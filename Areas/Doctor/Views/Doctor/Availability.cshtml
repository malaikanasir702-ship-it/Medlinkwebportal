@{
    ViewData["Title"] = "Professional Availability Management";
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
}

<div class="max-w-6xl mx-auto py-8 space-y-8 animate-in fade-in duration-500">
    <!-- Header Section -->
    <div class="bg-white dark:bg-slate-900 rounded-3xl p-8 shadow-sm border border-slate-100 dark:border-slate-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
        <div>
            <h1 class="text-2xl font-semibold text-slate-900 dark:text-white tracking-tight">Availability Management</h1>
            <p class="text-sm text-slate-500 font-medium mt-1">Configure your weekly consultation schedule and operational constraints.</p>
        </div>
        <div class="flex items-center gap-4 bg-slate-50 dark:bg-slate-800/50 p-2 rounded-2xl border border-slate-100 dark:border-slate-700">
            <div class="px-4 py-2">
                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest leading-none mb-1">Live Status</p>
                <p id="statusLabel" class="text-xs font-bold @(ViewBag.IsAvailable ? "text-emerald-500" : "text-rose-500")">
                    @(ViewBag.IsAvailable ? "Online & Accepting" : "Offline / Standby")
                </p>
            </div>
            <button id="toggleAvailability" class="w-14 h-8 rounded-full transition-all relative @(ViewBag.IsAvailable ? "bg-emerald-500" : "bg-slate-300 dark:bg-slate-700") shadow-inner">
                <div class="w-6 h-6 bg-white rounded-full absolute top-1 transition-all @(ViewBag.IsAvailable ? "right-1" : "left-1") shadow-md"></div>
            </button>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Sidebar: Configuration -->
        <div class="lg:col-span-4 space-y-6">
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-6 shadow-sm border border-slate-100 dark:border-slate-800">
                <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-6">Operational Rules</h3>
                
                <div class="space-y-4">
                    <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-transparent hover:border-blue-500/20 transition-all">
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Slot Duration</span>
                            <span id="displaySlotDuration" class="text-[10px] font-semibold text-blue-600 bg-blue-50 dark:bg-blue-900/30 px-2.5 py-1 rounded-lg">@ViewBag.SlotDuration MIN</span>
                        </div>
                        <p class="text-[10px] text-slate-500">Standard time for each appointment.</p>
                    </div>

                    <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-transparent hover:border-blue-500/20 transition-all">
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-xs font-bold text-slate-700 dark:text-slate-300">Buffer Period</span>
                            <span id="displayBufferTime" class="text-[10px] font-semibold text-slate-600 bg-slate-100 dark:bg-slate-700 px-2.5 py-1 rounded-lg">@ViewBag.BufferTime MIN</span>
                        </div>
                        <p class="text-[10px] text-slate-500">Rest gap between sessions.</p>
                    </div>
                </div>

                <button onclick="openConstraintsModal()" class="w-full mt-6 py-3.5 text-xs font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 dark:bg-blue-900/20 dark:hover:bg-blue-900/30 rounded-2xl transition-all border border-blue-100/50 dark:border-blue-900/30 uppercase tracking-widest">
                    Edit Global Rules
                </button>
            </div>

            <div class="bg-blue-600 rounded-[2rem] p-8 text-white relative overflow-hidden shadow-xl shadow-blue-500/20">
                <div class="relative z-10">
                    <h4 class="text-xl font-semibold leading-tight">Sync Status:<br/>Enterprise Active</h4>
                    <p class="text-xs text-blue-100 mt-4 leading-relaxed opacity-80">Your availability is synchronized across all MedLink institutional branches.</p>
                </div>
                <i data-lucide="refresh-cw" class="absolute -right-4 -bottom-4 w-32 h-32 text-white/10 rotate-12"></i>
            </div>
        </div>

        <!-- Main Schedule -->
        <div class="lg:col-span-8 space-y-6">
            <div class="bg-white dark:bg-slate-900 rounded-3xl p-8 shadow-sm border border-slate-100 dark:border-slate-800">
                <div class="flex items-center justify-between mb-8">
                    <div>
                        <h3 class="text-xl font-semibold text-slate-900 dark:text-white tracking-tight">Weekly Schedule</h3>
                        <p class="text-xs text-slate-500 font-medium">Define active work widows for each day.</p>
                    </div>
                </div>

                <div class="space-y-3">
                    @foreach (var day in new[] { "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday" })
                    {
                        var isWeekend = day == "Saturday" || day == "Sunday";
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between p-5 bg-slate-50 dark:bg-slate-800/30 rounded-2xl border border-transparent hover:border-slate-200 dark:hover:border-slate-700 transition-all group">
                            <div class="flex items-center gap-5 mb-4 sm:mb-0">
                                <div class="w-12 h-12 rounded-xl @(isWeekend ? "bg-slate-200 dark:bg-slate-700 text-slate-500" : "bg-blue-100 dark:bg-blue-900/40 text-blue-600") flex items-center justify-center text-[11px] font-semibold uppercase">
                                    @day.Substring(0, 3)
                                </div>
                                <div>
                                    <h4 class="text-sm font-bold text-slate-900 dark:text-white">@day</h4>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-0.5">
                                        @(isWeekend ? "Not Scheduled" : "Configured Windows")
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <button onclick="openSlotModal('@day')" class="px-5 py-2.5 bg-white dark:bg-slate-800 text-[11px] font-semibold text-slate-700 dark:text-slate-300 rounded-xl uppercase tracking-widest border border-slate-200 dark:border-slate-700 hover:border-blue-500 transition-all shadow-sm">
                                    Manage Slots
                                </button>
                                @if (!isWeekend)
                                {
                                     <button class="w-10 h-10 flex items-center justify-center text-slate-300 hover:text-rose-500 transition-colors">
                                        <i data-lucide="power" class="w-4 h-4"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Edit Slots -->
<div class="modal fade" id="slotModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-none shadow-2xl bg-white dark:bg-slate-900 rounded-[2.5rem] overflow-hidden">
            <div class="p-8 border-b border-slate-50 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/50 flex items-center justify-between">
                <div>
                    <h3 class="text-xl font-semibold text-slate-900 dark:text-white tracking-tight" id="slotDayTitle">Manage Schedule</h3>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">Define work periods</p>
                </div>
                <button type="button" class="w-10 h-10 flex items-center justify-center text-slate-400 hover:text-slate-900 dark:hover:text-white" data-bs-dismiss="modal">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <div class="p-8">
                <!-- Add Form -->
                <form id="addSlotForm" class="space-y-4 p-6 bg-slate-50 dark:bg-slate-800/50 rounded-2xl mb-8 border border-slate-100 dark:border-slate-800">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="DayOfWeek" id="hiddenDay" />
                    <input type="hidden" name="Id" id="hiddenSlotId" value="0" />
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-2">
                             <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest ml-1">Start Time</label>
                             <input type="time" name="StartTime" class="w-full bg-white dark:bg-slate-900 border-2 border-slate-100 dark:border-slate-800 rounded-xl px-4 py-3 text-sm font-bold focus:border-blue-500 focus:outline-none transition-all" required />
                        </div>
                        <div class="space-y-2">
                             <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest ml-1">End Time</label>
                             <input type="time" name="EndTime" class="w-full bg-white dark:bg-slate-900 border-2 border-slate-100 dark:border-slate-800 rounded-xl px-4 py-3 text-sm font-bold focus:border-blue-500 focus:outline-none transition-all" required />
                        </div>
                    </div>
                    <div class="flex gap-3">
                        <button type="submit" id="slotSubmitBtn" class="flex-1 py-3.5 bg-blue-600 text-white rounded-xl shadow-lg shadow-blue-500/20 active:scale-95 transition-all text-xs font-semibold uppercase tracking-widest">
                            <span id="slotBtnText">Add Time Period</span>
                        </button>
                        <button type="button" id="cancelEditBtn" class="hidden px-6 py-3.5 bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 rounded-xl text-xs font-semibold uppercase tracking-widest" onclick="resetForm()">
                            Cancel
                        </button>
                    </div>
                </form>

                <!-- List -->
                <div id="slotsContainer" class="space-y-3 max-h-[300px] overflow-y-auto pr-2 custom-scrollbar">
                    <!-- Dynamic Content -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Global Constraints -->
<div class="modal fade" id="constraintsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-none shadow-2xl bg-white dark:bg-slate-900 rounded-[2.5rem] overflow-hidden">
             <div class="p-8 border-b border-slate-50 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/50 flex justify-between items-center">
                 <h3 class="text-sm font-semibold text-slate-900 dark:text-white uppercase tracking-[0.2em]">Global Rules</h3>
                  <button type="button" class="text-slate-400 hover:text-slate-900 transition-colors" data-bs-dismiss="modal">
                     <i data-lucide="x" class="w-4 h-4"></i>
                 </button>
             </div>
             <form id="constraintsForm" class="p-8 space-y-6">
                 <div class="space-y-2">
                     <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest ml-1">Slot Duration (Min)</label>
                     <input type="number" name="slotDuration" id="inputSlotDuration" class="w-full bg-slate-50 dark:bg-slate-800 border-2 border-transparent focus:border-blue-500/20 rounded-xl px-4 py-3 text-sm font-bold focus:outline-none transition-all" value="@ViewBag.SlotDuration" required />
                 </div>
                 <div class="space-y-2">
                     <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest ml-1">Buffer Time (Min)</label>
                     <input type="number" name="bufferTime" id="inputBufferTime" class="w-full bg-slate-50 dark:bg-slate-800 border-2 border-transparent focus:border-blue-500/20 rounded-xl px-4 py-3 text-sm font-bold focus:outline-none transition-all" value="@ViewBag.BufferTime" required />
                 </div>
                 <button type="submit" class="w-full py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-2xl text-[10px] font-semibold uppercase tracking-[0.2em] shadow-xl transition-all active:scale-95">
                     Update Operational Rules
                 </button>
             </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();

        const availabilityBtn = document.getElementById('toggleAvailability');
        const statusLabel = document.getElementById('statusLabel');

        availabilityBtn?.addEventListener('click', async () => {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const response = await fetch('/Doctor/Doctor/ToggleAvailability', { 
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    }
                });
                const data = await response.json();
                
                if (data.success) {
                    const knob = availabilityBtn.querySelector('div');
                    if (data.isAvailable) {
                        availabilityBtn.classList.replace('bg-slate-300', 'bg-emerald-500');
                        availabilityBtn.classList.replace('dark:bg-slate-700', 'bg-emerald-500');
                        knob.classList.replace('left-1', 'right-1');
                        statusLabel.textContent = 'Online & Accepting';
                        statusLabel.className = 'text-xs font-bold text-emerald-500';
                    } else {
                        availabilityBtn.classList.replace('bg-emerald-500', 'bg-slate-300');
                        knob.classList.replace('right-1', 'left-1');
                        statusLabel.textContent = 'Offline / Standby';
                        statusLabel.className = 'text-xs font-bold text-rose-500';
                    }
                }
            } catch (error) {
                console.error('Session update failure:', error);
            }
        });

        let currentDay = "";

        async function openSlotModal(day) {
            currentDay = day;
            document.getElementById('slotDayTitle').textContent = `${day} Schedule`;
            document.getElementById('hiddenDay').value = day;
            resetForm();
            const modalElement = document.getElementById('slotModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            modal.show();
            await loadSlots();
            lucide.createIcons();
        }

        function resetForm() {
            const form = document.getElementById('addSlotForm');
            form.reset();
            document.getElementById('hiddenDay').value = currentDay;
            document.getElementById('hiddenSlotId').value = "0";
            
            const btnText = document.getElementById('slotBtnText');
            btnText.textContent = 'Add Time Period';
            document.getElementById('slotSubmitBtn').className = 'flex-1 py-3.5 bg-blue-600 text-white rounded-xl shadow-lg shadow-blue-500/20 active:scale-95 transition-all text-xs font-semibold uppercase tracking-widest';
            document.getElementById('cancelEditBtn').classList.add('hidden');
        }

        function editSlot(id, start, end) {
            document.getElementById('hiddenSlotId').value = id;
            const form = document.getElementById('addSlotForm');
            form.elements['StartTime'].value = start.padStart(5, '0');
            form.elements['EndTime'].value = end.padStart(5, '0');
            
            document.getElementById('slotBtnText').textContent = 'Confirm Changes';
            document.getElementById('slotSubmitBtn').className = 'flex-1 py-3.5 bg-emerald-500 text-white rounded-xl shadow-lg shadow-emerald-500/20 active:scale-95 transition-all text-xs font-semibold uppercase tracking-widest';
            document.getElementById('cancelEditBtn').classList.remove('hidden');
        }

        async function loadSlots() {
            const container = document.getElementById('slotsContainer');
            container.innerHTML = '<div class="flex justify-center py-10"><div class="w-6 h-6 border-2 border-blue-600/30 border-t-blue-600 rounded-full animate-spin"></div></div>';
            
            try {
                const response = await fetch(`/Doctor/Doctor/GetAvailabilitySlots?day=${currentDay}`);
                const slots = await response.json();
                
                if (slots.length === 0) {
                    container.innerHTML = `
                        <div class="text-center py-10 opacity-40">
                            <i data-lucide="calendar-x" class="w-10 h-10 mx-auto mb-2"></i>
                            <p class="text-xs font-bold">No windows configured.</p>
                        </div>`;
                    lucide.createIcons();
                    return;
                }

                container.innerHTML = slots.map(s => `
                    <div class="flex items-center justify-between p-4 bg-white dark:bg-slate-800 rounded-2xl border border-slate-100 dark:border-slate-800 group hover:border-blue-500/30 transition-all shadow-sm">
                        <div class="flex items-center gap-4">
                            <div class="w-2 h-2 rounded-full bg-blue-500"></div>
                            <span class="text-sm font-semibold text-slate-700 dark:text-slate-200 font-mono tracking-tight">${s.startTime} — ${s.endTime}</span>
                        </div>
                        <div class="flex gap-2">
                             <button onclick="editSlot(${s.id}, '${s.startTime}', '${s.endTime}')" class="w-8 h-8 rounded-lg text-slate-300 hover:text-blue-500 hover:bg-blue-50 dark:hover:bg-blue-900/40 transition-all flex items-center justify-center">
                                <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                            </button>
                            <button onclick="deleteSlot(${s.id})" class="w-8 h-8 rounded-lg text-slate-300 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-900/40 transition-all flex items-center justify-center">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>
                `).join('');
                lucide.createIcons();
            } catch (error) {
                container.innerHTML = '<p class="text-center text-rose-500 text-[10px] font-semibold">Sync failed.</p>';
            }
        }

        document.getElementById('addSlotForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const btn = document.getElementById('slotSubmitBtn');
            const originalText = btn.innerHTML;
            btn.innerHTML = '<div class="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin mx-auto"></div>';
            btn.disabled = true;
            
            try {
                const response = await fetch('/Doctor/Doctor/SaveAvailabilitySlot', {
                    method: 'POST',
                    body: new URLSearchParams(formData).toString(),
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                });
                const result = await response.json();
                if (result.success) {
                    resetForm();
                    await loadSlots();
                } else {
                    await PremiumModal.error('Constraint mismatch: ' + (result.errors?.join(', ') || 'Process failed'), 'Configuration Error');
                }
            } catch (error) {
                console.error(error);
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        });

        async function deleteSlot(id) {
            const confirmed = await PremiumModal.confirm('Permanently remove this operational work window?', 'Delete Window');
            if (!confirmed) return;
            try {
                const response = await fetch(`/Doctor/Doctor/DeleteAvailabilitySlot?id=${id}`, { method: 'POST' });
                const result = await response.json();
                if (result.success) await loadSlots();
            } catch (error) {
                console.error(error);
            }
        }

        function openConstraintsModal() {
            const modalElement = document.getElementById('constraintsModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            modal.show();
            lucide.createIcons();
        }

        document.getElementById('constraintsForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            try {
                const response = await fetch('/Doctor/Doctor/UpdateGlobalConstraints', {
                    method: 'POST',
                    body: new URLSearchParams(formData).toString(),
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' }
                });
                const result = await response.json();
                if (result.success) {
                    document.getElementById('displaySlotDuration').textContent = formData.get('slotDuration') + ' MIN';
                    document.getElementById('displayBufferTime').textContent = formData.get('bufferTime') + ' MIN';
                    bootstrap.Modal.getInstance(document.getElementById('constraintsModal')).hide();
                }
            } catch (error) {
                console.error(error);
            }
        });
    </script>
}
