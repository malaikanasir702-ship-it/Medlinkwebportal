@model MedLinkPortal.Models.PatientDashboardModel
@{
    ViewData["Title"] = "Medicine Details";
    Layout = "_DashboardLayout";
    var medicine = ViewBag.Medicine as MedLinkPortal.Models.Medicine;
}

<div class="min-h-screen pb-20">
    <div class="max-w-5xl mx-auto px-4 py-8 lg:py-12">
        <!-- Back Button -->
        <a href="/Pharmacy/Store" class="inline-flex items-center gap-2 text-slate-500 hover:text-blue-600 font-bold text-sm mb-8 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Store
        </a>

        @if (medicine == null)
        {
            <div class="text-center py-20">
                <div class="w-20 h-20 bg-rose-50 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="alert-circle" class="w-10 h-10 text-rose-500"></i>
                </div>
                <h2 class="text-xl font-semibold text-slate-900">Medicine Not Found</h2>
                <p class="text-slate-500 mt-2">The medicine you are looking for does not exist or has been removed.</p>
            </div>
        }
        else
        {
            <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-xl overflow-hidden">
                <div class="grid grid-cols-1 lg:grid-cols-2">
                    <!-- Image Section -->
                    <div class="bg-slate-50 p-8 lg:p-12 flex items-center justify-center relative group">
                        @if (!string.IsNullOrEmpty(medicine.ImageUrl) && medicine.ImageUrl != "/images/medicines/default.png")
                        {
                            <img src="@medicine.ImageUrl" alt="@medicine.Name" class="w-full max-w-[300px] object-contain drop-shadow-2xl group-hover:scale-105 transition-transform duration-500" />
                        }
                        else
                        {
                            <i data-lucide="pill" class="w-32 h-32 text-slate-300 opacity-50"></i>
                        }
                        
                        <!-- Stock Badge -->
                        <div class="absolute top-8 left-8">
                             @if((medicine.StockQuantity ?? 0) > 0) {
                                <span class="px-3 py-1 bg-emerald-50 text-emerald-600 text-[10px] font-semibold uppercase tracking-widest rounded-full border border-emerald-100">In Stock</span>
                            } else {
                                <span class="px-3 py-1 bg-rose-50 text-rose-600 text-[10px] font-semibold uppercase tracking-widest rounded-full border border-rose-100">Out of Stock</span>
                            }
                        </div>
                    </div>

                    <!-- Details Section -->
                    <div class="p-8 lg:p-12 flex flex-col">
                        <div class="mb-auto">
                            <p class="text-xs font-bold text-blue-500 uppercase tracking-widest mb-2">@medicine.Brand • @medicine.Category</p>
                            <h1 class="text-3xl md:text-4xl font-semibold text-slate-900 mb-6 tracking-tight">@medicine.Name</h1>
                            
                            <div class="space-y-6">
                                <div>
                                    <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-3 flex items-center gap-2">
                                        <i data-lucide="info" class="w-4 h-4"></i> Description
                                    </h3>
                                    <p class="text-slate-600 leading-relaxed text-sm md:text-base">
                                        @if (!string.IsNullOrEmpty(medicine.Description))
                                        {
                                            @medicine.Description
                                        }
                                        else
                                        {
                                            <span class="italic text-slate-400">No description available for this medicine.</span>
                                        }
                                    </p>
                                </div>
                                
                                <div class="flex items-center gap-8 py-6 border-y border-slate-50">
                                    <div>
                                        <p class="text-[10px] font-semibold text-slate-300 uppercase tracking-widest mb-1">Price per Unit</p>
                                         <p class="text-3xl font-semibold text-slate-900 text-emerald-600">PKR @((medicine.Price ?? 0).ToString("N0"))</p>
                                    </div>
                                     @if(medicine.PrescriptionRequired == true)
                                    {
                                        <div class="flex items-center gap-2 bg-amber-50 px-4 py-2 rounded-xl border border-amber-100">
                                            <i data-lucide="file-warning" class="w-5 h-5 text-amber-500"></i>
                                            <span class="text-[10px] font-bold text-amber-700 uppercase tracking-widest">Prescription Required</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mt-8 pt-8">
                            @if((medicine.StockQuantity ?? 0) > 0)
                            {
                                 <button onclick="addToCart(@medicine.Id, '@medicine.Name', @(medicine.Price ?? 0), '@medicine.Brand', '@medicine.ImageUrl')" 
                                        class="w-full py-5 bg-slate-900 text-white font-semibold text-sm rounded-2xl hover:bg-blue-600 shadow-xl shadow-slate-900/10 active:scale-95 transition-all flex items-center justify-center gap-3">
                                    <i data-lucide="shopping-cart" class="w-5 h-5"></i> Add to Cart
                                </button>
                            }
                            else
                            {
                                <button disabled class="w-full py-5 bg-slate-100 text-slate-400 font-semibold text-sm rounded-2xl cursor-not-allowed flex items-center justify-center gap-3">
                                    <i data-lucide="ban" class="w-5 h-5"></i> Out of Stock
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        lucide.createIcons();
    });

    function addToCart(id, name, price, brand, imageUrl) {
        // Use Global Cart
        PharmacyCart.addItem({
            id: id,
            name: name,
            price: price,
            brand: brand,
            imageUrl: imageUrl
        });
    }
</script>
