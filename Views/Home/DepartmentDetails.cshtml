@using MedLinkPortal.Models
@{
    var dept = ViewBag.Department as Department;
    var specialists = ViewBag.Specialists as List<Doctor>;
    ViewData["Title"] = $"{dept.Title} Department | MedLink";
}

<div class="min-h-screen bg-white">

    <!-- Header / Hero -->
    <header class="pt-32 md:pt-44 pb-28 md:pb-32 px-6 bg-white border-b border-gray-100">
        <div class="max-w-7xl mx-auto">

            <!-- Breadcrumb -->
            <nav class="mb-14 mt-10 md:mt-14">
                <a href="/" class="inline-flex items-center gap-2 text-sm font-medium text-gray-400 hover:text-gray-700 transition-colors group">
                    <i data-lucide="arrow-left" class="w-4 h-4 transition-transform group-hover:-translate-x-0.5"></i>
                    Back to Specialties
                </a>
            </nav>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-start">

                <!-- Left: Dept Info -->
                <div>
                    <!-- Icon -->
                    <div class="w-14 h-14 rounded-xl bg-blue-50 border border-blue-100 flex items-center justify-center mb-10">
                        <i data-lucide="@dept.Icon.ToLower()" class="w-7 h-7 text-blue-600"></i>
                    </div>

                    <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-4">Medical Department</p>

                    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 tracking-tight leading-tight mb-3">
                        @dept.Title
                    </h1>
                    <p class="text-2xl font-semibold text-gray-300 mb-8">Department</p>

                    <p class="text-base text-gray-500 leading-relaxed mb-12 max-w-lg">
                        @dept.Description
                    </p>

                    <button onclick="toggleModal('bookingModal')"
                            class="inline-flex items-center gap-2 px-8 py-3.5 mb-16 md:mb-20 bg-blue-600 text-white rounded-lg font-semibold text-sm hover:bg-blue-700 transition-colors">
                        <i data-lucide="calendar-plus" class="w-4 h-4"></i>
                        Book Department Consultation
                    </button>
                </div>

                <!-- Right: Services Grid -->
                <div>
                    @if (dept.Services != null && dept.Services.Any())
                    {
                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-6">Services Offered</p>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            @foreach (var service in dept.Services)
                            {
                                <div class="bg-white border border-gray-200 rounded-xl p-6 hover:border-gray-300 transition-colors">
                                    <div class="w-9 h-9 rounded-lg bg-blue-50 border border-blue-100 flex items-center justify-center mb-5">
                                        <i data-lucide="check-circle" class="w-4 h-4 text-blue-600"></i>
                                    </div>
                                    <h4 class="font-semibold text-gray-900 mb-2">@service</h4>
                                    <p class="text-xs text-gray-400 leading-relaxed">Specialized procedural care and diagnostics.</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Specialists Section -->
    <section class="py-28 px-6">
        <div class="max-w-7xl mx-auto">

            <!-- Section Header -->
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-6">
                <div>
                    <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-4">Board-Certified Experts</p>
                    <h2 class="text-3xl font-bold text-gray-900 tracking-tight">Meet our @dept.Title Specialists</h2>
                </div>
                <p class="text-sm text-gray-400 max-w-xs leading-relaxed">
                    Our team consists of world-class doctors with average 15+ years of clinical experience.
                </p>
            </div>

            <!-- Doctors Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                @if (specialists != null && specialists.Any())
                {
                    foreach (var doc in specialists)
                    {
                        <div class="bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-gray-300 transition-colors group">
                            <!-- Doctor Photo -->
                            <div class="relative aspect-[4/5] overflow-hidden bg-gray-100">
                                <img src="@doc.Image"
                                     alt="@doc.Name"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
                            </div>

                            <!-- Doctor Info -->
                            <div class="p-6">
                                <p class="text-xs font-semibold text-blue-600 uppercase tracking-wider mb-1.5">@doc.Specialty</p>
                                <h4 class="font-semibold text-gray-900 mb-2">@doc.Name</h4>
                                <div class="flex items-center gap-1 mb-5">
                                    <i data-lucide="star" class="w-3 h-3 text-yellow-400 fill-current"></i>
                                    <span class="text-xs text-gray-500 font-medium">@doc.Rating</span>
                                </div>

                                <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                                    <div>
                                        <p class="text-[10px] text-gray-400 uppercase tracking-wider font-semibold mb-0.5">Availability</p>
                                        <p class="text-xs font-semibold text-green-600">@doc.Availability</p>
                                    </div>
                                    <button onclick="toggleModal('bookingModal')"
                                            class="w-9 h-9 bg-gray-900 text-white rounded-lg flex items-center justify-center hover:bg-blue-600 transition-colors">
                                        <i data-lucide="calendar" class="w-4 h-4"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-span-full py-12 md:py-14 px-6 text-center border border-dashed border-gray-200 rounded-xl bg-gray-50">
                        <div class="w-12 h-12 bg-white border border-gray-200 rounded-xl flex items-center justify-center mx-auto mb-4">
                            <i data-lucide="user-plus" class="w-5 h-5 text-gray-400"></i>
                        </div>
                        <h4 class="font-semibold text-gray-900 mb-1.5">Recruiting More Specialists</h4>
                        <p class="text-sm text-gray-400">We are currently onboarding more @dept.Title experts.</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- Why Choose Section -->
    <section class="py-24 px-6 bg-gray-50 border-t border-b border-gray-100">
        <div class="max-w-7xl mx-auto">

            <!-- Header -->
            <div class="mb-16 md:mb-20">
                <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-4">Precision Care</p>
                <h2 class="text-3xl font-bold text-gray-900 tracking-tight">Why our @dept.Title unit?</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                <div class="bg-white border border-gray-200 rounded-xl p-8">
                    <div class="w-11 h-11 rounded-lg bg-blue-50 border border-blue-100 flex items-center justify-center mb-7">
                        <i data-lucide="activity" class="w-5 h-5 text-blue-600"></i>
                    </div>
                    <h3 class="font-semibold text-gray-900 mb-3">Real-time Monitoring</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">Continuous vitals monitoring during remote consultations with IoT device integration.</p>
                </div>

                <div class="bg-white border border-gray-200 rounded-xl p-8">
                    <div class="w-11 h-11 rounded-lg bg-gray-50 border border-gray-200 flex items-center justify-center mb-7">
                        <i data-lucide="cpu" class="w-5 h-5 text-gray-600"></i>
                    </div>
                    <h3 class="font-semibold text-gray-900 mb-3">AI Diagnostic Aid</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">Neural networks assist our doctors in identifying patterns specific to @dept.Title conditions.</p>
                </div>

                <div class="bg-white border border-gray-200 rounded-xl p-8">
                    <div class="w-11 h-11 rounded-lg bg-gray-50 border border-gray-200 flex items-center justify-center mb-7">
                        <i data-lucide="globe" class="w-5 h-5 text-gray-600"></i>
                    </div>
                    <h3 class="font-semibold text-gray-900 mb-3">Global Specialist Network</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">Consult with top-tier specialists from any continent within minutes through our platform.</p>
                </div>

            </div>
        </div>
    </section>

    <!-- CTA Strip -->
    <section class="py-16 px-6 bg-white border-b border-gray-100">
        <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
            <div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">Ready to book a @dept.Title consultation?</h3>
                <p class="text-sm text-gray-500">Connect with a specialist today. Available 7 days a week.</p>
            </div>
            <button onclick="toggleModal('bookingModal')"
                    class="flex-shrink-0 inline-flex items-center gap-2 px-8 py-3.5 bg-blue-600 text-white rounded-lg font-semibold text-sm hover:bg-blue-700 transition-colors">
                <i data-lucide="calendar-plus" class="w-4 h-4"></i>
                Book Consultation
            </button>
        </div>
    </section>

    @await Html.PartialAsync("_Footer")
    @await Html.PartialAsync("_BookingModal")
</div>

<script>
    lucide.createIcons();
    function toggleModal(id) {
        document.getElementById(id).classList.toggle('hidden');
        document.body.classList.toggle('overflow-hidden');
    }
</script>