@model IEnumerable<MedLinkPortal.Areas.Admin.Models.Billing>
<div class="space-y-12 pb-20">
    <div class="flex flex-col flex-md-row md:items-center justify-between gap-10 py-6">
        <div class="animate-in fade-in slide-in-from-left-8 duration-1000">
            <h1 class="text-6xl md:text-7xl font-semibold text-slate-900 tracking-tighter mb-4">
                Financial <span class="text-blue-600">Ledger</span>
            </h1>
            <p class="text-slate-500 text-xl font-medium leading-relaxed max-w-2xl">
                Invoice generation, insurance claim tracking, and consultation billing.
            </p>
        </div>
        <button id="btnOpenBillModal" class="flex items-center gap-3 px-10 py-5 bg-[#0F172A] text-white rounded-[24px] text-sm font-semibold hover:bg-black transition-all shadow-xl active:scale-95 group">
            <i class="fas fa-file-invoice group-hover:rotate-12 transition-transform"></i> Create Invoice
        </button>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bento-card p-8 bg-white border border-slate-100 flex items-center gap-6 group hover:shadow-2xl transition-all duration-500">
            <div class="w-16 h-16 rounded-[22px] bg-blue-50 text-blue-600 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                <i class="fas fa-wallet"></i>
            </div>
            <div>
                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Total Revenue</p>
                <p class="text-3xl font-semibold text-slate-900">PKR @Model.Sum(b => b.Amount).ToString("N0")</p>
            </div>
        </div>
        <div class="bento-card p-8 bg-white border border-slate-100 flex items-center gap-6 group hover:shadow-2xl transition-all duration-500">
            <div class="w-16 h-16 rounded-[22px] bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                <i class="fas fa-check-double"></i>
            </div>
            <div>
                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Collected</p>
                <p class="text-3xl font-semibold text-slate-900">PKR @Model.Where(b => b.Status == "PAID").Sum(b => b.Amount).ToString("N0")</p>
            </div>
        </div>
        <div class="bento-card p-8 bg-white border border-slate-100 flex items-center gap-6 group hover:shadow-2xl transition-all duration-500">
            <div class="w-16 h-16 rounded-[22px] bg-amber-50 text-amber-600 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                <i class="fas fa-clock-rotate-left"></i>
            </div>
            <div>
                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Outstanding</p>
                <p class="text-3xl font-semibold text-slate-900">PKR @Model.Where(b => b.Status != "PAID").Sum(b => b.Amount).ToString("N0")</p>
            </div>
        </div>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-10">
        <div class="xl:col-span-12">
            <div class="bento-card p-5 md:p-12">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="text-left border-b border-slate-100">
                                <th class="pb-6 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">ID / Date</th>
                                <th class="pb-6 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Patient</th>
                                <th class="pb-6 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Description</th>
                                <th class="pb-6 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Insurance Details</th>
                                <th class="pb-6 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Amount</th>
                                <th class="pb-6 text-[10px] font-semibold text-slate-400 uppercase tracking-widest text-center">Status</th>
                                <th class="pb-6 text-[10px] font-semibold text-slate-400 uppercase tracking-widest text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            @foreach (var bill in Model) {
                                <tr class="group hover:bg-slate-50/50 transition-all">
                                    <td class="py-6">
                                        <p class="text-sm font-semibold text-slate-900">#INV-@bill.Id</p>
                                        <p class="text-[10px] font-bold text-slate-400">@bill.DateGenerated.ToString("MMM dd, yyyy")</p>
                                    </td>
                                    <td class="py-6">
                                        <div class="flex items-center gap-3">
                                            <div class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center text-blue-600">
                                                <i class="fas fa-user text-xs"></i>
                                            </div>
                                            <span class="text-sm font-bold text-slate-700">@bill.Patient?.Name</span>
                                        </div>
                                    </td>
                                    <td class="py-6 text-xs font-medium text-slate-500">@bill.Description</td>
                                    <td class="py-6">
                                        @if(!string.IsNullOrEmpty(bill.InsuranceProvider)) {
                                            <p class="text-[10px] font-semibold text-blue-600 uppercase">@bill.InsuranceProvider</p>
                                            <p class="text-[10px] font-bold text-slate-400">Policy: @bill.InsurancePolicyNumber</p>
                                        } else {
                                            <span class="text-[9px] font-semibold text-slate-300 uppercase italic">Self Pay</span>
                                        }
                                    </td>
                                    <td class="py-6">
                                        <div class="flex items-center gap-1.5">
                                            <span class="text-[10px] font-semibold text-slate-400">PKR</span>
                                            <span class="text-xl font-semibold text-slate-900">@bill.Amount.ToString("N2")</span>
                                        </div>
                                    </td>
                                    <td class="py-6 text-center">
                                        <span class="px-4 py-1.5 @(bill.Status == "PAID" ? "bg-emerald-500/10 text-emerald-600 border-emerald-500/20" : "bg-amber-500/10 text-amber-600 border-amber-500/20") rounded-full text-[9px] font-semibold uppercase tracking-widest border border-opacity-20 inline-block">
                                            @bill.Status
                                        </span>
                                    </td>
                                    <td class="py-6 text-right">
                                        <div class="flex justify-end gap-2 opacity-0 group-hover:opacity-100 transition-opacity">
                                            <a href="@Url.Action("Details", "Billing", new { id = bill.Id })" class="w-8 h-8 rounded-lg bg-white border border-slate-200 text-slate-400 hover:text-blue-600 transition-all shadow-sm flex items-center justify-center">
                                                <i class="fas fa-eye text-[10px]"></i>
                                            </a>
                                            <button class="btn-mark-paid w-8 h-8 rounded-lg bg-emerald-500 text-white hover:bg-emerald-600 transition-all shadow-md" data-id="@bill.Id">
                                                <i class="fas fa-check text-[10px]"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="billModal" class="fixed inset-0 hidden items-center justify-center modal-overlay p-4 z-[100]">
    <div class="modal-content w-full max-w-sm max-h-[90vh] overflow-hidden relative flex flex-col bg-white rounded-2xl shadow-2xl" style="background-color: #ffffff !important;">
        <div class="p-4 pb-2 flex justify-between items-start flex-shrink-0 border-b border-slate-100">
            <div>
                <h3 class="text-lg font-semibold text-slate-900 tracking-tight">Generate <span class="text-blue-600">Invoice</span></h3>
                <p class="text-slate-500 text-[9px] font-medium mt-0.5">Create financial record for patient.</p>
            </div>
            <button id="btnCloseModal" class="w-8 h-8 flex items-center justify-center rounded-lg bg-slate-50 text-slate-400 hover:text-slate-900 transition-all">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <form id="billForm" class="p-4 space-y-3 overflow-y-auto flex-1">
            <div class="space-y-0.5">
                <label class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest px-2">Patient</label>
                <select name="PatientId" data-val="true" data-val-required="Patient is required" data-val-length="Patient ID cannot exceed 50 characters" data-val-length-max="50" class="w-full px-3 py-2 bg-slate-50 border border-slate-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-bold text-slate-900 transition-all text-xs">
                    <option value="">Select Patient</option>
                    @foreach(var p in ViewBag.Patients) {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
                <span class="field-validation-valid text-red-500 text-[10px] leading-tight block min-h-[14px]" data-valmsg-for="PatientId" data-valmsg-replace="true"></span>
            </div>
            <div class="grid grid-cols-2 gap-2">
                <div class="space-y-0.5">
                    <label class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest px-2">Amount (PKR)</label>
                    <input type="number" name="Amount" step="0.01" data-val="true" data-val-required="Amount is required" data-val-range="Amount must be between 0.01 and 999999.99" data-val-range-min="0.01" data-val-range-max="999999.99" class="w-full px-3 py-2 bg-slate-50 border border-slate-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-bold text-slate-900 transition-all text-xs" />
                    <span class="field-validation-valid text-red-500 text-[10px] leading-tight block min-h-[14px]" data-valmsg-for="Amount" data-valmsg-replace="true"></span>
                </div>
                <div class="space-y-0.5">
                    <label class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest px-2">Status</label>
                    <select name="Status" data-val="true" data-val-required="Status is required" data-val-regex="Status must be PENDING, PAID, or PARTIALLY-PAID" data-val-regex-pattern="^(PENDING|PAID|PARTIALLY-PAID)$" class="w-full px-3 py-2 bg-slate-50 border border-slate-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-bold text-slate-900 transition-all text-xs">
                        <option value="">Select Status</option>
                        <option value="PENDING">Pending</option>
                        <option value="PAID">Paid</option>
                        <option value="PARTIALLY-PAID">Partially Paid</option>
                    </select>
                    <span class="field-validation-valid text-red-500 text-[10px] leading-tight block min-h-[14px]" data-valmsg-for="Status" data-valmsg-replace="true"></span>
                </div>
            </div>
            <div class="space-y-0.5">
                <label class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest px-2">Insurance Provider (Optional)</label>
                <input type="text" name="InsuranceProvider" data-val="true" data-val-length="Insurance provider cannot exceed 200 characters" data-val-length-max="200" placeholder="e.g. BlueCross" class="w-full px-3 py-2 bg-slate-50 border border-slate-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-bold text-slate-900 transition-all text-xs" />
                <span class="field-validation-valid text-red-500 text-[10px] leading-tight block min-h-[14px]" data-valmsg-for="InsuranceProvider" data-valmsg-replace="true"></span>
            </div>
            <div class="space-y-0.5">
                <label class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest px-2">Policy Number</label>
                <input type="text" name="InsurancePolicyNumber" data-val="true" data-val-length="Insurance policy number cannot exceed 100 characters" data-val-length-max="100" placeholder="e.g. PN-12345" class="w-full px-3 py-2 bg-slate-50 border border-slate-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-bold text-slate-900 transition-all text-xs" />
                <span class="field-validation-valid text-red-500 text-[10px] leading-tight block min-h-[14px]" data-valmsg-for="InsurancePolicyNumber" data-valmsg-replace="true"></span>
            </div>
            <div class="space-y-0.5">
                <label class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest px-2">Description</label>
                <textarea name="Description" data-val="true" data-val-length="Description cannot exceed 1000 characters" data-val-length-max="1000" class="w-full px-3 py-2 bg-slate-50 border border-slate-100 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-medium text-slate-900 transition-all text-xs resize-none h-14"></textarea>
                <span class="field-validation-valid text-red-500 text-[10px] leading-tight block min-h-[14px]" data-valmsg-for="Description" data-valmsg-replace="true"></span>
            </div>
            <div class="pt-2 flex-shrink-0 border-t border-slate-100 mt-3">
                <button type="submit" class="w-full py-3 bg-slate-900 text-white rounded-xl text-[10px] font-semibold uppercase tracking-widest hover:bg-black transition-all shadow-lg active:scale-95 text-center">Generate Financial Record</button>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Initialize jQuery validation for billing form
            $('#billForm').validate({
                errorClass: 'input-validation-error',
                errorElement: 'span',
                errorPlacement: function(error, element) {
                    error.addClass('text-red-500 text-xs');
                    error.insertAfter(element);
                },
                highlight: function(element) {
                    $(element).addClass('border-red-500');
                },
                unhighlight: function(element) {
                    $(element).removeClass('border-red-500');
                }
            });
            const $modal = $('#billModal');
            $('#btnOpenBillModal').on('click', () => {
                $modal.removeClass('hidden').addClass('flex');
                setTimeout(() => $modal.addClass('modal-open'), 10);
            });
            $('#btnCloseModal').on('click', () => {
                $modal.removeClass('modal-open');
                // Immediate close - no delay
                $modal.removeClass('flex').addClass('hidden');
            });
            $('#billForm').on('submit', function(e) {
                e.preventDefault();
                const $form = $(this);
                if (!$form.valid()) {
                    return false;
                }
                $.post('/Billing/Create', $(this).serialize(), function(res) {
                    if (res.success) location.reload();
                }).fail(function(xhr) {
                    if (xhr.responseJSON && xhr.responseJSON.errors) {
                        const errors = xhr.responseJSON.errors;
                        Object.keys(errors).forEach(function(key) {
                            const errorMsg = Array.isArray(errors[key]) ? errors[key][0] : errors[key];
                            $form.find('[data-valmsg-for="' + key + '"]').text(errorMsg).removeClass('field-validation-valid').addClass('field-validation-error');
                        });
                    } else {
                        alert(xhr.responseJSON?.message || 'An error occurred');
                    }
                });
            });
            $('.btn-mark-paid').on('click', function() {
                const id = $(this).data('id');
                $.post('/Billing/UpdateStatus', { id: id, status: 'PAID' }, function(res) {
                    if (res.success) location.reload();
                });
            });
        });
    </script>
}
