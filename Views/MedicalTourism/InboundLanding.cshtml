@model MedLinkPortal.Models.PatientDashboardModel

@{
    ViewData["Title"] = "Medical Tourism - Pakistan";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="space-y-12 pb-10">
    <!-- Immersive Hero Section -->
    <div class="relative rounded-[48px] overflow-hidden h-[600px] group shadow-[0_40px_80px_-20px_rgba(0,0,0,0.2)]">
        <img src="https://images.unsplash.com/photo-1500622944204-b135684e99fd?q=80&w=1461&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-[2s] ease-out" alt="Pakistan Landscape">
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
        
        <div class="absolute inset-0 flex flex-col justify-end p-10 md:p-16">
            <div class="max-w-3xl space-y-6 transform translate-y-0 transition-transform duration-700">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/20 backdrop-blur-md border border-white/20 text-white text-xs font-bold uppercase tracking-[0.2em]">
                    <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
                    Premium Destination
                </div>
                <h1 class="text-5xl md:text-7xl font-black text-white tracking-tight leading-none">
                    Healing in <br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-300">Nature's Lap</span>
                </h1>
                <p class="text-lg md:text-xl text-gray-200 font-medium max-w-xl leading-relaxed">
                    Combine your medical procedure with a spiritual retreat in the Himalayas. World-class surgeons, 5-star recovery suites, and guided tours.
                </p>
                <div class="pt-4 flex flex-wrap gap-4">
                    <a href="@Url.Action("RequestInbound")" class="px-8 py-4 bg-white text-slate-900 rounded-2xl font-bold hover:bg-slate-50 transition-all shadow-lg hover:shadow-xl hover:-translate-y-1 flex items-center gap-3">
                        Start Planning <i class="fas fa-arrow-right text-blue-600"></i>
                    </a>
                    <a href="@Url.Action("WatchFilm")" class="px-8 py-4 bg-white/10 backdrop-blur-md border border-white/20 text-white rounded-2xl font-bold hover:bg-white/20 transition-all flex items-center gap-3">
                        <i class="fas fa-play text-blue-400"></i> Watch Film
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Feature Grid (Frosted Glass) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-10 rounded-[40px] shadow-[0_20px_40px_-12px_rgba(0,0,0,0.05)] border border-slate-100 hover:shadow-xl transition-all duration-500 group">
            <div class="w-16 h-16 bg-blue-50 rounded-[24px] flex items-center justify-center text-blue-600 text-2xl mb-6 group-hover:scale-110 group-hover:bg-blue-600 group-hover:text-white transition-all duration-500">
                🏥
            </div>
            <h3 class="text-2xl font-black text-slate-900 mb-3 tracking-tight">JCI Accredited</h3>
            <p class="text-slate-500 font-medium leading-relaxed">Partnered with Aga Khan and Shifa International. Standards that match global benchmarks.</p>
        </div>
        <div class="bg-white p-10 rounded-[40px] shadow-[0_20px_40px_-12px_rgba(0,0,0,0.05)] border border-slate-100 hover:shadow-xl transition-all duration-500 group">
            <div class="w-16 h-16 bg-indigo-50 rounded-[24px] flex items-center justify-center text-indigo-600 text-2xl mb-6 group-hover:scale-110 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-500">
                🩺
            </div>
            <h3 class="text-2xl font-black text-slate-900 mb-3 tracking-tight">Top Specialists</h3>
            <p class="text-slate-500 font-medium leading-relaxed">Direct access to leading surgeons in Hair Transplant, Dentistry, and Cardiology.</p>
        </div>
        <div class="bg-white p-10 rounded-[40px] shadow-[0_20px_40px_-12px_rgba(0,0,0,0.05)] border border-slate-100 hover:shadow-xl transition-all duration-500 group">
            <div class="w-16 h-16 bg-blue-50 rounded-[24px] flex items-center justify-center text-blue-500 text-2xl mb-6 group-hover:scale-110 group-hover:bg-blue-500 group-hover:text-white transition-all duration-500">
                🌄
            </div>
            <h3 class="text-2xl font-black text-slate-900 mb-3 tracking-tight">Seamless Tourism</h3>
            <p class="text-slate-500 font-medium leading-relaxed">From surgery to Skardu. We handle your visa, flights, and luxury accommodation.</p>
        </div>
    </div>

    <!-- Destinations Carousel (Apple Styled) -->
    <div>
        <div class="flex items-end justify-between mb-8 px-2">
            <div>
                <h3 class="text-3xl font-black text-slate-900 tracking-tight mb-2">Popular Add-ons</h3>
                <p class="text-slate-500 font-medium">Curated recovery retreats for our patients.</p>
            </div>
            <a href="@Url.Action("AllDestinations")" class="text-blue-600 font-black text-xs uppercase tracking-[0.2em] hover:text-indigo-700 transition-colors">View All</a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
            @foreach (var (name, img) in new[] { 
                ("Hunza Valley", "https://images.unsplash.com/photo-1722082933604-288a1c130475?q=80&w=715&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"),
                        ("Faisal Mosque", "https://images.unsplash.com/photo-1635016288720-c52507b9a717?q=80&w=735&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"),
                        ("Badshahi Mosque", "https://images.unsplash.com/photo-1739356025140-f3a282df3c35?q=80&w=732&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"),
                ("Shangrila Resort", "https://images.unsplash.com/photo-1587595431973-160d0d94add1?q=80&w=2676&auto=format&fit=crop")
            })
            {
                <div class="group cursor-pointer relative rounded-[32px] overflow-hidden aspect-[4/5] shadow-md hover:shadow-2xl transition-all duration-500 hover:-translate-y-2">
                    <img src="@img" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-80"></div>
                    <div class="absolute bottom-0 left-0 p-6 z-10 w-full">
                        <span class="text-xs font-bold text-white/80 uppercase tracking-wider mb-1 block">Visit</span>
                        <h4 class="text-xl font-black text-white leading-tight">@name</h4>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
