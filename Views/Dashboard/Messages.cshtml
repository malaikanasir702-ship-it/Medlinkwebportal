@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Messages";
}

<!-- Main Container -->
<div class="min-h-0 flex-1 flex flex-col lg:flex-row bg-white/50 backdrop-blur-xl rounded-none lg:rounded-[2.5rem] lg:border border-gray-100 shadow-sm overflow-hidden" x-data="chatApp()" x-cloak>
    
    <!-- Sidebar: Doctor List -->
    <aside class="w-full lg:w-80 border-b lg:border-b-0 lg:border-r border-gray-100 flex flex-col bg-white/30" 
           :class="{ 'hidden lg:flex': activeDoctorId, 'flex': !activeDoctorId }">
        <div class="p-4 lg:p-6">
            <h3 class="text-xl font-semibold text-gray-900 mb-4">Messages</h3>
            <div class="relative">
                <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"></i>
                <input type="text" x-model="searchQuery" placeholder="Search..." 
                       class="w-full pl-11 pr-4 py-3 bg-gray-50 border-none rounded-2xl text-sm font-bold focus:ring-2 focus:ring-blue-500/10 transition-all outline-none">
            </div>
        </div>

        <div class="flex-1 overflow-y-auto px-2 lg:px-3 pb-6 space-y-1 custom-scrollbar">
            <template x-for="doctor in filteredDoctors" :key="doctor.id">
                <button type="button" @@click="selectDoctor(doctor)" 
                        class="w-full p-3 lg:p-4 rounded-2xl flex items-center gap-3 lg:gap-4 transition-all duration-300 group"
                        :class="activeDoctorId === doctor.id ? 'bg-blue-600 text-white shadow-lg shadow-blue-500/20' : 'hover:bg-gray-50 text-gray-900'">
                    <div class="relative shrink-0">
                        <img :src="doctor.image" class="w-10 h-10 lg:w-12 lg:h-12 rounded-xl object-cover border-2 shadow-sm"
                             :class="activeDoctorId === doctor.id ? 'border-blue-400' : 'border-white'">
                        <template x-if="doctor.online">
                            <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 lg:w-3.5 lg:h-3.5 bg-emerald-500 border-2 rounded-full"
                                 :class="activeDoctorId === doctor.id ? 'border-blue-600' : 'border-white'"></div>
                        </template>
                    </div>
                    <div class="flex-1 text-left min-w-0">
                        <h4 class="font-semibold text-sm truncate" x-text="doctor.name"></h4>
                        <p class="text-[10px] font-bold uppercase tracking-widest opacity-60 truncate" x-text="doctor.specialty"></p>
                    </div>
                    <div class="flex flex-col items-end gap-1 shrink-0">
                        <template x-if="doctor.unreadCount > 0">
                            <div class="bg-blue-500 text-white min-w-[20px] h-5 rounded-full flex items-center justify-center px-1.5 shadow-sm animate-in zoom-in duration-300">
                                <span class="text-[10px] font-semibold" x-text="doctor.unreadCount"></span>
                            </div>
                        </template>
                    </div>
                </button>
            </template>
        </div>
    </aside>

    <!-- Main Chat Area -->
    <main class="flex-1 flex flex-col min-h-0 bg-white/10 relative w-full" 
          :class="{ 'hidden lg:flex': !activeDoctorId, 'flex': activeDoctorId }">
        
        <template x-if="!activeDoctorId">
            <div class="flex-1 flex flex-col items-center justify-center p-8 text-center">
                <div class="w-20 h-20 lg:w-24 lg:h-24 bg-blue-50 rounded-[2rem] flex items-center justify-center text-blue-600 mb-6 animate-bounce-slow">
                    <i data-lucide="message-square" class="w-8 h-8 lg:w-10 lg:h-10"></i>
                </div>
                <h3 class="text-xl lg:text-2xl font-semibold text-gray-900 mb-2">Your Conversations</h3>
                <p class="text-gray-500 text-sm max-w-xs font-medium leading-relaxed">Select a doctor to start chatting.</p>
            </div>
        </template>

        <template x-if="activeDoctorId">
            <div class="flex-1 flex flex-col min-h-0 overflow-hidden">
                <!-- Chat Header -->
                <header class="p-3 lg:p-6 border-b border-gray-100 flex items-center justify-between bg-white/70 backdrop-blur-md shrink-0 sticky top-0 z-40">
                    <div class="flex items-center gap-2 lg:gap-3 min-w-0">
                        <button type="button" @@click="activeDoctorId = null" class="lg:hidden p-2 -ml-2 text-gray-400 hover:text-gray-900 shrink-0">
                            <i data-lucide="chevron-left" class="w-6 h-6"></i>
                        </button>
                        <div class="relative shrink-0">
                            <img :src="activeDoctor.image" class="w-9 h-9 lg:w-12 lg:h-12 rounded-xl object-cover shadow-md border-2 border-white">
                            <div x-show="activeDoctor.online" class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-500 border-2 border-white rounded-full"></div>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h4 class="font-semibold text-gray-900 text-xs lg:text-base truncate" x-text="activeDoctor.name"></h4>
                            <span class="text-[8px] lg:text-[9px] font-semibold text-blue-600 bg-blue-50 px-1.5 py-0.5 rounded-md uppercase" x-text="activeDoctor.specialty"></span>
                        </div>
                    </div>
                    <div class="flex items-center gap-0.5 lg:gap-3 shrink-0">
                        <button type="button" @@click="startCall('audio')" class="p-2 lg:p-3 text-gray-400 hover:text-emerald-600 hover:bg-emerald-50 rounded-2xl transition-all">
                            <i data-lucide="phone" class="w-4 h-4 lg:w-5 lg:h-5"></i>
                        </button>
                        <button type="button" @@click="startCall('video')" class="p-2 lg:p-3 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-2xl transition-all">
                            <i data-lucide="video" class="w-4 h-4 lg:w-5 lg:h-5"></i>
                        </button>
                        <div class="relative" x-data="{ open: false }" @@click.away="open = false">
                            <button type="button" @@click="open = !open" class="p-2 lg:p-3 text-gray-400 hover:text-gray-900 hover:bg-gray-50 rounded-2xl">
                                <i data-lucide="more-vertical" class="w-4 h-4 lg:w-5 lg:h-5"></i>
                            </button>
                            <div x-show="open" x-transition class="absolute right-0 top-full mt-2 w-48 bg-white border rounded-2xl shadow-2xl z-50 py-2">
                                <button type="button" @@click="clearChat(); open = false" class="w-full flex items-center gap-3 px-4 py-3 text-sm font-bold text-rose-600 hover:bg-rose-50">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    Clear Chat
                                </button>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- Messages Container -->
                <div class="flex-1 overflow-y-auto p-3 md:p-4 lg:p-8 space-y-3 md:space-y-6 custom-scrollbar" id="message-container" style="padding-bottom: calc(0.5rem + env(safe-area-inset-bottom, 0px));">
                    <template x-for="msg in messages" :key="msg.id">
                        <div class="flex flex-col group/message w-full" 
                             :class="isOwnMessage(msg) ? 'items-end' : 'items-start'">
                            
                            <!-- System Message (Call Logs) -->
                            <template x-if="msg.messageType === 'Call'">
                                <div class="w-full flex justify-center my-2">
                                    <div class="bg-gray-50 border border-gray-100 px-4 py-2 rounded-full flex items-center gap-2 text-xs font-bold text-gray-500">
                                        <i data-lucide="phone-missed" class="w-3 h-3 text-rose-500"></i>
                                        <span x-text="msg.content"></span>
                                        <span class="text-gray-300">|</span>
                                        <span x-text="formatTime(msg.timestamp)"></span>
                                    </div>
                                </div>
                            </template>

                            <!-- Normal Message -->
                            <template x-if="msg.messageType !== 'Call'">
                                <div class="flex items-end gap-2 max-w-[90%] md:max-w-[85%] lg:max-w-[70%]" :class="isOwnMessage(msg) ? 'flex-row-reverse' : 'flex-row'">
                                    
                                    <!-- Message Bubble -->
                                    <div class="relative px-3 py-2.5 md:px-4 md:py-3 lg:px-5 lg:py-3 rounded-[1.2rem] lg:rounded-[1.5rem] text-sm font-medium shadow-sm transition-all"
                                         :class="isOwnMessage(msg) ? 'bg-blue-600 text-white rounded-tr-none' : 'bg-gray-100 text-gray-900 rounded-tl-none'">
                                        
                                        <template x-if="msg.isDeleted">
                                            <div class="flex items-center gap-2 italic opacity-60">
                                                <i data-lucide="ban" class="w-3 h-3"></i>
                                                <span class="text-xs" x-text="isOwnMessage(msg) ? 'You deleted this message' : 'This message was deleted'"></span>
                                            </div>
                                        </template>
                                        
                                        <template x-if="!msg.isDeleted">
                                            <div>
                                                <p class="leading-relaxed whitespace-pre-wrap break-words" x-text="msg.content"></p>
                                                <span x-show="msg.isEdited" class="text-[9px] opacity-50 ml-2">edited</span>
                                                
                                                <template x-if="msg.attachmentUrl">
                                                    <div class="mt-3 overflow-hidden rounded-xl border" :class="isOwnMessage(msg) ? 'border-white/20' : 'border-gray-200'">
                                                        <template x-if="msg.attachmentType === 'Image'">
                                                            <img :src="msg.attachmentUrl" class="w-full max-h-48 lg:max-h-64 object-cover">
                                                        </template>
                                                        <template x-if="msg.attachmentType === 'Video'">
                                                            <video :src="msg.attachmentUrl" controls class="w-full max-h-48 lg:max-h-64 object-cover"></video>
                                                        </template>
                                                        <template x-if="msg.attachmentType !== 'Image' && msg.attachmentType !== 'Video'">
                                                            <a :href="msg.attachmentUrl" target="_blank" class="flex items-center gap-3 p-3 bg-black/5 hover:bg-black/10">
                                                                <i data-lucide="file-text" class="w-5 h-5"></i>
                                                                <span class="text-[11px] font-bold truncate max-w-[150px]" x-text="msg.attachmentName"></span>
                                                            </a>
                                                        </template>
                                                    </div>
                                                </template>
                                            </div>
                                        </template>
                                    </div>

                                    <!-- Action Menu -->
                                    <div class="relative" x-data="{ menuOpen: false }" @@click.away="menuOpen = false">
                                        <button type="button" 
                                                x-show="isOwnMessage(msg) && !msg.isDeleted" 
                                                @@click="menuOpen = !menuOpen"
                                                class="p-1.5 rounded-full hover:bg-gray-100 text-gray-400 opacity-100 lg:opacity-0 group-hover/message:opacity-100 transition-opacity focus:opacity-100"
                                                :class="{ 'opacity-100': menuOpen }">
                                            <i data-lucide="more-horizontal" class="w-4 h-4"></i>
                                        </button>
                                        <div x-show="menuOpen" x-transition 
                                             class="absolute bottom-full mb-2 bg-white rounded-xl shadow-xl border border-gray-100 py-1 z-10 w-32"
                                             :class="isOwnMessage(msg) ? 'right-0' : 'left-0'">
                                            <button type="button" @@click="editMessage(msg); menuOpen = false" class="w-full flex items-center gap-2 px-3 py-2 text-xs font-bold text-gray-700 hover:bg-blue-50">
                                                <i data-lucide="edit-2" class="w-3 h-3"></i> Edit
                                            </button>
                                            <button type="button" @@click="deleteMessage(msg); menuOpen = false" class="w-full flex items-center gap-2 px-3 py-2 text-xs font-bold text-rose-600 hover:bg-rose-50">
                                                <i data-lucide="trash-2" class="w-3 h-3"></i> Delete
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </template>
                            
                            <!-- Timestamp & Read Receipt -->
                            <div class="mt-1 flex items-center gap-1 px-1" :class="isOwnMessage(msg) ? 'justify-end' : 'justify-start'">
                                <span class="text-[10px] font-bold text-gray-400" x-text="formatTime(msg.timestamp)"></span>
                                <i x-show="isOwnMessage(msg) && msg.isRead && !msg.isDeleted" data-lucide="check-check" class="w-3 h-3 text-blue-500"></i>
                            </div>
                        </div>
                    </template>
                     <div class="h-2"></div>

                     <!-- Typing Indicator -->
                     <div x-show="isTyping" class="flex items-center gap-2 mb-4 animate-in fade-in slide-in-from-bottom-2 duration-300">
                        <div class="bg-gray-100 px-4 py-3 rounded-full rounded-tl-none flex items-center gap-1.5 shadow-sm">
                             <div class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 0ms"></div>
                             <div class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 150ms"></div>
                             <div class="w-1.5 h-1.5 bg-gray-400 rounded-full animate-bounce" style="animation-delay: 300ms"></div>
                        </div>
                        <span class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest animate-pulse">Doctor is typing...</span>
                     </div>
                </div>
                <!-- Input Area - Fixed at Bottom with Safe Area -->
                <footer class="p-2 md:p-4 lg:p-6 bg-white border-t border-gray-100 shrink-0 z-50 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.05)]" style="padding-bottom: calc(0.5rem + env(safe-area-inset-bottom, 10px));">
                    <form @@submit.prevent="sendMessage" class="relative">
                        <div class="flex items-end gap-2 bg-gray-50 rounded-[1.5rem] lg:rounded-[2rem] px-3 md:px-3 lg:px-4 py-2 md:py-2 lg:py-2 border border-gray-200 md:border-gray-100 focus-within:border-blue-500 focus-within:ring-2 focus-within:ring-blue-500/10 shadow-sm transition-all">
                            <div class="relative pb-0.5">
                                <button type="button" @@click="showAttachmentPicker = !showAttachmentPicker" class="p-2 text-gray-400 hover:text-blue-600 transition-colors">
                                    <i data-lucide="plus" class="w-5 h-5"></i>
                                </button>
                                <div x-show="showAttachmentPicker" @@click.away="showAttachmentPicker = false" 
                                     x-transition class="absolute bottom-full left-0 mb-3 bg-white rounded-2xl shadow-2xl border p-3 w-56 lg:w-64 z-50">
                                    <div class="space-y-1">
                                        <button type="button" @@click="selectAttachmentType('image')" class="w-full flex items-center gap-3 p-2 lg:p-3 hover:bg-purple-50 rounded-xl group transition-colors">
                                            <div class="w-8 h-8 lg:w-10 lg:h-10 bg-purple-100 text-purple-600 rounded-full flex items-center justify-center">
                                                <i data-lucide="image" class="w-4 h-4 lg:w-5 lg:h-5"></i>
                                            </div>
                                            <span class="font-bold text-gray-900 text-xs lg:text-sm">Photo</span>
                                        </button>
                                        <button type="button" @@click="selectAttachmentType('video')" class="w-full flex items-center gap-3 p-2 lg:p-3 hover:bg-rose-50 rounded-xl group transition-colors">
                                            <div class="w-8 h-8 lg:w-10 lg:h-10 bg-rose-100 text-rose-600 rounded-full flex items-center justify-center">
                                                <i data-lucide="video" class="w-4 h-4 lg:w-5 lg:h-5"></i>
                                            </div>
                                            <span class="font-bold text-gray-900 text-xs lg:text-sm">Video</span>
                                        </button>
                                        <button type="button" @@click="selectAttachmentType('document')" class="w-full flex items-center gap-3 p-2 lg:p-3 hover:bg-blue-50 rounded-xl group transition-colors">
                                            <div class="w-8 h-8 lg:w-10 lg:h-10 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center">
                                                <i data-lucide="file-text" class="w-4 h-4 lg:w-5 lg:h-5"></i>
                                            </div>
                                            <span class="font-bold text-gray-900 text-xs lg:text-sm">Document</span>
                                        </button>
                                    </div>
                                </div>
                                <input type="file" x-ref="photoInput" class="hidden" accept="image/*" @@change="handleFile">
                                <input type="file" x-ref="videoInput" class="hidden" accept="video/*" @@change="handleFile">
                                <input type="file" x-ref="documentInput" class="hidden" accept=".pdf,.doc,.docx,.txt" @@change="handleFile">
                            </div>
                            <textarea x-model="newMessage" @@keydown="handleKeyDown" 
                                     placeholder="Type message..." 
                                     class="flex-1 bg-transparent border-none text-sm font-medium focus:ring-0 outline-none resize-none max-h-20 md:max-h-24 lg:max-h-32 min-h-[44px] py-3"
                                     rows="1"></textarea>
                            <div class="pb-0.5">
                                <button type="button" @@click="sendMessage" :disabled="!newMessage.trim() && !pendingFile"
                                        class="p-2 md:p-2 lg:p-2.5 bg-blue-600 text-white rounded-full hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all shadow-md shadow-blue-500/30">
                                    <i data-lucide="send" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                    <div x-show="pendingFile" class="mt-2 md:mt-3 p-2 md:p-2 lg:p-3 bg-blue-50 rounded-2xl border flex items-center justify-between animate-fade-in-up">
                        <div class="flex items-center gap-3 overflow-hidden">
                            <i :data-lucide="getFileIcon(pendingFile)" class="w-4 h-4 lg:w-5 lg:h-5 text-blue-600"></i>
                            <p class="text-[10px] lg:text-xs font-semibold text-gray-900 truncate" x-text="pendingFile?.name"></p>
                        </div>
                        <button type="button" @@click="pendingFile = null" class="p-1 lg:p-2 text-rose-500">
                            <i data-lucide="x" class="w-4 h-4"></i>
                        </button>
                    </div>
                </footer>
            </div>
        </template>
    </main>

</div>

</div>

@section Scripts {
    <script>
    function chatApp() {
        return {
            searchQuery: '',
            activeDoctorId: '@(ViewBag.SelectedDoctorId ?? "")',
            doctors: @Html.Raw(Json.Serialize(Model.AvailableDoctors)),
            messages: [],
            newMessage: '',
            pendingFile: null,
            userId: '@Model.PatientId',
            showAttachmentPicker: false,
            chatHub: null,
            isTyping: false,
            typingTimeout: null,
            
            async init() {
                lucide.createIcons();
                
                try {
                    await this.initSignalR();
                } catch(e) { 
                    console.error('SignalR init failed', e); 
                }
                
                if (this.activeDoctorId) {
                    const doc = this.doctors.find(d => d.id == this.activeDoctorId);
                    if (doc) this.selectDoctor(doc);
                }
                
                this.$watch('messages', () => {
                    this.$nextTick(() => {
                        this.scrollToBottom();
                        lucide.createIcons();
                    });
                });

                // Global call event listeners to log calls in chat
                window.addEventListener('call-ended', (e) => {
                    if (this.activeDoctorId) {
                        this.logCallToChat(e.detail.duration, e.detail.type);
                    }
                });

                window.addEventListener('call-rejected', () => {
                    if (this.activeDoctorId) {
                        this.messages.push({
                            id: Date.now(),
                            senderId: 'system',
                            content: 'Call Declined',
                            messageType: 'Call',
                            timestamp: new Date().toISOString(),
                            isMe: false
                        });
                        this.$nextTick(() => this.scrollToBottom());
                    }
                });
            },

            async logCallToChat(duration, type) {
                const doc = this.doctors.find(d => d.id == this.activeDoctorId);
                if (doc) {
                    const fd = new FormData();
                    fd.append('receiverId', doc.userId);
                    fd.append('message', `${type === 'video' ? 'Video' : 'Voice'} Call • ${duration}`);
                    fd.append('type', 'Call');
                    
                    const res = await fetch('/Dashboard/SendMessage', { method: 'POST', body: fd });
                    const data = await res.json();
                    if (data.success) {
                        this.messages.push(data.message);
                        this.$nextTick(() => this.scrollToBottom());
                    }
                }
            },

            async initSignalR() {
                if (typeof signalR === 'undefined') return;

                this.chatHub = new signalR.HubConnectionBuilder()
                    .withUrl("/chatHub")
                    .withAutomaticReconnect()
                    .build();

                // Typing Indicators
                this.chatHub.on("UserIsTyping", (senderId) => {
                    const doc = this.doctors.find(d => d.userId?.toLowerCase() === senderId?.toLowerCase());
                    if (doc && doc.id == this.activeDoctorId) {
                        this.isTyping = true;
                        this.$nextTick(() => this.scrollToBottom());
                    }
                });

                this.chatHub.on("UserStoppedTyping", (senderId) => {
                    const doc = this.doctors.find(d => d.userId?.toLowerCase() === senderId?.toLowerCase());
                    if (doc && doc.id == this.activeDoctorId) {
                        this.isTyping = false;
                    }
                });

                // Read Receipts
                this.chatHub.on("MessagesRead", (readerId) => {
                    const doc = this.doctors.find(d => d.userId === readerId);
                    if (doc && doc.id == this.activeDoctorId) {
                        this.messages.forEach(m => {
                            if (this.isOwnMessage(m)) m.isRead = true;
                        });
                    }
                });

                this.chatHub.on("ReceiveMessage", (senderId, message, type, url, name, actualSenderId) => {
                    if (actualSenderId === this.userId) return;

                    const senderDoc = this.doctors.find(d => d.userId === actualSenderId);
                    const isRelevant = (senderDoc && senderDoc.id == this.activeDoctorId) || actualSenderId === this.userId;
                    
                    if (isRelevant) {
                        const msgObj = {
                            id: Date.now(),
                            senderId: actualSenderId,
                            content: message,
                            messageType: type === 'Call' ? 'Call' : 'Text',
                            timestamp: new Date().toISOString(),
                            attachmentUrl: url,
                            attachmentType: type === 'image' || (type && type.toLowerCase() === 'image') ? 'Image' : 
                                            (type === 'video' || (type && type.toLowerCase() === 'video') ? 'Video' : 
                                            (url && type !== 'Call' ? 'Document' : null)),
                            attachmentName: name,
                            isMe: actualSenderId === this.userId
                        };
                        this.messages.push(msgObj);
                        this.$nextTick(() => this.scrollToBottom());
                        
                        if (actualSenderId !== this.userId && senderDoc && senderDoc.id == this.activeDoctorId) {
                            this.markAsRead();
                        }
                    } else if (senderDoc) {
                        senderDoc.unreadCount = (senderDoc.unreadCount || 0) + 1;
                        this.doctors = [senderDoc, ...this.doctors.filter(d => d.id !== senderDoc.id)];
                    }
                });

                await this.chatHub.start();
                if (this.activeDoctorId) this.markAsRead();
            },

            get filteredDoctors() {
                if (!this.searchQuery) return this.doctors;
                const q = this.searchQuery.toLowerCase();
                return this.doctors.filter(d => 
                    d.name.toLowerCase().includes(q) || d.specialty.toLowerCase().includes(q)
                );
            },

            get activeDoctor() {
                return this.doctors.find(d => d.id == this.activeDoctorId) || {};
            },

            selectDoctor(doctor) {
                this.activeDoctorId = doctor.id;
                doctor.unreadCount = 0;
                this.messages = []; 
                this.loadMessages();
            },

            async loadMessages() {
                try {
                    let url = `/Dashboard/GetConversation?doctorId=${this.activeDoctorId}`;
                    if (this.activeDoctorId == -1) {
                         const doc = this.doctors.find(d => d.id == -1);
                         url = `/Dashboard/GetConversation?otherUserId=${doc.userId}`;
                    }
                    const res = await fetch(url);
                    if (res.ok) {
                        this.messages = await res.json();
                    }
                } catch (err) { console.error(err); }
            },

            async sendMessage() {
                if ((!this.newMessage.trim() && !this.pendingFile) || !this.activeDoctorId) return;

                const fd = new FormData();
                if (this.activeDoctorId == -1) {
                    const doc = this.doctors.find(d => d.id == -1);
                    fd.append('receiverId', doc.userId);
                } else {
                    fd.append('doctorId', this.activeDoctorId);
                }
                fd.append('content', this.newMessage);
                if (this.pendingFile) fd.append('attachment', this.pendingFile);

                const temp = this.newMessage; this.newMessage = ''; this.pendingFile = null;
                try {
                    const res = await fetch('/Dashboard/SendMessage', { method: 'POST', body: fd });
                    if (res.ok) {
                        const data = await res.json();
                        if (data.success) {
                            if (Array.isArray(this.messages)) this.messages.push(data.message);
                            else this.messages = [data.message];
                        }
                    } else { this.newMessage = temp; }
                } catch (err) { this.newMessage = temp; }
            },

            selectAttachmentType(type) {
                this.showAttachmentPicker = false;
                if (type === 'image') this.$refs.photoInput.click();
                else if (type === 'video') this.$refs.videoInput.click();
                else if (type === 'document') this.$refs.documentInput.click();
            },

            handleFile(e) {
                if (e.target.files.length) this.pendingFile = e.target.files[0];
            },

            getFileIcon(file) {
                if (!file) return 'file';
                if (file.type.startsWith('image/')) return 'image';
                if (file.type.startsWith('video/')) return 'video';
                return 'file-text';
            },

            startCall(type) {
                if (!this.activeDoctorId) return;
                const doc = this.doctors.find(d => d.id == this.activeDoctorId);
                if (doc) {
                    window.dispatchEvent(new CustomEvent('call-initiated', { 
                        detail: { 
                            targetId: doc.userId, 
                            targetName: doc.name, 
                            type 
                        } 
                    }));
                }
            },

            async markAsRead() {
                if (!this.activeDoctorId || !this.chatHub) return;
                const doc = this.doctors.find(d => d.id == this.activeDoctorId);
                if (doc) {
                    await fetch(`/Dashboard/MarkMessagesAsRead?doctorId=${this.activeDoctorId}`, { method: 'POST' });
                    this.chatHub.invoke("MarkMessagesAsRead", doc.userId).catch(err => console.error(err));
                }
            },

            async editMessage(message) {
                const n = await PremiumModal.prompt('Update message:', message.content, 'Edit');
                if (n && n !== message.content) {
                    const fd = new FormData(); fd.append('messageId', message.id); fd.append('content', n);
                    const r = await fetch('/Dashboard/EditMessage', { method: 'POST', body: fd });
                    if ((await r.json()).success) message.content = n;
                }
            },

            async deleteMessage(message) {
                const confirmed = await PremiumModal.confirm('Delete this message?', 'Delete');
                if (confirmed) {
                    const r = await fetch(`/Dashboard/DeleteMessage?messageId=${message.id}`, { method: 'POST' });
                    if ((await r.json()).success) message.isDeleted = true;
                }
            },

            handleKeyDown(e) {
                if (!this.activeDoctorId || !this.chatHub) return;
                if (!this.typingTimeout) {
                    const doc = this.doctors.find(d => d.id == this.activeDoctorId);
                    if (doc) this.chatHub.invoke("UserTyping", doc.userId).catch(err => console.error(err));
                }
                if (this.typingTimeout) clearTimeout(this.typingTimeout);
                this.typingTimeout = setTimeout(() => {
                    const doc = this.doctors.find(d => d.id == this.activeDoctorId);
                    if (doc) this.chatHub.invoke("UserStoppedTyping", doc.userId).catch(err => console.error(err));
                    this.typingTimeout = null;
                }, 2000);
                if (e.key === 'Enter' && !e.shiftKey) this.sendMessage();
            },

            scrollToBottom() {
                const c = document.getElementById('message-container');
                if (c) c.scrollTop = c.scrollHeight;
            },

            formatTime(ts) {
                return new Date(ts).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            },

            isOwnMessage(msg) { return msg.senderId === this.userId; }
        }
    }

    // Draggable PiP Logic removed - Handled by _GlobalCallOverlay
    </script>

    <style>
        [x-cloak] { display: none !important; }
        .animate-bounce-slow { animation: bounce 3s infinite; }
        @@keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
        .animate-fade-in-up { animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
        @@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #E2E8F0; border-radius: 10px; }
    </style>
}
