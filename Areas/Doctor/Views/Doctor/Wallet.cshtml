@model IEnumerable<MedLinkPortal.Models.WalletTransaction>
@{
    ViewData["Title"] = "Earning & Wallet";
    Layout = "_DocDash";
    decimal balance = ViewBag.WalletBalance ?? 0;
}

<!-- Toastify CSS -->
<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">

<div class="space-y-6 lg:space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <!-- Premium Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="text-3xl md:text-4xl font-semibold text-gray-900 tracking-tight">Earnings <span class="text-blue-600">& Wallet</span></h1>
            <p class="text-sm md:text-base text-gray-500 font-medium mt-1">Manage your professional earnings and withdrawal requests.</p>
        </div>
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div class="bg-white border border-gray-100 rounded-2xl px-6 py-3 shadow-sm text-center sm:text-left">
                <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest mb-0.5">Available Balance</p>
                <p class="text-2xl font-semibold text-blue-600">PKR @balance.ToString("N2")</p>
            </div>
            <button onclick="openWithdrawModal()" class="px-8 py-4 bg-gray-900 text-white rounded-2xl font-semibold text-xs md:text-sm uppercase tracking-widest hover:bg-blue-600 hover:-translate-y-1 active:scale-95 transition-all shadow-xl shadow-gray-900/10 flex items-center justify-center gap-2">
                <i data-lucide="arrow-up-right" class="w-5 h-5"></i>
                Withdraw
            </button>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6">
        <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm group hover:shadow-xl transition-all">
            <div class="w-12 h-12 bg-emerald-50 rounded-2xl flex items-center justify-center text-emerald-600 mb-4 group-hover:scale-110 transition-transform">
                <i data-lucide="trending-up" class="w-6 h-6"></i>
            </div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest mb-1">Total Earnings</p>
            <p class="text-2xl md:text-3xl font-semibold text-gray-900">PKR @Model.Where(t => t.TransactionType == "EARNING").Sum(t => t.Amount).ToString("N0")</p>
        </div>
        <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm group hover:shadow-xl transition-all">
            <div class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-600 mb-4 group-hover:scale-110 transition-transform">
                <i data-lucide="clock" class="w-6 h-6"></i>
            </div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest mb-1">Pending Withdrawals</p>
            <p class="text-2xl md:text-3xl font-semibold text-gray-900">PKR @Model.Where(t => t.TransactionType == "WITHDRAWAL" && t.Status == "Pending").Sum(t => t.Amount).ToString("N0")</p>
        </div>
        <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm group hover:shadow-xl transition-all">
            <div class="w-12 h-12 bg-gray-50 rounded-2xl flex items-center justify-center text-gray-600 mb-4 group-hover:scale-110 transition-transform">
                <i data-lucide="history" class="w-6 h-6"></i>
            </div>
            <p class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest mb-1">Total Withdrawn</p>
            <p class="text-2xl md:text-3xl font-semibold text-gray-900">PKR @Model.Where(t => t.TransactionType == "WITHDRAWAL" && t.Status == "Approved").Sum(t => t.Amount).ToString("N0")</p>
        </div>
    </div>

    <!-- Mobile Transaction Cards (Visual < md) -->
    <div class="md:hidden space-y-4">
        <h3 class="text-lg font-semibold text-gray-900 px-2">Recent Activity</h3>
        @if (!Model.Any())
        {
             <div class="flex flex-col items-center justify-center p-8 bg-white rounded-3xl border border-dashed border-gray-200">
                <div class="w-16 h-16 bg-gray-50 rounded-full flex items-center justify-center text-gray-300 mb-4">
                    <i data-lucide="database" class="w-8 h-8"></i>
                </div>
                <p class="text-sm font-semibold text-gray-900">No transactions</p>
            </div>
        }
        @foreach (var tx in Model)
        {
            <div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-sm">
                <div class="flex items-center justify-between mb-4">
                     <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-2xl bg-gray-50 flex items-center justify-center text-gray-400">
                            <i data-lucide="@(tx.TransactionType == "EARNING" ? "plus-circle" : "minus-circle")" class="w-5 h-5"></i>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-gray-900">#TX-@tx.Id</p>
                            <p class="text-[10px] font-bold text-gray-400">@tx.TransactionDate.ToString("MMM dd, HH:mm")</p>
                        </div>
                    </div>
                    <span class="px-3 py-1 rounded-lg text-[9px] font-semibold uppercase tracking-widest @(tx.TransactionType == "EARNING" ? "bg-emerald-50 text-emerald-600" : "bg-rose-50 text-rose-600")">
                        @tx.TransactionType
                    </span>
                </div>
                
                <div class="mb-4">
                     <p class="text-xs font-bold text-gray-700">@tx.Description</p>
                     @if (tx.AppointmentId.HasValue)
                    {
                        <p class="text-[9px] font-bold text-blue-600 uppercase tracking-tighter mt-1">Ref: #@tx.AppointmentId</p>
                    }
                </div>

                <div class="flex items-center justify-between pt-4 border-t border-gray-50">
                    <span class="px-3 py-1 rounded-full text-[9px] font-semibold uppercase tracking-widest border @(tx.Status == "Approved" || tx.Status == "Completed" ? "bg-emerald-50 text-emerald-600 border-emerald-100" : tx.Status == "Pending" ? "bg-amber-50 text-amber-600 border-amber-100" : "bg-rose-50 text-rose-600 border-rose-100")">
                        @tx.Status
                    </span>
                    <p class="text-sm font-semibold @(tx.TransactionType == "EARNING" ? "text-emerald-600" : "text-rose-600")">
                        @(tx.TransactionType == "EARNING" ? "+" : "-") PKR @tx.Amount.ToString("N0")
                    </p>
                </div>
            </div>
        }
    </div>

    <!-- Transactions Table (Hidden < md) -->
    <div class="hidden md:block bg-white rounded-[2.5rem] border border-gray-100 shadow-sm overflow-hidden">
        <div class="p-8 border-b border-gray-50 flex items-center justify-between">
            <h3 class="text-xl font-semibold text-gray-900">Transaction History</h3>
            <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
                <span class="text-xs font-bold text-gray-500">Automatic Sync Active</span>
            </div>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="text-left bg-gray-50/50">
                        <th class="px-8 py-5 text-[10px] font-semibold text-gray-400 uppercase tracking-widest">Date / ID</th>
                        <th class="px-8 py-5 text-[10px] font-semibold text-gray-400 uppercase tracking-widest">Description</th>
                        <th class="px-8 py-5 text-[10px] font-semibold text-gray-400 uppercase tracking-widest">Type</th>
                        <th class="px-8 py-5 text-[10px] font-semibold text-gray-400 uppercase tracking-widest">Amount</th>
                        <th class="px-8 py-5 text-[10px] font-semibold text-gray-400 uppercase tracking-widest text-center">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-8 py-20 text-center">
                                <div class="flex flex-col items-center">
                                    <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center text-gray-300 mb-4">
                                        <i data-lucide="database" class="w-10 h-10"></i>
                                    </div>
                                    <p class="text-gray-900 font-semibold">No transactions found</p>
                                    <p class="text-gray-400 text-sm font-medium">Your earnings will appear here once patients start paying.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var tx in Model)
                    {
                        <tr class="group hover:bg-gray-50/50 transition-all">
                            <td class="px-8 py-6">
                                <p class="text-sm font-semibold text-gray-900">#TX-@tx.Id</p>
                                <p class="text-[10px] font-bold text-gray-400">@tx.TransactionDate.ToString("MMM dd, yyyy HH:mm")</p>
                            </td>
                            <td class="px-8 py-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-gray-50 flex items-center justify-center text-gray-400 group-hover:text-blue-600 transition-colors">
                                        <i data-lucide="@(tx.TransactionType == "EARNING" ? "plus-circle" : "minus-circle")" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold text-gray-900">@tx.Description</p>
                                        @if (tx.AppointmentId.HasValue)
                                        {
                                            <p class="text-[10px] font-bold text-blue-600 uppercase tracking-tighter">Appt Ref: #@tx.AppointmentId</p>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-6">
                                <span class="px-3 py-1 rounded-lg text-[10px] font-semibold uppercase tracking-widest @(tx.TransactionType == "EARNING" ? "bg-emerald-50 text-emerald-600" : "bg-rose-50 text-rose-600")">
                                    @tx.TransactionType
                                </span>
                            </td>
                            <td class="px-8 py-6">
                                <p class="text-base font-semibold @(tx.TransactionType == "EARNING" ? "text-emerald-600" : "text-rose-600")">
                                    @(tx.TransactionType == "EARNING" ? "+" : "-") PKR @tx.Amount.ToString("N2")
                                </p>
                            </td>
                            <td class="px-8 py-6 text-center">
                                <span class="px-4 py-1.5 rounded-full text-[9px] font-semibold uppercase tracking-widest border @(tx.Status == "Approved" || tx.Status == "Completed" ? "bg-emerald-50 text-emerald-600 border-emerald-100" : tx.Status == "Pending" ? "bg-amber-50 text-amber-600 border-amber-100" : "bg-rose-50 text-rose-600 border-rose-100")">
                                    @tx.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Withdraw Modal -->
<div id="withdrawModal" class="fixed inset-0 hidden items-center justify-center z-[100] p-4">
    <div class="absolute inset-0 bg-gray-900/60 backdrop-blur-sm" onclick="closeWithdrawModal()"></div>
    <div class="relative bg-white rounded-[2.5rem] w-full max-w-sm shadow-2xl animate-in zoom-in duration-300">
        <div class="p-8 border-b border-gray-50">
            <h3 class="text-2xl font-semibold text-gray-900 tracking-tight">Withdraw <span class="text-blue-600">Funds</span></h3>
            <p class="text-gray-500 text-sm font-medium mt-1">Submit a request to withdraw your earnings.</p>
        </div>
        <form id="withdrawForm" class="p-8 space-y-6">
            <div class="space-y-2">
                <label class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest px-1">Amount to Withdraw (PKR)</label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 font-semibold text-gray-400">PKR</span>
                    <input type="number" name="amount" step="1" min="100" max="@balance" value="@(balance > 100 ? balance : 0)" 
                           class="w-full pl-14 pr-4 py-4 bg-gray-50 border border-gray-100 rounded-2xl font-semibold text-gray-900 focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all">
                </div>
                <p class="text-[10px] font-bold text-gray-400 px-1">Maximum available: PKR @balance.ToString("N2")</p>
            </div>

            <!-- Platform Fee Info -->
            <div id="feeBreakdown" class="hidden space-y-3 p-4 bg-gray-50 rounded-2xl border border-gray-200">
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-gray-600">Requested Amount</span>
                    <span id="requestedAmount" class="text-sm font-semibold text-gray-900">PKR 0.00</span>
                </div>
                <div class="flex justify-between items-center">
                    <span class="text-xs font-bold text-gray-600">Platform Fee (2%)</span>
                    <span id="platformFeeAmount" class="text-sm font-semibold text-rose-600">- PKR 0.00</span>
                </div>
                <div class="h-px bg-gray-300"></div>
                <div class="flex justify-between items-center">
                    <span class="text-xs font-semibold text-gray-900">You Will Receive</span>
                    <span id="netAmountDisplay" class="text-lg font-semibold text-emerald-600">PKR 0.00</span>
                </div>
            </div>

            <div class="p-4 bg-blue-50 rounded-2xl border border-blue-100">
                <div class="flex gap-3">
                    <i data-lucide="info" class="w-5 h-5 text-blue-600 flex-shrink-0"></i>
                    <p class="text-[10px] text-blue-700 font-bold leading-relaxed">
                        Withdrawals are typically processed within 24-48 business hours to your registered bank account. A 2% platform fee will be deducted.
                    </p>
                </div>
            </div>

            <div class="flex gap-3">
                <button type="button" onclick="closeWithdrawModal()" class="flex-1 py-4 bg-gray-100 text-gray-600 rounded-2xl font-semibold text-xs uppercase tracking-widest hover:bg-gray-200 transition-all">
                    Cancel
                </button>
                <button type="submit" class="flex-2 px-8 py-4 bg-gray-900 text-white rounded-2xl font-semibold text-xs uppercase tracking-widest hover:bg-blue-600 hover:-translate-y-1 active:scale-95 transition-all shadow-lg">
                    Submit Request
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="fixed inset-0 hidden items-center justify-center z-[110] p-4">
    <div class="absolute inset-0 bg-gray-900/60 backdrop-blur-md"></div>
    <div class="relative bg-white rounded-[3rem] w-full max-w-sm shadow-2xl p-10 text-center animate-in zoom-in duration-500">
        <div class="w-24 h-24 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-6 text-emerald-600">
            <i data-lucide="check-circle-2" class="w-12 h-12 stroke-[2.5]"></i>
        </div>
        <h3 class="text-3xl font-semibold text-gray-900 tracking-tight mb-2">Success!</h3>
        <p class="text-gray-500 font-medium mb-8 leading-relaxed">
            Your withdrawal request has been submitted successfully and the amount has been deducted from your balance.
        </p>
        <button onclick="location.reload()" class="w-full py-5 bg-gray-900 text-white rounded-2xl font-semibold text-sm uppercase tracking-widest hover:bg-emerald-600 hover:-translate-y-1 active:scale-95 transition-all shadow-xl shadow-emerald-500/20">
            Great, Thanks!
        </button>
    </div>
</div>

@section Scripts {
    <!-- Toastify JS -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    
    <script>
        lucide.createIcons();

        function openWithdrawModal() {
            const $modal = document.getElementById('withdrawModal');
            $modal.classList.remove('hidden');
            $modal.classList.add('flex');
        }

        function closeWithdrawModal() {
            const $modal = document.getElementById('withdrawModal');
            $modal.classList.remove('flex');
            $modal.classList.add('hidden');
        }

        // Calculate and display platform fee
        const amountInput = document.querySelector('input[name="amount"]');
        const feeBreakdown = document.getElementById('feeBreakdown');
        const requestedAmountEl = document.getElementById('requestedAmount');
        const platformFeeEl = document.getElementById('platformFeeAmount');
        const netAmountEl = document.getElementById('netAmountDisplay');

        amountInput.addEventListener('input', (e) => {
            const amount = parseFloat(e.target.value) || 0;
            if (amount > 0) {
                const platformFee = Math.round(amount * 0.02 * 100) / 100;
                const netAmount = amount - platformFee;
                
                requestedAmountEl.textContent = `PKR ${amount.toFixed(2)}`;
                platformFeeEl.textContent = `- PKR ${platformFee.toFixed(2)}`;
                netAmountEl.textContent = `PKR ${netAmount.toFixed(2)}`;
                
                feeBreakdown.classList.remove('hidden');
            } else {
                feeBreakdown.classList.add('hidden');
            }
        });

        document.getElementById('withdrawForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const amount = formData.get('amount');

            try {
                const response = await fetch('/Doctor/Doctor/RequestWithdrawal', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: `amount=${amount}`
                });

                const result = await response.json();
                if (result.success) {
                    closeWithdrawModal();
                    
                    // Show success modal as per requirement
                    const $successModal = document.getElementById('successModal');
                    $successModal.classList.remove('hidden');
                    $successModal.classList.add('flex');

                    // Optional: auto reload after 5 seconds if they don't click
                    setTimeout(() => location.reload(), 5000);
                } else {
                    Toastify({
                        text: result.message,
                        duration: 4000,
                        gravity: "top",
                        position: "right",
                        style: {
                            background: "linear-gradient(135deg, #ef4444, #dc2626)",
                            borderRadius: "16px",
                            padding: "16px 24px",
                            fontWeight: "bold",
                            fontSize: "14px"
                        }
                    }).showToast();
                }
            } catch (error) {
                Toastify({
                    text: "An error occurred. Please try again.",
                    duration: 4000,
                    gravity: "top",
                    position: "right",
                    style: {
                        background: "linear-gradient(135deg, #ef4444, #dc2626)",
                        borderRadius: "16px",
                        padding: "16px 24px",
                        fontWeight: "bold",
                        fontSize: "14px"
                    }
                }).showToast();
            }
        });
    </script>
}
