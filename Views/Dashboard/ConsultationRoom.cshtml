            <p class="text-[10px] font-bold text-blue-400 uppercase tracking-widest mb-1">DOCTOR</p>
            <p class="font-bold text-lg text-gray-900">Dr. @doctorName</p>
            <p class="text-sm text-gray-600">General Practitioner</p>
        </div>
        <div class="text-right">
            <p class="text-[10px] font-bold text-blue-400 uppercase tracking-widest mb-1">PATIENT</p>
            <p class="font-bold text-lg text-gray-900">@patientName</p>
            <p class="text-sm text-gray-600">ID: #@(ViewBag.CurrentUserId != null ? ViewBag.CurrentUserId.ToString().Substring(0,8) : "N/A")</p>
