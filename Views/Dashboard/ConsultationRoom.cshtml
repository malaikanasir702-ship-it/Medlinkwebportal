@model MedLinkPortal.Models.PatientDashboardModel
@{
    var isDoctor = User.IsInRole("Doctor");
    Layout = isDoctor ? "~/Areas/Doctor/Views/Shared/_DocDash.cshtml" : "_DashboardLayout";
    ViewData["Title"] = "Consultation Room";
    var appointmentId = ViewBag.AppointmentId;
    var doctorName = ViewBag.DoctorName;
    var doctorImage = ViewBag.DoctorImage;
    var patientName = ViewBag.PatientName;
}

<!-- Main Responsive Container -->
<div class="min-h-[calc(100vh-140px)] flex flex-col gap-4 lg:gap-5 pb-20 lg:pb-0">
    <!-- Room Header -->
    <div class="bg-white/80 backdrop-blur-xl rounded-3xl p-4 border border-white/20 shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="flex items-center gap-4 w-full md:w-auto">
            <div class="relative shrink-0">
                <img src="@doctorImage" class="w-12 h-12 rounded-2xl object-cover shadow-lg border-2 border-white" alt="@doctorName">
                <div class="absolute -bottom-1 -right-1 bg-green-500 w-3.5 h-3.5 rounded-full border-2 border-white"></div>
            </div>
            <div class="min-w-0 flex-1">
                <h3 class="font-bold text-gray-900 truncate">Consultation with @doctorName</h3>
                <p class="text-xs text-blue-600 font-medium flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-600 animate-pulse shrink-0"></span>
                    <span class="truncate">Live Consultation • @patientName</span>
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3 w-full md:w-auto">
            <div id="callTimer" class="flex-1 md:flex-none text-center bg-gray-50 px-4 py-2 rounded-xl text-sm font-semibold text-gray-700 font-mono border border-gray-100">
                00:00:00
            </div>
            <button type="button" id="leaveCall" class="flex-1 md:flex-none justify-center px-5 py-2 bg-rose-50 text-rose-600 font-bold rounded-xl hover:bg-rose-100 transition-all border border-rose-100 flex items-center gap-2">
                <i data-lucide="phone-off" class="w-4 h-4"></i> <span>Leave</span>
            </button>
        </div>
    </div>

    <!-- Main Content Area: Stack on mobile, Grid on large screens -->
    <div class="flex flex-col lg:grid lg:grid-cols-12 gap-5 min-h-0">
        
        <!-- Left Column: Video & Prescription -->
        <div class="lg:col-span-8 flex flex-col gap-5 order-1">
            <!-- Video Container -->
            <div class="w-full aspect-[4/5] md:aspect-video lg:h-[500px] lg:aspect-auto bg-white rounded-[2rem] relative overflow-hidden group shadow-xl border border-gray-100 shrink-0">
                <!-- Main Video Stream -->
                <div id="remoteVideoContainer" class="w-full h-full flex items-center justify-center p-1">
                    <div class="w-full h-full bg-slate-900 rounded-[1.8rem] flex flex-col items-center justify-center gap-4 relative overflow-hidden">
                        <div class="skeleton-stream animate-pulse flex flex-col items-center gap-4 z-10 px-4 text-center">
                            <div class="w-16 h-16 md:w-20 md:h-20 bg-white/10 backdrop-blur-md rounded-full flex items-center justify-center border border-white/10">
                                <i data-lucide="video" class="w-8 h-8 md:w-10 md:h-10 text-white/40"></i>
                            </div>
                            <p class="text-white/60 font-medium text-sm md:text-base">Waiting for participant to join...</p>
                        </div>
                        <!-- Background decoration -->
                        <div class="absolute top-0 left-0 w-full h-full bg-gradient-to-br from-blue-600/10 to-purple-600/10 opacity-50"></div>
                    </div>
                </div>

                <!-- Local Video Stream (PiP) -->
                <div id="draggableSelfVideo" class="absolute bottom-4 right-4 md:bottom-6 md:right-6 w-28 md:w-40 aspect-[3/4] md:aspect-video bg-gray-900 rounded-xl md:rounded-2xl overflow-hidden border-2 border-white/20 shadow-2xl z-40 cursor-grab active:cursor-grabbing select-none transition-shadow hover:shadow-blue-500/20" style="touch-action: none;">
                    <div id="localVideoContainer" class="w-full h-full">
                         <div class="w-full h-full animate-pulse bg-gray-800 flex items-center justify-center">
                             <i data-lucide="user" class="w-5 h-5 md:w-6 md:h-6 text-gray-700"></i>
                         </div>
                    </div>
                </div>

                <!-- Video Controls (Center Bottom) -->
                <!-- Video Controls (Center Bottom) -->
                <div class="absolute bottom-4 left-4 md:bottom-6 md:left-6 right-auto flex items-center gap-2 md:gap-3 p-1.5 bg-white/90 backdrop-blur-md rounded-xl md:rounded-2xl border border-gray-100 shadow-xl z-20 transition-all">
                    <button id="btnMute" class="control-btn p-2.5 md:p-3 bg-gray-50 hover:bg-blue-50 hover:text-blue-600 rounded-lg md:rounded-xl text-gray-400 transition-all"><i data-lucide="mic" class="w-4 h-4 md:w-5 md:h-5"></i></button>
                    <button id="btnVideo" class="control-btn p-2.5 md:p-3 bg-gray-50 hover:bg-blue-50 hover:text-blue-600 rounded-lg md:rounded-xl text-gray-400 transition-all"><i data-lucide="video" class="w-4 h-4 md:w-5 md:h-5"></i></button>
                    <div class="w-px h-5 md:h-6 bg-gray-100 mx-0.5 md:mx-1"></div>
                    <button id="btnEndCall" class="p-2.5 md:p-3 bg-rose-500 hover:bg-rose-600 rounded-lg md:rounded-xl text-white shadow-lg shadow-rose-500/20 transition-all"><i data-lucide="phone-off" class="w-4 h-4 md:w-5 md:h-5"></i></button>
                </div>
            </div>

            <!-- Bottom: Prescription / Notes -->
            <div class="bg-white rounded-3xl p-4 md:p-6 border border-gray-100 shadow-xl flex flex-col gap-5 relative overflow-hidden order-3 lg:order-2">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 relative z-10">
                    <h4 class="font-bold text-gray-900 flex items-center gap-2">
                        <i data-lucide="file-text" class="text-blue-600 w-5 h-5"></i>
                        Digital Prescription
                    </h4>
                    <div class="flex items-center gap-2 self-start sm:self-auto">
                        <span id="prescriptionStatus" class="text-[10px] bg-blue-50 text-blue-600 px-3 py-1 rounded-full font-bold uppercase tracking-wider">Live Syncing</span>
                        <div class="w-1.5 h-1.5 rounded-full bg-blue-500 animate-ping"></div>
                    </div>
                </div>

                <!-- Doctor View (Interactive Form) -->
                <div id="doctorPrescription" class="hidden flex flex-col md:grid md:grid-cols-12 gap-6 relative z-10">
                    <div class="md:col-span-5 space-y-3">
                        <label class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest flex items-center gap-1.5">
                            <i data-lucide="activity" class="w-3 h-3"></i> Diagnosis
                        </label>
                        <textarea id="diagnosis" class="w-full p-4 bg-gray-50 border border-gray-100 rounded-2xl text-sm focus:ring-4 focus:ring-blue-500/5 focus:border-blue-400 focus:bg-white transition-all outline-none resize-none h-32" placeholder="Enter clinical diagnosis details..."></textarea>
                    </div>
                    <div class="md:col-span-7 space-y-3">
                        <label class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest flex items-center justify-between">
                            <span class="flex items-center gap-1.5"><i data-lucide="pill" class="w-3 h-3"></i> Medications</span>
                            <button type="button" id="addMedication" class="text-blue-600 hover:text-blue-700 flex items-center gap-1 transition-colors">
                                <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i> Add
                            </button>
                        </label>
                        <div id="medicationList" class="space-y-2 max-h-32 overflow-y-auto pr-2 custom-scrollbar">
                           <!-- Dynamic medications -->
                        </div>
                    </div>
                </div>

                <!-- Professional Prescription Card (Visible to both, content syncs) -->
                <div id="prescriptionCard" class="flex flex-col xl:flex-row items-start xl:items-center justify-between gap-6 p-4 md:p-6 bg-blue-50/50 rounded-2xl border border-blue-100/50 relative z-10 w-full mt-4">
                    <div class="space-y-4 flex-1 w-full">
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 md:w-12 md:h-12 bg-white rounded-xl shadow-sm flex shrink-0 items-center justify-center text-blue-600 border border-blue-100">
                                <i data-lucide="scroll-text" class="w-5 h-5 md:w-6 md:h-6"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <h5 class="font-bold text-gray-900 text-base md:text-lg truncate">Electronic Health Record</h5>
                                    <span id="actionFeedback" class="text-[10px] font-bold text-emerald-600 animate-pulse hidden">Success!</span>
                                </div>
                                <p id="patientDiagnosisDisplay" class="text-xs md:text-sm text-gray-600 break-words line-clamp-2">Waiting for doctor to finalize diagnosis...</p>
                            </div>
                        </div>
                        <div id="patientMedicationDisplay" class="flex flex-wrap gap-2">
                             <!-- Patient meds display -->
                             <span class="text-xs text-gray-400 italic">No medications added yet</span>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 md:grid-cols-3 xl:flex xl:flex-col gap-2 w-full xl:w-auto">
                        <button type="button" id="btnSaveRecord" onclick="handlePrescriptionAction(event, 'save')" class="w-full py-2.5 bg-white text-gray-700 font-bold text-xs rounded-xl border border-gray-100 hover:border-blue-500 hover:text-blue-600 transition-all flex items-center justify-center gap-2 shadow-sm">
                            <i data-lucide="database" class="w-3.5 h-3.5"></i> Save
                        </button>
                        <button type="button" onclick="handlePrescriptionAction(event, 'download')" class="w-full py-2.5 bg-blue-600 text-white font-bold text-xs rounded-xl hover:bg-blue-700 transition-all flex items-center justify-center gap-2 shadow-lg shadow-blue-500/20">
                            <i data-lucide="download" class="w-3.5 h-3.5"></i> PDF
                        </button>
                        <button type="button" onclick="handlePrescriptionAction(event, 'share')" class="col-span-2 md:col-span-1 w-full py-2.5 bg-white text-gray-700 font-bold text-xs rounded-xl border border-gray-100 hover:border-gray-900 transition-all flex items-center justify-center gap-2 shadow-sm">
                            <i data-lucide="share-2" class="w-3.5 h-3.5"></i> Share
                        </button>
                        @if (!isDoctor)
                        {
                            <a href="/Pharmacy/Checkout/@appointmentId" id="btnBuyMedicines" class="col-span-2 w-full py-3 bg-emerald-600 text-white font-bold text-xs rounded-xl hover:bg-emerald-700 transition-all flex items-center justify-center gap-2 shadow-lg shadow-emerald-500/20 mt-2">
                                <i data-lucide="shopping-cart" class="w-4 h-4"></i> Buy Prescribed Medicines
                            </a>
                        }
                    </div>
                </div>

                <!-- Background Abstract -->
                <div class="absolute -right-20 -bottom-20 w-64 h-64 bg-blue-50 rounded-full blur-3xl -z-0 opacity-50"></div>
            </div>
        </div>

        <!-- Right: Chat Area (Stacks bottom on mobile) -->
        <div class="lg:col-span-4 flex flex-col bg-white rounded-[2rem] border border-gray-100 shadow-xl h-[450px] lg:h-auto overflow-hidden order-2 lg:order-3">
            <div class="p-2 border-b border-gray-50 bg-gray-50/30">
                <div class="flex items-center gap-1">
                    <button onclick="switchTab('chat')" id="tab-chat" class="flex-1 py-3 px-4 rounded-2xl flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-widest transition-all bg-white text-blue-600 shadow-sm border border-gray-100">
                        <i data-lucide="message-circle" class="w-4 h-4"></i> Chat
                    </button>
                    <button onclick="switchTab('transcript')" id="tab-transcript" class="flex-1 py-3 px-4 rounded-2xl flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-widest transition-all text-gray-400 hover:text-gray-600">
                        <i data-lucide="languages" class="w-4 h-4"></i> Transcript
                    </button>
                </div>
            </div>

            <!-- Chat Content -->
            <div id="chat-content" class="flex flex-col flex-1 overflow-hidden">
                <div id="chatMessages" class="flex-1 overflow-y-auto p-4 md:p-6 space-y-4 scrollbar-hide">
                <!-- System Message -->
                <div class="flex justify-center">
                    <span class="text-[10px] font-bold text-gray-400 bg-gray-50 px-3 py-1 rounded-full uppercase tracking-widest text-center">
                        Meeting started at @DateTime.Now.ToString("hh:mm tt")
                    </span>
                </div>
                
                <!-- Skeleton Chat -->
                <div class="skeleton-chat space-y-4">
                    <div class="flex items-start gap-3">
                        <div class="w-8 h-8 rounded-full bg-gray-100 animate-pulse"></div>
                        <div class="space-y-1">
                            <div class="w-32 h-8 bg-gray-50 rounded-2xl rounded-tl-none animate-pulse"></div>
                            <div class="w-12 h-2 bg-gray-100 rounded animate-pulse"></div>
                        </div>
                    </div>
                </div>
                </div>
            </div>

            <!-- Transcription Content (Hidden by default) -->
            <div id="transcript-content" class="hidden flex flex-col flex-1 overflow-hidden bg-slate-900 font-mono">
                <div class="p-4 border-b border-white/5 flex items-center justify-between bg-white/5">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-blue-500 animate-pulse shadow-[0_0_10px_rgba(59,130,246,0.5)]"></div>
                        <span class="text-[9px] font-semibold text-white/70 uppercase tracking-[0.2em]">Signal Transcription</span>
                    </div>
                </div>
                <div id="transcriptionLog" class="flex-1 overflow-y-auto p-5 space-y-4 custom-scrollbar">
                    <div class="flex flex-col items-center justify-center h-full text-center p-6 space-y-4 opacity-20">
                        <div class="w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center border border-white/10">
                            <i data-lucide="brain-circuit" class="w-6 h-6 text-blue-400"></i>
                        </div>
                        <p class="text-white text-[9px] font-semibold uppercase tracking-[0.2em] leading-relaxed">
                            Awaiting Voice Signal...
                        </p>
                    </div>
                </div>
                <div class="p-4 bg-black/40 border-t border-white/5 flex items-center justify-between">
                     <div class="flex items-center gap-2">
                         <div id="listen-status-dot" class="w-2 h-2 rounded-full bg-slate-700"></div>
                         <span id="listen-status-text" class="text-[8px] font-semibold text-slate-500 uppercase tracking-widest">Idle</span>
                     </div>
                     <button id="toggleTranscription" class="px-4 py-2 bg-blue-600/20 hover:bg-blue-600/40 text-blue-400 text-[9px] font-semibold uppercase tracking-widest rounded-xl border border-blue-500/20 transition-all active:scale-95">
                        Enable Live Aid
                     </button>
                </div>
            </div>

            <div class="p-3 md:p-4 bg-gray-50/50 border-t border-gray-50">
                <div class="relative flex items-center gap-2">

                    <input type="file" id="fileInput" class="hidden">
                    <button type="button" id="attachBtn" class="p-2 md:p-2.5 text-gray-400 hover:text-blue-600 transition-colors">
                        <i data-lucide="paperclip" class="w-5 h-5"></i>
                    </button>
                    <input type="text" id="chatInput" class="flex-1 bg-white border-gray-100 rounded-xl md:rounded-2xl px-3 py-2 md:px-4 md:py-3 text-sm focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all outline-none" placeholder="Type..." autocomplete="off">
                    <button type="button" id="sendBtn" class="p-2 md:p-3 bg-blue-600 text-white rounded-xl shadow-lg shadow-blue-500/20 hover:bg-blue-700 hover:scale-105 transition-all">
                        <i data-lucide="send" class="w-4 h-4 md:w-5 md:h-5"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Padding for bottom overlay in mobile if needed -->
    <div class="h-4 md:hidden"></div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="~/js/telemedicine-core.js" asp-append-version="true"></script>
    <script src="~/js/pharmacy-core.js" asp-append-version="true"></script>
    <script>
        function switchTab(tab) {
            const chatBtn = document.getElementById('tab-chat');
            const transcriptBtn = document.getElementById('tab-transcript');
            const chatContent = document.getElementById('chat-content');
            const transcriptContent = document.getElementById('transcript-content');
            const chatInput = document.getElementById('chatInput').parentElement.parentElement;

            if (tab === 'chat') {
                chatBtn.className = "flex-1 py-3 px-4 rounded-2xl flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-widest transition-all bg-white text-blue-600 shadow-sm border border-gray-100";
                transcriptBtn.className = "flex-1 py-3 px-4 rounded-2xl flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-widest transition-all text-gray-400 hover:text-gray-600";
                chatContent.classList.remove('hidden');
                transcriptContent.classList.add('hidden');
                chatInput.classList.remove('hidden');
            } else {
                transcriptBtn.className = "flex-1 py-3 px-4 rounded-2xl flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-widest transition-all bg-slate-800 text-blue-400 shadow-xl border border-white/5";
                chatBtn.className = "flex-1 py-3 px-4 rounded-2xl flex items-center justify-center gap-2 text-xs font-semibold uppercase tracking-widest transition-all text-gray-500 hover:text-gray-700";
                chatContent.classList.add('hidden');
                transcriptContent.classList.remove('hidden');
                chatInput.classList.add('hidden'); // Hide chat input when in transcript mode
            }
        }
        const roomContext = {
            roomId: "room_@appointmentId",
            userName: "@(User.Identity.Name?.Split('@')[0] ?? "User")",
            isDoctor: @((User.IsInRole("Doctor")).ToString().ToLower()),
            appointmentId: "@appointmentId",
            senderId: "@(ViewBag.CurrentUserId ?? "")",
            receiverId: "@(User.IsInRole("Doctor") ? (ViewBag.PatientUserId ?? "") : (ViewBag.DoctorUserId ?? ""))",
            isLocked: @((ViewBag.IsPrescriptionLocked ?? false).ToString().ToLower()),
            initialData: @Html.Raw(ViewBag.PrescriptionData ?? "null")
        };
        
        document.addEventListener("DOMContentLoaded", () => {
             console.log("Telemed Bootstrapping...");
             Telemed.init(roomContext);
             window.Telemed = Telemed; // Expose for inline handlers
        });

        // --- Prescription Actions ---
        
        async function handlePrescriptionAction(event, action) {
            if (event) event.preventDefault();
            
            // Provide immediate feedback
            const feedback = document.getElementById("actionFeedback");
            const btn = event?.currentTarget;
            if (btn) btn.disabled = true;

            const showFeedback = (msg, isError = false) => {
                feedback.innerText = msg;
                feedback.className = `text-[10px] font-bold ${isError ? 'text-rose-600' : 'text-emerald-600'} animate-pulse`;
                feedback.classList.remove('hidden');
                setTimeout(() => feedback.classList.add('hidden'), 3000);
                if (btn) btn.disabled = false;
            };
            
            // Get latest data from display
            const diagnosis = document.getElementById("patientDiagnosisDisplay").innerText;
            const medsContainer = document.getElementById("patientMedicationDisplay");
            const meds = Array.from(medsContainer.children)
                .map(c => c.innerText)
                .filter(t => t !== "No medications added yet")
                .join(", ");
            
            if (action === 'save') {
                 try {
                     const response = await fetch('/Dashboard/SavePrescriptionRecord', {
                         method: 'POST',
                         headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                         body: new URLSearchParams({ appointmentId: roomContext.appointmentId, diagnosis: diagnosis, medicationsJson: meds })
                     });
                     const data = await response.json();
                     if (data.success) {
                         showFeedback("Record Saved Successfully!");
                     } else {
                         showFeedback("Save Failed: " + data.message, true);
                     }
                 } catch (e) { console.error(e); showFeedback("Network Error", true); }

            } else if (action === 'download') {
                showFeedback("Generating PDF...");
                // Populate Template
                document.getElementById('pdf-diagnosis').innerText = diagnosis;
                document.getElementById('pdf-meds').innerHTML = Array.from(medsContainer.children)
                    .filter(c => c.innerText !== "No medications added yet")
                    .map(c => `<div class="p-2 border-b border-gray-100">${c.innerText}</div>`).join("");
                
                const template = document.getElementById('pdf-template');
                template.classList.remove('hidden');
                
                try {
                    const canvas = await html2canvas(template, { scale: 2 });
                    const imgData = canvas.toDataURL('image/png');
                    const pdf = new jspdf.jsPDF('p', 'mm', 'a4');
                    const pdfWidth = pdf.internal.pageSize.getWidth();
                    const pdfHeight = (canvas.height * pdfWidth) / canvas.width;
                    pdf.addImage(imgData, 'PNG', 0, 0, pdfWidth, pdfHeight);
                    pdf.save(`Prescription_${roomContext.appointmentId}.pdf`);
                    showFeedback("PDF Downloaded");
                } catch (e) { console.error(e); showFeedback("PDF Error", true); }
                finally { template.classList.add('hidden'); }

            } else if (action === 'share') {
                try {
                     // First check if we need to save
                     showFeedback("Preparing to share...");
                     const response = await fetch('/Dashboard/SavePrescriptionRecord', {
                         method: 'POST',
                         headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                         body: new URLSearchParams({ appointmentId: roomContext.appointmentId, diagnosis: diagnosis, medicationsJson: meds })
                     });
                     const data = await response.json();
                     if (data.success) {
                         currentRecordId = data.recordId;
                         openShareModal();
                         if (btn) btn.disabled = false;
                         feedback.classList.add('hidden');
                     } else {
                         showFeedback("Preparation Failed", true);
                     }
                 } catch (e) { console.error(e); showFeedback("Network Error", true); }
            }
        }

        let currentRecordId = 0;
        
        // --- Draggable PiP Logic (Refined) ---
        (function() {
            const pip = document.getElementById('draggableSelfVideo');
            if (!pip) return;
            const container = pip.parentElement;
            let isDragging = false;
            let startX, startY;
            let currentX = 0, currentY = 0;
            let savedX = 0, savedY = 0;

            const dragStart = (e) => {
                const clientX = e.type === "touchstart" ? e.touches[0].clientX : e.clientX;
                const clientY = e.type === "touchstart" ? e.touches[0].clientY : e.clientY;

                if (e.target === pip || pip.contains(e.target)) {
                    console.log("PiP Drag Started");
                    isDragging = true;
                    startX = clientX;
                    startY = clientY;
                    pip.classList.add('shadow-blue-500/40', 'z-[100]');
                    e.stopPropagation();
                }
            };

            const dragMove = (e) => {
                if (!isDragging) return;
                
                const clientX = e.type === "touchmove" ? e.touches[0].clientX : e.clientX;
                const clientY = e.type === "touchmove" ? e.touches[0].clientY : e.clientY;

                let deltaX = clientX - startX;
                let deltaY = clientY - startY;

                let nextX = savedX + deltaX;
                let nextY = savedY + deltaY;

                // --- Improved Boundary Clamping ---
                const rect = pip.getBoundingClientRect();
                const containerRect = container.getBoundingClientRect();

                const limitLeft = -(containerRect.width - rect.width - 24);
                const limitTop = -(containerRect.height - rect.height - 24);
                const limitRight = 24;
                const limitBottom = 24;

                currentX = Math.max(limitLeft, Math.min(nextX, limitRight));
                currentY = Math.max(limitTop, Math.min(nextY, limitBottom));

                pip.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
                e.preventDefault();
            };

            const dragEnd = () => {
                if (!isDragging) return;
                console.log("PiP Drag Ended at:", currentX, currentY);
                isDragging = false;
                savedX = currentX;
                savedY = currentY;
                pip.classList.remove('shadow-blue-500/40', 'z-[100]');
            };

            // Listeners
            pip.addEventListener("mousedown", dragStart);
            pip.addEventListener("touchstart", dragStart, { passive: false });

            window.addEventListener("mousemove", dragMove);
            window.addEventListener("touchmove", dragMove, { passive: false });

            window.addEventListener("mouseup", dragEnd);
            window.addEventListener("touchend", dragEnd);
        })();

        async function openShareModal() {
            const modal = document.getElementById('shareModal');
            const list = document.getElementById('doctorShareList');
            list.innerHTML = '<div class="p-4 text-center text-gray-500">Loading doctors...</div>';
            modal.classList.remove('hidden');
            
            try {
                const res = await fetch('/Dashboard/GetDoctorsList');
                const data = await res.json();
                if (data.success) {
                    list.innerHTML = data.doctors.map(doc => `
                        <div class="flex items-center justify-between p-3 hover:bg-gray-50 rounded-xl transition-colors cursor-pointer border border-transparent hover:border-gray-100" onclick="selectDoctorForShare(${doc.id}, this)">
                            <div class="flex items-center gap-3">
                                <img src="${doc.profileImage || '/images/default-avatar.png'}" class="w-10 h-10 rounded-full object-cover">
                                <div>
                                    <p class="font-bold text-gray-900 text-sm">${doc.name}</p>
                                    <p class="text-xs text-gray-500">${doc.specialization}</p>
                                </div>
                            </div>
                            <div class="w-4 h-4 rounded-full border-2 border-gray-300 selection-indicator"></div>
                        </div>
                    `).join('');
                }
            } catch(e) { console.error(e); list.innerHTML = '<div class="text-rose-500 p-4">Error loading doctors</div>'; }
        }

        let selectedDoctorId = 0;
        function selectDoctorForShare(id, el) {
            selectedDoctorId = id;
            document.querySelectorAll('.selection-indicator').forEach(i => i.classList.remove('bg-blue-600', 'border-blue-600'));
            el.querySelector('.selection-indicator').classList.add('bg-blue-600', 'border-blue-600');
        }

        async function confirmShare(event) {
            if (event) event.preventDefault();
            if (!selectedDoctorId) return showShareFeedback("Please select a doctor", true);
            
            const feedback = document.getElementById("actionFeedback");
            const showFeedback = (msg, isError = false) => {
                feedback.innerText = msg;
                feedback.className = `text-[10px] font-bold ${isError ? 'text-rose-600' : 'text-emerald-600'} animate-pulse`;
                feedback.classList.remove('hidden');
                setTimeout(() => feedback.classList.add('hidden'), 3000);
            };

            try {
                const formData = new FormData();
                formData.append('recordId', currentRecordId);
                formData.append('doctorId', selectedDoctorId);
                
                const res = await fetch('/Dashboard/ShareHealthRecord', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    showFeedback("Shared successfully!");
                    document.getElementById('shareModal').classList.add('hidden');
                } else showFeedback(data.message, true);
            } catch(e) { console.error(e); showFeedback("Share failed", true); }
        }

        async function showShareFeedback(msg, isError) {
             if (isError) await PremiumModal.error(msg, 'Validation Error');
             else await PremiumModal.alert(msg, 'Information');
        }
    </script>
}

<!-- Share Modal -->
<div id="shareModal" class="hidden fixed inset-0 z-[10001] bg-black/50 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl w-full max-w-md shadow-2xl overflow-hidden">
        <div class="p-6 border-b border-gray-100 flex justify-between items-center">
            <h3 class="font-bold text-lg text-gray-900">Share Prescription</h3>
            <button type="button" onclick="document.getElementById('shareModal').classList.add('hidden')" class="text-gray-400 hover:text-gray-600"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <div id="doctorShareList" class="p-4 max-h-[400px] overflow-y-auto space-y-2 custom-scrollbar">
            <!-- Dynamic List -->
        </div>
        <div class="p-4 bg-gray-50 border-t border-gray-100 flex gap-3">
             <button type="button" onclick="document.getElementById('shareModal').classList.add('hidden')" class="flex-1 py-3 text-gray-600 font-bold text-sm bg-white border border-gray-200 rounded-xl hover:bg-gray-50">Cancel</button>
             <button type="button" onclick="confirmShare(event)" class="flex-1 py-3 text-white font-bold text-sm bg-blue-600 rounded-xl hover:bg-blue-700 shadow-lg shadow-blue-500/20">Share Now</button>
        </div>
    </div>
</div>

<!-- Diagnostic Overlay -->
<div class="fixed bottom-4 left-4 z-[9999] opacity-10 hover:opacity-100 transition-opacity pointer-events-none">
    <div class="bg-slate-900/90 backdrop-blur-xl p-4 rounded-2xl border border-white/10 text-[10px] text-white/50 font-mono">
        <p>Room: <span class="text-blue-400">room_@appointmentId</span></p>
        <p>Status: <span id="debug-status" class="text-emerald-400">Initializing...</span></p>
    </div>
</div>

