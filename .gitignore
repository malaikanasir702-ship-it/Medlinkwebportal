## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][In]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache folder
.vs/

# Node modules
node_modules/

# Secret files — firebase key must never be committed
firebase-service-account.json

# Local developer overrides — these contain real credentials and must NOT be committed.
# appsettings.json (the base file) IS tracked and contains only YOUR_X_KEY placeholders.
# Put real secrets in appsettings.Development.json locally, or use Railway env vars in production.
appsettings.Development.json
appsettings.Production.json
appsettings.Staging.json
appsettings.Local.json