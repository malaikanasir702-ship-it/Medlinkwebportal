@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Appointments";
    ViewData["HeaderTitle"] = "Your Appointments";
    ViewData["HeaderSubtitle"] = "Manage your scheduled consultations.";
}

<div class="grid grid-cols-12 gap-5">
    <!-- Upcoming Appointments -->
    <div class="col-span-12 lg:col-span-8 space-y-5">
        <div class="bg-white rounded-3xl p-6 border border-gray-50 shadow-sm">
            <h3 class="text-lg font-bold text-gray-900 mb-6 flex items-center gap-2">
                <i data-lucide="calendar" class="text-blue-600 w-5 h-5"></i>
                Upcoming Schedule
            </h3>
            
            <div class="space-y-4">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="skeleton-loader bg-white p-5 rounded-2xl border border-gray-50 shadow-sm mb-4">
                        <div class="flex flex-col md:flex-row items-center justify-between gap-5">
                            <div class="flex items-center gap-5 w-full md:w-auto">
                                <div class="animate-pulse bg-gray-200 rounded-2xl w-16 h-16"></div>
                                <div class="space-y-2">
                                    <div class="animate-pulse bg-gray-200 rounded-lg h-5 w-40"></div>
                                    <div class="flex items-center gap-2">
                                        <div class="animate-pulse bg-gray-200 rounded-md h-4 w-24"></div>
                                        <div class="animate-pulse bg-gray-200 rounded-md h-4 w-20"></div>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-4 w-full md:w-auto justify-between md:justify-end">
                                <div class="space-y-1.5 text-right hidden md:block">
                                    <div class="animate-pulse bg-gray-200 rounded-lg h-4 w-24 ml-auto"></div>
                                    <div class="animate-pulse bg-gray-200 rounded-lg h-3 w-16 ml-auto"></div>
                                </div>
                                <div class="animate-pulse bg-gray-200 rounded-xl w-12 h-12"></div>
                            </div>
                        </div>
                    </div>
                }
                
                @if (!Model.UpcomingConsultations.Any())
                {
                    <div class="page-content hidden p-12 text-center space-y-4">
                        <div class="w-20 h-20 bg-gray-50 rounded-full flex items-center justify-center mx-auto text-gray-300">
                            <i data-lucide="calendar-x" class="w-10 h-10"></i>
                        </div>
                        <div>
                            <h4 class="text-gray-900 font-bold">No Appointments Yet</h4>
                            <p class="text-gray-500 text-sm">You haven't scheduled any consultations.</p>
                        </div>
                        <a href="@Url.Action("Doctors", "Dashboard")" class="inline-flex items-center gap-2 px-6 py-2.5 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all">
                             Find a Doctor
                        </a>
                    </div>
                }
                else
                {
                    @foreach (var consult in Model.UpcomingConsultations)
                    {
                        <div x-data="{ open: false }" 
                             :class="{ 'z-[100]': open, 'relative': true }"
                             class="page-content hidden group p-4 md:p-5 rounded-2xl border border-gray-100 bg-white hover:border-blue-200 hover:shadow-md transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-4 md:gap-5">
                            <div class="flex items-center gap-4 md:gap-5 w-full md:w-auto">
                                <div class="relative shrink-0">
                                    <img src="@consult.Image" class="w-14 h-14 md:w-16 md:h-16 rounded-2xl object-cover shadow-sm" alt="@consult.Doctor">
                                    <div class="absolute -bottom-1 -right-1 bg-green-500 border-2 border-white w-4 h-4 rounded-full"></div>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <h4 class="font-semibold text-gray-900 text-base md:text-lg truncate">@consult.Doctor</h4>
                                    <div class="flex flex-wrap items-center gap-2 text-[11px] md:text-sm text-gray-500 font-medium mt-1">
                                        <span class="text-blue-600 bg-blue-50 px-2 py-0.5 rounded-md">@consult.Specialty</span>
                                        <span class="hidden xs:block w-1 h-1 rounded-full bg-gray-300"></span>
                                        <span class="flex items-center gap-1"><i data-lucide="video" class="w-3.5 h-3.5"></i> @consult.Type</span>
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center justify-between w-full md:w-auto md:justify-end gap-2 border-t border-gray-50 md:border-none pt-3 md:pt-0">
                                <div class="text-left md:text-right">
                                    <div class="text-xs md:text-sm font-bold text-gray-900 flex items-center gap-1.5 md:justify-end">
                                        <i data-lucide="clock" class="w-4 h-4 text-gray-400"></i>
                                        @consult.Time
                                    </div>
                                    <div class="text-[10px] md:text-xs font-semibold text-green-600 mt-0.5 flex items-center md:justify-end gap-1">
                                        <span class="bg-green-100 text-green-700 px-1.5 py-0.5 rounded text-[9px] border border-green-200">PAID</span>
                                        Confirmed
                                    </div>
                                </div>
                                @{
                                    var today = DateTime.Today;
                                    bool isToday = consult.RawDate.HasValue && consult.RawDate.Value.Date == today;
                                    bool isPast = consult.RawDate.HasValue && consult.RawDate.Value.Date < today;
                                    bool isFuture = consult.RawDate.HasValue && consult.RawDate.Value.Date > today;
                                    bool isFinished = consult.Status == "Completed" || consult.Status == "Cancelled";
                                    bool canJoin = isToday && !isFinished && consult.Type != "Physical";

                                    string clickHandler = "";
                                    if (isFinished || isPast) clickHandler = $"showRestrictedModal('completed', '{consult.Doctor}')";
                                    else if (isFuture) clickHandler = $"showRestrictedModal('upcoming', '{consult.Doctor}', '{consult.RawDate?.ToString("MMM dd")}')";
                                    else if (consult.Type == "Physical") clickHandler = $"showRestrictedModal('physical', '{consult.Doctor}')";
                                    else clickHandler = $"window.location.href='{Url.Action("ConsultationRoom", "Dashboard", new { id = consult.Id })}'";
                                }
                                <div class="flex items-center gap-2 relative" @@click.away="open = false">
                                    <button onclick="@clickHandler" class="p-2.5 md:p-3 @(canJoin ? "bg-blue-600 text-white shadow-lg shadow-blue-500/20 hover:bg-blue-700" : "bg-gray-100 text-gray-400") rounded-xl transition-all">
                                        <i data-lucide="@(canJoin ? "video" : "lock")" class="w-5 h-5"></i>
                                    </button>
                                    <button @@click="open = !open" class="p-2.5 md:p-3 bg-gray-50 border border-gray-100 text-gray-400 rounded-xl hover:text-blue-600 hover:bg-blue-50 transition-all shadow-sm">
                                        <i data-lucide="more-vertical" class="w-4 h-4"></i>
                                    </button>

                                    <!-- Dropdown Menu -->
                                    <div x-show="open" 
                                         x-transition:enter="transition ease-out duration-100"
                                         x-transition:enter-start="transform opacity-0 scale-95"
                                         x-transition:enter-end="transform opacity-100 scale-100"
                                         class="absolute right-0 bottom-full md:bottom-auto md:top-full mb-2 md:mb-0 md:mt-3 w-56 bg-white border border-gray-100 rounded-2xl shadow-2xl z-50 overflow-hidden py-2 divide-y divide-gray-50 origin-bottom-right md:origin-top-right">
                                        
                                        <a href="@Url.Action("DownloadInvoice", "Dashboard", new { id = consult.Id })" target="_blank" class="flex items-center gap-3 px-4 py-3 text-[11px] font-bold text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition-all">
                                            <i data-lucide="file-text" class="w-4 h-4"></i> View Invoice
                                        </a>
                                        
                                        <a href="@Url.Action("Messages", "Dashboard", new { doctorId = consult.DoctorId })" class="flex items-center gap-3 px-4 py-3 text-[11px] font-bold text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition-all">
                                            <i data-lucide="message-square" class="w-4 h-4"></i> Message
                                        </a>

                                        <a href="@Url.Action("DoctorProfile", "Dashboard", new { id = consult.DoctorId })" class="flex items-center gap-3 px-4 py-3 text-[11px] font-bold text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition-all">
                                            <i data-lucide="user" class="w-4 h-4"></i> Profile
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            
            <a href="@Url.Action("Doctors", "Dashboard")" class="w-full mt-6 py-4 border-2 border-dashed border-gray-100 rounded-2xl text-sm font-bold text-gray-400 hover:border-blue-500 hover:text-blue-600 hover:bg-blue-50 transition-all flex items-center justify-center gap-2">
                <i data-lucide="plus" class="w-4 h-4"></i> Schedule New Appointment
            </a>
        </div>
    </div>

    <!-- Calendar Widget -->
    <div class="col-span-12 lg:col-span-4 space-y-5">
        <div class="bg-white rounded-3xl p-6 border border-gray-50 shadow-sm">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-lg font-bold text-gray-900">Calendar</h3>
                <div class="flex items-center gap-2">
                    <button onclick="changeMonth(-1)" class="p-2 hover:bg-gray-50 text-gray-400 hover:text-blue-600 rounded-xl transition-all border border-transparent hover:border-blue-100">
                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                    </button>
                    <button onclick="changeMonth(1)" class="p-2 hover:bg-gray-50 text-gray-400 hover:text-blue-600 rounded-xl transition-all border border-transparent hover:border-blue-100">
                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>
            
            <div class="bg-slate-50/50 rounded-2xl p-5">
                <div class="text-center mb-6">
                    <span id="calendarMonthYear" class="text-xs font-semibold uppercase tracking-[0.2em] text-blue-600">February 2026</span>
                </div>
                
                <div class="grid grid-cols-7 gap-1 text-center text-[10px] font-semibold uppercase tracking-widest text-gray-400 mb-4">
                    <div>S</div><div>M</div><div>T</div><div>W</div><div>T</div><div>F</div><div>S</div>
                </div>
                
                <div id="calendarDays" class="grid grid-cols-7 gap-2">
                    <!-- Days will be injected by JavaScript -->
                </div>
            </div>
        </div>

        <script>
            // Pass appointment dates from C# to JS
            const appointmentDates = [
                @foreach (var consult in Model.UpcomingConsultations.Where(c => c.RawDate.HasValue))
                {
                    <text>"@consult.RawDate.Value.ToString("yyyy-MM-dd")",</text>
                }
            ];

            let currentDate = new Date();
            let viewDate = new Date();

            function renderCalendar() {
                const year = viewDate.getFullYear();
                const month = viewDate.getMonth();
                
                const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                document.getElementById('calendarMonthYear').textContent = `${monthNames[month]} ${year}`;
                
                const firstDay = new Date(year, month, 1).getDay();
                const daysInMonth = new Date(year, month + 1, 0).getDate();
                const daysInPrevMonth = new Date(year, month, 0).getDate();
                
                const calendarDays = document.getElementById('calendarDays');
                calendarDays.innerHTML = '';
                
                // Previous Month Days
                for (let i = firstDay - 1; i >= 0; i--) {
                    const dayDiv = document.createElement('div');
                    dayDiv.className = 'p-2 text-xs font-semibold text-gray-300 pointer-events-none text-center';
                    dayDiv.textContent = daysInPrevMonth - i;
                    calendarDays.appendChild(dayDiv);
                }
                
                // Current Month Days
                for (let i = 1; i <= daysInMonth; i++) {
                    const dayDiv = document.createElement('div');
                    const dateStr = `${year}-${String(month + 1).padStart(2, '0')}-${String(i).padStart(2, '0')}`;
                    const isToday = i === currentDate.getDate() && month === currentDate.getMonth() && year === currentDate.getFullYear();
                    const hasAppointment = appointmentDates.includes(dateStr);
                    
                    dayDiv.className = 'relative p-2 text-xs font-bold rounded-xl transition-all cursor-default flex items-center justify-center h-9 w-9 mx-auto';
                    
                    if (isToday) {
                        dayDiv.classList.add('bg-blue-600', 'text-white', 'shadow-lg', 'shadow-blue-500/20');
                    } else if (hasAppointment) {
                        dayDiv.classList.add('bg-blue-50', 'text-blue-600', 'border', 'border-blue-100');
                    } else {
                        dayDiv.classList.add('text-gray-600', 'hover:bg-gray-50');
                    }
                    
                    dayDiv.textContent = i;
                    
                    if (hasAppointment && !isToday) {
                        const dot = document.createElement('div');
                        dot.className = 'absolute bottom-1 w-1 h-1 bg-blue-600 rounded-full';
                        dayDiv.appendChild(dot);
                    }
                    
                    calendarDays.appendChild(dayDiv);
                }
                
                // Next Month Days (filling up to 42 cells for consistent grid height)
                const totalCells = firstDay + daysInMonth;
                const remainingCells = 42 - totalCells;
                for (let i = 1; i <= remainingCells; i++) {
                    const dayDiv = document.createElement('div');
                    dayDiv.className = 'p-2 text-xs font-semibold text-gray-300 pointer-events-none text-center';
                    dayDiv.textContent = i;
                    calendarDays.appendChild(dayDiv);
                }
            }

            function changeMonth(offset) {
                viewDate.setMonth(viewDate.getMonth() + offset);
                renderCalendar();
                lucide.createIcons();
            }

            document.addEventListener('DOMContentLoaded', () => {
                renderCalendar();
            });
        </script>
        
        @{
            var nextConsult = Model.UpcomingConsultations.FirstOrDefault();
        }
        @if (nextConsult != null)
        {
            <div class="bg-gradient-to-br from-purple-600 to-indigo-600 rounded-3xl p-6 text-white shadow-xl shadow-purple-500/20">
                <div class="flex items-start justify-between mb-4">
                    <div>
                        <div class="text-purple-200 text-xs font-bold uppercase tracking-wider mb-1">Next Visit</div>
                        <h4 class="text-xl font-semibold">@nextConsult.Doctor</h4>
                        <p class="text-purple-100 text-sm">@nextConsult.Specialty</p>
                    </div>
                    <div class="bg-white/20 backdrop-blur-md p-2 rounded-xl">
                        <i data-lucide="calendar" class="w-6 h-6"></i>
                    </div>
                </div>
                <div class="bg-black/20 rounded-xl p-3 flex items-center justify-between text-sm">
                    <span class="font-medium">Scheduled</span>
                    <span class="font-bold">@nextConsult.Time</span>
                </div>
            </div>
        }
        else
        {
             <div class="bg-gradient-to-br from-blue-600 to-blue-700 rounded-3xl p-6 text-white shadow-xl shadow-blue-500/20">
                <div class="text-center space-y-3">
                    <i data-lucide="calendar-plus" class="w-10 h-10 mx-auto opacity-50"></i>
                    <p class="text-sm font-bold">Stay on top of your health.</p>
                    <a href="@Url.Action("Doctors", "Dashboard")" class="block w-full py-2 bg-white text-blue-600 rounded-xl font-semibold text-xs uppercase tracking-wider hover:bg-blue-50 transition-all">Book Now</a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Restricted Access Modal -->
<div id="restrictedModal" class="hidden fixed inset-0 z-[110] flex items-center justify-center p-4 bg-gray-900/60 backdrop-blur-md animate-in fade-in duration-300">
    <div class="bg-white rounded-[2.5rem] w-full max-w-md overflow-hidden shadow-2xl relative animate-in zoom-in slide-in-from-bottom-4 duration-500">
        <!-- Header Pattern -->
        <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-br from-blue-600 to-indigo-700 opacity-5"></div>
        <div class="absolute top-0 right-0 p-8 opacity-[0.03]">
            <i data-lucide="shield-alert" class="w-32 h-32 text-blue-600"></i>
        </div>

        <div class="relative p-10 text-center">
            <!-- Icon Stage -->
            <div id="restrictedIconContainer" class="w-24 h-24 mx-auto mb-8 rounded-[2rem] bg-blue-50 flex items-center justify-center text-blue-600 shadow-inner relative group">
                <div class="absolute inset-0 bg-blue-400 rounded-[2rem] animate-ping opacity-20 group-hover:opacity-40 transition-opacity"></div>
                <i id="restrictedIcon" data-lucide="lock" class="w-10 h-10 relative z-10 transition-transform group-hover:scale-110"></i>
            </div>

            <!-- Content -->
            <h3 id="restrictedTitle" class="text-2xl font-semibold text-gray-900 tracking-tight mb-3">Room Access Locked</h3>
            <p id="restrictedMessage" class="text-sm text-gray-500 font-medium leading-relaxed mb-10 px-4">
                This consultation session is currently unavailable for digital entry based on clinical status.
            </p>

            <!-- Buttons -->
            <div class="space-y-3">
                <button onclick="closeRestrictedModal()" class="w-full py-4 bg-gray-900 text-white rounded-2xl font-semibold text-[11px] uppercase tracking-widest shadow-xl shadow-gray-900/20 hover:bg-gray-800 transition-all active:scale-95">
                    Acknowledge Protocol
                </button>
            </div>
        </div>

        <!-- Footer Info -->
        <div class="bg-gray-50/80 border-t border-gray-100 p-4 text-center">
            <p class="text-[9px] font-semibold text-gray-400 uppercase tracking-[0.2em] flex items-center justify-center gap-2">
                <i data-lucide="shield-check" class="w-3 h-3"></i>
                Security Architecture Verified
            </p>
        </div>
    </div>
</div>

<script>
    function showRestrictedModal(type, doctor, date = '') {
        const modal = document.getElementById('restrictedModal');
        const icon = document.getElementById('restrictedIcon');
        const container = document.getElementById('restrictedIconContainer');
        const title = document.getElementById('restrictedTitle');
        const message = document.getElementById('restrictedMessage');

        // Reset
        container.className = 'w-24 h-24 mx-auto mb-8 rounded-[2rem] flex items-center justify-center shadow-inner relative group';

        if (type === 'completed') {
            title.innerText = 'Session Completed';
            message.innerText = `The clinical consultation with Dr. ${doctor} has already been concluded and archived in your history.`;
            icon.setAttribute('data-lucide', 'check-circle-2');
            container.classList.add('bg-emerald-50', 'text-emerald-600');
        } else if (type === 'upcoming') {
            title.innerText = 'Upcoming Protocol';
            message.innerText = `Your session with Dr. ${doctor} is scheduled for ${date}. Communication channels will initialize strictly on the appointment date.`;
            icon.setAttribute('data-lucide', 'clock');
            container.classList.add('bg-amber-50', 'text-amber-600');
        } else if (type === 'physical') {
            title.innerText = 'Physical Visit Required';
            message.innerText = `This is a physical in-person consultation at Dr. ${doctor}'s clinic. No digital room is required for this protocol.`;
            icon.setAttribute('data-lucide', 'building-2');
            container.classList.add('bg-blue-50', 'text-blue-600');
        }

        modal.classList.remove('hidden');
        lucide.createIcons();
    }

    function closeRestrictedModal() {
        const modal = document.getElementById('restrictedModal');
        modal.classList.add('opacity-0', 'scale-95', 'transition-all', 'duration-300');
        setTimeout(() => {
            modal.classList.add('hidden');
            modal.classList.remove('opacity-0', 'scale-95');
        }, 300);
    }
</script>
