@model IEnumerable<MedLinkPortal.Areas.Doctor.Models.PatientRecordListViewModel>

@{
    ViewData["Title"] = "Patient Records";
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
}

<div class="space-y-10 reveal">
    <!-- Grid Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
        <div>
            <h1 class="text-3xl font-semibold text-slate-900 dark:text-white tracking-tight">Node Directory</h1>
            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-2">Centralized patient record management</p>
        </div>
        <div class="relative w-full md:w-80 group">
            <input type="text" placeholder="Search patient nodes..." 
                   class="w-full pl-12 pr-6 py-4 bg-white dark:bg-white/5 border border-slate-100 dark:border-white/5 rounded-2xl text-[11px] font-semibold uppercase tracking-widest placeholder-slate-400 focus:ring-4 focus:ring-blue-500/10 transition-all shadow-sm">
            <i class="fas fa-search absolute left-5 top-1/2 -translate-y-1/2 text-slate-300 text-xs transition-colors group-focus-within:text-blue-500"></i>
        </div>
    </div>

    <!-- Data Grid -->
    <!-- Mobile Card View (Visible < md) -->
    <div class="md:hidden space-y-4">
        @foreach (var item in Model)
        {
            var patient = item.Patient;
            var apptStarted = item.IsAppointmentStarted;
            var disabledClass = apptStarted ? "" : "opacity-30 grayscale pointer-events-none";
            
             <div class="premium-card p-5 space-y-4">
                <div class="flex items-center gap-4">
                    <div class="flex-shrink-0 w-12 h-12 rounded-2xl bg-gradient-to-br from-blue-50 to-slate-100 dark:from-slate-800 dark:to-slate-700 flex items-center justify-center text-blue-600 dark:text-blue-400 font-semibold text-lg shadow-inner">
                        @((patient.Name ?? patient.UserName ?? "PT").Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <div class="text-sm font-semibold text-slate-900 dark:text-white tracking-tight">@(patient.Name ?? patient.UserName ?? "Patient")</div>
                        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter mt-0.5">ID: @patient.Id.Substring(0, 8)</div>
                    </div>
                </div>
                
                <div class="grid grid-cols-2 gap-4 pt-2 border-t border-slate-50 dark:border-white/5">
                    <div>
                        <div class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Status</div>
                         @if (item.IsAppointmentStarted)
                        {
                            <div class="flex items-center gap-2 text-emerald-500 font-semibold text-[10px] uppercase tracking-widest">
                                <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
                                Live
                            </div>
                        }
                        else if (item.NextAppointmentTime.HasValue)
                        {
                            <div class="flex items-center gap-2 text-blue-500 font-semibold text-[10px] uppercase tracking-widest">
                                <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
                                @item.NextAppointmentTime.Value.ToString("MMM dd")
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center gap-2 text-slate-400 font-semibold text-[10px] uppercase tracking-widest">
                                <span class="w-1.5 h-1.5 bg-slate-300 rounded-full"></span>
                                Standby
                            </div>
                        }
                    </div>
                    <div>
                         @{
                            var dob = item.Patient.DateOfBirth ?? DateTime.Now;
                            var age = DateTime.Today.Year - dob.Year;
                            if (dob.Date > DateTime.Today.AddYears(-age)) age--;
                        }
                        <div class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Age</div>
                        <div class="text-[10px] font-bold text-slate-600 dark:text-slate-300">@age Years</div>
                    </div>
                </div>

                <div class="flex gap-3 pt-2">
                     <a asp-action="ViewHistory" asp-route-patientId="@patient.Id" 
                       class="flex-1 h-10 flex items-center justify-center bg-slate-50 dark:bg-white/5 text-slate-600 dark:text-slate-400 rounded-xl text-[10px] font-semibold uppercase tracking-widest hover:bg-slate-900 dark:hover:bg-white hover:text-white dark:hover:text-slate-900 transition-all border border-transparent @disabledClass">
                        <i class="fas fa-history mr-2"></i> History
                    </a>
                    <a asp-action="CreateRecord" asp-route-patientId="@patient.Id" 
                       class="flex-1 h-10 flex items-center justify-center bg-blue-600 text-white rounded-xl text-[10px] font-semibold uppercase tracking-widest hover:bg-blue-700 transition-all shadow-lg shadow-blue-500/20 @disabledClass">
                        <i class="fas fa-plus mr-2"></i> Record
                    </a>
                </div>
             </div>
        }
        @if (!Model.Any())
        {
             <div class="py-20 text-center premium-card border-dashed border-2 border-slate-100 dark:border-white/5">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-slate-50 dark:bg-white/5 rounded-full mb-4">
                    <i class="fas fa-user-slash text-slate-200 text-2xl"></i>
                </div>
                <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-widest">No Active Patient Nodes Found</h3>
            </div>
        }
    </div>

    <!-- Desktop Data Grid (Hidden < md) -->
    <div class="premium-card overflow-hidden hidden md:block">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/50 dark:bg-white/2 border-b border-slate-100 dark:border-white/5">
                        <th class="px-10 py-6 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Identify</th>
                        <th class="px-6 py-6 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Signal (Email)</th>
                        <th class="px-6 py-6 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Chronology</th>
                        <th class="px-6 py-6 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Operational Status</th>
                        <th class="px-10 py-6 text-[10px] font-semibold text-slate-400 uppercase tracking-widest text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                    @foreach (var item in Model)
                    {
                        var patient = item.Patient;
                        <tr class="group hover:bg-slate-50/30 dark:hover:bg-white/2 transition-all">
                            <td class="px-10 py-8">
                                <div class="flex items-center gap-5">
                                    <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-50 to-slate-100 dark:from-slate-800 dark:to-slate-700 flex items-center justify-center text-blue-600 dark:text-blue-400 font-semibold text-lg shadow-inner group-hover:scale-105 transition-transform">
                                        @((patient.Name ?? patient.UserName ?? "PT").Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <div class="text-sm font-semibold text-slate-900 dark:text-white tracking-tight">@(patient.Name ?? patient.UserName ?? "Patient")</div>
                                        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter mt-1">ID: @patient.Id.Substring(0, 8)</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-8">
                                <div class="text-[11px] font-bold text-slate-600 dark:text-slate-300">@patient.Email</div>
                                <div class="text-[9px] font-semibold text-blue-500 uppercase tracking-widest mt-1 opacity-60">Verified Signal</div>
                            </td>
                            <td class="px-6 py-8">
                                @{
                                    var dob = item.Patient.DateOfBirth ?? DateTime.Now;
                                    var age = DateTime.Today.Year - dob.Year;
                                    if (dob.Date > DateTime.Today.AddYears(-age)) age--;
                                }
                                <div class="text-sm font-semibold text-slate-900 dark:text-white">@age Years</div>
                                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter mt-1">@dob.ToString("MMM dd, yyyy")</div>
                            </td>
                            <td class="px-6 py-8">
                                @if (item.IsAppointmentStarted)
                                {
                                    <div class="flex items-center gap-3 text-emerald-500 font-semibold text-[10px] uppercase tracking-widest">
                                        <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                                        Live Session
                                    </div>
                                }
                                else if (item.NextAppointmentTime.HasValue)
                                {
                                    <div class="flex items-center gap-3 text-blue-500 font-semibold text-[10px] uppercase tracking-widest">
                                        <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
                                        ETA: @item.NextAppointmentTime.Value.ToString("MMM dd, HH:mm")
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center gap-3 text-slate-400 font-semibold text-[10px] uppercase tracking-widest">
                                        <span class="w-2 h-2 bg-slate-300 rounded-full"></span>
                                        Node Standby
                                    </div>
                                }
                            </td>
                            <td class="px-10 py-8 text-right">
                                <div class="flex items-center justify-end gap-3">
                                    @{
                                        var disabledClass = item.IsAppointmentStarted ? "" : "opacity-30 grayscale pointer-events-none";
                                        var btnTitle = item.IsAppointmentStarted ? "" : "Access available only during active session link.";
                                    }
                                    <a asp-action="ViewHistory" asp-route-patientId="@patient.Id" 
                                       class="h-10 px-6 flex items-center justify-center bg-slate-50 dark:bg-white/5 text-slate-600 dark:text-slate-400 rounded-xl text-[10px] font-semibold uppercase tracking-widest hover:bg-slate-900 dark:hover:bg-white hover:text-white dark:hover:text-slate-900 transition-all border border-transparent hover:border-slate-900 dark:hover:border-white @disabledClass"
                                       title="@btnTitle">
                                        <i class="fas fa-history mr-3"></i> History
                                    </a>
                                    <a asp-action="CreateRecord" asp-route-patientId="@patient.Id" 
                                       class="h-10 px-6 flex items-center justify-center bg-blue-600 text-white rounded-xl text-[10px] font-semibold uppercase tracking-widest hover:bg-blue-700 transition-all shadow-lg shadow-blue-500/20 @disabledClass"
                                       title="@btnTitle">
                                        <i class="fas fa-plus mr-3"></i> New Record
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-32 text-center">
                                <div class="inline-flex items-center justify-center w-24 h-24 bg-slate-50 dark:bg-white/5 rounded-[40px] mb-8">
                                    <i class="fas fa-user-slash text-slate-200 text-4xl"></i>
                                </div>
                                <h3 class="text-xl font-semibold text-slate-400 uppercase tracking-widest">No Active Patient Nodes Found</h3>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
