@model IEnumerable<MedLinkPortal.Models.MatchingRequest>
@{
    ViewData["Title"] = "AI Matching Analytics";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    var employerReqs = ViewBag.EmployerRequirements as List<MedLinkPortal.Models.EmployerRequirement> ?? new();
}

<div class="space-y-8 pb-20 animate-in fade-in duration-500">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 py-4 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-xs font-bold uppercase tracking-wider flex items-center gap-1.5">
                    <i class="fas fa-project-diagram text-purple-600"></i> Phase 4 AI Matching Engine
                </span>
                <span class="text-xs text-slate-400 font-mono">Two-Sided Recommendation Pipeline</span>
            </div>
            <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
                AI Matching <span class="text-purple-600">Analytics</span>
            </h1>
            <p class="text-slate-500 text-base font-medium mt-1">
                Patient triage-to-specialist matching and international employer hospital requirement fulfillment.
            </p>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Match Inquiries</span>
                <div class="w-10 h-10 rounded-2xl bg-purple-100 text-purple-600 flex items-center justify-center text-sm shadow-sm">
                    <i class="fas fa-stethoscope"></i>
                </div>
            </div>
            <h3 class="text-3xl font-extrabold text-slate-900 font-mono">@ViewBag.TotalRequests</h3>
            <p class="text-xs text-slate-500 mt-1">Patient symptom-driven requests</p>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Fulfilled Appointments</span>
                <div class="w-10 h-10 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-sm shadow-sm">
                    <i class="fas fa-calendar-check"></i>
                </div>
            </div>
            <h3 class="text-3xl font-extrabold text-slate-900 font-mono">@ViewBag.FulfilledRequests</h3>
            <p class="text-xs text-emerald-600 mt-1 font-semibold flex items-center gap-1">
                <i class="fas fa-check-circle"></i> Resulted in booked consultations
            </p>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Avg. Match Score</span>
                <div class="w-10 h-10 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-sm shadow-sm">
                    <i class="fas fa-chart-line"></i>
                </div>
            </div>
            <h3 class="text-3xl font-extrabold text-slate-900 font-mono">87.4%</h3>
            <p class="text-xs text-slate-500 mt-1">Specialty + historical case similarity</p>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Active Employer Reqs</span>
                <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-sm shadow-sm">
                    <i class="fas fa-hospital-user"></i>
                </div>
            </div>
            <h3 class="text-3xl font-extrabold text-slate-900 font-mono">@employerReqs.Count</h3>
            <p class="text-xs text-slate-500 mt-1">Cross-border hospital requirements</p>
        </div>
    </div>

    <!-- Algorithm Weight Breakdown -->
    <div class="bg-white rounded-3xl p-8 border border-slate-100 shadow-sm">
        <h3 class="text-lg font-bold text-slate-900 mb-2">Multi-Factor Matching Weights</h3>
        <p class="text-xs text-slate-500 mb-6">Configured scoring distribution for candidate physician ranking</p>

        <div class="grid grid-cols-1 sm:grid-cols-5 gap-4">
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-bold text-slate-700">Specialty Fit</span>
                    <span class="text-xs font-bold text-purple-600">40 pts</span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2">
                    <div class="bg-purple-600 h-2 rounded-full" style="width: 40%"></div>
                </div>
                <p class="text-[10px] text-slate-400 mt-2">Exact medical specialty alignment</p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-bold text-slate-700">Case History</span>
                    <span class="text-xs font-bold text-blue-600">25 pts</span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2">
                    <div class="bg-blue-600 h-2 rounded-full" style="width: 25%"></div>
                </div>
                <p class="text-[10px] text-slate-400 mt-2">Prior similar patient treatments</p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-bold text-slate-700">Availability</span>
                    <span class="text-xs font-bold text-emerald-600">15 pts</span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2">
                    <div class="bg-emerald-600 h-2 rounded-full" style="width: 15%"></div>
                </div>
                <p class="text-[10px] text-slate-400 mt-2">Immediate and near-term slots</p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-bold text-slate-700">Patient Rating</span>
                    <span class="text-xs font-bold text-amber-600">10 pts</span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2">
                    <div class="bg-amber-600 h-2 rounded-full" style="width: 10%"></div>
                </div>
                <p class="text-[10px] text-slate-400 mt-2">Verified review ratings</p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-100">
                <div class="flex items-center justify-between mb-1">
                    <span class="text-xs font-bold text-slate-700">Proximity</span>
                    <span class="text-xs font-bold text-indigo-600">10 pts</span>
                </div>
                <div class="w-full bg-slate-200 rounded-full h-2">
                    <div class="bg-indigo-600 h-2 rounded-full" style="width: 10%"></div>
                </div>
                <p class="text-[10px] text-slate-400 mt-2">Clinic distance / Telehealth mode</p>
            </div>
        </div>
    </div>

    <!-- International Employer Hospital Placements -->
    <div class="bg-white rounded-3xl p-8 border border-slate-100 shadow-sm">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-bold text-slate-900">International Hospital Requirements</h3>
                <p class="text-xs text-slate-500 mt-0.5">Global healthcare institutions matching with MedLink certified specialists</p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                        <th class="py-4 px-4">Hospital Entity</th>
                        <th class="py-4 px-4">Country</th>
                        <th class="py-4 px-4">Required Specialty</th>
                        <th class="py-4 px-4">Min. Cases</th>
                        <th class="py-4 px-4">Salary Range</th>
                        <th class="py-4 px-4">Visa Sponsorship</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 text-sm font-medium text-slate-700">
                    @if (employerReqs.Any())
                    {
                        @foreach (var emp in employerReqs)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-4 px-4 font-bold text-slate-900">@emp.HospitalName</td>
                                <td class="py-4 px-4">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-slate-100 text-slate-700">
                                        <i class="fas fa-globe-americas mr-1"></i> @emp.Country
                                    </span>
                                </td>
                                <td class="py-4 px-4">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-purple-50 text-purple-700 border border-purple-100">
                                        @emp.RequiredSpecialty
                                    </span>
                                </td>
                                <td class="py-4 px-4 font-mono font-bold text-slate-900">@emp.MinCasesCount+ cases</td>
                                <td class="py-4 px-4 text-emerald-600 font-bold font-mono">@emp.SalaryRange</td>
                                <td class="py-4 px-4">
                                    @if (emp.VisaSponsorship)
                                    {
                                        <span class="text-xs font-bold text-emerald-600 flex items-center gap-1">
                                            <i class="fas fa-check-circle"></i> Yes, Sponsored
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs font-bold text-slate-400">Direct Hire</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-8 text-center text-slate-400">
                                No employer requirements registered yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
