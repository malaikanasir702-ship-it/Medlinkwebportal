@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5 mb-5">
    <h1 class="display-3 fw-bold mb-3 text-dark">Your Health, <span class="text-primary">Our Priority</span></h1>
    <p class="lead text-muted mb-4 mx-auto" style="max-width: 600px;">
        Streamlined medical practice management for modern doctors and clinics. 
        Experience the future of healthcare administration today.
    </p>
    <div class="d-flex gap-3 justify-content-center">
        <a href="#" class="btn btn-primary btn-lg px-4">Get Started</a>
        <a href="#" class="btn btn-outline-secondary btn-lg px-4">Learn More</a>
    </div>
</div>

<div class="row g-4 py-5">
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4 text-center">
            <div class="mb-3 text-primary">
                <i class="fas fa-calendar-check fa-3x"></i>
            </div>
            <h3 class="h4 mb-3">Easy Appointments</h3>
            <p class="text-muted">
                Seamless booking system for patients and efficient schedule management for doctors.
            </p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4 text-center">
            <div class="mb-3 text-primary">
                <i class="fas fa-file-medical fa-3x"></i>
            </div>
            <h3 class="h4 mb-3">Secure Records</h3>
            <p class="text-muted">
                State-of-the-art encryption ensures that patient medical history and personal data remain safe.
            </p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm p-4 text-center">
            <div class="mb-3 text-primary">
                <i class="fas fa-user-md fa-3x"></i>
            </div>
            <h3 class="h4 mb-3">Specialist Access</h3>
            <p class="text-muted">
                Connect with top specialists across various fields for consultations and referrals.
            </p>
        </div>
    </div>
</div>
