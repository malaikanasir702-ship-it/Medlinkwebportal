@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Transcription History";
}

<div class="p-6 lg:p-10 space-y-8 max-w-[1600px] mx-auto overflow-hidden">
    <!-- Hero Section (Bento Grid Header) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Welcome Card -->
        <div class="lg:col-span-2 relative group overflow-hidden bg-white dark:bg-slate-900 rounded-[2.5rem] p-10 border border-slate-100 dark:border-white/5 shadow-2xl shadow-blue-500/5">
            <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-gradient-to-br from-blue-50/50 to-indigo-50/30 dark:from-blue-900/10 dark:to-indigo-900/5 rounded-full blur-[100px] -mr-40 -mt-40 transition-transform duration-1000 group-hover:scale-110"></div>
            
            <div class="relative z-10 flex flex-col h-full justify-between gap-12">
                <div class="flex items-start justify-between">
                    <div class="space-y-4">
                        <div class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-full text-[10px] font-semibold uppercase tracking-[0.2em] border border-blue-100 dark:border-blue-800">
                            <span class="w-2 h-2 bg-blue-600 rounded-full animate-pulse"></span>
                            Neurological Archive
                        </div>
                        <h1 class="text-4xl lg:text-6xl font-semibold text-slate-900 dark:text-white leading-[1.1] tracking-tight">
                            Transcription <br/>
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">History Hub.</span>
                        </h1>
                        <p class="text-slate-400 dark:text-slate-500 font-bold max-w-md text-sm leading-relaxed">
                            Access your comprehensive clinical intelligence repository. Every consultation, captured and analyzed by MedLink AI.
                        </p>
                    </div>
                    <div class="hidden md:flex w-24 h-24 bg-white dark:bg-slate-800 rounded-3xl shadow-2xl items-center justify-center text-blue-600 rotate-6 group-hover:rotate-0 transition-transform duration-500">
                         <i data-lucide="brain-circuit" class="w-12 h-12"></i>
                    </div>
                </div>

                <div class="flex flex-wrap gap-4">
                    <div class="px-6 py-4 bg-slate-50 dark:bg-white/5 rounded-2xl border border-slate-100 dark:border-white/5">
                        <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Total Records</div>
                        <div class="text-2xl font-semibold text-slate-900 dark:text-white">@Model.UpcomingConsultations.Count()</div>
                    </div>
                    <div class="px-6 py-4 bg-emerald-50/50 dark:bg-emerald-900/10 rounded-2xl border border-emerald-100/50 dark:border-emerald-800/20">
                        <div class="text-[10px] font-semibold text-emerald-600 uppercase tracking-widest mb-1">AI Insights</div>
                        <div class="text-2xl font-semibold text-emerald-700 dark:text-emerald-400 whitespace-nowrap">Generated</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Stats Bento -->
        <div class="grid grid-cols-1 gap-6 h-full">
            <!-- Top Alert/Status -->
            <div class="bg-gradient-to-br from-slate-900 to-slate-800 dark:from-indigo-950 dark:to-slate-900 rounded-[2.5rem] p-8 text-white relative overflow-hidden group">
                <div class="absolute inset-0 opacity-20 pointer-events-none">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-white/20 rounded-full blur-2xl -mr-16 -mt-16"></div>
                </div>
                <div class="relative z-10 flex flex-col justify-between h-full space-y-6">
                    <div class="flex items-center justify-between">
                        <i data-lucide="shield-check" class="w-8 h-8 text-blue-400"></i>
                        <span class="text-[9px] font-semibold uppercase tracking-widest px-3 py-1 bg-white/10 rounded-full">Encrypted</span>
                    </div>
                    <div>
                        <h3 class="text-lg font-semibold leading-tight mb-2">Privacy & Security</h3>
                        <p class="text-[11px] text-slate-400 font-bold leading-relaxed">Your medical transcripts are stored using military-grade AES-256 encryption.</p>
                    </div>
                    <a href="@Url.Action("SecurityProtocol", "Dashboard")" class="w-full py-3 bg-white text-slate-900 text-[10px] font-semibold uppercase tracking-widest rounded-xl hover:bg-blue-500 hover:text-white transition-all text-center flex items-center justify-center">Security Protocol</a>
                </div>
            </div>
            
            <!-- Integration Status -->
            <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] p-8 border border-slate-100 dark:border-white/5 shadow-xl shadow-slate-200/50 dark:shadow-none flex items-center gap-6 group">
                <div class="w-16 h-16 bg-blue-50 dark:bg-blue-900/20 rounded-2xl flex items-center justify-center text-blue-600 dark:text-blue-400 group-hover:scale-110 transition-transform">
                    <i data-lucide="languages" class="w-8 h-8"></i>
                </div>
                <div>
                    <h4 class="text-md font-semibold dark:text-white">Multilingual Core</h4>
                    <p class="text-[10px] font-bold text-slate-400 mt-0.5">EN / UR Processing Active</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main List (Bento Grid Style) -->
    <div class="space-y-6">
        <div class="flex items-center justify-between px-2">
            <div>
                <h2 class="text-2xl font-semibold text-slate-900 dark:text-white tracking-tight">Recent Sessions</h2>
                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-1">Timeline of consultation transcripts</p>
            </div>
            <div class="flex gap-2">
                 <button class="w-10 h-10 bg-white dark:bg-slate-800 border border-slate-100 dark:border-white/5 rounded-xl shadow-sm items-center justify-center flex text-slate-400 hover:text-blue-600 transition-all">
                    <i data-lucide="filter" class="w-4 h-4"></i>
                 </button>
                 <button class="w-10 h-10 bg-white dark:bg-slate-800 border border-slate-100 dark:border-white/5 rounded-xl shadow-sm items-center justify-center flex text-slate-400 hover:text-blue-600 transition-all">
                    <i data-lucide="search" class="w-4 h-4"></i>
                 </button>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            @if (!Model.UpcomingConsultations.Any())
            {
                <div class="col-span-full bg-white dark:bg-slate-900 rounded-[3rem] p-24 border-2 border-dashed border-slate-100 dark:border-white/5 flex flex-col items-center gap-8 justify-center">
                    <div class="w-32 h-32 bg-slate-50 dark:bg-white/5 rounded-full flex items-center justify-center text-slate-200 dark:text-slate-800 shadow-inner">
                        <i data-lucide="file-audio-2" class="w-16 h-16"></i>
                    </div>
                    <div class="text-center max-w-sm space-y-3">
                        <h3 class="text-2xl font-semibold text-slate-900 dark:text-white">Archive Empty</h3>
                        <p class="text-sm font-bold text-slate-400 leading-relaxed">No consultation recordings found. Completed sessions with recording enabled will appear here automatically.</p>
                    </div>
                    <a href="@Url.Action("Doctors", "Dashboard")" class="px-10 py-5 bg-slate-900 dark:bg-white dark:text-slate-900 text-white font-semibold rounded-2xl text-[10px] uppercase tracking-[0.2em] shadow-2xl hover:bg-blue-600 dark:hover:bg-blue-500 dark:hover:text-white hover:-translate-y-1 transition-all">Book New Consultation</a>
                </div>
            }
            else
            {
                @foreach (var consult in Model.UpcomingConsultations)
                {
                    <div class="group relative bg-white dark:bg-slate-900 rounded-[2.5rem] p-8 border border-slate-100 dark:border-white/5 shadow-xl shadow-slate-200/50 dark:shadow-none hover:shadow-2xl hover:shadow-blue-500/10 dark:hover:bg-slate-800/50 transition-all duration-500 overflow-hidden h-full flex flex-col justify-between">
                        <!-- Card Glow -->
                        <div class="absolute -bottom-20 -right-20 w-40 h-40 bg-blue-500/5 rounded-full blur-[60px] opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        
                        <div class="space-y-6">
                            <div class="flex items-center justify-between">
                                <span class="bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 text-[9px] font-semibold px-4 py-1.5 rounded-full uppercase tracking-widest border border-blue-100 dark:border-blue-800">
                                    @consult.Specialty
                                </span>
                                <div class="flex -space-x-2">
                                     <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-white/10 border-2 border-white dark:border-slate-900 flex items-center justify-center text-[10px] font-bold text-slate-400">
                                        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                                     </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-5">
                                <div class="relative shrink-0">
                                    <img src="@consult.Image" class="w-16 h-16 rounded-2xl object-cover shadow-lg border-2 border-white dark:border-white/5 group-hover:scale-105 transition-transform duration-500">
                                    <div class="absolute -bottom-1 -right-1 bg-emerald-500 border-2 border-white dark:border-slate-900 w-4 h-4 rounded-full shadow-lg"></div>
                                </div>
                                <div class="overflow-hidden">
                                    <h4 class="text-xl font-semibold text-slate-900 dark:text-white truncate group-hover:text-blue-600 transition-colors">Dr. @consult.Doctor</h4>
                                    <div class="flex items-center gap-2 mt-1">
                                        <i data-lucide="clock" class="w-3.5 h-3.5 text-slate-400"></i>
                                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">@consult.Time</span>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-6 border-t border-slate-50 dark:border-white/5 grid grid-cols-2 gap-4">
                                <div class="space-y-1">
                                    <div class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest">Intelligence</div>
                                    <div class="flex items-center gap-2 text-emerald-500 font-semibold text-[10px] uppercase tracking-wider">
                                        <i data-lucide="check-circle" class="w-3 h-3"></i> Optimized
                                    </div>
                                </div>
                                <div class="space-y-1">
                                    <div class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest">Status</div>
                                    <div class="flex items-center gap-1.5 text-blue-500 font-semibold text-[10px] uppercase tracking-wider">
                                        <i data-lucide="archive" class="w-3 h-3"></i> Live Archive
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-8 flex gap-3">
                            <a href="@Url.Action("TranscriptHistory", "Dashboard", new { id = consult.Id })" class="flex-1 py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-2xl text-[10px] font-semibold uppercase tracking-widest hover:bg-blue-600 dark:hover:bg-blue-500 dark:hover:text-white transition-all shadow-xl shadow-slate-900/10 text-center">
                                View Transcript
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
