@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Diagnostic Catalog";
    var lab = Model.SelectedLaboratory;
}

<div class="w-full lg:p-2 animate-in fade-in slide-in-from-bottom-4 duration-700 overflow-x-clip" 
     x-data="{ 
        selectedTests: [], 
        patientType: 'Adult',
        get total() {
            return this.selectedTests.reduce((acc, curr) => acc + curr.price, 0);
        },
        toggleTest(id, name, price) {
            const index = this.selectedTests.findIndex(t => t.id === id);
            if (index > -1) {
                this.selectedTests.splice(index, 1);
            } else {
                this.selectedTests.push({ id, name, price });
            }
        }
     }">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-6">
        <!-- Main: Catalog -->
        <div class="lg:col-span-8 space-y-6 lg:space-y-8">
            
            <!-- Premium Lab Header -->
            <div class="relative bg-white/40 backdrop-blur-xl border border-white rounded-[1.5rem] lg:rounded-[2rem] p-5 lg:p-6 shadow-xl flex flex-col lg:flex-row items-center gap-5 lg:gap-6 group overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 to-transparent pointer-events-none"></div>
                
                <div class="relative w-16 h-16 lg:w-24 lg:h-24 bg-white rounded-[1.2rem] lg:rounded-[1.5rem] p-2.5 lg:p-3 shadow-lg border border-slate-50 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform duration-500">
                    <img src="@lab.LogoUrl" alt="@lab.Name" class="w-full h-full object-contain">
                </div>

                <div class="relative flex-1 text-center lg:text-left min-w-0">
                    <div class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-blue-100 text-blue-600 rounded-full text-[8px] lg:text-[9px] font-black tracking-widest uppercase mb-2 lg:mb-2.5">
                        <i data-lucide="award" class="w-2.5 h-2.5 lg:w-3 h-3"></i>
                        Partner Lab
                    </div>
                    <h1 class="text-2xl lg:text-3xl font-black text-slate-900 tracking-tight leading-tight lg:leading-none mb-1.5 lg:mb-2 truncate">@lab.Name</h1>
                    <p class="text-slate-500 font-medium text-xs lg:text-sm truncate">World-class diagnostics at your doorstep.</p>
                </div>

                <!-- Patient Toggle -->
                <div class="relative w-full lg:w-auto bg-slate-900/5 backdrop-blur-md p-1 rounded-xl lg:rounded-[1.2rem] flex items-center gap-0.5 border border-slate-200/50 shadow-inner overflow-x-auto no-scrollbar">
                    <template x-for="type in ['Adult', 'Child', 'Female', 'Senior']">
                        <button @@click="patientType = type" 
                                :class="patientType === type ? 'bg-white text-blue-600 shadow-sm scale-[1.02]' : 'text-slate-500 hover:text-slate-900'"
                                class="flex-1 lg:flex-none px-3 lg:px-4 py-2 lg:py-2.5 rounded-lg lg:rounded-xl text-[9px] lg:text-[10px] font-black uppercase tracking-wider transition-all duration-300 whitespace-nowrap"
                                x-text="type">
                        </button>
                    </template>
                </div>
            </div>

            <!-- Context Alerts -->
            <div x-show="patientType === 'Senior'" x-transition:enter="transition ease-out duration-300" x-transition:enter-start="opacity-0 -translate-y-4" class="p-4 lg:p-5 bg-amber-50/80 backdrop-blur-md border border-amber-100 rounded-[1.2rem] lg:rounded-[1.5rem] flex items-center gap-3 lg:gap-4 shadow-lg shadow-amber-500/5">
                <div class="w-8 h-8 lg:w-10 lg:h-10 bg-amber-500 text-white rounded-lg lg:rounded-xl flex items-center justify-center shrink-0">
                    <i data-lucide="heart" class="w-4 h-4 lg:w-5 h-5"></i>
                </div>
                <p class="text-[10px] lg:text-xs font-bold text-amber-700/80 leading-relaxed">Special protocols: 12h fasting required for metabolic panels.</p>
            </div>

            <!-- Test Grid Sections -->
            <div class="space-y-10 lg:space-y-12">
                @foreach (var category in Model.MedicalTestCategories)
                {
                    <div class="animate-in fade-in slide-in-from-bottom-2 duration-500">
                        <div class="flex items-center gap-3 lg:gap-4 mb-4 lg:mb-5">
                            <h2 class="text-lg lg:text-lg font-black text-slate-900 tracking-tight">@category.Name</h2>
                            <div class="h-px flex-1 bg-gradient-to-r from-slate-100 to-transparent"></div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 lg:gap-5">
                            @foreach (var test in category.MedicalTests)
                            {
                                <div @@click="toggleTest(@test.Id, '@test.Name', @test.Price)"
                                     :class="selectedTests.some(t => t.id === @test.Id) ? 'border-blue-500 bg-blue-50/50 ring-2 ring-blue-500/5 scale-[1.01]' : 'border-slate-100/50 bg-white/40 hover:bg-white hover:border-blue-200'"
                                     class="relative p-4 lg:p-5 rounded-[1.2rem] lg:rounded-[1.5rem] border backdrop-blur-md cursor-pointer transition-all duration-500 group overflow-hidden shadow-sm hover:shadow-lg">
                                    
                                    <div class="relative flex justify-between items-start">
                                        <div class="space-y-2.5 min-w-0 flex-1 pr-4">
                                            <div class="space-y-0.5">
                                                <h4 class="text-sm lg:text-base font-black text-slate-900 tracking-tight transition-colors group-hover:text-blue-600 truncate">@test.Name</h4>
                                                <div class="flex flex-wrap items-center gap-2 text-[8px] lg:text-[9px] font-black text-slate-400 uppercase tracking-widest">
                                                    <span class="flex items-center gap-1 font-bold whitespace-nowrap">
                                                        <i data-lucide="timer" class="w-2.5 h-2.5 lg:w-3 h-3 text-blue-500"></i> @test.ReportTime
                                                    </span>
                                                    <span class="flex items-center gap-1 font-bold whitespace-nowrap">
                                                        <i data-lucide="droplets" class="w-2.5 h-2.5 lg:w-3 h-3 text-blue-500"></i> @test.SampleType
                                                    </span>
                                                </div>
                                            </div>
                                            <p class="text-[10px] lg:text-[11px] font-medium text-slate-500 leading-none truncate">ISO Certified Lab Verification</p>
                                        </div>

                                        <div class="text-right shrink-0">
                                            <div class="text-base lg:text-lg font-black text-slate-900 group-hover:text-blue-600 transition-colors tracking-tighter">
                                                <span class="text-[10px] lg:text-xs font-bold text-slate-400">Rs.</span>@test.Price
                                            </div>
                                            
                                            <div :class="selectedTests.some(t => t.id === @test.Id) ? 'bg-blue-600 scale-105 shadow-md shadow-blue-500/20' : 'bg-slate-100 text-transparent'"
                                                 class="w-7 h-7 lg:w-8 lg:h-8 rounded-full flex items-center justify-center mt-3 lg:mt-4 ml-auto transition-all duration-500">
                                                <i data-lucide="check" class="w-3.5 h-3.5 lg:w-4 h-4 text-white"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Sidebar Selection Dock -->
        <div class="lg:col-span-4 shrink-0">
            <div class="sticky top-6 bg-slate-900 text-white rounded-[1.5rem] lg:rounded-[2rem] p-5 lg:p-6 shadow-2xl overflow-hidden group/dock">
                <!-- Abstract Glow -->
                <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(circle_at_0%_0%,rgba(59,130,246,0.2),transparent)] pointer-events-none"></div>

                <div class="relative z-10 flex flex-col h-full min-h-[400px]">
                    <div class="flex items-center justify-between mb-6">
                        <h3 class="text-lg lg:text-xl font-black tracking-tight">Selection</h3>
                        <div class="px-2 py-0.5 bg-white/10 rounded-full text-[8px] lg:text-[9px] font-black tracking-widest uppercase">
                            <span x-text="selectedTests.length"></span> Tests
                        </div>
                    </div>

                    <div class="flex-1 space-y-3 overflow-y-auto pr-1 custom-glass-scrollbar">
                        <template x-if="selectedTests.length === 0">
                            <div class="h-full flex flex-col items-center justify-center text-center opacity-30 py-12">
                                <i data-lucide="test-tube" class="w-10 h-10 mb-4"></i>
                                <p class="text-[10px] font-medium">Add tests from the catalog.</p>
                            </div>
                        </template>

                        <template x-for="test in selectedTests" :key="test.id">
                            <div class="flex items-center justify-between gap-2 p-3.5 bg-white/5 rounded-xl border border-white/5 hover:bg-white/10 transition-all">
                                <div class="min-w-0">
                                    <p class="text-[11px] font-black text-white truncate" x-text="test.name"></p>
                                    <p class="text-[9px] font-black text-blue-400 uppercase tracking-widest mt-0.5" x-text="'Rs. ' + test.price"></p>
                                </div>
                                <button @@click.stop="toggleTest(test.id, test.name, test.price)" class="text-white/20 hover:text-rose-500 transition-all shrink-0">
                                    <i data-lucide="minus-circle" class="w-4.5 h-4.5"></i>
                                </button>
                            </div>
                        </template>
                    </div>

                    <div class="mt-6 pt-6 border-t border-white/10">
                        <div class="flex items-end justify-between mb-5">
                            <div class="space-y-0.5">
                                <p class="text-[8px] font-black text-white/40 uppercase tracking-widest">Investment</p>
                                <p class="text-2xl lg:text-3xl font-black tracking-tighter" x-text="'Rs. ' + total"></p>
                            </div>
                            <p class="text-[8px] font-black text-emerald-400 uppercase tracking-widest bg-emerald-400/10 px-2 py-0.5 rounded-full">Fast Reports</p>
                        </div>

                        <button :disabled="selectedTests.length === 0"
                                @@click="window.location.href = '@Url.Action("Booking", "LabDiagnostics")?labId=@lab.Id&testIds=' + selectedTests.map(t => t.id).join(',')"
                                class="w-full h-14 lg:h-16 bg-blue-600 text-white rounded-[1.2rem] font-black text-base shadow-lg shadow-blue-600/20 hover:bg-blue-500 active:scale-[0.98] disabled:bg-white/5 disabled:text-white/10 transition-all flex items-center justify-center gap-2 group/btn">
                            Proceed to Booking
                            <i data-lucide="arrow-right" class="w-4 h-4 lg:w-5 h-5 group-hover:translate-x-1 transition-transform"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-glass-scrollbar::-webkit-scrollbar {
        width: 3px;
    }
    .custom-glass-scrollbar::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.03);
    }
    .custom-glass-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.08);
        border-radius: 10px;
    }
    
    [x-cloak] { display: none !important; }

    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
