<section id="security" class="py-16 md:py-24 px-4 md:px-6 bg-white overflow-hidden relative fade-up" data-animate>
    <div class="max-w-6xl mx-auto">
        <div class="security-inner bg-gray-900 rounded-[2rem] p-6 md:p-16 flex flex-col lg:flex-row items-center gap-8 md:gap-16 relative overflow-hidden">
            <div class="absolute inset-0 opacity-10 pointer-events-none">
                <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(#3b82f6_1px,transparent_1px)] [background-size:20px_20px]"></div>
            </div>

            <div class="relative z-10 flex-1 fade-right delay-200" data-animate>
                <div class="inline-flex items-center gap-2 text-blue-400 font-bold mb-4 text-sm tracking-wider uppercase">
                    <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                    Privacy & Compliance
                </div>
                <h2 class="security-heading text-2xl md:text-4xl font-bold text-white mb-4 md:mb-6 leading-tight tracking-tight">
                    Healthcare-grade security <br /> for total peace of mind.
                </h2>
                <p class="text-gray-400 text-sm md:text-lg mb-6 md:mb-8 leading-relaxed max-w-lg">
                    Your data is encrypted end-to-end. We adhere to the strictest global healthcare
                    regulations including HIPAA and GDPR.
                </p>

                <div class="space-y-3 stagger-children" data-animate>
                    @{
                        var securityFeatures = new[]
                        {
                                        "Multi-factor authentication for all users",
                                        "Consent-based record sharing protocols",
                                        "Encrypted cloud storage with 99.9% availability",
                                        "Regular third-party security audits"
                                        };
                    }

                    @foreach (var feature in securityFeatures)
                    {
                        <div class="flex items-center gap-3 text-gray-300 fade-up" data-animate>
                            <div class="w-5 h-5 rounded-full bg-blue-500/20 flex items-center justify-center text-blue-400 flex-shrink-0">
                                <i data-lucide="check-circle" class="w-3 h-3"></i>
                            </div>
                            <span class="font-medium text-sm md:text-base">@feature</span>
                        </div>
                    }
                </div>
            </div>

            <div class="relative z-10 flex-1 flex justify-center fade-left delay-300" data-animate>
                <div class="relative">
                    <div class="w-48 h-48 md:w-64 md:h-64 bg-blue-600/20 rounded-full blur-[60px] absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"></div>
                    <div class="security-shield-card relative bg-gray-800 p-6 md:p-10 rounded-2xl border border-gray-700 shadow-xl backdrop-blur-sm animate-float">
                        <i data-lucide="shield-check" class="w-12 h-12 md:w-16 md:h-16 text-blue-500 mx-auto mb-4 md:mb-6"></i>
                        <div class="text-center">
                            <div class="text-white text-xl md:text-2xl font-bold mb-1 md:mb-2">Secure Core</div>
                            <div class="text-gray-400 text-xs md:text-sm">256-bit AES Encryption</div>
                        </div>
                    </div>

                    <div class="absolute -top-3 -right-3 md:-top-4 md:-right-4 bg-green-500/20 text-green-400 p-2.5 md:p-3 rounded-xl border border-green-500/30 backdrop-blur-md">
                        <i data-lucide="eye-off" class="w-4 h-4 md:w-5 md:h-5"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    .animate-float {
        animation: float 3s ease-in-out infinite;
    }
</style>