@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Find Doctors";
    ViewData["HeaderTitle"] = "Find Doctors";
    ViewData["HeaderSubtitle"] = "Connect with top specialists for your health needs.";
}


<div class="space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <!-- Premium Search & Filter Header -->
    <div class="relative z-40 bg-white/40 backdrop-blur-xl border border-white rounded-3xl lg:rounded-[2.5rem] p-4 md:p-5 lg:p-4 shadow-2xl shadow-blue-900/5">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-3 md:gap-4">
            <!-- Search Interaction -->
            <div class="relative group flex-1 w-full">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <i data-lucide="search" class="w-4 h-4 md:w-5 h-5 text-gray-400 group-focus-within:text-blue-600 transition-colors"></i>
                </div>
                <input type="text" id="doctorSearchInput" 
                       placeholder="Search by name, specialty..." 
                       class="w-full pl-11 pr-4 py-3 md:py-4 bg-white/50 border border-gray-100/50 rounded-xl md:rounded-2xl text-sm md:text-sm font-bold placeholder:text-gray-400 focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500/50 transition-all shadow-inner">
            </div>

            <div class="flex items-center gap-2 md:gap-3 w-full lg:w-auto">
                <div class="relative flex-1 lg:flex-none">
                    <button id="filterBtn" onclick="toggleFilterMenu()" 
                            class="w-full lg:w-auto px-4 lg:px-6 py-3 md:py-4 bg-white border border-gray-100 rounded-xl md:rounded-2xl text-xs md:text-xs font-semibold text-gray-600 uppercase tracking-widest hover:bg-gray-50 hover:border-blue-200 hover:text-blue-600 transition-all shadow-sm flex items-center justify-center gap-2">
                        <i data-lucide="sliders-horizontal" class="w-4 h-4 md:w-4 h-4"></i> Filters
                    </button>
                    <!-- Filters Dropdown (Mobile-First Responsive) -->
                    <div id="filterMenu" class="hidden absolute top-full left-0 lg:right-0 lg:left-auto mt-3 w-[calc(100vw-2rem)] max-w-xs lg:w-64 bg-white rounded-2xl lg:rounded-3xl shadow-2xl border border-gray-100/50 z-50 p-4 animate-in fade-in zoom-in-95 duration-200">
                        <div class="flex items-center justify-between mb-4 px-2">
                             <span class="text-[10px] font-semibold uppercase text-gray-400 tracking-widest">Medical Specialties</span>
                             <button onclick="filterBySpecialty('')" class="text-[10px] font-semibold text-rose-500 hover:text-rose-600 uppercase tracking-widest">Reset</button>
                        </div>
                        <div class="grid grid-cols-1 gap-1 max-h-72 overflow-y-auto pr-1 custom-scrollbar" id="specialtyList">
                            @foreach (var specialty in Model.AvailableDoctors.Select(d => d.Specialty).Distinct())
                            {
                                <button onclick="filterBySpecialty('@specialty')" 
                                        class="w-full text-left px-4 py-3 rounded-xl text-xs font-bold text-gray-600 hover:bg-blue-50 hover:text-blue-600 transition-all flex items-center justify-between group">
                                    @specialty
                                    <div class="w-1.5 h-1.5 rounded-full bg-blue-600 opacity-0 group-[.active]:opacity-100 transition-opacity"></div>
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <button id="nearMeBtn" onclick="toggleNearMe()" 
                        class="flex-1 lg:flex-none px-4 lg:px-6 py-3 md:py-4 bg-white border border-gray-100 rounded-xl md:rounded-2xl text-xs md:text-xs font-semibold text-gray-600 uppercase tracking-widest hover:bg-emerald-50 hover:border-emerald-200 hover:text-emerald-600 transition-all shadow-sm flex items-center justify-center gap-2">
                     <i data-lucide="map-pin" class="w-4 h-4 md:w-4 h-4"></i> Near Me
                </button>
            </div>
        </div>
    </div>

    <!-- Enhanced Grid with Premium Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8" id="doctorsGrid">
        
        <!-- Skeleton Loader (Strictly Maintained) -->
        <div class="skeleton-loader contents">
            @for(int i=0; i<6; i++) {
                <div class="bg-white rounded-3xl p-5 border border-gray-50 shadow-sm space-y-4">
                    <div class="flex items-start gap-4">
                        <div class="w-16 h-16 rounded-2xl bg-gray-200 animate-pulse"></div>
                        <div class="flex-1 space-y-2">
                            <div class="h-5 w-3/4 bg-gray-200 rounded animate-pulse"></div>
                            <div class="h-3 w-1/2 bg-gray-200 rounded animate-pulse"></div>
                            <div class="flex gap-1 pt-1">
                                <div class="h-3 w-12 bg-gray-200 rounded animate-pulse"></div>
                                <div class="h-3 w-12 bg-gray-200 rounded animate-pulse"></div>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-3 gap-2 pt-2">
                        <div class="h-9 bg-gray-100 rounded-xl animate-pulse"></div>
                         <div class="h-9 bg-gray-100 rounded-xl animate-pulse"></div>
                          <div class="h-9 bg-gray-100 rounded-xl animate-pulse"></div>
                    </div>
                </div>
            }
        </div>

        <!-- Premium Real Content -->
        @foreach (var doctor in Model.AvailableDoctors)
        {
            <div class="doctor-card page-content group relative"
                 data-name="@doctor.Name" 
                 data-specialty="@doctor.Specialty" 
                 data-expertise="@(doctor.Expertise ?? "")"
                 data-online="@doctor.Online.ToString().ToLower()"
                 data-docid="@doctor.Id"
                 data-userid="@(doctor.UserId ?? "")">
                
                <div class="h-full bg-white rounded-[2.5rem] p-6 border border-gray-100 shadow-sm hover:shadow-2xl hover:shadow-blue-900/10 hover:-translate-y-2 transition-all duration-500 overflow-hidden relative">
                    <!-- Background Accent -->
                    <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50/30 rounded-full blur-3xl -mr-16 -mt-16 group-hover:bg-blue-100/50 transition-colors"></div>
                    
                    <!-- Online Pulse Indicator -->
                    @if(doctor.Online) {
                        <div class="absolute top-6 right-6 flex items-center gap-2">
                             <span class="relative flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                            </span>
                            <span class="text-[9px] font-semibold text-emerald-600 uppercase tracking-widest">Active</span>
                        </div>
                    }

                    <div class="flex flex-col items-center text-center mb-6">
                        <div class="relative mb-4">
                            <div class="absolute inset-0 bg-blue-600/10 rounded-[2rem] scale-110 blur-xl group-hover:scale-125 transition-transform"></div>
                            @{
                                var imageUrl = !string.IsNullOrEmpty(doctor.Image) 
                                    ? doctor.Image 
                                    : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(doctor.Name)}&size=200&background=random&color=fff&bold=true";
                            }
                            <img src="@imageUrl" class="relative w-24 h-24 rounded-[2rem] object-cover shadow-xl border-4 border-white">
                        </div>
                        
                        <h3 class="font-semibold text-gray-900 text-xl tracking-tight mb-1">@doctor.Name</h3>
                        <p class="text-blue-600 text-xs font-semibold uppercase tracking-widest mb-3">@doctor.Specialty</p>
                        
                        <div class="flex items-center gap-4">
                            <div class="flex items-center gap-1.5 bg-amber-50 px-3 py-1 rounded-full border border-amber-100">
                                <i data-lucide="star" class="w-3.5 h-3.5 text-amber-500 fill-current"></i>
                                <span class="text-xs font-semibold text-amber-700">@doctor.Rating</span>
                            </div>
                            <div class="text-[10px] font-semibold text-gray-400 uppercase tracking-widest">
                                @doctor.Experience exp
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3 mb-6">
                        <div class="bg-gray-50/50 border border-gray-100/50 rounded-2xl p-3 text-center">
                            <div class="text-[8px] font-semibold text-gray-400 uppercase tracking-widest mb-1">Availability</div>
                            <div class="text-[10px] font-bold text-gray-900 truncate">@doctor.Availability</div>
                        </div>
                        <div class="bg-gray-50/50 border border-gray-100/50 rounded-2xl p-3 text-center">
                            <div class="text-[8px] font-semibold text-gray-400 uppercase tracking-widest mb-1">Reviews</div>
                            <div class="text-[10px] font-bold text-gray-900">@doctor.Reviews</div>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <a href="@Url.Action("DoctorProfile", "Dashboard", new { id = doctor.Id })" 
                           class="w-full py-4 bg-blue-600/5 text-blue-600 rounded-2xl text-[10px] font-semibold uppercase tracking-[0.15em] hover:bg-blue-600 hover:text-white transition-all flex items-center justify-center gap-2 group/btn shadow-sm">
                            View Expert Profile
                            <i data-lucide="move-right" class="w-3.5 h-3.5 group-hover/btn:translate-x-1 transition-transform"></i>
                        </a>

                        <div class="grid grid-cols-3 gap-2 pt-1">
                            <a href="@Url.Action("Messages", "Dashboard")" 
                               class="py-3 rounded-2xl border border-gray-100/80 text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition-all flex items-center justify-center font-bold text-xs"
                               title="Message">
                                <i data-lucide="message-square" class="w-4 h-4"></i>
                            </a>
                            @if (!string.IsNullOrEmpty(doctor.UserId)) {
                            <button onclick="startCall('@doctor.UserId', '@doctor.Name', 'video')" 
                                    class="py-3 rounded-2xl border border-gray-100/80 text-gray-600 hover:bg-gray-50 hover:text-blue-600 transition-all flex items-center justify-center font-bold text-xs"
                                    title="Video Call">
                                <i data-lucide="video" class="w-4 h-4"></i>
                            </button>
                            } else {
                            <button disabled class="py-3 rounded-2xl border border-gray-100/80 text-gray-200 flex items-center justify-center font-bold text-xs cursor-not-allowed" title="Call unavailable">
                                <i data-lucide="video" class="w-4 h-4"></i>
                            </button>
                            }
                            <a href="@Url.Action("BookAppointment", "Dashboard", new { doctorId = doctor.Id })" 
                               class="py-3 rounded-2xl bg-gray-900 text-white hover:bg-blue-600 transition-all flex items-center justify-center font-semibold text-[10px] uppercase tracking-widest shadow-lg shadow-gray-200 group-hover:scale-105 active:scale-95">
                                Book
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    // Initialize once per load, preserve state across AJAX navigations
    if (typeof window.doctorState === 'undefined') {
        window.doctorState = {
            currentSpecialty: '',
            isNearMe: false
        };
    }

    // Initiate a WebRTC call from the doctors grid
    function startCall(targetUserId, targetName, callType) {
        if (!targetUserId) {
            showToast && showToast('This doctor is not available for online calls.', 'error');
            return;
        }
        if (window.globalCallHandler) {
            window.globalCallHandler.initiateCall(targetUserId, targetName, callType);
        } else {
            showToast && showToast('Call system is initializing, please try again.', 'info');
        }
    }

    // Initialize after every AJAX load
    (function initializeDoctors() {
        const searchInput = document.getElementById('doctorSearchInput');
        if (searchInput) {
            searchInput.addEventListener('input', applyFilters);
        }
        // Re-apply current state if navigating back
        applyFilters(); 
    })();

    function toggleFilterMenu() {
        const menu = document.getElementById('filterMenu');
        if (menu) menu.classList.toggle('hidden');
    }

    function toggleNearMe() {
        const btn = document.getElementById('nearMeBtn');

        if (window.doctorState.isNearMe) {
            // Toggle off - restore normal list
            window.doctorState.isNearMe = false;
            document.querySelectorAll('.doctor-card').forEach(c => c.style.order = '');
            if (btn) {
                btn.classList.remove('bg-emerald-600', 'text-white', 'border-emerald-600');
                btn.classList.add('bg-white', 'text-gray-600');
                btn.querySelector('span') && btn.querySelector('span').remove();
            }
            applyFilters();
            return;
        }

        // Requesting location
        if (!navigator.geolocation) {
            showToast && showToast('Geolocation not supported', 'error');
            return;
        }

        if (btn) {
            btn.innerHTML = '<i data-lucide="loader" class="w-4 h-4 animate-spin"></i> Locating...';
            lucide && lucide.createIcons();
        }

        navigator.geolocation.getCurrentPosition(
            async (pos) => {
                const lat = pos.coords.latitude;
                const lng = pos.coords.longitude;
                window.doctorState.isNearMe = true;

                // Call the backend to get nearby doctors sorted by distance
                try {
                    const res = await fetch(`/Dashboard/GetNearbyDoctors?lat=${lat}&lng=${lng}`);
                    const data = await res.json();
                    if (data.success && data.doctors) {
                        // Reorder the doctor cards based on distance
                        const grid = document.getElementById('doctorsGrid');
                        const cards = [...document.querySelectorAll('.doctor-card')];
                        
                        data.doctors.forEach((d, idx) => {
                            const card = cards.find(c => c.dataset.docid == d.id);
                            if (card) card.style.order = idx;
                        });

                        // Add distance badge to each card
                        data.doctors.forEach(d => {
                            const card = document.querySelector(`.doctor-card[data-docid='${d.id}']`);
                            if (card && d.distanceKm !== null) {
                                let badge = card.querySelector('.near-me-badge');
                                if (!badge) {
                                    badge = document.createElement('div');
                                    badge.className = 'near-me-badge absolute top-6 left-6 bg-emerald-500/90 backdrop-blur-md text-white px-2 py-0.5 rounded-full text-[9px] font-semibold flex items-center gap-1';
                                    card.querySelector('.h-full')?.appendChild(badge);
                                }
                                badge.innerHTML = `<i data-lucide="map-pin" style="width:10px;height:10px"></i> ${d.distanceKm.toFixed(1)} km`;
                                lucide && lucide.createIcons();
                            }
                        });
                    }
                } catch(e) {
                    console.error('Near Me fetch failed', e);
                }

                if (btn) {
                    btn.innerHTML = '<i data-lucide="map-pin" class="w-4 h-4"></i> Near Me <span class="w-2 h-2 rounded-full bg-emerald-400"></span>';
                    btn.classList.add('bg-emerald-600', 'text-white', 'border-emerald-600');
                    btn.classList.remove('bg-white', 'text-gray-600');
                    lucide && lucide.createIcons();
                }
                applyFilters();
            },
            (err) => {
                showToast && showToast('Location permission denied. Enable location access.', 'error');
                if (btn) {
                    btn.innerHTML = '<i data-lucide="map-pin" class="w-4 h-4"></i> Near Me';
                    lucide && lucide.createIcons();
                }
            },
            { timeout: 8000 }
        );
    }

    function filterBySpecialty(specialty) {
        window.doctorState.currentSpecialty = specialty;
        
        // UI feedback for active specialty
        document.querySelectorAll('#specialtyList button').forEach(btn => {
            if (btn.textContent.trim() === specialty) {
                btn.classList.add('bg-blue-50', 'text-blue-600');
            } else {
                btn.classList.remove('bg-blue-50', 'text-blue-600');
            }
        });

        toggleFilterMenu();
        applyFilters();
    }

    function applyFilters() {
        const input = document.getElementById('doctorSearchInput');
        if (!input) return;
        
        const term = input.value.toLowerCase();
        const cards = document.querySelectorAll('.doctor-card');
        
        cards.forEach(card => {
            const name = card.dataset.name.toLowerCase();
            const spec = card.dataset.specialty.toLowerCase();
            const expertise = card.dataset.expertise.toLowerCase();
            const online = card.dataset.online === 'true';

            let show = true;

            // Search filter
            if (term && !(name.includes(term) || spec.includes(term) || expertise.includes(term))) {
                show = false;
            }

            // Specialty filter
            if (window.doctorState.currentSpecialty && card.dataset.specialty !== window.doctorState.currentSpecialty) {
                show = false;
            }

            // Near Me filter
            if (window.doctorState.isNearMe && !online) {
                show = false;
            }

            if (show) {
                card.classList.remove('hidden');
            } else {
                card.classList.add('hidden');
            }
        });
    }

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
        const menu = document.getElementById('filterMenu');
        const btn = document.getElementById('filterBtn');
        if (menu && btn && !menu.contains(e.target) && !btn.contains(e.target)) {
            menu.classList.add('hidden');
        }
    });
</script>
