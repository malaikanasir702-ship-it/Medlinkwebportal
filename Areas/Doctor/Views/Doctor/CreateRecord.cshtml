@model MedLinkPortal.Areas.Doctor.Models.PatientRecord

@{
    ViewData["Title"] = "Create Patient Record";
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
}

<div class="max-w-4xl mx-auto py-6 md:py-12 space-y-6 md:space-y-12 reveal">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 md:gap-8 bg-slate-900 rounded-[2.5rem] md:rounded-[40px] p-6 md:p-10 shadow-2xl relative overflow-hidden">
        <div class="absolute -right-20 -top-20 opacity-10">
            <i class="fas fa-file-medical text-[150px] md:text-[200px] text-white"></i>
        </div>
        <div class="relative z-10">
            <h1 class="text-3xl font-semibold text-white tracking-tight">Create Record</h1>
            <p class="text-[10px] font-semibold text-blue-500 uppercase tracking-widest mt-2 flex items-center">
                <i class="fas fa-fingerprint mr-3"></i>
                Patient: <span class="text-white ml-2">@(ViewBag.PatientName ?? "Patient")</span>
            </p>
        </div>
        <div class="relative z-10">
            <a asp-action="ViewHistory" asp-route-patientId="@Model.PatientId" 
               class="px-8 py-4 bg-white/10 text-white rounded-2xl text-[11px] font-semibold uppercase tracking-widest hover:bg-white/20 transition-all flex items-center justify-center border border-white/10">
                Cancel
            </a>
        </div>
    </div>

    <!-- Terminal Card -->
    <div class="premium-card p-12">
        <form asp-action="CreateRecord" method="post" class="space-y-10">
            <div asp-validation-summary="ModelOnly" class="p-6 bg-red-500/10 border border-red-500/20 rounded-2xl text-red-500 text-xs font-bold uppercase tracking-widest"></div>
            
            <input type="hidden" asp-for="PatientId" />
            <input type="hidden" asp-for="DoctorId" />

            <!-- Input Grid -->
            <div class="space-y-12">
                <!-- Diagnosis Vector -->
                <div class="space-y-4">
                    <label asp-for="Diagnosis" class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] flex items-center justify-between w-full">
                        <span class="flex items-center">
                            <span class="w-2 h-2 bg-blue-500 rounded-full mr-3"></span>
                            Diagnosis
                        </span>
                        @if (ViewBag.IsPro == true) {
                            <button type="button" id="getAiSuggestions" class="px-3 py-1 bg-gradient-to-r from-blue-600 to-indigo-600 text-white text-[9px] font-semibold rounded-lg uppercase tracking-widest hover:scale-105 transition-all shadow-lg shadow-blue-500/20">
                                <i class="fas fa-robot mr-2"></i> Get AI Suggestions
                            </button>
                        } else {
                            <a asp-action="MedLinkPro" class="px-3 py-1 bg-white/5 border border-white/10 text-slate-400 text-[9px] font-semibold rounded-lg uppercase tracking-widest hover:text-blue-400 hover:border-blue-400/30 transition-all">
                                <i class="fas fa-lock mr-2"></i> AI Suggestions (PRO)
                            </a>
                        }
                    </label>
                    <div class="relative group">
                        <textarea asp-for="Diagnosis" rows="3" 
                                  class="premium-input w-full min-h-[120px] pt-6"
                                  placeholder="Input diagnostic findings..."></textarea>
                        <i class="fas fa-stethoscope absolute top-6 right-6 text-slate-300 group-focus-within:text-blue-500 transition-colors"></i>
                    </div>
                    <span asp-validation-for="Diagnosis" class="text-red-500 text-[10px] font-semibold uppercase tracking-widest"></span>
                </div>

                <!-- Biometrics & Clinical Anchors -->
                <div class="grid md:grid-cols-2 gap-10 pt-8 border-t border-slate-100 dark:border-white/5">
                    <div class="space-y-4">
                        <label asp-for="Vitals" class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] flex items-center">
                            <span class="w-2 h-2 bg-emerald-500 rounded-full mr-3"></span>
                            Biometric Vitals
                        </label>
                        <div class="relative group">
                            <input asp-for="Vitals" class="premium-input w-full pl-12" placeholder="BP, HR, Temp, SpO2..." />
                            <i class="fas fa-heart-pulse absolute left-4 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-emerald-500 transition-colors"></i>
                        </div>
                    </div>
                    <div class="space-y-4">
                        <label asp-for="Allergies" class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] flex items-center">
                            <span class="w-2 h-2 bg-red-500 rounded-full mr-3"></span>
                            Allergen Matrix
                        </label>
                        <div class="relative group">
                            <input asp-for="Allergies" class="premium-input w-full pl-12" placeholder="Identify reactionary agents..." />
                            <i class="fas fa-shield-virus absolute left-4 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-red-500 transition-colors"></i>
                        </div>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-10">
                    <!-- Prescription Deck -->
                    <div class="space-y-4">
                        <label asp-for="Prescription" class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] flex items-center">
                            <span class="w-2 h-2 bg-purple-500 rounded-full mr-3"></span>
                            Pharmacology Deck
                        </label>
                        <div class="relative group">
                            <textarea asp-for="Prescription" rows="5" 
                                      class="premium-input w-full min-h-[180px] pt-6"
                                      placeholder="Define medication vectors..."></textarea>
                            <i class="fas fa-prescription absolute top-6 right-6 text-slate-300 group-focus-within:text-purple-500 transition-colors"></i>
                        </div>
                        <span asp-validation-for="Prescription" class="text-red-500 text-[10px] font-semibold uppercase tracking-widest"></span>
                    </div>

                    <!-- Clinical Notes -->
                    <div class="space-y-4">
                        <label asp-for="Notes" class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] flex items-center">
                            <span class="w-2 h-2 bg-emerald-500 rounded-full mr-3"></span>
                            Observation Logs
                        </label>
                        <div class="relative group">
                            <textarea asp-for="Notes" rows="5" 
                                      class="premium-input w-full min-h-[180px] pt-6"
                                      placeholder="Append clinical observations..."></textarea>
                            <i class="fas fa-notes-medical absolute top-6 right-6 text-slate-300 group-focus-within:text-emerald-500 transition-colors"></i>
                        </div>
                        <span asp-validation-for="Notes" class="text-red-500 text-[10px] font-semibold uppercase tracking-widest"></span>
                    </div>
                </div>
            </div>

            <!-- Terminal Actions -->
            <div class="pt-10 border-t border-slate-100 dark:border-white/5 flex items-center justify-between">
                <div class="hidden md:flex items-center text-[10px] font-semibold text-slate-400 uppercase tracking-widest">
                    <i class="fas fa-shield-alt mr-3 text-blue-500"></i>
                    Secured by MedLink Core
                </div>
                <button type="submit" 
                        class="w-full md:w-auto px-12 py-5 bg-blue-600 text-white rounded-2xl text-[11px] font-semibold uppercase tracking-widest hover:bg-blue-700 shadow-xl shadow-blue-500/20 transition-all flex items-center justify-center">
                    Save Record <i class="fas fa-arrow-right ml-4"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('getAiSuggestions')?.addEventListener('click', async function() {
            const diagArea = document.querySelector('textarea[name="Diagnosis"]');
            const vitals = document.querySelector('input[name="Vitals"]').value;
            
            if (!vitals) {
                await PremiumModal.alert('Please input patient vitals first for a more accurate AI analysis.', 'Insufficient Data');
            }

            // Simulate AI Processing
            const btn = this;
            const originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Analyzing...';
            btn.disabled = true;

            setTimeout(async () => {
                const suggestions = [
                    "Based on vitals, consider potential metabolic syndrome evaluation.",
                    "Rule out respiratory infection if HR remains elevated above 100bpm.",
                    "Current vitals suggest stable recovery; maintain existing protocol.",
                    "Recommend electrolyte panel if SpO2 dips during sleep cycles."
                ];
                const selected = suggestions[Math.floor(Math.random() * suggestions.Length)];
                
                diagArea.value += (diagArea.value ? "\n\n" : "") + "[AI Suggestion]: " + selected;
                btn.innerHTML = originalHtml;
                btn.disabled = false;
                
                await PremiumModal.success('AI Suggestions have been integrated into your diagnosis vector.', 'Analysis Complete');
            }, 2000);
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
