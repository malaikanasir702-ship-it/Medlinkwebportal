<section id="pharmacy" class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

            <!-- Left: Content -->
            <div class="fade-up" data-animate>
                <div class="inline-flex items-center gap-2 text-emerald-600 font-bold mb-4 text-sm tracking-widest uppercase">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    Online Pharmacy
                </div>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight leading-tight mb-5">
                    Medicines delivered <br />
                    <span class="text-gray-400 italic">right to your door.</span>
                </h2>
                <p class="text-gray-500 text-base leading-relaxed mb-8 max-w-lg">
                    Browse thousands of prescription and OTC medicines. Upload your prescription, get it verified by a licensed pharmacist, and receive your order the same day — no queues, no hassle.
                </p>

                <div class="space-y-4 mb-8">
                    @foreach (var item in new[] {
                        new { icon = "check-circle", text = "Licensed pharmacist verification on every order" },
                        new { icon = "truck", text = "Same-day delivery available in major cities" },
                        new { icon = "shield", text = "Authentic medicines from certified suppliers only" },
                        new { icon = "refresh-cw", text = "Automated refill reminders linked to your prescriptions" }
                    })
                    {
                        <div class="flex items-start gap-3">
                            <div style="background-color:#d1fae5; width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    @if (item.icon == "check-circle") { <text>&#x2713;</text> }
                                    @if (item.icon == "truck") { <text>&#x1F69A;</text> }
                                </svg>
                                <!-- Fallback colored dot -->
                                <svg xmlns="http://www.w3.org/2000/svg" width="8" height="8" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4" fill="#059669"/></svg>
                            </div>
                            <p class="text-gray-600 text-sm leading-relaxed pt-1">@item.text</p>
                        </div>
                    }
                </div>

                <a asp-area="Identity" asp-page="/Account/Login"
                   class="inline-flex items-center gap-2 bg-emerald-600 text-white text-sm font-bold px-6 py-3 rounded-full hover:bg-emerald-700 transition-all shadow-md hover:shadow-emerald-200 active:scale-95">
                    Order Medicines Now
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
            </div>

            <!-- Right: Visual Card -->
            <div class="fade-up delay-200" data-animate>
                <div class="bg-gradient-to-br from-emerald-50 to-white border border-emerald-100 rounded-3xl p-8">
                    <!-- Mock pharmacy UI card -->
                    <div class="mb-6">
                        <p class="text-xs font-bold text-emerald-600 uppercase tracking-widest mb-3">Popular Categories</p>
                        <div class="grid grid-cols-3 gap-3">
                            @foreach (var cat in new[] {
                                new { name = "Pain Relief", color = "#fee2e2", icon = "💊" },
                                new { name = "Vitamins", color = "#fef9c3", icon = "🌿" },
                                new { name = "Antibiotics", color = "#dbeafe", icon = "💉" },
                                new { name = "Heart Care", color = "#fce7f3", icon = "❤️" },
                                new { name = "Diabetes", color = "#e0f2fe", icon = "🩸" },
                                new { name = "Eye Drops", color = "#ede9fe", icon = "👁️" }
                            })
                            {
                                <div class="rounded-2xl p-3 text-center cursor-pointer hover:shadow-md transition-shadow" style="background-color:@cat.color;">
                                    <div class="text-2xl mb-1">@cat.icon</div>
                                    <p class="text-xs font-semibold text-gray-700">@cat.name</p>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="border-t border-emerald-100 pt-5 flex items-center justify-between">
                        <div>
                            <p class="text-xs text-gray-400 font-medium">Average delivery time</p>
                            <p class="text-2xl font-bold text-gray-900">2–4 hrs</p>
                        </div>
                        <div class="text-right">
                            <p class="text-xs text-gray-400 font-medium">Orders fulfilled</p>
                            <p class="text-2xl font-bold text-gray-900">50K+</p>
                        </div>
                        <div class="text-right">
                            <p class="text-xs text-gray-400 font-medium">Pharmacies</p>
                            <p class="text-2xl font-bold text-gray-900">120+</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
