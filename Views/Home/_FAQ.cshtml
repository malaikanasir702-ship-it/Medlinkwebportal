@model List<MedLinkPortal.Models.FAQ>

<section class="py-32 px-6 bg-white">
    <div class="max-w-3xl mx-auto">
        <div class="text-center mb-16 fade-down" data-animate>
            <div class="inline-flex p-3 rounded-2xl bg-blue-50 text-blue-600 mb-6">
                <i data-lucide="help-circle" class="w-8 h-8"></i>
            </div>
            <h2 class="text-4xl font-bold text-gray-900 tracking-tight">Common Questions</h2>
            <p class="text-gray-500 mt-4">Everything you need to know about the portal.</p>
        </div>

        <div class="space-y-4 stagger-children" data-animate>
            @for (int i = 0; i < Model.Count; i++)
            {
                var faq = Model[i];
                <div class="faq-item rounded-3xl border transition-all duration-300 bg-white border-gray-100 hover:border-blue-100 fade-up" data-animate>
                    <button onclick="toggleFaq(@i)"
                            class="w-full px-8 py-6 flex items-center justify-between text-left">
                        <span class="text-lg font-bold text-gray-900">@faq.Question</span>
                        <i data-lucide="chevron-down" class="w-5 h-5 text-gray-400 faq-icon"></i>
                    </button>
                    <div class="faq-content px-8 pb-8 hidden">
                        <p class="text-gray-600 leading-relaxed">@faq.Answer</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
