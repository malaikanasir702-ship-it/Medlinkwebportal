@model MedLinkPortal.Models.PatientDashboardModel
@{
    ViewData["Title"] = "All Medicines";
    Layout = "_DashboardLayout";
    var medicines  = ViewBag.AllMedicines  as List<MedLinkPortal.Models.Medicine> ?? new List<MedLinkPortal.Models.Medicine>();
    var brands     = ViewBag.Brands        as List<string> ?? new List<string>();
    var categories = ViewBag.Categories    as List<string> ?? new List<string>();
    string curSearch   = ViewBag.CurrentSearch   ?? "";
    string curBrand    = ViewBag.CurrentBrand    ?? "";
    string curCategory = ViewBag.CurrentCategory ?? "";
    string curSort     = ViewBag.CurrentSort     ?? "";
}

<div class="min-h-screen pb-20">
<div class="max-w-7xl mx-auto px-4 py-8">

    <!-- Page Header -->
    <div class="flex items-center gap-3 mb-8">
        <a href="/Pharmacy/Store" class="w-9 h-9 rounded-lg border border-slate-200 flex items-center justify-center text-slate-500 hover:border-slate-400 hover:text-slate-900 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold text-slate-900 tracking-tight">All Medicines</h1>
            <p class="text-sm text-slate-400 mt-0.5">@medicines.Count result@(medicines.Count == 1 ? "" : "s") found</p>
        </div>
    </div>

    <!-- Filter / Search Bar -->
    <form method="get" action="/Pharmacy/AllMedicines" id="filterForm">
        <div class="bg-white border border-slate-200 rounded-xl p-4 mb-6 flex flex-col md:flex-row gap-3 items-stretch md:items-center">

            <!-- Search -->
            <div class="relative flex-1 min-w-0">
                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                <input type="text" name="search" value="@curSearch"
                       placeholder="Search medicines, brands, symptoms..."
                       class="w-full pl-9 pr-4 py-2.5 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all"
                       onchange="document.getElementById('filterForm').submit()" />
            </div>

            <!-- Brand Filter -->
            <select name="brand" onchange="document.getElementById('filterForm').submit()"
                    class="py-2.5 px-3 border border-slate-200 rounded-lg text-sm text-slate-700 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none bg-white min-w-[150px]">
                <option value="">All Brands</option>
                @foreach (var b in brands)
                {
                    if (curBrand == b)
                    {
                        <option value="@b" selected="selected">@b</option>
                    }
                    else
                    {
                        <option value="@b">@b</option>
                    }
                }
            </select>

            <!-- Category Filter -->
            <select name="category" onchange="document.getElementById('filterForm').submit()"
                    class="py-2.5 px-3 border border-slate-200 rounded-lg text-sm text-slate-700 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none bg-white min-w-[150px]">
                <option value="">All Categories</option>
                @foreach (var c in categories)
                {
                    if (curCategory == c)
                    {
                        <option value="@c" selected="selected">@c</option>
                    }
                    else
                    {
                        <option value="@c">@c</option>
                    }
                }
            </select>

            <!-- Sort -->
            <select name="sort" onchange="document.getElementById('filterForm').submit()"
                    class="py-2.5 px-3 border border-slate-200 rounded-lg text-sm text-slate-700 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none bg-white min-w-[160px]">
                @{
                    var sortOptions = new[]
                    {
                        ("", "Sort: A → Z"),
                        ("name_desc", "Sort: Z → A"),
                        ("price_asc", "Price: Low → High"),
                        ("price_desc", "Price: High → Low"),
                    };
                }
                @foreach (var (val, label) in sortOptions)
                {
                    if (curSort == val)
                    {
                        <option value="@val" selected="selected">@label</option>
                    }
                    else
                    {
                        <option value="@val">@label</option>
                    }
                }
            </select>

            @* Hidden fields to preserve other params when any one changes *@
            @if (!string.IsNullOrEmpty(curSearch))   { <input type="hidden" name="_search_set"   value="1"> }
            @if (!string.IsNullOrEmpty(curBrand))    { <input type="hidden" name="_brand_set"    value="1"> }
            @if (!string.IsNullOrEmpty(curCategory)) { <input type="hidden" name="_cat_set"      value="1"> }

            @if (!string.IsNullOrEmpty(curSearch) || !string.IsNullOrEmpty(curBrand) || !string.IsNullOrEmpty(curCategory) || !string.IsNullOrEmpty(curSort))
            {
                <a href="/Pharmacy/AllMedicines"
                   class="inline-flex items-center gap-1.5 px-4 py-2.5 text-sm font-medium text-slate-500 border border-slate-200 rounded-lg hover:bg-slate-50 hover:text-slate-700 transition-colors whitespace-nowrap">
                    <i data-lucide="x" class="w-3.5 h-3.5"></i>
                    Clear
                </a>
            }
        </div>
    </form>

    <!-- Active Filters Pills -->
    @if (!string.IsNullOrEmpty(curBrand) || !string.IsNullOrEmpty(curCategory))
    {
        <div class="flex flex-wrap gap-2 mb-5">
            @if (!string.IsNullOrEmpty(curBrand))
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-blue-700 border border-blue-200 rounded-full text-xs font-semibold">
                    Brand: @curBrand
                    <a href="/Pharmacy/AllMedicines?search=@curSearch&category=@curCategory&sort=@curSort" class="hover:text-blue-900">×</a>
                </span>
            }
            @if (!string.IsNullOrEmpty(curCategory))
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 bg-blue-50 text-blue-700 border border-blue-200 rounded-full text-xs font-semibold">
                    Category: @curCategory
                    <a href="/Pharmacy/AllMedicines?search=@curSearch&brand=@curBrand&sort=@curSort" class="hover:text-blue-900">×</a>
                </span>
            }
        </div>
    }

    <!-- Results Grid -->
    @if (!medicines.Any())
    {
        <div class="bg-white border border-slate-200 rounded-xl p-16 text-center">
            <div class="w-16 h-16 bg-slate-50 border border-dashed border-slate-200 rounded-xl flex items-center justify-center mx-auto mb-5">
                <i data-lucide="pill" class="w-8 h-8 text-slate-300"></i>
            </div>
            <h3 class="text-lg font-semibold text-slate-900 mb-1">No medicines found</h3>
            <p class="text-sm text-slate-400 max-w-xs mx-auto">Try adjusting your filters or search terms.</p>
            <a href="/Pharmacy/AllMedicines" class="inline-flex items-center gap-2 mt-5 px-5 py-2.5 bg-slate-900 text-white rounded-lg text-sm font-medium hover:bg-black transition-colors">
                Clear Filters
            </a>
        </div>
    }
    else
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
            @foreach (var medicine in medicines)
            {
                <div class="bg-white rounded-xl p-4 border border-slate-100 shadow-sm hover:shadow-md hover:scale-[1.01] transition-all group relative overflow-hidden">

                    <!-- Stock Badge -->
                    <div class="absolute top-3 right-3 z-10">
                        @if ((medicine.StockQuantity ?? 0) > 0)
                        {
                            <span class="px-2 py-0.5 bg-emerald-50 text-emerald-600 text-[9px] font-bold uppercase tracking-wider rounded-full border border-emerald-100">In Stock</span>
                        }
                        else
                        {
                            <span class="px-2 py-0.5 bg-rose-50 text-rose-600 text-[9px] font-bold uppercase tracking-wider rounded-full border border-rose-100">Out</span>
                        }
                    </div>

                    <!-- Image -->
                    <a href="/Pharmacy/Details/@medicine.Id" class="block h-24 w-full bg-slate-50 rounded-lg mb-3 overflow-hidden">
                        @if (!string.IsNullOrEmpty(medicine.ImageUrl) && medicine.ImageUrl != "/images/medicines/default.png")
                        {
                            <img src="@medicine.ImageUrl" alt="@medicine.Name" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center">
                                <i data-lucide="pill" class="w-7 h-7 text-slate-200"></i>
                            </div>
                        }
                    </a>

                    <!-- Info -->
                    <a href="/Pharmacy/Details/@medicine.Id" class="block hover:text-blue-600 transition-colors">
                        <h3 class="text-xs font-semibold text-slate-900 line-clamp-2 leading-snug">@medicine.Name</h3>
                    </a>
                    <p class="text-[10px] text-slate-400 uppercase tracking-wider mt-1 mb-2 font-semibold line-clamp-1">@medicine.Brand</p>

                    <div class="flex items-center justify-between">
                        <p class="text-sm font-bold text-slate-900">PKR @((medicine.Price ?? 0).ToString("N0"))</p>
                        @if ((medicine.StockQuantity ?? 0) > 0)
                        {
                            <button onclick="addToCart(@medicine.Id, '@medicine.Name.Replace("'", "\\'")', @(medicine.Price ?? 0), '@(medicine.Brand?.Replace("'", "\\'") ?? "")', '@(medicine.ImageUrl ?? "")')"
                                    class="w-7 h-7 rounded-lg bg-slate-900 text-white flex items-center justify-center hover:bg-emerald-500 transition-all active:scale-95" title="Add to Cart">
                                <i data-lucide="plus" class="w-3 h-3"></i>
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }

</div>
</div>

<script>
    function addToCart(id, name, price, brand, imageUrl) {
        PharmacyCart.addItem({ id, name, price, brand, imageUrl });
    }

    document.addEventListener('DOMContentLoaded', () => {
        lucide.createIcons();

        // Live search — submit form on Enter or debounce
        const searchInput = document.querySelector('input[name="search"]');
        let debounceTimer;
        searchInput.addEventListener('input', () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                document.getElementById('filterForm').submit();
            }, 500);
        });
    });
</script>
