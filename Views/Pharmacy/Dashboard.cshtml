@using MedLinkPortal.Models
@model List<PharmacyOrder>
@{
    ViewData["Title"] = "Pharmacist Dashboard";
    Layout = "_PharmacistLayout";
}

<div class="min-h-screen bg-slate-50/50 pb-20">
    <div class="max-w-7xl mx-auto px-4 py-8 lg:py-12">
        <!-- Stats Header -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-10">
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-xl shadow-slate-200/50">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center">
                        <i data-lucide="shopping-cart" class="w-6 h-6"></i>
                    </div>
                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">New Orders</span>
                </div>
                <h3 class="text-3xl font-black text-slate-900">@Model.Count(o => o.Status == PharmacyOrderStatus.Pending)</h3>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-xl shadow-slate-200/50">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center">
                        <i data-lucide="pill" class="w-6 h-6"></i>
                    </div>
                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Low Stock</span>
                </div>
                <h3 class="text-3xl font-black text-slate-900">@ViewBag.LowStockCount</h3>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-xl shadow-slate-200/50">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center">
                        <i data-lucide="check-circle-2" class="w-6 h-6"></i>
                    </div>
                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Fulfilled Today</span>
                </div>
                <h3 class="text-3xl font-black text-slate-900">@Model.Count(o => o.Status == PharmacyOrderStatus.Delivered && o.CreatedAt.Date == DateTime.Today)</h3>
            </div>
            <div class="bg-white p-8 rounded-[2rem] border border-slate-100 shadow-xl shadow-slate-200/50">
                <div class="flex items-center gap-4 mb-4">
                    <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-2xl flex items-center justify-center">
                        <i data-lucide="wallet" class="w-6 h-6"></i>
                    </div>
                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Monthly Revenue</span>
                </div>
                <h3 class="text-3xl font-black text-slate-900">PKR @Model.Where(o => o.Status == PharmacyOrderStatus.Delivered && o.CreatedAt.Month == DateTime.Now.Month).Sum(o => o.TotalAmount).ToString("N0")</h3>
            </div>
        </div>

        <div class="flex flex-col lg:flex-row gap-10">
            <!-- Order Queue -->
            <div class="flex-1">
                <div class="flex items-center justify-between mb-8">
                    <h2 class="text-xl font-black text-slate-900 tracking-tight">Active Fulfillment Queue</h2>
                    <div class="flex gap-2">
                        <button class="px-4 py-2 bg-white border border-slate-100 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-50 transition-all">Filter</button>
                    </div>
                </div>

                <div class="space-y-4">
                    @foreach (var order in Model.OrderByDescending(o => o.CreatedAt))
                    {
                        <div class="bg-white p-6 md:p-8 rounded-[2.5rem] border border-slate-100 shadow-lg hover:shadow-xl transition-all group overflow-hidden relative">
                            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 relative z-10">
                                <div>
                                    <div class="flex items-center gap-3 mb-2">
                                        <span class="text-xs font-black text-blue-600 tracking-widest">#ORD-@order.Id.ToString("D5")</span>
                                        @{
                                            string badgeClass = order.Status switch
                                            {
                                                PharmacyOrderStatus.Pending => "bg-amber-50 text-amber-600 border-amber-100",
                                                PharmacyOrderStatus.Accepted => "bg-blue-50 text-blue-600 border-blue-100",
                                                PharmacyOrderStatus.Delivered => "bg-emerald-50 text-emerald-600 border-emerald-100",
                                                _ => "bg-slate-50 text-slate-600 border-slate-100"
                                            };
                                        }
                                        <span class="px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-widest border @badgeClass">@order.Status</span>
                                    </div>
                                    <h4 class="font-black text-slate-900 text-lg">Patient ID: @order.PatientId.Substring(0, 8)...</h4>
                                    <p class="text-xs font-bold text-slate-400 mt-1"><i data-lucide="map-pin" class="w-3 h-3 inline-block mr-1"></i> @order.ShippingAddress</p>
                                </div>
                                <div class="flex flex-col items-end gap-3 text-right">
                                    <p class="text-2xl font-black text-slate-900">PKR @order.TotalAmount.ToString("N0")</p>
                                    <div class="flex gap-2">
                                        @if (order.Status == PharmacyOrderStatus.Pending)
                                        {
                                            <button onclick="updateOrderStatus(@order.Id, 1)" class="px-6 py-2.5 bg-emerald-600 text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-emerald-700 shadow-lg shadow-emerald-500/20 active:scale-95 transition-all">Accept Order</button>
                                        }
                                        else if (order.Status == PharmacyOrderStatus.Accepted)
                                        {
                                            <button onclick="updateOrderStatus(@order.Id, 2)" class="px-6 py-2.5 bg-violet-600 text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-violet-700 shadow-lg shadow-violet-500/20 active:scale-95 transition-all">Mark Packed</button>
                                        }
                                        else if (order.Status == PharmacyOrderStatus.Packed)
                                        {
                                            <button onclick="openAssignRider(@order.Id)" class="px-6 py-2.5 bg-blue-600 text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-blue-700 shadow-lg shadow-blue-500/20 active:scale-95 transition-all">🏍 Assign Rider</button>
                                        }
                                        else if (order.Status == PharmacyOrderStatus.OnTheWay)
                                        {
                                            <button onclick="updateOrderStatus(@order.Id, 6)" class="px-6 py-2.5 bg-slate-900 text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-black shadow-lg shadow-black/20 active:scale-95 transition-all">Mark Delivered</button>
                                        }
                                        <a href="/Pharmacy/OrderDetails/@order.Id" class="p-2.5 bg-slate-50 text-slate-400 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition-all border border-slate-100">
                                            <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="absolute -right-20 -bottom-20 w-64 h-64 bg-slate-50 rounded-full -z-0 group-hover:bg-blue-50 transition-colors"></div>
                        </div>
                    }
                </div>
            </div>

            <!-- Sidebar -->
            <div class="w-full lg:w-80 space-y-8">
                <div class="bg-slate-900 rounded-[2.5rem] p-8 md:p-10 text-white shadow-2xl relative overflow-hidden">
                    <h3 class="text-xs font-black text-white/40 uppercase tracking-widest mb-6">Inventory Management</h3>
                    <div class="space-y-6 relative z-10">
                        <p class="text-[10px] font-bold text-white/60 leading-relaxed uppercase tracking-widest">Direct controls for medical inventory and stock auditing.</p>
                        <a href="/Pharmacy/Inventory" class="block w-full py-4 bg-emerald-600 text-white font-black text-xs rounded-2xl hover:bg-emerald-700 shadow-xl shadow-emerald-600/10 text-center transition-all">Access Inventory CMS</a>
                        <button class="w-full py-4 bg-white/5 text-white font-black text-xs rounded-2xl border border-white/10 hover:bg-white/10 transition-all">Run Stock Audit</button>
                    </div>
                </div>

                <div class="bg-white rounded-[2.5rem] p-8 md:p-10 border border-slate-100 shadow-xl">
                    <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-6">Recent Activities</h3>
                    <div class="space-y-6">
                        <div class="flex gap-4">
                            <div class="w-1.5 h-10 bg-emerald-500 rounded-full shrink-0"></div>
                            <div>
                                <p class="text-sm font-bold text-slate-900">Order #0024 Fulfilled</p>
                                <p class="text-[10px] font-bold text-slate-400 mt-1">10 minutes ago</p>
                            </div>
                        </div>
                        <div class="flex gap-4">
                            <div class="w-1.5 h-10 bg-amber-500 rounded-full shrink-0"></div>
                            <div>
                                <p class="text-sm font-bold text-slate-900">Low Stock: Panadol</p>
                                <p class="text-[10px] font-bold text-slate-400 mt-1">1 hour ago</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function updateOrderStatus(orderId, status) {
        if(!confirm("Update order status? This will notify the patient.")) return;

        const res = await fetch('/Pharmacy/UpdateOrderStatus', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId, status })
        });

        const data = await res.json();
        if(data.success) {
            window.location.reload();
        } else {
            alert("Error: " + data.message);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) {
            lucide.createIcons();
        }
    });
</script>

<!-- Assign Rider Modal (Task 6.5) -->
<div id="assignRiderModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50">
    <div class="bg-white rounded-3xl shadow-2xl p-8 w-full max-w-md mx-4">
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-black text-slate-900">🏍️ Assign Rider</h3>
            <button onclick="closeAssignRider()" class="text-slate-400 hover:text-slate-700 text-xl font-bold">✕</button>
        </div>

        <p class="text-sm text-slate-500 mb-4">Select an available rider for Order <strong id="modalOrderId"></strong></p>

        <div id="ridersList" class="space-y-2 mb-6 max-h-60 overflow-y-auto">
            <p class="text-sm text-slate-400 text-center py-4">Loading riders...</p>
        </div>

        <div class="flex gap-3">
            <button onclick="closeAssignRider()"
                    class="flex-1 py-3 bg-slate-100 text-slate-700 font-bold text-sm rounded-xl hover:bg-slate-200 transition-all">
                Cancel
            </button>
            <button id="confirmAssignBtn" onclick="confirmAssignRider()" disabled
                    class="flex-1 py-3 bg-blue-600 text-white font-bold text-sm rounded-xl hover:bg-blue-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all">
                Assign Rider
            </button>
        </div>
    </div>
</div>

<script>
    let _currentOrderId = null;
    let _selectedRiderId = null;

    async function openAssignRider(orderId) {
        _currentOrderId = orderId;
        _selectedRiderId = null;
        document.getElementById('modalOrderId').textContent = `#ORD-${String(orderId).padStart(5,'0')}`;
        document.getElementById('confirmAssignBtn').disabled = true;
        document.getElementById('assignRiderModal').classList.remove('hidden');

        const res = await fetch('/Pharmacy/AvailableRiders');
        const riders = await res.json();
        const container = document.getElementById('ridersList');

        if (!riders.length) {
            container.innerHTML = '<p class="text-sm text-slate-400 text-center py-4">No available riders right now.</p>';
            return;
        }

        container.innerHTML = riders.map(r => `
            <div onclick="selectRider(${r.id}, this)"
                 class="flex items-center gap-3 p-3 rounded-xl border border-slate-100 cursor-pointer hover:border-blue-300 hover:bg-blue-50 transition-all"
                 data-rider-id="${r.id}">
                <div class="w-9 h-9 bg-blue-600 rounded-xl flex items-center justify-center text-white font-black text-sm">
                    ${r.name.charAt(0).toUpperCase()}
                </div>
                <div class="flex-1">
                    <p class="font-bold text-slate-900 text-sm">${r.name}</p>
                    <p class="text-xs text-slate-400">${r.vehicleType} · ${r.vehicleNumber || '—'}</p>
                </div>
                <span class="text-xs font-bold text-emerald-600">Available</span>
            </div>
        `).join('');
    }

    function selectRider(riderId, el) {
        document.querySelectorAll('#ridersList [data-rider-id]').forEach(d => {
            d.classList.remove('border-blue-500', 'bg-blue-50');
            d.classList.add('border-slate-100');
        });
        el.classList.add('border-blue-500', 'bg-blue-50');
        el.classList.remove('border-slate-100');
        _selectedRiderId = riderId;
        document.getElementById('confirmAssignBtn').disabled = false;
    }

    async function confirmAssignRider() {
        if (!_selectedRiderId || !_currentOrderId) return;
        const btn = document.getElementById('confirmAssignBtn');
        btn.textContent = 'Assigning...'; btn.disabled = true;

        const res = await fetch('/Pharmacy/AssignRider', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orderId: _currentOrderId, orderType: 'PharmacyOrder', riderId: _selectedRiderId })
        });
        const data = await res.json();
        if (data.success) {
            closeAssignRider();
            window.location.reload();
        } else {
            alert('Error: ' + (data.message || 'Failed to assign rider'));
            btn.textContent = 'Assign Rider'; btn.disabled = false;
        }
    }

    function closeAssignRider() {
        document.getElementById('assignRiderModal').classList.add('hidden');
        _currentOrderId = null; _selectedRiderId = null;
    }
</script>
