@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Consultation History";
    var today = DateTime.Today;
    
    // Calculate stats
    var totalSessions = Model.UpcomingConsultations.Count();
    var completedSessions = Model.UpcomingConsultations.Count(c => c.Status == "Completed" || (c.RawDate.HasValue && c.RawDate.Value.Date < today));
    var scheduledToday = Model.UpcomingConsultations.Count(c => c.RawDate.HasValue && c.RawDate.Value.Date == today && c.Status != "Cancelled");
}

<div class="space-y-6 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <!-- Premium Stats Header -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="relative overflow-hidden bg-white p-8 rounded-[2.5rem] border border-gray-100 shadow-sm group hover:shadow-2xl hover:shadow-blue-900/5 transition-all duration-500">
            <div class="absolute top-0 right-0 p-8 opacity-[0.03] group-hover:scale-110 transition-transform duration-700">
                <i data-lucide="layers" class="w-24 h-24 text-blue-600"></i>
            </div>
            <div class="relative z-10 flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-[0.2em] mb-2">Total Archive</p>
                    <h4 class="text-4xl font-semibold text-gray-900 tracking-tight">@totalSessions</h4>
                </div>
                <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-600 shadow-inner group-hover:bg-blue-600 group-hover:text-white transition-all duration-500">
                    <i data-lucide="calendar-check" class="w-7 h-7"></i>
                </div>
            </div>
        </div>

        <div class="relative overflow-hidden bg-white p-8 rounded-[2.5rem] border border-gray-100 shadow-sm group hover:shadow-2xl hover:shadow-emerald-900/5 transition-all duration-500">
            <div class="absolute top-0 right-0 p-8 opacity-[0.03] group-hover:scale-110 transition-transform duration-700">
                <i data-lucide="check-circle" class="w-24 h-24 text-emerald-600"></i>
            </div>
            <div class="relative z-10 flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-[0.2em] mb-2">Successfully Closed</p>
                    <h4 class="text-4xl font-semibold text-emerald-600 tracking-tight">@completedSessions</h4>
                </div>
                <div class="w-14 h-14 bg-emerald-50 rounded-2xl flex items-center justify-center text-emerald-600 shadow-inner group-hover:bg-emerald-600 group-hover:text-white transition-all duration-500">
                    <i data-lucide="check-circle-2" class="w-7 h-7"></i>
                </div>
            </div>
        </div>

        <div class="relative overflow-hidden bg-white p-8 rounded-[2.5rem] border border-gray-100 shadow-sm group hover:shadow-2xl hover:shadow-amber-900/5 transition-all duration-500">
            <div class="absolute top-0 right-0 p-8 opacity-[0.03] group-hover:scale-110 transition-transform duration-700">
                <i data-lucide="clock" class="w-24 h-24 text-amber-500"></i>
            </div>
            <div class="relative z-10 flex items-center justify-between">
                <div>
                    <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-[0.2em] mb-2">Active Today</p>
                    <h4 class="text-4xl font-semibold text-amber-500 tracking-tight">@scheduledToday</h4>
                </div>
                <div class="w-14 h-14 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-500 shadow-inner group-hover:bg-amber-500 group-hover:text-white transition-all duration-500">
                    <i data-lucide="activity" class="w-7 h-7"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Enhanced History Section -->
    <div class="bg-white rounded-[3rem] border border-gray-100 shadow-sm border-b-4 border-b-gray-50 mb-10" x-data="{ filter: 'all' }">
        <div class="p-10 border-b border-gray-50 flex flex-col sm:flex-row sm:items-center justify-between gap-6 bg-gradient-to-b from-gray-50/30 to-transparent">
            <div>
                <div class="flex items-center gap-3">
                    <div class="w-2 h-8 bg-blue-600 rounded-full"></div>
                    <h3 class="text-2xl font-semibold text-gray-900 tracking-tight">Clinical Consultation Logs</h3>
                </div>
                <p class="text-[11px] text-gray-400 font-bold mt-2 uppercase tracking-[0.15em] ml-5">Comprehensive archive of your medical session history</p>
            </div>
            <div class="flex items-center gap-2 bg-gray-50/80 p-1.5 rounded-2xl border border-gray-100 inline-flex self-start sm:self-center">
                 <button @@click="filter = 'all'" 
                         :class="filter === 'all' ? 'bg-white shadow-xl shadow-blue-900/5 text-blue-600' : 'text-gray-400 hover:text-blue-600'"
                         class="px-6 py-2.5 rounded-xl text-[11px] font-semibold uppercase tracking-widest border border-transparent transition-all">All History</button>
                 <button @@click="filter = 'past'" 
                         :class="filter === 'past' ? 'bg-white shadow-xl shadow-blue-900/5 text-blue-600' : 'text-gray-400 hover:text-blue-600'"
                         class="px-6 py-2.5 rounded-xl text-[11px] font-semibold uppercase tracking-widest border border-transparent transition-all">Past Only</button>
            </div>
        </div>

        <div class="divide-y divide-gray-50">
            @if (!Model.UpcomingConsultations.Any())
            {
                <div class="p-32 text-center flex flex-col items-center gap-6">
                    <div class="relative">
                        <div class="w-28 h-28 bg-gray-50 rounded-[2.5rem] flex items-center justify-center text-gray-200 rotate-3">
                             <i data-lucide="archive-x" class="w-12 h-12"></i>
                        </div>
                        <div class="absolute -top-2 -right-2 w-8 h-8 bg-white border border-gray-100 rounded-full flex items-center justify-center text-gray-300 shadow-sm animate-bounce">
                            <i data-lucide="search" class="w-4 h-4"></i>
                        </div>
                    </div>
                    <div>
                        <h4 class="text-xl font-semibold text-gray-900 tracking-tight">Vault is Empty</h4>
                        <p class="text-gray-400 text-xs font-bold uppercase tracking-widest mt-2 max-w-[280px] leading-relaxed">Your digital health interactions will appear here once archived.</p>
                    </div>
                    <a href="@Url.Action("Doctors", "Dashboard")" class="mt-6 px-10 py-4 bg-gray-900 text-white font-semibold rounded-[2rem] text-[11px] uppercase tracking-widest shadow-2xl shadow-gray-900/20 hover:bg-gray-800 hover:scale-105 active:scale-95 transition-all">Initialize Booking</a>
                </div>
            }
            else
            {
                @foreach (var consult in Model.UpcomingConsultations.OrderByDescending(c => c.RawDate))
                {
                    bool isToday = consult.RawDate.HasValue && consult.RawDate.Value.Date == today;
                    bool isPast = consult.RawDate.HasValue && consult.RawDate.Value.Date < today;
                    bool isFuture = consult.RawDate.HasValue && consult.RawDate.Value.Date > today;
                    bool isFinished = consult.Status == "Completed" || consult.Status == "Cancelled";
                    bool canJoin = isToday && !isFinished;
                    
                    var rowFilterState = isPast || isFinished ? "past" : "upcoming";

                    <div id="consultation-row-@consult.Id" 
                         x-show="filter === 'all' || (filter === 'past' && '@rowFilterState' === 'past')"
                         class="group p-8 hover:bg-gray-50/50 transition-all duration-500 flex flex-col lg:flex-row items-center justify-between gap-8 relative">
                        <!-- Left: Doctor Info -->
                        <div class="flex items-center gap-6 flex-1 w-full lg:w-auto">
                             <div class="relative group/img">
                                 <div class="absolute inset-0 bg-blue-600 rounded-[2rem] rotate-6 scale-95 opacity-0 group-hover/img:opacity-10 group-hover/img:rotate-12 transition-all duration-700"></div>
                                 <img src="@consult.Image" class="w-20 h-20 rounded-[2rem] object-cover shadow-xl border-4 border-white relative z-10 transition-transform duration-700 group-hover/img:scale-105">
                                 @if (isToday && !isFinished)
                                 {
                                     <div class="absolute -bottom-1 -right-1 bg-emerald-500 border-4 border-white w-6 h-6 rounded-full z-20 shadow-md">
                                         <div class="absolute inset-0 bg-emerald-400 rounded-full animate-ping opacity-75"></div>
                                     </div>
                                 }
                             </div>
                             <div>
                                 <div class="flex items-center gap-3 mb-1.5">
                                     <h4 class="text-xl font-semibold text-gray-900 tracking-tight">@consult.Doctor</h4>
                                     @if (isToday)
                                     {
                                         <span class="px-2.5 py-1 bg-amber-50 text-amber-600 text-[9px] font-semibold uppercase tracking-widest rounded-lg border border-amber-100 flex items-center gap-1.5">
                                             <span class="w-1.5 h-1.5 bg-amber-500 rounded-full animate-pulse"></span> Today
                                         </span>
                                     }
                                 </div>
                                 <div class="flex flex-wrap items-center gap-4">
                                     <span class="text-[11px] font-semibold text-blue-600 bg-blue-50/80 border border-blue-100 px-3 py-1 rounded-xl uppercase tracking-wider shadow-sm">@consult.Specialty</span>
                                     <div class="flex items-center gap-4 text-gray-400">
                                         <span class="text-[10px] font-semibold uppercase tracking-widest flex items-center gap-2">
                                             <i data-lucide="calendar" class="w-4 h-4 text-gray-300"></i> @(consult.RawDate?.ToString("MMM dd, yyyy") ?? "Not Set")
                                         </span>
                                         <span class="text-[10px] font-semibold uppercase tracking-widest flex items-center gap-2">
                                             <i data-lucide="clock" class="w-4 h-4 text-gray-300"></i> @(consult.Time ?? "Scheduled")
                                         </span>
                                     </div>
                                 </div>
                             </div>
                        </div>

                        <!-- Right: Actions & Status -->
                        <div class="flex items-center gap-8 w-full lg:w-auto border-t lg:border-t-0 pt-6 lg:pt-0 justify-between">
                            <div class="text-right hidden sm:block">
                                <p class="text-[9px] font-semibold text-gray-400 uppercase tracking-[0.2em] mb-1 opacity-60">Identity Ref</p>
                                <p class="text-[11px] font-semibold text-gray-900 bg-gray-50 px-3 py-1 rounded-lg border border-gray-100">#MED-@(consult.Id)X7P</p>
                            </div>

                            <div class="flex items-center gap-4 relative" x-data="{ open: false }" @@click.away="open = false">
                                 @if (canJoin)
                                 {
                                     if (consult.Type == "Physical")
                                     {
                                         <div class="flex flex-col items-end gap-2">
                                             <a href="@Url.Action("ClinicVisitDetails", "Dashboard", new { id = consult.Id })" 
                                                class="px-6 py-3 bg-emerald-50 text-emerald-600 rounded-xl text-[10px] font-semibold uppercase tracking-wider border border-emerald-100 flex items-center gap-2 hover:bg-emerald-600 hover:text-white transition-all shadow-sm">
                                                 <i data-lucide="building-2" class="w-4 h-4"></i>
                                                 <span>Visit Clinic Today</span>
                                             </a>
                                             <p class="text-[10px] font-bold text-gray-400 italic">@(consult.Specialty) Clinic</p>
                                         </div>
                                     }
                                     else
                                     {
                                         <a href="@Url.Action("ConsultationRoom", "Dashboard", new { id = consult.Id })" 
                                            class="group/btn px-10 py-4 bg-blue-600 text-white rounded-[1.5rem] text-[11px] font-semibold uppercase tracking-[0.15em] hover:bg-blue-700 hover:scale-[1.03] active:scale-95 transition-all shadow-2xl shadow-blue-500/20 flex items-center gap-3">
                                             <span>Join Room</span>
                                             <i data-lucide="arrow-right" class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform"></i>
                                         </a>
                                     }
                                 }
                                 else if (consult.Status == "Cancelled")
                                 {
                                     <div onclick="showRestrictedModal('completed', '@consult.Doctor')" class="px-10 py-4 bg-rose-50 text-rose-500 rounded-[1.5rem] text-[11px] font-semibold uppercase tracking-[0.15em] border border-rose-100 flex items-center gap-3 opacity-80 cursor-pointer hover:bg-rose-100 transition-all">
                                         <i data-lucide="slash" class="w-4 h-4"></i>
                                         <span>Cancelled</span>
                                     </div>
                                 }
                                 else if (isFinished || isPast)
                                 {
                                     <div onclick="showRestrictedModal('completed', '@consult.Doctor')" class="px-10 py-4 bg-emerald-50 text-emerald-600 rounded-[1.5rem] text-[11px] font-semibold uppercase tracking-[0.15em] border border-emerald-100 flex items-center gap-3 shadow-sm shadow-emerald-900/5 cursor-pointer hover:bg-emerald-600 hover:text-white transition-all">
                                         <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                                         <span>Completed</span>
                                     </div>
                                 }
                                 else
                                 {
                                     if (consult.Type == "Physical")
                                     {
                                         <div onclick="showRestrictedModal('physical', '@consult.Doctor')" class="px-6 py-3 bg-gray-50 text-gray-400 rounded-xl text-[10px] font-semibold uppercase tracking-wider border border-gray-100 flex items-center gap-2 cursor-pointer hover:bg-blue-50 hover:text-blue-600 transition-all">
                                             <i data-lucide="map-pin" class="w-4 h-4"></i>
                                             <span>In-Person Visit</span>
                                         </div>
                                     }
                                     else
                                     {
                                         <div onclick="showRestrictedModal('upcoming', '@consult.Doctor', '@(consult.RawDate?.ToString("MMM dd"))')" class="px-10 py-4 bg-gray-50 text-gray-400 rounded-[1.5rem] text-[11px] font-semibold uppercase tracking-[0.15em] border border-gray-100 flex items-center gap-3 shadow-sm cursor-pointer hover:bg-amber-50 hover:text-amber-600 transition-all">
                                             <i data-lucide="hourglass" class="w-4 h-4"></i>
                                             <span>Upcoming</span>
                                         </div>
                                     }
                                 }

                                 <button @@click="open = !open" 
                                         class="p-4 bg-white border border-gray-100 text-gray-400 rounded-[1.5rem] hover:text-blue-600 hover:bg-blue-50 hover:border-blue-100 transition-all shadow-sm group-hover:shadow-md">
                                      <i data-lucide="more-horizontal" class="w-6 h-6"></i>
                                 </button>
                                 
                                 <!-- Dropdown Menu -->
                                 <div x-show="open" 
                                      x-transition:enter="transition ease-out duration-300"
                                      x-transition:enter-start="transform opacity-0 translate-y-4 scale-95"
                                      x-transition:enter-end="transform opacity-100 translate-y-0 scale-100"
                                      class="absolute right-0 top-full mt-4 w-72 bg-white border border-gray-100 rounded-[2.5rem] shadow-[0_20px_50px_rgba(0,0,0,0.1)] z-[100] overflow-hidden py-3 divide-y divide-gray-50 origin-top-right backdrop-blur-xl bg-white/95">
                                     
                                     <a href="@Url.Action("DownloadInvoice", "Dashboard", new { id = consult.Id })" target="_blank" class="flex items-center justify-between px-6 py-4 hover:bg-blue-50/50 group/item transition-all">
                                         <div class="flex items-center gap-4">
                                             <div class="w-10 h-10 bg-gray-50 rounded-xl flex items-center justify-center text-gray-400 group-hover/item:bg-blue-600 group-hover/item:text-white transition-all">
                                                 <i data-lucide="file-text" class="w-4 h-4"></i>
                                             </div>
                                             <span class="text-[12px] font-semibold text-gray-700 group-hover/item:text-blue-600">Financial Invoice</span>
                                         </div>
                                         <i data-lucide="chevron-right" class="w-4 h-4 text-gray-300 group-hover/item:text-blue-600"></i>
                                     </a>
                                     
                                     <a href="@Url.Action("Messages", "Dashboard", new { doctorId = consult.DoctorId })" class="flex items-center justify-between px-6 py-4 hover:bg-blue-50/50 group/item transition-all">
                                         <div class="flex items-center gap-4">
                                             <div class="w-10 h-10 bg-gray-50 rounded-xl flex items-center justify-center text-gray-400 group-hover/item:bg-blue-600 group-hover/item:text-white transition-all">
                                                 <i data-lucide="message-square" class="w-4 h-4"></i>
                                             </div>
                                             <span class="text-[12px] font-semibold text-gray-700 group-hover/item:text-blue-600">Message Provider</span>
                                         </div>
                                         <i data-lucide="chevron-right" class="w-4 h-4 text-gray-300 group-hover/item:text-blue-600"></i>
                                     </a>
                                     
                                     <a href="@Url.Action("DoctorProfile", "Dashboard", new { id = consult.DoctorId })" class="flex items-center justify-between px-6 py-4 hover:bg-blue-50/50 group/item transition-all">
                                         <div class="flex items-center gap-4">
                                             <div class="w-10 h-10 bg-gray-50 rounded-xl flex items-center justify-center text-gray-400 group-hover/item:bg-blue-600 group-hover/item:text-white transition-all">
                                                 <i data-lucide="user" class="w-4 h-4"></i>
                                             </div>
                                             <span class="text-[12px] font-semibold text-gray-700 group-hover/item:text-blue-600">Archive Profile</span>
                                         </div>
                                         <i data-lucide="chevron-right" class="w-4 h-4 text-gray-300 group-hover/item:text-blue-600"></i>
                                     </a>
                                     
                                     @if (!isFinished && !isPast)
                                     {
                                         <div class="bg-rose-50/30 p-2 m-2 rounded-[1.5rem]">
                                             <button onclick="cancelAppointment(@consult.Id)" class="w-full flex items-center gap-4 px-4 py-3 text-[12px] font-semibold text-rose-500 hover:bg-rose-500 hover:text-white rounded-xl transition-all">
                                                 <div class="w-8 h-8 bg-rose-50 rounded-lg flex items-center justify-center border border-rose-100">
                                                     <i data-lucide="slash" class="w-4 h-4"></i>
                                                 </div>
                                                 <span>Terminate Session</span>
                                             </button>
                                         </div>
                                     }
                                 </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Restricted Access Modal -->
<div id="restrictedModal" class="hidden fixed inset-0 z-[110] flex items-center justify-center p-4 bg-gray-900/60 backdrop-blur-md animate-in fade-in duration-300">
    <div class="bg-white rounded-[2.5rem] w-full max-w-md overflow-hidden shadow-2xl relative animate-in zoom-in slide-in-from-bottom-4 duration-500">
        <!-- Header Pattern -->
        <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-br from-blue-600 to-indigo-700 opacity-5"></div>
        <div class="absolute top-0 right-0 p-8 opacity-[0.03]">
            <i data-lucide="shield-alert" class="w-32 h-32 text-blue-600"></i>
        </div>

        <div class="relative p-10 text-center">
            <!-- Icon Stage -->
            <div id="restrictedIconContainer" class="w-24 h-24 mx-auto mb-8 rounded-[2rem] bg-blue-50 flex items-center justify-center text-blue-600 shadow-inner relative group">
                <div class="absolute inset-0 bg-blue-400 rounded-[2rem] animate-ping opacity-20 group-hover:opacity-40 transition-opacity"></div>
                <i id="restrictedIcon" data-lucide="lock" class="w-10 h-10 relative z-10 transition-transform group-hover:scale-110"></i>
            </div>

            <!-- Content -->
            <h3 id="restrictedTitle" class="text-2xl font-semibold text-gray-900 tracking-tight mb-3">Room Access Locked</h3>
            <p id="restrictedMessage" class="text-sm text-gray-500 font-medium leading-relaxed mb-10 px-4">
                This consultation session is currently unavailable for digital entry based on clinical status.
            </p>

            <!-- Buttons -->
            <div class="space-y-3">
                <button onclick="closeRestrictedModal()" class="w-full py-4 bg-gray-900 text-white rounded-2xl font-semibold text-[11px] uppercase tracking-widest shadow-xl shadow-gray-900/20 hover:bg-gray-800 transition-all active:scale-95">
                    Acknowledge Protocol
                </button>
            </div>
        </div>

        <!-- Footer Info -->
        <div class="bg-gray-50/80 border-t border-gray-100 p-4 text-center">
            <p class="text-[9px] font-semibold text-gray-400 uppercase tracking-[0.2em] flex items-center justify-center gap-2">
                <i data-lucide="shield-check" class="w-3 h-3"></i>
                Security Architecture Verified
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function cancelAppointment(id) {
            const confirmed = await PremiumModal.confirm('Are you sure you want to cancel this appointment? This action cannot be undone.', 'Cancel Appointment?');
            if (!confirmed) return;

            try {
                const response = await fetch(`/Dashboard/CancelAppointment/${id}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                });

                const result = await response.json();

                if (result.success) {
                    const row = document.getElementById(`consultation-row-${id}`);
                    if (row) {
                        row.classList.add('opacity-0', '-translate-x-full', 'transition-all', 'duration-500');
                        setTimeout(() => {
                            row.remove();
                            if (document.querySelectorAll('[id^="consultation-row-"]').length === 0) {
                                location.reload();
                            }
                        }, 500);
                    }
                    if (typeof showToast === 'function') {
                        showToast('Appointment cancelled successfully', 'info');
                    }
                } else {
                    await PremiumModal.error(result.message || 'Error cancelling appointment', 'Request Canceled');
                }
            } catch (err) {
                console.error('Error:', err);
                await PremiumModal.error('An unexpected protocol error occurred while terminating the session.', 'Sync Error');
            }
        }

        function showRestrictedModal(type, doctor, date = '') {
            const modal = document.getElementById('restrictedModal');
            const icon = document.getElementById('restrictedIcon');
            const container = document.getElementById('restrictedIconContainer');
            const title = document.getElementById('restrictedTitle');
            const message = document.getElementById('restrictedMessage');

            // Reset
            container.className = 'w-24 h-24 mx-auto mb-8 rounded-[2rem] flex items-center justify-center shadow-inner relative group';

            if (type === 'completed') {
                title.innerText = 'Session Completed';
                message.innerText = `The clinical consultation with Dr. ${doctor} has already been concluded and archived in your history.`;
                icon.setAttribute('data-lucide', 'check-circle-2');
                container.classList.add('bg-emerald-50', 'text-emerald-600');
            } else if (type === 'upcoming') {
                title.innerText = 'Upcoming Protocol';
                message.innerText = `Your session with Dr. ${doctor} is scheduled for ${date}. Communication channels will initialize strictly on the appointment date.`;
                icon.setAttribute('data-lucide', 'clock');
                container.classList.add('bg-amber-50', 'text-amber-600');
            } else if (type === 'physical') {
                title.innerText = 'Physical Visit Required';
                message.innerText = `This is a physical in-person consultation at Dr. ${doctor}'s clinic. No digital room is required for this protocol.`;
                icon.setAttribute('data-lucide', 'building-2');
                container.classList.add('bg-blue-50', 'text-blue-600');
            }

            modal.classList.remove('hidden');
            lucide.createIcons();
        }

        function closeRestrictedModal() {
            const modal = document.getElementById('restrictedModal');
            modal.classList.add('opacity-0', 'scale-95', 'transition-all', 'duration-300');
            setTimeout(() => {
                modal.classList.add('hidden');
                modal.classList.remove('opacity-0', 'scale-95');
            }, 300);
        }
    </script>
}
