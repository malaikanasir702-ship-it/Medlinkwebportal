@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Secure Checkout";
    var tests = ViewBag.Tests as List<MedLinkPortal.Models.MedicalTest>;
    var total = ViewBag.Total;
    var labId = ViewBag.LaboratoryId;
}

<div class="max-w-7xl mx-auto py-12 px-4 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <!-- Header -->
    <div class="mb-12">
        <div class="flex items-center gap-3 mb-4">
            <a href="javascript:history.back()" class="p-3 bg-slate-100 hover:bg-slate-200 text-slate-500 rounded-2xl transition-all active:scale-90">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
            </a>
            <div class="h-px flex-1 bg-slate-100"></div>
            <div class="flex items-center gap-2 px-4 py-1.5 bg-blue-50 text-blue-600 rounded-full text-[10px] font-black tracking-widest uppercase border border-blue-100">
                <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
                Secure Booking
            </div>
        </div>
        <h1 class="text-4xl md:text-5xl font-black text-slate-900 tracking-tight">Patient <span class="text-blue-600">Verification.</span></h1>
        <p class="text-slate-500 font-medium text-lg mt-2">Complete the details below to finalize your laboratory appointment.</p>
    </div>

    <div class="flex flex-col lg:flex-row gap-12">
        <!-- Main: Form -->
        <div class="flex-1">
            <div class="bg-white/40 backdrop-blur-xl rounded-[3rem] p-8 md:p-12 border border-white shadow-2xl relative overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-blue-50/50 rounded-full -mr-32 -mt-32 blur-3xl pointer-events-none"></div>
                
                <form asp-action="ConfirmBooking" method="post" class="relative z-10 space-y-12">
                    <input type="hidden" name="LaboratoryId" value="@labId" />
                    <input type="hidden" name="testIds" value="@string.Join(",", tests.Select(t => t.Id))" />

                    <!-- Section: Personal Info -->
                    <div class="space-y-8">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-blue-600 text-white rounded-2xl flex items-center justify-center shadow-lg shadow-blue-500/20">
                                <i data-lucide="user" class="w-6 h-6"></i>
                            </div>
                            <h3 class="text-2xl font-black text-slate-900 tracking-tight">Identity Details</h3>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-neutral-50">
                            <div class="space-y-3">
                                <label class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] ml-1">Patient Full Name</label>
                                <div class="relative group">
                                    <input type="text" name="PatientName" value="@Model.PatientName" required 
                                           class="w-full pl-14 pr-6 py-5 bg-white border-2 border-slate-100 focus:border-blue-500 rounded-[1.5rem] font-bold text-slate-900 shadow-sm transition-all outline-none" 
                                           placeholder="Enter full name" />
                                    <i data-lucide="user-plus" class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-blue-600 transition-colors w-5 h-5"></i>
                                </div>
                            </div>
                            <div class="space-y-3">
                                <label class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] ml-1">Contact Number</label>
                                <div class="relative group">
                                    <input type="tel" name="PhoneNumber" value="@Model.Phone" required 
                                           class="w-full pl-14 pr-6 py-5 bg-white border-2 border-slate-100 focus:border-blue-500 rounded-[1.5rem] font-bold text-slate-900 shadow-sm transition-all outline-none" 
                                           placeholder="+92 3XX XXXXXXX" />
                                    <i data-lucide="smartphone" class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-blue-600 transition-colors w-5 h-5"></i>
                                </div>
                            </div>
                        </div>

                        <div class="space-y-3">
                            <label class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] ml-1">Preferred Appointment Slot</label>
                            <div class="relative group">
                                <input type="datetime-local" name="PreferredDate" required 
                                       class="w-full pl-14 pr-6 py-5 bg-white border-2 border-slate-100 focus:border-blue-500 rounded-[1.5rem] font-bold text-slate-900 shadow-sm transition-all outline-none" />
                                <i data-lucide="calendar-clock" class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-300 group-focus-within:text-blue-600 transition-colors w-5 h-5"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Section: Logistics -->
                    <div class="space-y-8 p-8 bg-slate-50 rounded-[2.5rem] border border-slate-200/50">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 bg-emerald-500 text-white rounded-2xl flex items-center justify-center shadow-lg shadow-emerald-500/20">
                                    <i data-lucide="home" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <h3 class="text-xl font-black text-slate-900 tracking-tight">Home Collection</h3>
                                    <p class="text-xs font-bold text-emerald-600 uppercase tracking-widest">Premium Service - Available</p>
                                </div>
                            </div>
                            
                            <label class="relative inline-flex items-center cursor-pointer group">
                                <input type="checkbox" name="IsHomeCollection" id="homeCollection" class="sr-only peer" onchange="toggleAddress()" checked>
                                <div class="w-16 h-9 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[4px] after:left-[4px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-7 after:w-7 after:transition-all peer-checked:bg-blue-600 shadow-inner group-hover:scale-110 transition-transform"></div>
                            </label>
                        </div>

                        <div id="addressField" class="space-y-3 animate-in slide-in-from-top-4 duration-500">
                            <label class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] ml-1">Full Collection Address</label>
                            <div class="relative group">
                                <textarea name="Address" rows="3" 
                                          class="w-full pl-14 pr-6 py-5 bg-white border-2 border-slate-100 focus:border-blue-500 rounded-[1.5rem] font-bold text-slate-900 shadow-sm transition-all outline-none" 
                                          placeholder="Apt, Street, Landmarks..."></textarea>
                                <i data-lucide="map-pinned" class="absolute left-5 top-6 text-slate-300 group-focus-within:text-blue-600 transition-colors w-5 h-5"></i>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="w-full h-24 bg-blue-600 text-white rounded-[2rem] font-black text-2xl shadow-2xl shadow-blue-600/30 hover:bg-blue-500 hover:scale-[1.01] active:scale-[0.98] transition-all flex items-center justify-center gap-4 group/btn">
                        <span>Confirm Appointment</span>
                        <i data-lucide="check-circle-2" class="w-8 h-8 group-hover:scale-110 transition-transform"></i>
                    </button>
                </form>
            </div>
        </div>

        <!-- Right: Summary -->
        <div class="lg:w-[400px] shrink-0">
            <div class="bg-slate-900 rounded-[3rem] p-10 text-white shadow-2xl sticky top-12 overflow-hidden border border-white/10">
                <div class="absolute -right-20 -top-20 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>
                
                <h3 class="text-2xl font-black mb-10 relative z-10 flex items-center justify-between">
                    Summary
                    <span class="text-xs bg-white/10 px-3 py-1 rounded-full text-blue-400 uppercase tracking-widest">Pre-booked</span>
                </h3>
                
                <div class="space-y-6 mb-12 relative z-10 max-h-[350px] overflow-y-auto pr-2 custom-glass-scrollbar">
                    @foreach (var test in tests)
                    {
                        <div class="flex justify-between items-start gap-6 group/item">
                            <div class="flex-1">
                                <p class="text-sm font-black text-slate-100 group-hover:text-blue-400 transition-colors">@test.Name</p>
                                <p class="text-[10px] font-black text-slate-500 uppercase tracking-[0.2em] mt-2">@test.SampleType Specialist Analysis</p>
                            </div>
                            <div class="text-right">
                                <p class="text-sm font-black text-blue-400">Rs. @test.Price</p>
                            </div>
                        </div>
                    }
                </div>

                <div class="space-y-6 pt-10 border-t border-white/10 relative z-10">
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">Processing Subtotal</span>
                        <span class="font-black">Rs. @total</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500 font-bold uppercase tracking-widest text-[10px]">Collection Logistics</span>
                        <span class="font-black text-emerald-400 tracking-widest">FREE</span>
                    </div>
                    <div class="pt-10 border-t border-white/10 flex flex-col gap-2">
                        <p class="text-[10px] font-black text-blue-500 uppercase tracking-[0.3em] mb-2">Total Amount Payable</p>
                        <div class="flex justify-between items-end">
                             <span class="text-5xl font-black tracking-tighter">Rs. @total</span>
                             <div class="text-right">
                                 <p class="text-xs font-black text-emerald-400 uppercase tracking-widest">All Taxes Incl.</p>
                             </div>
                        </div>
                    </div>
                </div>

                <div class="mt-12 p-6 bg-white/5 rounded-[2rem] border border-white/5 relative z-10 hover:bg-white/10 transition-colors">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-10 h-10 bg-white/10 rounded-xl flex items-center justify-center">
                            <i data-lucide="lock" class="w-5 h-5 text-blue-400"></i>
                        </div>
                        <p class="text-xs font-black text-slate-300 uppercase tracking-widest">Secure Dispatch</p>
                    </div>
                    <p class="text-xs font-bold text-slate-500 leading-relaxed">Payment is processed upon successful sample collection or via wallet during confirmation.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggleAddress() {
        const check = document.getElementById('homeCollection');
        const field = document.getElementById('addressField');
        if (check.checked) {
            field.style.display = 'block';
            field.classList.add('animate-in', 'slide-in-from-top-4');
        } else {
            field.style.display = 'none';
        }
    }
</script>

<style>
    .custom-glass-scrollbar::-webkit-scrollbar {
        width: 4px;
    }
    .custom-glass-scrollbar::-webkit-scrollbar-track {
        background: rgba(255,255,255,0.05);
        border-radius: 10px;
    }
    .custom-glass-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.1);
        border-radius: 10px;
    }
    .custom-glass-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgba(255,255,255,0.2);
    }
</style>
