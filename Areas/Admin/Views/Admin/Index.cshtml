                </button>
                <button id="scrollRight" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 w-12 h-12 bg-white rounded-full shadow-xl border border-slate-200 flex items-center justify-center text-slate-600 hover:text-blue-600 hover:border-blue-300 transition-all opacity-0 group-hover:opacity-100 hover:scale-110 active:scale-95">
                    <i class="fas fa-chevron-right"></i>
                </button>
