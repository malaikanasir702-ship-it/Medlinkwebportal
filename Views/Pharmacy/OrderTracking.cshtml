@model MedLinkPortal.Models.PatientDashboardModel
@{
    ViewData["Title"] = "Order Tracking";
    Layout = "_DashboardLayout";
    
    var order = Model?.CurrentOrder;
    if (order == null)
    {
        <div class="min-h-screen flex items-center justify-center">
            <div class="text-center p-8 bg-white rounded-3xl shadow-xl border border-slate-100">
                <i data-lucide="alert-circle" class="w-16 h-16 text-rose-500 mb-4 mx-auto"></i>
                <h2 class="text-xl font-bold text-slate-900">Order Information Unavailable</h2>
                <p class="text-slate-500 mt-2">We couldn't load the details for this order at this moment.</p>
                <a href="/Dashboard" class="mt-6 inline-block px-6 py-2 bg-blue-600 text-white rounded-xl font-bold">Back to Dashboard</a>
            </div>
        </div>
        return;
    }
    int statusStep = (int)order.Status;
    bool hasRider = order.Status >= MedLinkPortal.Models.PharmacyOrderStatus.RiderAssigned
                 && order.Status != MedLinkPortal.Models.PharmacyOrderStatus.Delivered
                 && order.Status != MedLinkPortal.Models.PharmacyOrderStatus.Cancelled;
}

<div class="min-h-screen bg-slate-50/50 pb-20">
    <div class="max-w-4xl mx-auto px-4 py-8 lg:py-12">
        <!-- Header -->
        <div class="bg-white rounded-[2.5rem] p-8 md:p-10 border border-slate-100 shadow-xl mb-8 relative overflow-hidden">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 relative z-10">
                <div class="flex items-center gap-6">
                    <div class="w-16 h-16 bg-emerald-600 rounded-2xl flex items-center justify-center text-white shadow-xl shadow-emerald-600/20">
                        <i data-lucide="package" class="w-10 h-10"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-semibold text-slate-900 tracking-tight">Order #MED-@order.Id.ToString("D5")</h1>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">Placed on @order.CreatedAt.ToString("MMM dd, yyyy • HH:mm")</p>
                    </div>
                </div>
                <div id="statusBadge" class="flex items-center gap-3 bg-emerald-50 px-5 py-2.5 rounded-full border border-emerald-100 shadow-sm">
                    <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                    <span id="statusText" class="text-xs font-semibold text-emerald-700 uppercase tracking-widest">@order.Status</span>
                </div>
            </div>
            <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-emerald-600/5 rounded-full blur-[100px] -z-0"></div>
        </div>

        <!-- ── LIVE MAP SECTION (shown when rider is assigned) ── -->
        @if (hasRider)
        {
            <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-xl mb-8 overflow-hidden">
                <div class="p-6 border-b border-slate-50 flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="w-2.5 h-2.5 rounded-full bg-blue-500 animate-pulse"></div>
                        <h2 class="text-sm font-bold text-slate-900 uppercase tracking-widest">Live Rider Location</h2>
                    </div>
                    <div id="etaBanner" class="hidden px-4 py-1.5 bg-blue-50 rounded-full text-xs font-bold text-blue-700 border border-blue-100">
                        ETA: <span id="etaMinutes">--</span> min
                    </div>
                </div>

                <!-- Map container -->
                <div id="trackingMap" style="height: 340px; width: 100%; background: #f1f5f9; position: relative;">
                    <div id="mapWaiting" class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-slate-400">
                        <div class="w-8 h-8 border-2 border-blue-300 border-t-blue-600 rounded-full animate-spin"></div>
                        <span class="text-xs font-semibold uppercase tracking-wider">Connecting to rider...</span>
                    </div>
                    <!-- Rider marker overlay -->
                    <div id="riderMarker" class="hidden absolute z-10 pointer-events-none" style="transform: translate(-50%, -50%);">
                        <div class="w-10 h-10 bg-blue-600 rounded-full flex items-center justify-center shadow-xl shadow-blue-600/40 border-2 border-white">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/>
                            </svg>
                        </div>
                        <div class="text-[9px] font-bold text-center text-blue-700 mt-1 bg-white rounded-full px-2 py-0.5 shadow">Rider</div>
                    </div>
                </div>

                <!-- Rider info bar -->
                <div id="riderInfoBar" class="hidden p-4 bg-slate-50 border-t border-slate-100 flex items-center gap-4">
                    <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center text-blue-600">
                        <i data-lucide="user" class="w-5 h-5"></i>
                    </div>
                    <div class="flex-1">
                        <p class="text-sm font-bold text-slate-900" id="riderName">Loading...</p>
                        <p class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider" id="riderVehicle">—</p>
                    </div>
                    <div class="text-right">
                        <p class="text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Distance</p>
                        <p class="text-sm font-bold text-slate-700" id="riderDistance">—</p>
                    </div>
                </div>
            </div>
        }

        <!-- Tracking Timeline -->
        <div class="bg-white rounded-[2.5rem] p-8 md:p-12 border border-slate-100 shadow-xl mb-8">
            <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-[0.2em] mb-10 ml-1">Journey Status</h2>
            
            <div class="relative">
                <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-1 bg-slate-100 md:-translate-x-1/2 rounded-full overflow-hidden">
                    <div id="progressBar" class="absolute top-0 left-0 right-0 bg-emerald-500 rounded-full transition-all duration-1000" style="height: @(statusStep * 20)%;"></div>
                </div>

                <div class="space-y-12">
                    @{
                        var steps = new[]
                        {
                            ("receipt", "Order Placed", "Awaiting Pharmacist Acceptance", 0),
                            ("circle-check", "Confirmed", "Pharmacist is preparing your meds", 1),
                            ("truck", "Rider Assigned", "Rider picking up your order", 3),
                            ("map-pin", "Out for Delivery", "Your order is on the way", 4),
                            ("home", "Delivered", "Package received successfully", 5),
                        };
                    }
                    @foreach (var (icon, label, sub, step) in steps)
                    {
                        <div class="relative flex items-center md:justify-center gap-8 md:gap-0">
                            <div class="md:w-1/2 flex justify-end md:pr-16 order-2 md:order-1">
                                <div class="text-right hidden md:block">
                                    <h4 class="font-semibold @(statusStep >= step ? "text-emerald-600" : "text-slate-400")">@label</h4>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">@sub</p>
                                </div>
                            </div>
                            <div class="w-12 h-12 rounded-full @(statusStep >= step ? "bg-emerald-500 shadow-lg shadow-emerald-500/30" : "bg-slate-200") flex items-center justify-center text-white z-10 shrink-0 order-1 md:order-2 step-dot" data-step="@step">
                                <i data-lucide="@icon" class="w-6 h-6"></i>
                            </div>
                            <div class="md:w-1/2 md:pl-16 order-3">
                                <div class="md:hidden">
                                    <h4 class="font-semibold @(statusStep >= step ? "" : "text-slate-300")">@label</h4>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">@sub</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Order Details -->
            <div class="bg-white rounded-[2.5rem] p-8 md:p-10 border border-slate-100 shadow-xl">
                <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-6 border-b border-slate-50 pb-4">Package Contents</h3>
                <div class="space-y-4">
                    @foreach (var item in order.OrderItems ?? new List<MedLinkPortal.Models.PharmacyOrderItem>())
                    {
                        <div class="flex justify-between items-center p-4 bg-slate-50 rounded-2xl border border-slate-100">
                            <div>
                                <p class="font-bold text-slate-900 text-sm">@item.Medicine.Name</p>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">PKR @item.UnitPrice x @item.Quantity</p>
                            </div>
                            <p class="font-semibold text-slate-900">PKR @(item.UnitPrice * item.Quantity)</p>
                        </div>
                    }
                    <div class="pt-6 mt-4 border-t border-dashed border-slate-200 flex justify-between items-center px-2">
                        <span class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Total Paid</span>
                        <span class="text-2xl font-semibold text-emerald-600">PKR @order.TotalAmount</span>
                    </div>
                </div>
            </div>

            <!-- Shipping Information -->
            <div class="bg-slate-900 rounded-[2.5rem] p-8 md:p-10 border border-white/5 shadow-2xl relative overflow-hidden">
                <h3 class="text-xs font-semibold text-white/40 uppercase tracking-widest mb-6 border-b border-white/5 pb-4">Destination Intelligence</h3>
                <div class="space-y-6 relative z-10">
                    <div>
                        <p class="text-[10px] font-semibold text-emerald-500 uppercase tracking-widest mb-2">Delivery Address</p>
                        <p class="text-sm font-bold text-white/80 leading-relaxed">@order.ShippingAddress</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-semibold text-emerald-500 uppercase tracking-widest mb-2">Payment Method</p>
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-white">
                                <i data-lucide="credit-card" class="w-4 h-4"></i>
                            </div>
                            <span class="text-sm font-bold text-white/80">@order.PaymentMethod</span>
                        </div>
                    </div>
                    <div class="pt-4">
                        <a href="@Url.Action("SupportIntelligence", "Pharmacy", new { id = order.Id })" class="w-full py-4 bg-white/10 text-white font-semibold text-xs rounded-2xl border border-white/10 hover:bg-white/20 transition-all flex items-center justify-center gap-3">
                            <i data-lucide="headphones" class="w-4 h-4"></i> Support Intelligence
                        </a>
                    </div>
                </div>
                <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-emerald-500/10 rounded-full blur-[80px] -z-0"></div>
            </div>
        </div>
    </div>
</div>

@if (hasRider)
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script src="https://unpkg.com/maplibre-gl@@3.3.1/dist/maplibre-gl.js"></script>
    <link href="https://unpkg.com/maplibre-gl@@3.3.1/dist/maplibre-gl.css" rel="stylesheet">
    <script>
    (async function() {
        const orderId   = @order.Id;
        const orderType = 'PharmacyOrder';
        const groupKey  = `order_pharmacyorder_${orderId}`;

        // ── MapLibre map ─────────────────────────────────────────────────
        const map = new maplibregl.Map({
            container: 'trackingMap',
            style: 'https://tiles.openfreemap.org/styles/positron',
            zoom: 13,
            center: [67.0011, 24.8607], // Karachi default
        });

        let riderMarker = null;
        let destMarker  = null;
        let hasRiderPos = false;

        map.on('load', async () => {
            document.getElementById('mapWaiting').classList.add('hidden');

            // Add route layer (will be populated later)
            map.addSource('route', { type: 'geojson', data: { type: 'Feature', geometry: { type: 'LineString', coordinates: [] }, properties: {} } });
            map.addLayer({ id: 'route-line', type: 'line', source: 'route',
                layout: { 'line-join': 'round', 'line-cap': 'round' },
                paint: { 'line-color': '#2563EB', 'line-width': 4, 'line-opacity': 0.85 } });

            // Fetch last known position
            try {
                const res = await fetch(`/api/tracking/last-location/${orderType}/${orderId}`, { credentials: 'include' });
                if (res.ok) {
                    const dto = await res.json();
                    if (Math.abs(dto.latitude) > 0.001 || Math.abs(dto.longitude) > 0.001) {
                        placeRiderMarker(dto.latitude, dto.longitude, dto.heading ?? 0);
                        map.flyTo({ center: [dto.longitude, dto.latitude], zoom: 14 });
                        fetchRoute(dto.latitude, dto.longitude);
                    }
                }
            } catch {}

            // Load rider info
            try {
                const ri = await fetch(`/api/tracking/rider-info/${orderType}/${orderId}`, { credentials: 'include' });
                if (ri.ok) {
                    const info = await ri.json();
                    document.getElementById('riderName').textContent    = info.name || 'Rider';
                    document.getElementById('riderVehicle').textContent = `${info.vehicleType} • ⭐ ${info.averageRating?.toFixed(1)}`;
                    document.getElementById('riderInfoBar').classList.remove('hidden');
                }
            } catch {}

            // Connect SignalR
            connectSignalR();
        });

        // ── Rider marker ──────────────────────────────────────────────────
        function placeRiderMarker(lat, lng, heading) {
            const el = document.createElement('div');
            el.style.cssText = 'width:44px;height:44px;background:#2563EB;border-radius:50%;display:flex;align-items:center;justify-content:center;border:3px solid white;box-shadow:0 4px 14px rgba(37,99,235,0.5);';
            el.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="white"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg>`;

            if (riderMarker) riderMarker.remove();
            riderMarker = new maplibregl.Marker({ element: el, rotationAlignment: 'map', rotation: heading })
                .setLngLat([lng, lat])
                .addTo(map);
            hasRiderPos = true;
        }

        // ── Route polyline ────────────────────────────────────────────────
        async function fetchRoute(rLat, rLng) {
            try {
                const res = await fetch(`/api/tracking/route/${orderType}/${orderId}`, { credentials: 'include' });
                if (!res.ok) return;
                const data = await res.json();
                if (data.polyline) {
                    const coords = decodePolyline(data.polyline);
                    map.getSource('route').setData({ type: 'Feature', geometry: { type: 'LineString', coordinates: coords }, properties: {} });
                }
                // ETA
                const etaRes = await fetch(`/api/tracking/eta/${orderType}/${orderId}`, { credentials: 'include' });
                if (etaRes.ok) {
                    const eta = await etaRes.json();
                    document.getElementById('etaMinutes').textContent = eta.estimatedMinutes;
                    document.getElementById('riderDistance').textContent = `${eta.distanceKm} km`;
                    document.getElementById('etaBanner').classList.remove('hidden');
                }
            } catch {}
        }

        // ── SignalR ───────────────────────────────────────────────────────
        async function connectSignalR() {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/trackingHub', { withCredentials: true })
                .withAutomaticReconnect()
                .build();

            connection.on('ReceiveLocationUpdate', (dto) => {
                if (!dto || (Math.abs(dto.latitude) < 0.001 && Math.abs(dto.longitude) < 0.001)) return;
                placeRiderMarker(dto.latitude, dto.longitude, dto.heading ?? 0);
                if (!hasRiderPos) map.flyTo({ center: [dto.longitude, dto.latitude], zoom: 14 });
                fetchRoute(dto.latitude, dto.longitude);
                if (dto.estimatedMinutes) {
                    document.getElementById('etaMinutes').textContent = dto.estimatedMinutes;
                    document.getElementById('etaBanner').classList.remove('hidden');
                }
            });

            connection.on('ReceiveStatusUpdate', (dto) => {
                document.getElementById('statusText').textContent = dto.statusLabel;
                // Update progress bar
                const statusMap = { 'RiderAssigned': 3, 'PickedUp': 4, 'OnTheWay': 4, 'Delivered': 5 };
                const step = statusMap[dto.statusLabel] ?? 3;
                document.getElementById('progressBar').style.height = `${step * 20}%`;
                // Highlight dots
                document.querySelectorAll('.step-dot').forEach(dot => {
                    const dotStep = parseInt(dot.getAttribute('data-step'));
                    if (dotStep <= step) {
                        dot.classList.remove('bg-slate-200');
                        dot.classList.add('bg-emerald-500', 'shadow-lg', 'shadow-emerald-500/30');
                    }
                });
                if (dto.statusLabel === 'Delivered' || dto.statusLabel === 'Cancelled') {
                    setTimeout(() => window.location.href = '/Pharmacy/MyOrders', 3000);
                }
            });

            connection.on('RiderNearby', () => {
                const banner = document.createElement('div');
                banner.className = 'fixed top-20 left-1/2 -translate-x-1/2 z-50 px-6 py-3 bg-emerald-500 text-white font-bold text-sm rounded-full shadow-xl';
                banner.textContent = '🏃 Rider is arriving!';
                document.body.appendChild(banner);
                setTimeout(() => banner.remove(), 5000);
            });

            try {
                await connection.start();
                await connection.invoke('JoinOrderGroup', groupKey);
            } catch(e) { console.warn('SignalR connection failed:', e); }
        }

        // ── Google polyline decoder ───────────────────────────────────────
        function decodePolyline(encoded) {
            const coords = []; let index = 0, lat = 0, lng = 0;
            while (index < encoded.length) {
                let b, shift = 0, result = 0;
                do { b = encoded.charCodeAt(index++) - 63; result |= (b & 0x1f) << shift; shift += 5; } while (b >= 0x20);
                lat += (result & 1) ? ~(result >> 1) : result >> 1;
                shift = 0; result = 0;
                do { b = encoded.charCodeAt(index++) - 63; result |= (b & 0x1f) << shift; shift += 5; } while (b >= 0x20);
                lng += (result & 1) ? ~(result >> 1) : result >> 1;
                coords.push([lng / 1e5, lat / 1e5]);
            }
            return coords;
        }
    })();
    </script>
}

<style>
    .animate-in { animation: fadeIn 0.5s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) lucide.createIcons();
    });
</script>

<div class="min-h-screen bg-slate-50/50 pb-20">
    <div class="max-w-4xl mx-auto px-4 py-8 lg:py-12">
        <!-- Header -->
        <div class="bg-white rounded-[2.5rem] p-8 md:p-10 border border-slate-100 shadow-xl mb-8 relative overflow-hidden">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 relative z-10">
                <div class="flex items-center gap-6">
                    <div class="w-16 h-16 bg-emerald-600 rounded-2xl flex items-center justify-center text-white shadow-xl shadow-emerald-600/20">
                        <i data-lucide="package" class="w-10 h-10"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-semibold text-slate-900 tracking-tight">Order #MED-@order.Id.ToString("D5")</h1>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">Placed on @order.CreatedAt.ToString("MMM dd, yyyy • HH:mm")</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 bg-emerald-50 px-5 py-2.5 rounded-full border border-emerald-100 shadow-sm">
                    <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                    <span class="text-xs font-semibold text-emerald-700 uppercase tracking-widest">@order.Status</span>
                </div>
            </div>
            
            <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-emerald-600/5 rounded-full blur-[100px] -z-0"></div>
        </div>

        <!-- Tracking Timeline -->
        <div class="bg-white rounded-[2.5rem] p-8 md:p-12 border border-slate-100 shadow-xl mb-8">
            <h2 class="text-sm font-semibold text-slate-400 uppercase tracking-[0.2em] mb-10 ml-1">Journey Status</h2>
            
            <div class="relative">
                <!-- Progress Line -->
                <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-1 bg-slate-100 md:-translate-x-1/2 rounded-full overflow-hidden">
                    <div class="absolute top-0 left-0 right-0 bg-emerald-500 rounded-full transition-all duration-1000" style="height: @(statusStep * 25)%;"></div>
                </div>

                <div class="space-y-12">
                    <!-- Step 1: Pending -->
                    <div class="relative flex items-center md:justify-center gap-8 md:gap-0">
                        <div class="md:w-1/2 flex justify-end md:pr-16 order-2 md:order-1">
                             <div class="text-right hidden md:block">
                                <h4 class="font-semibold text-slate-900 @(statusStep >= 0 ? "text-emerald-600" : "text-slate-400")">Order Placed</h4>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Awaiting Pharmacist Acceptance</p>
                             </div>
                        </div>
                        <div class="w-12 h-12 rounded-full @(statusStep >= 0 ? "bg-emerald-500 shadow-lg shadow-emerald-500/30" : "bg-slate-200") flex items-center justify-center text-white z-10 shrink-0 order-1 md:order-2">
                            <i data-lucide="receipt" class="w-6 h-6"></i>
                        </div>
                        <div class="md:w-1/2 md:pl-16 order-3">
                            <div class="md:hidden">
                                <h4 class="font-semibold text-slate-900">Order Placed</h4>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Awaiting Pharmacist Acceptance</p>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Accepted -->
                    <div class="relative flex items-center md:justify-center gap-8 md:gap-0">
                        <div class="md:w-1/2 md:pr-16 order-2 md:order-1">
                            <div class="md:pl-0 pl-0">
                                <div class="md:hidden">
                                    <h4 class="font-semibold text-slate-900 @(statusStep >= 1 ? "" : "text-slate-300")">Confirmed</h4>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Pharmacist is preparing your meds</p>
                                </div>
                            </div>
                        </div>
                        <div class="w-12 h-12 rounded-full @(statusStep >= 1 ? "bg-emerald-500 shadow-lg shadow-emerald-500/30" : "bg-slate-200") flex items-center justify-center text-white z-10 shrink-0 order-1 md:order-2">
                            <i data-lucide="circle-check" class="w-6 h-6"></i>
                        </div>
                        <div class="md:w-1/2 md:pl-16 order-3">
                            <div class="hidden md:block">
                                <h4 class="font-semibold text-slate-900 @(statusStep >= 1 ? "text-emerald-600" : "text-slate-400")">Confirmed</h4>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Pharmacist is preparing your meds</p>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Dispatched -->
                    <div class="relative flex items-center md:justify-center gap-8 md:gap-0">
                        <div class="md:w-1/2 flex justify-end md:pr-16 order-2 md:order-1">
                             <div class="text-right hidden md:block">
                                <h4 class="font-semibold text-slate-900 @(statusStep >= 3 ? "text-emerald-600" : "text-slate-400")">Out for Delivery</h4>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Rider has picked up your order</p>
                             </div>
                        </div>
                        <div class="w-12 h-12 rounded-full @(statusStep >= 3 ? "bg-emerald-500 shadow-lg shadow-emerald-500/30" : "bg-slate-200") flex items-center justify-center text-white z-10 shrink-0 order-1 md:order-2">
                            <i data-lucide="truck" class="w-6 h-6"></i>
                        </div>
                        <div class="md:w-1/2 md:pl-16 order-3">
                             <div class="md:hidden">
                                <h4 class="font-semibold text-slate-900 @(statusStep >= 3 ? "" : "text-slate-300")">Out for Delivery</h4>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Rider has picked up your order</p>
                             </div>
                        </div>
                    </div>

                    <!-- Step 4: Delivered -->
                    <div class="relative flex items-center md:justify-center gap-8 md:gap-0">
                        <div class="md:w-1/2 md:pr-16 order-2 md:order-1"></div>
                        <div class="w-12 h-12 rounded-full @(statusStep >= 4 ? "bg-emerald-500 shadow-lg shadow-emerald-500/30" : "bg-slate-200") flex items-center justify-center text-white z-10 shrink-0 order-1 md:order-2">
                            <i data-lucide="home" class="w-6 h-6"></i>
                        </div>
                        <div class="md:w-1/2 md:pl-16 order-3">
                             <div>
                                <h4 class="font-semibold text-slate-900 @(statusStep >= 4 ? "text-emerald-600" : "text-slate-400")">Delivered</h4>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Package received successfully</p>
                             </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Order Details -->
            <div class="bg-white rounded-[2.5rem] p-8 md:p-10 border border-slate-100 shadow-xl">
                 <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-6 border-b border-slate-50 pb-4">Package Contents</h3>
                 <div class="space-y-4">
                    @foreach (var item in order.OrderItems ?? new List<MedLinkPortal.Models.PharmacyOrderItem>())
                    {
                        <div class="flex justify-between items-center p-4 bg-slate-50 rounded-2xl border border-slate-100">
                            <div>
                                <p class="font-bold text-slate-900 text-sm">@item.Medicine.Name</p>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">PKR @item.UnitPrice x @item.Quantity</p>
                            </div>
                            <p class="font-semibold text-slate-900">PKR @(item.UnitPrice * item.Quantity)</p>
                        </div>
                    }
                    <div class="pt-6 mt-4 border-t border-dashed border-slate-200 flex justify-between items-center px-2">
                        <span class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Total Paid</span>
                        <span class="text-2xl font-semibold text-emerald-600">PKR @order.TotalAmount</span>
                    </div>
                 </div>
            </div>

            <!-- Shipping Information -->
            <div class="bg-slate-900 rounded-[2.5rem] p-8 md:p-10 border border-white/5 shadow-2xl relative overflow-hidden">
                <h3 class="text-xs font-semibold text-white/40 uppercase tracking-widest mb-6 border-b border-white/5 pb-4">Destination Intelligence</h3>
                
                <div class="space-y-6 relative z-10">
                    <div>
                        <p class="text-[10px] font-semibold text-emerald-500 uppercase tracking-widest mb-2">Delivery Address</p>
                        <p class="text-sm font-bold text-white/80 leading-relaxed">@order.ShippingAddress</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-semibold text-emerald-500 uppercase tracking-widest mb-2">Payment Method</p>
                        <div class="flex items-center gap-3">
                             <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-white">
                                <i data-lucide="credit-card" class="w-4 h-4"></i>
                             </div>
                             <span class="text-sm font-bold text-white/80">@order.PaymentMethod</span>
                        </div>
                    </div>
                    <div class="pt-4">
                         <a href="@Url.Action("SupportIntelligence", "Pharmacy", new { id = order.Id })" class="w-full py-4 bg-white/10 text-white font-semibold text-xs rounded-2xl border border-white/10 hover:bg-white/20 transition-all flex items-center justify-center gap-3">
                            <i data-lucide="headphones" class="w-4 h-4"></i> Support Intelligence
                         </a>
                    </div>
                </div>

                <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-emerald-500/10 rounded-full blur-[80px] -z-0"></div>
            </div>
        </div>
    </div>
</div>

<style>
    .animate-in { animation: fadeIn 0.5s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) {
            lucide.createIcons();
        }
    });
</script>
