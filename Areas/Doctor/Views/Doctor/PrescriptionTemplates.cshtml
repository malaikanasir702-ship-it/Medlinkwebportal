@{
    ViewData["Title"] = "Prescription Templates";
    Layout = "~/Areas/Doctor/Views/Shared/_Layout.cshtml";
}

<div class="space-y-8 pb-20">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 py-6">
        <div>
            <h1 class="text-5xl font-bold text-slate-900 tracking-tight">Prescription <span class="text-blue-600">Templates</span></h1>
            <p class="text-slate-500 mt-2 font-medium">Save frequently used prescriptions and apply them with one click.</p>
        </div>
        <button onclick="openTemplateModal()" class="flex items-center gap-3 px-8 py-4 bg-slate-900 text-white rounded-2xl text-sm font-bold hover:bg-black transition-all shadow-lg">
            <i class="fas fa-plus"></i> New Template
        </button>
    </div>

    <!-- Templates Grid -->
    <div id="templatesGrid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        <div class="col-span-full flex flex-col items-center justify-center py-20 text-slate-400">
            <i class="fas fa-spinner fa-spin text-4xl mb-4"></i>
            <p class="font-semibold">Loading templates...</p>
        </div>
    </div>
</div>

<!-- New/Edit Template Modal -->
<div id="templateModal" class="fixed inset-0 hidden items-center justify-center modal-overlay p-4 z-[100]">
    <div class="bg-white rounded-3xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center">
            <h3 class="text-xl font-bold text-slate-900" id="modalTitle">New Template</h3>
            <button onclick="closeTemplateModal()" class="w-9 h-9 flex items-center justify-center rounded-xl bg-slate-100 hover:bg-slate-200 transition-all">
                <i class="fas fa-times text-slate-500"></i>
            </button>
        </div>
        <form id="templateForm" class="p-6 space-y-5">
            <input type="hidden" id="templateId" value="0">
            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Template Name *</label>
                <input type="text" id="templateName" required placeholder="e.g. Fever Bundle, Hypertension Routine"
                       class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-semibold text-slate-800">
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Diagnosis *</label>
                <textarea id="templateDiagnosis" rows="2" required placeholder="Primary diagnosis..."
                          class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-semibold text-slate-800 resize-none"></textarea>
            </div>

            <!-- Medicines -->
            <div>
                <div class="flex justify-between items-center mb-3">
                    <label class="text-xs font-bold text-slate-400 uppercase tracking-wider">Medications</label>
                    <button type="button" onclick="addMedRow()" class="text-xs text-blue-600 font-bold hover:underline">+ Add Medicine</button>
                </div>
                <div id="medRows" class="space-y-3"></div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Notes (Optional)</label>
                <textarea id="templateNotes" rows="2" placeholder="Additional instructions..."
                          class="w-full px-4 py-3 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-semibold text-slate-800 resize-none"></textarea>
            </div>

            <div class="flex gap-3 pt-2">
                <button type="button" onclick="closeTemplateModal()" class="flex-1 py-3 bg-slate-100 text-slate-600 rounded-xl text-sm font-bold hover:bg-slate-200">Cancel</button>
                <button type="submit" class="flex-1 py-3 bg-slate-900 text-white rounded-xl text-sm font-bold hover:bg-black">Save Template</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
let templates = [];

const medRowTpl = `
<div class="med-row grid grid-cols-2 gap-2">
  <input type="text" placeholder="Medicine name" class="med-name px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none text-sm font-semibold text-slate-800 col-span-2">
  <input type="text" placeholder="Dosage (e.g. 500mg)" class="med-dosage px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none text-sm font-semibold text-slate-800">
  <input type="text" placeholder="Frequency" class="med-freq px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none text-sm font-semibold text-slate-800">
  <input type="text" placeholder="Duration" class="med-dur px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none text-sm font-semibold text-slate-800">
  <input type="number" placeholder="Qty" value="1" class="med-qty px-3 py-2 bg-slate-50 rounded-xl border border-slate-200 focus:outline-none text-sm font-semibold text-slate-800">
  <button type="button" onclick="this.closest('.med-row').remove()" class="px-3 py-2 text-red-400 hover:text-red-600 hover:bg-red-50 rounded-xl text-sm font-bold"><i class="fas fa-trash"></i></button>
</div>`;

function addMedRow(data) {
    const div = document.createElement('div');
    div.innerHTML = medRowTpl;
    if (data) {
        div.querySelector('.med-name').value = data.medicineName || data.name || '';
        div.querySelector('.med-dosage').value = data.dosage || '';
        div.querySelector('.med-freq').value = data.frequency || '';
        div.querySelector('.med-dur').value = data.duration || '';
        div.querySelector('.med-qty').value = data.quantity || 1;
    }
    document.getElementById('medRows').appendChild(div.firstElementChild);
}

function getMeds() {
    return Array.from(document.querySelectorAll('.med-row')).map(row => ({
        medicineName: row.querySelector('.med-name').value,
        dosage: row.querySelector('.med-dosage').value,
        frequency: row.querySelector('.med-freq').value,
        duration: row.querySelector('.med-dur').value,
        quantity: parseInt(row.querySelector('.med-qty').value) || 1
    })).filter(m => m.medicineName);
}

function openTemplateModal(t) {
    document.getElementById('medRows').innerHTML = '';
    document.getElementById('templateId').value = t ? t.id : 0;
    document.getElementById('templateName').value = t ? t.name : '';
    document.getElementById('templateDiagnosis').value = t ? t.diagnosis : '';
    document.getElementById('templateNotes').value = t ? (t.notes || '') : '';
    document.getElementById('modalTitle').textContent = t ? 'Edit Template' : 'New Template';
    if (t) {
        try {
            const meds = JSON.parse(t.medicationsJson || '[]');
            meds.forEach(m => addMedRow(m));
        } catch {}
    } else {
        addMedRow();
    }
    const modal = document.getElementById('templateModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeTemplateModal() {
    const modal = document.getElementById('templateModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

document.getElementById('templateForm').addEventListener('submit', async e => {
    e.preventDefault();
    const btn = e.target.querySelector('button[type=submit]');
    btn.textContent = 'Saving...'; btn.disabled = true;
    const payload = {
        id: parseInt(document.getElementById('templateId').value),
        name: document.getElementById('templateName').value,
        diagnosis: document.getElementById('templateDiagnosis').value,
        medicationsJson: JSON.stringify(getMeds()),
        notes: document.getElementById('templateNotes').value || null
    };
    try {
        const res = await fetch('/api/doctor/prescription-templates', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + getToken() },
            body: JSON.stringify(payload)
        });
        if (res.ok) { closeTemplateModal(); loadTemplates(); }
        else alert('Failed to save template');
    } finally { btn.textContent = 'Save Template'; btn.disabled = false; }
});

async function deleteTemplate(id) {
    if (!confirm('Delete this template?')) return;
    await fetch(`/api/doctor/prescription-templates/${id}`, {
        method: 'DELETE', headers: { 'Authorization': 'Bearer ' + getToken() }
    });
    loadTemplates();
}

async function loadTemplates() {
    const res = await fetch('/api/doctor/prescription-templates', {
        headers: { 'Authorization': 'Bearer ' + getToken() }
    });
    templates = res.ok ? await res.json() : [];
    renderTemplates();
}

function renderTemplates() {
    const grid = document.getElementById('templatesGrid');
    if (!templates.length) {
        grid.innerHTML = `<div class="col-span-full flex flex-col items-center justify-center py-20 text-slate-400">
            <i class="fas fa-file-prescription text-5xl mb-4 opacity-30"></i>
            <p class="font-bold text-lg text-slate-500">No templates yet</p>
            <p class="text-sm mt-1">Create your first template to speed up prescriptions.</p>
        </div>`;
        return;
    }
    grid.innerHTML = templates.map(t => {
        let meds = [];
        try { meds = JSON.parse(t.medicationsJson || '[]'); } catch {}
        return `<div class="bg-white rounded-2xl border border-slate-100 p-6 hover:shadow-lg transition-all">
            <div class="flex justify-between items-start mb-4">
                <div>
                    <h3 class="font-bold text-slate-900 text-lg">${t.name}</h3>
                    <p class="text-sm text-slate-500 mt-1 line-clamp-1">${t.diagnosis}</p>
                </div>
                <div class="flex gap-2">
                    <button onclick="openTemplateModal(${JSON.stringify(t).replace(/"/g,'&quot;')})" class="w-9 h-9 flex items-center justify-center bg-blue-50 text-blue-600 rounded-xl hover:bg-blue-100 transition-all">
                        <i class="fas fa-edit text-xs"></i>
                    </button>
                    <button onclick="deleteTemplate(${t.id})" class="w-9 h-9 flex items-center justify-center bg-red-50 text-red-400 rounded-xl hover:bg-red-100 transition-all">
                        <i class="fas fa-trash text-xs"></i>
                    </button>
                </div>
            </div>
            <div class="space-y-1.5">
                ${meds.slice(0,3).map(m => `<div class="flex items-center gap-2">
                    <div class="w-1.5 h-1.5 rounded-full bg-blue-400 flex-shrink-0"></div>
                    <span class="text-sm text-slate-700 font-medium">${m.medicineName} <span class="text-slate-400">${m.dosage}</span></span>
                </div>`).join('')}
                ${meds.length > 3 ? `<span class="text-xs text-slate-400 font-semibold">+${meds.length-3} more</span>` : ''}
            </div>
            <div class="mt-4 pt-4 border-t border-slate-50 flex justify-between items-center">
                <span class="text-xs text-slate-400">${new Date(t.updatedAt).toLocaleDateString()}</span>
                <button onclick="applyTemplate(${t.id})" class="text-xs font-bold text-blue-600 hover:underline">Apply to Rx →</button>
            </div>
        </div>`;
    }).join('');
}

function applyTemplate(id) {
    const t = templates.find(x => x.id === id);
    if (!t) return;
    // Store in sessionStorage for prescription writer to pick up
    sessionStorage.setItem('rxTemplate', JSON.stringify(t));
    window.location.href = '/Doctor/Doctor/PrescriptionWriter';
}

function getToken() { return localStorage.getItem('jwt_token') || ''; }

document.addEventListener('DOMContentLoaded', loadTemplates);
</script>
}
