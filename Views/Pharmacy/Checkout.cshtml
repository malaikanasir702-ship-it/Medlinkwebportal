@model MedLinkPortal.Models.PatientDashboardModel
@{
    ViewData["Title"] = "Checkout";
    Layout = "_DashboardLayout";
    var prescription = Model.CurrentPrescription;
    var meds = prescription?.PrescriptionMedicines ?? new List<MedLinkPortal.Models.PrescriptionMedicine>();
    decimal total = meds.Sum(m => (m.Medicine?.Price ?? 0) * m.Quantity);
}

<div class="min-h-screen bg-slate-50/50 pb-20">
    <div class="max-w-4xl mx-auto px-4 py-8 lg:py-12">
        <!-- Header -->
        <div class="bg-white rounded-[2.5rem] p-8 md:p-10 border border-slate-100 shadow-xl mb-8 relative overflow-hidden">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 relative z-10">
                <div class="flex items-center gap-6">
                    <div class="w-16 h-16 bg-blue-600 rounded-2xl flex items-center justify-center text-white shadow-xl shadow-blue-600/20">
                        <i data-lucide="shopping-cart" class="w-8 h-8"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">Your Cart</h1>
                        @if(prescription?.AppointmentId > 0) {
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">Prescription for Appointment #@prescription?.AppointmentId</p>
                        } else {
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">Cart Summary</p>
                        }
                    </div>
                </div>
                <div class="flex items-center gap-3 bg-emerald-50 px-5 py-2.5 rounded-full border border-emerald-100 shadow-sm">
                    <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                    <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">Verified Prescription</span>
                </div>
            </div>
            <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-blue-600/5 rounded-full blur-[100px] -z-0"></div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
            <!-- Left Side: Items & Summary -->
            <div class="lg:col-span-7 space-y-8">
                <!-- Order Summary -->
                <div class="bg-white rounded-[2.5rem] p-8 md:p-10 border border-slate-100 shadow-xl">
                    <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-6 border-b border-slate-50 pb-4 flex items-center gap-2">
                        <i data-lucide="shopping-bag" class="w-4 h-4"></i> Cart Items
                    </h3>
                    <div id="checkoutItemsList" class="space-y-4">
                        @foreach (var item in meds)
                        {
                            <div class="flex justify-between items-center p-4 bg-slate-50 rounded-2xl border border-slate-100 group hover:bg-white transition-all">
                                <div>
                                    <p class="font-bold text-slate-900 text-sm">@(item.Medicine?.Name ?? "Unknown Medicine")</p>
                                    <div class="flex items-center gap-3 mt-1">
                                        <button onclick="updateQuantity(@item.MedicineId, -1, @(item.Medicine?.Price ?? 0))" class="w-6 h-6 rounded-full bg-white border border-slate-200 flex items-center justify-center hover:bg-slate-50 active:scale-90 transition-all">
                                            <i data-lucide="minus" class="w-3 h-3 text-slate-600"></i>
                                        </button>
                                        <span id="qty-@item.MedicineId" class="text-[10px] font-black text-slate-600">@item.Quantity</span>
                                        <button onclick="updateQuantity(@item.MedicineId, 1, @(item.Medicine?.Price ?? 0))" class="w-6 h-6 rounded-full bg-white border border-slate-200 flex items-center justify-center hover:bg-slate-50 active:scale-90 transition-all">
                                            <i data-lucide="plus" class="w-3 h-3 text-slate-600"></i>
                                        </button>
                                        <span class="text-slate-300">|</span>
                                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">@item.Dosage</p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="font-black text-slate-900" id="subtotal-@item.MedicineId">PKR @(((item.Medicine?.Price ?? 0) * item.Quantity).ToString("F2"))</p>
                                    <p class="text-[8px] text-slate-400 font-bold tracking-widest">PKR @(item.Medicine?.Price ?? 0) / unit</p>
                                </div>
                            </div>
                        }
                    </div>
                    
                    <div class="pt-8 mt-6 border-t border-dashed border-slate-200">
                        <div class="flex justify-between items-center px-2">
                            <span class="text-xs font-black text-slate-400 uppercase tracking-widest">Grand Total</span>
                            <span id="checkoutTotal" class="text-3xl font-black text-emerald-600">PKR @total.ToString("F2")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Shipping & Payment -->
            <div class="lg:col-span-5 space-y-8">
                <!-- Shipping Address -->
                <div class="bg-white rounded-[2.5rem] p-8 md:p-10 border border-slate-100 shadow-xl">
                    <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-6 border-b border-slate-50 pb-4 flex items-center gap-2">
                        <i data-lucide="map-pin" class="w-4 h-4"></i> Delivery Destination
                    </h3>
                    <textarea id="deliveryAddress" class="w-full p-5 bg-slate-50 border border-slate-100 rounded-2xl text-sm font-bold focus:ring-4 focus:ring-blue-500/5 focus:border-blue-400 outline-none transition-all h-32" placeholder="Enter full delivery address..."></textarea>
                </div>

                <!-- Payment Strategy -->
                <div class="bg-slate-900 rounded-[2.5rem] p-8 md:p-10 border border-white/5 shadow-2xl relative overflow-hidden">
                    <h3 class="text-xs font-black text-white/40 uppercase tracking-widest mb-6 border-b border-white/5 pb-4 flex items-center gap-2">
                        <i data-lucide="credit-card" class="w-4 h-4"></i> Payment Strategy
                    </h3>
                    
                    <div class="space-y-4 relative z-10">
                        <div class="grid grid-cols-1 gap-3">
                            <label class="relative cursor-pointer group">
                                <input type="radio" name="paymentMethod" value="0" checked class="peer sr-only">
                                <div class="p-4 bg-white/5 border border-white/10 rounded-2xl flex items-center gap-4 peer-checked:border-emerald-500 peer-checked:bg-emerald-500/10 transition-all hover:bg-white/10">
                                    <div class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-white group-peer-checked:bg-emerald-500">
                                        <i data-lucide="truck" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <span class="text-[10px] font-black uppercase text-white/60 group-peer-checked:text-emerald-400 block">Standard</span>
                                        <span class="text-sm font-bold text-white tracking-tight">Cash on Delivery</span>
                                    </div>
                                    <div class="ml-auto opacity-0 group-peer-checked:opacity-100 transition-opacity">
                                        <i data-lucide="check-circle" class="w-5 h-5 text-emerald-500"></i>
                                    </div>
                                </div>
                            </label>

                            <label class="relative cursor-pointer group">
                                <input type="radio" name="paymentMethod" value="1" class="peer sr-only">
                                <div class="p-4 bg-white/5 border border-white/10 rounded-2xl flex items-center gap-4 peer-checked:border-emerald-500 peer-checked:bg-emerald-500/10 transition-all hover:bg-white/10">
                                    <div class="w-10 h-10 rounded-xl bg-white/5 flex items-center justify-center text-white group-peer-checked:bg-emerald-500">
                                        <i data-lucide="zap" class="w-5 h-5"></i>
                                    </div>
                                    <div>
                                        <span class="text-[10px] font-black uppercase text-white/60 group-peer-checked:text-emerald-400 block">Instant</span>
                                        <span class="text-sm font-bold text-white tracking-tight">Online Payment</span>
                                    </div>
                                    <div class="ml-auto opacity-0 group-peer-checked:opacity-100 transition-opacity">
                                        <i data-lucide="check-circle" class="w-5 h-5 text-emerald-500"></i>
                                    </div>
                                </div>
                            </label>
                        </div>

                        <div class="pt-6">
                            <button type="button" id="btnPlaceOrder" onclick="Pharmacy.placeOrder(checkoutData)" class="w-full py-5 bg-emerald-600 text-white font-black text-sm rounded-2xl hover:bg-emerald-700 shadow-xl shadow-emerald-600/20 active:scale-95 transition-all flex items-center justify-center gap-3">
                                <i data-lucide="shield-check" class="w-5 h-5"></i> Complete Secure Order
                            </button>
                            <p class="text-[10px] text-white/30 text-center mt-4 font-bold uppercase tracking-widest">Encrypted Checkout Flow</p>
                        </div>
                    </div>

                    <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-emerald-500/10 rounded-full blur-[80px] -z-0"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pharmacy-core.js"></script>
    <script>
        // Data for PlaceOrder
        const checkoutData = {
            appointmentId: @(prescription?.AppointmentId ?? 0),
            prescriptionId: @(prescription?.Id ?? 0),
            items: [
                @foreach(var item in meds) {
                    <text>{ medicineId: @item.MedicineId, quantity: @item.Quantity, price: @(item.Medicine?.Price ?? 0) },</text>
                }
            ]
        };

        function updateQuantity(medicineId, delta, price) {
            const item = checkoutData.items.find(i => i.medicineId === medicineId);
            if (!item) return;

            const newQty = item.quantity + delta;
            if (newQty < 1) return;

            item.quantity = newQty;
            
            // Update UI
            document.getElementById(`qty-${medicineId}`).innerText = newQty;
            document.getElementById(`subtotal-${medicineId}`).innerText = `PKR ${(newQty * price).toFixed(2)}`;
            
            // Update Grand Total
            updateGrandTotal();
        }

        function updateGrandTotal() {
            const total = checkoutData.items.reduce((acc, item) => acc + (item.quantity * item.price), 0);
            document.getElementById('checkoutTotal').innerText = `PKR ${total.toFixed(2)}`;
        }

        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();
        });
    </script>
}

<style>
    .animate-in { animation: fadeIn 0.5s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>
