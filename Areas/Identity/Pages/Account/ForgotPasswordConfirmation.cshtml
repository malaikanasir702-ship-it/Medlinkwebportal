@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<style>
    .login-container {
        min-height: 100vh;
        width: 100%;
        background: #F8FAFC;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        position: relative;
        overflow: hidden;
    }

    .dynamic-bg {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        opacity: 0.4;
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }

    .bg-blue {
        top: -10%;
        right: -10%;
        width: 35%;
        height: 35%;
        background: #DBEAFE;
    }

    .bg-emerald {
        bottom: -10%;
        left: -10%;
        width: 35%;
        height: 35%;
        background: #D1FAE5;
        animation-delay: 1s;
    }

    .card {
        background: white;
        border-radius: 1.5rem;
        padding: 2.5rem;
        box-shadow: 0 10px 25px -5px rgba(37, 99, 235, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.5);
        backdrop-filter: blur(8px);
        max-width: 24rem;
        width: 100%;
        text-align: center;
        animation: fadeIn 0.5s ease-out;
        position: relative;
        z-index: 10;
    }

    .success-icon {
        width: 4rem;
        height: 4rem;
        background: #D1FAE5;
        color: #059669;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem auto;
    }

    .submit-btn {
        width: 100%;
        background: #111827;
        color: white;
        padding: 0.75rem;
        border-radius: 0.75rem;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        border: none;
        cursor: pointer;
        transition: all 0.3s;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        font-size: 0.875rem;
        text-decoration: none;
        margin-top: 1.5rem;
    }

    .submit-btn:hover {
        background: #2563EB;
        box-shadow: 0 10px 15px -3px rgba(37, 99, 235, 0.2);
    }

    .footer {
        margin-top: 2rem;
        font-size: 0.625rem;
        color: #9CA3AF;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-weight: bold;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
    
    @@keyframes pulse {
        0%, 100% { opacity: 0.4; }
        50% { opacity: 0.6; }
    }
</style>

<div class="login-container">
    <div class="dynamic-bg bg-blue"></div>
    <div class="dynamic-bg bg-emerald"></div>

    <div class="card">
        <div class="success-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
        </div>
        
        <h1 class="text-2xl font-black text-gray-900 tracking-tight mb-3">Check Your Email</h1>
        <p class="text-gray-500 font-medium text-sm leading-relaxed">
            We have sent a password reset link to your email address.
        </p>
        
        <a asp-page="./Login" class="submit-btn">
            Return to Login
        </a>
    </div>

    <div class="footer">
        Securely Encrypted Portals • HIPAA Compliant
    </div>
</div>
