@using Microsoft.AspNetCore.Identity
@using MedLinkPortal.Areas.Identity.Pages.Account
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedLink Pharmacist</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Outfit', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 min-h-screen">
    <div class="flex">
        <!-- Sidebar -->
        <aside class="hidden lg:block w-72 h-screen sticky top-0 border-r border-slate-200 z-50">
            <partial name="_PharmacistSidebar" />
        </aside>

        <!-- Main -->
        <main class="flex-1 min-h-screen flex flex-col">
            <!-- Top Nav -->
            <header class="h-20 bg-white/80 backdrop-blur-md border-b border-slate-100 flex items-center justify-between px-8 sticky top-0 z-40">
                <div class="flex items-center gap-4">
                    <button class="lg:hidden w-10 h-10 bg-slate-50 rounded-xl flex items-center justify-center text-slate-400">
                        <i class="fas fa-bars"></i>
                    </button>
                    <h2 class="font-semibold text-slate-900 tracking-tight">@ViewData["Title"]</h2>
                </div>
                
                <div class="flex items-center gap-6">
                    <div class="hidden md:flex items-center bg-slate-50 px-4 py-2 rounded-2xl border border-slate-100 gap-3">
                        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
                        <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Network Protocol Active</span>
                    </div>
                    
                    <div class="flex items-center gap-4 pl-6 border-l border-slate-100">
                         <div class="text-right hidden sm:block">
                            <p class="text-xs font-semibold text-slate-900">@user?.UserName</p>
                            <p class="text-[9px] font-bold text-emerald-600 uppercase tracking-widest">Head Pharmacist</p>
                         </div>
                         <div class="w-10 h-10 bg-emerald-600 rounded-xl flex items-center justify-center text-white shadow-lg shadow-emerald-500/20">
                            <i class="fas fa-id-badge"></i>
                         </div>
                    </div>
                </div>
            </header>

            <div class="flex-1 p-8">
                @RenderBody()
            </div>
        </main>
    </div>
    @RenderSection("Scripts", required: false)
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
