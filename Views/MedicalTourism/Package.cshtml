@model MedLinkPortal.Models.PatientDashboardModel

@{
    ViewData["Title"] = "Package Details";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var package = ViewBag.Package as MedLinkPortal.Models.MedicalTourismPackage;
}

@if(package != null)
{
    <div class="max-w-5xl mx-auto space-y-10 py-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 px-4">
            <div class="space-y-1">
                <a href="@Url.Action("Tracking")" class="inline-flex items-center gap-2 text-slate-500 hover:text-slate-900 transition-colors font-medium group mb-2">
                    <i data-lucide="arrow-left" class="w-4 h-4 group-hover:-translate-x-1 transition-transform"></i>
                    <span>Back to Journey</span>
                </a>
                <h1 class="text-3xl font-black text-slate-900 tracking-tight">Proposal Details</h1>
            </div>
            <div class="px-6 py-2.5 bg-blue-50 border border-blue-100 text-blue-600 rounded-full text-[10px] font-black uppercase tracking-[0.2em] shadow-sm flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
                Review Package
            </div>
        </div>

        <div class="bg-white rounded-[60px] overflow-hidden shadow-2xl shadow-slate-200/50 border border-slate-100/50 relative group">
            <!-- Header Banner -->
            <div class="bg-[#0A0F1E] p-10 md:p-16 text-white relative overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-transparent to-transparent opacity-50"></div>
                <!-- Abstract Glow -->
                <div class="absolute top-0 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[100px] -mr-32 -mt-32"></div>
                
                <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-8">
                    <div class="space-y-4">
                        <span class="inline-block px-4 py-1.5 bg-blue-500/20 backdrop-blur-md rounded-lg text-blue-300 text-[10px] font-black uppercase tracking-[0.2em]">Personalized Itinerary</span>
                        <h2 class="text-4xl md:text-6xl font-black tracking-tighter leading-none">Your Premium <br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-300">Package Proposal</span></h2>
                    </div>
                    <div class="bg-white/5 backdrop-blur-xl border border-white/10 p-8 rounded-[40px] text-right">
                        <p class="text-blue-300/80 font-black text-[10px] uppercase tracking-widest mb-2">Total Investment</p>
                        <div class="flex items-baseline justify-end gap-2">
                            <span class="text-4xl md:text-5xl font-black tracking-tighter">PKR @package.TotalPrice.ToString("N0")</span>
                        </div>
                        <p class="text-white/40 text-xs font-medium mt-2">All-Inclusive Concierge Estimate</p>
                    </div>
                </div>
            </div>

            <div class="p-10 md:p-16 space-y-16">
                
                <!-- Hospital & Doctor -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
                    <div class="space-y-8">
                        <div>
                            <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.3em] mb-8">Medical Excellence</h3>
                            <div class="flex items-center gap-6 p-8 rounded-[40px] bg-slate-50/50 border border-slate-100/50 group-hover:bg-white transition-all duration-500">
                                @if(!string.IsNullOrEmpty(package.Hospital?.ImageUrl)) {
                                    <img src="@package.Hospital.ImageUrl" class="w-20 h-20 rounded-3xl object-cover shadow-2xl border-4 border-white" />
                                } else {
                                    <div class="w-20 h-20 bg-blue-100 rounded-3xl flex items-center justify-center text-blue-600 text-3xl shadow-inner"><i data-lucide="hospital"></i></div>
                                }
                                <div>
                                    <h4 class="text-2xl font-black text-slate-900 leading-tight">@(package.Hospital?.Name ?? "Leading Medical Hub")</h4>
                                    <p class="text-slate-500 font-medium text-sm mt-1">@package.Hospital?.City, @package.Hospital?.Country</p>
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-6 p-6 rounded-[32px] bg-indigo-50/50 border border-indigo-100/50">
                            <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-indigo-600 shadow-xl shadow-indigo-100/50 border border-white">
                                <i data-lucide="user-check" class="w-6 h-6"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-black text-indigo-400 uppercase tracking-widest">Assigned Specialist</p>
                                <p class="text-lg font-black text-slate-900">@(package.Doctor?.Name ?? "Chief Medical Officer")</p>
                            </div>
                        </div>
                    </div>
                    
                    <div>
                        <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.3em] mb-8">Service Roadmap</h3>
                        <div class="relative pl-10 border-l-[3px] border-slate-100 space-y-12">
                            <div class="relative">
                                <div class="absolute -left-[51px] top-0 w-6 h-6 rounded-full bg-blue-600 border-[5px] border-white ring-8 ring-blue-50 shadow-lg"></div>
                                <h4 class="text-lg font-black text-slate-900 tracking-tight">Treatment & Care</h4>
                                <p class="text-slate-500 font-medium mt-1">Scheduled for @package.TreatmentDuration</p>
                            </div>
                            <div class="relative">
                                <div class="absolute -left-[51px] top-0 w-6 h-6 rounded-full bg-indigo-500 border-[5px] border-white ring-8 ring-indigo-50 shadow-lg"></div>
                                <h4 class="text-lg font-black text-slate-900 tracking-tight">Recovery Retreat</h4>
                                <p class="text-slate-500 font-medium mt-1">Experience Pakistan for @package.RecoveryDays</p>
                            </div>
                             <div class="relative">
                                <div class="absolute -left-[51px] top-0 w-6 h-6 rounded-full bg-slate-300 border-[5px] border-white shadow-lg"></div>
                                <h4 class="text-lg font-black text-slate-900 tracking-tight">Concierge Return</h4>
                                <p class="text-slate-500 font-medium mt-1">Airport Departure Support</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Inclusions -->
                <div class="space-y-10">
                     <h3 class="text-[10px] font-black text-slate-400 uppercase tracking-[0.3em]">Premium Inclusions</h3>
                     <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                         <div class="p-8 rounded-[40px] bg-blue-50/50 border border-blue-100/50 group/item hover:bg-white transition-all duration-500">
                             <div class="flex items-center gap-4 mb-4 text-blue-900">
                                 <div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center shadow-lg group-hover/item:scale-110 transition-transform">
                                     <i data-lucide="car" class="w-6 h-6 text-blue-600"></i>
                                 </div>
                                 <h4 class="text-lg font-black tracking-tight">Executive Logistics</h4>
                             </div>
                             <p class="text-blue-700/70 font-medium leading-relaxed">@package.AirportPickup</p>
                         </div>
                         <div class="p-8 rounded-[40px] bg-indigo-50/50 border border-indigo-100/50 group/item hover:bg-white transition-all duration-500">
                             <div class="flex items-center gap-4 mb-4 text-indigo-900">
                                 <div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center shadow-lg group-hover/item:scale-110 transition-transform">
                                     <i data-lucide="hotel" class="w-6 h-6 text-indigo-600"></i>
                                 </div>
                                 <h4 class="text-lg font-black tracking-tight">Luxury Residence</h4>
                             </div>
                             <p class="text-indigo-700/70 font-medium leading-relaxed">@package.HotelDetails</p>
                         </div>
                         <div class="p-10 rounded-[48px] bg-slate-900 text-white md:col-span-2 relative overflow-hidden group/tour">
                             <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/20 rounded-full blur-[80px] -mr-32 -mt-32"></div>
                             <div class="relative z-10">
                                 <div class="flex items-center gap-4 mb-6">
                                     <div class="w-14 h-14 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center">
                                         <i data-lucide="map" class="w-7 h-7 text-blue-400"></i>
                                     </div>
                                     <h4 class="text-2xl font-black tracking-tight">Curation Tour Itinerary</h4>
                                 </div>
                                 <p class="text-slate-400 text-lg font-medium leading-[1.8]">@package.TourPlanDetails</p>
                             </div>
                         </div>
                     </div>
                </div>

                <!-- CTA -->
                <div class="pt-10 flex items-center justify-between border-t border-slate-100">
                    <div class="hidden md:block">
                        <p class="text-slate-500 font-medium flex items-center gap-2">
                            <i data-lucide="shield-check" class="w-5 h-5 text-blue-500"></i>
                            Stripe Secure Encryption Enabled
                        </p>
                    </div>
                    <form asp-action="CreateCheckoutSession" method="post" class="w-full md:w-auto">
                        <input type="hidden" name="packageId" value="@package.Id" />
                        <button type="submit" class="w-full md:w-auto px-12 py-5 bg-blue-600 text-white rounded-2xl font-black text-xs uppercase tracking-[0.3em] hover:bg-slate-900 hover:scale-[1.02] active:scale-[0.98] transition-all shadow-2xl shadow-blue-200 flex items-center justify-center gap-4">
                            <span>Secure Checkout</span>
                            <i data-lucide="chevron-right" class="w-5 h-5"></i>
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
}
