@{
    ViewData["Title"] = "Platform Capabilities | MedLink";
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-purple-50">
    <!-- Hero Section -->
    <section class="relative overflow-hidden pt-32 pb-20 px-6">
        <!-- Animated Background Elements -->
        <div class="absolute top-0 left-0 w-full h-full -z-10">
            <div class="absolute top-[-20%] right-[-10%] w-[60%] h-[60%] bg-blue-200/30 rounded-full blur-[120px] animate-pulse"></div>
            <div class="absolute bottom-[-20%] left-[-10%] w-[50%] h-[50%] bg-purple-200/30 rounded-full blur-[120px] animate-pulse" style="animation-delay: 1s;"></div>
        </div>

        <div class="max-w-7xl mx-auto">
            <div class="text-center mb-16 animate-fade-in-up">
                <div class="inline-flex items-center gap-2 bg-blue-600 text-white rounded-full px-6 py-2 mb-8 shadow-lg shadow-blue-200">
                    <i data-lucide="sparkles" class="w-4 h-4"></i>
                    <span class="text-sm font-bold uppercase tracking-wider">What's New</span>
                    <span class="bg-white/20 px-2 py-0.5 rounded-full text-xs">v1.0</span>
                </div>
                
                <h1 class="text-5xl md:text-7xl font-black text-gray-900 tracking-tight leading-[1.1] mb-8">
                    Healthcare reimagined<br/>
                    for the <span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">digital age.</span>
                </h1>
                
                <p class="text-xl md:text-2xl text-gray-600 max-w-3xl mx-auto leading-relaxed font-medium mb-12">
                    MedLink isn't just a booking app. It's a comprehensive ecosystem designed to connect patients, providers, and payers in a seamless, secure loop.
                </p>

                <div class="flex flex-wrap items-center justify-center gap-4">
                    <a href="/" class="px-8 py-4 bg-blue-600 text-white rounded-2xl font-bold text-lg shadow-xl shadow-blue-200 hover:bg-blue-700 hover:scale-105 transition-all duration-300">
                        Get Started
                    </a>
                    <a href="#features" class="px-8 py-4 bg-white text-gray-900 rounded-2xl font-bold text-lg shadow-lg border-2 border-gray-100 hover:border-blue-200 hover:shadow-xl transition-all duration-300">
                        Explore Features →
                    </a>
                </div>
            </div>

            <!-- Hero Image/Visual -->
            <div class="relative max-w-5xl mx-auto animate-fade-in-up" style="animation-delay: 0.2s;">
                <div class="relative rounded-[3rem] overflow-hidden shadow-2xl border-8 border-white">
                    <div class="aspect-video bg-gradient-to-br from-blue-600 to-purple-600 flex items-center justify-center">
                        <div class="text-center text-white p-12">
                            <i data-lucide="activity" class="w-24 h-24 mx-auto mb-6 opacity-90"></i>
                            <p class="text-3xl font-bold">Your Health Dashboard</p>
                            <p class="text-blue-100 mt-2">Intelligent. Secure. Always Available.</p>
                        </div>
                    </div>
                </div>
                <!-- Floating Cards -->
                <div class="absolute -top-8 -left-8 bg-white rounded-2xl shadow-xl p-4 border border-gray-100 hidden md:block animate-float">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                            <i data-lucide="check-circle" class="w-6 h-6 text-green-600"></i>
                        </div>
                        <div>
                            <p class="font-bold text-gray-900">99.9% Uptime</p>
                            <p class="text-sm text-gray-500">Always Available</p>
                        </div>
                    </div>
                </div>
                <div class="absolute -bottom-8 -right-8 bg-white rounded-2xl shadow-xl p-4 border border-gray-100 hidden md:block animate-float" style="animation-delay: 0.5s;">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                            <i data-lucide="shield-check" class="w-6 h-6 text-blue-600"></i>
                        </div>
                        <div>
                            <p class="font-bold text-gray-900">HIPAA Compliant</p>
                            <p class="text-sm text-gray-500">Bank-Grade Security</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section id="features" class="py-32 px-6 bg-white">
        <div class="max-w-7xl mx-auto">
            
            <!-- Smart Scheduling -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-32">
                <div class="order-2 lg:order-1">
                    <div class="inline-flex items-center gap-2 bg-blue-50 text-blue-600 rounded-full px-4 py-2 mb-6">
                        <i data-lucide="zap" class="w-4 h-4"></i>
                        <span class="text-sm font-bold uppercase tracking-wider">Seamless Access</span>
                    </div>
                    <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6 leading-tight">
                        Smart Scheduling
                    </h2>
                    <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                        Forget waiting on hold. Our AI-driven scheduling system syncs directly with doctors' real-time calendars.
                    </p>
                    
                    <div class="space-y-6">
                        <div class="flex gap-4">
                            <div class="flex-shrink-0 w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                                <i data-lucide="clock" class="w-6 h-6 text-blue-600"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-900 text-lg mb-2">Real-time Availability</h3>
                                <p class="text-gray-600">See exactly when slots open up, instantly. No more phone tag.</p>
                            </div>
                        </div>
                        
                        <div class="flex gap-4">
                            <div class="flex-shrink-0 w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center">
                                <i data-lucide="brain" class="w-6 h-6 text-purple-600"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-900 text-lg mb-2">Smart Matching</h3>
                                <p class="text-gray-600">Find the right specialist based on your symptoms and insurance.</p>
                            </div>
                        </div>
                        
                        <div class="flex gap-4">
                            <div class="flex-shrink-0 w-12 h-12 bg-green-100 rounded-xl flex items-center justify-center">
                                <i data-lucide="calendar-check" class="w-6 h-6 text-green-600"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-900 text-lg mb-2">Calendar Sync</h3>
                                <p class="text-gray-600">Auto-add to Google Calendar, Outlook, or iCal.</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="order-1 lg:order-2">
                    <div class="relative">
                        <div class="bg-gradient-to-br from-blue-600 to-purple-600 rounded-[3rem] p-12 shadow-2xl shadow-blue-200">
                            <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/20">
                                <i data-lucide="calendar-check-2" class="w-16 h-16 text-white mb-6"></i>
                                <p class="text-3xl font-black text-white mb-3">Book in 3 clicks.</p>
                                <p class="text-blue-100 text-lg">Average booking time is less than 45 seconds.</p>
                                
                                <div class="mt-8 bg-white/20 rounded-xl p-4">
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="text-white font-bold">Success Rate</span>
                                        <span class="text-white font-bold">99.4%</span>
                                    </div>
                                    <div class="h-2 bg-white/20 rounded-full overflow-hidden">
                                        <div class="h-full bg-white rounded-full w-[99.4%]"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Health Records -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-32">
                <div>
                    <div class="relative">
                        <div class="bg-gradient-to-br from-emerald-500 to-teal-600 rounded-[3rem] p-12 shadow-2xl shadow-emerald-200">
                            <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/20">
                                <i data-lucide="shield-check" class="w-16 h-16 text-white mb-6"></i>
                                <p class="text-3xl font-black text-white mb-3">All histories. One place.</p>
                                <p class="text-emerald-100 text-lg">Lab results, prescriptions, and imaging.</p>
                                
                                <div class="mt-8 space-y-3">
                                    <div class="bg-white/20 rounded-lg p-3 flex items-center gap-3">
                                        <i data-lucide="file-text" class="w-5 h-5 text-white"></i>
                                        <span class="text-white font-medium">Medical History</span>
                                    </div>
                                    <div class="bg-white/20 rounded-lg p-3 flex items-center gap-3">
                                        <i data-lucide="pill" class="w-5 h-5 text-white"></i>
                                        <span class="text-white font-medium">Prescriptions</span>
                                    </div>
                                    <div class="bg-white/20 rounded-lg p-3 flex items-center gap-3">
                                        <i data-lucide="scan" class="w-5 h-5 text-white"></i>
                                        <span class="text-white font-medium">Lab Results</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div>
                    <div class="inline-flex items-center gap-2 bg-emerald-50 text-emerald-600 rounded-full px-4 py-2 mb-6">
                        <i data-lucide="lock" class="w-4 h-4"></i>
                        <span class="text-sm font-bold uppercase tracking-wider">Your Data, Secure</span>
                    </div>
                    <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6 leading-tight">
                        Unified Health Records
                    </h2>
                    <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                        A single source of truth for your medical history. Accessible anywhere, secure everywhere.
                    </p>
                    
                    <div class="space-y-6">
                        <div class="flex gap-4">
                            <div class="flex-shrink-0 w-12 h-12 bg-emerald-100 rounded-xl flex items-center justify-center">
                                <i data-lucide="shield" class="w-6 h-6 text-emerald-600"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-900 text-lg mb-2">Bank-Grade Encryption</h3>
                                <p class="text-gray-600">AES-256 encryption ensures only you and your doctor see your data.</p>
                            </div>
                        </div>
                        
                        <div class="flex gap-4">
                            <div class="flex-shrink-0 w-12 h-12 bg-blue-100 rounded-xl flex items-center justify-center">
                                <i data-lucide="file-check" class="w-6 h-6 text-blue-600"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-900 text-lg mb-2">Universal Formats</h3>
                                <p class="text-gray-600">Compatible with FHIR standards for interoperability.</p>
                            </div>
                        </div>
                        
                        <div class="flex gap-4">
                            <div class="flex-shrink-0 w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center">
                                <i data-lucide="share-2" class="w-6 h-6 text-purple-600"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-900 text-lg mb-2">Consent Control</h3>
                                <p class="text-gray-600">Share records with a click, revoke access just as easily.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Video Consultation -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                <div class="order-2 lg:order-1">
                    <div class="inline-flex items-center gap-2 bg-purple-50 text-purple-600 rounded-full px-4 py-2 mb-6">
                        <i data-lucide="video" class="w-4 h-4"></i>
                        <span class="text-sm font-bold uppercase tracking-wider">Face-to-Face Care</span>
                    </div>
                    <h2 class="text-4xl md:text-5xl font-black text-gray-900 mb-6 leading-tight">
                        HD Video Consultation
                    </h2>
                    <p class="text-xl text-gray-600 mb-8 leading-relaxed">
                        Crystal-clear video calls with screen sharing for diagnosis walkthroughs. Feel like you're in the same room.
                    </p>
                    
                    <div class="space-y-6">
                        <div class="flex gap-4">
                            <div class="flex-shrink-0 w-12 h-12 bg-purple-100 rounded-xl flex items-center justify-center">
                                <i data-lucide="monitor" class="w-6 h-6 text-purple-600"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-900 text-lg mb-2">Screen Sharing</h3>
                                <p class="text-gray-600">Review X-rays, lab results, and reports together in real-time.</p>
                            </div>
                        </div>
                        
                        <div class="flex gap-4">
                            <div class="flex-shrink-0 w-12 h-12 bg-red-100 rounded-xl flex items-center justify-center">
                                <i data-lucide="mic" class="w-6 h-6 text-red-600"></i>
                            </div>
                            <div>
                                <h3 class="font-bold text-gray-900 text-lg mb-2">Auto Transcription</h3>
                                <p class="text-gray-600">Every consultation is transcribed and saved to your records.</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="order-1 lg:order-2">
                    <div class="relative">
                        <div class="bg-gradient-to-br from-purple-600 to-pink-600 rounded-[3rem] p-12 shadow-2xl shadow-purple-200">
                            <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-8 border border-white/20">
                                <i data-lucide="video" class="w-16 h-16 text-white mb-6"></i>
                                <p class="text-3xl font-black text-white mb-3">HD Quality. Zero Lag.</p>
                                <p class="text-purple-100 text-lg">Powered by WebRTC technology.</p>
                                
                                <div class="mt-8 grid grid-cols-2 gap-4">
                                    <div class="bg-white/20 rounded-xl p-4 text-center">
                                        <p class="text-3xl font-black text-white">1080p</p>
                                        <p class="text-purple-100 text-sm">Video Quality</p>
                                    </div>
                                    <div class="bg-white/20 rounded-xl p-4 text-center">
                                        <p class="text-3xl font-black text-white">< 50ms</p>
                                        <p class="text-purple-100 text-sm">Latency</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- CTA Section -->
    <section class="py-32 px-6 bg-gradient-to-br from-blue-600 to-purple-600 relative overflow-hidden">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
        <div class="max-w-4xl mx-auto text-center relative z-10">
            <h2 class="text-4xl md:text-6xl font-black text-white mb-6 leading-tight">
                Ready to experience the future of healthcare?
            </h2>
            <p class="text-xl text-blue-100 mb-12">
                Join thousands of patients who've already made the switch.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-4">
                <a href="/" class="px-8 py-4 bg-white text-blue-600 rounded-2xl font-bold text-lg shadow-xl hover:scale-105 transition-all duration-300">
                    Get Started Free
                </a>
                <a href="#features" class="px-8 py-4 bg-white/10 backdrop-blur-sm text-white rounded-2xl font-bold text-lg border-2 border-white/20 hover:bg-white/20 transition-all duration-300">
                    Watch Demo
                </a>
            </div>
        </div>
    </section>
</div>

<style>
    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(40px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in-up {
        animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-20px); }
    }
    .animate-float {
        animation: float 3s ease-in-out infinite;
    }
</style>

<script>
    lucide.createIcons();
</script>
