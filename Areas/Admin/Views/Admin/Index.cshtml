@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        $(document).ready(function() {
            // Count animation
            $('.counter').each(function() {
                var $this = $(this);
                var target = parseInt($this.data('target'));
                var current = 0;
                var duration = 1500;
                var increment = target / (duration / 16);
                var timer = setInterval(function() {
                    current += increment;
                    if (current >= target) {
                        $this.text(target.toLocaleString());
                        clearInterval(timer);
                    } else {
                        $this.text(Math.floor(current).toLocaleString());
                    }
                }, 16);
            });
            // ApexCharts Optimization
            var options = {
                series: [{
                    name: 'Appointments',
                    data: @Html.Raw(Json.Serialize(ViewBag.ChartAppointments))
                }, {
                    name: 'Billing Invoices',
                    data: @Html.Raw(Json.Serialize(ViewBag.ChartBillings))
                }, {
                    name: 'New Admissions',
                    data: @Html.Raw(Json.Serialize(ViewBag.ChartPatients))
                }, {
                    name: 'Clinical Activity',
                    data: @Html.Raw(Json.Serialize(ViewBag.ChartRecords))
                }],
                chart: {
                    height: '100%',
                    width: '100%',
                    type: 'area',
                    toolbar: { show: false },
                    sparkline: { enabled: false },
                    zoom: { enabled: false },
                    animations: {
                        enabled: true,
                        easing: 'easeinout',
                        speed: 800,
                        animateOnRender: true
                    },
                    fontFamily: 'Outfit, sans-serif'
                },
                dataLabels: { enabled: false },
                stroke: {
                    curve: 'smooth',
                    width: 3,
                    colors: ['#3b82f6', '#10b981', '#8b5cf6', '#f59e0b']
                },
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.45,
                        opacityTo: 0.05,
                        stops: [20, 100, 100, 100]
                    }
                },
                grid: {
                    borderColor: '#f1f5f9',
                    strokeDashArray: 4,
                    yaxis: { lines: { show: true } },
                    padding: { top: 0, right: 10, bottom: 0, left: 10 }
                },
                xaxis: {
                    categories: @Html.Raw(Json.Serialize(ViewBag.ChartLabels)),
                    axisBorder: { show: false },
                    axisTicks: { show: false },
                    tooltip: { enabled: false },
                    labels: {
                        rotate: -45,
                        rotateAlways: false,
                        hideOverlappingLabels: true,
                        style: {
                            colors: '#94a3b8',
                            fontSize: '10px',
                            fontWeight: 600
                        }
                    }
                },
                yaxis: {
                    labels: {
                        style: {
                            colors: '#94a3b8',
                            fontSize: '11px',
                            fontWeight: 800
                        }
                    }
                },
                tooltip: {
                    theme: 'dark',
                    x: { show: true },
                    style: { fontSize: '12px' },
                    marker: { show: false }
                },
                colors: ['#3b82f6', '#10b981', '#8b5cf6', '#f59e0b'],
                legend: { 
                    show: true,
                    position: 'top',
                    horizontalAlign: 'right',
                    offsetY: -20,
                    itemMargin: { horizontal: 10, vertical: 0 }
                },
                responsive: [{
                    breakpoint: 480,
                    options: {
                        chart: { height: 250 },
                        xaxis: {
                            labels: {
                                style: { fontSize: '8px' }
                            }
                        },
                        yaxis: {
                            labels: {
                                style: { fontSize: '8px' }
                            }
                        }
                    }
                }]
            };
            var chart = new ApexCharts(document.querySelector("#performanceChart"), options);
            chart.render();
            // Chart Switching Logic
            $('.chart-filter-btn').on('click', function() {
                $('.chart-filter-btn').removeClass('bg-white shadow-lg text-slate-900').addClass('text-slate-400');
                $(this).addClass('bg-white shadow-lg text-slate-900').removeClass('text-slate-400');
                if (this.id === 'btnChart30D') {
                    // Dynamic 30 days data
                    chart.updateSeries([{
                        name: 'Appointments',
                        data: @Html.Raw(Json.Serialize(ViewBag.ChartAppointments30))
                    }, {
                        name: 'Billing Invoices',
                        data: @Html.Raw(Json.Serialize(ViewBag.ChartBillings30))
                    }, {
                        name: 'New Admissions',
                        data: @Html.Raw(Json.Serialize(ViewBag.ChartPatients30))
                    }, {
                        name: 'Clinical Activity',
                        data: @Html.Raw(Json.Serialize(ViewBag.ChartRecords30))
                    }]);
                    chart.updateOptions({
                        xaxis: {
                            categories: @Html.Raw(Json.Serialize(ViewBag.ChartLabels30))
                        }
                    });
                } else {
                    // Restore 7 days data
                    chart.updateSeries([{
                        name: 'Appointments',
                        data: @Html.Raw(Json.Serialize(ViewBag.ChartAppointments))
                    }, {
                        name: 'Billing Invoices',
                        data: @Html.Raw(Json.Serialize(ViewBag.ChartBillings))
                    }, {
                        name: 'New Admissions',
                        data: @Html.Raw(Json.Serialize(ViewBag.ChartPatients))
                    }, {
                        name: 'Clinical Activity',
                        data: @Html.Raw(Json.Serialize(ViewBag.ChartRecords))
                    }]);
                    chart.updateOptions({
                        xaxis: {
                            categories: @Html.Raw(Json.Serialize(ViewBag.ChartLabels))
                        }
                    });
                }
            });
            // Button Event Listeners
            
            $('#scrollLeft').on('click', function() {
                const carousel = document.getElementById('doctorsCarousel');
                const scrollAmount = 350;
                const maxScroll = carousel.scrollWidth - carousel.clientWidth;
                
                if (carousel.scrollLeft <= 0) {
                    carousel.scrollTo({ left: maxScroll, behavior: 'smooth' });
                } else {
                    carousel.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
                }
            });
            
            $('#scrollRight').on('click', function() {
                const carousel = document.getElementById('doctorsCarousel');
                const scrollAmount = 350;
                const maxScroll = carousel.scrollWidth - carousel.clientWidth;
                
                if (carousel.scrollLeft >= maxScroll - 10) {
                    carousel.scrollTo({ left: 0, behavior: 'smooth' });
                } else {
                    carousel.scrollBy({ left: scrollAmount, behavior: 'smooth' });
                }
            });
            
            $('#btnManageQueue').on('click', function() {
                alert('Triage Management Console active. Updating global priority list.');
            });
        });
    </script>
}
