@using Microsoft.AspNetCore.Identity
@inject UserManager<MedLinkPortal.Areas.Identity.Pages.Account.ApplicationUser> UserManager
@{
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
    ViewData["Title"] = "VIP Support Channel";
    var adminId = ViewBag.AdminSupportId;
    var adminName = ViewBag.AdminSupportName;
}

<div class="chat-container premium-card flex overflow-hidden reveal bg-white/50 backdrop-blur-xl h-[calc(100vh-140px)] relative">
    <!-- VIP Support Header & Context (Sidebar) -->
    <div class="w-full md:w-96 flex-shrink-0 border-r border-slate-100 dark:border-white/5 flex flex-col bg-slate-50/50 dark:bg-white/5 p-8">
        <div class="mb-10">
            <div class="w-16 h-16 bg-gradient-to-br from-emerald-500 to-teal-600 rounded-3xl flex items-center justify-center text-white text-2xl mb-6 shadow-xl shadow-emerald-500/20">
                <i class="fas fa-crown"></i>
            </div>
            <h2 class="text-2xl font-semibold text-slate-900 dark:text-white tracking-tight leading-tight">Priority Neural Support</h2>
            <p class="text-[10px] font-semibold text-emerald-500 uppercase tracking-[0.2em] mt-2">Active Protocol: VIP-L7</p>
        </div>

        <div class="space-y-6 flex-grow">
            <div class="p-6 bg-white dark:bg-white/5 rounded-3xl border border-slate-100 dark:border-white/5 shadow-sm">
                <h4 class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-4">Support Node</h4>
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-slate-100 dark:bg-white/10 rounded-2xl flex items-center justify-center text-slate-600 dark:text-slate-300 font-semibold">
                        @adminName.Substring(0, 1).ToUpper()
                    </div>
                    <div>
                        <h5 class="text-sm font-semibold text-slate-900 dark:text-white truncate">@adminName</h5>
                        <div class="flex items-center gap-1.5 mt-1">
                            <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
                            <span class="text-[9px] font-bold text-emerald-500 uppercase tracking-widest">Linked</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-6 bg-blue-600/5 dark:bg-blue-600/10 rounded-3xl border border-blue-600/10">
                <h4 class="text-[10px] font-semibold text-blue-600 uppercase tracking-widest mb-3">Service Level</h4>
                <p class="text-[11px] font-bold text-slate-600 dark:text-slate-400 leading-relaxed">
                    You have unlocked <span class="text-blue-600 font-semibold">24/7 Priority Access</span>. Our clinical engineers are standing by for technical or diagnostic escalation.
                </p>
            </div>
        </div>

        <div class="pt-8 border-t border-slate-100 dark:border-white/5">
            <a asp-action="DoctorDashBoard" class="flex items-center gap-3 text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all group">
                <div class="w-8 h-8 rounded-xl bg-slate-100 dark:bg-white/5 flex items-center justify-center group-hover:bg-slate-200 dark:group-hover:bg-white/10 transition-all">
                    <i class="fas fa-arrow-left text-[10px]"></i>
                </div>
                <span class="text-[10px] font-semibold uppercase tracking-widest">Return to Base</span>
            </a>
        </div>
    </div>

    <!-- Communication Hub (Main Area) -->
    <div class="flex-grow flex flex-col bg-white dark:bg-slate-900/50 relative">
        <!-- Hub Header -->
        <div class="px-8 py-5 border-b border-slate-100 dark:border-white/5 flex items-center justify-between bg-white/80 backdrop-blur-md z-10 sticky top-0">
            <div class="flex items-center gap-4">
                <div class="relative">
                    <div class="w-12 h-12 bg-blue-600 rounded-2xl flex items-center justify-center text-white font-semibold text-lg shadow-xl shadow-blue-500/20">
                        @adminName.Substring(0, 1).ToUpper()
                    </div>
                    <div class="absolute -bottom-1 -right-1 w-4 h-4 bg-emerald-500 border-2 border-white dark:border-slate-900 rounded-full shadow-lg"></div>
                </div>
                <div>
                    <h3 class="text-lg font-semibold text-slate-900 dark:text-white tracking-tight leading-none">@adminName</h3>
                    <p class="text-[9px] font-semibold text-emerald-500 uppercase tracking-widest mt-2">Encrypted Clinical Channel</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <button onclick="PremiumModal.alert('Diagnostic screening is active for this session.', 'Neural Guard')" class="w-11 h-11 flex items-center justify-center bg-slate-50 dark:bg-white/5 text-slate-400 hover:text-blue-500 rounded-xl transition-all" title="Security Protocol">
                    <i class="fas fa-shield-halved text-xs"></i>
                </button>
            </div>
        </div>

        <!-- Data Stream -->
        <div id="messagesArea" class="flex-grow p-8 overflow-y-auto flex flex-col gap-6 custom-scrollbar">
            <div id="messagesList" class="flex flex-col gap-6 flex-grow">
                <!-- Messages will be injected here -->
                <div class="flex-grow flex items-center justify-center flex-col opacity-20">
                    <div class="w-24 h-24 bg-slate-100 dark:bg-white/5 rounded-[40px] flex items-center justify-center mb-8">
                        <i class="fas fa-tower-broadcast text-4xl text-slate-400"></i>
                    </div>
                    <h4 class="text-xl font-semibold text-slate-900 dark:text-white uppercase tracking-widest">Initializing Link</h4>
                </div>
            </div>
            
            <div id="typingIndicator" class="flex items-center gap-2 mb-4 hidden shrink-0">
                <div class="bg-slate-100 dark:bg-white/10 px-4 py-3 rounded-full rounded-tl-none flex items-center gap-1.5 ">
                     <div class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0ms"></div>
                     <div class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 150ms"></div>
                     <div class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 300ms"></div>
                </div>
                <span class="text-[9px] font-semibold text-slate-300 uppercase tracking-widest animate-pulse">Typing...</span>
            </div>
        </div>

        <!-- Input Terminal -->
        <div class="p-8 bg-white/50 backdrop-blur-md">
            <form id="chatForm" onsubmit="event.preventDefault(); sendMessage();" class="flex items-center gap-4 p-3 bg-slate-50 dark:bg-white/5 rounded-[32px] border border-transparent focus-within:border-blue-500/30 transition-all shadow-inner">
                <div class="flex gap-2 ml-2">
                    <label class="cursor-pointer w-10 h-10 flex items-center justify-center text-slate-400 hover:text-blue-500 hover:bg-white dark:hover:bg-white/10 rounded-xl transition-all">
                        <i class="fas fa-image text-sm"></i>
                        <input type="file" id="imageInput" class="hidden" accept="image/*" onchange="handleImageSelect()">
                    </label>
                    <label class="cursor-pointer w-10 h-10 flex items-center justify-center text-slate-400 hover:text-blue-500 hover:bg-white dark:hover:bg-white/10 rounded-xl transition-all">
                        <i class="fas fa-paperclip text-sm"></i>
                        <input type="file" id="fileInput" class="hidden" onchange="handleFileSelect()">
                    </label>
                </div>
                <div class="flex-grow">
                    <input type="text" id="messageInput" placeholder="Enter clinical signal..." class="w-full bg-transparent border-none text-sm font-bold text-slate-800 dark:text-white placeholder-slate-400 p-0 focus:ring-0">
                </div>
                <button type="submit" class="w-12 h-12 bg-blue-600 text-white rounded-2xl flex items-center justify-center hover:bg-blue-700 transition-all shadow-xl shadow-blue-500/30 active:scale-90">
                    <i class="fas fa-location-arrow text-sm"></i>
                </button>
            </form>
            
            <div id="attachmentPreview" class="mt-4 hidden flex items-center gap-3 p-3 bg-blue-500/10 border border-blue-500/20 rounded-2xl">
                <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white text-[10px]">
                     <i class="fas fa-file"></i>
                </div>
                <span id="fileName" class="text-[11px] font-semibold text-blue-600 uppercase tracking-tight truncate max-w-[200px]">file.pdf</span>
                <button onclick="clearAttachment()" class="w-6 h-6 rounded-full bg-blue-100 text-blue-600 hover:bg-red-500 hover:text-white transition-all ml-auto">
                    <i class="fas fa-times text-[10px]"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script>
        const activeRecipientId = '@adminId';
        const currentUserId = '@UserManager.GetUserId(User)';
        let connection = null;

        document.addEventListener("DOMContentLoaded", function() {
            // Initialize SignalR
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            connection.on("ReceiveMessage", (senderName, message, type, url, name, actualSenderId) => {
                 if (actualSenderId === currentUserId) return; // Prevent duplication

                 if (actualSenderId === activeRecipientId) {
                     appendMessage({
                         content: message,
                         isMe: false,
                         senderId: actualSenderId,
                         messageType: type === 'Call' ? 'Call' : 'Text',
                         timestamp: new Date().toISOString(),
                         attachmentPath: url,
                         attachmentType: type === 'image' || type === 'file' ? type : (url && type !== 'Call' ? (type.toLowerCase().startsWith('image') ? 'image' : 'file') : null)
                     });
                     markAsRead();
                 }
            });

            connection.on("UserIsTyping", (senderId) => {
                if (senderId === activeRecipientId) {
                    document.getElementById('typingIndicator').classList.remove('hidden');
                    const area = document.getElementById('messagesArea');
                    area.scrollTop = area.scrollHeight;
                }
            });

            connection.on("UserStoppedTyping", (senderId) => {
                if (senderId === activeRecipientId) {
                    document.getElementById('typingIndicator').classList.add('hidden');
                }
            });

            connection.on("MessagesRead", (readerId) => {
                if (readerId === activeRecipientId) {
                    document.querySelectorAll('.message-tick').forEach(icon => {
                        icon.className = "fas fa-check-double text-[10px] text-blue-500 message-tick animate-in zoom-in duration-300";
                    });
                }
            });

            connection.start().then(() => {
                console.log("VIP Support Connected");
                fetchMessages();
                markAsRead();
            }).catch(err => console.error(err));

            // Typing Indicator Logic
            let typingTimeout = null;
            const messageInput = document.getElementById('messageInput');
            messageInput.addEventListener('keydown', () => {
                if (!typingTimeout) {
                    connection.invoke("UserTyping", activeRecipientId).catch(err => console.error(err));
                }
                if (typingTimeout) clearTimeout(typingTimeout);
                typingTimeout = setTimeout(() => {
                    connection.invoke("UserStoppedTyping", activeRecipientId).catch(err => console.error(err));
                    typingTimeout = null;
                }, 2000);
            });
        });

        async function fetchMessages() {
            try {
                const response = await fetch(`/Doctor/Chat/GetMessages?otherUserId=${activeRecipientId}`);
                const messages = await response.json();
                renderMessages(messages);
            } catch (error) { console.error('Error fetching messages:', error); }
        }

        function renderMessages(messages) {
            const list = document.getElementById('messagesList');
            const area = document.getElementById('messagesArea');
            list.innerHTML = '';
            
            if (messages.length === 0) {
                list.innerHTML = `<div class="flex-grow flex items-center justify-center text-gray-400 flex-col opacity-50"><p>Clinical channel established. Awaiting initial contact.</p></div>`;
                return;
            }

            messages.forEach(msg => appendMessage(msg));
            area.scrollTop = area.scrollHeight;
        }

        function appendMessage(msg) {
            const list = document.getElementById('messagesList');
            const area = document.getElementById('messagesArea');
            const empty = list.querySelector('.opacity-50');
            if (empty) list.innerHTML = '';

            const div = document.createElement('div');
            const isMe = msg.senderId === currentUserId || msg.isMe;
            
            div.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'} group w-full animate-in slide-in-from-bottom-2`;
            
            let attachmentHtml = '';
            if (msg.attachmentPath) {
                const aType = (msg.attachmentType || '').toLowerCase();
                attachmentHtml = aType === 'image' 
                    ? `<img src="${msg.attachmentPath}" class="rounded-2xl mb-3 max-w-full lg:max-w-md border shadow-sm">`
                    : `<div class="p-3 bg-black/5 rounded-xl mb-3 text-xs font-semibold">Linked File: ${msg.attachmentName || 'Attachment'}</div>`;
            }

            const time = new Date(msg.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            let tickIcon = isMe ? `<i class="fas ${msg.isRead ? 'fa-check-double text-blue-500' : 'fa-check text-slate-300'} text-[10px] message-tick"></i>` : '';

            div.innerHTML = `
                <div class="flex flex-col max-w-[80%] ${isMe ? 'items-end' : 'items-start'}">
                    ${attachmentHtml}
                    ${(msg.content && msg.content !== 'null' && msg.content !== '') ? `
                    <div class="px-5 py-3 rounded-[1.5rem] text-sm font-bold shadow-sm ${isMe ? 'bg-blue-600 text-white rounded-tr-none' : 'bg-slate-50 dark:bg-white/5 text-slate-800 dark:text-white rounded-tl-none'}">
                        ${msg.content}
                    </div>
                    ` : ''}
                    <div class="flex items-center gap-1 mt-1">
                         <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest">${time}</span>
                         ${tickIcon}
                    </div>
                </div>
            `;
            list.appendChild(div);
            area.scrollTop = area.scrollHeight;
        }

        async function sendMessage() {
            const input = document.getElementById('messageInput');
            const fileInput = document.getElementById('fileInput');
            const imageInput = document.getElementById('imageInput');
            
            const content = input.value.trim();
            const file = fileInput.files[0] || imageInput.files[0];
            
            if (!content && !file) return;

            const formData = new FormData();
            formData.append('receiverId', activeRecipientId);
            formData.append('content', content);
            if (file) formData.append('attachment', file);

            input.value = '';
            const tempFileUrl = file ? URL.createObjectURL(file) : null;
            appendMessage({
                content: content,
                isMe: true,
                timestamp: new Date().toISOString(),
                attachmentPath: tempFileUrl,
                attachmentType: file ? (file.type.startsWith('image/') ? 'image' : 'file') : null,
                attachmentName: file?.name
            });

            clearAttachment();
            
            try {
                await fetch('/Doctor/Chat/SendMessage', { method: 'POST', body: formData });
            } catch (error) { console.error('Error sending message:', error); }
        }

        function handleFileSelect() {
            const file = document.getElementById('fileInput').files[0];
            if (file) { document.getElementById('imageInput').value = ''; showPreview(file.name); }
        }

        function handleImageSelect() {
            const file = document.getElementById('imageInput').files[0];
            if (file) { document.getElementById('fileInput').value = ''; showPreview(file.name); }
        }

        function showPreview(name) {
            document.getElementById('attachmentPreview').classList.remove('hidden');
            document.getElementById('fileName').textContent = name;
        }

        function clearAttachment() {
            document.getElementById('fileInput').value = '';
            document.getElementById('imageInput').value = '';
            document.getElementById('attachmentPreview').classList.add('hidden');
        }

        function markAsRead() {
            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                 connection.invoke("MarkMessagesAsRead", activeRecipientId).catch(err => console.error(err));
            }
        }
    </script>
}

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #E2E8F0; border-radius: 10px; }
</style>
