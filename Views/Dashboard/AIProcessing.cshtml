@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "AI Neural Processing";
}

<div class="min-h-[70vh] flex flex-col items-center justify-center p-4">
    <div class="max-w-2xl w-full bg-white/60 backdrop-blur-2xl rounded-[3rem] p-8 md:p-12 border border-white shadow-2xl relative overflow-hidden">
        
        <!-- Animated Background Elements -->
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl animate-pulse"></div>
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>

        <div class="relative z-10 text-center">
            <!-- Neural Scanner Animation -->
            <div class="mb-12 relative flex justify-center">
                <div class="w-32 h-32 bg-slate-900 rounded-[2.5rem] flex items-center justify-center shadow-2xl relative group overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-tr from-blue-600 to-indigo-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                    <i data-lucide="brain" class="w-16 h-16 text-white relative z-10 animate-pulse"></i>
                    
                    <!-- Scanning Bar -->
                    <div class="absolute top-0 left-0 w-full h-1 bg-blue-400/50 shadow-[0_0_15px_rgba(96,165,250,0.8)] animate-scan"></div>
                </div>
                
                <!-- Orbiting Dots -->
                <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                    <div class="w-48 h-48 border border-dashed border-blue-200 rounded-full animate-spin-slow"></div>
                    <div class="absolute w-2 h-2 bg-blue-500 rounded-full offset-circle"></div>
                </div>
            </div>

            <h2 class="text-3xl font-semibold text-slate-900 tracking-tight mb-2">Neural Engine <span class="text-blue-600">Active</span></h2>
            <p class="text-slate-500 font-bold text-sm tracking-widest uppercase mb-12">Core V2.4 Deep Learning Suite</p>

            <!-- Sequential Steps Container -->
            <div id="processing-steps" class="space-y-4 text-left max-w-md mx-auto">
                <div class="step flex items-center gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100 transition-all duration-500 opacity-0 transform translate-y-4" id="step-1">
                    <div class="status-icon w-8 h-8 rounded-lg flex items-center justify-center text-blue-600 bg-blue-50">
                        <i data-lucide="heart-pulse" class="w-4 h-4"></i>
                    </div>
                    <span class="text-sm font-bold text-slate-700">Collecting and validating patient vitals...</span>
                    <div class="ml-auto loading-spinner"></div>
                </div>

                <div class="step flex items-center gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100 transition-all duration-500 opacity-0 transform translate-y-4" id="step-2">
                    <div class="status-icon w-8 h-8 rounded-lg flex items-center justify-center text-blue-600 bg-blue-50">
                        <i data-lucide="activity" class="w-4 h-4"></i>
                    </div>
                    <span class="text-sm font-bold text-slate-700">Comparing values with medical standard ranges...</span>
                    <div class="ml-auto loading-spinner hidden"></div>
                </div>

                <div class="step flex items-center gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100 transition-all duration-500 opacity-0 transform translate-y-4" id="step-3">
                    <div class="status-icon w-8 h-8 rounded-lg flex items-center justify-center text-blue-600 bg-blue-50">
                        <i data-lucide="percent" class="w-4 h-4"></i>
                    </div>
                    <span class="text-sm font-bold text-slate-700">Assigning stability percentage to each vital...</span>
                    <div class="ml-auto loading-spinner hidden"></div>
                </div>

                <div class="step flex items-center gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100 transition-all duration-500 opacity-0 transform translate-y-4" id="step-4">
                    <div class="status-icon w-8 h-8 rounded-lg flex items-center justify-center text-blue-600 bg-blue-50">
                        <i data-lucide="calculator" class="w-4 h-4"></i>
                    </div>
                    <span class="text-sm font-bold text-slate-700">Calculating overall health score using weighted algorithm...</span>
                    <div class="ml-auto loading-spinner hidden"></div>
                </div>

                <div class="step flex items-center gap-4 p-4 rounded-2xl bg-slate-50 border border-slate-100 transition-all duration-500 opacity-0 transform translate-y-4" id="step-5">
                    <div class="status-icon w-8 h-8 rounded-lg flex items-center justify-center text-blue-600 bg-blue-50">
                        <i data-lucide="sparkles" class="w-4 h-4"></i>
                    </div>
                    <span class="text-sm font-bold text-slate-700">Generating AI medical reasoning and recommendations...</span>
                    <div class="ml-auto loading-spinner hidden"></div>
                </div>

                <div class="step flex items-center gap-4 p-4 rounded-2xl bg-emerald-50 border border-emerald-100 transition-all duration-500 opacity-0 transform translate-y-4" id="step-6">
                    <div class="status-icon w-8 h-8 rounded-lg flex items-center justify-center text-emerald-600 bg-emerald-100">
                        <i data-lucide="check-circle" class="w-4 h-4"></i>
                    </div>
                    <span class="text-sm font-semibold text-emerald-700">AI Analysis Complete!</span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    @@keyframes scan {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(128px); }
    }
    .animate-scan {
        animation: scan 2s ease-in-out infinite;
    }
    .animate-spin-slow {
        animation: spin 10s linear infinite;
    }
    .loading-spinner {
        width: 16px;
        height: 16px;
        border: 2px solid #e2e8f0;
        border-top-color: #3b82f6;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }
    .status-completed {
        background-color: #f0fdf4 !important;
        border-color: #dcfce7 !important;
    }
    .status-completed .status-icon {
        background-color: #dcfce7 !important;
        color: #16a34a !important;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', async () => {
        // Fallback redirect to ensure user is never stuck
        setTimeout(() => {
            window.location.href = '@Url.Action("AIAnalysis", "Dashboard")';
        }, 12000); // 12 seconds max wait (animation is ~10s)

        const steps = [
            { id: 'step-1', duration: 1500 },
            { id: 'step-2', duration: 1800 },
            { id: 'step-3', duration: 1200 },
            { id: 'step-4', duration: 1600 },
            { id: 'step-5', duration: 2000 },
            { id: 'step-6', duration: 1000 }
        ];

        const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

        try {
            for (let i = 0; i < steps.length; i++) {
                const stepEl = document.getElementById(steps[i].id);
                if (!stepEl) continue;
                
                // Show step
                stepEl.classList.remove('opacity-0', 'translate-y-4');
                
                if (i < steps.length - 1) {
                    // Show spinner for active step
                    const spinner = stepEl.querySelector('.loading-spinner');
                    if (spinner) spinner.classList.remove('hidden');
                    
                    await sleep(steps[i].duration);
                    
                    // Mark as completed
                    if (spinner) spinner.classList.add('hidden');
                    stepEl.classList.add('status-completed');
                    
                    // Update icon safely (handle case where <i> is replaced by <svg>)
                    const iconContainer = stepEl.querySelector('.status-icon');
                    if (iconContainer) {
                        iconContainer.innerHTML = '<i data-lucide="check-circle" class="w-4 h-4"></i>';
                        if (window.lucide && window.lucide.createIcons) {
                            window.lucide.createIcons({
                                root: iconContainer
                            });
                        }
                    }
                } else {
                    // Last step complete
                    await sleep(steps[i].duration);
                }
            }
        } catch (error) {
            console.error("Animation error:", error);
        }

        // Redirect to results
        window.location.href = '@Url.Action("AIAnalysis", "Dashboard")';
    });
</script>
