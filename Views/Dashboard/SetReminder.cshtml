@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Set Reminder";
    ViewData["HeaderTitle"] = "Health Reminders";
    ViewData["HeaderSubtitle"] = "Stay on track with personalized health reminders";
    var activeReminders = ViewBag.ActiveReminders as List<MedLinkPortal.Models.ReminderViewModel> ?? new List<MedLinkPortal.Models.ReminderViewModel>();
}

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Create Reminder Form -->
    <div class="lg:col-span-2">
        <div class="bg-white rounded-[3rem] p-10 border border-slate-100 shadow-xl">
            <div class="flex items-center gap-4 mb-8">
                <div class="w-14 h-14 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600">
                    <i data-lucide="bell-plus" class="w-7 h-7"></i>
                </div>
                <div>
                    <h2 class="text-3xl font-semibold text-slate-900">Create Reminder</h2>
                    <p class="text-sm text-slate-500 font-medium">Set a new health reminder</p>
                </div>
            </div>

            <form asp-action="CreateReminder" method="post" class="space-y-6">
                <!-- Title -->
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-2">Reminder Title</label>
                    <input type="text" name="Title" required
                           class="w-full px-6 py-4 rounded-2xl border-2 border-slate-200 focus:border-blue-500 focus:outline-none transition-colors text-slate-900 font-medium"
                           placeholder="e.g., Morning Exercise">
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-sm font-bold text-slate-700 mb-2">Description</label>
                    <textarea name="Description" rows="3"
                              class="w-full px-6 py-4 rounded-2xl border-2 border-slate-200 focus:border-blue-500 focus:outline-none transition-colors text-slate-900 font-medium resize-none"
                              placeholder="Add details about this reminder..."></textarea>
                </div>

                <!-- Type and Date/Time Row -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Reminder Type -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Type</label>
                        <select name="ReminderType" required
                                class="w-full px-6 py-4 rounded-2xl border-2 border-slate-200 focus:border-blue-500 focus:outline-none transition-colors text-slate-900 font-medium">
                            <option value="Exercise">🏃 Exercise</option>
                            <option value="Medication">💊 Medication</option>
                            <option value="Appointment">📅 Appointment</option>
                            <option value="Hydration">💧 Hydration</option>
                            <option value="Sleep">😴 Sleep</option>
                            <option value="Custom">✨ Custom</option>
                        </select>
                    </div>

                    <!-- Scheduled Time -->
                    <div>
                        <label class="block text-sm font-bold text-slate-700 mb-2">Date & Time</label>
                        <input type="datetime-local" name="ScheduledTime" required
                               class="w-full px-6 py-4 rounded-2xl border-2 border-slate-200 focus:border-blue-500 focus:outline-none transition-colors text-slate-900 font-medium">
                    </div>
                </div>

                <!-- Recurrence -->
                <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
                    <div class="flex items-center justify-between mb-4">
                        <label class="text-sm font-bold text-slate-700">Recurring Reminder</label>
                        <input type="checkbox" id="isRecurring" name="IsRecurring" value="true"
                               class="w-6 h-6 rounded-lg border-2 border-slate-300 text-blue-600 focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div id="recurrenceOptions" class="hidden">
                        <select name="RecurrencePattern"
                                class="w-full px-6 py-4 rounded-2xl border-2 border-slate-200 focus:border-blue-500 focus:outline-none transition-colors text-slate-900 font-medium">
                            <option value="">Select frequency...</option>
                            <option value="Daily">Daily</option>
                            <option value="Weekly">Weekly</option>
                            <option value="Monthly">Monthly</option>
                        </select>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit"
                        class="w-full py-5 bg-gradient-to-r from-blue-600 to-indigo-600 text-white rounded-2xl font-semibold text-sm uppercase tracking-[0.2em] shadow-xl hover:shadow-2xl hover:scale-[1.02] transition-all flex items-center justify-center gap-3">
                    <i data-lucide="check-circle" class="w-5 h-5"></i>
                    Create Reminder
                </button>
            </form>
        </div>
    </div>

    <!-- Active Reminders List -->
    <div class="lg:col-span-1">
        <div class="bg-white rounded-[3rem] p-8 border border-slate-100 shadow-xl sticky top-8">
            <div class="flex items-center justify-between mb-6">
                <h3 class="text-xl font-semibold text-slate-900">Active Reminders</h3>
                <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-semibold">@activeReminders.Count</span>
            </div>

            @if (activeReminders.Any())
            {
                <div class="space-y-4 max-h-[600px] overflow-y-auto pr-2">
                    @foreach (var reminder in activeReminders)
                    {
                        <div class="p-5 rounded-2xl @(reminder.ReminderType == "Exercise" ? "bg-emerald-50 border border-emerald-100" : reminder.ReminderType == "Medication" ? "bg-purple-50 border border-purple-100" : reminder.ReminderType == "Appointment" ? "bg-blue-50 border border-blue-100" : "bg-slate-50 border border-slate-100") group hover:shadow-lg transition-all">
                            <div class="flex items-start justify-between mb-3">
                                <div class="flex-1">
                                    <h4 class="font-semibold text-sm text-slate-900 mb-1">@reminder.Title</h4>
                                    @if (!string.IsNullOrEmpty(reminder.Description))
                                    {
                                        <p class="text-xs text-slate-600 font-medium mb-2">@reminder.Description</p>
                                    }
                                    <div class="flex items-center gap-2 text-xs">
                                        <span class="px-2 py-1 rounded-lg @(reminder.ReminderType == "Exercise" ? "bg-emerald-100 text-emerald-700" : reminder.ReminderType == "Medication" ? "bg-purple-100 text-purple-700" : reminder.ReminderType == "Appointment" ? "bg-blue-100 text-blue-700" : "bg-slate-100 text-slate-700") font-bold">
                                            @reminder.ReminderType
                                        </span>
                                        @if (reminder.IsRecurring)
                                        {
                                            <span class="px-2 py-1 rounded-lg bg-amber-100 text-amber-700 font-bold">
                                                <i data-lucide="repeat" class="w-3 h-3 inline-block"></i> @reminder.RecurrencePattern
                                            </span>
                                        }
                                    </div>
                                </div>
                                <span class="text-xs font-semibold text-slate-500 ml-2">@reminder.TimeUntil</span>
                            </div>
                            <div class="flex items-center gap-2 pt-3 border-t border-slate-200">
                                <p class="text-[10px] font-bold text-slate-500 flex-1">
                                    <i data-lucide="clock" class="w-3 h-3 inline-block"></i> @reminder.FormattedTime
                                </p>
                                <form asp-action="CompleteReminder" method="post" class="inline">
                                    <input type="hidden" name="id" value="@reminder.Id" />
                                    <button type="submit" class="p-2 rounded-lg bg-white hover:bg-emerald-100 text-emerald-600 transition-colors" title="Complete">
                                        <i data-lucide="check" class="w-4 h-4"></i>
                                    </button>
                                </form>
                                <form asp-action="DeleteReminder" method="post" class="inline">
                                    <input type="hidden" name="id" value="@reminder.Id" />
                                    <button type="submit" class="p-2 rounded-lg bg-white hover:bg-rose-100 text-rose-600 transition-colors" title="Delete">
                                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-12">
                    <div class="w-20 h-20 rounded-full bg-slate-100 flex items-center justify-center mx-auto mb-4">
                        <i data-lucide="bell-off" class="w-10 h-10 text-slate-400"></i>
                    </div>
                    <p class="text-sm font-bold text-slate-500">No active reminders</p>
                    <p class="text-xs text-slate-400 mt-1">Create your first reminder to get started</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        lucide.createIcons();

        // Toggle recurrence options
        document.getElementById('isRecurring').addEventListener('change', function() {
            const recurrenceOptions = document.getElementById('recurrenceOptions');
            if (this.checked) {
                recurrenceOptions.classList.remove('hidden');
            } else {
                recurrenceOptions.classList.add('hidden');
            }
        });
    </script>
}
