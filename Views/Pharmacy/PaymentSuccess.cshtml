@model MedLinkPortal.Models.PharmacyOrder
@{
    ViewData["Title"] = "Payment Successful";
    Layout = null;
    bool isOnline = Model.PaymentMethod == MedLinkPortal.Models.PaymentMethod.OnlinePayment;

    string? cardLast4 = null;
    string? cardBrand = null;
    string? intentId = null;
    DateTime? paidAt = null;
    try { cardLast4 = Model.StripeCardLast4; } catch { }
    try { cardBrand = Model.StripeCardBrand; } catch { }
    try { intentId = Model.StripePaymentIntentId; } catch { }
    try { paidAt = Model.PaidAt; } catch { }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Successful – MedLink</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@@latest/dist/umd/lucide.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            background: #f0f4f8;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 32px 16px;
        }
        .page-wrap { width: 100%; max-width: 520px; display: flex; flex-direction: column; gap: 10px; }

        /* Card base */
        .card {
            background: #ffffff;
            border: 1px solid #dce4ef;
            border-radius: 10px;
            padding: 22px 24px;
        }
        .card-blue {
            background: #2563eb;
            border: 1px solid #2563eb;
            border-radius: 10px;
            padding: 22px 24px;
        }
        .card-blue-light {
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 10px;
            padding: 22px 24px;
        }

        /* Two-column grid */
        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }

        /* Typography */
        .label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #64748b;
            margin-bottom: 5px;
        }
        .label-white { color: rgba(255,255,255,0.65); }
        .label-blue { color: #2563eb; }
        .value { font-size: 15px; font-weight: 700; color: #0f172a; }
        .value-lg { font-size: 21px; font-weight: 800; color: #0f172a; }
        .value-white { color: #ffffff; }
        .value-xl { font-size: 28px; font-weight: 800; }

        /* Badge */
        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 3px 10px;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
            color: #2563eb;
        }
        .badge-dot {
            width: 6px; height: 6px;
            background: #2563eb;
            border-radius: 50%;
            display: inline-block;
        }
        .badge-white {
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.3);
            color: #fff;
        }
        .badge-white .badge-dot { background: #fff; }

        /* Divider */
        .divider { border: none; border-top: 1px solid #e8edf3; margin: 14px 0; }

        /* Icon box */
        .icon-box {
            width: 36px; height: 36px;
            border-radius: 8px;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .icon-box-white {
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.25);
        }

        /* Buttons */
        .btn-primary {
            display: flex; align-items: center; justify-content: center; gap: 7px;
            padding: 12px 20px;
            background: #2563eb;
            color: #fff;
            border-radius: 8px;
            font-size: 13px; font-weight: 700;
            text-decoration: none;
            transition: background 0.15s;
        }
        .btn-primary:hover { background: #1d4ed8; }
        .btn-secondary {
            display: flex; align-items: center; justify-content: center; gap: 7px;
            padding: 12px 20px;
            background: #fff;
            color: #1e40af;
            border: 1px solid #bfdbfe;
            border-radius: 8px;
            font-size: 13px; font-weight: 700;
            text-decoration: none;
            transition: background 0.15s;
        }
        .btn-secondary:hover { background: #eff6ff; }

        /* Item row */
        .item-row {
            display: flex; align-items: center; justify-content: space-between;
            padding: 10px 12px;
            background: #f8fafc;
            border: 1px solid #e8edf3;
            border-radius: 8px;
        }
    </style>
</head>
<body>
<div class="page-wrap">

    <!-- ── Header: Success Banner ── -->
    <div class="card-blue">
        <div style="display:flex; align-items:center; gap:14px;">
            <div class="icon-box icon-box-white" style="width:44px;height:44px;border-radius:10px;">
                <i data-lucide="check" style="width:22px;height:22px;color:#fff;stroke-width:3;"></i>
            </div>
            <div>
                <div class="label label-white" style="margin-bottom:3px;">MedLink Pharmacy</div>
                <div class="value-xl value-white">
                    @(isOnline ? "Payment Successful" : "Order Confirmed")
                </div>
                <div style="font-size:12px;color:rgba(255,255,255,0.65);margin-top:3px;font-weight:500;">
                    @(isOnline ? "Processed securely via Stripe" : "Cash on delivery · Medicines being prepared")
                </div>
            </div>
            <div style="margin-left:auto;">
                <div class="badge badge-white">
                    <span class="badge-dot"></span>
                    @(isOnline ? "Paid" : "Confirmed")
                </div>
            </div>
        </div>
    </div>

    <!-- ── Row 1: Order ID + Delivery ── -->
    <div class="grid-2">
        <div class="card">
            <div class="label label-blue">Order ID</div>
            <div class="value-lg">#ORD-@Model.Id.ToString("D5")</div>
        </div>
        <div class="card">
            <div class="label">Estimated Delivery</div>
            <div class="value" style="font-size:16px;font-weight:800;">1–3 Business Days</div>
            <div style="font-size:12px;color:#94a3b8;margin-top:3px;font-weight:500;">Door-to-door delivery</div>
        </div>
    </div>

    @if (isOnline && Model.TotalAmount > 0)
    {
        <!-- ── Row 2: Amount + Card ── -->
        <div class="grid-2">
            <!-- Amount — blue card -->
            <div class="card-blue">
                <div class="label label-white">Amount Paid</div>
                <div style="font-size:30px;font-weight:800;color:#fff;margin:6px 0 10px;">PKR @Model.TotalAmount.ToString("N0")</div>
                <div class="badge badge-white">
                    <span class="badge-dot"></span>
                    Payment Confirmed
                </div>
            </div>

            <!-- Card details — light blue -->
            <div class="card-blue-light">
                <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;">
                    <div class="label label-blue">Payment Card</div>
                    <i data-lucide="credit-card" style="width:14px;height:14px;color:#2563eb;"></i>
                </div>
                @if (!string.IsNullOrEmpty(cardLast4))
                {
                    <div style="width:28px;height:18px;background:#2563eb;border-radius:3px;margin-bottom:12px;"></div>
                    <div style="font-family:monospace;font-size:13px;font-weight:700;color:#1e3a5f;letter-spacing:0.08em;">
                        •••• •••• •••• @cardLast4
                    </div>
                    <div class="label" style="margin-top:5px;margin-bottom:0;">@(cardBrand?.ToUpper() ?? "CARD")</div>
                }
                else
                {
                    <div style="font-size:13px;color:#64748b;">Card details unavailable</div>
                }
            </div>
        </div>

        @if (paidAt.HasValue)
        {
            <!-- ── Row 3: Date + Status ── -->
            <div class="grid-2">
                <div class="card">
                    <div class="label">Date &amp; Time</div>
                    <div class="value">@paidAt.Value.ToString("MMM dd, yyyy")</div>
                    <div style="font-size:13px;color:#64748b;font-weight:600;margin-top:2px;">@paidAt.Value.ToString("HH:mm")</div>
                </div>
                <div class="card-blue-light">
                    <div class="label label-blue">Status</div>
                    <div style="display:flex;align-items:center;gap:7px;margin-top:4px;">
                        <span style="width:8px;height:8px;background:#2563eb;border-radius:50%;display:inline-block;"></span>
                        <span class="value" style="color:#1e40af;">Paid</span>
                    </div>
                    <div style="font-size:11px;color:#3b82f6;margin-top:4px;font-weight:600;">Secured by Stripe</div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(intentId))
        {
            <!-- Transaction ID -->
            <div class="card" style="background:#f8fafc;padding:14px 18px;">
                <div style="display:flex;align-items:center;gap:6px;margin-bottom:5px;">
                    <i data-lucide="fingerprint" style="width:13px;height:13px;color:#94a3b8;"></i>
                    <span class="label" style="margin-bottom:0;">Transaction Reference</span>
                </div>
                <div style="font-family:monospace;font-size:11px;color:#475569;word-break:break-all;line-height:1.6;">@intentId</div>
            </div>
        }
    }

    @if (Model.OrderItems != null && Model.OrderItems.Any())
    {
        <!-- ── Ordered Items ── -->
        <div class="card" style="padding:20px 22px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                <div style="display:flex;align-items:center;gap:8px;">
                    <div class="icon-box">
                        <i data-lucide="package" style="width:16px;height:16px;color:#2563eb;"></i>
                    </div>
                    <span style="font-size:13px;font-weight:700;color:#0f172a;">Ordered Items</span>
                </div>
                <span style="font-size:12px;color:#94a3b8;font-weight:600;">@Model.OrderItems.Count item(s)</span>
            </div>

            <div style="display:flex;flex-direction:column;gap:6px;">
                @foreach (var item in Model.OrderItems)
                {
                    <div class="item-row">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <div class="icon-box" style="background:#fff;width:32px;height:32px;">
                                <i data-lucide="pill" style="width:13px;height:13px;color:#3b82f6;"></i>
                            </div>
                            <div>
                                <div style="font-size:13px;font-weight:700;color:#0f172a;">@(item.Medicine?.Name ?? "Medicine")</div>
                                <div style="font-size:11px;color:#94a3b8;font-weight:600;margin-top:1px;">Qty: @item.Quantity &middot; PKR @item.UnitPrice.ToString("N0") each</div>
                            </div>
                        </div>
                        <div style="font-size:13px;font-weight:800;color:#1e40af;">PKR @((item.UnitPrice * item.Quantity).ToString("N0"))</div>
                    </div>
                }
            </div>

            @if (Model.TotalAmount > 0)
            {
                <hr class="divider" />
                <div style="display:flex;justify-content:space-between;align-items:center;padding:0 2px;">
                    <span style="font-size:13px;font-weight:600;color:#64748b;">Total</span>
                    <span style="font-size:16px;font-weight:800;color:#1e40af;">PKR @Model.TotalAmount.ToString("N0")</span>
                </div>
            }
        </div>
    }

    <!-- ── CTA Buttons ── -->
    <div class="grid-2">
        <a href="/Pharmacy/Store" class="btn-primary">
            <i data-lucide="store" style="width:15px;height:15px;"></i>
            Continue Shopping
        </a>
        <a href="/Pharmacy/MyOrders" class="btn-secondary">
            <i data-lucide="package" style="width:15px;height:15px;"></i>
            My Orders
        </a>
    </div>

</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) lucide.createIcons();
    });
</script>
</body>
</html>
