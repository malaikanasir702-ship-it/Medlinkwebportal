@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Sleep Map";
    ViewData["HeaderTitle"] = "Sleep Intelligence Map";
    ViewData["HeaderSubtitle"] = "Neural Sleep Pattern Analysis & Circadian Optimization";
    var sleepData = ViewBag.SleepData as MedLinkPortal.Models.SleepData;
}

<div class="space-y-8">
    <!-- Hero Section: Overall Sleep Score -->
    <div class="bg-gradient-to-br from-indigo-900 via-purple-900 to-slate-900 rounded-[3rem] p-8 md:p-12 text-white shadow-2xl relative overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_50%,rgba(99,102,241,0.15),transparent)]"></div>
        <div class="absolute -right-20 -top-20 w-96 h-96 bg-purple-600/20 rounded-full blur-[120px]"></div>
        
        <div class="relative z-10 flex flex-col md:flex-row items-center gap-12">
            <!-- Sleep Score Radial -->
            <div class="relative w-72 h-72 flex-shrink-0">
                <svg class="w-full h-full transform -rotate-90">
                    <circle cx="144" cy="144" r="120" stroke="currentColor" stroke-width="8" fill="transparent" class="text-white/10" />
                    <circle cx="144" cy="144" r="120" stroke="currentColor" stroke-width="16" fill="transparent" 
                            stroke-dasharray="754" stroke-dashoffset="@(754 - (754 * sleepData.OverallSleepScore / 100))" 
                            class="text-indigo-400 drop-shadow-[0_0_20px_rgba(129,140,248,0.6)]" stroke-linecap="round" />
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span class="text-8xl font-semibold tracking-tighter">@sleepData.OverallSleepScore</span>
                    <span class="text-xs font-semibold text-indigo-300 uppercase tracking-[0.3em] mt-2">@sleepData.SleepQuality</span>
                </div>
            </div>

            <!-- Sleep Summary -->
            <div class="flex-1 text-center md:text-left">
                <div class="inline-flex items-center gap-2 bg-indigo-500/10 border border-indigo-400/20 px-4 py-2 rounded-full text-[10px] font-semibold uppercase tracking-[0.2em] mb-6 text-indigo-300">
                    <span class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></span>
                    Sleep Quality Index
                </div>
                <h1 class="text-5xl md:text-6xl font-semibold mb-6 tracking-tight leading-tight">
                    Sleep Pattern <span class="text-indigo-400">Optimized.</span>
                </h1>
                <p class="text-slate-300 text-lg font-medium leading-relaxed mb-8 max-w-2xl">
                    Your sleep architecture shows strong circadian alignment with @sleepData.CircadianData.CircadianAlignment% synchronization. 
                    Average sleep duration: 7.7 hours with minimal interruptions.
                </p>
                
                <div class="flex flex-wrap items-center gap-6">
                    <div class="px-6 py-3 bg-white/5 rounded-2xl border border-white/10 flex items-center gap-4">
                        <i data-lucide="moon" class="w-8 h-8 text-indigo-400"></i>
                        <div>
                            <p class="text-2xl font-semibold text-indigo-300">@sleepData.CircadianData.Chronotype</p>
                            <p class="text-[9px] font-bold text-slate-500 uppercase tracking-widest">Chronotype</p>
                        </div>
                    </div>
                    <div class="px-6 py-3 bg-white/5 rounded-2xl border border-white/10 flex items-center gap-4">
                        <i data-lucide="clock" class="w-8 h-8 text-purple-400"></i>
                        <div>
                            <p class="text-2xl font-semibold text-purple-300">@sleepData.CircadianData.OptimalBedTime</p>
                            <p class="text-[9px] font-bold text-slate-500 uppercase tracking-widest">Optimal Bedtime</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Weekly Sleep Pattern Chart -->
    <div class="bg-white rounded-[3rem] p-10 border border-slate-100 shadow-xl">
        <div class="flex items-center justify-between mb-10">
            <h2 class="text-3xl font-semibold text-slate-900 flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600">
                    <i data-lucide="bar-chart-3" class="w-7 h-7"></i>
                </div>
                7-Day Sleep Pattern
            </h2>
            <span class="px-4 py-1.5 bg-slate-100 text-slate-500 rounded-full text-[9px] font-semibold uppercase tracking-[0.2em]">Last Week</span>
        </div>

        <div class="grid grid-cols-7 gap-4">
            @foreach (var day in sleepData.WeeklyPattern)
            {
                <div class="relative group">
                    <!-- Bar Chart Column -->
                    <div class="h-64 bg-slate-50 rounded-2xl flex flex-col justify-end p-4 relative overflow-hidden group-hover:bg-slate-100 transition-all">
                        <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-blue-500 to-indigo-500 rounded-t-2xl transition-all group-hover:from-blue-600 group-hover:to-indigo-600"
                             style="height: @((day.TotalHours / 10.0) * 100)%">
                        </div>
                        <div class="relative z-10 text-center">
                            <p class="text-2xl font-semibold text-white drop-shadow-lg">@day.TotalHours.ToString("0.0")</p>
                            <p class="text-[8px] font-bold text-white/80 uppercase tracking-wider">hrs</p>
                        </div>
                    </div>
                    
                    <!-- Day Label -->
                    <div class="mt-4 text-center">
                        <p class="text-xs font-semibold text-slate-900">@day.DayName</p>
                        <p class="text-[9px] font-bold text-slate-400">@day.Date</p>
                        <div class="mt-2 inline-flex items-center gap-1 px-2 py-1 rounded-lg @(day.QualityScore >= 85 ? "bg-emerald-50 text-emerald-700" : "bg-amber-50 text-amber-700")">
                            <i data-lucide="@(day.QualityScore >= 85 ? "check-circle" : "alert-circle")" class="w-3 h-3"></i>
                            <span class="text-[8px] font-semibold">@day.QualityScore</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Sleep Stages Breakdown -->
        <div class="bg-white rounded-[3rem] p-10 border border-slate-100 shadow-xl">
            <h2 class="text-2xl font-semibold text-slate-900 mb-8 flex items-center gap-4">
                <div class="w-12 h-12 rounded-2xl bg-purple-50 flex items-center justify-center text-purple-600">
                    <i data-lucide="layers" class="w-6 h-6"></i>
                </div>
                Sleep Stages
            </h2>

            <div class="space-y-6">
                <div class="relative">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-3">
                            <div class="w-3 h-3 rounded-full bg-purple-500"></div>
                            <span class="text-sm font-bold text-slate-700">REM Sleep</span>
                        </div>
                        <span class="text-lg font-semibold text-purple-600">@sleepData.SleepStages.RemPercentage.ToString("0.0")%</span>
                    </div>
                    <div class="h-3 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r from-purple-500 to-purple-600 rounded-full" style="width: @sleepData.SleepStages.RemPercentage%"></div>
                    </div>
                </div>

                <div class="relative">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-3">
                            <div class="w-3 h-3 rounded-full bg-indigo-500"></div>
                            <span class="text-sm font-bold text-slate-700">Deep Sleep</span>
                        </div>
                        <span class="text-lg font-semibold text-indigo-600">@sleepData.SleepStages.DeepPercentage.ToString("0.0")%</span>
                    </div>
                    <div class="h-3 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r from-indigo-500 to-indigo-600 rounded-full" style="width: @sleepData.SleepStages.DeepPercentage%"></div>
                    </div>
                </div>

                <div class="relative">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-3">
                            <div class="w-3 h-3 rounded-full bg-blue-400"></div>
                            <span class="text-sm font-bold text-slate-700">Light Sleep</span>
                        </div>
                        <span class="text-lg font-semibold text-blue-600">@sleepData.SleepStages.LightPercentage.ToString("0.0")%</span>
                    </div>
                    <div class="h-3 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r from-blue-400 to-blue-500 rounded-full" style="width: @sleepData.SleepStages.LightPercentage%"></div>
                    </div>
                </div>

                <div class="relative">
                    <div class="flex items-center justify-between mb-2">
                        <div class="flex items-center gap-3">
                            <div class="w-3 h-3 rounded-full bg-slate-400"></div>
                            <span class="text-sm font-bold text-slate-700">Awake</span>
                        </div>
                        <span class="text-lg font-semibold text-slate-600">@sleepData.SleepStages.AwakePercentage.ToString("0.0")%</span>
                    </div>
                    <div class="h-3 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-gradient-to-r from-slate-400 to-slate-500 rounded-full" style="width: @sleepData.SleepStages.AwakePercentage%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sleep Hygiene Score -->
        <div class="bg-white rounded-[3rem] p-10 border border-slate-100 shadow-xl">
            <div class="flex items-center justify-between mb-8">
                <h2 class="text-2xl font-semibold text-slate-900 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-2xl bg-emerald-50 flex items-center justify-center text-emerald-600">
                        <i data-lucide="shield-check" class="w-6 h-6"></i>
                    </div>
                    Sleep Hygiene
                </h2>
                <div class="text-right">
                    <p class="text-4xl font-semibold text-emerald-600">@sleepData.HygieneScore.OverallScore</p>
                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Overall Score</p>
                </div>
            </div>

            <div class="space-y-4">
                @foreach (var factor in sleepData.HygieneScore.Factors)
                {
                    <div class="p-4 rounded-2xl @(factor.Status == "Excellent" ? "bg-emerald-50 border border-emerald-100" : factor.Status == "Good" ? "bg-blue-50 border border-blue-100" : "bg-amber-50 border border-amber-100")">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-sm font-bold text-slate-700">@factor.Name</span>
                            <span class="text-lg font-semibold @(factor.Status == "Excellent" ? "text-emerald-600" : factor.Status == "Good" ? "text-blue-600" : "text-amber-600")">@factor.Score</span>
                        </div>
                        <p class="text-[10px] font-medium text-slate-600">@factor.Recommendation</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- AI-Generated Insights -->
    <div class="bg-white rounded-[3rem] p-10 border border-slate-100 shadow-xl">
        <h2 class="text-3xl font-semibold text-slate-900 mb-8 flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600">
                <i data-lucide="lightbulb" class="w-7 h-7"></i>
            </div>
            Neural Sleep Insights
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var insight in sleepData.Insights)
            {
                <div class="p-6 rounded-[2rem] @(insight.Color == "emerald" ? "bg-emerald-50 border border-emerald-100" : insight.Color == "blue" ? "bg-blue-50 border border-blue-100" : insight.Color == "amber" ? "bg-amber-50 border border-amber-100" : "bg-slate-50 border border-slate-100") group hover:shadow-xl transition-all">
                    <div class="flex items-start gap-4 mb-4">
                        <div class="w-12 h-12 rounded-xl @(insight.Color == "emerald" ? "bg-emerald-100 text-emerald-600" : insight.Color == "blue" ? "bg-blue-100 text-blue-600" : insight.Color == "amber" ? "bg-amber-100 text-amber-600" : "bg-slate-100 text-slate-600") flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                            <i data-lucide="@insight.Icon" class="w-6 h-6"></i>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center justify-between mb-2">
                                <h3 class="text-sm font-semibold text-slate-900">@insight.Title</h3>
                                <span class="px-2 py-1 rounded-lg text-[8px] font-semibold uppercase tracking-wider @(insight.Priority == "High" ? "bg-rose-100 text-rose-700" : insight.Priority == "Medium" ? "bg-blue-100 text-blue-700" : "bg-slate-100 text-slate-600")">
                                    @insight.Priority
                                </span>
                            </div>
                            <p class="text-xs font-medium text-slate-600 leading-relaxed">@insight.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        lucide.createIcons();
    </script>
}
