@model MedLinkPortal.Models.PatientDashboardModel
@using MedLinkPortal.Models
@{
    ViewData["Title"] = "My Visa Applications";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var apps = ViewBag.Applications as List<VisaApplication> ?? new List<VisaApplication>();
}

<div class="max-w-5xl mx-auto pb-20 space-y-8 animate-in fade-in duration-700">
    <div class="flex items-center justify-between">
        <div>
            <a href="@Url.Action("VisaSupport")" class="inline-flex items-center gap-2 text-slate-400 hover:text-slate-900 font-bold text-xs uppercase tracking-widest transition-all mb-4 group">
                <i data-lucide="arrow-left" class="w-4 h-4 group-hover:-translate-x-1 transition-transform"></i> Back to Visa Support
            </a>
            <h1 class="text-3xl font-black text-slate-900 tracking-tight">My Visa Applications</h1>
            <p class="text-slate-400 font-medium text-sm mt-1">Track all your submitted medical visa requests</p>
        </div>
        <a href="@Url.Action("VisaSupport")"
           class="px-6 py-3 bg-indigo-600 text-white rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-indigo-700 transition-all shadow-lg flex items-center gap-2">
            <i data-lucide="plus" class="w-4 h-4"></i> New Application
        </a>
    </div>

    @if (!apps.Any())
    {
        <div class="bg-white rounded-[2rem] p-20 text-center border border-slate-100">
            <div class="w-16 h-16 bg-slate-50 rounded-3xl flex items-center justify-center mx-auto mb-4 text-slate-300">
                <i data-lucide="file-x" class="w-8 h-8"></i>
            </div>
            <h3 class="text-xl font-black text-slate-900">No Applications Yet</h3>
            <p class="text-slate-400 text-sm mt-2 mb-6">Submit your first visa application to get started</p>
            <a href="@Url.Action("VisaSupport")" class="px-6 py-3 bg-indigo-600 text-white rounded-xl font-black text-xs uppercase tracking-widest hover:bg-indigo-700 transition-all inline-flex items-center gap-2">
                <i data-lucide="send" class="w-4 h-4"></i> Apply Now
            </a>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var app in apps)
            {
                var (statusBg, statusText, statusDot) = app.Status switch
                {
                    VisaStatus.Submitted => ("bg-amber-50 border-amber-200", "text-amber-700", "bg-amber-400"),
                    VisaStatus.DocumentsUnderReview => ("bg-blue-50 border-blue-200", "text-blue-700", "bg-blue-500"),
                    VisaStatus.InvitationIssued => ("bg-indigo-50 border-indigo-200", "text-indigo-700", "bg-indigo-500"),
                    VisaStatus.EmbassySubmitted => ("bg-purple-50 border-purple-200", "text-purple-700", "bg-purple-500"),
                    VisaStatus.VisaApproved => ("bg-emerald-50 border-emerald-200", "text-emerald-700", "bg-emerald-500"),
                    VisaStatus.VisaRejected => ("bg-red-50 border-red-200", "text-red-700", "bg-red-500"),
                    _ => ("bg-slate-50 border-slate-200", "text-slate-600", "bg-slate-400")
                };

                <div class="bg-white rounded-[2rem] border @statusBg p-6 md:p-8 shadow-sm hover:shadow-xl transition-all duration-500 border-l-4">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div class="flex items-center gap-4">
                            <div class="w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-600 flex-shrink-0">
                                <i data-lucide="file-text" class="w-6 h-6"></i>
                            </div>
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="text-[9px] font-black text-slate-400 uppercase tracking-widest">@app.ReferenceId</span>
                                </div>
                                <h4 class="text-lg font-black text-slate-900">@app.TreatmentType</h4>
                                <p class="text-sm text-slate-400 font-medium">@app.Nationality · Submitted @app.CreatedAt.ToString("MMM dd, yyyy")</p>
                            </div>
                        </div>
                        <div class="flex flex-col items-start md:items-end gap-2">
                            <span class="flex items-center gap-2 px-4 py-2 rounded-xl border text-[10px] font-black uppercase tracking-widest @statusBg @statusText">
                                <span class="w-2 h-2 rounded-full @statusDot @(app.Status is VisaStatus.DocumentsUnderReview or VisaStatus.EmbassySubmitted ? "animate-pulse" : "")"></span>
                                @app.Status.ToString().Replace("Documents", "Docs ")
                            </span>
                            @if (app.UpdatedAt.HasValue)
                            {
                                <span class="text-[9px] text-slate-400 font-medium">Updated @app.UpdatedAt.Value.ToString("MMM dd, yyyy")</span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(app.AdminNotes) || !string.IsNullOrEmpty(app.InvitationLetterUrl))
                    {
                        <div class="mt-5 pt-5 border-t border-slate-100 space-y-3">
                            @if (!string.IsNullOrEmpty(app.InvitationLetterUrl))
                            {
                                <a href="@app.InvitationLetterUrl" target="_blank"
                                   class="inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-xl font-black text-xs uppercase tracking-widest hover:bg-emerald-600 hover:text-white transition-all">
                                    <i data-lucide="download" class="w-4 h-4"></i> Download Invitation Letter
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(app.AdminNotes))
                            {
                                <div class="flex items-start gap-3 p-4 bg-amber-50 rounded-2xl border border-amber-100">
                                    <i data-lucide="info" class="w-4 h-4 text-amber-500 flex-shrink-0 mt-0.5"></i>
                                    <p class="text-sm text-amber-800 font-medium">@app.AdminNotes</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>lucide.createIcons();</script>
}
