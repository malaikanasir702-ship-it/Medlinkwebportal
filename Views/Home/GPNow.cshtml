@{
    ViewData["Title"] = "Instant GP Consultation | MedLink";
}

<div class="min-h-screen bg-white">

    <!-- Navigation -->
    <nav class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100 py-4">
        <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2">
                <div class="bg-blue-600 p-1.5 rounded-lg text-white">
                    <i data-lucide="heart" class="w-4 h-4"></i>
                </div>
                <span class="text-lg font-bold tracking-tight text-gray-900">MedLink</span>
            </a>

            <div class="flex items-center gap-6">
                <div class="hidden sm:flex items-center gap-2">
                    <span class="flex h-2 w-2 rounded-full bg-green-500"></span>
                    <span class="text-xs font-semibold text-gray-500 uppercase tracking-widest">GPS Active Online</span>
                </div>
                <a href="/" class="text-sm font-medium text-gray-500 hover:text-gray-900 transition-colors">Exit</a>
            </div>
        </div>
    </nav>

    <main class="pt-32 pb-24 px-6 max-w-5xl mx-auto">

        <!-- Hero -->
        <div class="text-center mb-20">
            <div class="inline-flex items-center gap-2 border border-gray-200 rounded-full px-4 py-1.5 mb-10">
                <i data-lucide="zap" class="w-3.5 h-3.5 text-blue-600"></i>
                <span class="text-xs font-semibold text-gray-600 uppercase tracking-widest">Priority Triage Active</span>
            </div>

            <h1 class="text-5xl md:text-6xl font-bold text-gray-900 tracking-tight leading-tight mb-6">
                Immediate care,<br />
                <span class="text-gray-400 font-normal italic">just a tap away.</span>
            </h1>

            <p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed mb-12">
                Connect with a board-certified General Practitioner in seconds.
                Our high-speed triage system ensures you get medical attention when it matters most.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <button onclick="startTriage()"
                        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 min-w-[220px] px-8 py-3.5 bg-gray-900 text-white rounded-lg font-semibold text-sm hover:bg-black transition-colors">
                    <i data-lucide="video" class="w-4 h-4"></i>
                    Consult Virtual GP Now
                </button>
                <button class="w-full sm:w-auto inline-flex items-center justify-center gap-2 min-w-[180px] px-8 py-3.5 bg-white border border-gray-200 text-gray-700 rounded-lg font-semibold text-sm hover:border-gray-300 hover:bg-gray-50 transition-colors">
                    View Network Status
                </button>
            </div>
        </div>

        <!-- Main Card -->
        <div class="rounded-xl border border-gray-200 overflow-hidden bg-white">

            <!-- Card Header -->
            <div class="bg-gray-50 border-b border-gray-200 px-7 py-5 flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-lg bg-blue-600 text-white flex items-center justify-center flex-shrink-0">
                        <i data-lucide="activity" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900 text-sm">Priority Queuing</h3>
                        <p class="text-xs text-gray-400 mt-0.5">Average Wait: <span class="font-semibold text-blue-600">42 Seconds</span></p>
                    </div>
                </div>

                <!-- Online GPs -->
                <div class="flex items-center gap-3">
                    <div class="flex -space-x-2">
                        @for (int i = 1; i <= 3; i++)
                        {
                            <img src="https://picsum.photos/seed/gp-@i/80/80"
                                 class="w-8 h-8 rounded-full border-2 border-white object-cover">
                        }
                        <div class="w-8 h-8 rounded-full border-2 border-white bg-blue-50 flex items-center justify-center text-[10px] font-bold text-blue-600">
                            +12
                        </div>
                    </div>
                    <span class="text-xs text-gray-400 hidden sm:block">GPs online</span>
                </div>
            </div>

            <!-- Features Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-gray-100">
                <div class="p-8">
                    <div class="w-10 h-10 rounded-lg bg-orange-50 border border-orange-100 flex items-center justify-center mb-5">
                        <i data-lucide="stethoscope" class="w-5 h-5 text-orange-500"></i>
                    </div>
                    <h4 class="font-semibold text-gray-900 mb-2">AI Triage</h4>
                    <p class="text-sm text-gray-500 leading-relaxed">Instant symptom analysis to match you with the right expertise level.</p>
                </div>

                <div class="p-8">
                    <div class="w-10 h-10 rounded-lg bg-blue-50 border border-blue-100 flex items-center justify-center mb-5">
                        <i data-lucide="video" class="w-5 h-5 text-blue-600"></i>
                    </div>
                    <h4 class="font-semibold text-gray-900 mb-2">HD Video Consult</h4>
                    <p class="text-sm text-gray-500 leading-relaxed">Crystal clear communication with screen-sharing and vitals integration.</p>
                </div>

                <div class="p-8">
                    <div class="w-10 h-10 rounded-lg bg-green-50 border border-green-100 flex items-center justify-center mb-5">
                        <i data-lucide="file-text" class="w-5 h-5 text-green-600"></i>
                    </div>
                    <h4 class="font-semibold text-gray-900 mb-2">Digital Rx</h4>
                    <p class="text-sm text-gray-500 leading-relaxed">Secure prescriptions sent instantly to your phone and local pharmacy.</p>
                </div>
            </div>

            <!-- Status Bar -->
            <div class="bg-gray-900 px-7 py-4 flex flex-col sm:flex-row items-center justify-between gap-3">
                <div class="flex items-center gap-3">
                    <span class="flex h-2 w-2 rounded-full bg-blue-400"></span>
                    <p class="text-xs font-semibold text-gray-300 uppercase tracking-wider">Systems Active · Secure Pipeline Established</p>
                </div>
                <div class="flex items-center gap-2">
                    <i data-lucide="lock" class="w-3 h-3 text-gray-500"></i>
                    <span class="text-xs text-gray-500 uppercase tracking-wider font-medium">End-to-End Encrypted</span>
                </div>
            </div>
        </div>

        <!-- How It Works -->
        <div class="mt-20">
            <div class="text-center mb-12">
                <p class="text-xs font-semibold text-blue-600 uppercase tracking-widest mb-3">How It Works</p>
                <h2 class="text-2xl font-bold text-gray-900">Get care in 3 simple steps</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white border border-gray-200 rounded-xl p-7">
                    <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center text-sm font-bold mb-5">1</div>
                    <h3 class="font-semibold text-gray-900 mb-2">Describe Symptoms</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">Answer a brief triage questionnaire to help our AI route you to the right GP.</p>
                </div>

                <div class="bg-white border border-gray-200 rounded-xl p-7">
                    <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center text-sm font-bold mb-5">2</div>
                    <h3 class="font-semibold text-gray-900 mb-2">Connect via Video</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">Join a secure HD video call with an available, board-certified GP within seconds.</p>
                </div>

                <div class="bg-white border border-gray-200 rounded-xl p-7">
                    <div class="w-8 h-8 rounded-lg bg-blue-600 text-white flex items-center justify-center text-sm font-bold mb-5">3</div>
                    <h3 class="font-semibold text-gray-900 mb-2">Receive Prescription</h3>
                    <p class="text-sm text-gray-500 leading-relaxed">Get your digital prescription, referrals, or sick note sent directly to your device.</p>
                </div>
            </div>
        </div>

        <!-- Trust Badges -->
        <div class="mt-16 pt-10 border-t border-gray-100">
            <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest text-center mb-8">Trusted by Global Standards</p>
            <div class="flex flex-wrap justify-center items-center gap-10">
                <div class="flex items-center gap-2">
                    <i data-lucide="shield-check" class="w-4 h-4 text-gray-400"></i>
                    <span class="text-sm font-semibold text-gray-400">HIPAA Compliant</span>
                </div>
                <div class="w-px h-4 bg-gray-200"></div>
                <div class="flex items-center gap-2">
                    <i data-lucide="lock" class="w-4 h-4 text-gray-400"></i>
                    <span class="text-sm font-semibold text-gray-400">GDPR Secure</span>
                </div>
                <div class="w-px h-4 bg-gray-200"></div>
                <div class="flex items-center gap-2">
                    <i data-lucide="check-circle" class="w-4 h-4 text-gray-400"></i>
                    <span class="text-sm font-semibold text-gray-400">WHO Certified</span>
                </div>
            </div>
        </div>

    </main>

    @await Html.PartialAsync("_Footer")
</div>

<script>
    lucide.createIcons();

    function startTriage() {
        const btn = event.currentTarget;
        btn.disabled = true;
        btn.innerHTML = `<svg class="animate-spin w-4 h-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path></svg>Connecting...`;
        setTimeout(() => {
            window.location.href = '/Identity/Account/Login?returnUrl=/Dashboard/Doctors';
        }, 1200);
    }
</script>
