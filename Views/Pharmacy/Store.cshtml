@model MedLinkPortal.Models.PatientDashboardModel
@{
    ViewData["Title"] = "Pharmacy Store";
    Layout = "_DashboardLayout";
}

<div class="min-h-screen pb-20">
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    <style>
        .swiper-pagination-bullet { width: 10px; height: 10px; background: rgba(255,255,255,0.5); opacity: 1; transition: all 0.3s; }
        .swiper-pagination-bullet-active { width: 30px; border-radius: 5px; background: #10b981; }
        .glass-card { background: rgba(255, 255, 255, 0.1); backdrop-filter: blur(10px); border: 1px solid rgba(255, 255, 255, 0.2); }
    </style>

    <div class="max-w-6xl mx-auto px-4 py-8 lg:py-8">
        <!-- Advanced Carousel -->
        <div class="swiper mySwiper w-full h-auto min-h-[300px] md:h-[400px] rounded-[2rem] md:rounded-[2.5rem] shadow-2xl mb-8 md:mb-12 relative overflow-hidden group">
            <div class="swiper-wrapper">
                <!-- Slide 1 -->
                <div class="swiper-slide relative">
                    <img src="https://images.unsplash.com/photo-1576602976047-174e57a47881?q=80&w=1920&auto=format&fit=crop" class="w-full h-full object-cover absolute inset-0" alt="Pharmacy Banner 1">
                    <div class="relative z-10 bg-gradient-to-r from-slate-900/95 via-slate-900/60 to-transparent flex items-center px-6 py-12 md:px-20 h-full">
                        <div class="max-w-xl space-y-4 md:space-y-6 animate-in fade-in slide-in-from-left-10 duration-1000">
                            <span class="px-3 py-1.5 md:px-4 md:py-2 bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 rounded-full text-[10px] md:text-xs font-semibold uppercase tracking-[0.2em] backdrop-blur-sm">Premium Healthcare</span>
                            <h2 class="text-3xl md:text-6xl font-semibold text-white leading-tight">Your Health, <br><span class="text-emerald-400">Our Priority</span></h2>
                            <p class="text-slate-300 text-sm md:text-lg font-medium max-w-[280px] md:max-w-md leading-relaxed">Experience next-generation pharmacy services with instant delivery.</p>
                            <button onclick="document.getElementById('medicineSearch').focus(); document.getElementById('medicineSearch').scrollIntoView({behavior:'smooth'});" class="px-6 py-3 md:px-8 md:py-4 bg-emerald-500 hover:bg-emerald-400 text-slate-900 rounded-xl md:rounded-2xl font-semibold transition-all hover:scale-105 active:scale-95 flex items-center gap-2 md:gap-3 shadow-[0_0_40px_-10px_rgba(16,185,129,0.5)] text-sm md:text-base">
                                Shop Now <i data-lucide="arrow-right" class="w-4 h-4 md:w-5 md:h-5"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <!-- Slide 2 -->
                <div class="swiper-slide relative">
                    <img src="https://images.unsplash.com/photo-1631549916768-4119b2e5f926?q=80&w=1920&auto=format&fit=crop" class="w-full h-full object-cover absolute inset-0" alt="Pharmacy Banner 2">
                    <div class="relative z-10 bg-gradient-to-r from-blue-900/95 via-blue-900/60 to-transparent flex items-center px-6 py-12 md:px-20 h-full">
                        <div class="max-w-xl space-y-4 md:space-y-6">
                            <span class="px-3 py-1.5 md:px-4 md:py-2 bg-blue-500/20 text-blue-300 border border-blue-500/30 rounded-full text-[10px] md:text-xs font-semibold uppercase tracking-[0.2em] backdrop-blur-sm">24/7 Service</span>
                            <h2 class="text-3xl md:text-6xl font-semibold text-white leading-tight">Digital <br><span class="text-blue-400">Prescriptions</span></h2>
                            <p class="text-slate-300 text-sm md:text-lg font-medium max-w-[280px] md:max-w-md leading-relaxed">Upload your prescription and let our pharmacists handle the rest.</p>
                            <button onclick="openPrescriptionModal()" class="px-6 py-3 md:px-8 md:py-4 bg-blue-500 hover:bg-blue-400 text-white rounded-xl md:rounded-2xl font-semibold transition-all hover:scale-105 active:scale-95 flex items-center gap-2 md:gap-3 shadow-[0_0_40px_-10px_rgba(59,130,246,0.5)] text-sm md:text-base">
                                Upload Rx <i data-lucide="upload-cloud" class="w-4 h-4 md:w-5 md:h-5"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <!-- Slide 3 -->
                <div class="swiper-slide relative">
                    <img src="https://images.unsplash.com/photo-1587854692152-cbe660dbde88?q=80&w=1920&auto=format&fit=crop" class="w-full h-full object-cover absolute inset-0" alt="Pharmacy Banner 3">
                    <div class="relative z-10 bg-gradient-to-r from-violet-900/95 via-violet-900/60 to-transparent flex items-center px-6 py-12 md:px-20 h-full">
                        <div class="max-w-xl space-y-4 md:space-y-6">
                            <span class="px-3 py-1.5 md:px-4 md:py-2 bg-violet-500/20 text-violet-300 border border-violet-500/30 rounded-full text-[10px] md:text-xs font-semibold uppercase tracking-[0.2em] backdrop-blur-sm">Exclusive Deals</span>
                            <h2 class="text-3xl md:text-6xl font-semibold text-white leading-tight">Save on <br><span class="text-violet-400">Essentials</span></h2>
                            <p class="text-slate-300 text-sm md:text-lg font-medium max-w-[280px] md:max-w-md leading-relaxed">Get up to 50% off on daily vitamins and supplements.</p>
                            <button onclick="window.location.href='/Pharmacy/Store#medicineGrid'" class="px-6 py-3 md:px-8 md:py-4 bg-violet-500 hover:bg-violet-400 text-white rounded-xl md:rounded-2xl font-semibold transition-all hover:scale-105 active:scale-95 flex items-center gap-2 md:gap-3 shadow-[0_0_40px_-10px_rgba(139,92,246,0.5)] text-sm md:text-base">
                                View Offers <i data-lucide="percent" class="w-4 h-4 md:w-5 md:h-5"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="swiper-pagination !bottom-6 md:!bottom-8 !left-6 md:!left-12 !w-auto"></div>
            <!-- Navigation Buttons -->
            <div class="hidden md:flex gap-2 absolute bottom-8 right-12 z-20">
                <button class="swiper-button-prev-custom w-12 h-12 rounded-full glass-card text-white flex items-center justify-center hover:bg-white hover:text-slate-900 transition-all active:scale-95">
                    <i data-lucide="chevron-left" class="w-6 h-6"></i>
                </button>
                <button class="swiper-button-next-custom w-12 h-12 rounded-full glass-card text-white flex items-center justify-center hover:bg-white hover:text-slate-900 transition-all active:scale-95">
                    <i data-lucide="chevron-right" class="w-6 h-6"></i>
                </button>
            </div>
        </div>

        <!-- Header & Search -->
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 mb-10">
            <div>
                <h1 class="text-3xl font-semibold text-slate-900 tracking-tight">Pharmacy Store</h1>
                <p class="text-slate-500 font-bold mt-1">Browse and purchase certified medicines.</p>
            </div>
            
            <div class="relative w-full md:w-96 group">
                <input type="text" id="medicineSearch" 
                       class="w-full pl-12 pr-4 py-4 bg-white border border-slate-100 rounded-2xl shadow-lg shadow-slate-200/50 text-sm font-bold focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 outline-none transition-all placeholder:text-slate-300"
                       placeholder="Search medicines, brands, or symptoms...">
                <i data-lucide="search" class="absolute left-5 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-300 group-focus-within:text-blue-500 transition-colors"></i>
            </div>
        </div>

        @if (!Model.StoreMedicines.Any())
        {
            <div class="bg-white rounded-[2.5rem] p-16 text-center border border-slate-100 shadow-xl">
                <div class="w-24 h-24 bg-slate-50 rounded-3xl flex items-center justify-center mx-auto mb-6 border border-dashed border-slate-200">
                    <i data-lucide="pill" class="w-10 h-10 text-slate-300"></i>
                </div>
                <h3 class="text-xl font-semibold text-slate-900 mb-2">Pharmacy is Empty</h3>
                <p class="text-slate-500 font-medium max-w-sm mx-auto">No medicines are currently available in the inventory. Please check back later.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="medicineGrid">
                @foreach (var medicine in Model.StoreMedicines)
                {
                    <div class="bg-white rounded-[2.5rem] p-6 border border-slate-100 shadow-xl hover:shadow-2xl hover:scale-[1.02] transition-all group relative overflow-hidden medicine-card" 
                         data-name="@medicine.Name.ToLower()" data-brand="@medicine.Brand.ToLower()">
                        
                        <!-- Stock Badge -->
                        <div class="absolute top-6 right-6 z-10">
                            @if((medicine.StockQuantity ?? 0) > 0) {
                                <span class="px-3 py-1 bg-emerald-50 text-emerald-600 text-[10px] font-semibold uppercase tracking-widest rounded-full border border-emerald-100">In Stock</span>
                            } else {
                                <span class="px-3 py-1 bg-rose-50 text-rose-600 text-[10px] font-semibold uppercase tracking-widest rounded-full border border-rose-100">Out of Stock</span>
                            }
                        </div>

                        <a href="/Pharmacy/Details/@medicine.Id" class="block h-48 w-full bg-slate-50 rounded-[2rem] mb-6 overflow-hidden relative group-hover:shadow-md transition-all">
                            @if(!string.IsNullOrEmpty(medicine.ImageUrl) && medicine.ImageUrl != "/images/medicines/default.png")
                            {
                                <img src="@medicine.ImageUrl" alt="@medicine.Name" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center text-slate-300">
                                    <i data-lucide="pill" class="w-12 h-12 text-slate-300 opacity-50"></i>
                                </div>
                            }
                        </a>

                        <a href="/Pharmacy/Details/@medicine.Id" class="block group-hover:text-blue-600 transition-colors">
                            <h3 class="text-lg font-semibold text-slate-900 mb-1 line-clamp-1">@medicine.Name</h3>
                        </a>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4">@medicine.Brand • @medicine.Category</p>

                        <div class="flex items-end justify-between mt-auto pt-4 border-t border-slate-50">
                            <div>
                                <p class="text-[10px] font-semibold text-slate-300 uppercase tracking-widest mb-1">Price per Unit</p>
                                 <p class="text-xl font-semibold text-slate-900">PKR @((medicine.Price ?? 0).ToString("N0"))</p>
                            </div>
                            
                             @if((medicine.StockQuantity ?? 0) > 0)
                            {
                                 <button onclick="addToCart(@medicine.Id, '@medicine.Name', @(medicine.Price ?? 0), '@medicine.Brand', '@medicine.ImageUrl')" 
                                        class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center hover:bg-emerald-500 hover:text-white transition-all shadow-lg active:scale-95 group/btn" title="Add to Cart">
                                    <i data-lucide="plus" class="w-4 h-4 group-hover/btn:hidden"></i>
                                    <i data-lucide="shopping-cart" class="w-4 h-4 hidden group-hover/btn:block animate-bounce"></i>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Simple Client-Side Search Script -->
<script>
    document.getElementById('medicineSearch').addEventListener('keyup', function(e) {
        const term = e.target.value.toLowerCase();
        const cards = document.querySelectorAll('.medicine-card');
        
        cards.forEach(card => {
            const name = card.getAttribute('data-name');
            const brand = card.getAttribute('data-brand');
            
            if (name.includes(term) || brand.includes(term)) {
                card.style.display = 'block';
            } else {
                card.style.display = 'none';
            }
        });
        lucide.createIcons();
    });

    function addToCart(id, name, price, brand, imageUrl) {
        // Use Global Cart
        PharmacyCart.addItem({
            id: id,
            name: name,
            price: price,
            brand: brand,
            imageUrl: imageUrl
        });
    }

    function openPrescriptionModal() {
        document.getElementById('prescriptionModal').classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }

    function closePrescriptionModal() {
        document.getElementById('prescriptionModal').classList.add('hidden');
        document.body.style.overflow = '';
        document.getElementById('rxFileInput').value = '';
        document.getElementById('rxPreview').classList.add('hidden');
        document.getElementById('rxScanResult').classList.add('hidden');
        document.getElementById('rxDropzone').classList.remove('hidden');
        document.getElementById('rxScanBtn').disabled = true;
        window._rxFile = null;
    }

    window._rxFile = null;

    // Single DOMContentLoaded — bind everything once after page load
    document.addEventListener('DOMContentLoaded', function() {
        const rxDropzone = document.getElementById('rxDropzone');
        const rxFileInput = document.getElementById('rxFileInput');

        if (rxDropzone) {
            rxDropzone.addEventListener('click', function(e) {
                e.preventDefault();
                e.stopPropagation();
                rxFileInput.click();
            });
            rxDropzone.addEventListener('dragover', function(e) {
                e.preventDefault();
                rxDropzone.style.borderColor = '#60a5fa';
                rxDropzone.style.background = 'rgba(219,234,254,0.3)';
            });
            rxDropzone.addEventListener('dragleave', function() {
                rxDropzone.style.borderColor = '';
                rxDropzone.style.background = '';
            });
            rxDropzone.addEventListener('drop', function(e) {
                e.preventDefault();
                rxDropzone.style.borderColor = '';
                rxDropzone.style.background = '';
                var file = e.dataTransfer.files[0];
                if (file) handleRxFile(file);
            });
        }

        if (rxFileInput) {
            rxFileInput.addEventListener('change', function(e) {
                var file = e.target.files[0];
                if (file) handleRxFile(file);
            });
        }
    });

    function handleRxFile(file) {
        if (!file.type.startsWith('image/')) {
            alert('Please upload an image file (JPG, PNG, etc.)');
            return;
        }
        window._rxFile = file;

        var reader = new FileReader();
        reader.onload = function(ev) {
            var previewImg = document.getElementById('rxPreviewImg');
            var preview = document.getElementById('rxPreview');
            var dropzone = document.getElementById('rxDropzone');
            var scanBtn = document.getElementById('rxScanBtn');

            if (previewImg) previewImg.src = ev.target.result;
            if (preview) preview.classList.remove('hidden');
            if (dropzone) dropzone.classList.add('hidden');
            if (scanBtn) scanBtn.disabled = false;
        };
        reader.readAsDataURL(file);
    }

    async function scanPrescription() {
        var file = window._rxFile;
        var fileInput = document.getElementById('rxFileInput');
        if (!file && fileInput && fileInput.files[0]) file = fileInput.files[0];
        if (!file) { alert('Please select an image first'); return; }

        const btn = document.getElementById('rxScanBtn');
        const originalText = btn.innerHTML;
        btn.innerHTML = '<span class="animate-spin inline-block mr-2">⟳</span> Scanning...';
        btn.disabled = true;

        const formData = new FormData();
        formData.append('prescriptionImage', file);

        try {
            const res = await fetch('/Pharmacy/ScanPrescription', { method: 'POST', body: formData });
            const data = await res.json();

            if (!data.success) {
                document.getElementById('rxScanResultContent').innerHTML = `<p class="text-red-500 font-bold">❌ ${data.message}</p>`;
                document.getElementById('rxScanResult').classList.remove('hidden');
                return;
            }

            let html = '';

            if (data.foundMedicines && data.foundMedicines.length > 0) {
                html += `<div class="mb-4">
                    <p class="text-xs font-semibold text-emerald-600 uppercase tracking-widest mb-3">✅ Found in Our Inventory (${data.foundMedicines.length})</p>
                    <div class="space-y-2" id="rxFoundList">`;
                data.foundMedicines.forEach(med => {
                    html += `<div class="flex items-center justify-between p-3 bg-emerald-50 rounded-xl border border-emerald-100">
                        <div>
                            <p class="font-bold text-slate-900 text-sm">${med.name}</p>
                            <p class="text-xs text-slate-500">${med.brand} · PKR ${med.price}</p>
                        </div>
                        <button onclick="addRxMedToCart(${med.id}, '${med.name.replace(/'/g,"\\'")}', ${med.price}, '${(med.brand||'').replace(/'/g,"\\'")}', '${med.imageUrl||''}')"
                            class="px-3 py-1.5 bg-emerald-600 text-white text-xs font-bold rounded-lg hover:bg-emerald-700 transition-all active:scale-95 rxAddBtn"
                            data-id="${med.id}">
                            + Add
                        </button>
                    </div>`;
                });
                html += `</div></div>`;
            }

            if (data.notFoundMedicines && data.notFoundMedicines.length > 0) {
                html += `<div>
                    <p class="text-xs font-semibold text-amber-600 uppercase tracking-widest mb-3">⚠ Not Available (${data.notFoundMedicines.length})</p>
                    <div class="space-y-2">`;
                data.notFoundMedicines.forEach(name => {
                    html += `<div class="flex items-center gap-3 p-3 bg-amber-50 rounded-xl border border-amber-100">
                        <i data-lucide="alert-circle" class="w-4 h-4 text-amber-500 shrink-0"></i>
                        <p class="text-sm font-bold text-slate-700">${name}</p>
                        <span class="ml-auto text-[10px] font-semibold text-amber-600 bg-amber-100 px-2 py-1 rounded-full">Not Available</span>
                    </div>`;
                });
                html += `</div></div>`;
            }

            if (!data.foundMedicines?.length && !data.notFoundMedicines?.length) {
                html = '<p class="text-slate-500 text-center py-4">No medicines detected in the prescription. Please try a clearer image.</p>';
            }

            document.getElementById('rxScanResultContent').innerHTML = html;
            document.getElementById('rxScanResult').classList.remove('hidden');
            if (window.lucide) lucide.createIcons();

        } catch(err) {
            document.getElementById('rxScanResultContent').innerHTML = `<p class="text-red-500 font-bold">❌ Scan failed: ${err.message}</p>`;
            document.getElementById('rxScanResult').classList.remove('hidden');
        } finally {
            btn.innerHTML = originalText;
            btn.disabled = false;
        }
    }

    function addRxMedToCart(id, name, price, brand, imageUrl) {
        PharmacyCart.addItem({ id, name, price, brand, imageUrl });
        // Visual feedback
        const btns = document.querySelectorAll(`.rxAddBtn[data-id="${id}"]`);
        btns.forEach(btn => {
            btn.textContent = '✓ Added';
            btn.classList.remove('bg-emerald-600', 'hover:bg-emerald-700');
            btn.classList.add('bg-slate-400');
            btn.disabled = true;
        });
    }

    function addAllRxToCart() {
        const btns = document.querySelectorAll('.rxAddBtn:not([disabled])');
        btns.forEach(btn => btn.click());
    }
</script>

<!-- Prescription Upload Modal -->
<div id="prescriptionModal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="bg-white rounded-[2.5rem] shadow-2xl w-full max-w-lg mx-auto overflow-hidden flex flex-col max-h-[90vh]">
        <!-- Header -->
        <div class="flex items-center justify-between px-8 pt-8 pb-4">
            <div class="flex items-center gap-4">
                <div class="w-12 h-12 bg-blue-600 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-blue-600/30">
                    <i data-lucide="scan-line" class="w-6 h-6"></i>
                </div>
                <div>
                    <h2 class="text-lg font-semibold text-slate-900">AI Prescription Scan</h2>
                    <p class="text-xs text-slate-400">MedLink AI · Smart Medicine Detection</p>
                </div>
            </div>
            <button onclick="closePrescriptionModal()" class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition-all border border-slate-100">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>

        <div class="px-8 pb-8 overflow-y-auto flex-1 space-y-5">
            <!-- Dropzone -->
            <div id="rxDropzone" class="border-2 border-dashed border-slate-200 rounded-2xl p-8 text-center cursor-pointer hover:border-blue-400 hover:bg-blue-50/30 transition-all group">
                <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:bg-blue-100 transition-all">
                    <i data-lucide="upload-cloud" class="w-7 h-7 text-blue-500"></i>
                </div>
                <p class="font-bold text-slate-700 mb-1">Drop prescription here or click to upload</p>
                <p class="text-xs text-slate-400">JPG, PNG, WEBP up to 20MB</p>
                <input type="file" id="rxFileInput" accept="image/*" class="hidden">
            </div>

            <!-- Preview -->
            <div id="rxPreview" class="hidden">
                <div class="relative rounded-2xl overflow-hidden border border-slate-100 shadow-sm">
                    <img id="rxPreviewImg" src="" alt="Prescription" class="w-full max-h-48 object-contain bg-slate-50">
                    <button onclick="document.getElementById('rxFileInput').click()" class="absolute top-3 right-3 px-3 py-1.5 bg-white/90 backdrop-blur-sm text-slate-700 text-xs font-bold rounded-xl border border-slate-200 hover:bg-white transition-all shadow-sm">
                        Change
                    </button>
                </div>
            </div>

            <!-- Scan Button -->
            <button id="rxScanBtn" onclick="scanPrescription()" disabled
                class="w-full py-4 bg-blue-600 text-white font-semibold rounded-2xl hover:bg-blue-700 disabled:opacity-40 disabled:cursor-not-allowed transition-all shadow-lg shadow-blue-600/20 flex items-center justify-center gap-2">
                <i data-lucide="brain-circuit" class="w-5 h-5"></i> Scan & Find Medicines
            </button>

            <!-- Results -->
            <div id="rxScanResult" class="hidden space-y-4">
                <div class="border-t border-slate-100 pt-4">
                    <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-4">Scan Results</p>
                    <div id="rxScanResultContent"></div>
                </div>

                <!-- Add all to cart + go to checkout -->
                <div class="flex gap-3 pt-2">
                    <button onclick="addAllRxToCart()"
                        class="flex-1 py-3 bg-emerald-600 text-white font-semibold text-sm rounded-xl hover:bg-emerald-700 transition-all shadow-lg shadow-emerald-600/20">
                        Add All to Cart
                    </button>
                    <button onclick="closePrescriptionModal(); window.location.href='/Pharmacy/CartCheckout?cart=1'"
                        class="flex-1 py-3 bg-slate-900 text-white font-semibold text-sm rounded-xl hover:bg-black transition-all">
                        Go to Checkout →
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        lucide.createIcons();
        
        var swiper = new Swiper(".mySwiper", {
            spaceBetween: 30,
            effect: "fade",
            loop: true,
            autoplay: {
                delay: 5000,
                disableOnInteraction: false,
            },
            pagination: {
                el: ".swiper-pagination",
                clickable: true,
            },
            navigation: {
                nextEl: ".swiper-button-next-custom",
                prevEl: ".swiper-button-prev-custom",
            },
        });
    });
</script>
