<section class="py-24 px-12 bg-white flex flex-col justify-center">
    <div class="max-w-xl mx-auto lg:ml-auto lg:mr-0 fade-right" data-animate>
        <div class="inline-flex items-center gap-2 text-indigo-600 font-bold mb-6 text-sm">
            <i data-lucide="users" class="w-5 h-5"></i>
            FOR PROVIDERS
        </div>
        <h2 class="text-4xl font-bold text-gray-900 mb-6 leading-tight">Empower your practice <br /> with digital tools.</h2>
        <p class="text-gray-600 mb-10 text-lg leading-relaxed">
            Manage your patients effortlessly with an intuitive admin dashboard. Track progress, review
            diagnostics, and conduct consultations from anywhere in the world.
        </p>

        <div class="space-y-6 stagger-children" data-animate>
            @{
                var tools = new[]
                {
                        new { Title = "Unified Patient Dashboard", Icon = "layout-dashboard" },
                        new { Title = "Seamless Record Review", Icon = "check-circle" },
                        new { Title = "Practice Insights & Growth", Icon = "trending-up" }
                        };
            }

            @foreach (var tool in tools)
            {
                <div class="flex items-center gap-4 p-5 rounded-2xl bg-gray-50 border border-gray-100 group hover:border-indigo-200 transition-colors fade-up" data-animate>
                    <div class="bg-indigo-600 text-white p-2.5 rounded-xl shadow-md group-hover:scale-110 transition-transform">
                        <i data-lucide="@tool.Icon" class="w-4.5 h-4.5"></i>
                    </div>
                    <span class="font-bold text-gray-800">@tool.Title</span>
                </div>
            }
        </div>
    </div>
</section>