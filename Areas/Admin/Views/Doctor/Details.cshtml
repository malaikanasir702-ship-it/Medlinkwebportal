@model MedLinkPortal.Areas.Doctor.Controllers.ProfileViewModel
@{
    ViewData["Title"] = "Doctor Details";
}

<div class="min-h-screen bg-slate-50 pb-20">
    <div class="max-w-7xl mx-auto px-6 py-10">
        <!-- Header -->
        <div class="flex items-center justify-between mb-10">
            <div>
                <a asp-action="Index" class="inline-flex items-center gap-2 text-slate-400 font-bold uppercase tracking-widest text-[10px] hover:text-blue-600 transition-colors mb-4">
                    <i class="fas fa-arrow-left"></i> Back to Registry
                </a>
                <h1 class="text-4xl font-semibold text-slate-900 tracking-tighter">
                    Physician <span class="text-blue-600">Dossier</span>
                </h1>
                <p class="text-slate-500 font-medium mt-2">Comprehensive profile verification data.</p>
            </div>
            <div class="flex gap-4">
                 @if (Model.ApprovalStatus != "Approved")
                {
                    <button id="btnApprove" class="px-8 py-4 bg-emerald-500 text-white rounded-2xl text-xs font-semibold uppercase tracking-widest hover:bg-emerald-600 transition-all shadow-xl shadow-emerald-500/20 flex items-center gap-3">
                        <i class="fas fa-check-circle text-lg"></i> Authenticate
                    </button>
                }
                 @if (Model.ApprovalStatus != "Rejected")
                {
                    <button id="btnReject" class="px-8 py-4 bg-white border border-slate-200 text-rose-500 rounded-2xl text-xs font-semibold uppercase tracking-widest hover:bg-rose-50 hover:border-rose-100 transition-all flex items-center gap-3">
                        <i class="fas fa-ban text-lg"></i> Reject
                    </button>
                }
            </div>
        </div>

        <!-- Completion Overview -->
        <div class="bg-white rounded-[32px] p-8 md:p-12 shadow-sm border border-slate-100 mb-8">
            <div class="flex items-center gap-8 md:gap-12">
                <div class="relative">
                     <div class="w-32 h-32 rounded-3xl bg-slate-100 p-1 flex items-center justify-center overflow-hidden">
                        @if(!string.IsNullOrEmpty(Model.ProfilePictureUrl)) {
                            <img src="~/@Model.ProfilePictureUrl" class="w-full h-full object-cover rounded-2xl" />
                        } else {
                            <i class="fas fa-user-md text-4xl text-slate-300"></i>
                        }
                    </div>
                </div>
                <div class="flex-1">
                     <div class="flex items-center justify-between mb-4">
                        <div>
                            <h2 class="text-2xl font-semibold text-slate-900">@Model.Name</h2>
                            <p class="text-slate-400 font-bold uppercase text-[10px] tracking-widest mt-1">
                                @Model.Specialist • @Model.Workplace
                            </p>
                        </div>
                        <div class="text-right">
                             <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Status</p>
                             @if (Model.ApprovalStatus == "Approved") {
                                <span class="inline-flex items-center gap-2 text-emerald-500 font-semibold text-sm uppercase tracking-wider">
                                    <i class="fas fa-check-circle"></i> Verified
                                </span>
                             } else if (Model.ApprovalStatus == "Rejected") {
                                 <span class="inline-flex items-center gap-2 text-rose-500 font-semibold text-sm uppercase tracking-wider">
                                    <i class="fas fa-times-circle"></i> Rejected
                                </span>
                             } else {
                                  <span class="inline-flex items-center gap-2 text-amber-500 font-semibold text-sm uppercase tracking-wider">
                                    <i class="fas fa-clock"></i> Pending
                                </span>
                             }
                        </div>
                     </div>
                     
                     <div class="space-y-2">
                        <div class="flex justify-between text-[10px] font-semibold uppercase tracking-widest">
                            <span class="text-slate-500">Profile Completeness</span>
                            <span class="@(Model.CompletionPercentage == 100 ? "text-emerald-500" : "text-amber-500")">@Model.CompletionPercentage%</span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-2">
                            <div class="h-2 rounded-full transition-all duration-500 @(Model.CompletionPercentage == 100 ? "bg-emerald-500" : "bg-amber-500")" 
                                 style="width: @Model.CompletionPercentage%"></div>
                        </div>
                        @if (Model.CompletionPercentage < 100) {
                            <p class="text-[10px] font-bold text-rose-500 mt-2">
                                <i class="fas fa-exclamation-circle mr-1"></i> Cannot approve until profile is 100% complete.
                            </p>
                        }
                     </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Personal Info -->
            <div class="bg-white rounded-[32px] p-8 shadow-sm border border-slate-100">
                <div class="flex items-center gap-3 mb-8">
                    <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-600">
                        <i class="fas fa-user"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-slate-900 tracking-tight">Identity Details</h3>
                </div>
                <div class="space-y-6">
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Full Name</label>
                            <p class="text-sm font-bold text-slate-700">@Model.Name</p>
                        </div>
                        <div>
                            <label class="block text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Father/Husband</label>
                            <p class="text-sm font-bold text-slate-700">@(Model.FatherHusbandName ?? "-")</p>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                         <div>
                            <label class="block text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Gender</label>
                            <p class="text-sm font-bold text-slate-700">@(Model.Gender ?? "-")</p>
                        </div>
                         <div>
                            <label class="block text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-1">CNIC</label>
                            <p class="text-sm font-mono font-bold text-slate-700">@(Model.CNIC ?? "-")</p>
                        </div>
                    </div>
                    <div>
                        <label class="block text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Residential Address</label>
                        <p class="text-sm font-bold text-slate-700">@(Model.ResidentialAddress ?? "-")</p>
                    </div>
                </div>
            </div>

            <!-- Professional Info -->
             <div class="bg-white rounded-[32px] p-8 shadow-sm border border-slate-100">
                 <div class="flex items-center gap-3 mb-8">
                    <div class="w-10 h-10 rounded-xl bg-indigo-500/10 flex items-center justify-center text-indigo-600">
                        <i class="fas fa-user-md"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-slate-900 tracking-tight">Professional Credentials</h3>
                </div>
                <div class="space-y-6">
                     <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-1">PMDC Reg No</label>
                            <p class="text-sm font-mono font-bold text-slate-700">@(Model.PMDCRegistrationNumber ?? "-")</p>
                        </div>
                        <div>
                            <label class="block text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Validity</label>
                            <p class="text-sm font-bold text-slate-700">@(Model.PMDCValidityDate?.ToString("MMM dd, yyyy") ?? "-")</p>
                        </div>
                    </div>
                     <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Specialty</label>
                            <p class="text-sm font-bold text-slate-700">@(Model.Specialist ?? "-")</p>
                        </div>
                        <div>
                            <label class="block text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Experience</label>
                            <p class="text-sm font-bold text-slate-700">@Model.Experience</p>
                        </div>
                    </div>
                    <div>
                        <label class="block text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Qualification</label>
                        <p class="text-sm font-bold text-slate-700">@(Model.Qualification ?? "-")</p>
                    </div>
                </div>
            </div>

             <!-- Documents -->
            <div class="md:col-span-2 bg-white rounded-[32px] p-8 shadow-sm border border-slate-100">
                <div class="flex items-center gap-3 mb-8">
                    <div class="w-10 h-10 rounded-xl bg-slate-900/5 flex items-center justify-center text-slate-900">
                        <i class="fas fa-file-contract"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-slate-900 tracking-tight">Verification Documents</h3>
                </div>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                    @* Helper for Doc Card *@
                    @if(!string.IsNullOrEmpty(Model.CNICFrontUrl)) {
                        <a href="~/@Model.CNICFrontUrl" target="_blank" class="block group">
                            <div class="aspect-video bg-slate-100 rounded-2xl overflow-hidden relative border border-slate-200">
                                <img src="~/@Model.CNICFrontUrl" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity text-white text-xs font-bold uppercase tracking-widest">
                                    View
                                </div>
                            </div>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-2 text-center">CNIC Front</p>
                        </a>
                    } else {
                         <div class="aspect-video bg-slate-50 rounded-2xl border-2 border-dashed border-slate-200 flex items-center justify-center flex-col gap-2">
                             <i class="fas fa-times text-slate-300"></i>
                             <span class="text-[9px] font-semibold text-slate-300 uppercase tracking-widest">Missing</span>
                         </div>
                    }

                    @if(!string.IsNullOrEmpty(Model.CNICBackUrl)) {
                         <a href="~/@Model.CNICBackUrl" target="_blank" class="block group">
                            <div class="aspect-video bg-slate-100 rounded-2xl overflow-hidden relative border border-slate-200">
                                <img src="~/@Model.CNICBackUrl" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity text-white text-xs font-bold uppercase tracking-widest">
                                    View
                                </div>
                            </div>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-2 text-center">CNIC Back</p>
                        </a>
                    } else {
                        <div class="aspect-video bg-slate-50 rounded-2xl border-2 border-dashed border-slate-200 flex items-center justify-center flex-col gap-2">
                             <i class="fas fa-times text-slate-300"></i>
                             <span class="text-[9px] font-semibold text-slate-300 uppercase tracking-widest">Missing</span>
                         </div>
                    }

                    @if(!string.IsNullOrEmpty(Model.PMDCCertificateUrl)) {
                         <a href="~/@Model.PMDCCertificateUrl" target="_blank" class="block group">
                            <div class="aspect-video bg-slate-100 rounded-2xl overflow-hidden relative border border-slate-200">
                                <img src="~/@Model.PMDCCertificateUrl" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity text-white text-xs font-bold uppercase tracking-widest">
                                    View
                                </div>
                            </div>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-2 text-center">PMDC Cert</p>
                        </a>
                    } else {
                        <div class="aspect-video bg-slate-50 rounded-2xl border-2 border-dashed border-slate-200 flex items-center justify-center flex-col gap-2">
                             <i class="fas fa-times text-slate-300"></i>
                             <span class="text-[9px] font-semibold text-slate-300 uppercase tracking-widest">Missing</span>
                         </div>
                    }

                     @if(!string.IsNullOrEmpty(Model.DegreeCertificateUrl)) {
                         <a href="~/@Model.DegreeCertificateUrl" target="_blank" class="block group">
                            <div class="aspect-video bg-slate-100 rounded-2xl overflow-hidden relative border border-slate-200">
                                <img src="~/@Model.DegreeCertificateUrl" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity text-white text-xs font-bold uppercase tracking-widest">
                                    View
                                </div>
                            </div>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-2 text-center">Degree</p>
                        </a>
                    } else {
                        <div class="aspect-video bg-slate-50 rounded-2xl border-2 border-dashed border-slate-200 flex items-center justify-center flex-col gap-2">
                             <i class="fas fa-times text-slate-300"></i>
                             <span class="text-[9px] font-semibold text-slate-300 uppercase tracking-widest">Missing</span>
                         </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const userId = '@Model.NewPassword'; // UserId passed in this field for simplicity

            $('#btnApprove').on('click', function() {
                const $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Processing');
                
                $.ajax({
                    url: '/Admin/Doctor/Approve',
                    type: 'POST',
                    data: { userId: userId },
                    success: function() {
                        location.reload();
                    },
                    error: function(xhr) {
                         $btn.prop('disabled', false).html('<i class="fas fa-check-circle text-lg"></i> Authenticate');
                         alert(xhr.responseJSON?.message || 'Failed to approve');
                    }
                });
            });

            $('#btnReject').on('click', function() {
                if(!confirm('Are you sure you want to reject this application?')) return;
                
                 const $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Processing');

                $.ajax({
                    url: '/Admin/Doctor/Reject',
                    type: 'POST',
                    data: { userId: userId },
                    success: function() {
                        location.reload();
                    },
                    error: function(xhr) {
                        $btn.prop('disabled', false).html('<i class="fas fa-ban text-lg"></i> Reject');
                        alert(xhr.responseJSON?.message || 'Failed to reject');
                    }
                });
            });
        });
    </script>
}
