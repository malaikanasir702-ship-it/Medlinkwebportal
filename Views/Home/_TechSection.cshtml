<section class="py-24 px-6 bg-gray-50 border-y border-gray-100">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16 fade-down" data-animate>
            <h2 class="text-sm font-bold text-gray-500 uppercase tracking-widest mb-4">Under the Hood</h2>
            <h3 class="text-4xl font-bold text-gray-900">World-class Infrastructure.</h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 stagger-children" data-animate>
            @{
                var specs = new[]
                {
                        new { Icon = "cpu", Title = "React Architecture",
                        Desc = "High-performance component structure for seamless navigation." },
                        new { Icon = "maximize", Title = "Hyper-Scalable",
                        Desc = "Cloud-native design built to handle millions of concurrent patients." },
                        new { Icon = "zap", Title = "Zero Lag",
                        Desc = "Optimized for speed and low latency across global data nodes." },
                        new { Icon = "refresh-cw", Title = "Always Syncing",
                        Desc = "Real-time data synchronization between providers and patients." }
                        };
            }

            @foreach (var spec in specs)
            {
                <div class="text-center zoom-in" data-animate>
                    <div class="w-16 h-16 rounded-2xl bg-white shadow-md flex items-center justify-center text-blue-600 mx-auto mb-6">
                        <i data-lucide="@spec.Icon" class="w-8 h-8"></i>
                    </div>
                    <h4 class="text-lg font-bold text-gray-900 mb-2">@spec.Title</h4>
                    <p class="text-gray-500 text-sm leading-relaxed">@spec.Desc</p>
                </div>
            }
        </div>
    </div>
</section>