@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    var doctor = Model.SelectedDoctor;
    ViewData["Title"] = $"Dr. {doctor.Name} - Profile";
    ViewData["HeaderTitle"] = "Specialist Profile";
    ViewData["HeaderSubtitle"] = "Your health is our priority.";
    
    var imageUrl = !string.IsNullOrEmpty(doctor.Image) 
        ? doctor.Image 
        : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(doctor.Name)}&size=400&background=random&color=fff&bold=true";
}

<div class="max-w-6xl mx-auto pb-20 space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <!-- Navigation & Meta -->
    <div class="flex items-center justify-between">
        <a href="@Url.Action("Doctors", "Dashboard")" class="group flex items-center gap-2 text-gray-400 hover:text-blue-600 font-bold text-xs uppercase tracking-widest transition-all">
            <div class="p-2 bg-white border border-gray-100 rounded-xl group-hover:border-blue-100 group-hover:shadow-md transition-all">
                <i data-lucide="arrow-left" class="w-4 h-4 group-hover:-translate-x-1 transition-transform"></i>
            </div>
            Back to Directory
        </a>
        <div class="flex items-center gap-3">
             <button onclick="shareProfile()" class="p-2.5 bg-white border border-gray-100 rounded-xl text-gray-400 hover:text-blue-600 hover:border-blue-100 transition-all shadow-sm" title="Share Profile">
                <i data-lucide="share-2" class="w-4 h-4"></i>
            </button>
            <button id="wishlistBtn" onclick="toggleWishlist(@doctor.Id, '@doctor.Name.Replace("'", "\\'")', '@doctor.Specialty.Replace("'", "\\'")', '@imageUrl')" class="p-2.5 bg-white border border-gray-100 rounded-xl text-gray-400 hover:text-rose-500 hover:border-rose-100 transition-all shadow-sm" title="Add to Wishlist">
                <i data-lucide="heart" class="w-4 h-4"></i>
            </button>
        </div>
    </div>

    <!-- Immersive Header Section -->
    <div class="relative group">
        <!-- Abstract Background Decoration -->
        <div class="absolute -inset-1 bg-gradient-to-r from-blue-600/20 to-indigo-600/20 rounded-[2.5rem] blur-2xl opacity-50 group-hover:opacity-75 transition-opacity duration-500"></div>
        
        <div class="relative bg-white/70 backdrop-blur-3xl border border-white/50 rounded-[2.5rem] p-6 md:p-10 shadow-2xl shadow-blue-900/5 transition-all">
            <div class="flex flex-col lg:flex-row gap-10 items-center lg:items-start text-center lg:text-left">
                <!-- Profile Image & Status -->
                <div class="relative">
                    <div class="w-40 h-40 md:w-56 md:h-56 rounded-[2rem] overflow-hidden shadow-2xl border-4 border-white relative">
                        <img src="@imageUrl" class="w-full h-full object-cover scale-105 group-hover:scale-110 transition-transform duration-700">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>
                    </div>
                    @if(doctor.Online) {
                        <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 bg-white border border-gray-100 px-4 py-1.5 rounded-full shadow-xl flex items-center gap-2 whitespace-nowrap">
                            <span class="relative flex h-2.5 w-2.5">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                            </span>
                            <span class="text-[10px] font-semibold text-gray-900 uppercase tracking-widest">Active Now</span>
                        </div>
                    }
                </div>

                <!-- Main Info -->
                <div class="flex-1 space-y-6">
                    <div>
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-100 text-[10px] font-semibold uppercase tracking-widest text-blue-600 mb-4">
                            Verified Specialist
                        </div>
                        <h1 class="text-4xl md:text-5xl font-semibold text-gray-900 tracking-tight leading-none mb-4">@doctor.Name</h1>
                        <p class="text-xl md:text-2xl font-bold bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">@doctor.Specialty</p>
                        <p class="text-sm font-medium text-gray-400 mt-2 uppercase tracking-widest leading-loose">@doctor.Qualification</p>
                    </div>

                    <!-- Trust Bento Cards -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="p-4 bg-gray-50/50 rounded-2xl border border-gray-100 flex flex-col items-center lg:items-start gap-1 group/stat">
                            <span class="text-2xl font-semibold text-gray-900 group-hover/stat:text-blue-600 transition-colors">@doctor.Rating <span class="text-amber-400 text-lg">★</span></span>
                            <span class="text-[9px] font-semibold text-gray-400 uppercase tracking-widest">Global Rating</span>
                        </div>
                        <div class="p-4 bg-gray-50/50 rounded-2xl border border-gray-100 flex flex-col items-center lg:items-start gap-1 group/stat">
                            <span class="text-2xl font-semibold text-gray-900">@doctor.Experience</span>
                            <span class="text-[9px] font-semibold text-gray-400 uppercase tracking-widest">Experience</span>
                        </div>
                        <div class="p-4 bg-gray-50/50 rounded-2xl border border-gray-100 flex flex-col items-center lg:items-start gap-1 group/stat">
                            <span class="text-2xl font-semibold text-gray-900">@doctor.Reviews.ToString("N0")</span>
                            <span class="text-[9px] font-semibold text-gray-400 uppercase tracking-widest">Recoveries</span>
                        </div>
                        <div class="p-4 bg-gray-50/50 rounded-2xl border border-gray-100 flex flex-col items-center lg:items-start gap-1 group/stat">
                            <div class="flex -space-x-2">
                                @for(int i=0; i<3; i++) {
                                    <img src="https://i.pravatar.cc/100?u=@i" class="w-7 h-7 rounded-full border-2 border-white grayscale opacity-70">
                                }
                            </div>
                            <span class="text-[9px] font-semibold text-gray-400 uppercase tracking-widest mt-1">Trusted By Many</span>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-4 justify-center lg:justify-start pt-4">
                        <a href="@Url.Action("BookAppointment", "Dashboard", new { doctorId = doctor.Id })" class="px-8 py-4 bg-gray-900 text-white rounded-2xl font-semibold text-sm uppercase tracking-widest shadow-xl shadow-gray-900/10 hover:bg-blue-600 hover:-translate-y-1 active:scale-95 transition-all">
                            Instant Booking
                        </a>
                        <button class="px-6 py-4 bg-white border border-gray-200 text-gray-900 rounded-2xl font-semibold text-sm uppercase tracking-widest hover:border-blue-200 hover:bg-blue-50/50 transition-all flex items-center gap-2 group/btn">
                            <i data-lucide="message-square" class="w-4 h-4 group-hover/btn:scale-110 transition-transform"></i>
                            Quick Consult
                        </button>
                        @{
                            var latestAppt = Model.UpcomingConsultations?.FirstOrDefault(a => a.DoctorId == doctor.Id) ?? Model.UpcomingConsultations?.FirstOrDefault();
                            int apptId = latestAppt != null ? latestAppt.Id : 0;
                        }
                        <a href="@Url.Action("ClinicVisitDetails", "Dashboard", new { id = apptId })" class="px-6 py-4 bg-emerald-50 border border-emerald-200 text-emerald-700 rounded-2xl font-semibold text-sm uppercase tracking-widest hover:border-emerald-300 hover:bg-emerald-100 transition-all flex items-center gap-2 group/btn">
                            <i data-lucide="clipboard-list" class="w-4 h-4 group-hover/btn:scale-110 transition-transform"></i>
                            Clinic Visit Details
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Body -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Left: Details & Trust -->
        <div class="lg:col-span-2 space-y-8">
            <!-- Biography Card -->
            <div class="bg-white rounded-[2rem] p-8 border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-500">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-12 h-12 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-600">
                        <i data-lucide="award" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold text-gray-900">Professional Profile</h3>
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-widest">Summary & Expertise</p>
                    </div>
                </div>
                <p class="text-gray-600 text-base leading-relaxed font-medium mb-8">
                    @doctor.Description
                </p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @if (!string.IsNullOrEmpty(doctor.Expertise))
                    {
                        foreach (var item in doctor.Expertise.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries))
                        {
                            <div class="flex items-center gap-3 p-3 bg-gray-50/50 rounded-xl border border-gray-100">
                                <div class="w-2 h-2 rounded-full bg-blue-500 shadow-[0_0_8px_rgba(59,130,246,0.6)]"></div>
                                <span class="text-xs font-bold text-gray-700">@item.Trim()</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <!-- Hospital Affiliations (Trust Building) -->
            <div class="bg-white rounded-[2rem] p-8 border border-gray-100 shadow-sm relative overflow-hidden group">
                 <!-- ... (existing content) ... -->
                <div class="absolute top-0 right-0 p-8 opacity-5">
                    <i data-lucide="hospital" class="w-24 h-24"></i>
                </div>
                <div class="relative">
                    <div class="flex items-center gap-3 mb-8">
                         <div class="w-12 h-12 bg-emerald-50 rounded-2xl flex items-center justify-center text-emerald-600">
                            <i data-lucide="building-2" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold text-gray-900">Hospital Affiliations</h3>
                            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest">Where Dr. @doctor.Name Practices</p>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        @if (!string.IsNullOrEmpty(doctor.HospitalAffiliations))
                        {
                            foreach (var hospital in doctor.HospitalAffiliations.Split(','))
                            {
                                <div class="p-6 bg-gray-50/50 rounded-3xl border border-gray-100 hover:bg-white hover:shadow-xl hover:-translate-y-1 transition-all group/hosp">
                                    <div class="w-10 h-10 bg-white rounded-xl shadow-sm flex items-center justify-center mb-4 group-hover/hosp:scale-110 transition-transform">
                                        <i data-lucide="shield-check" class="w-5 h-5 text-emerald-500"></i>
                                    </div>
                                    <h4 class="text-sm font-bold text-gray-900 leading-snug">@hospital.Trim()</h4>
                                    <div class="inline-flex items-center gap-1.5 mt-3 text-[10px] font-semibold text-emerald-600 uppercase tracking-widest">
                                        Active Privileges <i data-lucide="check" class="w-3 h-3"></i>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- PATIENT REVIEWS SECTION -->
            <div class="bg-white rounded-[2rem] p-8 border border-gray-100 shadow-sm relative overflow-hidden group" x-data="reviewForm(@doctor.Id)">
                @Html.AntiForgeryToken()
                <div class="flex items-center justify-between mb-8">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-500">
                            <i data-lucide="star" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold text-gray-900">Patient Reviews</h3>
                            <div class="flex items-center gap-2">
                                <p class="text-xs font-bold text-gray-400 uppercase tracking-widest">@doctor.Reviews Verified Reviews</p>
                                <span class="text-xs text-amber-500 font-bold">@doctor.Rating.ToString("0.0") ★</span>
                            </div>
                        </div>
                    </div>
                    <button @@click="showReviewForm = !showReviewForm" class="px-5 py-2.5 bg-gray-900 text-white rounded-xl text-xs font-semibold uppercase tracking-widest shadow-lg hover:bg-gray-800 transition-all flex items-center gap-2">
                        <i data-lucide="pen-tool" class="w-4 h-4"></i> Write Review
                    </button>
                </div>

                <!-- Review Form -->
                <div x-show="showReviewForm" x-transition class="mb-8 p-6 bg-gray-50 rounded-3xl border border-gray-200">
                    <template x-if="!submitted">
                        <div>
                            <h4 class="text-lg font-bold text-gray-900 mb-4">Share your experience</h4>
                            <div class="flex items-center gap-2 mb-4">
                                <template x-for="i in 5">
                                    <button @@click="rating = i" type="button" class="transition-all hover:scale-125 focus:outline-none group">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" 
                                             class="transition-all duration-300"
                                             :class="rating >= i ? 'text-amber-400 fill-current drop-shadow-[0_0_8px_rgba(251,191,36,0.3)]' : 'text-gray-200 group-hover:text-amber-200'"
                                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                             <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                        </svg>
                                    </button>
                                </template>
                            </div>
                            <textarea x-model="comment" class="w-full p-4 rounded-xl border-gray-200 focus:border-blue-500 focus:ring-0 text-sm mb-4" rows="3" placeholder="How was your consultation?"></textarea>
                            <button 
                                @@click="submitSubmit()" 
                                :disabled="rating === 0 || !comment || submitting"
                                class="w-full py-3 bg-blue-600 text-white rounded-xl font-bold uppercase tracking-widest text-xs disabled:opacity-50 hover:bg-blue-700 transition-all flex items-center justify-center gap-2">
                                <template x-if="submitting">
                                    <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                                    </svg>
                                </template>
                                <span x-text="submitting ? 'Submitting...' : 'Submit Review'"></span>
                            </button>
                        </div>
                    </template>
                    <template x-if="submitted">
                        <div class="text-center py-6 animate-in zoom-in duration-300">
                            <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4 text-emerald-600">
                                <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                            </div>
                            <h4 class="text-lg font-bold text-gray-900">Thank You!</h4>
                            <p class="text-sm text-gray-500">Your review was submitted successfully.</p>
                        </div>
                    </template>
                </div>

                <!-- Reviews List -->
                <div class="space-y-6" id="reviews-container">
                    @if(doctor.PatientReviews != null && doctor.PatientReviews.Any())
                    {
                        foreach(var review in doctor.PatientReviews.OrderByDescending(r => r.CreatedAt))
                        {
                            <div class="p-6 bg-gray-50/50 rounded-3xl border border-gray-100">
                                <div class="flex items-center justify-between mb-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 bg-blue-100 rounded-full flex items-center justify-center text-blue-600 font-bold text-xs">
                                            @review.PatientName.Substring(0,1)
                                        </div>
                                        <div>
                                            <h5 class="text-sm font-bold text-gray-900">@review.PatientName</h5>
                                            <span class="text-[10px] text-gray-400 font-bold uppercase">@review.CreatedAt.ToString("MMM dd, yyyy")</span>
                                        </div>
                                    </div>
                                    <div class="flex gap-0.5">
                                        @for(int i=0; i<review.Rating; i++) { <i data-lucide="star" class="w-3 h-3 text-amber-400 fill-current"></i> }
                                    </div>
                                </div>
                                <p class="text-sm text-gray-600 italic">"@review.Comment"</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-10">
                            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4 text-gray-400">
                                <i data-lucide="message-square-off" class="w-8 h-8"></i>
                            </div>
                            <p class="text-gray-500 font-medium">No reviews yet. Be the first to share your experience!</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Real-time Data & Location -->
        <div class="space-y-8">
            <!-- Availability Insight -->
            <div class="bg-gray-900 rounded-[2rem] p-8 text-white shadow-2xl relative overflow-hidden group">
                <div class="absolute -top-10 -right-10 w-40 h-40 bg-blue-600/20 rounded-full blur-3xl"></div>
                <div class="relative z-10">
                    <h3 class="text-lg font-semibold mb-6 flex items-center gap-2">
                        <i data-lucide="clock" class="w-5 h-5 text-blue-400"></i>
                        Availability
                    </h3>
                    <div class="p-5 bg-white/5 rounded-2xl border border-white/10 mb-8 backdrop-blur-sm">
                        <p class="text-[10px] font-semibold text-blue-400 uppercase tracking-widest mb-1">Status</p>
                        @if (ViewBag.NextAvailableSlot != null)
                        {
                            var nextSlot = (MedLinkPortal.Areas.Doctor.Models.DoctorAvailabilitySlot)ViewBag.NextAvailableSlot;
                            <p class="text-xl font-bold">Next Available: @nextSlot.DayOfWeek</p>
                            <p class="text-sm font-medium text-gray-300 mt-2">@nextSlot.StartTime.ToString(@"hh\:mm") - @nextSlot.EndTime.ToString(@"hh\:mm")</p>
                        }
                        else
                        {
                            <p class="text-xl font-bold">@doctor.Availability</p>
                        }
                    </div>
                    <div class="space-y-4">
                        @if (ViewBag.AvailabilitySlots != null && ((List<MedLinkPortal.Areas.Doctor.Models.DoctorAvailabilitySlot>)ViewBag.AvailabilitySlots).Any())
                        {
                            var slots = (List<MedLinkPortal.Areas.Doctor.Models.DoctorAvailabilitySlot>)ViewBag.AvailabilitySlots;
                            var groupedSlots = slots.GroupBy(s => s.DayOfWeek).Take(5);
                            
                            foreach (var dayGroup in groupedSlots)
                            {
                                var firstSlot = dayGroup.First();
                                var lastSlot = dayGroup.Last();
                                <div class="flex justify-between items-center text-xs font-bold">
                                    <span class="text-gray-400 uppercase tracking-widest">@dayGroup.Key</span>
                                    <span>@firstSlot.StartTime.ToString(@"hh\:mm") - @lastSlot.EndTime.ToString(@"hh\:mm")</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <p class="text-xs font-medium text-gray-400">No availability slots configured</p>
                            </div>
                        }
                    </div>
                    <button class="w-full mt-10 py-4 bg-blue-600 rounded-2xl font-semibold text-xs uppercase tracking-widest transition-all hover:bg-blue-500 hover:shadow-lg hover:shadow-blue-500/20">
                        Check All Slots
                    </button>
                </div>
            </div>

            <!-- Enhanced Location Tracker -->
            <div class="bg-white rounded-[2rem] p-8 border border-gray-100 shadow-sm relative group overflow-hidden">
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-12 h-12 bg-rose-50 rounded-2xl flex items-center justify-center text-rose-500">
                        <i data-lucide="map-pin" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold text-gray-900">Clinic Location</h3>
                        <p class="text-xs font-bold text-gray-400 uppercase tracking-widest">Verified Address</p>
                    </div>
                </div>

                <div class="space-y-6">
                    <div class="p-5 bg-gray-50 rounded-2xl border border-gray-100">
                        <p class="text-[10px] font-semibold text-rose-500 uppercase tracking-widest mb-1">@(doctor.ClinicName ?? "Main Medical Center")</p>
                        <p class="text-sm font-bold text-gray-900 leading-relaxed capitalize">
                             @(doctor.ClinicAddress ?? "MedLink Central Clinic, 123 Health Ave, Medical District")
                        </p>
                    </div>

                    <!-- Interactive Map Preview -->
                    <div class="w-full h-48 rounded-[2rem] overflow-hidden border border-gray-100 shadow-inner relative group/map">
                        @if (!string.IsNullOrEmpty(doctor.ClinicMapUrl) && doctor.ClinicMapUrl.StartsWith("https://www.google.com/maps/embed"))
                        {
                            <iframe src="@doctor.ClinicMapUrl" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                        }
                        else
                        {
                            <img src="https://images.unsplash.com/photo-1569336415962-a4bd9f69cd83?auto=format&fit=crop&q=80&w=400" class="w-full h-full object-cover grayscale opacity-40 group-hover/map:opacity-60 transition-opacity">
                            <div class="absolute inset-0 flex items-center justify-center bg-black/5 backdrop-blur-[2px] text-center p-4">
                                <p class="text-[9px] font-semibold text-slate-500 uppercase tracking-widest">Map View Unavailable</p>
                            </div>
                        }
                    </div>

                    <a href="https://maps.google.com/maps?q=@Uri.EscapeDataString(doctor.ClinicAddress ?? doctor.ClinicName ?? doctor.Name)" target="_blank" class="flex items-center justify-center gap-2 w-full py-3 border border-gray-100 rounded-xl text-xs font-semibold text-gray-500 uppercase tracking-widest hover:bg-gray-50 transition-all">
                        <i data-lucide="navigation" class="w-3.5 h-3.5"></i> Get Directions
                    </a>
                </div>
            </div>

            <!-- Quick Contacts -->
            <div class="grid grid-cols-2 gap-4">
                 <div class="p-4 bg-white border border-gray-100 rounded-3xl flex flex-col items-center gap-2 hover:border-blue-200 transition-all cursor-pointer">
                    <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center text-blue-600">
                        <i data-lucide="phone" class="w-5 h-5"></i>
                    </div>
                    <span class="text-[9px] font-semibold uppercase tracking-widest text-gray-400">Call Clinic</span>
                </div>
                <div class="p-4 bg-white border border-gray-100 rounded-3xl flex flex-col items-center gap-2 hover:border-emerald-200 transition-all cursor-pointer">
                    <div class="w-10 h-10 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-600">
                        <i data-lucide="video" class="w-5 h-5"></i>
                    </div>
                    <span class="text-[9px] font-semibold uppercase tracking-widest text-gray-400">Video Link</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();

        // --- Wishlist Logic ---
        function getWishlist() {
            return JSON.parse(localStorage.getItem('medlink_wishlist') || '[]');
        }

        function updateWishlistIcon(doctorId) {
            const wishlist = getWishlist();
            const btn = document.getElementById('wishlistBtn');
            const icon = btn.querySelector('i');
            
            if (wishlist.some(d => d.id === doctorId)) {
                btn.classList.add('text-rose-500', 'border-rose-100', 'bg-rose-50/50');
                btn.classList.remove('text-gray-400', 'border-gray-100');
                icon.setAttribute('fill', 'currentColor');
            } else {
                btn.classList.remove('text-rose-500', 'border-rose-100', 'bg-rose-50/50');
                btn.classList.add('text-gray-400', 'border-gray-100');
                icon.removeAttribute('fill');
            }
            lucide.createIcons();
        }

        function toggleWishlist(id, name, specialty, image) {
            let wishlist = getWishlist();
            const index = wishlist.findIndex(d => d.id === id);
            
            if (index > -1) {
                wishlist.splice(index, 1);
                showToast('Removed from wishlist', 'info');
            } else {
                wishlist.push({ id, name, specialty, image, addedAt: new Date().toISOString() });
                showToast('Added to wishlist', 'success');
            }
            
            localStorage.setItem('medlink_wishlist', JSON.stringify(wishlist));
            updateWishlistIcon(id);
        }

        // Initialize icon state
        document.addEventListener('DOMContentLoaded', () => {
            updateWishlistIcon(@doctor.Id);
        });

        // --- Share Logic ---
        async function shareProfile() {
            const shareData = {
                title: 'Dr. @doctor.Name | MedLink Portal',
                text: 'Check out Dr. @doctor.Name\'s profile on MedLink Portal. @doctor.Specialty - @doctor.Qualification',
                url: window.location.href
            };

            try {
                if (navigator.share) {
                    await navigator.share(shareData);
                } else {
                    // Fallback to WhatsApp
                    const whatsappUrl = `https://wa.me/?text=${encodeURIComponent(shareData.text + ' ' + shareData.url)}`;
                    window.open(whatsappUrl, '_blank');
                }
            } catch (err) {
                console.error('Error sharing:', err);
                // Copy to clipboard fallback
                navigator.clipboard.writeText(window.location.href);
                showToast('Link copied to clipboard', 'success');
            }
        }

        function showToast(message, type = 'success') {
            // Simple toast implementation
            const toast = document.createElement('div');
            toast.className = `fixed bottom-24 left-1/2 -translate-x-1/2 px-6 py-3 rounded-2xl text-white font-bold text-xs uppercase tracking-widest shadow-2xl z-[100] animate-in slide-in-from-bottom duration-300 ${type === 'success' ? 'bg-emerald-500' : 'bg-blue-500'}`;
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.classList.add('fade-out');
                setTimeout(() => toast.remove(), 300);
            }, 2000);
        }

        function reviewForm(doctorId) {
            return {
                showReviewForm: false,
                rating: 0,
                comment: '',
                submitting: false,
                submitted: false,
                submitSubmit() {
                    if (this.rating === 0 || !this.comment || this.submitting) return;

                    this.submitting = true;
                    const formData = new URLSearchParams();
                    formData.append('doctorId', doctorId);
                    formData.append('rating', this.rating);
                    formData.append('comment', this.comment);

                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

                    fetch('/Reviews/AddReview', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': token
                        },
                        body: formData
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            this.submitted = true;
                            setTimeout(() => {
                                window.location.reload();
                            }, 1500);
                        } else {
                            PremiumModal.error('Failed to submit review: ' + (data.message || 'Unknown error'), 'Buffer Rejection');
                            this.submitting = false;
                        }
                    })
                    .catch(async error => {
                        console.error('Error:', error);
                        await PremiumModal.error('An error occurred while submitting your review to the clinical ledger.', 'Sync Error');
                        this.submitting = false;
                    });
                }
            }
        }
    </script>
}