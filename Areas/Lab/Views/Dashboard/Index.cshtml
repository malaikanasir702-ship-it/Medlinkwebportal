@model List<MedLinkPortal.Models.LabBooking>
@{
    Layout = "_LabLayout";
    ViewData["Title"] = "Operations Center";
}

<div class="space-y-10">
    <!-- Welcome Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h1 class="text-3xl font-semibold text-slate-900 tracking-tight">Welcome back, @ViewBag.LabName</h1>
            <p class="text-slate-500 font-bold mt-1">Here's what's happening in your laboratory today.</p>
        </div>
        <div class="flex items-center gap-3">
            <div class="px-5 py-3 bg-white border border-slate-100 rounded-2xl shadow-sm flex items-center gap-3">
                <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-xs font-semibold text-slate-600 uppercase tracking-widest">Live Terminal</span>
            </div>
            <button onclick="openAddTestModal()" class="bg-indigo-600 text-white p-3 rounded-2xl shadow-lg shadow-indigo-500/20 hover:scale-105 transition-transform">
                <i data-lucide="plus" class="w-6 h-6"></i>
            </button>
        </div>
    </div>

    <!-- Analytics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm relative overflow-hidden group">
            <div class="relative z-10">
                <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center mb-6">
                    <i data-lucide="inbox" class="w-6 h-6"></i>
                </div>
                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Active Requests</p>
                <h3 class="text-3xl font-semibold text-slate-900 mt-2">@ViewBag.TotalBookings</h3>
                <div class="flex items-center gap-2 mt-4 text-emerald-600 font-bold text-xs">
                    <i data-lucide="trending-up" class="w-4 h-4"></i>
                    <span>+12.5%</span>
                </div>
            </div>
            <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-indigo-50/50 rounded-full group-hover:scale-110 transition-transform duration-500"></div>
        </div>

        <div class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm relative overflow-hidden group">
            <div class="relative z-10">
                <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl flex items-center justify-center mb-6">
                    <i data-lucide="truck" class="w-6 h-6"></i>
                </div>
                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Pending Collection</p>
                <h3 class="text-3xl font-semibold text-slate-900 mt-2">@ViewBag.PendingCollections</h3>
                <p class="text-[10px] font-bold text-slate-400 mt-4 uppercase tracking-widest">Requires attention</p>
            </div>
            <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-amber-50/50 rounded-full group-hover:scale-110 transition-transform duration-500"></div>
        </div>

        <div class="bg-white p-8 rounded-[2.5rem] border border-slate-100 shadow-sm relative overflow-hidden group">
            <div class="relative z-10">
                <div class="w-12 h-12 bg-violet-50 text-violet-600 rounded-2xl flex items-center justify-center mb-6">
                    <i data-lucide="microscope" class="w-6 h-6"></i>
                </div>
                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest">In Processing</p>
                <h3 class="text-3xl font-semibold text-slate-900 mt-2">@ViewBag.InProcessing</h3>
                <p class="text-[10px] font-bold text-slate-400 mt-4 uppercase tracking-widest">Lab queue active</p>
            </div>
            <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-violet-50/50 rounded-full group-hover:scale-110 transition-transform duration-500"></div>
        </div>

        <div class="bg-indigo-600 p-8 rounded-[2.5rem] shadow-xl shadow-indigo-200 relative overflow-hidden group">
            <div class="relative z-10">
                <div class="w-12 h-12 bg-white/20 text-white rounded-2xl flex items-center justify-center mb-6 backdrop-blur-md">
                    <i data-lucide="wallet" class="w-6 h-6"></i>
                </div>
                <p class="text-[10px] font-semibold text-white/60 uppercase tracking-widest">Estimated Gross</p>
                <h3 class="text-3xl font-semibold text-white mt-2">Rs. @ViewBag.Revenue.ToString("N0")</h3>
                <div class="inline-flex items-center gap-2 px-3 py-1 bg-white/10 rounded-full text-white/80 font-bold text-[10px] mt-4 backdrop-blur-md">
                    <span>MTD Performance</span>
                </div>
            </div>
            <i data-lucide="circle-dot" class="absolute -right-8 -top-8 w-40 h-40 text-white/5 rotate-12"></i>
        </div>
    </div>

    <!-- Requests Table -->
    <div class="bg-white rounded-[2.5rem] border border-slate-100 shadow-sm overflow-hidden">
        <div class="p-8 border-b border-slate-50 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
                <h3 class="text-xl font-semibold text-slate-900 tracking-tight">Fulfillment Queue</h3>
                <p class="text-xs font-bold text-slate-400 mt-1">Manage sample collections and report uploads</p>
            </div>
            <div class="flex items-center gap-2">
                <div class="relative">
                    <i data-lucide="search" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                    <input type="text" placeholder="Search patient..." class="pl-10 pr-4 py-2.5 bg-slate-50 border-none rounded-xl text-xs font-bold focus:ring-2 ring-indigo-500/20 outline-none w-64 transition-all" />
                </div>
            </div>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left">
                <thead>
                    <tr class="bg-slate-50/50 border-b border-slate-100">
                        <th class="px-8 py-5 text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em]">Patient / ID</th>
                        <th class="px-8 py-5 text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em]">Priority & Slot</th>
                        <th class="px-8 py-5 text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em]">Service Mode</th>
                        <th class="px-8 py-5 text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em]">Fulfillment Status</th>
                        <th class="px-8 py-5 text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] text-right">Operations</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @foreach (var booking in Model)
                    {
                        <tr class="hover:bg-slate-50/50 transition-all group">
                            <td class="px-8 py-7">
                                <div class="flex items-center gap-4">
                                    <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center font-semibold text-sm shadow-sm group-hover:bg-indigo-600 group-hover:text-white transition-all">
                                        @booking.PatientName.Substring(0, 1)
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-slate-900">@booking.PatientName</p>
                                        <p class="text-[10px] font-bold text-indigo-600 uppercase tracking-widest mt-0.5">#LB-@booking.Id.ToString("D5")</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-7">
                                <p class="text-sm font-semibold text-slate-900">@booking.PreferredDate.ToString("MMM dd")</p>
                                <p class="text-[10px] font-bold text-slate-400 uppercase mt-0.5">@booking.PreferredDate.ToString("hh:mm tt") Slot</p>
                            </td>
                            <td class="px-8 py-7">
                                @if(booking.IsHomeCollection) {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-amber-50 rounded-full text-[10px] font-semibold text-amber-600 uppercase tracking-widest border border-amber-100">
                                        <i data-lucide="home" class="w-3 h-3"></i>
                                        Home
                                    </span>
                                } else {
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 rounded-full text-[10px] font-semibold text-blue-600 uppercase tracking-widest border border-blue-100">
                                        <i data-lucide="building" class="w-3 h-3"></i>
                                        Walk-in
                                    </span>
                                }
                            </td>
                            <td class="px-8 py-7">
                                <div class="relative inline-block w-48">
                                    <select onchange="updateStatus(@booking.Id, this.value)" class="w-full bg-slate-50 border border-slate-100 rounded-xl px-4 py-2 text-xs font-semibold text-slate-600 focus:ring-2 ring-indigo-500/10 outline-none appearance-none cursor-pointer transition-all">
                                        @foreach (var status in Enum.GetValues(typeof(MedLinkPortal.Models.LabBookingStatus)))
                                        {
                                            <option value="@((int)status)" selected="@((int)status == (int)booking.Status)">@status</option>
                                        }
                                    </select>
                                    <i data-lucide="chevron-down" class="absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none"></i>
                                </div>
                            </td>
                            <td class="px-8 py-7 text-right">
                                <button onclick="openUploadModal(@booking.Id, '@booking.PatientName')" class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-900 text-white rounded-xl text-xs font-semibold hover:bg-indigo-600 transition-all shadow-md active:scale-95">
                                    <i data-lucide="file-up" class="w-3.5 h-3.5"></i>
                                    Upload Report
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Glass Upload Modal -->
<div id="uploadModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-md">
    <div class="bg-white rounded-[3rem] p-10 max-w-md w-full shadow-2xl relative animate-in zoom-in-95 duration-300 border border-white/20">
        <div class="flex items-center gap-4 mb-8">
            <div class="w-14 h-14 bg-indigo-50 text-indigo-600 rounded-2xl flex items-center justify-center">
                <i data-lucide="clipboard-check" class="w-7 h-7"></i>
            </div>
            <div>
                <h3 class="text-xl font-semibold text-slate-900">Upload Report</h3>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">Ref ID: <span id="modalIdDisplay"></span></p>
            </div>
        </div>

        <p class="text-sm font-bold text-slate-400 mb-8 leading-relaxed">Processing report for <span id="modalPatientName" class="text-indigo-600 font-semibold"></span>. Ensure the PDF is correctly signed and validated.</p>
        
        <form id="uploadForm" onsubmit="handleUpload(event)" class="space-y-6">
            <input type="hidden" id="modalBookingId" name="bookingId" />
            
            <div class="border-2 border-dashed border-slate-100 rounded-[2rem] p-12 text-center hover:border-indigo-300 hover:bg-indigo-50/30 transition-all cursor-pointer group relative" onclick="document.getElementById('fileInput').click()">
                <input type="file" id="fileInput" name="reportFile" class="hidden" required />
                <div class="w-16 h-16 bg-slate-50 text-slate-400 rounded-2xl flex items-center justify-center mx-auto mb-4 group-hover:bg-indigo-600 group-hover:text-white transition-all shadow-sm">
                    <i data-lucide="file-text" class="w-8 h-8"></i>
                </div>
                <p class="text-sm font-semibold text-slate-900">Select PDF Analysis</p>
                <p class="text-[10px] font-bold text-slate-400 mt-2 uppercase tracking-widest">PDF only • 5MB Limit</p>
                <p id="fileNameDisplay" class="text-xs font-semibold text-indigo-600 mt-4 hidden truncate"></p>
            </div>

            <div class="flex gap-4">
                <button type="button" onclick="closeModal()" class="flex-1 py-4 bg-slate-50 text-slate-500 rounded-2xl font-semibold text-xs hover:bg-slate-100 transition-all">Discard</button>
                <button type="submit" class="flex-1 py-4 bg-indigo-600 text-white rounded-2xl font-semibold text-xs shadow-xl shadow-indigo-600/20 hover:bg-indigo-700 transition-all">System Upload</button>
            </div>
        </form>
    </div>
</div>

<!-- Add Test Modal -->
<div id="testModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm">
    <div class="bg-white rounded-[3rem] p-10 max-w-lg w-full shadow-2xl relative border border-white/20 animate-in fade-in zoom-in-95 duration-200">
        <h3 class="text-2xl font-semibold text-slate-900 mb-8 tracking-tight">Launch New Protocol</h3>
        
        <form id="testForm" onsubmit="handleTestSubmit(event)" class="space-y-6">
            <div class="grid grid-cols-2 gap-6">
                <div class="col-span-2 space-y-2">
                    <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest ml-1">Official Test Name</label>
                    <input type="text" name="Name" required class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl font-semibold text-sm focus:ring-2 ring-indigo-500/20 outline-none transition-all" />
                </div>
                
                <div class="space-y-2">
                    <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest ml-1">Market Category</label>
                    <select name="CategoryId" id="categorySelect" required onchange="toggleNewCategoryInput(this, 'newCategoryContainer')" class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl font-semibold text-sm focus:ring-2 ring-indigo-500/20 outline-none transition-all appearance-none">
                        <option value="">Select Category</option>
                        @if (ViewBag.Categories != null) {
                            @foreach(var cat in (List<MedLinkPortal.Models.MedicalTestCategory>)ViewBag.Categories) {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        }
                        <option value="-1" class="text-indigo-600">+ Add New Category...</option>
                    </select>
                </div>

                <div id="newCategoryContainer" class="hidden col-span-2 space-y-2 animate-in fade-in slide-in-from-top-2 duration-300">
                    <label class="text-[10px] font-semibold text-indigo-600 uppercase tracking-widest ml-1">New Category Name</label>
                    <input type="text" name="newCategoryName" placeholder="e.g. Genetics, Cardiology" class="w-full px-5 py-4 bg-indigo-50 border-none rounded-2xl font-semibold text-sm focus:ring-2 ring-indigo-500/20 outline-none transition-all" />
                </div>
                
                <div class="space-y-2">
                    <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest ml-1">Service Fee (PKR)</label>
                    <input type="number" name="Price" required class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl font-semibold text-sm focus:ring-2 ring-indigo-500/20 outline-none transition-all" />
                </div>

                <div class="space-y-2">
                    <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest ml-1">Report TAT</label>
                    <input type="text" name="ReportTime" required placeholder="e.g. 24 Hours" class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl font-semibold text-sm focus:ring-2 ring-indigo-500/20 outline-none transition-all" />
                </div>

                <div class="space-y-2">
                    <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest ml-1">Sample Protocol</label>
                    <input type="text" name="SampleType" required placeholder="e.g. Blood, Urine" class="w-full px-5 py-4 bg-slate-50 border-none rounded-2xl font-semibold text-sm focus:ring-2 ring-indigo-500/20 outline-none transition-all" />
                </div>
            </div>

            <div class="flex gap-4 pt-4">
                <button type="button" onclick="closeTestModal()" class="flex-1 py-4 bg-slate-50 text-slate-500 rounded-2xl font-semibold hover:bg-slate-100 transition-all">Discard</button>
                <button type="submit" class="flex-1 py-4 bg-indigo-600 text-white rounded-2xl font-semibold shadow-xl shadow-indigo-600/20 hover:bg-indigo-700 transition-all">Add Test</button>
            </div>
        </form>
    </div>
</div>

<script>
    function toggleNewCategoryInput(select, containerId) {
        const container = document.getElementById(containerId);
        const input = container.querySelector('input');
        if (select.value === "-1") {
            container.classList.remove('hidden');
            input.required = true;
            input.focus();
        } else {
            container.classList.add('hidden');
            input.required = false;
        }
    }

    function openAddTestModal() {
        document.getElementById('testModal').classList.remove('hidden');
        document.getElementById('testForm').reset();
        document.getElementById('newCategoryContainer').classList.add('hidden');
    }

    function closeTestModal() {
        document.getElementById('testModal').classList.add('hidden');
    }

    function handleTestSubmit(e) {
        e.preventDefault();
        const data = new FormData(e.target);
        
        // Ensure CategoryId is not -1 if we have a new name
        if (data.get('CategoryId') === "-1") {
            data.delete('CategoryId');
        }

        const params = new URLSearchParams();
        for (const pair of data) params.append(pair[0], pair[1]);

        fetch(`@Url.Action("AddTest", "Dashboard", new { area = "Lab" })`, {
            method: 'POST',
            body: params
        }).then(r => r.json()).then(res => {
            if (res.success) {
                location.href = `@Url.Action("Tests", "Dashboard", new { area = "Lab" })`;
            } else {
                alert("Operation failed. Verify category mapping.");
            }
        });
    }

    function updateStatus(id, status) {
        fetch(`@Url.Action("UpdateStatus", "Dashboard", new { area = "Lab" })`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `bookingId=${id}&status=${status}`
        }).then(r => r.json()).then(res => {
            if (res.success) {
                // Status updated
            }
        });
    }

    function openUploadModal(id, name) {
        document.getElementById('modalBookingId').value = id;
        document.getElementById('modalIdDisplay').innerText = `#LB-${id.toString().padStart(5, '0')}`;
        document.getElementById('modalPatientName').innerText = name;
        document.getElementById('uploadModal').classList.remove('hidden');
    }

    function closeModal() {
        document.getElementById('uploadModal').classList.add('hidden');
        document.getElementById('uploadForm').reset();
        document.getElementById('fileNameDisplay').classList.add('hidden');
    }

    document.getElementById('fileInput').onchange = function() {
        if (this.files && this.files[0]) {
            const display = document.getElementById('fileNameDisplay');
            display.innerText = this.files[0].name;
            display.classList.remove('hidden');
        }
    };

    function handleUpload(e) {
        e.preventDefault();
        const formData = new FormData(e.target);
        const submitBtn = e.target.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="animate-pulse">Processing...</span>';
        
        fetch(`@Url.Action("UploadReport", "Dashboard", new { area = "Lab" })`, {
            method: 'POST',
            body: formData
        }).then(r => r.json()).then(res => {
            if (res.success) {
                location.reload();
            } else {
                submitBtn.disabled = false;
                submitBtn.innerText = 'System Upload';
                alert("Upload failed.");
            }
        });
    }
</script>
