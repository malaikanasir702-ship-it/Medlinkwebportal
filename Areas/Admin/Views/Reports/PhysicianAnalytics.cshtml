@model IEnumerable<MedLinkPortal.Models.PhysicianCredentialProfile>
@{
    ViewData["Title"] = "Physician Analytics";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="space-y-8 pb-20 animate-in fade-in duration-500">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 py-4 border-b border-slate-200">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <span class="px-3 py-1 bg-purple-100 text-purple-700 rounded-full text-xs font-bold uppercase tracking-wider flex items-center gap-1.5">
                    <i class="fas fa-user-shield text-purple-600"></i> Phase 3 & 5 Enterprise Analytics
                </span>
                <span class="text-xs text-slate-400 font-mono">Dynamic Credentialing & Performance</span>
            </div>
            <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight">
                Physician <span class="text-purple-600">Analytics</span>
            </h1>
            <p class="text-slate-500 text-base font-medium mt-1">
                Continuous credential verification, CPD compliance, peer distribution, and clinical case volume tracking.
            </p>
        </div>
        <div class="flex items-center gap-3">
            <button onclick="window.print()" class="px-5 py-3 bg-white border border-slate-200 hover:border-purple-300 text-slate-700 rounded-2xl text-xs font-bold transition-all shadow-sm flex items-center gap-2 active:scale-95">
                <i class="fas fa-print text-slate-500"></i> Print Audit
            </button>
        </div>
    </div>

    <!-- Stats Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Average Credential Score</span>
                <div class="w-10 h-10 rounded-2xl bg-purple-100 text-purple-600 flex items-center justify-center text-sm shadow-sm">
                    <i class="fas fa-award"></i>
                </div>
            </div>
            <h3 class="text-3xl font-extrabold text-slate-900 font-mono">@(((double)ViewBag.AvgScore).ToString("F1")) <span class="text-sm text-slate-400 font-normal">/ 100</span></h3>
            <p class="text-xs text-slate-500 mt-1">Calculated across verified practice data</p>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">PMC Verified Rate</span>
                <div class="w-10 h-10 rounded-2xl bg-emerald-100 text-emerald-600 flex items-center justify-center text-sm shadow-sm">
                    <i class="fas fa-certificate"></i>
                </div>
            </div>
            <h3 class="text-3xl font-extrabold text-slate-900 font-mono">@ViewBag.PmcVerifiedCount <span class="text-sm text-slate-400 font-normal">/ @ViewBag.ProfiledCount</span></h3>
            <p class="text-xs text-emerald-600 mt-1 font-semibold flex items-center gap-1">
                <i class="fas fa-check-circle"></i> Medical council verified physicians
            </p>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Elite & Expert Tiers</span>
                <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-sm shadow-sm">
                    <i class="fas fa-crown"></i>
                </div>
            </div>
            <h3 class="text-3xl font-extrabold text-slate-900 font-mono">@((int)ViewBag.EliteCount + (int)ViewBag.ExpertCount)</h3>
            <p class="text-xs text-slate-500 mt-1">@ViewBag.EliteCount Elite · @ViewBag.ExpertCount Expert level specialists</p>
        </div>

        <div class="bg-white rounded-3xl p-6 border border-slate-100 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Profiled Doctors</span>
                <div class="w-10 h-10 rounded-2xl bg-blue-100 text-blue-600 flex items-center justify-center text-sm shadow-sm">
                    <i class="fas fa-users-cog"></i>
                </div>
            </div>
            <h3 class="text-3xl font-extrabold text-slate-900 font-mono">@ViewBag.ProfiledCount</h3>
            <p class="text-xs text-slate-500 mt-1">Live active physician profiles</p>
        </div>
    </div>

    <!-- Tier Breakdown Bar -->
    <div class="bg-white rounded-3xl p-8 border border-slate-100 shadow-sm">
        <h3 class="text-lg font-bold text-slate-900 mb-2">Physician Experience Tier Distribution</h3>
        <p class="text-xs text-slate-500 mb-6">Automated classification based on tenure, verified case load, CPD points, and procedures performed</p>

        <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
            <div class="p-4 rounded-2xl bg-amber-50 border border-amber-200">
                <div class="text-xs font-extrabold text-amber-800 uppercase tracking-wider">Elite Tier</div>
                <div class="text-2xl font-black text-amber-900 font-mono mt-1">@ViewBag.EliteCount</div>
                <div class="text-[10px] text-amber-700 mt-1">15+ yrs · 5000+ cases · Score 90+</div>
            </div>
            <div class="p-4 rounded-2xl bg-indigo-50 border border-indigo-200">
                <div class="text-xs font-extrabold text-indigo-800 uppercase tracking-wider">Expert Tier</div>
                <div class="text-2xl font-black text-indigo-900 font-mono mt-1">@ViewBag.ExpertCount</div>
                <div class="text-[10px] text-indigo-700 mt-1">10-15 yrs · 2000+ cases · Score 76-90</div>
            </div>
            <div class="p-4 rounded-2xl bg-purple-50 border border-purple-200">
                <div class="text-xs font-extrabold text-purple-800 uppercase tracking-wider">Senior Tier</div>
                <div class="text-2xl font-black text-purple-900 font-mono mt-1">@ViewBag.SeniorCount</div>
                <div class="text-[10px] text-purple-700 mt-1">5-10 yrs · 500+ cases · Score 56-75</div>
            </div>
            <div class="p-4 rounded-2xl bg-blue-50 border border-blue-200">
                <div class="text-xs font-extrabold text-blue-800 uppercase tracking-wider">Mid Tier</div>
                <div class="text-2xl font-black text-blue-900 font-mono mt-1">@ViewBag.MidCount</div>
                <div class="text-[10px] text-blue-700 mt-1">2-5 yrs · 100+ cases · Score 36-55</div>
            </div>
            <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
                <div class="text-xs font-extrabold text-slate-800 uppercase tracking-wider">Junior Tier</div>
                <div class="text-2xl font-black text-slate-900 font-mono mt-1">@ViewBag.JuniorCount</div>
                <div class="text-[10px] text-slate-600 mt-1">&lt;2 yrs · &lt;100 cases · Score 0-35</div>
            </div>
        </div>
    </div>

    <!-- Doctor Credential Registry Table -->
    <div class="bg-white rounded-3xl p-8 border border-slate-100 shadow-sm">
        <div class="flex items-center justify-between mb-6">
            <div>
                <h3 class="text-lg font-bold text-slate-900">Credential Score Registry</h3>
                <p class="text-xs text-slate-500 mt-0.5">Real-time synthesized scores across all practicing doctors</p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                        <th class="py-4 px-4">Physician</th>
                        <th class="py-4 px-4">Specialty</th>
                        <th class="py-4 px-4">Credential Score</th>
                        <th class="py-4 px-4">Tier</th>
                        <th class="py-4 px-4">Processed Cases</th>
                        <th class="py-4 px-4">PMC Status</th>
                        <th class="py-4 px-4">CPD Points</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50 text-sm font-medium text-slate-700">
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var p in Model)
                        {
                            <tr class="hover:bg-slate-50/80 transition-colors">
                                <td class="py-4 px-4">
                                    <div class="font-bold text-slate-900">@(p.DoctorUser?.FirstName ?? "Dr.") @(p.DoctorUser?.LastName ?? "Physician")</div>
                                    <div class="text-xs text-slate-400">@p.DoctorUserId</div>
                                </td>
                                <td class="py-4 px-4">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-100">
                                        @p.PrimarySpecialty
                                    </span>
                                </td>
                                <td class="py-4 px-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-20 bg-slate-100 rounded-full h-2.5 overflow-hidden">
                                            <div class="bg-purple-600 h-2.5 rounded-full" style="width: @(p.CredentialScore)%"></div>
                                        </div>
                                        <span class="font-bold text-purple-700 font-mono">@p.CredentialScore.ToString("F1")</span>
                                    </div>
                                </td>
                                <td class="py-4 px-4">
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold uppercase tracking-wider @(p.TierLevel == "Elite" ? "bg-amber-100 text-amber-800" : p.TierLevel == "Expert" ? "bg-indigo-100 text-indigo-800" : p.TierLevel == "Senior" ? "bg-purple-100 text-purple-800" : "bg-slate-100 text-slate-700")">
                                        @p.TierLevel
                                    </span>
                                </td>
                                <td class="py-4 px-4 font-mono font-bold text-slate-900">
                                    @p.TotalCasesProcessed
                                </td>
                                <td class="py-4 px-4">
                                    @if (p.PmcVerified)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <i class="fas fa-check-circle"></i> Verified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                            <i class="fas fa-clock"></i> Pending
                                        </span>
                                    }
                                </td>
                                <td class="py-4 px-4 font-mono text-purple-700 font-bold">
                                    @p.CpdPoints pts
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <i class="fas fa-user-md text-3xl mb-3 text-slate-300"></i>
                                <p class="text-sm font-semibold">No credential profiles generated yet</p>
                                <p class="text-xs text-slate-400 mt-1">Credential profiles are automatically computed when doctors log consultations, write prescriptions, or ingest records.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
