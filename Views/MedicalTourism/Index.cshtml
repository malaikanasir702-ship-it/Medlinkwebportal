@model MedLinkPortal.Models.PatientDashboardModel

@{
    ViewData["Title"] = "Medical Tourism";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="relative min-h-[calc(100vh-100px)] -mt-6 -mx-8 px-8 py-10 overflow-hidden">
    
    <!-- Cinematic Background Layer -->
    <div class="absolute inset-0 pointer-events-none select-none overflow-hidden">
        <!-- Floating Glassmorphic Orbs -->
        <div class="absolute top-[10%] left-[5%] w-[600px] h-[600px] bg-blue-100/30 rounded-full blur-[120px] animate-float-orb animate-pulse-glow"></div>
        <div class="absolute bottom-[10%] right-[5%] w-[500px] h-[500px] bg-indigo-100/20 rounded-full blur-[100px] animate-float-orb animate-pulse-glow delay-1000" style="animation-direction: reverse;"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[400px] bg-slate-50/50 rounded-full blur-[150px]"></div>
        
        <!-- Interactive Grid Overlay -->
        <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(#475569 1px, transparent 1px), linear-gradient(90deg, #475569 1px, transparent 1px); background-size: 60px 60px;"></div>
    </div>

    <!-- Content Layer -->
    <div class="relative z-10 space-y-12 max-w-[1600px] mx-auto">
        
        <!-- Refined Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-8" data-animate>
            <div class="space-y-4">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50/80 border border-blue-100 text-blue-600 text-[10px] font-black uppercase tracking-[0.3em] backdrop-blur-md">
                    <i data-lucide="sparkles" class="w-3 h-3"></i>
                    MedLink Global Concierge
                </div>
                <h1 class="text-5xl lg:text-7xl font-black text-slate-900 tracking-tighter leading-none">
                    Medical <span class="bg-clip-text text-transparent bg-gradient-to-r from-blue-600 to-indigo-600">Tourism</span>
                </h1>
                <p class="text-xl text-slate-500 font-medium max-w-2xl leading-relaxed">
                    Seamlessly bridging world-class healthcare with premium recovery experiences.
                </p>
            </div>
            
            <a href="@Url.Action("Tracking")" class="group flex items-center gap-4 px-8 py-4 bg-slate-900 text-white rounded-2xl font-black text-xs uppercase tracking-[0.2em] transition-all shadow-xl hover:bg-blue-600 hover:scale-105 active:scale-95">
                <i data-lucide="radar" class="w-5 h-5 text-blue-400"></i>
                <span>Journey Dashboard</span>
            </a>
        </div>

        <!-- Primary Experience Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
            
            <!-- Pakistan: Domestic & Inbound -->
            <a href="@Url.Action("InboundLanding")" class="lg:col-span-7 group relative overflow-hidden rounded-[48px] bg-white p-10 shadow-[0_40px_100px_-30px_rgba(0,0,0,0.1)] border border-slate-100/50 transition-all duration-700 hover:shadow-[0_80px_120px_-20px_rgba(37,99,235,0.15)] hover:-translate-y-2 hover-shine" data-animate>
                <div class="absolute inset-0 bg-gradient-to-br from-blue-50/50 via-white to-white opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>
                
                <div class="relative z-10 flex flex-col justify-between h-full min-h-[300px]">
                    <div class="space-y-6">
                        <div class="w-16 h-16 rounded-[24px] bg-blue-50 shadow-2xl shadow-blue-100 flex items-center justify-center text-blue-600 transition-all duration-700 group-hover:rotate-[360deg] group-hover:bg-blue-600 group-hover:text-white">
                            <i data-lucide="map-pin" class="w-8 h-8"></i>
                        </div>
                        <div>
                            <span class="inline-block px-4 py-1.5 rounded-full bg-blue-50/50 border border-blue-100/50 text-blue-600 text-[10px] font-black uppercase tracking-[0.2em] mb-4 backdrop-blur-xl">
                                Domestic & Inbound
                            </span>
                            <h3 class="text-3xl font-black text-slate-900 mb-3 tracking-tight leading-tight">Come to Pakistan</h3>
                            <p class="text-slate-500 font-medium text-lg leading-relaxed max-w-md">
                                Experience world-class care, followed by a rejuvenating recovery in the Northern Areas.
                            </p>
                        </div>
                    </div>
                    
                    <div class="flex items-center gap-4 pt-6">
                        <div class="w-10 h-10 rounded-full bg-slate-900 flex items-center justify-center text-white shadow-xl group-hover:bg-blue-600 group-hover:scale-110 group-hover:rotate-45 transition-all duration-700">
                            <i data-lucide="arrow-right" class="w-5 h-5"></i>
                        </div>
                        <span class="font-black text-[10px] uppercase tracking-[0.3em] text-slate-900">Explore Packages</span>
                    </div>
                </div>
                
                <img src="https://plus.unsplash.com/premium_photo-1661281397737-9b5d75b52beb?q=80&w=1169&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="absolute -right-16 bottom-16 w-[380px] h-[260px] object-cover rounded-[40px] shadow-3xl opacity-90 group-hover:opacity-100 group-hover:-translate-x-6 transition-all duration-1000 rotate-6 hidden xl:block border-[10px] border-white" />
            </a>

            <!-- International: Outbound -->
            <a href="@Url.Action("OutboundSelection")" class="lg:col-span-5 group relative overflow-hidden rounded-[48px] bg-[#0A0F1E] p-10 shadow-[0_40px_100px_-30px_rgba(10,15,30,0.3)] transition-all duration-700 hover:shadow-[0_80px_120px_-20px_rgba(10,15,30,0.5)] hover:-translate-y-2 hover-shine" data-animate>
                <div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-blue-600/20 to-transparent"></div>
                <div class="absolute top-1/4 right-1/4 w-60 h-60 bg-blue-500 rounded-full blur-[100px] opacity-20 group-hover:opacity-40 transition-opacity duration-1000"></div>
                
                <div class="relative z-10 h-full flex flex-col justify-between min-h-[300px]">
                    <div class="space-y-6">
                        <div class="w-16 h-16 rounded-[24px] bg-white/5 backdrop-blur-2xl border border-white/10 flex items-center justify-center text-blue-300 transition-all duration-700 group-hover:scale-110 group-hover:bg-blue-500 group-hover:text-white">
                            <i data-lucide="plane" class="w-8 h-8"></i>
                        </div>
                        <div>
                            <span class="inline-block px-4 py-1.5 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-300 text-[10px] font-black uppercase tracking-[0.2em] mb-4 backdrop-blur-2xl">
                                Global Reach
                            </span>
                            <h3 class="text-3xl font-black text-white mb-3 tracking-tight leading-tight">Go Abroad</h3>
                            <p class="text-slate-400 font-medium text-lg leading-relaxed">
                                Access specialized surgical expertise in USA, UK, and Malaysia.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-4 pt-6">
                        <div class="w-10 h-10 rounded-full bg-blue-600 flex items-center justify-center text-white shadow-xl shadow-blue-900/50 group-hover:bg-white group-hover:text-slate-900 group-hover:scale-110 group-hover:rotate-45 transition-all duration-700">
                            <i data-lucide="arrow-right" class="w-5 h-5"></i>
                        </div>
                        <span class="font-black text-[10px] uppercase tracking-[0.3em] text-white">Select Destination</span>
                    </div>
                </div>
            </a>

            <!-- AI Enhanced Features -->
            <div class="lg:col-span-12 grid grid-cols-1 md:grid-cols-2 gap-6" data-animate>
                <!-- AI Cost Estimator Card -->
                <a href="@Url.Action("CostEstimator")" class="group relative overflow-hidden rounded-[40px] bg-gradient-to-br from-blue-600 to-indigo-700 p-8 text-white shadow-2xl transition-all hover:scale-[1.02] active:scale-[0.98]">
                    <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -mr-32 -mt-32 blur-3xl group-hover:bg-white/20 transition-all duration-700"></div>
                    <div class="relative z-10 space-y-4">
                        <div class="w-14 h-14 rounded-2xl bg-white/20 backdrop-blur-md flex items-center justify-center">
                            <i data-lucide="calculator" class="w-7 h-7"></i>
                        </div>
                        <div>
                            <h3 class="text-2xl font-black tracking-tight">AI Cost Estimator</h3>
                            <p class="text-blue-100 font-medium text-sm leading-relaxed">Compare global treatment costs and save up to 70%.</p>
                        </div>
                        <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-white/80 group-hover:text-white transition-colors">
                            <span>Open Tool</span>
                            <i data-lucide="chevron-right" class="w-3 h-3 group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>
                </a>

                <!-- Visa Support Card -->
                <a href="@Url.Action("VisaSupport")" class="group relative overflow-hidden rounded-[40px] bg-slate-100 p-8 text-slate-900 border border-slate-200 transition-all hover:bg-white hover:shadow-2xl hover:shadow-indigo-100/50 hover:scale-[1.02] active:scale-[0.98]">
                    <div class="absolute bottom-0 left-0 w-48 h-48 bg-indigo-500/5 rounded-full -ml-24 -mb-24 blur-3xl group-hover:bg-indigo-500/10 transition-all duration-700"></div>
                    <div class="relative z-10 space-y-4">
                        <div class="w-14 h-14 rounded-2xl bg-indigo-600 text-white flex items-center justify-center">
                            <i data-lucide="file-text" class="w-7 h-7"></i>
                        </div>
                        <div>
                            <h3 class="text-2xl font-black tracking-tight text-slate-900">Medical Visa Support</h3>
                            <p class="text-slate-500 font-medium text-sm leading-relaxed">End-to-end documentation & embassy assistance.</p>
                        </div>
                        <div class="flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-indigo-600">
                            <span>Learn More</span>
                            <i data-lucide="chevron-right" class="w-3 h-3 group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Premium Services Section -->
            <div class="lg:col-span-12 grid grid-cols-1 md:grid-cols-3 gap-6" data-animate>
                
                <!-- Concierge Support -->
                <div class="group bg-white/40 backdrop-blur-xl border border-white/60 p-8 rounded-[32px] hover:bg-white transition-all duration-500 shadow-sm hover:shadow-2xl hover:shadow-blue-100/50">
                    <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                        <i data-lucide="headphones" class="w-6 h-6"></i>
                    </div>
                    <h4 class="text-lg font-black text-slate-900 mb-2 leading-tight">Dedicated Concierge</h4>
                    <p class="text-slate-500 font-medium text-sm leading-relaxed">24/7 personalized support for travel and medical records.</p>
                </div>

                <!-- Virtual Screening -->
                <div class="group bg-white/40 backdrop-blur-xl border border-white/60 p-8 rounded-[32px] hover:bg-white transition-all duration-500 shadow-sm hover:shadow-2xl hover:shadow-indigo-100/50">
                    <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                        <i data-lucide="video" class="w-6 h-6"></i>
                    </div>
                    <h4 class="text-lg font-black text-slate-900 mb-2 leading-tight">Virtual Screening</h4>
                    <p class="text-slate-500 font-medium text-sm leading-relaxed">Consult with specialists globally before you travel.</p>
                </div>

                <!-- Luxury Recovery -->
                <div class="group bg-white/40 backdrop-blur-xl border border-white/60 p-8 rounded-[32px] hover:bg-white transition-all duration-500 shadow-sm hover:shadow-2xl hover:shadow-slate-100/50">
                    <div class="w-12 h-12 rounded-2xl bg-slate-100 text-slate-900 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
                        <i data-lucide="hotel" class="w-6 h-6"></i>
                    </div>
                    <h4 class="text-lg font-black text-slate-900 mb-2 leading-tight">Recovery Suites</h4>
                    <p class="text-slate-500 font-medium text-sm leading-relaxed">5-star residency options tailored for medical comfort.</p>
                </div>

            </div>

            <!-- Interactive Medical Hubs -->
            <div class="lg:col-span-12 space-y-8" data-animate>
                <div class="flex items-center justify-between">
                    <h3 class="text-2xl font-black text-slate-900 tracking-tight">Global Medical Hubs</h3>
                    <div class="flex gap-2">
                        <button class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center hover:bg-slate-50 transition-colors"><i data-lucide="chevron-left" class="w-4 h-4"></i></button>
                        <button class="w-10 h-10 rounded-full border border-slate-200 flex items-center justify-center hover:bg-slate-50 transition-colors"><i data-lucide="chevron-right" class="w-4 h-4"></i></button>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- Hub: Istanbul -->
                    <div class="group relative aspect-[4/5] overflow-hidden rounded-[32px] bg-slate-200 cursor-pointer">
                        <img src="https://images.contentstack.io/v3/assets/blt06f605a34f1194ff/bltd4e1c33717ea9c21/64e20e43ad2e0876bf02eb12/0_-_BCC-2023-BEST-PLACES-TO-VISIT-IN-ISTANBUL-0.webp?fit=crop&disable=upscale&auto=webp&quality=60&crop=smart" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="absolute bottom-6 left-6 right-6">
                            <p class="text-white font-black text-lg">Istanbul, Turkey</p>
                            <p class="text-white/70 text-[10px] font-bold uppercase tracking-widest">Hair Transplants & Dental</p>
                        </div>
                    </div>
                    <!-- Hub: Lahore -->
                    <div class="group relative aspect-[4/5] overflow-hidden rounded-[32px] bg-slate-200 cursor-pointer">
                        <img src="https://content-cdn.zameen.com/lahore_d1bd50642f.jpg" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="absolute bottom-6 left-6 right-6">
                            <p class="text-white font-black text-lg">Lahore, Pakistan</p>
                            <p class="text-white/70 text-[10px] font-bold uppercase tracking-widest">Cardiac & Orthopedic</p>
                        </div>
                    </div>
                    <!-- Hub: Bangkok -->
                    <div class="group relative aspect-[4/5] overflow-hidden rounded-[32px] bg-slate-200 cursor-pointer">
                        <img src="https://images.unsplash.com/photo-1583417319070-4a69db38a482?q=80&w=1000&auto=format&fit=crop" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="absolute bottom-6 left-6 right-6">
                            <p class="text-white font-black text-lg">Bangkok, Thailand</p>
                            <p class="text-white/70 text-[10px] font-bold uppercase tracking-widest">Cosmetic Surgery</p>
                        </div>
                    </div>
                    <!-- Hub: Houston -->
                    <div class="group relative aspect-[4/5] overflow-hidden rounded-[32px] bg-slate-200 cursor-pointer">
                        <img src="https://images.contentstack.io/v3/assets/blt06f605a34f1194ff/blt5ee94d09bf1b0635/67d68479d822deffd69e1e79/pexels-jmendezrf-15353653-2-Header_Mobile.jpg?fit=crop&disable=upscale&auto=webp&quality=60&crop=smart" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                        <div class="absolute bottom-6 left-6 right-6">
                            <p class="text-white font-black text-lg">Houston, USA</p>
                            <p class="text-white/70 text-[10px] font-bold uppercase tracking-widest">Oncology Specialist</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Redesigned Success Stories: Floating Interactive Cards -->
            <div class="lg:col-span-12 space-y-12" data-animate>
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                    <div class="space-y-4">
                        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-600 text-[10px] font-black uppercase tracking-[0.3em]">
                            <i data-lucide="heart" class="w-3 h-3"></i>
                            MedLink Patient Community
                        </div>
                        <h2 class="text-4xl font-black text-slate-900 tracking-tight">Real Stories, <span class="text-blue-600">Real Impact</span></h2>
                    </div>
                </div>

                <!-- Floating Cards Container -->
                <div class="group/stories relative min-h-[700px] w-full py-10">
                    <!-- Story 1 -->
                    <div class="absolute top-0 left-0 md:left-[2%] w-full md:w-[320px] bg-white rounded-[32px] p-6 shadow-xl border border-slate-100 transition-all duration-500 hover:z-50 group-hover/stories:opacity-30 hover:!opacity-100 hover:scale-110 hover:shadow-2xl">
                        <div class="flex items-center gap-3 mb-4">
                            <img src="https://i.pravatar.cc/150?u=sarah" class="w-10 h-10 rounded-full" />
                            <div>
                                <p class="text-xs font-black text-slate-900">Sarah Jenkins</p>
                                <p class="text-[9px] font-bold text-slate-400 uppercase">Knee Surgery • UK</p>
                            </div>
                        </div>
                        <p class="text-slate-600 font-medium text-xs leading-relaxed italic">"MedLink saved my quality of life. The care was world-class."</p>
                    </div>

                    <!-- Story 2 (Major Highlight) -->
                    <div class="absolute top-20 left-1/2 -translate-x-1/2 w-full md:w-[450px] bg-slate-900 rounded-[48px] p-10 text-white shadow-2xl transition-all duration-700 hover:z-50 group-hover/stories:opacity-30 hover:!opacity-100 hover:scale-105 hover:shadow-blue-500/30">
                        <div class="absolute top-0 right-0 w-40 h-40 bg-blue-600 rounded-full blur-[80px] opacity-20"></div>
                        <div class="relative z-10 space-y-6 text-center">
                            <div class="flex justify-center -space-x-4 mb-4">
                                <img src="https://i.pravatar.cc/150?u=1" class="w-12 h-12 rounded-full border-4 border-slate-900" />
                                <img src="https://i.pravatar.cc/150?u=2" class="w-12 h-12 rounded-full border-4 border-slate-900" />
                                <img src="https://i.pravatar.cc/150?u=3" class="w-12 h-12 rounded-full border-4 border-slate-900" />
                            </div>
                            <h3 class="text-2xl font-black leading-tight">5,000+ Successful Journeys</h3>
                            <p class="text-slate-400 text-sm font-medium">Join thousands who trusted MedLink for their global healthcare needs.</p>
                            <div class="pt-4 flex justify-center gap-2">
                                <div class="px-4 py-2 bg-white/10 rounded-full text-[10px] font-black uppercase tracking-widest">Trustpilot 4.9/5</div>
                                <div class="px-4 py-2 bg-white/10 rounded-full text-[10px] font-black uppercase tracking-widest">ISO 9001</div>
                            </div>
                        </div>
                    </div>

                    <!-- Story 3 -->
                    <div class="absolute top-0 right-0 md:right-[5%] w-full md:w-[300px] bg-white rounded-[32px] p-6 shadow-xl border border-slate-100 transition-all duration-500 hover:z-50 group-hover/stories:opacity-30 hover:!opacity-100 hover:scale-110">
                        <div class="flex items-center gap-3 mb-4">
                            <img src="https://i.pravatar.cc/150?u=mark" class="w-10 h-10 rounded-full" />
                            <div>
                                <p class="text-xs font-black text-slate-900">Mark Thompson</p>
                                <p class="text-[9px] font-bold text-slate-400 uppercase">Cardiac • USA</p>
                            </div>
                        </div>
                        <p class="text-slate-600 font-medium text-xs leading-relaxed">"A seamless medical journey. The coordination was flawless from start to finish."</p>
                    </div>

                    <!-- Story 4 -->
                    <div class="absolute bottom-20 left-0 md:left-[8%] w-full md:w-[280px] bg-blue-50 rounded-[32px] p-6 shadow-lg border border-blue-100 transition-all duration-500 hover:z-50 group-hover/stories:opacity-30 hover:!opacity-100 hover:scale-110">
                        <div class="flex items-center gap-2 text-blue-600 mb-3">
                            <i data-lucide="quote" class="w-4 h-4 fill-current"></i>
                            <span class="font-black text-[9px] uppercase tracking-widest">Highly Recommended</span>
                        </div>
                        <p class="text-slate-700 font-bold text-sm leading-snug">"Top-tier doctors. I saved over $15k!"</p>
                        <p class="mt-4 text-[10px] font-black text-blue-600 uppercase">Ahmed Al-Sayed • UAE</p>
                    </div>

                    <!-- Story 5 -->
                    <div class="absolute bottom-0 right-1/4 w-full md:w-[350px] bg-white rounded-[32px] p-8 shadow-xl border border-slate-100 transition-all duration-500 hover:z-50 group-hover/stories:opacity-30 hover:!opacity-100 hover:scale-110">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                                <i data-lucide="video" class="w-6 h-6"></i>
                            </div>
                            <div>
                                <p class="text-sm font-black text-slate-900">Watch Elena's Story</p>
                                <p class="text-[10px] font-bold text-slate-400 uppercase">Recovery in Northern Areas</p>
                            </div>
                        </div>
                        <div class="aspect-video rounded-2xl bg-slate-100 overflow-hidden relative group/video">
                            <img src="https://images.unsplash.com/photo-1576091160550-2173dad99961?q=80&w=400" class="w-full h-full object-cover" />
                            <div class="absolute inset-0 flex items-center justify-center">
                                <div class="w-10 h-10 rounded-full bg-white text-blue-600 flex items-center justify-center shadow-lg group-hover/video:scale-110 transition-transform">
                                    <i data-lucide="play" class="w-4 h-4 fill-current"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Story 6 (Small Floating Bubbles) -->
                    <div class="absolute top-1/2 left-[5%] -translate-y-1/2 w-16 h-16 rounded-full bg-white shadow-xl flex items-center justify-center border border-slate-100 transition-all duration-700 group-hover/stories:scale-75 hover:!scale-125 hover:z-50 cursor-pointer">
                        <img src="https://i.pravatar.cc/150?u=a" class="w-full h-full rounded-full object-cover" />
                    </div>
                    <div class="absolute bottom-1/3 right-[5%] w-20 h-20 rounded-full bg-white shadow-xl flex items-center justify-center border border-slate-100 transition-all duration-700 group-hover/stories:scale-75 hover:!scale-125 hover:z-50 cursor-pointer">
                        <img src="https://i.pravatar.cc/150?u=b" class="w-full h-full rounded-full object-cover" />
                    </div>
                </div>
            </div>
            </div>

            <!-- Live Tracking Widget -->
            <div class="lg:col-span-12 relative overflow-hidden rounded-[40px] bg-slate-900 p-0.5 transition-all duration-700 hover:shadow-[0_50px_100px_-20px_rgba(15,23,42,0.4)]" data-animate>
                <div class="bg-slate-950 rounded-[38px] p-6 md:p-10 flex flex-col md:flex-row items-center justify-between gap-8 relative overflow-hidden group/tracker">
                    <!-- Background aura -->
