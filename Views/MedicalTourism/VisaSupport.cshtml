@model MedLinkPortal.Models.PatientDashboardModel

@{
    ViewData["Title"] = "Medical Visa Support";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var visaRef = TempData["VisaRef"] as string;
}

<div class="relative min-h-[calc(100vh-100px)] -mt-6 -mx-8 px-8 py-10 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none select-none overflow-hidden">
        <div class="absolute top-[10%] right-[5%] w-[600px] h-[600px] bg-indigo-100/30 rounded-full blur-[120px] animate-pulse"></div>
        <div class="absolute bottom-[10%] left-[5%] w-[500px] h-[500px] bg-blue-100/20 rounded-full blur-[100px] animate-pulse delay-1000"></div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto space-y-14">

        <!-- Header -->
        <div class="text-center space-y-4">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-600 text-[10px] font-black uppercase tracking-[0.3em]">
                <i data-lucide="file-text" class="w-3 h-3"></i> Visa Concierge
            </div>
            <h1 class="text-5xl font-black text-slate-900 tracking-tighter">Medical <span class="text-indigo-600">Visa Support</span></h1>
            <p class="text-slate-500 font-medium max-w-2xl mx-auto">Skip the bureaucracy. We handle your medical visa invitation and documentation for a seamless cross-border experience.</p>
        </div>

        <!-- Success banner -->
        @if (!string.IsNullOrEmpty(visaRef))
        {
            <div class="bg-emerald-50 border border-emerald-200 rounded-3xl p-6 flex items-center gap-4 animate-in fade-in">
                <div class="w-12 h-12 bg-emerald-100 rounded-2xl flex items-center justify-center text-emerald-600 flex-shrink-0">
                    <i data-lucide="check-circle" class="w-6 h-6"></i>
                </div>
                <div>
                    <p class="font-black text-emerald-800 text-base">Visa Application Submitted Successfully!</p>
                    <p class="text-emerald-600 text-sm font-medium mt-0.5">Your reference ID: <strong class="font-black">@visaRef</strong> — Save this to track your application.</p>
                </div>
            </div>
        }

        <!-- Service Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="bg-white rounded-[32px] p-8 shadow-xl shadow-slate-200/50 border border-slate-100 space-y-4 group hover:-translate-y-2 transition-all">
                <div class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center group-hover:bg-blue-600 group-hover:text-white transition-all">
                    <i data-lucide="files" class="w-7 h-7"></i>
                </div>
                <h3 class="text-xl font-black text-slate-900">Document Prep</h3>
                <p class="text-slate-500 text-sm font-medium leading-relaxed">We assist in gathering essential medical reports, bank statements, and passport proofs required for the application.</p>
            </div>
            <div class="bg-white rounded-[32px] p-8 shadow-xl shadow-slate-200/50 border border-slate-100 space-y-4 group hover:-translate-y-2 transition-all">
                <div class="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:bg-indigo-600 group-hover:text-white transition-all">
                    <i data-lucide="building-2" class="w-7 h-7"></i>
                </div>
                <h3 class="text-xl font-black text-slate-900">Official Invitation</h3>
                <p class="text-slate-500 text-sm font-medium leading-relaxed">Receive a formal invitation letter from our partner ISO-accredited hospitals to fast-track your visa process.</p>
            </div>
            <div class="bg-white rounded-[32px] p-8 shadow-xl shadow-slate-200/50 border border-slate-100 space-y-4 group hover:-translate-y-2 transition-all">
                <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover:bg-emerald-600 group-hover:text-white transition-all">
                    <i data-lucide="landmark" class="w-7 h-7"></i>
                </div>
                <h3 class="text-xl font-black text-slate-900">Embassy Liaison</h3>
                <p class="text-slate-500 text-sm font-medium leading-relaxed">Our concierge team provides mock interview prep and embassy appointment booking assistance globally.</p>
            </div>
        </div>

        <!-- Apply + Track side by side -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

            <!-- Application Form -->
            <div class="bg-white rounded-[40px] p-10 shadow-2xl shadow-slate-200/60 border border-slate-100">
                <div class="flex items-center gap-3 mb-8">
                    <div class="w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-600">
                        <i data-lucide="send" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <h2 class="text-2xl font-black text-slate-900">Apply for Visa Support</h2>
                        <p class="text-slate-400 text-xs font-medium uppercase tracking-wider">Fill in your details below</p>
                    </div>
                </div>

                <form asp-action="ApplyVisa" method="post" class="space-y-5">
                    @Html.AntiForgeryToken()

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Full Name (as on passport)</label>
                            <div class="relative">
                                <i data-lucide="user" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                                <input type="text" name="FullName" required
                                       class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-slate-50 border border-slate-200 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none font-bold text-slate-900 text-sm transition-all"
                                       placeholder="e.g. Ahmed Khan" />
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Nationality</label>
                            <div class="relative">
                                <i data-lucide="globe" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                                <select name="Nationality" required class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-slate-50 border border-slate-200 focus:bg-white focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 outline-none font-bold text-slate-700 text-sm transition-all appearance-none">
                                    <option value="">Select Country</option>
                                    <option>UAE</option><option>USA</option><option>UK</option><option>Canada</option>
                                    <option>Saudi Arabia</option><option>Qatar</option><option>Kuwait</option>
                                    <option>Bahrain</option><option>Oman</option><option>Australia</option>
                                    <option>Germany</option><option>France</option><option>Turkey</option>
                                    <option>Other</option>
                                </select>
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Passport Number</label>
                            <div class="relative">
                                <i data-lucide="credit-card" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                                <input type="text" name="PassportNumber" required
                                       class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-slate-50 border border-slate-200 focus:bg-white focus:border-indigo-500 outline-none font-bold text-slate-900 text-sm transition-all"
                                       placeholder="e.g. AB1234567" />
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Passport Expiry</label>
                            <div class="relative">
                                <i data-lucide="calendar" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                                <input type="date" name="PassportExpiry"
                                       class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-slate-50 border border-slate-200 focus:bg-white focus:border-indigo-500 outline-none font-bold text-slate-900 text-sm transition-all" />
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Treatment Required</label>
                            <div class="relative">
                                <i data-lucide="stethoscope" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                                <input type="text" name="TreatmentType" required
                                       class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-slate-50 border border-slate-200 focus:bg-white focus:border-indigo-500 outline-none font-bold text-slate-900 text-sm transition-all"
                                       placeholder="e.g. Cardiac Surgery" />
                            </div>
                        </div>
                        <div class="space-y-2">
                            <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Planned Arrival Date</label>
                            <div class="relative">
                                <i data-lucide="plane-landing" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                                <input type="date" name="PlannedArrivalDate"
                                       class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-slate-50 border border-slate-200 focus:bg-white focus:border-indigo-500 outline-none font-bold text-slate-900 text-sm transition-all" />
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Medical Reports Link (Google Drive / Dropbox)</label>
                        <div class="relative">
                            <i data-lucide="link" class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                            <input type="url" name="MedicalReportsUrl"
                                   class="w-full pl-11 pr-4 py-3.5 rounded-2xl bg-slate-50 border border-slate-200 focus:bg-white focus:border-indigo-500 outline-none font-bold text-slate-900 text-sm transition-all"
                                   placeholder="https://drive.google.com/..." />
                        </div>
                    </div>

                    <div class="space-y-2">
                        <label class="text-[10px] font-black text-slate-500 uppercase tracking-widest">Additional Notes</label>
                        <textarea name="AdditionalNotes" rows="3"
                                  class="w-full px-4 py-3 rounded-2xl bg-slate-50 border border-slate-200 focus:bg-white focus:border-indigo-500 outline-none font-medium text-slate-900 text-sm transition-all resize-none"
                                  placeholder="Any special requirements or medical history..."></textarea>
                    </div>

                    <button type="submit"
                            class="w-full py-4 bg-indigo-600 text-white rounded-2xl font-black text-sm uppercase tracking-widest hover:bg-indigo-700 hover:scale-[1.01] active:scale-[0.99] transition-all shadow-2xl shadow-indigo-200 flex items-center justify-center gap-3">
                        <i data-lucide="send" class="w-4 h-4"></i> Submit Visa Application
                    </button>
                </form>
            </div>

            <!-- Track Visa -->
            <div class="space-y-6">
                <!-- Track Box -->
                <div class="bg-slate-900 rounded-[40px] p-10 text-white relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-64 h-64 bg-blue-600/20 rounded-full blur-[80px] -mr-32 -mt-32"></div>
                    <div class="relative z-10 space-y-6">
                        <div>
                            <h2 class="text-2xl font-black tracking-tight">Track Your Visa Status</h2>
                            <p class="text-slate-400 text-sm font-medium mt-1">Enter your reference ID to see real-time progress</p>
                        </div>
                        <div class="relative">
                            <input type="text" id="trackInput" placeholder="MLVISA-2026-00001"
                                   class="w-full px-6 py-4 bg-white/5 border border-white/10 rounded-2xl text-white placeholder-white/30 font-bold text-sm focus:ring-2 focus:ring-blue-500 outline-none transition-all" />
                            <button onclick="trackVisa()"
                                    class="absolute right-3 top-3 px-5 py-2 bg-blue-600 text-white rounded-xl font-black text-[10px] uppercase tracking-widest hover:bg-blue-500 transition-all">
                                Track
                            </button>
                        </div>
                        <!-- Result -->
                        <div id="trackResult" class="hidden space-y-4">
                            <div class="bg-white/5 rounded-2xl p-5 border border-white/10">
                                <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-1">Applicant</p>
                                <p id="tr-name" class="text-base font-black"></p>
                                <p id="tr-treatment" class="text-sm text-slate-400 mt-0.5"></p>
                            </div>
                            <div id="tr-steps" class="space-y-3"></div>
                            <div id="tr-invitation" class="hidden bg-emerald-500/10 border border-emerald-500/20 rounded-2xl p-4 flex items-center gap-3">
                                <i data-lucide="file-text" class="w-5 h-5 text-emerald-400 flex-shrink-0"></i>
                                <div>
                                    <p class="text-sm font-black text-emerald-300">Invitation Letter Ready</p>
                                    <a id="tr-invitation-link" href="#" target="_blank" class="text-xs text-emerald-400 hover:text-white underline">Download PDF</a>
                                </div>
                            </div>
                            <div id="tr-notes" class="hidden bg-amber-500/10 border border-amber-500/20 rounded-2xl p-4">
                                <p class="text-[9px] font-black text-amber-400 uppercase tracking-widest mb-1">Admin Notes</p>
                                <p id="tr-notes-text" class="text-sm text-amber-300"></p>
                            </div>
                        </div>
                        <div id="trackError" class="hidden text-rose-400 text-sm font-bold"></div>
                    </div>
                </div>

                <!-- My Applications Quick Link -->
                <a href="@Url.Action("MyVisaApplications")"
                   class="flex items-center justify-between p-6 bg-white rounded-3xl border border-slate-100 shadow-sm hover:shadow-xl hover:border-indigo-200 transition-all group">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-indigo-50 rounded-2xl flex items-center justify-center text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-all">
                            <i data-lucide="clipboard-list" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="font-black text-slate-900">My Visa Applications</p>
                            <p class="text-xs text-slate-400 font-medium">View all your submitted applications</p>
                        </div>
                    </div>
                    <i data-lucide="arrow-right" class="w-5 h-5 text-slate-300 group-hover:text-indigo-600 group-hover:translate-x-1 transition-all"></i>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    lucide.createIcons();

    async function trackVisa() {
        const refId = document.getElementById('trackInput').value.trim();
        if (!refId) return;

        document.getElementById('trackResult').classList.add('hidden');
        document.getElementById('trackError').classList.add('hidden');

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const resp = await fetch('/MedicalTourism/TrackVisa', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'RequestVerificationToken': token ?? ''
                },
                body: `referenceId=${encodeURIComponent(refId)}`
            });
            const data = await resp.json();

            if (!data.success) {
                document.getElementById('trackError').textContent = data.message;
                document.getElementById('trackError').classList.remove('hidden');
                return;
            }

            document.getElementById('tr-name').textContent = data.fullName;
            document.getElementById('tr-treatment').textContent = data.treatmentType;

            // Steps
            const stepsEl = document.getElementById('tr-steps');
            const statusMap = ['Submitted', 'DocumentsUnderReview', 'InvitationIssued', 'EmbassySubmitted', 'VisaApproved'];
            const icons = ['send', 'file-search', 'file-check', 'building', 'check-circle'];
            stepsEl.innerHTML = data.steps.map((s, i) => `
                <div class="flex items-center gap-3 p-3 rounded-xl ${s.done ? 'bg-white/10' : 'opacity-30'}">
                    <div class="w-8 h-8 rounded-xl flex items-center justify-center ${s.done ? 'bg-emerald-500 text-white' : 'bg-white/10 text-slate-400'}">
                        <i data-lucide="${icons[i]}" class="w-4 h-4"></i>
                    </div>
                    <p class="text-sm font-bold ${s.done ? 'text-white' : 'text-slate-400'}">${s.label}</p>
                    ${s.done && !data.steps[i+1]?.done ? '<span class="ml-auto text-[9px] font-black text-emerald-400 uppercase tracking-widest">Current</span>' : ''}
                </div>
            `).join('');

            // Invitation letter
            if (data.invitationLetterUrl) {
                document.getElementById('tr-invitation').classList.remove('hidden');
                document.getElementById('tr-invitation-link').href = data.invitationLetterUrl;
            }

            // Admin notes
            if (data.adminNotes) {
                document.getElementById('tr-notes').classList.remove('hidden');
                document.getElementById('tr-notes-text').textContent = data.adminNotes;
            }

            document.getElementById('trackResult').classList.remove('hidden');
            lucide.createIcons();
        } catch (e) {
            document.getElementById('trackError').textContent = 'Error connecting. Please try again.';
            document.getElementById('trackError').classList.remove('hidden');
        }
    }

    // Allow pressing Enter in track input
    document.getElementById('trackInput')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') trackVisa();
    });
</script>
@Html.AntiForgeryToken()
}
