@model IEnumerable<MedLinkPortal.Models.DoctorSubscription>

@{
    ViewData["Title"] = "Subscription Tracking";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="space-y-8 animate-in fade-in duration-700">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <h2 class="text-3xl font-semibold text-slate-900 tracking-tight">Active Subscriptions</h2>
            <p class="text-slate-500 font-medium mt-1 text-sm">Real-time tracking of professional plan adoptions and renewals.</p>
        </div>
        <div class="flex items-center gap-3">
             <div class="px-5 py-3 bg-blue-600 text-white rounded-2xl flex items-center gap-3 shadow-lg shadow-blue-500/20">
                <i class="fas fa-chart-line"></i>
                <div>
                    <p class="text-[8px] font-semibold uppercase tracking-widest opacity-80">Total Revenue</p>
                    <p class="text-xs font-semibold">$@Model.Where(s => s.IsActive).Sum(s => s.Plan?.Price ?? 0)</p>
                </div>
            </div>
        </div>
    </div>

    <div class="bento-card bg-white border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/50 border-b border-slate-100">
                        <th class="px-8 py-5 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Subscriber (Doctor)</th>
                        <th class="px-8 py-5 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Current Plan</th>
                        <th class="px-8 py-5 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Provisioned Date</th>
                        <th class="px-8 py-5 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Revenue Impact</th>
                        <th class="px-8 py-5 text-[10px] font-semibold text-slate-400 uppercase tracking-widest text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @if (!Model.Any()) {
                        <tr>
                            <td colspan="5" class="px-8 py-20 text-center">
                                <div class="max-w-xs mx-auto space-y-4">
                                    <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto text-slate-200 text-2xl">
                                        <i class="fas fa-layer-group"></i>
                                    </div>
                                    <p class="text-slate-400 font-bold text-sm">No clinical subscriptions identified in the registry.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var sub in Model)
                    {
                        <tr class="hover:bg-slate-50/50 transition-colors group">
                            <td class="px-8 py-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 bg-slate-100 rounded-xl flex items-center justify-center text-slate-400 font-semibold text-xs group-hover:bg-blue-600 group-hover:text-white transition-all">
                                        @(sub.DoctorUser?.Name?.Substring(0, 1) ?? "D")
                                    </div>
                                    <div>
                                        <p class="text-sm font-semibold text-slate-900">@sub.DoctorUser?.Name</p>
                                        <p class="text-[10px] font-medium text-slate-400">@sub.DoctorUser?.Email</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-6">
                                <span class="px-3 py-1.5 rounded-xl @(sub.Plan?.Price > 0 ? "bg-blue-50 text-blue-600" : "bg-slate-100 text-slate-600") text-[10px] font-semibold uppercase tracking-wider">
                                    @sub.Plan?.Name
                                </span>
                            </td>
                            <td class="px-8 py-6">
                                <p class="text-xs font-bold text-slate-600">@sub.PurchaseDate.ToString("MMM dd, yyyy")</p>
                                <p class="text-[9px] font-medium text-slate-400 uppercase tracking-tighter">@sub.PurchaseDate.ToString("hh:mm tt")</p>
                            </td>
                            <td class="px-8 py-6">
                                <p class="text-xs font-semibold text-emerald-600">+$@sub.Plan?.Price.ToString("N2")</p>
                            </td>
                            <td class="px-8 py-6 text-right">
                                <button class="w-8 h-8 rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-900 transition-all">
                                    <i class="fas fa-ellipsis-v text-xs"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
