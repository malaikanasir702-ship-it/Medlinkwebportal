@model MedLinkPortal.Areas.Doctor.Models.DoctorDashboardViewModel

@{
    ViewData["Title"] = "Doctor Dashboard";
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
}

<div class="space-y-6 lg:space-y-10 reveal">
    @if (ViewBag.CurrentPlan != null && ViewBag.CurrentPlan.PatientLimit > 0)
    {
        var limit = (int)ViewBag.CurrentPlan.PatientLimit;
        var count = (int)ViewBag.PatientCount;
        if (count >= limit)
        {
            <div class="bg-red-500/10 border border-red-500/50 p-6 rounded-[32px] flex flex-col md:flex-row items-center justify-between gap-6 animate-in fade-in slide-in-from-top-4 duration-700">
                <div class="flex items-center gap-6">
                    <div class="w-14 h-14 bg-red-600 rounded-2xl flex items-center justify-center text-white text-2xl shadow-lg shadow-red-500/30">
                        <i class="fas fa-exclamation-circle animate-pulse"></i>
                    </div>
                    <div>
                        <h4 class="text-lg font-semibold text-red-600 tracking-tight">Plan Limit Reached</h4>
                        <p class="text-slate-500 text-sm font-medium">You have hit the @limit-patient limit. New records are blocked until upgrade.</p>
                    </div>
                </div>
                <a asp-action="MedLinkPro" class="px-8 py-4 bg-white border border-red-200 text-red-600 rounded-2xl font-semibold text-xs uppercase tracking-widest hover:bg-red-600 hover:text-white transition-all shadow-sm">
                    Upgrade to PRO Now
                </a>
            </div>
        }
        else if (count >= limit * 0.8)
        {
            <div class="bg-amber-500/10 border border-amber-500/50 p-6 rounded-[32px] flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="flex items-center gap-6">
                    <div class="w-14 h-14 bg-amber-500 rounded-2xl flex items-center justify-center text-white text-2xl shadow-lg shadow-amber-500/30">
                        <i class="fas fa-battery-three-quarters"></i>
                    </div>
                    <div>
                        <h4 class="text-lg font-semibold text-amber-600 tracking-tight">Approaching Limit</h4>
                        <p class="text-slate-500 text-sm font-medium">@count / @limit patients. Upgrade soon to maintain clinical continuity.</p>
                    </div>
                </div>
                <a asp-action="MedLinkPro" class="px-8 py-4 bg-amber-500 text-white rounded-2xl font-semibold text-xs uppercase tracking-widest hover:bg-amber-600 transition-all shadow-lg shadow-amber-500/20">
                    View Premium Plans
                </a>
            </div>
        }
    }

    <!-- Header Section -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 lg:gap-6 pb-2 border-b border-slate-100 dark:border-white/5">
        <div>
            <h2 class="text-2xl md:text-3xl lg:text-4xl font-semibold text-slate-900 dark:text-white tracking-tight">Clinical Overview</h2>
            <p class="text-xs md:text-sm text-slate-500 font-medium mt-1 lg:mt-2">Real-time metrics and patient activity markers.</p>
        </div>
        <div class="flex items-center space-x-3">
            <a asp-controller="EmergencyCenter" asp-action="Index" class="group relative flex items-center justify-center px-4 py-2.5 lg:px-6 lg:py-3 bg-rose-600 text-white rounded-2xl text-xs lg:text-sm font-semibold hover:bg-rose-700 transition-all shadow-lg shadow-rose-500/30 overflow-hidden active:scale-95">
                <div class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-500"></div>
                <i class="fas fa-bolt-lightning mr-2 lg:mr-3 text-amber-300 animate-pulse"></i>
                <span class="relative">Emergency Ops</span>
            </a>
            <button id="exportReport" class="w-full lg:w-auto group flex items-center justify-center px-4 py-2.5 lg:px-6 lg:py-3 bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-700 dark:text-slate-300 rounded-2xl text-xs lg:text-sm font-bold hover:bg-slate-50 dark:hover:bg-white/10 transition-all shadow-sm active:scale-95">
                <i class="fas fa-file-export mr-2 lg:mr-3 text-blue-500 group-hover:rotate-12 transition-transform"></i> Analytics Export
            </button>
        </div>
    </div>

    <!-- Premium Stats Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 lg:gap-6">
        <!-- Metric 1: Active Patients -->
        <div class="premium-card p-5 lg:p-8 group overflow-hidden relative">
            <div class="absolute -right-10 -top-10 w-32 h-32 lg:w-40 lg:h-40 bg-blue-500/5 rounded-full group-hover:scale-150 transition-transform duration-700"></div>
            <div class="relative flex flex-col h-full justify-between gap-4">
                <div class="flex items-center justify-between">
                    <div class="w-10 h-10 lg:w-12 lg:h-12 bg-blue-600 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-500/30">
                        <i class="fas fa-user-check text-white text-base lg:text-lg"></i>
                    </div>
                    <span class="px-2 lg:px-3 py-1 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 text-[9px] lg:text-[10px] font-semibold rounded-lg">+12%</span>
                </div>
                <div>
                    <p class="text-[10px] lg:text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Active Treatments</p>
                    <h3 class="text-2xl lg:text-4xl font-semibold text-slate-900 dark:text-white mt-1 font-mono">@Model.ActiveTreatments</h3>
                </div>
            </div>
        </div>

        <!-- Metric 2: Consultations -->
        <div class="premium-card p-5 lg:p-8 group overflow-hidden relative">
            <div class="absolute -right-10 -top-10 w-32 h-32 lg:w-40 lg:h-40 bg-indigo-500/5 rounded-full group-hover:scale-150 transition-transform duration-700"></div>
            <div class="relative flex flex-col h-full justify-between gap-4">
                <div class="flex items-center justify-between">
                    <div class="w-10 h-10 lg:w-12 lg:h-12 bg-indigo-600 rounded-2xl flex items-center justify-center shadow-lg shadow-indigo-500/30">
                        <i class="fas fa-stethoscope text-white text-base lg:text-lg"></i>
                    </div>
                    <span class="px-2 lg:px-3 py-1 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 text-[9px] lg:text-[10px] font-semibold rounded-lg">Historical</span>
                </div>
                <div>
                    <p class="text-[10px] lg:text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Total Handled</p>
                    <h3 class="text-2xl lg:text-4xl font-semibold text-slate-900 dark:text-white mt-1 font-mono">@Model.TotalPatients</h3>
                </div>
            </div>
        </div>

        <!-- Metric 3: Follow-ups -->
        <div class="premium-card p-5 lg:p-8 group overflow-hidden relative">
            <div class="absolute -right-10 -top-10 w-32 h-32 lg:w-40 lg:h-40 bg-amber-500/5 rounded-full group-hover:scale-150 transition-transform duration-700"></div>
            <div class="relative flex flex-col h-full justify-between gap-4">
                <div class="flex items-center justify-between">
                    <div class="w-10 h-10 lg:w-12 lg:h-12 bg-amber-500 rounded-2xl flex items-center justify-center shadow-lg shadow-amber-500/30">
                        <i class="fas fa-bell-concierge text-white text-base lg:text-lg"></i>
                    </div>
                    <span class="px-2 lg:px-3 py-1 bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 text-[9px] lg:text-[10px] font-semibold rounded-lg">High Priority</span>
                </div>
                <div>
                    <p class="text-[10px] lg:text-xs font-bold text-slate-400 uppercase tracking-widest mb-1">Pending Sync</p>
                    <h3 class="text-2xl lg:text-4xl font-semibold text-slate-900 dark:text-white mt-1 font-mono">@Model.FollowUpNeeded</h3>
                </div>
            </div>
        </div>

        <!-- Metric 4: Satisfaction -->
        <div class="premium-card p-5 lg:p-8 group overflow-hidden relative bg-gradient-to-br from-blue-600 to-indigo-700 border-none shadow-xl shadow-blue-500/20">
            <div class="absolute -right-4 -bottom-4 w-24 h-24 lg:w-32 lg:h-32 bg-white/10 rounded-full group-hover:scale-110 transition-transform duration-700"></div>
            <div class="relative flex flex-col h-full justify-between gap-4">
                <div class="flex items-center justify-between">
                    <div class="w-10 h-10 lg:w-12 lg:h-12 bg-white/20 rounded-2xl flex items-center justify-center backdrop-blur-md">
                        <i class="fas fa-crown text-white text-base lg:text-lg"></i>
                    </div>
                    <div class="flex items-center space-x-1">
                        <i class="fas fa-star text-amber-400 text-[8px]"></i>
                        <span class="text-[9px] lg:text-[10px] font-bold text-white/80">Premium Care</span>
                    </div>
                </div>
                <div>
                    <p class="text-[10px] lg:text-xs font-bold text-white/60 uppercase tracking-widest mb-1">Clinician Rating</p>
                    <div class="flex items-end space-x-2">
                        <h3 class="text-2xl lg:text-4xl font-semibold text-white font-mono">@Model.AverageRating</h3>
                        <span class="text-white/40 text-xs lg:text-sm font-bold mb-1">/ 5.0</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10">
        <!-- Left: Patient Velocity -->
        <div class="lg:col-span-12 xl:col-span-8 space-y-6 lg:space-y-8">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-xl lg:text-2xl font-semibold text-slate-800 dark:text-white tracking-tight">Recent Patient List</h3>
                    <p class="text-[10px] lg:text-xs font-bold text-slate-400 uppercase tracking-widest mt-0.5 lg:mt-1">Live Feed</p>
                </div>
                <div class="flex items-center space-x-2 lg:space-x-3">
                    <button class="w-8 h-8 lg:w-10 lg:h-10 flex items-center justify-center bg-slate-50 dark:bg-white/5 text-slate-400 hover:text-blue-500 rounded-xl transition-colors">
                        <i class="fas fa-filter text-[10px] lg:text-xs"></i>
                    </button>
                    <button class="px-3 py-1.5 lg:px-4 lg:py-2 text-[10px] lg:text-xs font-semibold text-blue-600 hover:bg-blue-50 dark:hover:bg-blue-900/20 rounded-xl transition-all">Expand View</button>
                </div>
            </div>

            <div class="grid grid-cols-1 gap-4" id="patientList">
                @foreach (var patient in Model.RecentPatients)
                {
                    <div class="patient-card premium-card hover:bg-slate-50/50 dark:hover:bg-white/5 p-4 lg:p-6 group" 
                         data-patient-name="@((patient.Name ?? "Patient").ToLower())">
                        <div class="flex flex-col sm:flex-row sm:items-center gap-4 lg:gap-6">
                            <!-- Avatar with status glow -->
                            <div class="flex items-center space-x-4 sm:space-x-0 sm:block">
                                <div class="relative flex-shrink-0">
                                    <div class="w-12 h-12 lg:w-16 lg:h-16 rounded-2xl lg:rounded-3xl bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-700 flex items-center justify-center text-slate-600 dark:text-slate-300 font-semibold text-lg lg:text-xl shadow-inner transform group-hover:-rotate-3 transition-transform">
                                        @patient.Initials
                                    </div>
                                    <div class="absolute -bottom-1 -right-1 w-4 h-4 lg:w-5 lg:h-5 @(patient.Status == "Critical" ? "bg-red-500 shadow-red-500/50" : "bg-emerald-500 shadow-emerald-500/50") rounded-full border-2 lg:border-4 border-white dark:border-slate-900 shadow-lg"></div>
                                </div>
                                <!-- Mobile Status (beside avatar) -->
                                <div class="sm:hidden">
                                     <h4 class="font-semibold text-base text-slate-900 dark:text-white truncate tracking-tight">@(patient.Name ?? "Patient")</h4>
                                     <span class="inline-block mt-1 px-2 py-0.5 rounded-lg text-[9px] font-semibold uppercase tracking-widest @(patient.Status == "Critical" ? "bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400" : "bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400")">
                                        @patient.Status
                                    </span>
                                </div>
                            </div>
                            
                            <!-- Detailed Info -->
                            <div class="flex-grow min-w-0">
                                <div class="hidden sm:flex items-center gap-3 mb-2">
                                    <h4 class="font-semibold text-sm lg:text-lg text-slate-900 dark:text-white truncate tracking-tight">@(patient.Name ?? "Patient")</h4>
                                    <span class="px-2 lg:px-2.5 py-1 rounded-lg text-[9px] font-semibold uppercase tracking-widest @(patient.Status == "Critical" ? "bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400" : "bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400")">
                                        @patient.Status
                                    </span>
                                </div>
                                <div class="flex flex-wrap items-center gap-x-4 lg:gap-x-6 gap-y-2">
                                    <div class="flex items-center space-x-2">
                                        <div class="w-1.5 h-1.5 lg:w-2 lg:h-2 rounded-full bg-blue-500/30"></div>
                                        <span class="text-[10px] lg:text-xs font-bold text-slate-500 dark:text-slate-400">ID-@((patient.PatientId?.Length > 6) ? patient.PatientId.Substring(0, 6) : patient.PatientId)</span>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <i class="fas fa-heart-pulse text-slate-300 text-[10px]"></i>
                                        <span class="text-[10px] lg:text-xs font-bold text-slate-500 dark:text-slate-400">@patient.Condition</span>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <i class="fas fa-clock-rotate-left text-slate-300 text-[10px]"></i>
                                        <span class="text-[10px] lg:text-xs font-bold text-slate-400">@(patient.LastVisit?.ToString("MMM dd, yyyy") ?? "Registry Entry")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Contextual Actions -->
                            <div class="flex items-center space-x-3 self-end sm:self-center sm:opacity-0 sm:group-hover:opacity-100 transform sm:translate-x-4 sm:group-hover:translate-x-0 transition-all duration-300">
                                @{
                                    var apptStarted = patient.NextAppointment.HasValue && DateTime.Now >= patient.NextAppointment.Value;
                                    var disabledClass = apptStarted ? "" : "opacity-30 cursor-not-allowed grayscale";
                                }
                                <a asp-action="ViewHistory" asp-route-patientId="@patient.PatientId" 
                                   class="w-10 h-10 lg:w-12 lg:h-12 flex items-center justify-center bg-white dark:bg-white/10 border border-slate-200 dark:border-white/10 text-slate-600 dark:text-slate-400 rounded-xl lg:rounded-2xl hover:text-blue-600 hover:border-blue-100 transition-all @disabledClass shadow-sm active:scale-90"
                                   title="Vault Access">
                                    <i class="fas fa-layer-group text-xs lg:text-sm"></i>
                                </a>
                                <a asp-action="Messages" asp-route-patientId="@patient.PatientId" 
                                   class="w-10 h-10 lg:w-12 lg:h-12 flex items-center justify-center bg-blue-600 text-white rounded-xl lg:rounded-2xl hover:bg-blue-700 shadow-xl shadow-blue-500/30 active:scale-90 transition-all @disabledClass"
                                   title="Secure Signal">
                                    <i class="fas fa-paper-plane text-xs lg:text-sm"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }

                @if (!Model.RecentPatients.Any())
                {
                    <div class="p-10 lg:p-20 text-center premium-card border-dashed border-2 border-slate-100 dark:border-white/5">
                        <div class="w-16 h-16 lg:w-20 lg:h-20 bg-slate-50 dark:bg-white/5 rounded-full flex items-center justify-center mx-auto mb-4 lg:mb-6 shadow-inner">
                            <i class="fas fa-ghost text-slate-300 text-xl lg:text-3xl"></i>
                        </div>
                        <h4 class="text-lg lg:text-xl font-semibold text-slate-900 dark:text-white tracking-tight">Neutral State Detected</h4>
                        <p class="text-slate-500 font-medium mt-2 max-w-xs mx-auto text-xs lg:text-sm">No recent patient activity recorded in the synchronization layer.</p>
                        <button type="button" onclick="openInitialRecordModal()" class="inline-flex items-center mt-6 lg:mt-8 px-5 py-2.5 lg:px-6 lg:py-3 bg-blue-600 text-white text-xs lg:text-sm font-semibold rounded-2xl hover:bg-blue-700 transition-all shadow-lg shadow-blue-500/20">
                            <i class="fas fa-plus mr-2"></i> Deploy Initial Record
                        </button>
                    </div>
                }

                <div id="noResults" class="p-10 lg:p-20 text-center premium-card border-dashed border-2 border-slate-100 dark:border-white/5" style="display: none;">
                    <div class="w-16 h-16 lg:w-20 lg:h-20 bg-slate-50 dark:bg-white/5 rounded-full flex items-center justify-center mx-auto mb-4 lg:mb-6">
                        <i class="fas fa-radar text-slate-300 text-xl lg:text-3xl animate-pulse"></i>
                    </div>
                    <h4 class="text-lg lg:text-xl font-semibold text-slate-900 dark:text-white">Zero Matches Return</h4>
                    <p class="text-slate-500 font-medium mt-2 text-xs lg:text-sm">No entities found matching your current cryptographic query.</p>
                </div>
            </div>
        </div>

        <!-- Right: Operations Panel -->
        <div class="lg:col-span-12 xl:col-span-4 space-y-6 lg:space-y-10">
             <!-- Analytics Graph -->
            <div class="premium-card p-6 bg-white dark:bg-slate-900/50">
                <div class="flex items-center justify-between mb-4">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Clinic Performance</h3>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Real-time Velocity</p>
                    </div>
                     <span class="px-2 py-1 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 text-[10px] font-semibold rounded-lg animate-pulse">LIVE</span>
                </div>
                <div id="clinicPerformanceChart" class="w-full h-[250px]"></div>
            </div>

            <!-- Timeline Ops -->
            <div class="premium-card p-6 lg:p-8 bg-white dark:bg-slate-900/50">
                <div class="flex items-center justify-between mb-6 lg:mb-10">
                    <div>
                        <h3 class="text-lg lg:text-xl font-semibold text-slate-900 dark:text-white tracking-tight">Today's Schedule</h3>
                        <p class="text-[9px] lg:text-[10px] font-semibold text-blue-500 uppercase tracking-widest mt-0.5 lg:mt-1">Operational Loop</p>
                    </div>
                    <div class="w-8 h-8 lg:w-10 lg:h-10 bg-blue-50 dark:bg-blue-900/20 rounded-xl flex items-center justify-center text-blue-600">
                        <i class="fas fa-timeline text-[10px] lg:text-xs"></i>
                    </div>
                </div>
                
                <div class="space-y-4 lg:space-y-6 relative before:absolute before:left-[17px] before:top-2 before:bottom-2 before:w-px before:bg-slate-100 dark:before:bg-white/5">
                    @if (Model.TodayAppointments.Any())
                    {
                        @foreach (var appt in Model.TodayAppointments.Take(4))
                        {
                            var statusColor = appt.ConsultationType == "Emergency" ? "bg-red-500" :
                                             appt.Status == "Pending" ? "bg-amber-500" : "bg-blue-500";
                            
                            <div class="relative pl-10 group">
                                <div class="absolute left-0 top-1.5 w-9 h-9 @statusColor rounded-xl border-4 border-white dark:border-slate-900 z-10 flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                                     <i class="fas @(appt.ConsultationType == "Emergency" ? "fa-bolt" : "fa-check") text-white text-[10px]"></i>
                                </div>
                                <div class="p-3 lg:p-4 bg-slate-50 dark:bg-white/5 rounded-2xl border border-transparent group-hover:border-slate-100 dark:group-hover:border-white/5 transition-all cursor-pointer">
                                    <p class="text-[9px] lg:text-[10px] font-semibold text-slate-400 uppercase tracking-tighter mb-1">@appt.ScheduledTime.ToString("hh:mm tt")</p>
                                    <p class="text-sm font-semibold text-slate-800 dark:text-white group-hover:text-blue-500 transition-colors">@(appt.Patient?.Name ?? appt.Patient?.UserName ?? "Patient")</p>
                                    <div class="flex items-center mt-1 lg:mt-2">
                                        <span class="text-[10px] lg:text-[11px] font-medium text-slate-500 dark:text-slate-400">@appt.ConsultationType</span>
                                        <span class="mx-2 text-slate-300">/</span>
                                        <span class="text-[10px] lg:text-[11px] font-semibold text-blue-500 uppercase">Room 0@(new Random().Next(1,9))</span>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-6 lg:py-10">
                            <i class="fas fa-calendar-check text-slate-200 text-2xl lg:text-3xl mb-3 lg:mb-4"></i>
                            <p class="text-[10px] lg:text-xs font-bold text-slate-400">Operational Loop Clear</p>
                        </div>
                    }
                </div>
                
                <a asp-action="Schedule" class="w-full mt-6 lg:mt-10 py-3 lg:py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-2xl text-[10px] lg:text-xs font-semibold flex items-center justify-center hover:opacity-90 transition-all group shadow-xl">
                    Deploy Scheduler <i class="fas fa-chevron-right ml-2 lg:ml-3 group-hover:translate-x-1 transition-transform"></i>
                </a>
            </div>

            <!-- Advanced Analytics: Gated -->
            <div class="premium-card p-6 lg:p-8 bg-white dark:bg-slate-900/50 @(ViewBag.IsPro == true ? "" : "opacity-60 grayscale-[0.5]")">
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-900 dark:text-white">Advanced Insights</h3>
                        <p class="text-[10px] font-semibold text-blue-500 uppercase tracking-widest mt-1">Predictive Analytics</p>
                    </div>
                    @if (ViewBag.IsPro == true) {
                        <div class="w-10 h-10 bg-emerald-500/10 text-emerald-500 rounded-xl flex items-center justify-center">
                            <i class="fas fa-microchip"></i>
                        </div>
                    } else {
                        <a asp-action="MedLinkPro" class="w-10 h-10 bg-slate-100 dark:bg-white/5 text-slate-400 rounded-xl flex items-center justify-center hover:text-blue-500 transition-all">
                            <i class="fas fa-lock text-xs"></i>
                        </a>
                    }
                </div>
                
                @if (ViewBag.IsPro == true) {
                    <div class="space-y-4">
                        <div class="p-4 bg-slate-50 dark:bg-white/5 rounded-2xl border border-slate-100 dark:border-white/5">
                            <div class="flex justify-between mb-2">
                                <span class="text-[10px] font-bold text-slate-500 uppercase">Patient Growth Trend</span>
                                <span class="text-[10px] font-semibold text-emerald-500">+24% MoM</span>
                            </div>
                            <div class="w-full bg-slate-200 dark:bg-white/10 h-1.5 rounded-full overflow-hidden">
                                <div class="bg-emerald-500 h-full w-[70%]"></div>
                            </div>
                        </div>
                        <p class="text-[11px] text-slate-500 leading-relaxed italic">"Our AI predicts a 15% increase in respiratory consultations over the next 14 days based on regional trends."</p>
                    </div>
                } else {
                    <div class="py-10 text-center space-y-4">
                        <i class="fas fa-chart-area text-slate-200 text-4xl"></i>
                        <p class="text-xs font-bold text-slate-400 px-4">Unlock the Advanced Analytics Suite to see predictive patient trends and growth metrics.</p>
                        <a asp-action="MedLinkPro" class="inline-block px-6 py-2 bg-blue-600 text-white text-[10px] font-semibold rounded-xl uppercase tracking-widest shadow-lg shadow-blue-500/20 transition-all active:scale-95">Upgrade for Insights</a>
                    </div>
                }
            </div>

            <!-- Pro Upgrade / Support Card -->
            <div class="relative group overflow-hidden p-6 lg:p-8 rounded-[32px] lg:rounded-[40px] @(ViewBag.IsPro == true ? "bg-gradient-to-br from-emerald-600 via-teal-600 to-emerald-700" : "bg-gradient-to-br from-indigo-600 via-blue-600 to-indigo-700") shadow-2xl @(ViewBag.IsPro == true ? "shadow-emerald-500/40" : "shadow-blue-500/40")">
                <div class="absolute top-0 right-0 p-4 opacity-20 transform translate-x-4 -translate-y-4 group-hover:translate-x-0 group-hover:translate-y-0 transition-transform duration-700">
                    <i class="fas @(ViewBag.IsPro == true ? "fa-headset" : "fa-dna") text-[80px] lg:text-[120px] text-white"></i>
                </div>
                
                <div class="relative z-10">
                    <div class="w-10 h-10 lg:w-14 lg:h-14 bg-white/10 backdrop-blur-xl rounded-xl lg:rounded-2xl flex items-center justify-center mb-6 lg:mb-8 border border-white/20">
                        <i class="fas @(ViewBag.IsPro == true ? "fa-crown" : "fa-bolt-lightning") text-white text-lg lg:text-xl @(ViewBag.IsPro != true ? "animate-pulse" : "")"></i>
                    </div>
                    @if (ViewBag.IsPro == true) {
                        <h4 class="text-xl lg:text-2xl font-semibold text-white leading-none tracking-tighter">Priority 24/7<br/>Neural Support</h4>
                        <p class="text-white/70 text-xs lg:text-sm font-medium mt-3 lg:mt-4 line-clamp-2">You are currently on the PRO network. Connect directly with our clinical engineering team.</p>
                        <a asp-action="VIPSupport" class="block text-center w-full mt-6 lg:mt-10 py-3 lg:py-4 bg-white text-emerald-600 font-semibold text-xs lg:text-sm rounded-xl lg:rounded-2xl hover:bg-slate-50 transition-all shadow-lg">
                            Open VIP Channel
                        </a>
                    } else {
                        <h4 class="text-xl lg:text-2xl font-semibold text-white leading-none tracking-tighter">Ascend to<br/>MedLink PRO</h4>
                        <p class="text-white/70 text-xs lg:text-sm font-medium mt-3 lg:mt-4 line-clamp-2">Initialize AI diagnostic tools and multi-tenant analytics layer for elite clinical performance.</p>
                        <a asp-action="MedLinkPro" class="block text-center w-full mt-6 lg:mt-10 py-3 lg:py-4 bg-white text-blue-600 font-semibold text-xs lg:text-sm rounded-xl lg:rounded-2xl hover:bg-slate-50 transition-all active:scale-95 shadow-lg">
                            Expand Capability
                        </a>
                    }
                    
                    <div class="mt-4 lg:mt-6 flex items-center justify-center space-x-4 opacity-50">
                        <div class="flex -space-x-2">
                            <div class="w-5 h-5 lg:w-6 lg:h-6 rounded-full bg-white/20 border border-white/30"></div>
                            <div class="w-5 h-5 lg:w-6 lg:h-6 rounded-full bg-white/20 border border-white/30"></div>
                            <div class="w-5 h-5 lg:w-6 lg:h-6 rounded-full bg-white/20 border border-white/30"></div>
                        </div>
                        <span class="text-[9px] lg:text-[10px] font-bold text-white uppercase tracking-widest">@(ViewBag.IsPro == true ? "VIP Tier Active" : "Join 4k+ Clinicians")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Deploy Initial Record -->
<div class="modal fade" id="initialRecordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-none shadow-2xl glass-panel rounded-[40px] overflow-hidden">
            <div class="p-10 border-b border-slate-100 dark:border-white/5 bg-slate-50/50 dark:bg-white/2">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-xl font-semibold text-slate-900 dark:text-white tracking-tight">Intelligence Deployment</h3>
                        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-1">Initialize Patient Record Node</p>
                    </div>
                    <button type="button" class="w-10 h-10 flex items-center justify-center text-slate-400 hover:text-slate-900 dark:hover:text-white transition-all" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <form id="initialRecordForm" class="p-10 space-y-8">
                <div class="space-y-3">
                    <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest ml-1">Target Patient Node</label>
                    <select id="ajaxPatientSelect" name="PatientId" class="premium-input w-full" required>
                        <option value="">Querying Active Nodes...</option>
                    </select>
                </div>
                <div class="space-y-3">
                    <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest ml-1">Clinical Diagnosis</label>
                    <input type="text" name="Diagnosis" class="premium-input w-full" placeholder="Identify pathological vectors..." required />
                </div>
                <div class="space-y-3">
                    <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest ml-1">Pharmacological Deck</label>
                    <textarea name="Prescription" class="premium-input w-full text-xs" rows="3" placeholder="Draft treatment protocol..."></textarea>
                </div>
                <div class="pt-6 flex gap-4">
                    <button type="button" class="flex-1 py-4 text-[11px] font-semibold text-slate-400 uppercase tracking-widest hover:text-slate-900 dark:hover:text-white transition-all" data-bs-dismiss="modal">Abort</button>
                    <button type="submit" class="flex-[2] py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-2xl text-[11px] font-semibold uppercase tracking-widest shadow-xl active:scale-95 transition-all">
                        Commit Record
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        // Micro-interactions and animations
        document.addEventListener('DOMContentLoaded', function() {
            // Stats cards transition is now handled by class 'glass-card' transition property
            
            // --- ApexCharts Implementation ---
            // Simulate 'History' to reach current totals
            const totalPatients = @Model.TotalPatients;
            const activeTreatments = @Model.ActiveTreatments;
            
            // Generate a sleek curve ending at the real values
            const generateTrend = (endValue, days) => {
                let data = [];
                let current = Math.floor(endValue * 0.4); // Start at 40%
                for(let i=0; i<days-1; i++) {
                     // Add random flutter but trend up
                     let jump = Math.floor(Math.random() * (endValue/days * 2));
                     current += jump;
                     if(current > endValue) current = endValue - 2;
                     data.push(current);
                }
                data.push(endValue); // Ensure we land exactly on the real number
                return data;
            };

            const options = {
                series: [{
                    name: 'Total Patients',
                    data: generateTrend(totalPatients, 7)
                }, {
                    name: 'Active Cases',
                    data: generateTrend(activeTreatments, 7)
                }],
                chart: {
                    type: 'area',
                    height: 250,
                    toolbar: { show: false },
                    fontFamily: 'Outfit, sans-serif',
                    background: 'transparent',
                    animations: {
                        enabled: true,
                        easing: 'easeinout',
                        speed: 800,
                    }
                },
                colors: ['#3b82f6', '#10b981'], // Blue-500, Emerald-500
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.4,
                        opacityTo: 0.05,
                        stops: [0, 90, 100]
                    }
                },
                dataLabels: { enabled: false },
                stroke: {
                    curve: 'smooth',
                    width: 3
                },
                xaxis: {
                    categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'], // Static for loop feeling
                    axisBorder: { show: false },
                    axisTicks: { show: false },
                    labels: {
                        style: {
                            colors: '#94a3b8',
                            fontSize: '10px',
                            fontWeight: 700,
                        }
                    }
                },
                yaxis: {
                    show: false // Minimalist look
                },
                grid: {
                    show: true,
                    borderColor: 'rgba(148, 163, 184, 0.1)',
                    strokeDashArray: 4,
                    padding: { top: 0, right: 0, bottom: 0, left: 10 }
                },
                tooltip: {
                    theme: 'dark', // Always dark for premium feel
                    x: { show: false },
                    style: { fontSize: '12px' },
                    marker: { show: false },
                },
                legend: { show: false } // Hide legend for cleaner UI
            };

            const chart = new ApexCharts(document.querySelector("#clinicPerformanceChart"), options);
            chart.render();


            // --- Search Functionality ---
            const gSearch = document.getElementById('globalSearch');
            const patientCards = document.querySelectorAll('.patient-card');
            const noResults = document.getElementById('noResults');

            gSearch?.addEventListener('input', function(e) {
                const query = e.target.value.toLowerCase().trim();
                let visibleCount = 0;

                patientCards.forEach(card => {
                    const name = card.getAttribute('data-patient-name');
                    if (name.includes(query)) {
                        card.style.display = 'block';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (noResults) {
                    noResults.style.display = (visibleCount === 0 && query !== '') ? 'block' : 'none';
                }
            });

            // --- Export Report Functionality ---
            document.getElementById('exportReport')?.addEventListener('click', async function() {
                const patients = @Html.Raw(Json.Serialize(Model.RecentPatients ?? new List<PatientCardViewModel>()));
                if (patients.length === 0) {
                    await PremiumModal.alert('No patient items detected in the analytics buffer.', 'Empty Feed');
                    return;
                }

                let csvContent = "data:text/csv;charset=utf-8,";
                csvContent += "Patient ID,Name,Condition,Status,Last Visit\n";

                patients.forEach(function(p) {
                    const lastVisit = p.lastVisit ? new Date(p.lastVisit).toLocaleDateString() : "N/A";
                    csvContent += `${p.patientId},"${p.name}","${p.condition}","${p.status}",${lastVisit}\n`;
                });

                const encodedUri = encodeURI(csvContent);
                const link = document.createElement("a");
                link.setAttribute("href", encodedUri);
                link.setAttribute("download", `Patient_Report_${new Date().toLocaleDateString()}.csv`);
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
            });
        });

        async function openInitialRecordModal() {
            const modalElement = document.getElementById('initialRecordModal');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            modal.show();
            
            // Fetch patients via AJAX
            try {
                const response = await fetch('/Doctor/Doctor/GetPatientsAjax');
                const patients = await response.json();
                const select = document.getElementById('ajaxPatientSelect');
                select.innerHTML = '<option value="">Select Patient Node</option>';
                patients.forEach(p => {
                    select.innerHTML += `<option value="${p.id}">${p.name}</option>`;
                });
            } catch (error) {
                console.error('Core sync failure:', error);
            }
        }

        document.getElementById('initialRecordForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());

            try {
                const response = await fetch('/Doctor/Doctor/CreateRecordAjax', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ""
                    },
                    body: new URLSearchParams(formData).toString()
                });
                const result = await response.json();
                if (result.success) {
                    await PremiumModal.success(result.message, 'Node Dispatched');
                    location.reload();
                } else {
                    await PremiumModal.error('Deployment failed: ' + result.errors.join(', '), 'Commit Failure');
                }
            } catch (error) {
                console.error('Deployment protocol error:', error);
            }
        });
    </script>
}
