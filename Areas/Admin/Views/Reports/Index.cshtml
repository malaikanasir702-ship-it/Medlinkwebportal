@model IEnumerable<MedLinkPortal.Models.Report>
@{
    ViewData["Title"] = "Reports & Suspensions";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    // Using simple styling that matches typical dashboards
}

<!-- Main Content Section -->
<div class="px-6 lg:px-10 py-8">
    <!-- Header -->
    <div class="mb-10 bento-card p-8 flex flex-col md:flex-row md:items-center justify-between border-l-4 border-l-primary/80">
        <div>
            <h2 class="text-3xl font-semibold tracking-tight text-slate-900 mb-2">Reports & Moderation</h2>
            <p class="text-slate-500 font-medium max-w-2xl">Manage patient reports, suspend violating doctors, and review their appeal submissions.</p>
        </div>
        <div class="mt-4 md:mt-0 flex gap-4">
            <div class="bg-indigo-50 px-4 py-3 rounded-2xl flex items-center gap-3">
                <div class="bg-indigo-100 p-2 rounded-xl text-indigo-600">
                    <i class="fa-solid fa-flag"></i>
                </div>
                <div>
                    <p class="text-xs font-bold text-indigo-500 uppercase tracking-wider">Total Reports</p>
                    <p class="text-lg font-semibold text-indigo-900 leading-none mt-1">@Model.Count()</p>
                </div>
            </div>
            <div class="bg-rose-50 px-4 py-3 rounded-2xl flex items-center gap-3">
                <div class="bg-rose-100 p-2 rounded-xl text-rose-600">
                    <i class="fa-solid fa-ban"></i>
                </div>
                <div>
                    <p class="text-xs font-bold text-rose-500 uppercase tracking-wider">Open Issues</p>
                    <p class="text-lg font-semibold text-rose-900 leading-none mt-1">@Model.Count(r => r.Status == "Open")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Reports Table -->
    <div class="bento-card overflow-hidden">
        <div class="bg-white px-8 py-6 border-b border-slate-100 flex items-center gap-4">
            <div class="bg-blue-50 text-primary p-3 rounded-2xl">
                <i class="fa-solid fa-list-check text-xl"></i>
            </div>
            <div>
                <h3 class="text-xl font-bold text-slate-800">Recent Reports</h3>
                <p class="text-sm text-slate-500 font-medium">Detailed log of patient-submitted issues</p>
            </div>
        </div>
        
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/80 text-xs uppercase tracking-widest text-slate-500 font-bold border-b border-slate-100">
                        <th class="py-4 px-8 font-semibold">Date</th>
                        <th class="py-4 px-6 font-semibold">Reported By</th>
                        <th class="py-4 px-6 font-semibold">Doctor</th>
                        <th class="py-4 px-6 font-semibold">Issue Type</th>
                        <th class="py-4 px-6 font-semibold">Description</th>
                        <th class="py-4 px-6 font-semibold">Status</th>
                        <th class="py-4 px-8 text-right font-semibold">Action</th>
                    </tr>
                </thead>
                <tbody class="text-sm">
                    @if(!Model.Any()) {
                        <tr>
                            <td colspan="7" class="py-16 text-center">
                                <div class="inline-flex flex-col items-center justify-center p-6 bg-slate-50 rounded-3xl border border-slate-100 border-dashed">
                                    <i class="fa-solid fa-check-double text-4xl text-slate-300 mb-4"></i>
                                    <p class="text-slate-500 font-medium">No reports found.</p>
                                    <p class="text-xs text-slate-400 mt-1">Platform is operating smoothly.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var report in Model)
                    {
                        <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition-colors group">
                            <td class="py-5 px-8 whitespace-nowrap">
                                <div class="font-bold text-slate-700">@report.DateReported.ToString("MMM dd")</div>
                                <div class="text-xs text-slate-400 font-medium">@report.DateReported.ToString("yyyy")</div>
                            </td>
                            <td class="py-5 px-6">
                                <div class="flex items-center gap-3">
                                    <div class="h-10 w-10 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 font-bold shadow-sm">
                                        @((report.ReportedBy?.Name ?? "U").Substring(0, 1).ToUpper())
                                    </div>
                                    <div>
                                        <p class="font-bold text-slate-800">@report.ReportedBy?.Name</p>
                                        <p class="text-xs text-slate-500 truncate max-w-[150px]">@report.ReportedBy?.Email</p>
                                    </div>
                                </div>
                            </td>
                            <td class="py-5 px-6">
                                <p class="font-bold text-slate-800">Dr. @report.ReportedDoctor?.Name</p>
                                @if(report.ReportedDoctor?.IsSuspended == true) {
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-rose-50 text-rose-600 border border-rose-100 uppercase tracking-wider mt-1">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                        Suspended
                                    </span>
                                }
                            </td>
                            <td class="py-5 px-6">
                                <span class="px-3 py-1.5 bg-slate-100 text-slate-600 rounded-xl text-xs font-bold whitespace-nowrap">
                                    @report.IssueType
                                </span>
                            </td>
                            <td class="py-5 px-6">
                                <p class="text-slate-600 max-w-xs truncate text-sm font-medium" title="@report.Description">
                                    @report.Description
                                </p>
                            </td>
                            <td class="py-5 px-6">
                                @if(report.Status == "Open") {
                                    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-50 text-amber-700 border border-amber-200 shadow-sm">
                                        <span class="w-2 h-2 rounded-full bg-amber-500 animate-pulse"></span>
                                        Open
                                    </span>
                                } else {
                                    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-600 border border-slate-200">
                                        Resolved
                                    </span>
                                }
                            </td>
                            <td class="py-5 px-8 whitespace-nowrap text-right">
                                @if(report.ReportedDoctor?.IsSuspended != true)
                                {
                                    <button onclick="openSuspendModal(@report.ReportedDoctorId, `@report.ReportedDoctor?.Name`)" class="inline-flex items-center gap-2 px-4 py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-100 transition-colors rounded-xl font-bold text-xs">
                                        <i class="fa-solid fa-ban"></i>
                                        Suspend
                                    </button>
                                } 
                                else 
                                {
                                    @if(report.ReportedDoctor?.IsAppealing == true)
                                    {
                                        <button onclick="openAppealModal(@report.ReportedDoctorId, `@Uri.EscapeDataString(report.ReportedDoctor.AppealMessage ?? "")`)" class="inline-flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white shadow-shadow transition-colors rounded-xl font-bold text-xs">
                                            <i class="fa-solid fa-file-signature"></i>
                                            Review Appeal
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-2 px-4 py-2 bg-slate-50 text-slate-400 border border-slate-100 rounded-xl font-bold text-xs cursor-not-allowed">
                                            <i class="fa-solid fa-lock"></i>
                                            Locked
                                        </span>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Suspend Modal (Tailwind) -->
<div id="suspendModal" class="hidden fixed inset-0 z-[100] outline-none overflow-x-hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:p-0">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" aria-hidden="true" onclick="closeModals()"></div>

        <div class="relative inline-block align-bottom bg-white rounded-3xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full border border-slate-100">
            <div class="bg-white px-8 pt-8 pb-6">
                <div class="sm:flex sm:items-start">
                    <div class="mx-auto flex-shrink-0 flex items-center justify-center h-14 w-14 rounded-full bg-rose-100 sm:mx-0 sm:h-12 w-12 text-rose-600">
                        <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                    </div>
                    <div class="mt-4 text-center sm:mt-0 sm:ml-5 sm:text-left">
                        <h3 class="text-xl leading-6 font-semibold text-slate-900" id="modal-title">Suspend Doctor</h3>
                        <div class="mt-2 text-sm text-slate-500 font-medium">
                            <p>You are about to suspend <strong id="suspendDocName" class="text-slate-800"></strong>. This action will immediately block their access to the platform and hide them from search.</p>
                        </div>
                    </div>
                </div>
                
                <div class="mt-8">
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">Suspension Reason <span class="text-red-500">*</span></label>
                    <textarea id="suspendReason" rows="3" class="w-full bg-slate-50 border border-slate-200 rounded-2xl px-4 py-3 text-slate-700 focus:outline-none focus:ring-2 focus:ring-rose-500 focus:border-rose-500 resize-none font-medium text-sm transition-all placeholder:text-slate-400" placeholder="Required. This will be visible to the doctor..."></textarea>
                </div>
                <input type="hidden" id="suspendDocId" />
            </div>
            
            <div class="bg-slate-50 px-8 py-5 border-t border-slate-100 sm:flex sm:flex-row-reverse gap-3">
                <button type="button" onclick="submitSuspend()" class="w-full inline-flex justify-center rounded-xl border border-transparent shadow-sm px-6 py-3 bg-rose-600 text-base font-bold text-white hover:bg-rose-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-rose-500 sm:w-auto sm:text-sm transition-colors">
                    Confirm Suspension
                </button>
                <button type="button" onclick="closeModals()" class="mt-3 w-full inline-flex justify-center rounded-xl border border-slate-200 shadow-sm px-6 py-3 bg-white text-base font-bold text-slate-700 hover:bg-slate-50 focus:outline-none sm:mt-0 sm:w-auto sm:text-sm transition-colors">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Appeal Modal (Tailwind) -->
<div id="appealModal" class="hidden fixed inset-0 z-[100] outline-none overflow-x-hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:p-0">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity" aria-hidden="true" onclick="closeModals()"></div>

        <div class="relative inline-block align-bottom bg-white rounded-3xl text-left overflow-hidden shadow-2xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg w-full border border-slate-100">
            <div class="bg-white px-8 pt-8 pb-6">
                <div class="sm:flex sm:items-start">
                    <div class="mx-auto flex-shrink-0 flex items-center justify-center h-14 w-14 rounded-full bg-indigo-100 sm:mx-0 sm:h-12 w-12 text-indigo-600">
                        <i class="fa-solid fa-scale-balanced text-xl"></i>
                    </div>
                    <div class="mt-4 text-center sm:mt-0 sm:ml-5 sm:text-left">
                        <h3 class="text-xl leading-6 font-semibold text-slate-900">Review Appeal</h3>
                        <div class="mt-2 text-sm text-slate-500 font-medium">
                            <p>Carefully review the doctor's statement before making a decision.</p>
                        </div>
                    </div>
                </div>
                
                <div class="mt-8 bg-slate-50 rounded-2xl p-5 border border-slate-100 relative">
                    <div class="absolute -top-3 left-4 bg-white px-2 text-[10px] font-bold text-slate-400 uppercase tracking-widest border border-slate-100 rounded-md shadow-sm">Doctor's Statement</div>
                    <p id="appealMessageText" class="text-slate-700 text-sm font-medium leading-relaxed italic border-l-2 border-indigo-200 pl-3"></p>
                </div>
                
                <p class="mt-6 text-sm text-slate-600 font-semibold text-center">Are you satisfied and wish to restore this doctor's account access?</p>
                
                <input type="hidden" id="appealDocId" />
            </div>
            
            <div class="bg-slate-50 px-8 py-5 border-t border-slate-100 sm:flex sm:flex-row-reverse gap-3">
                <button type="button" onclick="submitRestore()" class="w-full inline-flex justify-center rounded-xl border border-transparent shadow-sm px-6 py-3 bg-emerald-600 text-base font-bold text-white hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 sm:w-auto sm:text-sm transition-colors">
                    <i class="fa-solid fa-unlock mr-2"></i> Restore Account
                </button>
                <button type="button" onclick="closeModals()" class="mt-3 w-full inline-flex justify-center rounded-xl border border-slate-200 shadow-sm px-6 py-3 bg-white text-base font-bold text-slate-700 hover:bg-slate-50 focus:outline-none sm:mt-0 sm:w-auto sm:text-sm transition-colors">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openSuspendModal(id, name) {
            document.getElementById('suspendDocId').value = id;
            document.getElementById('suspendDocName').textContent = name;
            document.getElementById('suspendReason').value = '';
            document.getElementById('suspendModal').classList.remove('hidden');
        }

        function openAppealModal(id, encodedMessage) {
            document.getElementById('appealDocId').value = id;
            document.getElementById('appealMessageText').textContent = decodeURIComponent(encodedMessage);
            document.getElementById('appealModal').classList.remove('hidden');
        }

        function closeModals() {
            document.getElementById('suspendModal').classList.add('hidden');
            document.getElementById('appealModal').classList.add('hidden');
        }

        function submitSuspend() {
            const id = document.getElementById('suspendDocId').value;
            const reason = document.getElementById('suspendReason').value;
            
            if(!reason) {
                document.getElementById('suspendReason').classList.add('border-rose-500', 'ring-1', 'ring-rose-500');
                setTimeout(() => document.getElementById('suspendReason').classList.remove('border-rose-500', 'ring-1', 'ring-rose-500'), 1500);
                return;
            }

            fetch('/Admin/Reports/SuspendDoctor', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `doctorId=${id}&reason=${encodeURIComponent(reason)}`
            }).then(r => r.json()).then(res => {
                location.reload();
            }).catch(err => {
                location.reload(); // Quick fallback
            });
        }

        function submitRestore() {
            const id = document.getElementById('appealDocId').value;
            
            fetch('/Admin/Reports/RestoreDoctor', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `doctorId=${id}`
            }).then(r => r.json()).then(res => {
                location.reload();
            }).catch(err => {
                location.reload();
            });
        }
    </script>
}
