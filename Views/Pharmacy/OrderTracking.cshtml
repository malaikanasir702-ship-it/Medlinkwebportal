@model MedLinkPortal.Models.PatientDashboardModel
@{
    ViewData["Title"] = "Order Tracking";
    Layout = "_DashboardLayout";
    
    var order = Model?.CurrentOrder;
    if (order == null)
    {
        <div class="min-h-screen flex items-center justify-center">
            <div class="text-center p-8 bg-white rounded-3xl shadow-xl border border-slate-100">
                <i data-lucide="alert-circle" class="w-16 h-16 text-rose-500 mb-4 mx-auto"></i>
                <h2 class="text-xl font-bold text-slate-900">Order Information Unavailable</h2>
                <p class="text-slate-500 mt-2">We couldn't load the details for this order at this moment.</p>
                <a href="/Dashboard" class="mt-6 inline-block px-6 py-2 bg-blue-600 text-white rounded-xl font-bold">Back to Dashboard</a>
            </div>
        </div>
        return;
    }
    int statusStep = (int)order.Status;
}

<div class="min-h-screen bg-slate-50/50 pb-20">
    <div class="max-w-4xl mx-auto px-4 py-8 lg:py-12">
        <!-- Header -->
        <div class="bg-white rounded-[2.5rem] p-8 md:p-10 border border-slate-100 shadow-xl mb-8 relative overflow-hidden">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 relative z-10">
                <div class="flex items-center gap-6">
                    <div class="w-16 h-16 bg-emerald-600 rounded-2xl flex items-center justify-center text-white shadow-xl shadow-emerald-600/20">
                        <i data-lucide="package" class="w-10 h-10"></i>
                    </div>
                    <div>
                        <h1 class="text-2xl md:text-3xl font-black text-slate-900 tracking-tight">Order #MED-@order.Id.ToString("D5")</h1>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">Placed on @order.CreatedAt.ToString("MMM dd, yyyy • HH:mm")</p>
                    </div>
                </div>
                <div class="flex items-center gap-3 bg-emerald-50 px-5 py-2.5 rounded-full border border-emerald-100 shadow-sm">
                    <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                    <span class="text-xs font-black text-emerald-700 uppercase tracking-widest">@order.Status</span>
                </div>
            </div>
            
            <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-emerald-600/5 rounded-full blur-[100px] -z-0"></div>
        </div>

        <!-- Tracking Timeline -->
        <div class="bg-white rounded-[2.5rem] p-8 md:p-12 border border-slate-100 shadow-xl mb-8">
            <h2 class="text-sm font-black text-slate-400 uppercase tracking-[0.2em] mb-10 ml-1">Journey Status</h2>
            
            <div class="relative">
                <!-- Progress Line -->
                <div class="absolute left-6 md:left-1/2 top-0 bottom-0 w-1 bg-slate-100 md:-translate-x-1/2 rounded-full overflow-hidden">
                    <div class="absolute top-0 left-0 right-0 bg-emerald-500 rounded-full transition-all duration-1000" style="height: @(statusStep * 25)%;"></div>
                </div>

                <div class="space-y-12">
                    <!-- Step 1: Pending -->
                    <div class="relative flex items-center md:justify-center gap-8 md:gap-0">
                        <div class="md:w-1/2 flex justify-end md:pr-16 order-2 md:order-1">
                             <div class="text-right hidden md:block">
                                <h4 class="font-black text-slate-900 @(statusStep >= 0 ? "text-emerald-600" : "text-slate-400")">Order Placed</h4>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Awaiting Pharmacist Acceptance</p>
                             </div>
                        </div>
                        <div class="w-12 h-12 rounded-full @(statusStep >= 0 ? "bg-emerald-500 shadow-lg shadow-emerald-500/30" : "bg-slate-200") flex items-center justify-center text-white z-10 shrink-0 order-1 md:order-2">
                            <i data-lucide="receipt" class="w-6 h-6"></i>
                        </div>
                        <div class="md:w-1/2 md:pl-16 order-3">
                            <div class="md:hidden">
                                <h4 class="font-black text-slate-900">Order Placed</h4>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Awaiting Pharmacist Acceptance</p>
                            </div>
                        </div>
                    </div>

                    <!-- Step 2: Accepted -->
                    <div class="relative flex items-center md:justify-center gap-8 md:gap-0">
                        <div class="md:w-1/2 md:pr-16 order-2 md:order-1">
                            <div class="md:pl-0 pl-0">
                                <div class="md:hidden">
                                    <h4 class="font-black text-slate-900 @(statusStep >= 1 ? "" : "text-slate-300")">Confirmed</h4>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Pharmacist is preparing your meds</p>
                                </div>
                            </div>
                        </div>
                        <div class="w-12 h-12 rounded-full @(statusStep >= 1 ? "bg-emerald-500 shadow-lg shadow-emerald-500/30" : "bg-slate-200") flex items-center justify-center text-white z-10 shrink-0 order-1 md:order-2">
                            <i data-lucide="circle-check" class="w-6 h-6"></i>
                        </div>
                        <div class="md:w-1/2 md:pl-16 order-3">
                            <div class="hidden md:block">
                                <h4 class="font-black text-slate-900 @(statusStep >= 1 ? "text-emerald-600" : "text-slate-400")">Confirmed</h4>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Pharmacist is preparing your meds</p>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Dispatched -->
                    <div class="relative flex items-center md:justify-center gap-8 md:gap-0">
                        <div class="md:w-1/2 flex justify-end md:pr-16 order-2 md:order-1">
                             <div class="text-right hidden md:block">
                                <h4 class="font-black text-slate-900 @(statusStep >= 3 ? "text-emerald-600" : "text-slate-400")">Out for Delivery</h4>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Rider has picked up your order</p>
                             </div>
                        </div>
                        <div class="w-12 h-12 rounded-full @(statusStep >= 3 ? "bg-emerald-500 shadow-lg shadow-emerald-500/30" : "bg-slate-200") flex items-center justify-center text-white z-10 shrink-0 order-1 md:order-2">
                            <i data-lucide="truck" class="w-6 h-6"></i>
                        </div>
                        <div class="md:w-1/2 md:pl-16 order-3">
                             <div class="md:hidden">
                                <h4 class="font-black text-slate-900 @(statusStep >= 3 ? "" : "text-slate-300")">Out for Delivery</h4>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Rider has picked up your order</p>
                             </div>
                        </div>
                    </div>

                    <!-- Step 4: Delivered -->
                    <div class="relative flex items-center md:justify-center gap-8 md:gap-0">
                        <div class="md:w-1/2 md:pr-16 order-2 md:order-1"></div>
                        <div class="w-12 h-12 rounded-full @(statusStep >= 4 ? "bg-emerald-500 shadow-lg shadow-emerald-500/30" : "bg-slate-200") flex items-center justify-center text-white z-10 shrink-0 order-1 md:order-2">
                            <i data-lucide="home" class="w-6 h-6"></i>
                        </div>
                        <div class="md:w-1/2 md:pl-16 order-3">
                             <div>
                                <h4 class="font-black text-slate-900 @(statusStep >= 4 ? "text-emerald-600" : "text-slate-400")">Delivered</h4>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Package received successfully</p>
                             </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Order Details -->
            <div class="bg-white rounded-[2.5rem] p-8 md:p-10 border border-slate-100 shadow-xl">
                 <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-6 border-b border-slate-50 pb-4">Package Contents</h3>
                 <div class="space-y-4">
                    @foreach (var item in order.OrderItems ?? new List<MedLinkPortal.Models.PharmacyOrderItem>())
                    {
                        <div class="flex justify-between items-center p-4 bg-slate-50 rounded-2xl border border-slate-100">
                            <div>
                                <p class="font-bold text-slate-900 text-sm">@item.Medicine.Name</p>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">PKR @item.UnitPrice x @item.Quantity</p>
                            </div>
                            <p class="font-black text-slate-900">PKR @(item.UnitPrice * item.Quantity)</p>
                        </div>
                    }
                    <div class="pt-6 mt-4 border-t border-dashed border-slate-200 flex justify-between items-center px-2">
                        <span class="text-xs font-black text-slate-400 uppercase tracking-widest">Total Paid</span>
                        <span class="text-2xl font-black text-emerald-600">PKR @order.TotalAmount</span>
                    </div>
                 </div>
            </div>

            <!-- Shipping Information -->
            <div class="bg-slate-900 rounded-[2.5rem] p-8 md:p-10 border border-white/5 shadow-2xl relative overflow-hidden">
                <h3 class="text-xs font-black text-white/40 uppercase tracking-widest mb-6 border-b border-white/5 pb-4">Destination Intelligence</h3>
                
                <div class="space-y-6 relative z-10">
                    <div>
                        <p class="text-[10px] font-black text-emerald-500 uppercase tracking-widest mb-2">Delivery Address</p>
                        <p class="text-sm font-bold text-white/80 leading-relaxed">@order.ShippingAddress</p>
                    </div>
                    <div>
                        <p class="text-[10px] font-black text-emerald-500 uppercase tracking-widest mb-2">Payment Method</p>
                        <div class="flex items-center gap-3">
                             <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-white">
                                <i data-lucide="credit-card" class="w-4 h-4"></i>
                             </div>
                             <span class="text-sm font-bold text-white/80">@order.PaymentMethod</span>
                        </div>
                    </div>
                    <div class="pt-4">
                         <a href="@Url.Action("SupportIntelligence", "Pharmacy", new { id = order.Id })" class="w-full py-4 bg-white/10 text-white font-black text-xs rounded-2xl border border-white/10 hover:bg-white/20 transition-all flex items-center justify-center gap-3">
                            <i data-lucide="headphones" class="w-4 h-4"></i> Support Intelligence
                         </a>
                    </div>
                </div>

                <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-emerald-500/10 rounded-full blur-[80px] -z-0"></div>
            </div>
        </div>
    </div>
</div>

<style>
    .animate-in { animation: fadeIn 0.5s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (window.lucide) {
            lucide.createIcons();
        }
    });
</script>
