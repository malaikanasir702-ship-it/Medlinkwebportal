@model IEnumerable<MedLinkPortal.Areas.Doctor.Models.Appointment>

@{
    ViewData["Title"] = "Transcript Archive";
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
}

<div class="p-6 lg:p-10 space-y-10 reveal">
    <!-- Bento Header -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
        <div class="lg:col-span-3 bg-white dark:bg-slate-900 rounded-[3rem] p-10 border border-slate-100 dark:border-white/5 shadow-2xl shadow-blue-500/5 relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-96 h-96 bg-blue-50/50 dark:bg-blue-900/10 rounded-full blur-[100px] -mr-48 -mt-48 transition-transform duration-1000 group-hover:scale-110"></div>
            
            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-8">
                <div class="space-y-4">
                    <div class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-full text-[10px] font-semibold uppercase tracking-[0.2em] border border-blue-100 dark:border-blue-800">
                        <span class="w-2 h-2 bg-blue-600 rounded-full animate-pulse"></span>
                        Clinical Intelligence Archive
                    </div>
                    <h1 class="text-4xl lg:text-5xl font-semibold text-slate-900 dark:text-white leading-tight tracking-tight">
                        Consultation <br/>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">Transcript Records.</span>
                    </h1>
                </div>
                
                <div class="flex flex-col items-start md:items-end gap-3">
                    <div class="flex items-center gap-3 px-4 py-3 bg-slate-50 dark:bg-white/5 rounded-2xl border border-slate-100 dark:border-white/5">
                        <i data-lucide="database" class="w-5 h-5 text-blue-600"></i>
                        <span class="text-[11px] font-semibold text-slate-900 dark:text-white uppercase tracking-widest">@Model.Count() Total Archives</span>
                    </div>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest text-right max-w-[200px]">Synchronized with Neural Core AI Processing</p>
                </div>
            </div>
        </div>

        <div class="bg-slate-900 dark:bg-indigo-950 rounded-[3rem] p-10 text-white flex flex-col justify-between group overflow-hidden relative shadow-2xl">
            <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 to-transparent pointer-events-none"></div>
            <div class="relative z-10">
                <i data-lucide="shield-check" class="w-8 h-8 text-blue-400 group-hover:scale-110 transition-transform"></i>
                <h3 class="text-lg font-semibold mt-4 leading-tight">Secure <br/>Vault Access</h3>
            </div>
            <button class="relative z-10 w-full py-4 bg-white/10 hover:bg-white/20 border border-white/10 rounded-2xl text-[9px] font-semibold uppercase tracking-widest transition-all">Audit Logs</button>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="space-y-6">
        <div class="flex items-center justify-between px-4">
            <div>
                <h2 class="text-2xl font-semibold text-slate-900 dark:text-white tracking-tight">Patient Logs</h2>
                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-1">Archived session transcripts</p>
            </div>
            <div class="relative group">
                <input type="text" placeholder="Search archives..." class="w-72 pl-12 pr-6 py-4 bg-white dark:bg-slate-900 border border-slate-100 dark:border-white/5 rounded-2xl text-[10px] font-semibold uppercase tracking-widest focus:ring-4 focus:ring-blue-500/10 transition-all shadow-sm">
                <i data-lucide="search" class="absolute left-5 top-1/2 -translate-y-1/2 text-slate-300 w-4 h-4"></i>
            </div>
        </div>

        <div class="bg-white dark:bg-slate-900 rounded-[3rem] border border-slate-100 dark:border-white/5 shadow-2xl overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-slate-50/50 dark:bg-white/2 border-b border-slate-100 dark:border-white/5">
                            <th class="px-10 py-8 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Patient Identity</th>
                            <th class="px-6 py-8 text-[10px] font-semibold text-slate-400 uppercase tracking-widest text-center">Modality</th>
                            <th class="px-6 py-8 text-[10px] font-semibold text-slate-400 uppercase tracking-widest text-center">Chronology</th>
                            <th class="px-6 py-8 text-[10px] font-semibold text-slate-400 uppercase tracking-widest text-center">AI Intelligence</th>
                            <th class="px-10 py-8 text-[10px] font-semibold text-slate-400 uppercase tracking-widest text-right">Operational Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-white/5">
                        @foreach (var appt in Model)
                        {
                            <tr class="group hover:bg-slate-50/30 dark:hover:bg-white/2 transition-all duration-300">
                                <td class="px-10 py-8">
                                    <div class="flex items-center gap-5">
                                        <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-blue-50 to-slate-100 dark:from-slate-800 dark:to-slate-700 flex items-center justify-center text-blue-600 dark:text-blue-400 font-semibold text-lg shadow-inner group-hover:scale-105 transition-transform duration-500 border border-slate-100 dark:border-white/5">
                                            @((appt.Patient?.Name ?? "PT").Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="text-[13px] font-semibold text-slate-900 dark:text-white tracking-tight">@(appt.Patient?.Name ?? "Patient Instance")</div>
                                            <div class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter mt-1">Node ID: @(appt.Patient?.Id.Substring(0, 8) ?? "N/A")</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-8 text-center">
                                    <span class="inline-flex px-3 py-1 bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 text-[9px] font-semibold rounded-lg uppercase tracking-widest border border-blue-100 dark:border-blue-800">
                                        @appt.ConsultationType
                                    </span>
                                </td>
                                <td class="px-6 py-8 text-center">
                                    <div class="text-[12px] font-semibold text-slate-900 dark:text-white">@appt.ScheduledTime.ToString("MMM dd, yyyy")</div>
                                    <div class="text-[9px] font-bold text-slate-400 uppercase tracking-widest mt-1">@appt.ScheduledTime.ToString("HH:mm") Z-Time</div>
                                </td>
                                <td class="px-6 py-8 text-center">
                                    <div class="flex items-center justify-center gap-3">
                                        <div class="flex items-center gap-2 px-3 py-1.5 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 text-[9px] font-semibold rounded-full border border-emerald-100 dark:border-emerald-800">
                                            <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
                                            Analyzed
                                        </div>
                                    </div>
                                </td>
                                <td class="px-10 py-8 text-right">
                                    <a asp-action="TranscriptHistory" asp-route-id="@appt.Id" 
                                       class="inline-flex h-12 px-8 items-center justify-center bg-slate-900 text-white dark:bg-white dark:text-slate-900 rounded-2xl text-[10px] font-semibold uppercase tracking-widest hover:bg-blue-600 dark:hover:bg-blue-500 dark:hover:text-white transition-all shadow-xl shadow-slate-900/10">
                                        <i data-lucide="eye" class="w-4 h-4 mr-3"></i> Access Archive
                                    </a>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="py-40 text-center">
                                    <div class="inline-flex items-center justify-center w-28 h-28 bg-slate-50 dark:bg-white/5 rounded-[3rem] mb-10 shadow-inner">
                                        <i data-lucide="server-off" class="w-14 h-14 text-slate-200 dark:text-slate-800"></i>
                                    </div>
                                    <div class="space-y-2">
                                        <h3 class="text-2xl font-semibold text-slate-900 dark:text-white uppercase tracking-widest">Archive Empty</h3>
                                        <p class="text-sm font-bold text-slate-400 max-w-sm mx-auto uppercase tracking-wider leading-relaxed">No medical transcripts found in your clinical node.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
