@model MedLinkPortal.Models.PatientDashboardModel

@{
    ViewData["Title"] = "Request Treatment Abroad";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var destination = ViewBag.Destination as string ?? "Abroad";
}

<div class="max-w-4xl mx-auto space-y-10 py-6">
    <div class="space-y-4">
        <a href="@Url.Action("OutboundSelection")" class="inline-flex items-center gap-2 text-slate-500 hover:text-slate-900 transition-colors font-medium group">
            <i data-lucide="arrow-left" class="w-4 h-4 group-hover:-translate-x-1 transition-transform"></i>
            <span>Change Destination</span>
        </a>
        <h1 class="text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
            Travel to <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">@destination</span>
        </h1>
        <p class="text-slate-500 font-medium text-lg leading-relaxed max-w-2xl">
            Complete the form to start your international medical journey. Our personal medical concierge will reach out within 24 hours.
        </p>
    </div>

    <form asp-action="RequestOutbound" method="post" class="bg-white rounded-[40px] p-10 md:p-12 border border-slate-100 shadow-2xl shadow-slate-200/50 space-y-10 relative overflow-hidden group">
        <div class="absolute top-0 right-0 w-64 h-64 bg-blue-50/50 rounded-full blur-[80px] -translate-y-1/2 translate-x-1/2 group-hover:bg-blue-100/50 transition-colors duration-700"></div>

        <input type="hidden" name="PreferredCountry" value="@destination" />

        <!-- Medical Details -->
        <div class="space-y-8 relative z-10">
             <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600">
                    <i data-lucide="stethoscope" class="w-5 h-5"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900">Medical Details</h3>
             </div>

             <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                 <div class="space-y-2">
                    <label class="block text-xs font-black text-slate-500 uppercase tracking-[0.2em]">Treatment Type</label>
                    <input type="text" name="TreatmentType" placeholder="e.g. Oncology, Neurology" class="w-full px-5 py-4 rounded-2xl bg-slate-50 border-transparent focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all font-bold text-slate-900 placeholder:font-medium placeholder:text-slate-400" required />
                 </div>
                 <div class="space-y-2">
                    <label class="block text-xs font-black text-slate-500 uppercase tracking-[0.2em]">Preferred City (Optional)</label>
                    <input type="text" name="PreferredCity" placeholder="e.g. Rochester, London" class="w-full px-5 py-4 rounded-2xl bg-slate-50 border-transparent focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all font-bold text-slate-900 placeholder:font-medium placeholder:text-slate-400" />
                 </div>
                 <div class="space-y-2">
                    <label class="block text-xs font-black text-slate-500 uppercase tracking-[0.2em]">Budget Range (USD)</label>
                    <div class="relative">
                        <select name="BudgetRange" class="w-full px-5 py-4 rounded-2xl bg-slate-50 border-transparent focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all font-bold text-slate-700 appearance-none">
                            <option value="$5k-10k">$5,000 - $10,000</option>
                            <option value="$10k-25k">$10,000 - $25,000</option>
                            <option value="$25k-50k">$25,000 - $50,000</option>
                            <option value="$50k+">$50,000+</option>
                        </select>
                        <i data-lucide="chevron-down" class="absolute right-5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                    </div>
                 </div>
                 <div class="space-y-2">
                    <label class="block text-xs font-black text-slate-500 uppercase tracking-[0.2em]">Medical Reports (URL)</label>
                    <input type="url" name="MedicalReportsUrl" placeholder="https://drive.google.com/..." class="w-full px-5 py-4 rounded-2xl bg-slate-50 border-transparent focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all font-bold text-slate-900 placeholder:font-medium placeholder:text-slate-400" />
                 </div>
             </div>
        </div>

        <!-- Documentation -->
        <div class="space-y-6 relative z-10">
             <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 rounded-2xl bg-indigo-50 flex items-center justify-center text-indigo-600">
                    <i data-lucide="file-text" class="w-5 h-5"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900">Travel Documentation</h3>
             </div>
             
             <div class="flex flex-col md:flex-row items-start md:items-center gap-8 p-6 rounded-[24px] bg-slate-50/50 border border-slate-100/50">
                 <label class="block font-bold text-slate-700">Do you have a valid passport?</label>
                 <div class="flex gap-6">
                     <label class="flex items-center gap-3 cursor-pointer group/radio">
                         <input type="radio" name="PassportAvailable" value="true" checked class="w-5 h-5 text-blue-600 border-slate-300 focus:ring-blue-500 transition-all" />
                         <span class="font-bold text-slate-700 group-hover/radio:text-blue-600">Yes, have it</span>
                     </label>
                     <label class="flex items-center gap-3 cursor-pointer group/radio">
                         <input type="radio" name="PassportAvailable" value="false" class="w-5 h-5 text-blue-600 border-slate-300 focus:ring-blue-500 transition-all" />
                         <span class="font-bold text-slate-700 group-hover/radio:text-blue-600">No, need help</span>
                     </label>
                 </div>
             </div>
        </div>

        <div class="space-y-2 relative z-10">
             <label class="block text-xs font-black text-slate-500 uppercase tracking-[0.2em]">Additional Notes</label>
             <textarea name="AdditionalNotes" rows="4" class="w-full px-5 py-4 rounded-2xl bg-slate-50 border-transparent focus:bg-white focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10 transition-all font-medium placeholder:text-slate-400" placeholder="Please specify if you need visa assistance, travel for attendants, or have special dietary needs."></textarea>
        </div>

        <button type="submit" class="w-full py-5 bg-slate-900 text-white rounded-2xl font-black text-xs uppercase tracking-[0.3em] hover:bg-blue-600 transition-all shadow-xl hover:shadow-2xl hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-4 relative z-10">
            <span>Submit International Request</span>
            <i data-lucide="arrow-right" class="w-5 h-5"></i>
        </button>
    </form>
</div>

<script>
    lucide.createIcons();
</script>
