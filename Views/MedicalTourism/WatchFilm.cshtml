@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Experience Pakistan - MedLink</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            margin: 0;
            overflow: hidden;
            background-color: black;
        }
        /* Video container with 90-degree rotation */
        .video-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }
        /* Rotated video styling */
        .rotated-video {
            width: 100vh; /* Swap width and height for landscape feel */
            height: 100vw;
            transform: rotate(-90deg);
            object-fit: cover;
        }
    </style>
</head>
<body>

    <!-- Video Player with 90-degree Rotation -->
    <div class="video-container">
        <video class="rotated-video"
               autoplay
               loop
               muted
               controls
               playsinline>
            <source src="~/videos/pakistan_tour.mp4" type="video/mp4">
            Your browser does not support the video tag.
        </video>
    </div>

    <!-- Overlay Controls -->
    <div class="fixed top-0 left-0 w-full p-10 z-50 flex justify-between items-center bg-gradient-to-b from-black/60 to-transparent pointer-events-none">
        <div class="text-white pointer-events-auto">
            <h1 class="text-3xl font-black tracking-tighter mb-1">Experience Pakistan</h1>
            <p class="text-white/50 font-medium text-xs uppercase tracking-[0.3em]">A MedLink Cinematic Original</p>
        </div>

        <a href="@Url.Action("InboundLanding")" class="group pointer-events-auto bg-white/5 backdrop-blur-2xl border border-white/10 w-16 h-16 rounded-full flex items-center justify-center text-white hover:bg-white hover:text-black transition-all duration-500 shadow-2xl">
            <i data-lucide="x" class="w-8 h-8 group-hover:rotate-90 transition-transform duration-500"></i>
        </a>
    </div>

    <script>
        lucide.createIcons();
    </script>
</body>
</html>