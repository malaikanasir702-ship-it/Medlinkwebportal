@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = null; // Clean page for printing
    var appointment = Model.SuccessAppointment;
    var invoiceNo = "INV-" + appointment.Id.ToString("D5");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Invoice @invoiceNo - MedLink</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Outfit', sans-serif; background-color: #f8fafc; }
        @@media print {
            .no-print { display: none !important; }
            body { background-color: white; }
            .invoice-card { box-shadow: none !important; border: 1px solid #e2e8f0 !important; }
        }
    </style>
</head>
<body class="p-4 md:p-10 flex flex-col items-center">

    <div class="no-print w-full max-w-4xl flex justify-between items-center mb-6">
        <a href="javascript:history.back()" class="text-sm font-bold text-gray-500 hover:text-gray-900 flex items-center gap-2">
            ← Back to Portal
        </a>
        <button onclick="window.print()" class="px-6 py-2 bg-blue-600 text-white font-bold rounded-xl shadow-lg hover:bg-blue-700 transition-all flex items-center gap-2">
            Download / Print Invoice
        </button>
    </div>

    <div class="invoice-card bg-white w-full max-w-4xl rounded-[2rem] shadow-2xl overflow-hidden border border-gray-100">
        <!-- Header Section -->
        <div class="bg-slate-900 p-8 md:p-12 text-white flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
            <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl overflow-hidden shadow-lg flex-shrink-0">
                    <img src="/images/medlink-logo.png" alt="MedLink Logo" class="w-full h-full object-cover">
                </div>
                <div>
                    <h1 class="text-3xl font-semibold tracking-tighter">MedLink<span class="text-blue-500">Portal</span></h1>
                    <p class="text-slate-400 text-sm font-medium">Global Healthcare Excellence</p>
                </div>
            </div>
            <div class="text-right">
                <h2 class="text-4xl font-semibold tracking-tight mb-1">INVOICE</h2>
                <p class="text-slate-400 font-bold uppercase tracking-widest text-xs">#@invoiceNo</p>
            </div>
        </div>

        <div class="p-8 md:p-12 space-y-12">
            <!-- Billing Details -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                <div>
                    <h4 class="text-[11px] font-semibold text-gray-400 uppercase tracking-widest mb-4">Patient Information</h4>
                    <div class="space-y-1">
                        <p class="text-xl font-semibold text-gray-900">@Model.PatientName</p>
                        <p class="text-gray-500 font-medium">@Model.PatientEmail</p>
                        <p class="text-gray-500 font-medium">@Model.Phone</p>
                    </div>
                </div>
                <div class="md:text-right">
                    <h4 class="text-[11px] font-semibold text-gray-400 uppercase tracking-widest mb-4">Invoice Information</h4>
                    <div class="space-y-1">
                        <p class="text-sm font-bold text-gray-900">Date: <span class="font-medium text-gray-500">@appointment.AppointmentDate.ToString("MMMM dd, yyyy")</span></p>
                        <p class="text-sm font-bold text-gray-900">Status: <span class="px-2 py-0.5 bg-emerald-100 text-emerald-700 rounded text-[10px] uppercase">Paid</span></p>
                        <p class="text-sm font-bold text-gray-900">Method: <span class="font-medium text-gray-500">Stripe Secure Checkout</span></p>
                    </div>
                </div>
            </div>

            <!-- Doctor Information & Service -->
            <div class="pt-8 border-t border-gray-100">
                <h4 class="text-[11px] font-semibold text-gray-400 uppercase tracking-widest mb-6 px-1">Service Details</h4>
                <div class="bg-gray-50/50 rounded-3xl p-6 border border-gray-100 flex flex-col md:flex-row items-center gap-8">
                    <div class="w-32 h-32 rounded-2xl overflow-hidden shadow-xl border-4 border-white flex-shrink-0">
                        <img src="@appointment.Doctor?.Image" class="w-full h-full object-cover" alt="Doctor Image">
                    </div>
                    <div class="flex-1 text-center md:text-left">
                        <h5 class="text-2xl font-semibold text-gray-900 mb-1">@appointment.Doctor?.Name</h5>
                        <p class="text-blue-600 font-bold text-sm mb-4">@appointment.Doctor?.Specialty</p>
                        <div class="flex flex-wrap gap-4 justify-center md:justify-start">
                            <div class="text-[11px] bg-white px-3 py-1.5 rounded-xl border border-gray-100 shadow-sm font-bold text-gray-500">
                                <span class="text-gray-400 uppercase">Qualification:</span> @appointment.Doctor?.Qualification
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary Table -->
            <div class="pt-8 overflow-x-auto">
                <table class="w-full text-left">
                    <thead>
                        <tr class="border-b border-gray-100">
                            <th class="py-4 text-[11px] font-semibold text-gray-400 uppercase tracking-widest">Description</th>
                            <th class="py-4 text-[11px] font-semibold text-gray-400 uppercase tracking-widest text-center">Date & Time</th>
                            <th class="py-4 text-[11px] font-semibold text-gray-400 uppercase tracking-widest text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        <tr>
                            <td class="py-6">
                                <p class="font-semibold text-gray-900">Medical Consultation</p>
                                <p class="text-xs text-gray-500 font-medium">Type: @appointment.ConsultationType</p>
                            </td>
                            <td class="py-6 text-center">
                                <p class="text-sm font-bold text-gray-900">@appointment.AppointmentDate.ToString("MMM dd")</p>
                                <p class="text-[11px] text-gray-500 font-bold uppercase">@appointment.TimeSlot</p>
                            </td>
                            <td class="py-6 text-right">
                                <p class="text-lg font-semibold text-gray-900">PKR @Model.AmountPaid.ToString("N2")</p>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr class="border-t-2 border-gray-900">
                            <td colspan="2" class="py-6 text-right font-semibold text-gray-400 uppercase tracking-widest">Total Amount Paid</td>
                            <td class="py-6 text-right">
                                <p class="text-3xl font-semibold text-blue-600">PKR @Model.AmountPaid.ToString("N2")</p>
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Footer Message -->
            <div class="pt-12 text-center space-y-4">
                <div class="flex justify-center gap-2">
                    <span class="w-1.5 h-1.5 bg-gray-200 rounded-full"></span>
                    <span class="w-1.5 h-1.5 bg-gray-200 rounded-full"></span>
                    <span class="w-1.5 h-1.5 bg-gray-200 rounded-full"></span>
                </div>
                <p class="text-xs text-gray-400 font-medium max-w-sm mx-auto leading-relaxed">
                    This is a digitally generated invoice and does not require a physical signature. Thank you for choosing MedLink.
                </p>
                <div class="flex items-center justify-center gap-2 text-[10px] font-semibold text-gray-300 uppercase tracking-widest">
                    <span>www.medlink.health</span>
                    <span class="text-gray-100">|</span>
                    <span>support@@medlink.health</span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="mt-10 mb-20 text-center no-print text-gray-400 text-xs font-medium">
        &copy; 2026 MedLink Portal. All rights reserved.
    </div>

    <script>
        // Optional: Auto open print on load if specifically requested via URL param
        if (new URLSearchParams(window.location.search).has('print')) {
            window.print();
        }
    </script>
</body>
</html>
