<div class="p-6 flex flex-col h-full">
    <!-- Brand -->
    <div class="flex items-center gap-3 mb-10 px-2">
        <div class="w-11 h-11 rounded-2xl overflow-hidden shadow-xl shadow-indigo-500/20 flex-shrink-0">
            <img src="/images/medlink-logo.png" alt="MedLink Logo" class="w-10 h-10 rounded-2xl object-cover shadow-lg">
        </div>
        <div>
            <h1 class="text-xl font-semibold text-slate-900 tracking-tight leading-none">MedLink</h1>
            <span class="text-[9px] font-semibold text-indigo-600 uppercase tracking-[0.2em] mt-1 block">Diagnostics</span>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="space-y-1.5 flex-1">
        <p class="px-4 text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-4">Main Menu</p>
        
        <a href="@Url.Action("Index", "Dashboard", new { area = "Lab" })" 
           class="flex items-center gap-3 px-4 py-4 rounded-2xl transition-all duration-300 group @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "bg-indigo-600 text-white shadow-lg shadow-indigo-500/20" : "text-slate-500 hover:bg-slate-50 hover:text-indigo-600")">
            <i data-lucide="layout-grid" class="w-5 h-5"></i>
            <span class="text-[13px] font-bold">Dashboard</span>
        </a>

        <a href="@Url.Action("Bookings", "Dashboard", new { area = "Lab" })" 
           class="flex items-center gap-3 px-4 py-4 rounded-2xl transition-all duration-300 group @(ViewContext.RouteData.Values["action"]?.ToString() == "Bookings" ? "bg-indigo-600 text-white shadow-lg shadow-indigo-500/20" : "text-slate-500 hover:bg-slate-50 hover:text-indigo-600")">
            <i data-lucide="calendar-check" class="w-5 h-5"></i>
            <span class="text-[13px] font-bold">Manage Bookings</span>
        </a>

        <a href="@Url.Action("Tests", "Dashboard", new { area = "Lab" })" 
           class="flex items-center gap-3 px-4 py-4 rounded-2xl transition-all duration-300 group @(ViewContext.RouteData.Values["action"]?.ToString() == "Tests" ? "bg-indigo-600 text-white shadow-lg shadow-indigo-500/20" : "text-slate-500 hover:bg-slate-50 hover:text-indigo-600")">
            <i data-lucide="test-tube-2" class="w-5 h-5"></i>
            <span class="text-[13px] font-bold">Diagnostics Catalog</span>
        </a>

        <div class="pt-8 pb-4">
            <p class="px-4 text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-4">Reports & Stats</p>
        </div>

        <a href="#" class="flex items-center gap-3 px-4 py-4 rounded-2xl text-slate-500 hover:bg-slate-50 hover:text-indigo-600 transition-all duration-300 group">
            <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
            <span class="text-[13px] font-bold">Performance</span>
        </a>

        <a href="@Url.Action("Profile", "Dashboard", new { area = "Lab" })" 
           class="flex items-center gap-3 px-4 py-4 rounded-2xl transition-all duration-300 group @(ViewContext.RouteData.Values["action"]?.ToString() == "Profile" ? "bg-indigo-600 text-white shadow-lg shadow-indigo-500/20" : "text-slate-500 hover:bg-slate-50 hover:text-indigo-600")">
            <i data-lucide="settings" class="w-5 h-5"></i>
            <span class="text-[13px] font-bold">Lab Settings</span>
        </a>
    </nav>

    <!-- Support/Profile -->
    <div class="mt-auto pt-6 border-t border-slate-100">
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit" class="w-full flex items-center gap-3 px-4 py-4 rounded-2xl text-rose-500 hover:bg-rose-50 transition-all duration-300 group">
                <i data-lucide="log-out" class="w-5 h-5 group-hover:translate-x-1 transition-transform"></i>
                <span class="text-[13px] font-bold">Logout System</span>
            </button>
        </form>
    </div>
</div>
