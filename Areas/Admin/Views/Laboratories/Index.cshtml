@using MedLinkPortal.Models
@model IEnumerable<MedLinkPortal.Areas.Admin.Controllers.LabCompanyViewModel>
@{
    ViewData["Title"] = "Laboratories Management";
}

<div class="skeleton-container space-y-12 pb-20">
    <div class="flex flex-col flex-md-row md:items-center justify-between gap-10 py-6">
        <div class="w-full max-w-xl">
            <div class="skeleton skeleton-title w-full h-16 md:h-24"></div>
            <div class="skeleton skeleton-text w-3/4 h-6"></div>
        </div>
        <div class="skeleton w-48 h-16 rounded-[24px]"></div>
    </div>
    <div class="skeleton-card p-5 md:p-12">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 mb-12">
            <div class="skeleton w-full max-w-2xl h-16 rounded-[28px]"></div>
            <div class="skeleton w-40 h-14 rounded-[20px]"></div>
        </div>
        <div class="space-y-4">
            @for(int i=0; i<5; i++) {
                <div class="flex items-center gap-6 p-6 border-b border-slate-50">
                    <div class="skeleton w-16 h-16 rounded-[24px]"></div>
                    <div class="flex-1 space-y-2">
                        <div class="skeleton skeleton-text w-48 h-6"></div>
                        <div class="skeleton skeleton-text w-32"></div>
                    </div>
                    <div class="skeleton w-24 h-8 rounded-full"></div>
                    <div class="skeleton w-32 h-10"></div>
                </div>
            }
        </div>
    </div>
</div>

<div class="main-content-actual content-hidden space-y-12 pb-20">
    <div class="flex flex-col flex-md-row md:items-center justify-between gap-10 py-6">
        <div class="animate-in fade-in slide-in-from-left-8 duration-1000">
            <h1 class="text-6xl md:text-7xl font-semibold text-slate-900 tracking-tighter mb-4">
                Lab <span class="text-blue-600">Companies</span>
            </h1>
            <p class="text-slate-500 text-xl font-medium leading-relaxed max-w-2xl">
                Manage registered laboratory diagnostic centers and their administrative access.
            </p>
        </div>
        <button id="btnOpenRegisterModal" class="flex items-center gap-3 px-10 py-5 bg-[#0F172A] text-white rounded-[24px] text-sm font-semibold hover:bg-black transition-all shadow-xl active:scale-95 group">
            <i class="fas fa-plus group-hover:rotate-90 transition-transform"></i> Register Laboratory
        </button>
    </div>

    <div class="bento-card p-5 md:p-12">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8 mb-12">
            <div class="relative flex-grow max-w-2xl">
                <i class="fas fa-search absolute left-6 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="text" id="labSearch" placeholder="Search laboratories by name, city or email..." 
                       class="w-full pl-14 pr-8 py-5 bg-slate-50 border-slate-100 rounded-[28px] text-base focus:outline-none focus:ring-4 focus:ring-blue-500/10 transition-all font-medium placeholder:text-slate-400 border" />
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="text-slate-400 text-[10px] font-semibold uppercase tracking-[0.3em]">
                        <th class="px-6 py-8 border-b border-slate-50 text-left">Laboratory Identity</th>
                        <th class="px-6 py-8 border-b border-slate-50 text-left">Location</th>
                        <th class="px-6 py-8 border-b border-slate-50 text-left">Admin Access</th>
                        <th class="px-6 py-8 border-b border-slate-50 text-left">Statistics</th>
                        <th class="px-6 py-8 border-b border-slate-50 text-right">Settings</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @foreach (var lab in Model) {
                        <tr class="group hover:bg-slate-50/80 transition-all duration-500 lab-row">
                            <td class="px-6 py-10">
                                <div class="flex items-center gap-6">
                                    <div class="w-16 h-16 rounded-[24px] bg-blue-600 border-4 border-white shadow-xl flex items-center justify-center text-white group-hover:scale-110 transition-transform duration-700">
                                        <i class="fas fa-flask text-2xl"></i>
                                    </div>
                                    <div>
                                        <p class="text-lg font-semibold text-slate-900 group-hover:text-blue-600 transition-colors lab-name">@lab.Name</p>
                                        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-1">ID: #LAB-@lab.Id</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-10">
                                <div class="flex flex-col gap-1">
                                    <span class="text-sm font-semibold text-slate-700 lab-city">@lab.CityName</span>
                                    <span class="text-[10px] text-slate-400 font-medium">@lab.Address</span>
                                </div>
                            </td>
                            <td class="px-6 py-10">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400">
                                        <i class="fas fa-user-shield"></i>
                                    </div>
                                    <span class="text-sm font-semibold text-slate-700 lab-admin">@lab.AdminEmail</span>
                                </div>
                            </td>
                            <td class="px-6 py-10">
                                <span class="inline-flex items-center px-4 py-2 bg-blue-500/10 text-blue-600 rounded-full text-[10px] font-semibold uppercase tracking-[0.15em] border border-blue-500/20">
                                    @lab.TestCount Active Tests
                                </span>
                            </td>
                            <td class="px-6 py-10 text-right">
                                <div class="flex items-center justify-end gap-3 opacity-0 group-hover:opacity-100 transition-all duration-500 translate-x-4 group-hover:translate-x-0">
                                    <button class="w-12 h-12 flex items-center justify-center bg-white border border-slate-100 text-slate-400 hover:text-red-500 hover:shadow-xl hover:scale-110 rounded-2xl transition-all btn-delete" data-id="@lab.Id">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="registerModal" class="fixed inset-0 hidden items-center justify-center modal-overlay p-4 z-[100]">
    <div class="modal-content w-full max-w-md max-h-[90vh] overflow-hidden relative flex flex-col bg-white rounded-3xl shadow-2xl">
        <div class="p-6 md:p-8 pb-4 flex justify-between items-start flex-shrink-0 border-b border-slate-50">
            <div>
                <h3 class="text-2xl font-semibold text-slate-900 tracking-tight">Register <span class="text-blue-600">Laboratory</span></h3>
                <p class="text-slate-500 text-xs font-medium mt-1">Create a new laboratory profile and admin account.</p>
            </div>
            <button id="btnCloseModal" class="w-10 h-10 flex items-center justify-center rounded-xl bg-slate-50 text-slate-400 hover:text-slate-900 transition-all">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <form id="labRegistrationForm" class="p-6 md:p-8 space-y-6 overflow-y-auto flex-1">
            <div class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-1">
                        <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest px-1">Lab Identity</label>
                        <input type="text" name="Name" required placeholder="Ex: Chughtai Lab" 
                               class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-bold text-slate-900 transition-all text-sm" />
                    </div>
                    <div class="space-y-1">
                        <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest px-1">Location / City</label>
                        <select name="CityId" required class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-bold text-slate-900 text-sm">
                            <option value="">Select City</option>
                            @foreach (var city in ViewBag.Cities as List<City>)
                            {
                                <option value="@city.Id">@city.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="space-y-1">
                    <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest px-1">Physical Address</label>
                    <input type="text" name="Address" required placeholder="Complete street address..." 
                           class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-bold text-slate-900 text-sm" />
                </div>

                <div class="space-y-1">
                    <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest px-1">Contact Phone</label>
                    <input type="text" name="PhoneNumber" required placeholder="+92 300 0000000" 
                           class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-bold text-slate-900 text-sm" />
                </div>

                <div class="pt-4 border-t border-slate-50">
                    <p class="text-[10px] font-semibold text-blue-600 uppercase tracking-[0.2em] mb-4">Admin Security Credentials</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-1">
                            <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest px-1">Admin Email</label>
                            <input type="email" name="AdminEmail" required placeholder="admin@lab.com" 
                                   class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-bold text-slate-900 text-sm" />
                        </div>
                        <div class="space-y-1">
                            <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest px-1">Set Password</label>
                            <input type="password" name="AdminPassword" required placeholder="••••••••" 
                                   class="w-full px-4 py-3 bg-slate-50 border border-slate-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500/20 font-bold text-slate-900 text-sm" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="pt-6 flex-shrink-0">
                <button type="submit" class="w-full py-4 bg-[#0F172A] text-white rounded-2xl text-sm font-semibold uppercase tracking-widest hover:bg-black transition-all shadow-xl active:scale-95">
                    Authorize & Register Laboratory
                </button>
            </div>
        </form>
    </div>
</div>

<div id="deleteModal" class="fixed inset-0 hidden items-center justify-center modal-overlay p-4 z-[100]">
    <div class="modal-content w-full max-w-sm overflow-hidden relative p-8 md:p-10 text-center bg-white rounded-3xl">
        <div class="w-20 h-20 bg-red-50 text-red-500 rounded-3xl flex items-center justify-center mx-auto mb-6">
            <i class="fas fa-trash-alt text-3xl"></i>
        </div>
        <h3 class="text-2xl font-semibold text-slate-900 tracking-tight mb-2">Remove Laboratory?</h3>
        <p class="text-slate-500 font-medium mb-8">This will de-register the laboratory and all associated tests from the platform.</p>
        <div class="flex gap-4">
            <button id="btnCancelDelete" class="flex-1 py-4 bg-slate-50 text-slate-500 rounded-xl text-xs font-semibold uppercase tracking-widest hover:bg-slate-100 transition-all">Cancel</button>
            <button id="btnConfirmDelete" class="flex-1 py-4 bg-red-500 text-white rounded-xl text-xs font-semibold uppercase tracking-widest hover:bg-red-600 transition-all shadow-lg active:scale-95">Confirm</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            const $body = $('body');
            let deleteId = null;

            // Search Logic
            $('#labSearch').on('input', function() {
                const search = $(this).val().toLowerCase();
                $('.lab-row').each(function() {
                    const name = $(this).find('.lab-name').text().toLowerCase();
                    const city = $(this).find('.lab-city').text().toLowerCase();
                    const admin = $(this).find('.lab-admin').text().toLowerCase();
                    if (name.includes(search) || city.includes(search) || admin.includes(search)) {
                        $(this).show();
                    } else {
                        $(this).hide();
                    }
                });
            });

            // Modal Toggles
            function toggleModal($modal, show) {
                if (show) {
                    $modal.removeClass('hidden').addClass('flex animate-in fade-in duration-300');
                    $body.addClass('overflow-hidden');
                } else {
                    $modal.removeClass('flex').addClass('hidden');
                    $body.removeClass('overflow-hidden');
                }
            }

            $('#btnOpenRegisterModal').on('click', () => toggleModal($('#registerModal'), true));
            $('#btnCloseModal').on('click', () => toggleModal($('#registerModal'), false));

            // Create Handler
            $('#labRegistrationForm').on('submit', function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                const data = Object.fromEntries(formData.entries());
                data.CityId = parseInt(data.CityId);

                const $btn = $(this).find('button[type="submit"]');
                $btn.text('Processing Access...').prop('disabled', true);

                $.ajax({
                    url: '/Admin/Laboratories/Create',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function() {
                        location.reload();
                    },
                    error: function(xhr) {
                        alert(xhr.responseJSON?.message || 'Error registering laboratory');
                        $btn.text('Authorize & Register Laboratory').prop('disabled', false);
                    }
                });
            });

            // Delete Logic
            $('.btn-delete').on('click', function() {
                deleteId = $(this).data('id');
                toggleModal($('#deleteModal'), true);
            });

            $('#btnCancelDelete').on('click', () => toggleModal($('#deleteModal'), false));

            $('#btnConfirmDelete').on('click', function() {
                $.ajax({
                    url: `/Admin/Laboratories/Delete?id=${deleteId}`,
                    type: 'DELETE',
                    success: function() {
                        location.reload();
                    },
                    error: function() {
                        alert('Error deleting laboratory');
                    }
                });
            });
        });
    </script>
}
