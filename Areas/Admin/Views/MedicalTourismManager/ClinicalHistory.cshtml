@model MedLinkPortal.Models.ClinicalHistoryViewModel

@{
    ViewData["Title"] = "Clinical History - " + Model.PatientName;
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Lucide Icons Script -->
<script src="https://unpkg.com/lucide@latest"></script>

<div class="p-8 max-w-7xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-700">
    <!-- Header -->
    <div class="mb-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-center gap-5">
            <div class="w-14 h-14 rounded-[20px] bg-slate-900 flex items-center justify-center text-white shadow-xl shadow-slate-200">
                <i data-lucide="history" class="w-7 h-7"></i>
            </div>
            <div>
                <h1 class="text-3xl font-semibold text-slate-900 tracking-tight">Clinical Dossier</h1>
                <p class="text-slate-500 font-medium flex items-center gap-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                    Patient ID: @Model.PatientId
                </p>
            </div>
        </div>
        <button onclick="window.open('@Url.Action("ExportDossier", new { userId = Model.PatientId })', '_blank')" class="px-6 py-3 rounded-2xl bg-white border border-slate-200 text-slate-900 hover:bg-slate-50 transition-all font-bold flex items-center gap-3 shadow-sm group">
            <i data-lucide="printer" class="w-5 h-5 text-slate-400 group-hover:text-slate-900 transition-colors"></i>
            <span>Export Record</span>
        </button>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Timeline / Health Records -->
        <div class="lg:col-span-2 space-y-8">
            
            <!-- Health Records Bento Card -->
            <div class="bg-white rounded-[32px] p-8 md:p-10 shadow-[0_30px_60px_rgba(0,0,0,0.04)] border border-slate-100 relative overflow-hidden">
                <div class="absolute top-0 right-0 p-10 opacity-[0.03] pointer-events-none">
                    <i data-lucide="test-tube-2" class="w-48 h-48 text-slate-900"></i>
                </div>
                
                <div class="flex items-center justify-between mb-10 relative">
                    <h3 class="text-[11px] uppercase tracking-[0.25em] font-semibold text-slate-400">Diagnostic History & Reports</h3>
                    <span class="px-3 py-1 bg-slate-100 text-slate-500 rounded-lg text-[10px] font-semibold uppercase tracking-wider">@Model.HealthRecords.Count entries</span>
                </div>

                <div class="space-y-4">
                    @if (Model.HealthRecords != null && Model.HealthRecords.Any())
                    {
                        @foreach (var record in Model.HealthRecords)
                        {
                            <div class="flex items-center gap-6 p-6 rounded-3xl border border-slate-50 hover:border-blue-100 hover:bg-blue-50/30 transition-all group">
                                <div class="w-14 h-14 rounded-2xl bg-white border border-slate-100 flex items-center justify-center text-slate-400 group-hover:text-blue-500 group-hover:border-blue-200 transition-all shadow-sm">
                                    <i data-lucide="@(record.Category == "Laboratory" ? "beaker" : record.Category == "Radiology" ? "scan" : "file-text")" class="w-6 h-6"></i>
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2 mb-1">
                                        <p class="font-semibold text-slate-900 truncate">@record.Name</p>
                                        <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 text-[9px] font-bold uppercase tracking-tighter">@record.Type</span>
                                    </div>
                                    <p class="text-xs text-slate-500 font-medium flex items-center gap-3">
                                        <span class="flex items-center gap-1.5"><i data-lucide="calendar" class="w-3 h-3 text-slate-300"></i> @record.Date.ToString("MMM dd, yyyy")</span>
                                        <span class="w-1 h-1 rounded-full bg-slate-200"></span>
                                        <span class="flex items-center gap-1.5"><i data-lucide="hospital" class="w-3 h-3 text-slate-300"></i> @record.Provider</span>
                                    </p>
                                </div>
                                @if (!string.IsNullOrEmpty(record.FilePath))
                                {
                                    <a href="@record.FilePath" target="_blank" class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center hover:bg-blue-600 transition-all shadow-lg shadow-black/5 opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0">
                                        <i data-lucide="external-link" class="w-4 h-4"></i>
                                    </a>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="py-16 text-center bg-slate-50 rounded-3xl border border-dashed border-slate-200">
                            <i data-lucide="folder-search" class="w-12 h-12 text-slate-200 mx-auto mb-4"></i>
                            <p class="text-slate-400 font-bold uppercase tracking-widest text-xs">No clinical records found</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Precriptions Bento Card -->
            <div class="bg-white rounded-[32px] p-8 md:p-10 shadow-[0_30px_60px_rgba(0,0,0,0.04)] border border-slate-100">
                <div class="flex items-center justify-between mb-10">
                    <h3 class="text-[11px] uppercase tracking-[0.25em] font-semibold text-slate-400">Medication & Prescriptions</h3>
                    <span class="px-3 py-1 bg-amber-50 text-amber-600 rounded-lg text-[10px] font-semibold uppercase tracking-wider">Verified Clinical Data</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    @if (Model.Prescriptions != null && Model.Prescriptions.Any())
                    {
                        @foreach (var prescription in Model.Prescriptions)
                        {
                            <div class="p-6 rounded-3xl bg-slate-50 border border-slate-100 hover:bg-white hover:shadow-xl hover:shadow-slate-200/50 transition-all group flex flex-col h-full relative">
                                <a href="@Url.Action("PrescriptionDetails", new { id = prescription.Id })" class="absolute inset-0 z-10"></a>
                                <div class="flex items-center gap-4 mb-4">
                                    <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center text-amber-500 shadow-sm">
                                        <i data-lucide="pill" class="w-5 h-5"></i>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Diagnosis</p>
                                        <p class="font-semibold text-slate-900 text-sm truncate">@prescription.Diagnosis</p>
                                    </div>
                                </div>
                                <div class="bg-white/50 rounded-2xl p-4 mb-4 flex-1">
                                    <p class="text-[8px] font-semibold text-slate-400 uppercase tracking-[0.1em] mb-2">Medications Preview</p>
                                    <div class="text-[11px] font-bold text-slate-700 leading-relaxed italic line-clamp-2">
                                        @if (prescription.PrescriptionMedicines != null && prescription.PrescriptionMedicines.Any())
                                        {
                                            <span>@string.Join(", ", prescription.PrescriptionMedicines.Select(pm => pm.Medicine?.Name).Where(name => name != null).Take(3))</span>
                                            if (prescription.PrescriptionMedicines.Count > 3)
                                            {
                                                <span class="text-[9px] text-slate-400 not-italic"> +@(prescription.PrescriptionMedicines.Count - 3) more</span>
                                            }
                                        }
                                        else if (prescription.MedicationsJson.StartsWith("["))
                                        {
                                            <span>Multiple medications prescribed</span>
                                        }
                                        else
                                        {
                                            @(prescription.MedicationsJson == "Structured" ? "Detailed prescription record" : prescription.MedicationsJson)
                                        }
                                    </div>
                                </div>
                                <div class="flex items-center justify-between mt-auto pt-4 border-t border-slate-100 text-[10px] font-semibold text-slate-400 uppercase tracking-widest relative z-20">
                                    <span class="flex items-center gap-2"><i data-lucide="calendar" class="w-3 h-3"></i> @prescription.CreatedAt.ToString("MMM yyyy")</span>
                                    <span class="text-blue-500 group-hover:translate-x-1 transition-transform flex items-center gap-1">Full Card <i data-lucide="chevron-right" class="w-3 h-3"></i></span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-span-2 py-12 text-center">
                            <p class="text-slate-400 font-bold uppercase tracking-widest text-[10px]">No active prescriptions</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar / Previous Requests -->
        <div class="space-y-8">
            
            <!-- Case History Bento Card -->
            <div class="bg-slate-900 rounded-[32px] p-8 text-white shadow-2xl shadow-slate-900/20">
                <h3 class="text-[10px] uppercase tracking-[0.2em] font-semibold text-white/30 mb-8">Tourism Journey Logs</h3>
                
                <div class="space-y-6">
                    @if (Model.PreviousRequests != null && Model.PreviousRequests.Any())
                    {
                        @foreach (var request in Model.PreviousRequests)
                        {
                            <div class="relative pl-8 pb-8 border-l border-white/10 last:pb-0">
                                <div class="absolute left-[-5px] top-0 w-2.5 h-2.5 rounded-full bg-blue-500 shadow-[0_0_15px_rgba(59,130,246,0.6)]"></div>
                                <div class="flex flex-col">
                                    <span class="text-[10px] font-semibold text-white/40 uppercase tracking-widest mb-1">@request.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    <p class="font-semibold text-sm mb-1">@request.TreatmentType</p>
                                    <div class="flex items-center gap-2">
                                        <span class="px-2 py-0.5 rounded-md bg-white/10 text-white/60 text-[8px] font-semibold uppercase tracking-wider">@request.RequestType</span>
                                        <span class="text-[10px] font-bold text-blue-400">@request.Status</span>
                                    </div>
                                </div>
                                @if (request.AssignedPackage != null)
                                {
                                    <div class="mt-4 p-4 rounded-2xl bg-white/5 border border-white/10 text-[10px] font-medium text-white/70">
                                        <div class="flex items-center gap-2 mb-2">
                                            <i data-lucide="hospital" class="w-3 h-3 text-white/30"></i>
                                            @request.AssignedPackage.Hospital?.Name
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <i data-lucide="tag" class="w-3 h-3 text-white/30"></i>
                                            PKR @request.AssignedPackage.TotalPrice.ToString("N0")
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-white/20 text-xs font-bold uppercase tracking-widest text-center py-8">Initial Consultation</p>
                    }
                </div>
            </div>

            <!-- Clinical Consent Summary -->
             <div class="p-8 bg-blue-50 rounded-[32px] border border-blue-100">
                <div class="flex items-center gap-4 mb-6">
                    <div class="w-12 h-12 bg-white rounded-2xl flex items-center justify-center text-blue-500 shadow-sm">
                        <i data-lucide="shield-check" class="w-6 h-6"></i>
                    </div>
                    <div>
                        <p class="text-[10px] font-semibold text-blue-500 uppercase tracking-widest">Compliance Status</p>
                        <p class="font-semibold text-slate-900">GDPR / HIPAA Ready</p>
                    </div>
                </div>
                <p class="text-xs text-slate-500 leading-relaxed font-medium">
                    This dossier contains sensitive medical information. Ensure compliance with data protection policies before sharing outside the secure portal.
                </p>
            </div>
        </div>
    </div>
</div>

<script>
    lucide.createIcons();
</script>
