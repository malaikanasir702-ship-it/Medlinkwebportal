@using Microsoft.AspNetCore.Identity
@using MedLinkPortal.Areas.Identity.Pages.Account
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedLink Lab Portal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        * { font-family: 'Outfit', sans-serif; }
        .bg-lab-gradient { background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); }
        .text-lab-primary { color: #6366f1; }
        .border-lab-soft { border-color: #f1f5f9; }
        .custom-scrollbar::-webkit-scrollbar { width: 5px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
    </style>
</head>
<body class="bg-[#FBFBFE] min-h-screen">
    <div class="flex">
        <!-- Desktop Sidebar -->
        <aside class="hidden lg:flex w-72 h-screen sticky top-0 bg-white border-r border-slate-100 flex-col z-50">
            <partial name="_LabSidebar" />
        </aside>

        <!-- Main Content -->
        <main class="flex-1 min-h-screen flex flex-col relative">
            <!-- Glass Header -->
            <header class="h-20 bg-white/70 backdrop-blur-md border-b border-slate-100 flex items-center justify-between px-8 sticky top-0 z-40">
                <div class="flex items-center gap-4">
                    <button class="lg:hidden w-10 h-10 bg-slate-50 rounded-xl flex items-center justify-center text-slate-400">
                        <i data-lucide="menu"></i>
                    </button>
                    <div>
                        <h2 class="font-semibold text-slate-900 tracking-tight text-xl">@ViewData["Title"]</h2>
                        <div class="flex items-center gap-2">
                             <span class="w-1.5 h-1.5 bg-indigo-500 rounded-full animate-pulse"></span>
                             <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest">Lab Management Active</span>
                        </div>
                    </div>
                </div>
                
                <div class="flex items-center gap-6">
                    <a href="@Url.Action("Profile", "Dashboard", new { area = "Lab" })" class="flex items-center gap-4 pl-6 border-l border-slate-100 group cursor-pointer no-underline">
                         <div class="text-right hidden sm:block">
                            <p class="text-xs font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors">@user?.FirstName @user?.LastName</p>
                            <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest">Laboratory Admin</p>
                         </div>
                         <div class="w-11 h-11 bg-indigo-600 rounded-2xl flex items-center justify-center text-white shadow-lg shadow-indigo-500/20 group-hover:scale-105 transition-transform">
                            <i data-lucide="user" class="w-5 h-5"></i>
                         </div>
                    </a>
                </div>
            </header>

            <div class="flex-1 p-8">
                @RenderBody()
            </div>
        </main>
    </div>

    <script>
        lucide.createIcons();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
