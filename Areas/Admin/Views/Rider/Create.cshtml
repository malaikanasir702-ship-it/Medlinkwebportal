@using MedLinkPortal.Models
@model CreateRiderViewModel
@{
    ViewData["Title"] = "Create Rider";
    Layout = "_Layout";
}

<div class="min-h-screen bg-slate-50 pb-20">
    <div class="max-w-xl mx-auto px-4 py-10">
        <div class="mb-8">
            <a href="/Admin/Rider" class="text-xs font-bold text-slate-400 hover:text-slate-700">← Back to Riders</a>
            <h1 class="text-2xl font-black text-slate-900 mt-2">Create New Rider</h1>
        </div>

        <div class="bg-white rounded-3xl shadow-xl border border-slate-100 p-8">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-rose-600 font-medium"></div>

                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5">First Name</label>
                        <input asp-for="FirstName" type="text" required
                               class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm font-medium focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all" />
                        <span asp-validation-for="FirstName" class="text-xs text-rose-500"></span>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5">Last Name</label>
                        <input asp-for="LastName" type="text" required
                               class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm font-medium focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5">Phone Number</label>
                    <input asp-for="Phone" type="tel" placeholder="+923001234567" required
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm font-medium focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all" />
                    <span asp-validation-for="Phone" class="text-xs text-rose-500"></span>
                </div>

                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5">Vehicle Type</label>
                        <select asp-for="VehicleType"
                                class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm font-medium focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all">
                            <option value="Motorcycle">🏍️ Motorcycle</option>
                            <option value="Bicycle">🚲 Bicycle</option>
                            <option value="Van">🚐 Van</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5">Vehicle Number</label>
                        <input asp-for="VehicleNumber" type="text" placeholder="ABC-1234"
                               class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm font-medium focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all" />
                    </div>
                </div>

                <div class="mb-6">
                    <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5">Initial Password</label>
                    <input asp-for="Password" type="password" required
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-sm font-medium focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all" />
                    <span asp-validation-for="Password" class="text-xs text-rose-500"></span>
                </div>

                <button type="submit"
                        class="w-full py-4 bg-blue-600 text-white font-black text-sm rounded-2xl hover:bg-blue-700 shadow-xl shadow-blue-600/20 transition-all active:scale-95">
                    Create Rider Account
                </button>
            </form>
        </div>
    </div>
</div>
