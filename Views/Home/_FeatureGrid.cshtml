<section id="features" class="py-32 px-6 bg-white relative">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-20 fade-up" data-animate>
            <h2 class="text-sm font-bold text-blue-600 uppercase tracking-[0.2em] mb-4">Core Capabilities</h2>
            <h3 class="text-4xl md:text-5xl font-bold text-gray-900 tracking-tight">Everything you need in <br /> one powerful platform.</h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 stagger-children" data-animate>
            @{
                var features = new[]
                {
                        new { Icon = "calendar", Title = "Smart Scheduling", Color = "blue",
                        Desc = "Browse specialists by availability, ratings, and language. Auto-sync with your calendar." },
                        new { Icon = "user-round", Title = "Expert Profiles", Color = "indigo",
                        Desc = "Detailed qualifications, specialty filtering, and verified patient reviews." },
                        new { Icon = "database", Title = "Health Records", Color = "teal",
                        Desc = "Secure, cloud-based storage for history, scans, and lab results. Consent-based sharing." },
                        new { Icon = "video", Title = "Video Consultation", Color = "blue",
                        Desc = "Integrated secure HD calls with screen-sharing for diagnosis walkthroughs." },
                        new { Icon = "file-text", Title = "Digital Prescriptions", Color = "emerald",
                        Desc = "Direct-to-patient scripts with automated refill reminders and follow-up tracking." },
                        new { Icon = "message-square", Title = "Secure Messaging", Color = "violet",
                        Desc = "Encrypted text consultation for asynchronous questions and timely doctor responses." },
                        new { Icon = "bell", Title = "Health Reminders", Color = "orange",
                        Desc = "Automatic alerts for consultations, medication refills, and screening schedules." },
                        new { Icon = "layout-dashboard", Title = "Provider Dashboard", Color = "gray",
                        Desc = "Comprehensive tools for doctors to manage patient progress and review diagnostics." },
                        new { Icon = "credit-card", Title = "Insurance & Billing", Color = "cyan",
                        Desc = "Secure invoice generation and insurance integration for hassle-free reimbursement." }
                        };
            }

            @foreach (var feature in features)
            {
                <div class="group p-10 rounded-[2.5rem] border border-gray-100 bg-white hover:bg-gray-50 transition-all duration-500 hover:shadow-2xl hover:shadow-blue-500/5 fade-up" data-animate>
                    <div class="@($"w-14 h-14 rounded-2xl flex items-center justify-center mb-8 transition-transform group-hover:scale-110 shadow-lg bg-{feature.Color}-600 text-white")">
                        <i data-lucide="@feature.Icon" class="w-7 h-7"></i>
                    </div>
                    <h4 class="text-2xl font-bold text-gray-900 mb-4">@feature.Title</h4>
                    <p class="text-gray-600 leading-relaxed text-base">@feature.Desc</p>
                    <a href="@Url.Action("LearnMore", "Home")" class="mt-8 flex items-center gap-2 text-blue-600 font-bold text-sm opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer">
                        Learn more <i data-lucide="arrow-up-right" class="w-4 h-4"></i>
                    </a>
                </div>
            }
        </div>
    </div>
</section>