<section id="medical-tourism" class="px-6 bg-white" style="padding-top:5rem; padding-bottom:5rem; border-top:1px solid #f0f0f0;">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">

            <!-- Left: Content -->
            <div class="fade-up flex flex-col" data-animate>
                <div class="inline-flex items-center gap-2 text-violet-600 font-bold mb-4 text-sm tracking-widest uppercase">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    Medical Tourism
                </div>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight leading-tight mb-5">
                    World-class treatment, <br />
                    <span class="text-gray-400 italic">planned end-to-end.</span>
                </h2>
                <p class="text-gray-500 text-base leading-relaxed mb-7 max-w-lg">
                    Connect with internationally accredited hospitals across Turkey, Thailand, Germany, and the UAE. MedLink handles everything — from pre-treatment consultations and visa assistance to accommodation and post-care follow-ups.
                </p>

                <div class="space-y-3 mb-8">
                    @foreach (var point in new[] {
                        "Pre-trip virtual consultation with the treating specialist",
                        "Medical visa invitation letters and documentation support",
                        "Partner hospitals in 15+ countries with JCI accreditation",
                        "Dedicated case coordinator from inquiry to recovery"
                    })
                    {
                        <div class="flex items-center gap-3">
                            <div style="background-color:#ede9fe; width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </div>
                            <p class="text-gray-600 text-sm">@point</p>
                        </div>
                    }
                </div>

                <div>
                    <a asp-area="Identity" asp-page="/Account/Login"
                       class="inline-flex items-center gap-2 text-white text-sm font-bold px-6 py-3 rounded-full transition-all shadow-md active:scale-95" style="background-color:#7c3aed;">
                        Explore Medical Tourism
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                </div>
            </div>

            <!-- Right: Destination Cards -->
            <div class="fade-up delay-200" data-animate>
                <div class="bg-white border border-gray-200 rounded-3xl overflow-hidden shadow-sm">
                    <!-- Card Header -->
                    <div class="px-6 pt-6 pb-4 border-b border-gray-100">
                        <p class="text-xs font-bold text-violet-600 uppercase tracking-widest">Top Destinations</p>
                    </div>
                    <!-- Destination List -->
                    <div class="divide-y divide-gray-50">
                        @foreach (var dest in new[] {
                            new { country = "Turkey", city = "Istanbul", specialty = "Hair Transplant · Oncology · Dental", saving = "Up to 70% savings", bgColor = "#fef3c7", accent = "#d97706" },
                            new { country = "Thailand", city = "Bangkok", specialty = "Orthopaedics · Cardiac · Wellness", saving = "Up to 65% savings", bgColor = "#dcfce7", accent = "#16a34a" },
                            new { country = "Germany", city = "Munich", specialty = "Neurology · Cancer · Rare Diseases", saving = "World-class precision", bgColor = "#dbeafe", accent = "#2563eb" },
                            new { country = "UAE", city = "Dubai", specialty = "Fertility · Cardiology · Aesthetics", saving = "Premium concierge care", bgColor = "#ede9fe", accent = "#7c3aed" }
                        })
                        {
                            <div class="flex items-center justify-between px-6 py-4 hover:bg-gray-50 transition-colors">
                                <div class="flex items-center gap-3">
                                    <div style="background-color:@dest.bgColor; width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="@dest.accent" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                                    </div>
                                    <div>
                                        <p class="text-sm font-bold text-gray-900">@dest.country <span class="text-gray-400 font-normal text-xs">· @dest.city</span></p>
                                        <p class="text-xs text-gray-400 mt-0.5">@dest.specialty</p>
                                    </div>
                                </div>
                                <span class="text-xs font-bold whitespace-nowrap ml-3" style="color:@dest.accent;">@dest.saving</span>
                            </div>
                        }
                    </div>
                    <!-- Card Footer Stats -->
                    <div class="px-6 py-5 bg-gray-50 border-t border-gray-100 flex items-center justify-between">
                        <div>
                            <p class="text-xs text-gray-400 font-medium">Partner hospitals</p>
                            <p class="text-xl font-bold text-gray-900">200+</p>
                        </div>
                        <div class="text-center">
                            <p class="text-xs text-gray-400 font-medium">Countries</p>
                            <p class="text-xl font-bold text-gray-900">15+</p>
                        </div>
                        <div class="text-right">
                            <p class="text-xs text-gray-400 font-medium">Patients served</p>
                            <p class="text-xl font-bold text-gray-900">8,000+</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
