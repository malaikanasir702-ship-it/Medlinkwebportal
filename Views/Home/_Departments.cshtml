@model List<MedLinkPortal.Models.Department>

<section id="departments" class="py-12 md:py-32 px-4 md:px-6 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 md:mb-20 gap-4 md:gap-8 fade-right" data-animate>
            <div class="max-w-xl">
                <h2 class="text-xs md:text-sm font-bold text-blue-600 uppercase tracking-[0.2em] mb-2 md:mb-4">Medical Specialties</h2>
                <h3 class="text-2xl md:text-5xl font-bold text-gray-900 tracking-tight leading-tight">
                    World-class expertise <br />
                    <span class="text-gray-400">across every discipline.</span>
                </h3>
            </div>
            <p class="text-gray-600 text-xs md:text-base max-w-sm mb-2">
                Access a vast network of board-certified specialists ready to provide precision care tailored to your needs.
            </p>
        </div>

        <div class="departments-grid grid grid-cols-2 lg:grid-cols-3 gap-3 md:gap-8 stagger-children" data-animate>
            @foreach (var dept in Model)
            {
                <div class="department-card group relative bg-gray-50 rounded-2xl md:rounded-[2rem] p-4 md:p-8 border border-gray-100 hover:bg-white hover:shadow-2xl hover:shadow-gray-200 transition-all duration-500 overflow-hidden fade-up flex flex-col justify-between" data-animate>
                    <div class="absolute -right-8 -top-8 w-24 h-24 md:w-32 md:h-32 rounded-full opacity-[0.03] group-hover:opacity-[0.08] transition-opacity @dept.Color"></div>

                    <div class="relative z-10">
                        <div class="w-10 h-10 md:w-14 md:h-14 rounded-xl md:rounded-2xl @dept.Color text-white flex items-center justify-center mb-3 md:mb-6 shadow-md group-hover:scale-110 transition-transform duration-500">
                            <i data-lucide="@dept.Icon.ToLower()" class="w-5 h-5 md:w-7 md:h-7"></i>
                        </div>

                        <div class="flex flex-col md:flex-row md:items-center justify-between mb-2 md:mb-4 gap-1">
                            <h4 class="text-base md:text-2xl font-bold text-gray-900 leading-snug">@dept.Title</h4>
                            <span class="bg-white border border-gray-100 px-2.5 py-0.5 md:px-3 md:py-1 rounded-full text-[9px] md:text-[10px] font-bold text-gray-500 uppercase tracking-wider w-max">
                                @dept.Specialists Doctors
                            </span>
                        </div>

                        <p class="text-gray-500 text-xs md:text-base mb-3 md:mb-8 leading-relaxed line-clamp-2">
                            @dept.Description
                        </p>
                    </div>

                    <a href="@Url.Action("DepartmentDetails", "Home", new { id = dept.Id })"
                       class="mt-2 flex items-center gap-1.5 text-blue-600 font-bold text-xs md:text-sm hover:gap-3 transition-all">
                        Explore <i data-lucide="arrow-right" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                    </a>
                </div>
            }
        </div>

        <div class="mt-20 p-8 md:p-12 rounded-[2.5rem] bg-blue-50 border border-blue-100 flex flex-col md:flex-row items-center justify-between gap-8 fade-up delay-300" data-animate>
            <div class="flex items-center gap-6">
                <div class="bg-blue-600 p-4 rounded-2xl text-white">
                    <i data-lucide="stethoscope" class="w-8 h-8"></i>
                </div>
                <div>
                    <h4 class="text-xl font-bold text-gray-900">Need immediate help?</h4>
                    <p class="text-gray-600">Our General Practitioners are available 24/7 for urgent triage.</p>
                </div>
            </div>
            <a href="@Url.Action("GPNow", "Home")"
                    class="whitespace-nowrap bg-gray-900 text-white px-8 py-4 rounded-full font-bold hover:bg-black transition-colors shadow-lg">
                Consult a GP Now
            </a>
        </div>
    </div>
</section>
