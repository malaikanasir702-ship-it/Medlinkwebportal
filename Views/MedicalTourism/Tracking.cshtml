@model MedLinkPortal.Models.PatientDashboardModel
@using MedLinkPortal.Models
@{
    ViewData["Title"] = "Journey Tracker";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var requests = ViewBag.Requests as List<MedicalTourismRequest> ?? new List<MedicalTourismRequest>();
}

<div class="space-y-10 pb-20">
    <!-- Header Section -->
    <div class="relative overflow-hidden bg-slate-900 rounded-[40px] p-10 md:p-16 text-white shadow-2xl">
        <div class="absolute top-0 right-0 w-96 h-96 bg-blue-600/20 rounded-full blur-[120px] -mr-48 -mt-48 transition-all duration-700 group-hover:bg-blue-600/30"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-indigo-600/10 rounded-full blur-[100px] -ml-32 -mb-32"></div>

        <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
            <div class="space-y-4">
                <div class="inline-flex items-center gap-2 px-4 py-2 bg-blue-500/10 border border-blue-500/20 rounded-full text-blue-400 text-[10px] font-black uppercase tracking-[0.3em]">
                    <i data-lucide="activity" class="w-3 h-3"></i>
                    Live Tracking
                </div>
                <h1 class="text-4xl md:text-6xl font-black tracking-tighter">Your Journey <br /><span class="text-blue-500">Milestones.</span></h1>
                <p class="text-slate-400 font-medium max-w-md leading-relaxed">
                    Track your medical tourism requests, upcoming travels, and global healthcare treatments in real-time.
                </p>
            </div>
            
            <div class="flex flex-wrap gap-4">
                <div class="bg-white/5 backdrop-blur-xl border border-white/10 p-6 rounded-3xl text-center min-w-[140px]">
                    <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-1">Active Trials</p>
                    <p class="text-3xl font-black text-white">@requests.Count(r => r.Status != RequestStatus.Cancelled && r.Status != RequestStatus.TourCompleted)</p>
                </div>
                <div class="bg-blue-600 p-6 rounded-3xl text-center min-w-[140px] shadow-lg shadow-blue-900/40">
                    <p class="text-[10px] font-black text-blue-200 uppercase tracking-widest mb-1">Total Requests</p>
                    <p class="text-3xl font-black text-white">@requests.Count</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Requests List -->
    <div class="space-y-6">
        @if (!requests.Any())
        {
            <div class="bg-white rounded-[40px] p-20 text-center border-2 border-dashed border-slate-100">
                <div class="w-20 h-20 bg-slate-50 rounded-3xl flex items-center justify-center mx-auto mb-6 text-slate-300">
                    <i data-lucide="plane-takeoff" class="w-10 h-10"></i>
                </div>
                <h3 class="text-2xl font-black text-slate-900 mb-2">No active journeys found.</h3>
                <p class="text-slate-500 mb-8 max-w-sm mx-auto">Start your world-class medical journey by exploring our premium treatment packages.</p>
                <a href="@Url.Action("Index", "MedicalTourism")" class="inline-flex items-center gap-3 px-8 py-4 bg-slate-900 text-white rounded-2xl font-black text-xs uppercase tracking-widest hover:bg-blue-600 transition-all hover:scale-105 active:scale-95">
                    Explore Destinations
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </a>
            </div>
        }
        else
        {
            @foreach (var request in requests)
            {
                <div class="group bg-white rounded-[40px] border border-slate-100 hover:border-blue-200 transition-all duration-500 hover:shadow-2xl hover:shadow-blue-900/5 overflow-hidden">
                    <div class="p-8 md:p-12">
                        <div class="flex flex-col lg:flex-row gap-10">
                            <!-- Left: Basic Info -->
                            <div class="lg:w-1/3 space-y-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-14 h-14 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-600">
                                        <i data-lucide="@(request.RequestType == TourismRequestType.Inbound ? "arrow-down-left" : "arrow-up-right")" class="w-7 h-7"></i>
                                    </div>
                                    <div>
                                        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">@request.RequestType Journey</p>
                                        <h4 class="text-xl font-black text-slate-900">@request.TreatmentType</h4>
                                    </div>
                                </div>

                                <div class="space-y-4">
                                    <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-100/50">
                                        <div class="flex items-center gap-3">
                                            <i data-lucide="map-pin" class="w-4 h-4 text-slate-400"></i>
                                            <span class="text-xs font-bold text-slate-600 uppercase tracking-tight">Destination</span>
                                        </div>
                                        <span class="text-sm font-black text-slate-900">@(string.IsNullOrEmpty(request.PreferredCity) ? "" : request.PreferredCity + ", ") @request.PreferredCountry</span>
                                    </div>
                                    <div class="flex items-center justify-between p-4 bg-slate-50 rounded-2xl border border-slate-100/50">
                                        <div class="flex items-center gap-3">
                                            <i data-lucide="calendar" class="w-4 h-4 text-slate-400"></i>
                                            <span class="text-xs font-bold text-slate-600 uppercase tracking-tight">Date Initiated</span>
                                        </div>
                                        <span class="text-sm font-black text-slate-900">@request.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Right: Status Tracker -->
                            <div class="lg:w-2/3 flex flex-col justify-between gap-10">
                                <div class="space-y-8">
                                    <div class="flex justify-between items-end">
                                        <div class="space-y-1">
                                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Current Status</p>
                                            <div class="flex items-center gap-3">
                                                <div class="w-3 h-3 rounded-full @GetStatusColorClass(request.Status) animate-pulse shadow-[0_0_15px] @GetStatusShadowClass(request.Status)"></div>
                                                <span class="text-2xl font-black text-slate-900 tracking-tight">@FormatStatus(request.Status)</span>
                                            </div>
                                        </div>
                                        @if (request.Status == RequestStatus.TravelScheduled || request.Status == RequestStatus.PackagePrepared)
                                        {
                                            <div class="px-6 py-3 bg-emerald-50 text-emerald-600 rounded-2xl text-[10px] font-black uppercase tracking-widest border border-emerald-100 flex items-center gap-2">
                                                <i data-lucide="check-circle" class="w-4 h-4"></i> Ready for Departure
                                            </div>
                                        }
                                    </div>

                                    <!-- Visual Progress Bar -->
                                    <div class="relative pt-6">
                                        <div class="flex justify-between mb-4">
                                            @{
                                                var steps = GetSteps(request.Status);
                                                for (int i = 0; i < steps.Count; i++)
                                                {
                                                    var step = steps[i];
                                                    <div class="flex flex-col items-center gap-2 group/step relative z-10 w-24">
                                                        <div class="w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300 @(step.IsCompleted ? "bg-blue-600 text-white shadow-lg shadow-blue-200" : (step.IsCurrent ? "bg-white border-4 border-blue-600 text-blue-600" : "bg-slate-100 text-slate-300"))">
                                                            <i data-lucide="@step.Icon" class="w-5 h-5"></i>
                                                        </div>
                                                        <span class="text-[9px] font-black uppercase tracking-widest text-center @(step.IsCompleted || step.IsCurrent ? "text-slate-900" : "text-slate-400")">@step.Label</span>
                                                    </div>
                                                }
                                            }
                                        </div>
                                        <!-- Progress Line Background -->
                                        <div class="absolute top-[3.25rem] left-8 right-8 h-1 bg-slate-100 -z-0 rounded-full"></div>
                                        <!-- Progress Line Foreground -->
                                        <div class="absolute top-[3.25rem] left-8 h-1 bg-blue-600 rounded-full -z-0 transition-all duration-1000" style="width: @(CalculateProgressPercentage(request.Status))%"></div>
                                    </div>
                                </div>

                                <div class="flex flex-wrap items-center gap-4 justify-end border-t border-slate-50 pt-8 mt-auto">
                                    @if(request.AssignedPackageId.HasValue)
                                    {
                                        <a href="@Url.Action("Package", new { id = request.AssignedPackageId })" class="flex items-center gap-2 px-6 py-3 bg-white border border-slate-200 text-slate-700 rounded-xl font-black text-[10px] uppercase tracking-widest hover:bg-slate-50 transition-all">
                                            <i data-lucide="eye" class="w-4 h-4"></i> View Package
                                        </a>
                                        <a href="@Url.Action("DownloadInvoice", new { id = request.Id })" class="flex items-center gap-2 px-6 py-3 bg-slate-900 text-white rounded-xl font-black text-[10px] uppercase tracking-widest hover:bg-blue-600 transition-all shadow-lg hover:shadow-blue-900/20">
                                            <i data-lucide="file-text" class="w-4 h-4"></i> Get Invoice
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] font-bold text-slate-400 italic">Waiting for Package Assignment...</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@functions {
    string GetStatusColorClass(RequestStatus status)
    {
        return status switch
        {
            RequestStatus.Pending => "bg-amber-400",
            RequestStatus.UnderReview => "bg-blue-400",
            RequestStatus.PackagePrepared => "bg-indigo-400",
            RequestStatus.CoordinatorAssigned => "bg-violet-400",
            RequestStatus.PaymentPending => "bg-rose-500",
            RequestStatus.TravelScheduled => "bg-teal-500",
            RequestStatus.TreatmentCompleted => "bg-emerald-500",
            RequestStatus.TourCompleted => "bg-emerald-600",
            RequestStatus.Cancelled => "bg-slate-400",
            _ => "bg-slate-300"
        };
    }

    string GetStatusShadowClass(RequestStatus status)
    {
        return status switch
        {
            RequestStatus.Pending => "shadow-amber-400/50",
            RequestStatus.UnderReview => "shadow-blue-400/50",
            RequestStatus.PackagePrepared => "shadow-indigo-400/50",
            RequestStatus.CoordinatorAssigned => "shadow-violet-400/50",
            RequestStatus.PaymentPending => "shadow-rose-500/50",
            RequestStatus.TravelScheduled => "shadow-teal-500/50",
            RequestStatus.TreatmentCompleted => "shadow-emerald-500/50",
            RequestStatus.TourCompleted => "shadow-emerald-600/50",
            RequestStatus.Cancelled => "shadow-slate-400/50",
            _ => "shadow-slate-300/50"
        };
    }

    string FormatStatus(RequestStatus status)
    {
        return System.Text.RegularExpressions.Regex.Replace(status.ToString(), "(\\B[A-Z])", " $1");
    }

    int CalculateProgressPercentage(RequestStatus status)
    {
        return status switch
        {
            RequestStatus.Pending => 5,
            RequestStatus.UnderReview => 25,
            RequestStatus.PackagePrepared or RequestStatus.CoordinatorAssigned => 50,
            RequestStatus.PaymentPending => 65,
            RequestStatus.TravelScheduled => 80,
            RequestStatus.TreatmentCompleted or RequestStatus.TourCompleted => 100,
            _ => 10
        };
    }

    List<ProgressStep> GetSteps(RequestStatus currentStatus)
    {
        var steps = new List<ProgressStep>
        {
            new ProgressStep { Label = "Request", Icon = "clipboard-list", Status = RequestStatus.Pending },
            new ProgressStep { Label = "Review", Icon = "search", Status = RequestStatus.UnderReview },
            new ProgressStep { Label = "Proposal", Icon = "file-spreadsheet", Status = RequestStatus.PackagePrepared },
            new ProgressStep { Label = "Secure", Icon = "shield-check", Status = RequestStatus.PaymentPending },
            new ProgressStep { Label = "Travel", Icon = "plane", Status = RequestStatus.TravelScheduled },
            new ProgressStep { Label = "Success", Icon = "sparkles", Status = RequestStatus.TreatmentCompleted }
        };

        bool completedFound = false;
        for (int i = 0; i < steps.Count; i++)
        {
            if (steps[i].Status == currentStatus)
            {
                steps[i].IsCurrent = true;
                for (int j = 0; j < i; j++) steps[j].IsCompleted = true;
                break;
            }
            // Fallback logic for when current status is between or beyond standard steps
            if (currentStatus == RequestStatus.TourCompleted) { foreach (var s in steps) s.IsCompleted = true; break; }
            if (currentStatus == RequestStatus.CoordinatorAssigned && steps[i].Status == RequestStatus.PackagePrepared)
            {
                steps[i].IsCurrent = true;
                for (int j = 0; j < i; j++) steps[j].IsCompleted = true;
                break;
            }
        }

        return steps;
    }

    public class ProgressStep
    {
        public string Label { get; set; }
        public string Icon { get; set; }
        public RequestStatus Status { get; set; }
        public bool IsCompleted { get; set; }
        public bool IsCurrent { get; set; }
    }
}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        if (typeof lucide !== 'undefined') {
            lucide.createIcons();
        }
    });
</script>
