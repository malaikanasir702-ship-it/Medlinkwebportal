@using Microsoft.AspNetCore.Identity
@inject UserManager<MedLinkPortal.Areas.Identity.Pages.Account.ApplicationUser> UserManager
@model IEnumerable<MedLinkPortal.Areas.Doctor.Models.PatientRecordListViewModel>
@{
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
    ViewData["Title"] = "Messages";
    ViewData["HideGlobalCall"] = true;
}


<div class="chat-container premium-card flex overflow-hidden reveal bg-white/50 backdrop-blur-xl h-[calc(100vh-140px)] relative">
    <!-- Signals Panel (Sidebar) -->
    <div id="signalsPanel" class="w-full md:w-80 flex-shrink-0 border-r border-slate-100 dark:border-white/5 flex flex-col bg-slate-50/50 dark:bg-white/5 transition-transform duration-300 absolute inset-0 md:relative z-10 md:z-auto">
        <div class="p-6 md:p-8 border-b border-slate-100 dark:border-white/5">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-semibold text-slate-900 dark:text-white tracking-tight">Signals</h2>
                <div class="w-8 h-8 rounded-lg bg-blue-600/10 flex items-center justify-center text-blue-600">
                    <i class="fas fa-tower-broadcast text-xs"></i>
                </div>
            </div>
            <div class="relative group">
                <input type="text" placeholder="Filter active nodes..." class="w-full pl-10 pr-4 py-3 bg-white dark:bg-slate-900 border-none rounded-2xl text-[11px] font-semibold uppercase tracking-widest placeholder-slate-400 focus:ring-2 focus:ring-blue-500/20 transition-all">
                <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-300 text-xs"></i>
            </div>
        </div>
        
        <div class="flex-grow overflow-y-auto custom-scrollbar">
            @foreach (var item in Model)
            {
                var patient = item.Patient;
                var isStarted = item.IsAppointmentStarted;
                var disabledClass = "";
                var statusIcon = isStarted ? "fa-circle-check text-emerald-500" : "fa-circle-nodes text-slate-300";
                
                <button onclick="loadConversation('@patient.Id', '@(patient.Name ?? patient.UserName ?? "Patient")', @(item.AppointmentId?.ToString() ?? "null"))" 
                        class="w-full p-6 flex items-center gap-4 hover:bg-white dark:hover:bg-white/5 transition-all text-left group contact-item @disabledClass" 
                        id="contact-@patient.Id">
                    <div class="relative">
                        <div class="w-14 h-14 bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-700 rounded-2xl flex items-center justify-center text-slate-600 dark:text-slate-300 font-semibold text-lg shadow-inner group-hover:scale-105 transition-transform">
                            @((patient.Name ?? patient.UserName ?? "PT").Substring(0, 1).ToUpper())
                        </div>
                        <div class="absolute -bottom-1 -right-1 w-5 h-5 bg-white dark:bg-slate-900 rounded-full flex items-center justify-center shadow-lg">
                            <i class="fas @statusIcon text-[8px]"></i>
                        </div>
                    </div>
                    <div class="flex-1 min-w-0">
                        <h4 class="text-sm font-semibold text-slate-900 dark:text-white truncate tracking-tight">@(patient.Name ?? patient.UserName ?? "Patient")</h4>
                        <p class="text-[10px] font-bold text-slate-400 mt-1 uppercase tracking-tighter truncate">
                            @(isStarted ? "Signal Live" : item.NextAppointmentTime.HasValue ? $"ETA {item.NextAppointmentTime.Value.ToString("HH:mm")}" : "Node Standby")
                        </p>
                    </div>
                    <div id="unread-@patient.Id" class="hidden">
                        <div class="bg-blue-600 text-white min-w-[20px] h-5 rounded-full flex items-center justify-center px-1.5 shadow-lg shadow-blue-500/20">
                            <span class="text-[9px] font-semibold unread-count">0</span>
                        </div>
                    </div>
                </button>
            }
        </div>
    </div>

    <!-- Communication Hub (Main Area) -->
    <div id="communicationHub" class="flex-grow flex flex-col bg-white dark:bg-slate-900/50 relative w-full md:w-auto absolute inset-0 md:relative z-20 md:z-auto translate-x-full md:translate-x-0 transition-transform duration-300">
        <!-- Hub Header -->
        <div id="chatHeader" class="px-4 py-3 md:px-8 md:py-5 border-b border-slate-100 dark:border-white/5 flex items-center justify-between hidden bg-white/80 backdrop-blur-md z-10 sticky top-0">
            <div class="flex items-center gap-4">
                <button onclick="backToSignals()" class="md:hidden w-10 h-10 rounded-xl bg-slate-100 dark:bg-white/5 flex items-center justify-center text-slate-600 hover:bg-blue-50 hover:text-blue-600 transition-all">
                    <i class="fas fa-chevron-left text-xs"></i>
                </button>
                <div class="relative">
                    <div id="activeUserAvatar" class="w-10 h-10 md:w-12 md:h-12 bg-blue-600 rounded-2xl flex items-center justify-center text-white font-semibold text-base md:text-lg shadow-xl shadow-blue-500/20">
                        ?
                    </div>
                    <div id="activeUserStatus" class="absolute -bottom-1 -right-1 w-3 h-3 md:w-4 md:h-4 bg-emerald-500 border-2 border-white dark:border-slate-900 rounded-full shadow-lg"></div>
                </div>
                <div class="min-w-0">
                    <h3 id="activeUserName" class="text-sm md:text-lg font-semibold text-slate-900 dark:text-white tracking-tight leading-none truncate max-w-[80px] xs:max-w-[150px] md:max-w-none">Select Patient</h3>
                    <p class="hidden xs:block text-[8px] md:text-[10px] font-semibold text-emerald-500 uppercase tracking-widest mt-2">Bi-directional Encrypted</p>
                </div>
            </div>
            <div class="flex items-center gap-1.5 md:gap-3">
                <button id="startConsultation" class="h-9 md:h-11 px-3 md:px-6 bg-slate-900 dark:bg-white text-white dark:text-slate-900 rounded-xl text-[10px] font-semibold uppercase tracking-widest hover:opacity-90 transition-all flex items-center gap-2">
                    <i class="fas fa-play text-[7px] md:text-[8px]"></i> 
                    <span class="hidden sm:inline">Start Consultation</span>
                    <span class="sm:hidden">Start</span>
                </button>
                <div class="hidden md:block w-px h-6 bg-slate-100 dark:border-white/5 mx-2"></div>
                <button onclick="startVideoCall()" class="w-9 h-9 md:w-11 md:h-11 flex items-center justify-center bg-slate-50 dark:bg-white/5 text-slate-400 hover:text-blue-500 rounded-xl transition-all" title="Video Call"><i class="fas fa-video text-[10px] md:text-xs"></i></button>
                <button onclick="startVoiceCall()" class="w-9 h-9 md:w-11 md:h-11 flex items-center justify-center bg-slate-50 dark:bg-white/5 text-slate-400 hover:text-blue-500 rounded-xl transition-all" title="Audio Call"><i class="fas fa-phone text-[10px] md:text-xs"></i></button>
            </div>
        </div>

        <div class="flex flex-grow overflow-hidden">
            <!-- Data Stream -->
            <div id="messagesArea" class="flex-grow p-8 overflow-y-auto flex flex-col gap-6 custom-scrollbar">
                <div id="messagesList" class="flex flex-col gap-6 flex-grow">
                    <div class="flex-grow flex items-center justify-center flex-col opacity-20">
                        <div class="w-24 h-24 bg-slate-100 dark:bg-white/5 rounded-[40px] flex items-center justify-center mb-8">
                            <i class="fas fa-comment-dots text-4xl text-slate-400"></i>
                        </div>
                        <h4 class="text-xl font-semibold text-slate-900 dark:text-white uppercase tracking-widest">Awaiting Link</h4>
                    </div>
                </div>
                
                <!-- Typing Bubble (Static) -->
                <div id="typingIndicator" class="flex items-center gap-2 mb-4 hidden shrink-0">
                    <div class="bg-slate-100 dark:bg-white/10 px-4 py-3 rounded-full rounded-tl-none flex items-center gap-1.5 ">
                         <div class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 0ms"></div>
                         <div class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 150ms"></div>
                         <div class="w-1.5 h-1.5 bg-slate-400 rounded-full animate-bounce" style="animation-delay: 300ms"></div>
                    </div>
                    <span class="text-[9px] font-semibold text-slate-300 uppercase tracking-widest animate-pulse">Typing...</span>
                </div>
            </div>

            <!-- Clinical Quick-Notes -->
            <div id="clinicalPanel" class="w-96 border-l border-slate-100 dark:border-white/5 bg-slate-50/30 dark:bg-white/2 hidden flex flex-col p-8 animate-in slide-in-from-right duration-500">
                <div class="flex items-center justify-between mb-8">
                    <h3 class="text-sm font-semibold text-slate-900 dark:text-white uppercase tracking-widest">Consultation Notes</h3>
                    <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
                </div>
                
                <div class="space-y-6 flex-grow overflow-y-auto pr-2 custom-scrollbar">
                    <div class="space-y-3">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Live Observations</label>
                        <textarea id="liveNotes" rows="6" class="premium-input w-full text-xs" placeholder="Input real-time findings..."></textarea>
                    </div>
                    <div class="space-y-3">
                        <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest ml-1">Draft Prescription</label>
                        <textarea id="livePrescription" rows="6" class="premium-input w-full text-xs" placeholder="Draft pharmacological vectors..."></textarea>
                    </div>
                </div>

                <div class="mt-8 pt-6 border-t border-slate-100 dark:border-white/5">
                    <button id="commitNotes" class="w-full py-4 bg-blue-600 text-white rounded-2xl text-[10px] font-semibold uppercase tracking-widest shadow-xl shadow-blue-500/30 hover:bg-blue-700 transition-all">
                        Commit to Timeline
                    </button>
                </div>
            </div>
        </div>

        <!-- Input Terminal -->
        <div id="inputArea" class="p-4 xs:p-8 hidden bg-white/50 backdrop-blur-md">
            <form id="chatForm" onsubmit="event.preventDefault(); sendMessage();" class="flex items-center gap-2 xs:gap-4 p-2 xs:p-3 bg-slate-50 dark:bg-white/5 rounded-[32px] border border-transparent focus-within:border-blue-500/30 transition-all shadow-inner">
                <div class="flex gap-2 ml-2">
                    <label class="cursor-pointer w-10 h-10 flex items-center justify-center text-slate-400 hover:text-blue-500 hover:bg-white dark:hover:bg-white/10 rounded-xl transition-all">
                        <i class="fas fa-image text-sm"></i>
                        <input type="file" id="imageInput" class="hidden" accept="image/*" onchange="handleImageSelect()">
                    </label>
                    <label class="cursor-pointer w-10 h-10 flex items-center justify-center text-slate-400 hover:text-blue-500 hover:bg-white dark:hover:bg-white/10 rounded-xl transition-all">
                        <i class="fas fa-paperclip text-sm"></i>
                        <input type="file" id="fileInput" class="hidden" onchange="handleFileSelect()">
                    </label>
                </div>
                <div class="flex-grow">
                    <input type="text" id="messageInput" placeholder="Enter clinical signal..." class="w-full bg-transparent border-none text-sm font-bold text-slate-800 dark:text-white placeholder-slate-400 p-0 focus:ring-0">
                </div>
                <button type="submit" class="w-12 h-12 bg-blue-600 text-white rounded-2xl flex items-center justify-center hover:bg-blue-700 transition-all shadow-xl shadow-blue-500/30 active:scale-90">
                    <i class="fas fa-location-arrow text-sm"></i>
                </button>
            </form>
            
            <div id="attachmentPreview" class="mt-4 hidden flex items-center gap-3 p-3 bg-blue-500/10 border border-blue-500/20 rounded-2xl">
                <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white text-[10px]">
                     <i class="fas fa-file"></i>
                </div>
                <span id="fileName" class="text-[11px] font-semibold text-blue-600 uppercase tracking-tight truncate max-w-[200px]">file.pdf</span>
                <button onclick="clearAttachment()" class="w-6 h-6 rounded-full bg-blue-100 text-blue-600 hover:bg-red-500 hover:text-white transition-all ml-auto">
                    <i class="fas fa-times text-[10px]"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Apple-inspired Premium Call Overlay -->
<div id="callOverlay" class="fixed inset-0 z-[100] flex items-center justify-center hidden p-0 lg:p-6 transition-all duration-500 ease-in-out opacity-0">
    
    <!-- Background Blur Overlay -->
    <div id="callOverlayBlur" class="absolute inset-0 bg-slate-900/40 backdrop-blur-2xl transition-opacity duration-700 opacity-0"></div>

    <!-- Main Call Container -->
    <div id="callContainer" class="w-full h-full lg:max-w-5xl lg:h-[85vh] lg:rounded-[3.5rem] relative overflow-hidden flex flex-col bg-[#050505] border border-white/5 shadow-[0_0_100px_rgba(0,0,0,0.8)] transition-transform duration-500 scale-95">
        
        <!-- Video Grid / Stage -->
        <div class="flex-1 relative bg-black">
            <!-- Remote Video (Full Screen) -->
            <video id="remoteVideo" autoplay playsinline 
                   class="w-full h-full object-cover transition-all duration-1000 ease-in-out opacity-0 hidden"></video>
            
            <!-- Audio Placeholder UI -->
            <div id="callPlaceholder" class="absolute inset-0 flex flex-col items-center justify-center z-10">
                
                <!-- Dynamic Blur Ring -->
                <div class="relative">
                    <div id="statusPulse" class="absolute inset-0 bg-blue-500/30 blur-[100px] rounded-full scale-150 transition-all duration-1000"></div>
                    
                    <!-- Professional Avatar Display -->
                    <div class="relative z-10 w-28 h-28 xs:w-40 xs:h-40 lg:w-56 lg:h-56 p-1 rounded-full bg-gradient-to-br from-white/10 to-transparent border border-white/20 shadow-2xl flex items-center justify-center">
                        <div id="callerAvatar" class="w-full h-full rounded-full bg-blue-600 flex items-center justify-center text-white text-4xl xs:text-6xl font-semibold shadow-inner ring-2 ring-white/5 overflow-hidden">
                            P
                        </div>
                        
                        <!-- Status Badge (iOS Style) -->
                        <div id="statusBadge" class="absolute -bottom-1 left-1/2 -translate-x-1/2 px-3 py-1 bg-white/10 backdrop-blur-md rounded-full border border-white/10 animate-bounce">
                            <span id="callStatusLabelSmall" class="text-[9px] font-semibold text-white uppercase tracking-wider whitespace-nowrap">Incoming</span>
                        </div>
                    </div>
                </div>

                <div class="mt-8 md:mt-12 text-center px-6 w-full max-w-sm mx-auto">
                    <h3 id="callTargetName" class="text-xl xs:text-3xl lg:text-5xl font-semibold text-white tracking-tight mb-2 break-all line-clamp-2">Patient Name</h3>
                    <p class="text-slate-400 font-bold uppercase tracking-widest text-[8px] lg:text-xs">
                        <span id="callDuration" class="text-emerald-400 hidden">00:00</span>
                        <span id="callStatusLabel">Secure Audio Link</span>
                    </p>
                </div>
            </div>

            <!-- Local PiP Video -->
            <div id="draggablePiP" class="absolute top-8 right-8 w-36 h-52 lg:w-56 lg:h-72 bg-slate-800 rounded-[2.5rem] overflow-hidden shadow-2xl border border-white/10 z-[100] group cursor-grab active:cursor-grabbing select-none hover:shadow-blue-500/20 hidden" style="touch-action: none;">
                <video id="localVideo" autoplay playsinline muted class="w-full h-full object-cover -scale-x-100"></video>
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </div>

            <!-- System Information (iOS Style) -->
            <div class="absolute top-8 left-8 z-40 bg-white/5 backdrop-blur-xl border border-white/10 px-4 py-2 rounded-2xl flex items-center gap-3">
                 <div class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]"></div>
                 <span class="text-[10px] font-semibold text-white/80 uppercase tracking-widest">E2E Secure</span>
            </div>
        </div>

        <!-- Ended Screen State -->
        <div id="endedScreen" class="absolute inset-0 z-50 bg-black/90 backdrop-blur-3xl flex flex-col items-center justify-center text-white p-6 hidden">
            <div class="w-20 h-20 bg-white/5 rounded-3xl flex items-center justify-center mb-8 border border-white/10">
                <i class="fas fa-check-circle text-4xl text-slate-400"></i>
            </div>
            <h2 class="text-4xl font-semibold mb-3">Session Summary</h2>
            <div class="flex items-center gap-4 text-slate-400 font-bold uppercase tracking-widest text-xs mb-12">
                 <span>Duration: <span id="finalDuration" class="text-white"></span></span>
                 <span class="w-1.5 h-1.5 rounded-full bg-slate-600"></span>
                 <span>Doctor: <span class="text-white">You</span></span>
            </div>
            <button onclick="closeCallOverlay()" class="px-12 py-5 bg-white text-black rounded-full font-semibold text-xs uppercase tracking-widest hover:bg-slate-200 transition-all hover:scale-105 active:scale-95 shadow-xl">
                Return to Hub
            </button>
        </div>

        <!-- Floating Controls Dock (Apple Dynamic Style) -->
        <div id="controlsDock" class="absolute bottom-12 left-0 right-0 z-50 px-6">
            
            <!-- Incoming Call Actions -->
            <div id="incomingActions" class="flex items-center justify-center gap-8 xs:gap-16 hidden">
                <div class="flex flex-col items-center gap-4 group">
                    <button onclick="rtc.rejectCall()" class="w-16 h-16 xs:w-20 xs:h-20 bg-red-600 text-white rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(220,38,38,0.4)] hover:bg-red-700 transition-all hover:scale-110 active:scale-90">
                        <i class="fas fa-phone-slash text-xl xs:text-2xl"></i>
                    </button>
                    <span class="text-[9px] xs:text-[10px] font-semibold text-white/40 uppercase tracking-widest group-hover:text-white transition-colors">Decline</span>
                </div>
                <div class="flex flex-col items-center gap-4 group">
                    <button onclick="rtc.acceptCall()" class="w-16 h-16 xs:w-20 xs:h-20 bg-emerald-500 text-white rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(16,185,129,0.4)] hover:bg-emerald-600 transition-all hover:scale-110 active:scale-90 ring-4 ring-emerald-500/20">
                        <i class="fas fa-phone text-xl xs:text-2xl"></i>
                    </button>
                    <span class="text-[9px] xs:text-[10px] font-semibold text-white/40 uppercase tracking-widest group-hover:text-white transition-colors">Accept</span>
                </div>
            </div>

            <!-- Active In-Call Dock -->
            <div id="activeActions" class="max-w-fit mx-auto flex items-center gap-4 xs:gap-8 bg-white/10 backdrop-blur-3xl px-6 xs:px-10 py-5 rounded-[3rem] border border-white/10 shadow-2xl hidden">
                
                <button id="btnMute" onclick="toggleLocalAudio()" class="w-12 h-12 xs:w-14 xs:h-14 rounded-full flex items-center justify-center transition-all border border-white/5 bg-white/5 text-slate-300 hover:bg-white/10">
                    <i class="fas fa-microphone text-base xs:text-lg"></i>
                </button>

                <!-- Centered End Call (Focus) -->
                <button onclick="rtc.endCall()" class="w-20 h-16 bg-red-600 text-white rounded-[2rem] flex items-center justify-center shadow-xl hover:bg-red-700 active:scale-90 transition-all transform hover:-translate-y-1">
                    <i class="fas fa-phone-slash text-2xl"></i>
                </button>

                <button id="btnVideo" onclick="toggleLocalVideo()" class="w-12 h-12 xs:w-14 xs:h-14 rounded-full flex items-center justify-center transition-all border border-white/5 bg-white/5 text-slate-300 hover:bg-white/10">
                    <i class="fas fa-video text-base xs:text-lg"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@* Redundant scripts removed - already in _DocDash layout *@


<script>
    let activeRecipientId = null;
    let activeAppointmentId = null;
    let connection = null;
    let rtc = null;
    let callTimerInterval = null;

    document.addEventListener("DOMContentLoaded", function() {
        const selectedId = '@ViewBag.SelectedPatientId';
        if (selectedId) {
            const btn = document.getElementById('contact-' + selectedId);
            if (btn) btn.click();
        }

        // Initialize SignalR
        connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        // Initialize WebRTC Handler
        rtc = new WebRTCHandler(connection);

        // WebRTC Signaling Events
        rtc.onCallIncoming = (callerId, type) => {
            const contact = document.getElementById('contact-' + callerId);
            const name = contact ? contact.querySelector('h4').textContent : "Patient";
            
            // Show Overlay in Incoming Mode
            showCallOverlay(name, type, 'ringing');
        };

        rtc.onStatusChange = (status) => {
            console.log("Status change:", status);
            if (status === 'connected') {
                updateCallUI('connected');
                startCallTimer();
            } else if (status === 'connecting') {
                updateCallUI('connecting');
            } else if (status === 'ringing') {
                updateCallUI('ringing');
            }
        };

        rtc.onLocalStream = (stream) => {
            const localVid = document.getElementById('localVideo');
            if (localVid) localVid.srcObject = stream;
        };

        rtc.onRemoteStream = (stream) => {
            const remoteVid = document.getElementById('remoteVideo');
            if (remoteVid) remoteVid.srcObject = stream;
        };

        rtc.onCallEnded = () => {
            updateCallUI('ended');
            stopCallTimer();
            logCallToChat();
        };

        rtc.onCallRejected = () => {
            document.getElementById('callStatusLabel').textContent = "Call Rejected";
            updateCallUI('ended');
        };

        connection.on("ReceiveMessage", (senderId, message, type, url, name, actualSenderId) => {
             const currentUserId = '@UserManager.GetUserId(User)';
             if (actualSenderId === currentUserId) return; // Prevent duplication

             if (activeRecipientId && actualSenderId === activeRecipientId) {
                 appendMessage({
                     content: message,
                     isMe: false, // If actualSenderId is activeRecipientId, it's NOT me
                     senderId: actualSenderId,
                     messageType: type === 'Call' ? 'Call' : 'Text',
                     timestamp: new Date().toISOString(),
                     attachmentPath: url,
                     attachmentType: type === 'image' || type === 'file' ? type : (url && type !== 'Call' ? (type.toLowerCase().startsWith('image') ? 'image' : 'file') : null)
                 });
                 // Real-time: Mark as read immediately seen
                 markAsRead();
             } else if (actualSenderId === '@UserManager.GetUserId(User)') {
                 // Message is from me, but was broadcast back to me
                 // Usually appendMessage is called manually in sendMessage, 
                 // but for real-time consistency we can check here
                 // Actually, sendMessage already appends. So we might get duplicates if we append here.
                 // Let's just ignore if it's from me OR check if it already exists.
             } else {
                 // Increment unread badge for another patient
                 const badge = document.getElementById('unread-' + actualSenderId);
                 if (badge) {
                     badge.classList.remove('hidden');
                     const countSpan = badge.querySelector('.unread-count');
                     countSpan.textContent = parseInt(countSpan.textContent) + 1;
                     
                     // Move contact to top
                     const contactBtn = document.getElementById('contact-' + actualSenderId);
                     if (contactBtn) {
                         const parent = contactBtn.parentElement;
                         parent.prepend(contactBtn);
                     }
                 }
             }
        });

        connection.start().then(() => {
            console.log("Doctor SignalR Connected");
            if (activeRecipientId) markAsRead();
        }).catch(err => console.error(err));

        // Start Consultation Button Logic
        const startBtn = document.getElementById('startConsultation');
        startBtn?.addEventListener('click', async () => {
            if (activeAppointmentId) window.location.href = '/Doctor/Doctor/ConsultationRoom/' + activeAppointmentId;
            else await PremiumModal.alert('No active appointment found for this patient signal.', 'Node Error');
        });

        // --- Typing Indicator ---
        let typingTimeout = null;
        const TYPING_TIMER_LENGTH = 2000;
        
        // Typing Event Triggers
        const messageInput = document.getElementById('messageInput');
        const typingBubble = document.getElementById('typingIndicator');
         
        messageInput.addEventListener('keydown', (e) => {
            if (!activeRecipientId) return;

            if (!typingTimeout) {
                console.log("Sending UserTyping to:", activeRecipientId);
                connection.invoke("UserTyping", activeRecipientId).catch(err => console.error(err));
            }

            if (typingTimeout) clearTimeout(typingTimeout);
            
            typingTimeout = setTimeout(() => {
                console.log("Sending UserStoppedTyping to:", activeRecipientId);
                connection.invoke("UserStoppedTyping", activeRecipientId).catch(err => console.error(err));
                typingTimeout = null;
            }, TYPING_TIMER_LENGTH);
        });

        connection.on("UserIsTyping", (senderId) => {
            console.log("UserIsTyping received from:", senderId, "Active:", activeRecipientId);
            if (activeRecipientId && activeRecipientId.toLowerCase() === senderId.toLowerCase()) {
                typingBubble.classList.remove('hidden');
                typingBubble.scrollIntoView({ behavior: 'smooth' });
            }
        });

        connection.on("UserStoppedTyping", (senderId) => {
            console.log("UserStoppedTyping received from:", senderId);
            if (activeRecipientId && activeRecipientId.toLowerCase() === senderId.toLowerCase()) {
                typingBubble.classList.add('hidden');
            }
        });

        // --- Read Receipts ---
        connection.on("MessagesRead", (readerId) => {
            console.log("MessagesRead received from:", readerId);
            if (activeRecipientId && activeRecipientId.toLowerCase() === readerId.toLowerCase()) {
                document.querySelectorAll('.message-tick').forEach(icon => {
                    icon.className = "fas fa-check-double text-[10px] text-blue-500 message-tick animate-in zoom-in duration-300";
                });
            }
        });
    });

    // --- Modern Call UI Logic ---
    function startVoiceCall() {
        if (!activeRecipientId) return;
        const name = document.getElementById('activeUserName').textContent;
        showCallOverlay(name, 'audio', 'connecting');
        rtc.initiateCall(activeRecipientId, 'audio');
    }

    function startVideoCall() {
        if (!activeRecipientId) return;
        const name = document.getElementById('activeUserName').textContent;
        showCallOverlay(name, 'video', 'connecting');
        rtc.initiateCall(activeRecipientId, 'video');
    }

    function showCallOverlay(name, type, state) {
        const overlay = document.getElementById('callOverlay');
        const blur = document.getElementById('callOverlayBlur');
        const container = document.getElementById('callContainer');
        
        document.getElementById('callTargetName').textContent = name;
        document.getElementById('callerAvatar').textContent = name.charAt(0).toUpperCase();

        overlay.classList.remove('hidden');
        
        // Trigger transitions
        setTimeout(() => {
            overlay.classList.remove('opacity-0');
            blur.classList.remove('opacity-0');
            container.classList.remove('scale-95');
            container.classList.add('scale-100');
        }, 10);

        updateCallUI(state);
    }

    function updateCallUI(state) {
        const placeholder = document.getElementById('callPlaceholder');
        const remoteVideo = document.getElementById('remoteVideo');
        const localContainer = document.getElementById('draggablePiP');
        const statusLabel = document.getElementById('callStatusLabel');
        const statusLabelSmall = document.getElementById('callStatusLabelSmall');
        const durationBox = document.getElementById('callDuration');
        const incomingActions = document.getElementById('incomingActions');
        const activeActions = document.getElementById('activeActions');
        const endedScreen = document.getElementById('endedScreen');
        const pulse = document.getElementById('statusPulse');

        // Reset visibility
        incomingActions.classList.add('hidden');
        activeActions.classList.add('hidden');
        endedScreen.classList.add('hidden');
        pulse.classList.remove('animate-pulse');

        if (state === 'ringing') {
            statusLabel.textContent = "Secure Audio Link";
            statusLabelSmall.textContent = "Incoming";
            incomingActions.classList.remove('hidden');
            durationBox.classList.add('hidden');
            pulse.classList.add('animate-pulse');
        } 
        else if (state === 'connecting') {
            statusLabel.textContent = "Establishing Secure Node";
            statusLabelSmall.textContent = "Linking...";
            activeActions.classList.remove('hidden');
            pulse.classList.add('animate-pulse');
        }
        else if (state === 'connected') {
            statusLabel.textContent = "";
            durationBox.classList.remove('hidden');
            activeActions.classList.remove('hidden');
            
            if (rtc.currentCall.type === 'video') {
                remoteVideo.classList.remove('hidden');
                setTimeout(() => remoteVideo.classList.remove('opacity-0'), 100);
                localContainer.classList.remove('hidden');
                placeholder.classList.add('hidden');
            } else {
                placeholder.classList.remove('hidden');
            }
        }
        else if (state === 'ended') {
            document.getElementById('finalDuration').textContent = document.getElementById('callDuration').textContent;
            endedScreen.classList.remove('hidden');
            durationBox.classList.add('hidden');
        }
    }

    function closeCallOverlay() {
        const overlay = document.getElementById('callOverlay');
        const blur = document.getElementById('callOverlayBlur');
        const container = document.getElementById('callContainer');

        overlay.classList.add('opacity-0');
        blur.classList.add('opacity-0');
        container.classList.remove('scale-100');
        container.classList.add('scale-95');

        setTimeout(() => {
            overlay.classList.add('hidden');
            // Clean up UI state
            document.getElementById('remoteVideo').classList.add('hidden', 'opacity-0');
            document.getElementById('draggablePiP').classList.add('hidden');
            document.getElementById('callPlaceholder').classList.remove('hidden');
            document.getElementById('callDuration').classList.add('hidden');
            document.getElementById('endedScreen').classList.add('hidden');
        }, 500);
    }

    function startCallTimer() {
        let seconds = 0;
        const durationSpan = document.getElementById('callDuration');
        durationSpan.textContent = "00:00";
        if (callTimerInterval) clearInterval(callTimerInterval);
        callTimerInterval = setInterval(() => {
            seconds++;
            const mins = Math.floor(seconds / 60).toString().padStart(2, '0');
            const secs = (seconds % 60).toString().padStart(2, '0');
            durationSpan.textContent = `${mins}:${secs}`;
        }, 1000);
    }

    function stopCallTimer() {
        if (callTimerInterval) clearInterval(callTimerInterval);
    }

    function toggleLocalAudio() {
        rtc.toggleMute();
        const btn = document.getElementById('btnMute');
        const muted = rtc.currentCall.muted;
        btn.querySelector('i').className = muted ? 'fas fa-microphone-slash' : 'fas fa-microphone';
        btn.classList.toggle('bg-white', muted);
        btn.classList.toggle('text-black', muted);
        btn.classList.toggle('text-slate-300', !muted);
    }

    function toggleLocalVideo() {
        rtc.toggleVideo();
        const btn = document.getElementById('btnVideo');
        const off = rtc.currentCall.videoOff;
        btn.querySelector('i').className = off ? 'fas fa-video-slash' : 'fas fa-video';
        btn.classList.toggle('bg-white', off);
        btn.classList.toggle('text-black', off);
        btn.classList.toggle('text-slate-300', !off);
    }

    // --- Mobile Navigation ---
    function backToSignals() {
        // Slide Chat OUT (Right)
        document.getElementById('communicationHub').classList.add('translate-x-full');
        document.getElementById('communicationHub').classList.remove('translate-x-0');
        
        // Slide Signals IN (Reset)
        // document.getElementById('signalsPanel').classList.remove('-translate-x-full');
    }

    // --- Chat Logic ---
    function loadConversation(userId, userName, appointmentId) {
        activeRecipientId = userId;
        activeAppointmentId = appointmentId;
        
        // Mobile Transition: Slide Chat IN
        const hub = document.getElementById('communicationHub');
        hub.classList.remove('translate-x-full');
        hub.classList.add('translate-x-0');

        document.querySelectorAll('.contact-item').forEach(item => item.classList.remove('bg-white', 'dark:bg-white/5', 'shadow-sm'));
        const activeLink = document.getElementById('contact-' + userId);
        if (activeLink) activeLink.classList.add('bg-white', 'dark:bg-white/5', 'shadow-sm');
        
        document.getElementById('chatHeader').classList.remove('hidden');
        document.getElementById('inputArea').classList.remove('hidden');
        document.getElementById('activeUserName').textContent = userName;
        document.getElementById('activeUserAvatar').textContent = userName.charAt(0).toUpperCase();
        
        // Reset unread badge
        const badge = document.getElementById('unread-' + userId);
        if (badge) {
            badge.classList.add('hidden');
            badge.querySelector('.unread-count').textContent = '0';
        }
        
        fetchMessages();
        markAsRead();
    }

    // ... (rest of functions: fetchMessages, renderMessages etc) ...

    async function fetchMessages() {
        if (!activeRecipientId) return;
        try {
            const response = await fetch(`/Doctor/Chat/GetMessages?otherUserId=${activeRecipientId}`);
            const messages = await response.json();
            renderMessages(messages);
        } catch (error) { console.error('Error fetching messages:', error); }
    }

    function renderMessages(messages) {
        const list = document.getElementById('messagesList');
        const area = document.getElementById('messagesArea');
        list.innerHTML = '';
        if (messages.length === 0) {
            list.innerHTML = `<div class="flex-grow flex items-center justify-center text-gray-400 flex-col opacity-50"><p>Awaiting clinical exchange...</p></div>`;
            return;
        }

        messages.forEach(msg => {
            const div = document.createElement('div');
            const isMe = msg.isMe;
            
            if (msg.messageType === 'Call') {
                 div.className = "w-full flex justify-center my-4";
                 const time = new Date(msg.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                 div.innerHTML = `
                    <div class="bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/10 px-4 py-2 rounded-full flex items-center gap-2 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">
                        <i class="fas fa-phone-slash text-blue-500"></i>
                        <span>${msg.content}</span>
                        <span class="opacity-30">|</span>
                        <span>${time}</span>
                    </div>
                 `;
            } else {
                div.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'} group w-full`;
                
                let attachmentHtml = '';
                if (msg.attachmentPath) {
                    const aUrl = msg.attachmentPath.toLowerCase();
                    const aType = (msg.attachmentType || '').toLowerCase();
                    const isImage = aType === 'image' || aUrl.endsWith('.jpg') || aUrl.endsWith('.jpeg') || aUrl.endsWith('.png') || aUrl.endsWith('.gif') || aUrl.endsWith('.webp');
                    
                    if (isImage) {
                        attachmentHtml = `<img src="${msg.attachmentPath}" class="rounded-2xl mb-3 max-w-full lg:max-w-md border border-slate-100 shadow-sm cursor-pointer hover:opacity-90 transition-opacity" onclick="window.open('${msg.attachmentPath}')">`;
                    } else {
                        attachmentHtml = `<div class="flex items-center gap-3 p-3 bg-slate-100 dark:bg-white/5 rounded-2xl mb-3 border border-slate-200 dark:border-white/10">
                                            <div class="w-8 h-8 rounded-lg bg-blue-600/10 flex items-center justify-center text-blue-600">
                                                <i class="fas fa-file-pdf"></i>
                                            </div>
                                            <a href="${msg.attachmentPath}" target="_blank" class="text-[10px] font-semibold uppercase tracking-widest truncate max-w-[150px] hover:text-blue-600 transition-colors">Link Attachment</a>
                                          </div>`;
                    }
                }

                const time = new Date(msg.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                // Ticks
                let tickIcon = '';
                if (isMe) {
                    if (msg.isRead) {
                        tickIcon = '<i class="fas fa-check-double text-[10px] text-blue-500 message-tick"></i>';
                    } else {
                        tickIcon = '<i class="fas fa-check text-[10px] text-slate-300 message-tick"></i>';
                    }
                }

                div.innerHTML = `
                    <div class="flex flex-col max-w-[80%] ${isMe ? 'items-end' : 'items-start'}">
                        ${attachmentHtml}
                        ${(msg.content && msg.content !== 'null') ? `
                        <div class="px-5 py-3 rounded-[1.5rem] text-sm font-bold shadow-sm ${isMe ? 'bg-blue-600 text-white rounded-tr-none' : 'bg-slate-50 dark:bg-white/5 text-slate-800 dark:text-white rounded-tl-none'}">
                            ${msg.content}
                        </div>
                        ` : ''}
                        <div class="flex items-center gap-1 mt-1">
                             <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest">${time}</span>
                             ${tickIcon}
                        </div>
                    </div>
                `;
            }
            list.appendChild(div);
        });
        area.scrollTop = area.scrollHeight;
    }

    function appendMessage(msg) {
        const list = document.getElementById('messagesList');
        const area = document.getElementById('messagesArea');
        const empty = list.querySelector('.opacity-50');
        if (empty) list.innerHTML = '';

        const div = document.createElement('div');
        const isMe = msg.isMe;
        
        if (msg.messageType === 'Call') {
             div.className = "w-full flex justify-center my-4 animate-in zoom-in duration-300";
             const time = new Date(msg.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
             div.innerHTML = `
                <div class="bg-slate-50 dark:bg-white/5 border border-slate-100 dark:border-white/10 px-4 py-2 rounded-full flex items-center gap-2 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">
                    <i class="fas fa-phone-slash text-blue-500"></i>
                    <span>${msg.content}</span>
                    <span class="opacity-30">|</span>
                    <span>${time}</span>
                </div>
             `;
        } else {
            div.className = `flex flex-col ${isMe ? 'items-end' : 'items-start'} group w-full animate-in slide-in-from-bottom-2`;
            
            let attachmentHtml = '';
            if (msg.attachmentPath) {
                const aUrl = msg.attachmentPath.toLowerCase();
                const aType = (msg.attachmentType || '').toLowerCase();
                const isImage = aType === 'image' || aUrl.endsWith('.jpg') || aUrl.endsWith('.jpeg') || aUrl.endsWith('.png') || aUrl.endsWith('.gif') || aUrl.endsWith('.webp');
                
                if (isImage) {
                    attachmentHtml = `<img src="${msg.attachmentPath}" class="rounded-2xl mb-3 max-w-full lg:max-w-md border border-slate-100 shadow-sm cursor-pointer hover:opacity-90 transition-opacity" onclick="window.open('${msg.attachmentPath}')">`;
                } else {
                    attachmentHtml = `<div class="flex items-center gap-3 p-3 bg-slate-100 dark:bg-white/5 rounded-2xl mb-3 border border-slate-200 dark:border-white/10">
                                        <div class="w-8 h-8 rounded-lg bg-blue-600/10 flex items-center justify-center text-blue-600">
                                            <i class="fas fa-file-pdf"></i>
                                        </div>
                                        <a href="${msg.attachmentPath}" target="_blank" class="text-[10px] font-semibold uppercase tracking-widest truncate max-w-[150px] hover:text-blue-600 transition-colors">Link Attachment</a>
                                      </div>`;
                }
            }

            const time = new Date(msg.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            
            // Double Tick Logic
            let tickIcon = '<i class="fas fa-check text-[10px] text-slate-300 message-tick"></i>';

            div.innerHTML = `
                 <div class="flex flex-col max-w-[80%] ${isMe ? 'items-end' : 'items-start'}">
                    ${attachmentHtml}
                    ${(msg.content && msg.content !== 'null') ? `
                    <div class="px-5 py-3 rounded-[1.5rem] text-sm font-bold shadow-sm ${isMe ? 'bg-blue-600 text-white rounded-tr-none' : 'bg-slate-50 dark:bg-white/5 text-slate-800 dark:text-white rounded-tl-none'}">
                        ${msg.content}
                    </div>
                    ` : ''}
                    <div class="flex items-center gap-1 mt-1">
                         <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest">${time}</span>
                         ${isMe ? tickIcon : ''}
                    </div>
                </div>
            `;
        }
        list.appendChild(div);
        area.scrollTop = area.scrollHeight;
    }

    async function sendMessage() {
        const input = document.getElementById('messageInput');
        const fileInput = document.getElementById('fileInput');
        const imageInput = document.getElementById('imageInput');
        
        const content = input.value.trim();
        const file = fileInput.files[0] || imageInput.files[0];
        
        if (!content && !file) return;

        const formData = new FormData();
        formData.append('receiverId', activeRecipientId);
        formData.append('content', content);
        if (file) formData.append('attachment', file);

        input.value = '';
        clearAttachment();
        
        try {
            const res = await fetch('/Doctor/Chat/SendMessage', { method: 'POST', body: formData });
            if (res.ok) {
                appendMessage({
                    content: content,
                    isMe: true,
                    timestamp: new Date(),
                    attachmentPath: file ? URL.createObjectURL(file) : null,
                    attachmentType: file ? (file.type.startsWith('image/') ? 'image' : 'file') : null
                });
            }
        } catch (error) { console.error('Error sending message:', error); }
    }

    function handleFileSelect() {
        const file = document.getElementById('fileInput').files[0];
        if (file) { document.getElementById('imageInput').value = ''; showPreview(file.name); }
    }

    function handleImageSelect() {
        const file = document.getElementById('imageInput').files[0];
        if (file) { document.getElementById('fileInput').value = ''; showPreview(file.name); }
    }

    function showPreview(name) {
        document.getElementById('attachmentPreview').classList.remove('hidden');
        document.getElementById('fileName').textContent = name;
    }

    function clearAttachment() {
        document.getElementById('fileInput').value = '';
        document.getElementById('imageInput').value = '';
        document.getElementById('attachmentPreview').classList.add('hidden');
    }

    async function logCallToChat() {
        if (!activeRecipientId) return;
        const fd = new FormData();
        fd.append('patientId', activeRecipientId);
        fd.append('callType', rtc.currentCall?.type || 'audio');
        const res = await fetch('/Doctor/Chat/LogCall', { method: 'POST', body: fd });
        if (res.ok) {
            const data = await res.json();
            if (data.success && data.message) {
                appendMessage({
                    ...data.message,
                    isMe: true
                });
            }
        }
    }



    function markAsRead() {
        if (activeRecipientId && connection && connection.state === signalR.HubConnectionState.Connected) {
             console.log("Marking messages as read for:", activeRecipientId);
             connection.invoke("MarkMessagesAsRead", activeRecipientId).catch(err => console.error(err));
        } else {
             console.warn("Connection not ready to mark as read.");
        }
    }


    // --- Draggable PiP Logic (Isolated) ---
    (function() {
        let isDragging = false;
        let startX, startY;
        let currentX = 0, currentY = 0;
        let savedX = 0, savedY = 0;

        const initDrag = () => {
            const pip = document.getElementById('draggablePiP');
            if (!pip) return setTimeout(initDrag, 500);
            const container = pip.parentElement;

            const dragStart = (e) => {
                const clientX = e.type === "touchstart" ? e.touches[0].clientX : e.clientX;
                const clientY = e.type === "touchstart" ? e.touches[0].clientY : e.clientY;

                if (e.target === pip || pip.contains(e.target)) {
                    isDragging = true;
                    startX = clientX;
                    startY = clientY;
                    pip.classList.add('shadow-blue-500/40');
                    e.stopPropagation();
                }
            };

            const dragMove = (e) => {
                if (!isDragging) return;
                
                const clientX = e.type === "touchmove" ? e.touches[0].clientX : e.clientX;
                const clientY = e.type === "touchmove" ? e.touches[0].clientY : e.clientY;

                let deltaX = clientX - startX;
                let deltaY = clientY - startY;

                let nextX = savedX + deltaX;
                let nextY = savedY + deltaY;

                // Boundary Clamping
                const rect = pip.getBoundingClientRect();
                const containerRect = container.getBoundingClientRect();

                const limitLeft = -(containerRect.width - rect.width - 32);
                const limitTop = 0;
                const limitRight = 0;
                const limitBottom = containerRect.height - rect.height - 32;

                currentX = Math.max(limitLeft, Math.min(nextX, limitRight));
                currentY = Math.max(limitTop, Math.min(nextY, limitBottom));

                pip.style.transform = `translate3d(${currentX}px, ${currentY}px, 0)`;
                if (e.cancelable) e.preventDefault();
            };

            const dragEnd = () => {
                if (!isDragging) return;
                isDragging = false;
                savedX = currentX;
                savedY = currentY;
                pip.classList.remove('shadow-blue-500/40');
            };

            pip.addEventListener("mousedown", dragStart);
            pip.addEventListener("touchstart", dragStart, { passive: false });
            window.addEventListener("mousemove", dragMove);
            window.addEventListener("touchmove", dragMove, { passive: false });
            window.addEventListener("mouseup", dragEnd);
            window.addEventListener("touchend", dragEnd);
        };

        document.addEventListener("DOMContentLoaded", initDrag);
    })();
</script>

