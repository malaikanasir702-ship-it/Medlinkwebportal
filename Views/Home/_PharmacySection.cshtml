<section id="pharmacy" class="py-20 px-6 bg-white">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

            <!-- Left: Content -->
            <div class="fade-up flex flex-col" data-animate>
                <div class="inline-flex items-center gap-2 text-emerald-600 font-bold mb-4 text-sm tracking-widest uppercase">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    Online Pharmacy
                </div>
                <h2 class="text-3xl md:text-4xl font-bold text-gray-900 tracking-tight leading-tight mb-5">
                    Medicines delivered <br />
                    <span class="text-gray-400 italic">right to your door.</span>
                </h2>
                <p class="text-gray-500 text-base leading-relaxed mb-6 max-w-lg">
                    Browse thousands of prescription and OTC medicines. Upload your prescription, get it verified by a licensed pharmacist, and receive your order the same day — no queues, no hassle.
                </p>

                <div class="space-y-3 mb-8">
                    @foreach (var point in new[] {
                        "Licensed pharmacist verification on every order",
                        "Same-day delivery available in major cities",
                        "Authentic medicines from certified suppliers only",
                        "Automated refill reminders linked to your prescriptions"
                    })
                    {
                        <div class="flex items-center gap-3">
                            <div style="background-color:#d1fae5; width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                            </div>
                            <p class="text-gray-600 text-sm">@point</p>
                        </div>
                    }
                </div>

                <div>
                    <a asp-area="Identity" asp-page="/Account/Login"
                       class="inline-flex items-center gap-2 bg-emerald-600 text-white text-sm font-bold px-6 py-3 rounded-full hover:bg-emerald-700 transition-all shadow-md hover:shadow-emerald-200 active:scale-95">
                        Order Medicines Now
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                    </a>
                </div>
            </div>

            <!-- Right: Visual Card -->
            <div class="fade-up delay-200" data-animate>
                <div class="bg-gradient-to-br from-emerald-50 to-white border border-emerald-100 rounded-3xl p-8">
                    <p class="text-xs font-bold text-emerald-600 uppercase tracking-widest mb-4">Popular Categories</p>
                    <div class="grid grid-cols-3 gap-3 mb-6">

                        <!-- Pain Relief -->
                        <div class="rounded-2xl p-3 text-center cursor-pointer hover:shadow-md transition-shadow" style="background-color:#fee2e2;">
                            <div class="flex justify-center mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 20H4a2 2 0 0 1-2-2V5c0-1.1.9-2 2-2h3.93a2 2 0 0 1 1.66.9l.82 1.2a2 2 0 0 0 1.66.9H20a2 2 0 0 1 2 2v3"/><circle cx="18" cy="18" r="3"/><path d="m22 22-1.5-1.5"/></svg>
                            </div>
                            <p class="text-xs font-semibold text-gray-700">Pain Relief</p>
                        </div>

                        <!-- Vitamins -->
                        <div class="rounded-2xl p-3 text-center cursor-pointer hover:shadow-md transition-shadow" style="background-color:#fef9c3;">
                            <div class="flex justify-center mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ca8a04" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a10 10 0 1 0 10 10"/><path d="M12 6v6l4 2"/></svg>
                            </div>
                            <p class="text-xs font-semibold text-gray-700">Vitamins</p>
                        </div>

                        <!-- Antibiotics -->
                        <div class="rounded-2xl p-3 text-center cursor-pointer hover:shadow-md transition-shadow" style="background-color:#dbeafe;">
                            <div class="flex justify-center mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m9 3-6 6 7.5 7.5"/><path d="m15 3 6 6-7.5 7.5"/><path d="M3 9h18"/><path d="M3 15h18"/></svg>
                            </div>
                            <p class="text-xs font-semibold text-gray-700">Antibiotics</p>
                        </div>

                        <!-- Heart Care -->
                        <div class="rounded-2xl p-3 text-center cursor-pointer hover:shadow-md transition-shadow" style="background-color:#fce7f3;">
                            <div class="flex justify-center mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#db2777" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                            </div>
                            <p class="text-xs font-semibold text-gray-700">Heart Care</p>
                        </div>

                        <!-- Diabetes -->
                        <div class="rounded-2xl p-3 text-center cursor-pointer hover:shadow-md transition-shadow" style="background-color:#e0f2fe;">
                            <div class="flex justify-center mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 10c-.83 0-1.5-.67-1.5-1.5v-5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5z"/><path d="M20.5 10H19V8.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/><path d="M9.5 14c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5S8 21.33 8 20.5v-5c0-.83.67-1.5 1.5-1.5z"/><path d="M3.5 14H5v1.5c0 .83-.67 1.5-1.5 1.5S2 16.33 2 15.5 2.67 14 3.5 14z"/><path d="M14 14.5c0-.83.67-1.5 1.5-1.5h5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5h-5c-.83 0-1.5-.67-1.5-1.5z"/><path d="M15.5 19H14v1.5c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5-.67-1.5-1.5-1.5z"/><path d="M10 9.5C10 8.67 9.33 8 8.5 8h-5C2.67 8 2 8.67 2 9.5S2.67 11 3.5 11h5c.83 0 1.5-.67 1.5-1.5z"/><path d="M8.5 5H10V3.5C10 2.67 9.33 2 8.5 2S7 2.67 7 3.5 7.67 5 8.5 5z"/></svg>
                            </div>
                            <p class="text-xs font-semibold text-gray-700">Diabetes</p>
                        </div>

                        <!-- Eye Drops -->
                        <div class="rounded-2xl p-3 text-center cursor-pointer hover:shadow-md transition-shadow" style="background-color:#ede9fe;">
                            <div class="flex justify-center mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </div>
                            <p class="text-xs font-semibold text-gray-700">Eye Drops</p>
                        </div>

                    </div>
                    <div class="border-t border-emerald-100 pt-5 flex items-center justify-between">
                        <div>
                            <p class="text-xs text-gray-400 font-medium">Avg. delivery</p>
                            <p class="text-2xl font-bold text-gray-900">2–4 hrs</p>
                        </div>
                        <div class="text-center">
                            <p class="text-xs text-gray-400 font-medium">Orders fulfilled</p>
                            <p class="text-2xl font-bold text-gray-900">50K+</p>
                        </div>
                        <div class="text-right">
                            <p class="text-xs text-gray-400 font-medium">Pharmacies</p>
                            <p class="text-2xl font-bold text-gray-900">120+</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
