@model MedLinkPortal.Areas.Admin.Models.InvoiceDetailsViewModel
<div class="space-y-10 pb-20">
    <div class="flex items-center justify-between py-6">
        <div class="animate-in fade-in slide-in-from-left-8 duration-700">
            <nav class="flex items-center gap-2 mb-4 text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-400">
                <a href="/Billing" class="hover:text-blue-600 transition-colors">Ledger</a>
                <i class="fas fa-chevron-right text-[8px]"></i>
                <span class="text-slate-900">Invoice #INV-@Model.Invoice.Id</span>
            </nav>
            <h1 class="text-5xl md:text-6xl font-semibold text-slate-900 tracking-tighter">
                Financial <span class="text-blue-600">Verification</span>
            </h1>
        </div>
        <div class="flex gap-4">
            <button onclick="window.print()" class="flex items-center gap-3 px-6 py-4 bg-white border border-slate-200 text-slate-900 rounded-2xl text-[10px] font-semibold uppercase tracking-widest hover:bg-slate-50 transition-all shadow-sm">
                <i class="fas fa-print"></i> Export Node
            </button>
            <a href="/Billing" class="flex items-center gap-3 px-6 py-4 bg-slate-900 text-white rounded-2xl text-[10px] font-semibold uppercase tracking-widest hover:bg-black transition-all shadow-xl">
                <i class="fas fa-arrow-left"></i> Return
            </a>
        </div>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-10">
        <div class="xl:col-span-8 space-y-10">
            <div class="bento-card p-10 bg-white group border border-slate-100 relative overflow-hidden">
                <div class="absolute top-0 right-0 w-64 h-64 bg-blue-50/30 rounded-full blur-3xl -mr-32 -mt-32"></div>
                <div class="relative flex flex-col md:flex-row gap-12 items-start">
                    <div class="w-24 h-24 rounded-[32px] bg-slate-900 flex items-center justify-center text-white text-4xl shadow-2xl relative">
                        <i class="fas fa-user-injured"></i>
                        <span class="absolute -bottom-2 -right-2 w-8 h-8 bg-emerald-500 border-4 border-white rounded-full flex items-center justify-center text-white text-[10px]">
                            <i class="fas fa-check"></i>
                        </span>
                    </div>
                    <div class="flex-1 space-y-6">
                        <div>
                            <p class="text-[10px] font-semibold text-blue-500 uppercase tracking-widest mb-1">Authenticated Resident</p>
                            <h2 class="text-4xl font-semibold text-slate-900 tracking-tight">@Model.Patient.Name</h2>
                            <div class="flex flex-wrap gap-2 mt-2">
                                <span class="px-2.5 py-1 bg-slate-100 text-slate-600 rounded-md text-[9px] font-semibold uppercase tracking-wider">@Model.Patient.Diagnostic</span>
                                <span class="px-2.5 py-1 bg-blue-50 text-blue-600 rounded-md text-[9px] font-semibold uppercase tracking-wider">@Model.Patient.Status</span>
                                <span class="px-2.5 py-1 bg-purple-50 text-purple-600 rounded-md text-[9px] font-semibold uppercase tracking-wider">Cohort A</span>
                            </div>
                            <p class="text-slate-500 font-medium text-lg mt-4">ID: <span class="text-slate-900 font-bold">@Model.Patient.Id</span> • Registered @Model.Patient.DateRegistered.ToString("MMM yyyy")</p>
                        </div>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-8 pt-8 border-t border-slate-50">
                            <div>
                                <p class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-2">Age / Gender</p>
                                <p class="text-base font-bold text-slate-900">@(DateTime.Now.Year - Model.Patient.DateOfBirth.Year)Y / @Model.Patient.Gender</p>
                            </div>
                            <div>
                                <p class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-2">Contact Link</p>
                                <p class="text-base font-bold text-slate-900">@Model.Patient.Phone</p>
                            </div>
                            <div>
                                <p class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest mb-2">Clinical Location</p>
                                <p class="text-base font-bold text-slate-900">@Model.Patient.Address</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bento-card p-10 bg-white border border-slate-100">
                <div class="flex items-center justify-between mb-10 pb-6 border-b border-slate-50">
                    <div>
                        <h3 class="text-xl font-semibold text-slate-900 mb-1">Clinical <span class="text-blue-600">Encounters</span></h3>
                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Chronological Record of Care</p>
                    </div>
                    <span class="px-3 py-1 bg-blue-50 text-blue-600 rounded-lg text-[10px] font-semibold uppercase">@Model.MedicalRecords.Count Records Bound</span>
                </div>
                @if(Model.MedicalRecords.Any()) {
                    <div class="relative space-y-8 before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-slate-200 before:to-transparent">
                        @foreach(var record in Model.MedicalRecords) {
                            <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
                                <div class="flex items-center justify-center w-10 h-10 rounded-full border-4 border-white bg-slate-100 group-hover:bg-blue-600 transition-colors shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10 text-slate-400 group-hover:text-white">
                                    <i class="fas @(record.RecordType == "Prescription" ? "fa-pills" : record.RecordType == "LabResult" ? "fa-microscope" : "fa-stethoscope") text-xs"></i>
                                </div>
                                <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-6 rounded-[24px] bg-slate-50 border border-slate-100 hover:bg-white hover:shadow-xl hover:-translate-y-1 transition-all duration-500">
                                    <div class="flex items-center justify-between mb-3">
                                        <span class="px-3 py-1 bg-white border border-slate-100 rounded-lg text-[9px] font-semibold @(record.RecordType == "Prescription" ? "text-emerald-500" : record.RecordType == "LabResult" ? "text-purple-500" : "text-blue-500") uppercase tracking-wider shadow-sm">
                                            @record.RecordType
                                        </span>
                                        <time class="text-[9px] font-bold text-slate-300">@record.DateCreated.ToString("HH:mm tt")</time>
                                    </div>
                                    <h4 class="text-lg font-semibold text-slate-900 mb-2">@record.Title</h4>
                                    <div class="relative pl-4 border-l-2 border-slate-200 my-4">
                                        <p class="text-sm font-medium text-slate-600 italic leading-relaxed">"@record.Content"</p>
                                    </div>
                                    @if(record.RecordType == "Prescription")
                                    {
                                        <div class="flex items-center gap-3 mt-4 p-3 bg-emerald-50/50 rounded-xl border border-emerald-100">
                                            <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-600">
                                                <i class="fas fa-prescription"></i>
                                            </div>
                                            <div>
                                                <p class="text-[9px] font-semibold text-emerald-700 uppercase">Rx Details</p>
                                                <p class="text-xs font-bold text-slate-700">Authorized Dispersion</p>
                                            </div>
                                        </div>
                                    }
                                    @if(record.Physician != null) {
                                        <div class="flex items-center gap-3 mt-4 pt-4 border-t border-slate-100">
                                            <div class="w-8 h-8 rounded-full bg-indigo-50 flex items-center justify-center text-[10px] text-indigo-500 font-semibold border border-indigo-100">
                                                DR
                                            </div>
                                            <div>
                                                <p class="text-[9px] font-semibold text-slate-400 uppercase">Attending Physician</p>
                                                <p class="text-xs font-bold text-slate-900">Dr. @record.Physician.Name</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                } else {
                    <div class="flex flex-col items-center justify-center py-20 opacity-50">
                        <div class="w-20 h-20 bg-slate-50 rounded-full flex items-center justify-center mb-6">
                            <i class="fas fa-file-medical-alt text-3xl text-slate-300"></i>
                        </div>
                        <h4 class="text-lg font-semibold text-slate-900">No Clinical Encounters</h4>
                        <p class="text-sm font-medium text-slate-400">No medical records have been linked to this invoice.</p>
                    </div>
                }
            </div>
        </div>
        <div class="xl:col-span-4 space-y-10">
            <div class="bento-card bg-[#0F172A] p-10 text-white relative overflow-hidden group">
                <div class="absolute top-0 right-0 w-32 h-32 bg-blue-600/20 rounded-full blur-2xl -mr-16 -mt-16 group-hover:bg-blue-600/40 transition-all duration-700"></div>
                <p class="text-[10px] font-semibold text-blue-400 uppercase tracking-[0.3em] mb-4">Invoice Intelligence</p>
                <div class="space-y-1 mb-8">
                    <h3 class="text-4xl font-semibold tracking-tighter">#INV-@Model.Invoice.Id</h3>
                    <p class="text-slate-400 text-xs font-medium">System Generated: @Model.Invoice.DateGenerated.ToString("ddd, MMM dd, yyyy")</p>
                </div>
                <div class="space-y-6 pt-8 border-t border-white/10">
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold text-slate-400">Total Billed</span>
                        <span class="text-2xl font-semibold text-white">$@Model.Invoice.Amount.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="text-xs font-bold text-slate-400">Status</span>
                        <span class="px-3 py-1 @(Model.Invoice.Status == "PAID" ? "bg-emerald-500" : "bg-amber-500") text-white rounded-lg text-[9px] font-semibold uppercase tracking-widest">@Model.Invoice.Status</span>
                    </div>
                </div>
            </div>

            <div class="mt-8">
                <a href="@Url.Action("PrintInvoicePdf", "Billing", new { area = "Admin", id = Model.Invoice.Id })"
                   class="w-full flex items-center justify-center gap-3 px-6 py-4 bg-blue-600 text-white rounded-2xl text-[10px] font-semibold uppercase tracking-widest hover:bg-blue-700 transition-all shadow-xl">
                    <i class="fas fa-file-pdf"></i>
                    Export PDF with QR
                </a>
            </div>

            <div class="bento-card p-10 bg-white border border-slate-100">
                <h4 class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-6">Insurance Coverage</h4>
                @if(!string.IsNullOrEmpty(Model.Invoice.InsuranceProvider)) {
                    <div class="flex items-center gap-6 mb-8">
                        <div class="w-16 h-16 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600 text-2xl">
                            <i class="fas fa-shield-alt"></i>
                        </div>
                        <div>
                            <p class="text-lg font-semibold text-slate-900">@Model.Invoice.InsuranceProvider</p>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">@Model.Invoice.InsurancePolicyNumber</p>
                        </div>
                    </div>
                    <div class="p-4 rounded-xl bg-slate-50 border border-slate-100">
                        <p class="text-[10px] font-medium text-slate-500 leading-relaxed italic">Claim processor has verified the eligibility of this patient for the listed consultation.</p>
                    </div>
                } else {
                    <div class="flex items-center gap-6 mb-8 opacity-40">
                        <div class="w-16 h-16 rounded-2xl bg-slate-100 flex items-center justify-center text-slate-400 text-2xl">
                            <i class="fas fa-hand-holding-usd"></i>
                        </div>
                        <div>
                            <p class="text-lg font-semibold text-slate-900 uppercase">Self Pay</p>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">No Insurance Linked</p>
                        </div>
                    </div>
                }
            </div>
            <div class="bento-card p-10 bg-white border border-slate-100 relative">
                <h4 class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-6 px-1">Visit Timeline</h4>
                <div class="absolute left-8 top-20 bottom-10 w-px bg-slate-100"></div>
                <div class="space-y-8 relative">
                    @foreach(var appt in Model.RecentAppointments) {
                        <div class="flex gap-4 group relative z-10">
                            <div class="w-8 h-8 rounded-full bg-white border-4 border-slate-50 flex items-center justify-center shrink-0 group-hover:border-blue-100 transition-colors">
                                <div class="w-2 h-2 rounded-full bg-slate-300 group-hover:bg-blue-500 transition-colors"></div>
                            </div>
                            <div class="pt-1">
                                <p class="text-xs font-semibold text-slate-900 group-hover:text-blue-600 transition-colors mb-0.5">@appt.Reason</p>
                                <p class="text-[10px] font-bold text-slate-400">@appt.AppointmentTime.ToString("MMM dd") • @(appt.Physician?.Name ?? "General Staff")</p>
                            </div>
                        </div>
                    }
                    <div class="flex gap-4 group relative z-10 opacity-50">
                        <div class="w-8 h-8 rounded-full bg-white border-4 border-slate-50 flex items-center justify-center shrink-0">
                            <div class="w-2 h-2 rounded-full bg-slate-200"></div>
                        </div>
                        <div class="pt-1">
                            <p class="text-xs font-semibold text-slate-400">Initial Registration</p>
                            <p class="text-[10px] font-bold text-slate-300">System Entry</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    @@media print {
        .sidebar, .top-nav, button, a[href="/Billing"] { display: none !important; }
        .bento-card { border: 1px solid #e2e8f0 !important; box-shadow: none !important; }
        .pb-20 { padding-bottom: 0 !important; }
    }
</style>
