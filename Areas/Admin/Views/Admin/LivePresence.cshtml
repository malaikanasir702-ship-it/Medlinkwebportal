@{
    ViewData["Title"] = "Live Presence";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="p-6 max-w-[1600px] mx-auto space-y-6 animate-in fade-in duration-700">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 tracking-tight flex items-center gap-3">
                <span class="relative flex h-3 w-3">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                </span>
                Live Presence
            </h1>
            <p class="text-sm text-gray-400 font-medium mt-1">Real-time doctor & patient activity — auto-refreshes every 15 seconds</p>
        </div>
        <div class="flex items-center gap-3">
            <span id="lastUpdated" class="text-xs text-gray-400 font-medium"></span>
            <button onclick="loadPresence()" class="px-4 py-2 bg-slate-900 text-white rounded-xl text-xs font-bold uppercase tracking-widest hover:bg-blue-600 transition-all flex items-center gap-2">
                <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i> Refresh
            </button>
        </div>
    </div>

    <!-- Stats Cards -->
    <div id="statsCards" class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm text-center">
            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-1">Online Doctors</p>
            <p id="stat-online" class="text-2xl font-black text-emerald-600">—</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm text-center">
            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-1">In Consultation</p>
            <p id="stat-consulting" class="text-2xl font-black text-blue-600">—</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm text-center">
            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-1">Free Doctors</p>
            <p id="stat-free" class="text-2xl font-black text-indigo-600">—</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm text-center">
            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-1">Offline Doctors</p>
            <p id="stat-offline" class="text-2xl font-black text-gray-400">—</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm text-center">
            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-1">Active Patients</p>
            <p id="stat-patients" class="text-2xl font-black text-amber-600">—</p>
        </div>
        <div class="bg-white rounded-2xl p-4 border border-gray-100 shadow-sm text-center">
            <p class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-1">Patients In Session</p>
            <p id="stat-patients-consulting" class="text-2xl font-black text-rose-600">—</p>
        </div>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">

        <!-- Doctors Panel -->
        <div class="bg-white rounded-[2rem] border border-gray-100 shadow-sm overflow-hidden">
            <div class="p-6 border-b border-gray-50 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-blue-50 rounded-2xl flex items-center justify-center text-blue-600">
                        <i data-lucide="stethoscope" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-gray-900">Doctors</h3>
                        <p class="text-[10px] text-gray-400 font-medium uppercase tracking-widest">All doctors status</p>
                    </div>
                </div>
                <!-- Filter tabs -->
                <div class="flex gap-1 bg-gray-50 p-1 rounded-xl">
                    <button onclick="filterDoctors('all')" id="df-all" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest bg-white shadow text-blue-600 transition-all">All</button>
                    <button onclick="filterDoctors('online')" id="df-online" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-blue-600 transition-all">Online</button>
                    <button onclick="filterDoctors('consultation')" id="df-consultation" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-blue-600 transition-all">Busy</button>
                    <button onclick="filterDoctors('free')" id="df-free" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-blue-600 transition-all">Free</button>
                </div>
            </div>
            <div id="doctorsList" class="divide-y divide-gray-50 max-h-[520px] overflow-y-auto">
                <div class="p-8 text-center text-gray-400 text-sm">Loading...</div>
            </div>
        </div>

        <!-- Patients Panel -->
        <div class="bg-white rounded-[2rem] border border-gray-100 shadow-sm overflow-hidden">
            <div class="p-6 border-b border-gray-50 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-amber-50 rounded-2xl flex items-center justify-center text-amber-600">
                        <i data-lucide="users" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-bold text-gray-900">Active Patients</h3>
                        <p class="text-[10px] text-gray-400 font-medium uppercase tracking-widest">Last 15 minutes activity</p>
                    </div>
                </div>
                <div class="flex gap-1 bg-gray-50 p-1 rounded-xl">
                    <button onclick="filterPatients('all')" id="pf-all" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest bg-white shadow text-amber-600 transition-all">All</button>
                    <button onclick="filterPatients('consultation')" id="pf-consultation" class="px-3 py-1.5 rounded-lg text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-amber-600 transition-all">In Session</button>
                </div>
            </div>
            <div id="patientsList" class="divide-y divide-gray-50 max-h-[520px] overflow-y-auto">
                <div class="p-8 text-center text-gray-400 text-sm">Loading...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    lucide.createIcons();

    let allDoctors = [];
    let allPatients = [];
    let doctorFilter = 'all';
    let patientFilter = 'all';

    async function loadPresence() {
        try {
            const res = await fetch('/Admin/Admin/GetLivePresenceData');
            const data = await res.json();

            allDoctors = data.doctors;
            allPatients = data.patients;

            // Stats
            document.getElementById('stat-online').textContent = data.stats.totalOnlineDoctors;
            document.getElementById('stat-consulting').textContent = data.stats.inConsultationDoctors;
            document.getElementById('stat-free').textContent = data.stats.freeDoctors;
            document.getElementById('stat-offline').textContent = data.stats.offlineDoctors;
            document.getElementById('stat-patients').textContent = data.stats.activePatients;
            document.getElementById('stat-patients-consulting').textContent = data.stats.patientsInConsultation;

            renderDoctors();
            renderPatients();

            document.getElementById('lastUpdated').textContent = 
                'Updated: ' + new Date().toLocaleTimeString();
        } catch (e) {
            console.error('Failed to load presence:', e);
        }
    }

    function filterDoctors(f) {
        doctorFilter = f;
        ['all', 'online', 'consultation', 'free'].forEach(tab => {
            const el = document.getElementById('df-' + tab);
            if (tab === f) {
                el.classList.add('bg-white', 'shadow', 'text-blue-600');
                el.classList.remove('text-gray-400');
            } else {
                el.classList.remove('bg-white', 'shadow', 'text-blue-600');
                el.classList.add('text-gray-400');
            }
        });
        renderDoctors();
    }

    function filterPatients(f) {
        patientFilter = f;
        ['all', 'consultation'].forEach(tab => {
            const el = document.getElementById('pf-' + tab);
            if (tab === f) {
                el.classList.add('bg-white', 'shadow', 'text-amber-600');
                el.classList.remove('text-gray-400');
            } else {
                el.classList.remove('bg-white', 'shadow', 'text-amber-600');
                el.classList.add('text-gray-400');
            }
        });
        renderPatients();
    }

    function renderDoctors() {
        let docs = allDoctors;
        if (doctorFilter === 'online') docs = docs.filter(d => d.isOnline && !d.isInConsultation);
        else if (doctorFilter === 'consultation') docs = docs.filter(d => d.isInConsultation);
        else if (doctorFilter === 'free') docs = docs.filter(d => d.isOnline && !d.isInConsultation);

        const container = document.getElementById('doctorsList');

        if (docs.length === 0) {
            container.innerHTML = '<div class="p-8 text-center text-gray-400 text-sm">No doctors in this category</div>';
            return;
        }

        container.innerHTML = docs.map(d => {
            const statusConfig = {
                'In Consultation': { dot: 'bg-blue-500 animate-pulse', badge: 'bg-blue-50 text-blue-700 border-blue-200', icon: '🎧' },
                'Online (Portal)': { dot: 'bg-emerald-500', badge: 'bg-emerald-50 text-emerald-700 border-emerald-200', icon: '💻' },
                'Online (App)': { dot: 'bg-emerald-400', badge: 'bg-emerald-50 text-emerald-700 border-emerald-200', icon: '📱' },
                'Offline': { dot: 'bg-gray-300', badge: 'bg-gray-50 text-gray-500 border-gray-200', icon: '💤' },
            };
            const cfg = statusConfig[d.status] || statusConfig['Offline'];

            return `
            <div class="flex items-center gap-4 p-4 hover:bg-gray-50/50 transition-all group">
                <div class="relative flex-shrink-0">
                    <img src="${d.image || 'https://ui-avatars.com/api/?name=' + encodeURIComponent(d.name) + '&background=e2e8f0&color=64748b'}"
                         class="w-12 h-12 rounded-2xl object-cover border-2 border-white shadow" 
                         onerror="this.src='https://ui-avatars.com/api/?name=${encodeURIComponent(d.name)}&background=e2e8f0&color=64748b'" />
                    <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 rounded-full ${cfg.dot} border-2 border-white"></span>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-bold text-gray-900 truncate">${d.name}</p>
                    <p class="text-[10px] text-gray-400 font-medium uppercase tracking-wider truncate">${d.specialty}</p>
                </div>
                <div class="flex flex-col items-end gap-1.5">
                    <span class="px-2 py-1 rounded-lg text-[9px] font-bold uppercase tracking-widest border ${cfg.badge} flex items-center gap-1">
                        <span>${cfg.icon}</span> ${d.status}
                    </span>
                    <span class="text-[9px] text-gray-400 font-medium">${d.completedToday}/${d.todayAppointments} today</span>
                </div>
            </div>`;
        }).join('');
        lucide.createIcons();
    }

    function renderPatients() {
        let patients = allPatients;
        if (patientFilter === 'consultation') patients = patients.filter(p => p.inConsultation);

        const container = document.getElementById('patientsList');

        if (patients.length === 0) {
            container.innerHTML = '<div class="p-8 text-center text-gray-400 text-sm">No active patients right now</div>';
            return;
        }

        container.innerHTML = patients.map(p => {
            const cfg = p.inConsultation
                ? { dot: 'bg-blue-500 animate-pulse', badge: 'bg-blue-50 text-blue-700 border-blue-200' }
                : p.statusClass === 'online'
                    ? { dot: 'bg-amber-400', badge: 'bg-amber-50 text-amber-700 border-amber-200' }
                    : { dot: 'bg-yellow-300', badge: 'bg-yellow-50 text-yellow-700 border-yellow-200' };

            const initials = (p.name || 'P').split(' ').map(n => n[0]).join('').toUpperCase().slice(0,2);

            return `
            <div class="flex items-center gap-4 p-4 hover:bg-gray-50/50 transition-all">
                <div class="relative flex-shrink-0">
                    ${p.image
                        ? `<img src="${p.image}" class="w-11 h-11 rounded-2xl object-cover border-2 border-white shadow" />`
                        : `<div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-white font-black text-sm shadow">${initials}</div>`
                    }
                    <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full ${cfg.dot} border-2 border-white"></span>
                </div>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-bold text-gray-900 truncate">${p.name}</p>
                    <p class="text-[10px] text-gray-400 font-medium truncate">📱 ${p.deviceName}</p>
                </div>
                <div class="flex flex-col items-end gap-1">
                    <span class="px-2 py-1 rounded-lg text-[9px] font-bold uppercase tracking-widest border ${cfg.badge}">
                        ${p.status}
                    </span>
                </div>
            </div>`;
        }).join('');
    }

    // Load on init
    loadPresence();

    // Auto-refresh every 15 seconds
    setInterval(loadPresence, 15000);
</script>
}
