                                <div class="w-12 h-12 bg-white text-indigo-600 rounded-2xl flex items-center justify-center group-hover:bg-indigo-600 group-hover:text-white transition-all shadow-sm">
                                    <i data-lucide="smartphone-nfc" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <h5 class="text-sm font-bold text-gray-900">Push Notifications</h5>
                                    <p class="text-[11px] text-gray-500 font-medium">Real-time alerts on your mobile devices.</p>
                                </div>
                            </div>
                            <label class="relative inline-flex items-center cursor-pointer">
                                <input type="checkbox" id="notifPush" class="sr-only peer" @(Model.PushNotificationsEnabled ? "checked" : "") onchange="saveGenericSettings()">
                                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-5 peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600"></div>
                            </label>
                        </div>
                        <div class="mt-4 flex flex-wrap items-center justify-between gap-4">
                            <div id="subscriptionStatus" class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">Checking Status...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Billing Tab -->
        <div x-show="activeTab === 'billing'" class="animate-fade-in space-y-6">
            <div class="bg-white rounded-[1.5rem] p-8 border border-gray-100 shadow-sm">
                <div class="flex items-center justify-between mb-8">
                    <h3 class="text-xl font-semibold text-gray-900">Billing History</h3>
                    <button class="px-4 py-2 bg-amber-50 text-amber-600 rounded-xl text-[10px] font-semibold uppercase tracking-widest border border-amber-100">Add Method</button>
                </div>
                <div class="space-y-3">
                    @foreach(var inv in Model.BillingHistory) {
                        <div class="flex items-center justify-between p-5 bg-gray-50/30 rounded-2xl border border-gray-100 group hover:bg-white hover:border-amber-200 transition-all">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center text-amber-500 shadow-sm group-hover:scale-105 transition-transform">
                                    <i data-lucide="file-check" class="w-5 h-5"></i>
                                </div>
                                <div>
                                    <h6 class="text-sm font-bold text-gray-900">@inv.Id</h6>
                                    <p class="text-[10px] text-gray-500 font-bold uppercase tracking-widest mt-0.5">@inv.Date</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-6">
                                <span class="text-sm font-semibold text-gray-900">@inv.Amount</span>
                                <span class="px-3 py-1 bg-emerald-100 text-emerald-700 text-[9px] font-semibold rounded-lg uppercase tracking-widest">Paid</span>
                                <a href="@Url.Action("DownloadInvoice", "Dashboard", new { id = inv.AppointmentId })" target="_blank" class="w-9 h-9 rounded-xl hover:bg-gray-100 flex items-center justify-center text-gray-400 hover:text-gray-900 transition-colors">
                                    <i data-lucide="download" class="w-4 h-4"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Devices Tab -->
        <div x-show="activeTab === 'devices'" class="animate-fade-in space-y-6">
            <div class="bg-white rounded-[1.5rem] p-8 border border-gray-100 shadow-sm">
                <h3 class="text-xl font-semibold text-gray-900 mb-2">Active Sessions</h3>
                <p class="text-gray-500 text-xs font-medium mb-8">Real-time tracking of devices logged into your account.</p>

                <div class="space-y-5">
                    @foreach(var dev in Model.RecentDevices) {
                        bool isCurrent = dev.Location == "Current Device";
                        string icon = "monitor";
                        if(dev.DeviceName.Contains("iPhone") || dev.DeviceName.Contains("Android")) icon = "smartphone";
                        if(dev.DeviceName.Contains("MacBook") || dev.DeviceName.Contains("Mac")) icon = "laptop";

                        <div class="flex items-center justify-between p-6 rounded-3xl border @(isCurrent ? "border-indigo-100 bg-indigo-50/40" : "border-gray-50 bg-gray-50/50") group transition-all hover:bg-white hover:shadow-md">
                             <div class="flex items-center gap-6">
                                <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-gray-900 shadow-sm group-hover:scale-110 transition-transform">
                                    <i data-lucide="@icon" class="w-6 h-6"></i>
                                </div>
                                <div>
                                    <div class="flex items-center gap-3 mb-1">
                                        <h5 class="text-base font-bold text-gray-900">@dev.DeviceName</h5>
                                        @if(isCurrent) {
                                            <span class="px-2 py-0.5 bg-indigo-600 text-[8px] text-white font-semibold rounded-md uppercase tracking-widest whitespace-nowrap shadow-sm">Active Now</span>
                                        }
                                    </div>
                                    <div class="flex items-center gap-2 text-[11px] text-gray-500 font-medium">
                                        <span>@dev.IPAddress</span>
                                        <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
                                        <span class="text-indigo-500">Last active: @dev.LastSeen.ToString("MMM dd, HH:mm")</span>
                                    </div>
                                </div>
                             </div>
                             @if(!isCurrent) {
                                <button x-on:click="startSessionRevoke('@dev.Id', '@dev.DeviceName')" class="px-5 py-2.5 bg-white border border-rose-100 text-rose-600 text-[10px] font-semibold uppercase tracking-widest rounded-xl hover:bg-rose-600 hover:text-white hover:border-rose-600 transition-all shadow-sm">Sign Out</button>
                             }
                        </div>
                    }
                </div>

                <div class="mt-12 p-8 bg-rose-50 rounded-[2rem] border border-rose-100 flex flex-col md:flex-row items-center justify-between gap-6">
                    <div class="text-center md:text-left">
                        <h4 class="text-rose-900 text-base font-semibold">Security Protocol</h4>
                        <p class="text-xs text-rose-600 font-bold mt-1 uppercase tracking-tight">Remote sign-out requires email confirmation for your protection.</p>
                    </div>
                    <button x-on:click="startSessionRevoke('all', 'All Other Devices')" class="px-8 py-3.5 bg-rose-600 text-white rounded-2xl text-xs font-semibold shadow-xl shadow-rose-200 hover:bg-rose-700 hover:scale-[1.02] active:scale-95 transition-all uppercase tracking-widest">Sign Out All Others</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 2FA Verification Modal -->
    <div x-show="show2FAModal" x-cloak class="fixed inset-0 z-[100] flex items-center justify-center p-6 bg-black/60 backdrop-blur-md animate-in fade-in duration-300">
        <div class="bg-white rounded-[2.5rem] p-10 max-w-md w-full shadow-2xl relative overflow-hidden transform transition-all scale-100">
            <div class="absolute top-0 left-0 w-full h-3 bg-rose-600"></div>
            
            <button x-on:click="show2FAModal = false" class="absolute top-6 right-6 w-10 h-10 rounded-full bg-gray-50 flex items-center justify-center text-gray-400 hover:bg-gray-100 transition-all">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <div class="text-center mb-10">
                <div class="w-20 h-20 bg-rose-50 text-rose-600 rounded-3xl flex items-center justify-center mx-auto mb-6 shadow-sm">
                    <i data-lucide="mail-warning" class="w-10 h-10"></i>
                </div>
                <h3 class="text-2xl font-semibold text-gray-900 mb-3">Security Verification</h3>
                <p class="text-sm text-gray-500 font-medium leading-relaxed">Enter the 6-digit code sent to your email to authorize sign-out of <span class="font-bold text-gray-900 italic" x-text="targetSessionName"></span>.</p>
            </div>

            <div class="space-y-6">
                <div class="relative">
                    <input type="text" x-model="verificationCode" maxlength="6" placeholder="000 000" class="w-full px-6 py-5 bg-gray-50 border-2 border-gray-100 rounded-3xl text-center text-3xl font-semibold tracking-[0.4em] text-gray-900 focus:outline-none focus:border-rose-600 transition-all placeholder:text-gray-200 shadow-inner">
                </div>
                
                <p x-show="error2FA" x-text="error2FA" class="text-xs text-rose-600 font-semibold text-center animate-pulse">Invalid code</p>

                <div class="flex gap-4 pt-6">
                    <button x-on:click="show2FAModal = false" class="flex-1 py-4.5 rounded-2xl text-sm font-bold text-gray-500 hover:bg-gray-50 transition-all">Cancel</button>
                    <button x-on:click="confirmRevoke()" class="flex-[2] py-4.5 bg-gray-900 text-white rounded-2xl font-semibold text-sm hover:bg-black transition-all shadow-2xl shadow-gray-300 uppercase tracking-widest">Verify & Terminate</button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    [x-cloak] { display: none !important; }
    input[type="date"]::-webkit-calendar-picker-indicator {
        opacity: 0.5;
        cursor: pointer;
    }
    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in {
        animation: fadeIn 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    /* Custom Scrollbar for the sidebar sticky */
    .sticky::-webkit-scrollbar { width: 4px; }
    .sticky::-webkit-scrollbar-thumb { background: #E2E8F0; border-radius: 10px; }
</style>
