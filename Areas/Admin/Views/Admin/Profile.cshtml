@model MedLinkPortal.Areas.Admin.Models.AdminProfile
@{
    ViewData["Title"] = "User Profile";
}
<style>
    .image-upload-wrapper:hover .upload-overlay { opacity: 1; }
    .upload-overlay { opacity: 0; transition: all 0.3s ease; }
</style>
<div class="skeleton-container space-y-12 pb-20">
</div>
<div class="main-content-actual content-hidden space-y-12 pb-20">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-10 py-6">
        <div class="animate-in fade-in slide-in-from-left-8 duration-1000">
            <div class="flex items-center gap-3 mb-4">
                <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.4em]">Personal Identity: Secured</span>
            </div>
            <h1 class="text-4xl md:text-6xl lg:text-7xl font-semibold text-slate-900 tracking-tighter mb-4">
                User <span class="text-blue-600">Profile</span>
            </h1>
            <p class="text-slate-500 text-lg md:text-xl max-w-2xl leading-relaxed font-medium">
                Manage your professional credentials and system presence.
            </p>
        </div>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-10 items-start">
        <div class="xl:col-span-4 space-y-8 animate-in fade-in slide-in-from-bottom-8 duration-1000 stagger-1">
            <div class="bento-card p-10 text-center relative overflow-hidden group">
                <div class="absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-blue-600 to-cyan-400"></div>
                <div class="relative inline-block mb-4 group cursor-pointer image-upload-wrapper" onclick="$('#imageInput').click()">
                    <div id="imagePreview" class="w-32 h-32 rounded-[40px] bg-slate-900 flex items-center justify-center text-white text-5xl shadow-2xl shadow-slate-900/40 relative z-10 group-hover:scale-105 transition-transform duration-700 overflow-hidden border-4 border-white">
                        @if (!string.IsNullOrEmpty(Model.ProfileImage)) {
                            <img src="@Model.ProfileImage" class="w-full h-full object-cover" />
                        } else {
                            <i class="fas fa-user"></i>
                        }
                    </div>
                    <div class="upload-overlay absolute inset-0 z-20 bg-black/40 rounded-[40px] flex items-center justify-center text-white text-xl">
                        <i class="fas fa-camera"></i>
                    </div>
                    <div class="absolute inset-0 bg-blue-500 blur-2xl opacity-10 group-hover:opacity-30 transition-opacity duration-700"></div>
                </div>
                <div class="mb-8">
                    <button type="button" onclick="$('#imageInput').click()" class="text-[10px] font-semibold text-blue-600 uppercase tracking-widest hover:text-blue-700 transition-colors">
                        <i class="fas fa-sync-alt mr-1"></i> Change Photo
                    </button>
                    <input type="file" id="imageInput" class="hidden" accept="image/*" />
                </div>
                <h2 class="text-2xl font-semibold text-slate-900 tracking-tight mb-2">@Model.Name</h2>
                <p class="text-xs font-semibold text-blue-500 uppercase tracking-widest mb-8">@Model.Specialty</p>
                <div class="space-y-4 text-left border-t border-slate-100 pt-8">
                    <div class="flex items-center gap-4 text-slate-500 hover:text-slate-900 transition-colors">
                        <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center border border-slate-100">
                            <i class="fas fa-envelope text-sm"></i>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-[9px] font-semibold uppercase tracking-widest text-slate-400 leading-none mb-1">Email Node</p>
                            <p class="text-sm font-bold truncate">@Model.Email</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 text-slate-500 hover:text-slate-900 transition-colors">
                        <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center border border-slate-100">
                            <i class="fas fa-phone text-sm"></i>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-[9px] font-semibold uppercase tracking-widest text-slate-400 leading-none mb-1">Secure Line</p>
                            <p class="text-sm font-bold truncate">@(string.IsNullOrEmpty(Model.Phone) ? "Not Set" : Model.Phone)</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4 text-slate-500 hover:text-slate-900 transition-colors">
                        <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center border border-slate-100">
                            <i class="fas fa-map-marker-alt text-sm"></i>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-[9px] font-semibold uppercase tracking-widest text-slate-400 leading-none mb-1">Office Location</p>
                            <p class="text-sm font-bold truncate">@(string.IsNullOrEmpty(Model.Office) ? "Not Set" : Model.Office)</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-blue-950 rounded-[40px] p-10 text-white relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-12 opacity-[0.05] group-hover:scale-150 transition-transform duration-1000 rotate-12">
                    <i class="fas fa-fingerprint text-[180px]"></i>
                </div>
                <div class="relative z-10">
                    <h4 class="text-xl font-semibold mb-4 tracking-tight">Security Level</h4>
                    <p class="text-slate-400 text-sm font-medium leading-relaxed mb-6">Administrator access granted. All modifications are logged protocol-grade.</p>
                    <div class="flex items-center gap-3">
                        <div class="px-4 py-2 bg-emerald-500/20 text-emerald-400 text-[10px] font-semibold tracking-widest uppercase rounded-xl border border-emerald-500/20">Verified</div>
                        <div class="px-4 py-2 bg-blue-500/20 text-blue-400 text-[10px] font-semibold tracking-widest uppercase rounded-xl border border-blue-500/20">Root</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="xl:col-span-8 animate-in fade-in slide-in-from-bottom-8 duration-1000 stagger-2">
            <div class="bento-card p-8 md:p-12">
                <div class="flex items-center justify-between mb-12">
                    <div>
                        <h3 class="text-2xl font-semibold text-slate-900 tracking-tight">Professional Credentials</h3>
                        <p class="text-slate-500 text-sm font-bold mt-1">Update your profile information and identity</p>
                    </div>
                    <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600 shadow-sm border border-blue-100">
                        <i class="fas fa-edit text-lg"></i>
                    </div>
                </div>
                <form id="profileForm" class="space-y-10">
                    <input type="hidden" id="profileId" value="@Model.Id" />
                    <input type="hidden" id="profileImageBase64" value="@Model.ProfileImage" />
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-3">
                            <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] ml-2">Full Name</label>
                            <input type="text" id="profileName" value="@Model.Name" class="w-full px-6 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-sm font-bold focus:outline-none focus:ring-4 focus:ring-blue-500/5 focus:border-blue-500/20 transition-all" />
                        </div>
                        <div class="space-y-3">
                            <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] ml-2">Position / Specialty</label>
                            <input type="text" id="profileSpecialty" value="@Model.Specialty" class="w-full px-6 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-sm font-bold focus:outline-none focus:ring-4 focus:ring-blue-500/5 focus:border-blue-500/20 transition-all" />
                        </div>
                        <div class="space-y-3">
                            <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] ml-2">Email Node</label>
                            <input type="email" id="profileEmail" value="@Model.Email" class="w-full px-6 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-sm font-bold focus:outline-none focus:ring-4 focus:ring-blue-500/5 focus:border-blue-500/20 transition-all" />
                        </div>
                        <div class="space-y-3">
                            <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] ml-2">Secure Line (Phone)</label>
                            <input type="text" id="profilePhone" value="@Model.Phone" class="w-full px-6 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-sm font-bold focus:outline-none focus:ring-4 focus:ring-blue-500/5 focus:border-blue-500/20 transition-all" />
                        </div>
                        <div class="md:col-span-2 space-y-3">
                            <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] ml-2">Office Location</label>
                            <input type="text" id="profileOffice" value="@Model.Office" class="w-full px-6 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-sm font-bold focus:outline-none focus:ring-4 focus:ring-blue-500/5 focus:border-blue-500/20 transition-all" />
                        </div>
                        <div class="md:col-span-2 space-y-3">
                            <label class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] ml-2">Professional Summary (Bio)</label>
                            <textarea id="profileBio" rows="6" class="w-full px-6 py-4 bg-slate-50 border border-slate-100 rounded-3xl text-sm font-bold focus:outline-none focus:ring-4 focus:ring-blue-500/5 focus:border-blue-500/20 transition-all resize-none">@Model.Bio</textarea>
                        </div>
                    </div>
                    <div class="pt-8 flex justify-end">
                        <button type="submit" class="px-10 py-5 bg-[#0F172A] text-white text-xs font-semibold rounded-2xl hover:shadow-[0_20px_40px_-10px_rgba(15,23,42,0.3)] hover:scale-[1.02] transition-all active:scale-95 uppercase tracking-widest flex items-center gap-3">
                            <i class="fas fa-check-circle"></i> Save Profile Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function() {
            // Image Preview & Base64 Conversion
            $('#imageInput').on('change', function() {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        $('#imagePreview').html(`<img src="${e.target.result}" class="w-full h-full object-cover" />`);
                        $('#profileImageBase64').val(e.target.result);
                    }
                    reader.readAsDataURL(file);
                }
            });
            $('#profileForm').on('submit', function(e) {
                e.preventDefault();
                const profile = {
                    id: parseInt($('#profileId').val()),
                    name: $('#profileName').val(),
                    email: $('#profileEmail').val(),
                    phone: $('#profilePhone').val(),
                    office: $('#profileOffice').val(),
                    bio: $('#profileBio').val(),
                    specialty: $('#profileSpecialty').val(),
                    profileImage: $('#profileImageBase64').val()
                };
                const $btn = $(this).find('button[type="submit"]');
                const originalText = $btn.html();
                $btn.html('<i class="fas fa-spinner fa-spin"></i> Saving Changes...').prop('disabled', true);
                $.ajax({
                    url: '/Admin/UpdateProfile',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(profile),
                    success: function() {
                        setTimeout(() => {
                            $btn.html('<i class="fas fa-check"></i> Changes Saved!').addClass('bg-emerald-600');
                            setTimeout(() => {
                                location.reload();
                            }, 1000);
                        }, 800);
                    },
                    error: function() {
                        alert('Failed to save changes. Please try again.');
                        $btn.html(originalText).prop('disabled', false);
                    }
                });
            });
        });
    </script>
}
