@model MedLinkPortal.Areas.Admin.Models.AdminProfile
<div class="space-y-12 pb-20">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-10 py-6">
        <div class="animate-in fade-in slide-in-from-left-8 duration-1000">
            <h1 class="text-6xl md:text-7xl font-semibold text-slate-900 tracking-tighter mb-4">
                Control <span class="text-blue-600">Center</span>
            </h1>
            <p class="text-slate-500 text-xl font-medium leading-relaxed max-w-2xl">
                Unified system configuration, security protocols, and live clinical node diagnostics.
            </p>
        </div>
    </div>
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-10">
        <div class="xl:col-span-3">
            <div class="bento-card p-6 space-y-2 sticky top-24">
                <button class="settings-nav-btn active w-full flex items-center gap-4 px-6 py-4 rounded-2xl bg-blue-600 text-white shadow-lg shadow-blue-500/20 text-sm font-bold transition-all" data-target="security-section">
                    <i class="fas fa-shield-alt"></i> Security
                </button>
                <button class="settings-nav-btn w-full flex items-center gap-4 px-6 py-4 rounded-2xl text-slate-400 hover:bg-slate-50 hover:text-slate-900 text-sm font-bold transition-all" data-target="diagnostics-section">
                    <i class="fas fa-clipboard-list"></i> System Logs
                </button>
                <button class="settings-nav-btn w-full flex items-center gap-4 px-6 py-4 rounded-2xl text-slate-400 hover:bg-slate-50 hover:text-slate-900 text-sm font-bold transition-all" data-target="interface-section">
                    <i class="fas fa-palette"></i> Interface
                </button>
                <button class="settings-nav-btn w-full flex items-center gap-4 px-6 py-4 rounded-2xl text-slate-400 hover:bg-slate-50 hover:text-slate-900 text-sm font-bold transition-all" data-target="notification-section">
                    <i class="fas fa-bell"></i> Notifications
                </button>
            </div>
        </div>
        <div class="xl:col-span-9 space-y-10">
            <section id="security-section" class="settings-section bento-card p-10 md:p-12 animate-in fade-in slide-in-from-bottom-4 duration-500">
                <div class="flex items-center gap-6 mb-10 pb-10 border-b border-slate-50">
                    <div class="w-24 h-24 rounded-3xl bg-red-50 text-red-500 border-8 border-white shadow-2xl flex items-center justify-center text-4xl">
                        <i class="fas fa-lock"></i>
                    </div>
                    <div>
                        <h3 class="text-2xl font-semibold text-slate-900">Security <span class="text-red-500">Vault</span></h3>
                        <p class="text-slate-400 font-bold text-xs uppercase tracking-widest mt-1">Credential & Access Control</p>
                    </div>
                </div>
                <div class="space-y-12">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                        <div class="space-y-6">
                            <h4 class="text-sm font-semibold text-slate-900 uppercase tracking-widest">Update Password</h4>
                            <div class="space-y-4">
                                <input type="password" placeholder="Current Password" class="w-full px-6 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-sm font-bold" />
                                <input type="password" placeholder="New Password" class="w-full px-6 py-4 bg-slate-50 border border-slate-100 rounded-2xl text-sm font-bold" />
                                <button class="w-full py-5 bg-blue-600 text-white rounded-2xl text-[10px] font-semibold uppercase tracking-widest shadow-lg shadow-blue-500/20 active:scale-95 transition-all">Rotate Credentials</button>
                            </div>
                        </div>
                        <div class="space-y-6">
                            <h4 class="text-sm font-semibold text-slate-900 uppercase tracking-widest">Two-Factor Auth</h4>
                            <div class="p-6 bg-slate-50 rounded-3xl border border-slate-100 space-y-4">
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-bold text-slate-700">Authenticator App</span>
                                    <div class="w-12 h-6 bg-emerald-500 rounded-full relative p-1 cursor-pointer">
                                        <div class="w-4 h-4 bg-white rounded-full ml-auto"></div>
                                    </div>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-sm font-bold text-slate-700">SMS Verification</span>
                                    <div class="w-12 h-6 bg-slate-200 rounded-full relative p-1 cursor-pointer">
                                        <div class="w-4 h-4 bg-white rounded-full"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="space-y-6">
                            <h4 class="text-sm font-semibold text-slate-900 uppercase tracking-widest">Team Management</h4>
                            <div class="p-6 bg-blue-50 rounded-3xl border border-blue-100 flex items-center justify-between">
                                <div>
                                    <p class="text-sm font-bold text-slate-900">Add Administrator</p>
                                    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mt-1">Grant System Access</p>
                                </div>
                                <a href="@Url.Action("Create", "Admin")" class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white hover:bg-blue-700 transition-colors shadow-lg shadow-blue-500/30">
                                    <i class="fas fa-plus"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="space-y-6">
                        <h4 class="text-sm font-semibold text-slate-900 uppercase tracking-widest">Login History</h4>
                        <div class="overflow-x-auto">
                            <table class="w-full border-collapse">
                                <tbody class="divide-y divide-slate-50">
                                    <tr class="group">
                                        <td class="py-6 flex items-center gap-4">
                                            <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-400"><i class="fas fa-desktop"></i></div>
                                            <div>
                                                <p class="text-sm font-semibold text-slate-900">Chrome on Windows</p>
                                                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Islamabad, PK • IP: 182.168.1.45</p>
                                            </div>
                                        </td>
                                        <td class="py-6 text-right">
                                            <span class="text-[10px] font-semibold text-emerald-500 uppercase tracking-widest">Active Now</span>
                                        </td>
                                    </tr>
                                    <tr class="group">
                                        <td class="py-6 flex items-center gap-4 text-slate-400">
                                            <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center"><i class="fas fa-mobile-alt"></i></div>
                                            <div>
                                                <p class="text-sm font-bold">iPhone 15 Pro</p>
                                                <p class="text-[10px] font-bold uppercase tracking-widest">Safari • 3 hours ago</p>
                                            </div>
                                        </td>
                                        <td class="py-6 text-right">
                                            <button class="text-[10px] font-semibold text-red-500 uppercase tracking-widest hover:underline">Revoke</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </section>
            <section id="diagnostics-section" class="settings-section bento-card p-10 md:p-12 animate-in fade-in slide-in-from-bottom-4 duration-500 hidden">
                <div class="flex items-center gap-6 mb-10 pb-10 border-b border-slate-50">
                    <div class="w-24 h-24 rounded-3xl bg-blue-50 text-blue-600 border-8 border-white shadow-2xl flex items-center justify-center text-4xl">
                        <i class="fas fa-clipboard-list"></i>
                    </div>
                    <div>
                        <h3 class="text-2xl font-semibold text-slate-900">System <span class="text-blue-600">Audit Logs</span></h3>
                        <p class="text-slate-400 font-bold text-xs uppercase tracking-widest mt-1">Track Admin Activity & Access</p>
                    </div>
                </div>
                <div class="space-y-6">
                    <div class="overflow-x-auto">
                        <table class="w-full border-collapse text-left">
                            <thead>
                                <tr class="border-b border-slate-100 text-[10px] font-semibold text-slate-400 uppercase tracking-widest">
                                    <th class="py-4">Event</th>
                                    <th class="py-4">User</th>
                                    <th class="py-4">Time</th>
                                    <th class="py-4 text-right">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                <tr class="group">
                                    <td class="py-4 text-sm font-bold text-slate-900">Patient Record Access</td>
                                    <td class="py-4 text-xs font-medium text-slate-500">Dr. Sarah Miller</td>
                                    <td class="py-4 text-xs font-mono text-slate-400">10:42 AM</td>
                                    <td class="py-4 text-right"><span class="px-2 py-1 bg-emerald-50 text-emerald-600 rounded text-[9px] font-semibold uppercase">Authorized</span></td>
                                </tr>
                                <tr class="group">
                                    <td class="py-4 text-sm font-bold text-slate-900">Billing Generation</td>
                                    <td class="py-4 text-xs font-medium text-slate-500">Admin (You)</td>
                                    <td class="py-4 text-xs font-mono text-slate-400">09:15 AM</td>
                                    <td class="py-4 text-right"><span class="px-2 py-1 bg-blue-50 text-blue-600 rounded text-[9px] font-semibold uppercase">Success</span></td>
                                </tr>
                                <tr class="group">
                                    <td class="py-4 text-sm font-bold text-slate-900">Login Attempt (Failed)</td>
                                    <td class="py-4 text-xs font-medium text-slate-500">Unknown IP</td>
                                    <td class="py-4 text-xs font-mono text-slate-400">Yesterday</td>
                                    <td class="py-4 text-right"><span class="px-2 py-1 bg-red-50 text-red-600 rounded text-[9px] font-semibold uppercase">Blocked</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>
            <section id="interface-section" class="settings-section bento-card p-10 md:p-12 animate-in fade-in slide-in-from-bottom-4 duration-500 hidden text-center py-24">
                 <div class="w-32 h-32 bg-blue-50 text-blue-500 rounded-full flex items-center justify-center mx-auto mb-8 text-5xl">
                     <i class="fas fa-magic"></i>
                 </div>
                  <h3 class="text-3xl font-semibold text-slate-900 mb-4">Interface <span class="text-blue-600">Dynamics</span></h3>
                  <p class="text-slate-500 font-medium max-w-sm mx-auto mb-10">Customize your workspace visual experience.</p>
                  <div class="grid grid-cols-3 gap-6 max-w-lg mx-auto">
                      <button id="btn-theme-light" class="group p-4 rounded-3xl border-2 border-slate-900 bg-white hover:scale-105 transition-transform">
                          <div class="h-20 bg-slate-100 rounded-2xl mb-3 border border-slate-100"></div>
                          <p class="text-[10px] font-semibold uppercase tracking-widest">Light</p>
                      </button>
                      <button id="btn-theme-dark" class="group p-4 rounded-3xl border border-slate-200 bg-slate-900 hover:border-blue-500 hover:scale-105 transition-all">
                          <div class="h-20 bg-slate-800 rounded-2xl mb-3 border border-slate-700"></div>
                          <p class="text-[10px] font-semibold text-white uppercase tracking-widest">Dark</p>
                      </button>
                      <button id="btn-theme-blue" class="group p-4 rounded-3xl border border-slate-200 bg-white hover:border-blue-500 hover:scale-105 transition-all">
                          <div class="h-20 bg-blue-50 rounded-2xl mb-3 border border-blue-100"></div>
                          <p class="text-[10px] font-semibold text-blue-600 uppercase tracking-widest">Medical Blue</p>
                      </button>
                  </div>
            </section>
            <section id="notification-section" class="settings-section bento-card p-10 md:p-12 animate-in fade-in slide-in-from-bottom-4 duration-500 hidden">
                 <h3 class="text-2xl font-semibold text-slate-900 mb-10">Notification <span class="text-blue-600">Logic</span></h3>
                 <div class="space-y-6">
                     <div class="flex items-center justify-between p-8 bg-slate-50 rounded-3xl border border-slate-100">
                         <div class="flex items-center gap-6">
                             <div class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center text-blue-500 shadow-sm"><i class="fas fa-envelope-open-text text-xl"></i></div>
                             <div>
                                 <p class="text-base font-semibold text-slate-900">Email Alerts</p>
                                 <p class="text-sm font-medium text-slate-500">Critical updates sent to your primary mail.</p>
                             </div>
                         </div>
                          <div class="w-14 h-8 bg-blue-600 rounded-full relative p-1 cursor-pointer transition-colors hover:bg-blue-700">
                             <div class="w-6 h-6 bg-white rounded-full ml-auto shadow-md transition-transform"></div>
                         </div>
                     </div>
                 </div>
            </section>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function() {
            $('.settings-nav-btn').on('click', function() {
                const target = $(this).data('target');
                $('.settings-nav-btn').removeClass('active bg-blue-600 text-white shadow-lg shadow-blue-500/20')
                                     .addClass('text-slate-400 hover:bg-slate-50 hover:text-slate-900');
                $(this).addClass('active bg-blue-600 text-white shadow-lg shadow-blue-500/20')
                       .removeClass('text-slate-400 hover:bg-slate-50 hover:text-slate-900');
                $('.settings-section').addClass('hidden');
                $('#' + target).removeClass('hidden');
            });
            // Theme Switching Logic
            $('#btn-theme-light').on('click', function() { window.setTheme('light'); });
            $('#btn-theme-dark').on('click', function() { window.setTheme('dark'); });
            $('#btn-theme-blue').on('click', function() { window.setTheme('blue'); });
        });
    </script>
}
