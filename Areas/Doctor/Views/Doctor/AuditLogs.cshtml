@model IEnumerable<MedLinkPortal.Models.AuditLog>
@{
    ViewData["Title"] = "Security & Audit Logs";
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
}

<div class="max-w-5xl mx-auto py-10 space-y-12 reveal">
    <!-- Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8">
        <div>
            <div class="inline-flex items-center px-3 py-1 bg-slate-900 text-white rounded-full text-[10px] font-semibold uppercase tracking-widest mb-4">
                Core Compliance Layer
            </div>
            <h1 class="text-4xl font-semibold text-slate-900 dark:text-white tracking-tight">Audit Trail</h1>
            <p class="text-slate-500 font-bold mt-2">Cryptographic history of system interactions.</p>
        </div>
        <div class="flex gap-4">
             <div class="flex items-center px-4 py-2 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 rounded-xl text-[10px] font-semibold border border-emerald-100 dark:border-emerald-900/30">
                <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full mr-3 animate-pulse"></span>
                LIVE MONITORING ACTIVE
            </div>
        </div>
    </div>

    <div class="premium-card overflow-hidden">
        <div class="bg-slate-50 dark:bg-white/2 px-10 py-6 border-b border-slate-100 dark:border-white/5 flex justify-between items-center">
            <h3 class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Activity Timeline</h3>
            <button class="text-xs font-semibold text-blue-600 uppercase tracking-widest">Export Protocol</button>
        </div>

        <div class="p-0">
            <div class="divide-y divide-slate-100 dark:divide-white/5">
                @if (!Model.Any())
                {
                    <div class="p-10 text-center text-slate-400 text-sm font-bold">
                        No audit logs found. System is waiting for initial handshake.
                    </div>
                }
                else
                {
                    @foreach (var log in Model)
                    {
                        // Determine Icon and Color based on Action keyword
                        string icon = "fa-circle-info";
                        string color = "text-slate-500";
                        string statusColor = "text-slate-500";

                        var actionLower = log.Action.ToLower();
                        if (actionLower.Contains("access") || actionLower.Contains("login") || actionLower.Contains("session")) 
                        { 
                            icon = "fa-key"; 
                            color = "text-blue-500";
                            statusColor = "text-blue-500";
                        }
                        else if (actionLower.Contains("update") || actionLower.Contains("modify") || actionLower.Contains("edit")) 
                        { 
                            icon = "fa-pen-to-square"; 
                            color = "text-amber-500";
                            statusColor = "text-amber-500";
                        }
                        else if (actionLower.Contains("create") || actionLower.Contains("new") || actionLower.Contains("add")) 
                        { 
                            icon = "fa-plus-circle"; 
                            color = "text-emerald-500";
                            statusColor = "text-emerald-500";
                        }
                        else if (actionLower.Contains("delete") || actionLower.Contains("remove")) 
                        { 
                            icon = "fa-trash"; 
                            color = "text-red-500";
                            statusColor = "text-red-500";
                        }
                        else if (actionLower.Contains("financial") || actionLower.Contains("withdrawal"))
                        {
                            icon = "fa-money-bill-transfer";
                            color = "text-purple-500";
                            statusColor = "text-purple-500";
                        }
                        else if (actionLower.Contains("optimization"))
                        {
                            icon = "fa-bolt";
                            color = "text-yellow-500";
                            statusColor = "text-yellow-500";
                        }

                        <div class="p-6 md:p-8 hover:bg-slate-50 dark:hover:bg-white/5 transition-colors flex flex-col md:flex-row md:items-center justify-between gap-4 md:gap-0 group">
                            <div class="flex items-center gap-4 md:gap-6">
                                <div class="w-10 h-10 md:w-12 md:h-12 rounded-2xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-white/10 flex shrink-0 items-center justify-center @color shadow-sm group-hover:scale-110 transition-transform">
                                    <i class="fas @icon"></i>
                                </div>
                                <div>
                                    <h4 class="text-sm font-semibold text-slate-900 dark:text-white tracking-tight">@log.Action</h4>
                                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mt-1">@log.Timestamp.ToString("g") • @log.IPAddress</p>
                                    @if(!string.IsNullOrEmpty(log.Details))
                                    {
                                         <p class="text-xs text-slate-500 mt-1 font-medium">@log.Details</p>
                                    }
                                </div>
                            </div>
                            <div class="flex items-center justify-between md:justify-end gap-8 w-full md:w-auto pl-14 md:pl-0">
                                <span class="text-[10px] font-semibold @statusColor uppercase tracking-widest">@log.Status</span>
                                <div class="w-10 h-10 flex items-center justify-center text-slate-300 hover:text-blue-500 transition-colors">
                                    <i class="fas fa-chevron-right text-[10px]"></i>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        
        <div class="p-10 bg-slate-50 dark:bg-white/2 border-t border-slate-100 dark:border-white/5 text-center">
            <p class="text-[9px] font-semibold text-slate-400 uppercase tracking-[0.3em]">End of Primary Buffer • Secure Link Maintained</p>
        </div>
    </div>
</div>
