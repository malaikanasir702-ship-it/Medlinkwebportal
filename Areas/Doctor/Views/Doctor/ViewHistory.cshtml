@model IEnumerable<MedLinkPortal.Areas.Doctor.Models.PatientRecord>

@{
    ViewData["Title"] = "Medical History";
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
}

<div class="max-w-5xl mx-auto py-6 md:py-10 space-y-6 md:space-y-12 reveal">
    <!-- Timeline Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6 md:gap-8 bg-slate-900 rounded-[2.5rem] md:rounded-[40px] p-6 md:p-10 shadow-2xl relative overflow-hidden">
        <div class="absolute -right-20 -top-20 opacity-10">
            <i class="fas fa-microscope text-[150px] md:text-[200px] text-white"></i>
        </div>
        <div class="relative z-10">
            <h1 class="text-3xl font-semibold text-white tracking-tight">Clinical Timeline</h1>
            <p class="text-[10px] font-semibold text-blue-500 uppercase tracking-widest mt-2 flex items-center">
                <i class="fas fa-fingerprint mr-3"></i>
                Patient Node: <span class="text-white ml-2">@ViewBag.PatientName</span>
            </p>
        </div>
        <div class="relative z-10 flex gap-4 w-full md:w-auto">
            <a asp-action="CreateRecord" asp-route-patientId="@ViewBag.PatientId" 
               class="flex-1 md:flex-none px-8 py-4 bg-white text-slate-900 rounded-2xl text-[11px] font-semibold uppercase tracking-widest hover:bg-blue-50 transition-all flex items-center justify-center shadow-xl">
                <i class="fas fa-plus mr-3"></i> Append Record
            </a>
            <a asp-action="PatientRecords" class="flex-1 md:flex-none px-8 py-4 bg-white/10 text-white rounded-2xl text-[11px] font-semibold uppercase tracking-widest hover:bg-white/20 transition-all flex items-center justify-center border border-white/10">
                Exit Loop
            </a>
        </div>
    </div>

    <!-- Timeline Body -->
    <div class="space-y-10 relative">
        <div class="absolute left-8 top-0 bottom-0 w-px bg-slate-100 dark:bg-white/5 hidden md:block"></div>
        
        @foreach (var record in Model)
        {
            <div class="relative md:pl-20 group">
                <!-- Timeline Dot -->
                <div class="absolute left-6 top-10 w-4 h-4 bg-white dark:bg-slate-900 border-4 border-blue-500 rounded-full z-10 hidden md:block group-hover:scale-125 transition-transform"></div>
                
                <div class="premium-card p-10 space-y-8 hover:border-blue-500/30">
                    <div class="flex flex-col md:flex-row justify-between gap-6">
                        <div class="flex items-center gap-6">
                            <div class="w-16 h-16 rounded-[24px] bg-blue-600/10 flex items-center justify-center text-blue-600 text-xl shadow-inner">
                                <i class="fas fa-file-waveform"></i>
                            </div>
                            <div>
                                <h3 class="text-xl font-semibold text-slate-900 dark:text-white tracking-tight line-clamp-1">@record.Diagnosis</h3>
                                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-1">
                                    <i class="far fa-calendar-alt mr-2 text-blue-500"></i> @record.CreatedAt.ToString("MMM dd, yyyy • HH:mm")
                                </p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 mt-4 md:mt-0">
                            @if (!string.IsNullOrEmpty(record.Vitals))
                            {
                                <span class="px-2 py-1 bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 text-[9px] font-semibold rounded-lg uppercase tracking-widest border border-emerald-500/10">Vitals Recorded</span>
                            }
                            @if (!string.IsNullOrEmpty(record.Allergies))
                            {
                                <span class="px-2 py-1 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 text-[9px] font-semibold rounded-lg uppercase tracking-widest border border-red-500/10">Allergies Logged</span>
                            }
                            <a asp-action="RecordDetails" asp-route-id="@record.Id" 
                               class="w-11 h-11 flex items-center justify-center bg-slate-50 dark:bg-white/5 text-slate-400 hover:text-blue-600 rounded-xl transition-all"><i class="fas fa-eye text-xs"></i></a>
                            <a asp-action="EditRecord" asp-route-id="@record.Id" 
                               class="w-11 h-11 flex items-center justify-center bg-slate-50 dark:bg-white/5 text-slate-400 hover:text-blue-500 rounded-xl transition-all"><i class="fas fa-edit text-xs"></i></a>
                            <form asp-action="DeleteRecord" asp-route-id="@record.Id" method="post" onsubmit="return confirm('Terminate this data block?');" class="inline">
                                <button type="submit" class="w-11 h-11 flex items-center justify-center bg-slate-50 dark:bg-white/5 text-slate-400 hover:text-red-500 rounded-xl transition-all">
                                    <i class="fas fa-trash-alt text-xs"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="grid md:grid-cols-2 gap-10 pt-8 border-t border-slate-100 dark:border-white/5">
                        <div class="space-y-3">
                            <h4 class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest flex items-center">
                                <span class="w-1.5 h-1.5 bg-blue-500 rounded-full mr-2"></span>
                                Prescription Deck
                            </h4>
                            <p class="text-xs font-bold text-slate-600 dark:text-slate-300 leading-relaxed italic">
                                @(string.IsNullOrEmpty(record.Prescription) ? "No active pharmacological vectors defined." : record.Prescription)
                            </p>
                        </div>
                        <div class="space-y-3">
                            <h4 class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest flex items-center">
                                <span class="w-1.5 h-1.5 bg-slate-300 rounded-full mr-2"></span>
                                Clinical Notes
                            </h4>
                            <p class="text-xs font-bold text-slate-500 dark:text-slate-400 leading-relaxed">
                                @(string.IsNullOrEmpty(record.Notes) ? "Observation logs are currently void." : record.Notes)
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="premium-card p-24 text-center border-2 border-dashed border-slate-100 dark:border-white/5">
                <div class="inline-flex items-center justify-center w-24 h-24 bg-slate-50 dark:bg-white/5 rounded-[40px] mb-8">
                    <i class="fas fa-folder-open text-slate-200 text-4xl"></i>
                </div>
                <h3 class="text-xl font-semibold text-slate-900 dark:text-white uppercase tracking-widest">Timeline Void</h3>
                <p class="text-xs font-bold text-slate-400 mt-4 max-w-sm mx-auto leading-relaxed">No medical data blocks have been committed to this node's chronology yet.</p>
                <a asp-action="CreateRecord" asp-route-patientId="@ViewBag.PatientId" 
                   class="inline-flex items-center px-10 py-5 bg-blue-600 text-white rounded-2xl text-[11px] font-semibold uppercase tracking-widest mt-10 hover:bg-blue-700 shadow-xl transition-all">
                    Initialize First Record
                </a>
            </div>
        }
    </div>
</div>
