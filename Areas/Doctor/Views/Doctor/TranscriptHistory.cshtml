@{
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
    ViewData["Title"] = "Clinical Transcript Archive";
    var appointmentId = ViewBag.AppointmentId;
}

<div class="p-6 lg:p-10 space-y-8 max-w-[1600px] mx-auto overflow-hidden">
    <!-- Header Bento Card -->
    <div class="relative group overflow-hidden bg-white dark:bg-slate-900 rounded-[3rem] p-10 border border-slate-100 dark:border-white/5 shadow-2xl shadow-blue-500/5">
        <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-blue-50/50 dark:bg-blue-900/10 rounded-full blur-[80px] -mr-32 -mt-32 transition-transform group-hover:scale-110"></div>
        
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-8">
            <div class="flex items-center gap-6">
                <div class="w-20 h-20 bg-gradient-to-br from-blue-700 to-slate-900 rounded-3xl flex items-center justify-center text-white shadow-2xl shadow-blue-600/30">
                    <i data-lucide="microscope" class="w-10 h-10"></i>
                </div>
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-blue-50 dark:bg-blue-900/30 rounded-full mb-2 border border-blue-100 dark:border-blue-800">
                        <span class="w-1.5 h-1.5 bg-blue-600 rounded-full animate-pulse"></span>
                        <span class="text-[9px] font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-widest">Medical Intelligence Record</span>
                    </div>
                    <h1 class="text-3xl lg:text-4xl font-semibold text-slate-900 dark:text-white tracking-tight">Transcription Archive</h1>
                    <div class="flex items-center gap-3 mt-1.5">
                        <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest flex items-center gap-1.5">
                            <i data-lucide="user" class="w-3 h-3"></i> @ViewBag.PatientName
                        </span>
                        <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest flex items-center gap-1.5 border-l border-slate-200 dark:border-white/10 pl-3">
                            <i data-lucide="calendar" class="w-3 h-3"></i> @ViewBag.AppointmentDate
                        </span>
                    </div>
                </div>
            </div>
            
            <a href="/Doctor/TranscriptionHistory" class="px-8 py-4 bg-slate-50 dark:bg-white/5 text-slate-900 dark:text-white border border-slate-200 dark:border-white/10 rounded-2xl text-[10px] font-semibold uppercase tracking-widest hover:bg-slate-900 dark:hover:bg-white hover:text-white dark:hover:text-slate-900 transition-all flex items-center gap-2">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Return to Node
            </a>
        </div>
    </div>

    <!-- Main Content Body -->
    <div class="bg-white dark:bg-slate-900/50 rounded-[3rem] border border-slate-100 dark:border-white/5 shadow-2xl overflow-hidden min-h-[600px] relative backdrop-blur-xl">
        <div class="absolute inset-0 bg-gradient-to-b from-slate-50/50 to-transparent dark:from-white/2 pointer-events-none"></div>
        
        <!-- Intelligence Status Bar -->
        <div class="relative z-10 px-10 py-6 border-b border-slate-50 dark:border-white/5 flex items-center justify-between bg-white/50 dark:bg-slate-900/50">
            <div class="flex items-center gap-8">
                <div class="flex items-center gap-2">
                    <i data-lucide="bot" class="w-4 h-4 text-blue-600"></i>
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Neural Link Active</span>
                </div>
                <div class="hidden sm:flex items-center gap-2 border-l border-slate-100 dark:border-white/10 pl-8 text-slate-400">
                    <i data-lucide="activity" class="w-4 h-4"></i>
                    <span class="text-[10px] font-semibold uppercase tracking-widest">Processing Latency: 42ms</span>
                </div>
            </div>
            <div class="flex items-center gap-4">
                 <button class="p-2 hover:bg-slate-100 dark:hover:bg-white/5 rounded-xl transition-all text-slate-400">
                    <i data-lucide="download" class="w-4 h-4"></i>
                 </button>
                 <button class="p-2 hover:bg-slate-100 dark:hover:bg-white/5 rounded-xl transition-all text-slate-400">
                    <i data-lucide="printer" class="w-4 h-4"></i>
                 </button>
            </div>
        </div>

        <!-- Messages Container -->
        <div id="transcriptContainer" class="relative z-10 p-8 lg:p-12 space-y-12">
            <!-- Loading State -->
            <div id="loadingState" class="flex flex-col items-center justify-center py-32 space-y-6">
                <div class="relative">
                    <div class="w-20 h-20 border-4 border-blue-600/10 dark:border-white/5 rounded-full"></div>
                    <div class="w-20 h-20 border-4 border-blue-600 border-t-transparent rounded-full animate-spin absolute top-0 left-0"></div>
                </div>
                <div class="text-center">
                    <p class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-[0.3em] animate-pulse">Syncing Med-Node Vault</p>
                    <p class="text-[10px] font-bold text-slate-400 mt-2">Decoding encrypted clinical dialogue...</p>
                </div>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="hidden flex flex-col items-center justify-center py-32 space-y-8">
                <div class="w-32 h-32 bg-slate-50 dark:bg-white/5 rounded-[3rem] flex items-center justify-center text-slate-200 dark:text-slate-800 shadow-inner">
                    <i data-lucide="database-zap" class="w-16 h-16"></i>
                </div>
                <div class="text-center max-w-sm">
                    <h3 class="text-2xl font-semibold text-slate-900 dark:text-white mb-2">No Records Cached</h3>
                    <p class="text-sm font-bold text-slate-400 uppercase tracking-wider leading-relaxed">System scan complete. Zero transcription packets found for this session ID.</p>
                </div>
            </div>

            <!-- Transcript List -->
            <div id="transcriptMessages" class="hidden space-y-12"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        const appointmentId = @(appointmentId ?? 0);

        async function loadTranscript() {
            const loadingElement = document.getElementById('loadingState');
            const emptyElement = document.getElementById('emptyState');
            const messagesElement = document.getElementById('transcriptMessages');

            try {
                if (!appointmentId) throw new Error("Invalid Appointment ID");

                const response = await fetch(`/Dashboard/GetTranscriptHistory?appointmentId=${appointmentId}`);
                if (!response.ok) throw new Error("Network response was not ok");
                
                const data = await response.json();

                if (loadingElement) loadingElement.classList.add('hidden');

                if (data.success && data.transcripts && data.transcripts.length > 0) {
                    if (messagesElement) {
                        messagesElement.classList.remove('hidden');
                        renderTranscripts(data.transcripts);
                    }
                } else {
                    if (emptyElement) emptyElement.classList.remove('hidden');
                }
            } catch (error) {
                console.error('Error loading transcript:', error);
                if (loadingElement) loadingElement.classList.add('hidden');
                if (emptyElement) emptyElement.classList.remove('hidden');
            }
        }

        function renderTranscripts(transcripts) {
            const container = document.getElementById('transcriptMessages');
            if (!container) return;
            
            container.innerHTML = '';

            transcripts.forEach((t, index) => {
                const isDoctor = t.speakerRole === 'Doctor';
                const messageWrapper = document.createElement('div');
                messageWrapper.className = `flex group ${isDoctor ? 'justify-end' : 'justify-start'}`;
                
                // Format timestamp
                let displayTime = "N/A";
                try {
                    const date = new Date(t.timestamp);
                    displayTime = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                } catch(e) { console.error(e); }

                messageWrapper.innerHTML = `
                    <div class="w-full max-w-4xl space-y-4">
                        <div class="flex items-center gap-3 ${isDoctor ? 'flex-row-reverse' : 'flex-row'}">
                            <div class="w-10 h-10 rounded-2xl ${isDoctor ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900' : 'bg-blue-600 text-white'} flex items-center justify-center shadow-lg transition-transform group-hover:scale-110">
                                <i data-lucide="${isDoctor ? 'stethoscope' : 'user'}" class="w-5 h-5"></i>
                            </div>
                            <div class="flex flex-col ${isDoctor ? 'items-end' : 'items-start'}">
                                <span class="text-[10px] font-semibold text-slate-900 dark:text-white uppercase tracking-widest">
                                    ${t.speakerName} (${t.speakerRole})
                                </span>
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter">
                                    ${displayTime}
                                </span>
                            </div>
                        </div>

                        <div class="bg-white dark:bg-slate-800/50 p-7 rounded-[2.5rem] ${isDoctor ? 'rounded-tr-lg' : 'rounded-tl-lg'} border border-slate-100 dark:border-white/5 shadow-xl shadow-slate-200/20 dark:shadow-none hover:shadow-2xl transition-all duration-500">
                             <p class="text-[15px] text-slate-900 dark:text-white font-bold leading-relaxed mb-6">${t.originalText}</p>
                             
                             <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6 border-t border-slate-50 dark:border-white/5">
                                <div class="space-y-3">
                                    <div class="flex items-center gap-2 opacity-50">
                                        <div class="w-5 h-5 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center text-[8px] font-semibold text-blue-600 dark:text-blue-400">EN</div>
                                        <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest">Medical Translation</span>
                                    </div>
                                    <p class="text-sm text-slate-600 dark:text-slate-400 italic font-medium leading-relaxed">${t.englishTranslation}</p>
                                </div>
                                <div class="space-y-3">
                                    <div class="flex items-center justify-end gap-2 opacity-50">
                                        <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest">اردو ترجمہ</span>
                                        <div class="w-5 h-5 bg-emerald-50 dark:bg-emerald-900/30 rounded-full flex items-center justify-center text-[8px] font-semibold text-emerald-600 dark:text-emerald-400">UR</div>
                                    </div>
                                    <p class="text-[17px] text-slate-600 dark:text-slate-200 leading-normal text-right font-urdu" dir="rtl">${t.urduTranslation}</p>
                                </div>
                             </div>
                        </div>
                    </div>
                `;

                container.appendChild(messageWrapper);
            });
            
            if (window.lucide) window.lucide.createIcons();
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', loadTranscript);
        } else {
            loadTranscript();
        }
    </script>

    <style>
        .font-urdu {
            font-family: 'Jameel Noori Nastaleeq', 'Noto Nastaliq Urdu', serif;
        }
    </style>
}
