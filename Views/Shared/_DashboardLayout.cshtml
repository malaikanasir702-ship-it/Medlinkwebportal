@model MedLinkPortal.Models.PatientDashboardModel
@functions {
    public string TimeSpanToString(DateTime dt)
    {
        var ts = DateTime.Now - dt;
        if (ts.TotalMinutes < 1) return "Just now";
        if (ts.TotalMinutes < 60) return $"{(int)ts.TotalMinutes}m ago";
        if (ts.TotalHours < 24) return $"{(int)ts.TotalHours}h ago";
        return dt.ToString("MMM dd");
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedLink</title>
    <link rel="icon" type="image/png" href="~/images/medlink-logo.png">
    <link rel="apple-touch-icon" href="~/images/medlink-logo.png">
    <link rel="preconnect" href="https://cdn.tailwindcss.com" crossorigin>
    <link rel="preconnect" href="https://unpkg.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
    <style>
        * { font-family: 'Outfit', sans-serif; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        [x-cloak] { display: none !important; }
        .animate-pulse { animation: pulse 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .5; } }
        .animate-in { animation: animateIn 0.2s ease-out; }
        @@keyframes animateIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }
        .skeleton-enter { animation: skeletonEnter 0.3s ease-out; }
        @@keyframes skeletonEnter { from { opacity: 0; } to { opacity: 1; } }

        /* Dark Mode Global Overrides */
        .dark body { background-color: #0F172A; color: #F8FAFC; }
        .dark aside { background-color: #1E293B !important; border-color: #334155 !important; }
        .dark .bg-white { background-color: #1E293B !important; }
        .dark .text-gray-900 { color: #F8FAFC !important; }
        .dark .text-gray-600 { color: #CBD5E1 !important; }
        .dark .text-gray-500 { color: #94A3B8 !important; }
        .dark .border-gray-100, .dark .border-gray-50 { border-color: #334155 !important; }
        .dark .bg-gray-50 { background-color: #0F172A !important; }
        .dark .shadow-sm { shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.5); }

        /* Progress Bar */
        #page-progress {
            position: fixed;
            top: 0;
            left: 0;
            height: 3px;
            background: linear-gradient(to right, #2563eb, #60a5fa);
            z-index: 1000;
            width: 0%;
            transition: width 0.3s ease;
            opacity: 0;
        }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.0/signalr.min.js"></script>
    <script src="~/js/webrtc-handler.js"></script>
    <script>
        // Make chatHubConnection globally available so _GlobalCallOverlay can reuse it
        window.chatHubConnection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();
        window.chatHubConnection.start().catch(err => console.error('ChatHub error:', err));
    </script>
    <script>
        // Apply dark mode immediately to prevent flash
        if (@(Model.DarkModeEnabled ? "true" : "false")) {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body class="min-h-screen bg-[#F8FAFC] font-inter relative transition-colors duration-300">
    <!-- Progress Bar -->
    <div id="page-progress"></div>

    <!-- Dynamic Background Blobs -->
    <div class="fixed top-[-10%] left-[-10%] w-[40%] h-[40%] bg-blue-50 rounded-full blur-[80px] -z-0 opacity-40 pointer-events-none"></div>
    <div class="fixed bottom-[-10%] right-[-10%] w-[50%] h-[50%] bg-purple-50 rounded-full blur-[100px] -z-0 opacity-30 pointer-events-none"></div>

    <!-- Desktop Sidebar -->
    <aside class="hidden lg:flex w-64 bg-white/70 backdrop-blur-xl border-r border-gray-100 flex-col z-10 fixed top-0 left-0 h-screen overflow-y-auto custom-scrollbar">
        <partial name="_Sidebar" model="Model" />
    </aside>

    <!-- Mobile Sidebar Overlay -->
    <div id="mobileSidebar" class="hidden fixed inset-0 z-50 lg:hidden">
        <div class="absolute inset-0 bg-gray-900/40 backdrop-blur-sm" onclick="closeMobileMenu()"></div>
        <aside class="absolute left-0 top-0 bottom-0 w-64 bg-white shadow-2xl flex flex-col animate-in slide-in-from-left duration-200 overflow-y-auto custom-scrollbar">
            <partial name="_Sidebar" model="Model" />
        </aside>
    </div>

    <!-- Main Content -->
    <main id="dashboard-main" class="flex-1 p-3 md:p-5 lg:p-6 z-10 overflow-y-auto lg:ml-64">
        <!-- Header - Compact & Sticky on Mobile -->
        <header id="dashboardHeader" class="sticky top-3 lg:top-0 lg:relative flex flex-col lg:flex-row lg:items-center justify-between mb-6 lg:mb-8 gap-4 bg-white/70 lg:bg-transparent backdrop-blur-2xl backdrop-saturate-150 lg:backdrop-blur-none z-40 px-5 lg:px-0 py-3 lg:p-0 border border-white/40 lg:border-none  lg:shadow-none rounded-[2.5rem] lg:rounded-none @(Model.ActiveTab == "messages" ? "top-0 -mx-3 mb-0 rounded-none shadow-none border-b border-gray-100 mt-0" : "")">
            <div class="flex items-center justify-between lg:block lg:w-auto w-full">
                <div class="lg:hidden flex items-center gap-2">
                    <div class="w-9 h-9 rounded-xl overflow-hidden shadow-md shadow-blue-500/10 flex-shrink-0 flex items-center justify-center bg-white border border-gray-100/50">
                        <img src="~/images/medlink-logo.png" alt="MedLink Logo" class="w-8 h-8 rounded-lg object-cover">
                    </div>
                    <span class="text-xl font-black text-gray-900 tracking-tight">MedLink</span>
                </div>

                <div class="hidden lg:block">
                    @if (Model.IsLoading)
                    {
                        <div class="space-y-1.5 skeleton-enter">
                            <div class="animate-pulse bg-gray-200/60 rounded-lg h-7 w-36"></div>
                            <div class="animate-pulse bg-gray-200/60 rounded-lg h-4 w-48"></div>
                        </div>
                    }
                    else
                    {
                        <h1 class="text-xl md:text-2xl font-semibold text-gray-900 mb-0.5 tracking-tight">
                            @if(ViewData["HeaderTitle"] != null) { @ViewData["HeaderTitle"] } else { <text>Dashboard 👋</text> }
                        </h1>
                        <p class="text-gray-500 font-medium text-xs md:text-sm">
                            @if(ViewData["HeaderSubtitle"] != null) { @ViewData["HeaderSubtitle"] } else { <text>Your health is our priority.</text> }
                        </p>
                    }
                </div>

                <div class="flex items-center gap-2 lg:hidden">
                    <a href="@Url.Action("AiDoctor", "Dashboard")" class="p-2 bg-blue-600 border border-blue-500 rounded-xl text-white relative shadow-sm shadow-blue-500/20" title="AI Doctor">
                        <i data-lucide="bot" class="w-5 h-5"></i>
                    </a>
                    <button id="notificationButtonMobile" onclick="toggleNotifications()" class="p-2 bg-white border border-gray-100 rounded-xl text-gray-400 relative">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                         @if (Model.Notifications != null && Model.Notifications.Any(n => !n.IsRead))
                        {
                            <span class="absolute top-2 right-2 w-2 h-2 bg-rose-500 rounded-full border-2 border-white"></span>
                        }
                    </button>
                    <button onclick="openMobileMenu()" class="p-2 bg-white border border-gray-100 rounded-xl text-gray-500 shadow-sm">
                        <i data-lucide="menu" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>

            <div class="hidden lg:flex items-center gap-6 w-full lg:w-auto">
                <!-- Premium High-Tech AI Status -->
                <div class="hidden xl:flex items-center gap-4 bg-white/40 backdrop-blur-md border border-white/60 rounded-[1.25rem] px-4 py-2 shadow-[0_8px_32px_rgba(31,38,135,0.07)] group hover:border-blue-400/50 transition-all duration-500 cursor-default">
                    <div class="relative flex items-center justify-center">
                        <div class="absolute inset-0 bg-blue-500/20 blur-md rounded-full animate-pulse"></div>
                        <div class="relative w-8 h-8 rounded-lg bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center shadow-lg shadow-blue-500/20">
                            <i data-lucide="cpu" class="w-4 h-4 text-white animate-pulse"></i>
                        </div>
                    </div>
                    <div class="flex flex-col pr-4 border-r border-gray-200/50">
                        <div class="flex items-center gap-1.5 mb-0.5">
                            <span class="text-[9px] font-black text-blue-600/80 uppercase tracking-[0.15em]">Neural Core</span>
                            <div class="flex h-1.5 w-1.5">
                                <span class="animate-ping absolute inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
                            </div>
                        </div>
                        <span class="text-[11px] font-extrabold text-gray-900 tracking-tight">V2.4 Active</span>
                    </div>
                    <div class="flex -space-x-1.5">
                        <div class="w-6 h-6 rounded-full border-2 border-white bg-blue-50 flex items-center justify-center text-blue-600 shadow-sm" title="HIPAA Compliant">
                            <i data-lucide="shield-check" class="w-3 h-3"></i>
                        </div>
                        <div class="w-6 h-6 rounded-full border-2 border-white bg-indigo-50 flex items-center justify-center text-indigo-600 shadow-sm" title="SSL Encrypted">
                            <i data-lucide="lock" class="w-3 h-3"></i>
                        </div>
                    </div>
                </div>

                <!-- Glassmorphic User Controls -->
                <div class="flex items-center bg-white/60 backdrop-blur-xl border border-white/80 rounded-2xl p-2 shadow-xl shadow-gray-200/40">
                    <!-- AI Doctor Trigger -->
                    <div class="relative px-2">
                         <a href="@Url.Action("AiDoctor", "Dashboard")" class="h-10 px-4 flex items-center justify-center gap-2 bg-blue-600 rounded-xl text-white hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-500/20 transition-all relative group border border-blue-500">
                            <i data-lucide="bot" class="w-4 h-4 group-hover:scale-110 transition-transform"></i>
                            <span class="text-[10px] font-black uppercase tracking-widest whitespace-nowrap">AI Doctor</span>
                        </a>
                    </div>

                    <div class="w-px h-6 bg-gray-200/60 mx-1"></div>

                    <!-- Cart Trigger -->
                    <div class="relative px-2">
                         <button onclick="PharmacyCart.open()" class="w-10 h-10 flex items-center justify-center bg-white rounded-xl text-gray-400 hover:text-blue-600 hover:shadow-sm transition-all relative group border border-transparent hover:border-blue-50">
                            <i data-lucide="shopping-cart" class="w-5 h-5 group-hover:scale-110 transition-transform"></i>
                            <span class="cart-badge hidden absolute top-2.5 right-2.5 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-white animate-pulse"></span>
                        </button>
                    </div>

                    <div class="w-px h-6 bg-gray-200/60 mx-1"></div>
                    <div class="relative px-2">
                        <button id="notificationButton" onclick="toggleNotifications()" class="w-10 h-10 flex items-center justify-center bg-white rounded-xl text-gray-400 hover:text-blue-600 hover:shadow-sm transition-all relative group border border-transparent hover:border-blue-50">
                            <i data-lucide="bell" class="w-5 h-5 group-hover:rotate-12 transition-transform"></i>
                            @if (Model.Notifications != null && Model.Notifications.Any(n => !n.IsRead))
                            {
                                <span class="absolute top-2.5 right-2.5 w-2.5 h-2.5 bg-rose-500 rounded-full border-2 border-white animate-pulse"></span>
                            }
                        </button>
                    </div>
                    
                    <div class="w-px h-6 bg-gray-200/60 mx-2"></div>

                    @if (Model.IsLoading)
                    {
                        <div class="animate-pulse bg-gray-200/60 rounded-xl w-10 h-10 mx-2"></div>
                    }
                    else
                    {
                        <div class="flex items-center gap-4 pl-2 pr-2 group">
                             <a href="@Url.Action("Settings", "Dashboard")" class="flex items-center gap-4">
                                <div class="hidden lg:flex flex-col items-end min-w-[80px]">
                                    <span class="text-[11px] font-black text-gray-900 leading-none mb-1 whitespace-nowrap">@Model.PatientName</span>
                                    <span class="text-[9px] font-bold text-gray-400 uppercase tracking-widest">Patient Portal</span>
                                </div>
                                @if (!string.IsNullOrEmpty(Model.ProfileImage))
                                {
                                    <div class="relative">
                                        <div class="absolute -inset-1.5 bg-gradient-to-tr from-blue-600 to-indigo-600 rounded-xl blur-[3px] opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                                        <img src="@Model.ProfileImage" class="relative w-10 h-10 rounded-xl object-cover border-2 border-white shadow-md" alt="Profile">
                                    </div>
                                }
                                else
                                {
                                    <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 border border-blue-100 shadow-inner group-hover:bg-blue-600 group-hover:text-white transition-all">
                                        <i data-lucide="user" class="w-5 h-5"></i>
                                    </div>
                                }
                             </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Global Notification Dropdown - Placed here to bypass lg:hidden parent -->
            <div id="notificationDropdown" class="hidden absolute left-1/2 -translate-x-1/2 lg:left-auto lg:right-0 lg:translate-x-0 top-full mt-3 w-[calc(100vw-2rem)] sm:w-96 bg-white border border-gray-100 rounded-[2rem] shadow-2xl z-50 overflow-hidden animate-in fade-in slide-in-from-top-4 duration-300">
                <div class="p-5 border-b border-gray-50 flex items-center justify-between bg-gray-50/50 backdrop-blur-sm">
                    <div>
                        <h3 class="font-black text-gray-900 text-base">Notifications</h3>
                        <p class="text-[10px] text-gray-400 font-bold uppercase tracking-widest mt-0.5">@(Model.Notifications?.Count(n => !n.IsRead) ?? 0) Unread Messages</p>
                    </div>
                    <button onclick="markAllAsRead()" class="text-[10px] font-black uppercase tracking-widest text-blue-600 hover:text-blue-700 hover:underline">Mark all read</button>
                </div>
                <div class="max-h-[400px] overflow-y-auto custom-scrollbar">
                    @if (Model.Notifications == null || !Model.Notifications.Any())
                    {
                        <div class="px-6 py-12 text-center">
                            <div class="w-16 h-16 bg-gray-50 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-dashed border-gray-200">
                                <i data-lucide="bell-off" class="w-8 h-8 text-gray-300"></i>
                            </div>
                            <h4 class="text-sm font-bold text-gray-900 mb-1">All caught up!</h4>
                            <p class="text-xs text-gray-500">No new notifications for you right now.</p>
                        </div>
                    }
                    else
                    {
                        <div class="p-2 space-y-1">
                            @foreach (MedLinkPortal.Models.Notification note in Model.Notifications.Where(n => n != null))
                            {
                                <div onclick="markAsRead(@note.Id)" class="p-4 hover:bg-blue-50/50 rounded-2xl transition-all cursor-pointer flex gap-4 group relative @(!note.IsRead ? "bg-white" : "opacity-60")">
                                    @if (!note.IsRead)
                                    {
                                        <div class="absolute left-2 top-1/2 -translate-y-1/2 w-1 h-8 bg-blue-600 rounded-full"></div>
                                    }
                                    <div class="w-12 h-12 rounded-2xl @(note.Color == "emerald" ? "bg-emerald-50 text-emerald-600 border-emerald-100" : note.Color == "amber" ? "bg-amber-50 text-amber-600 border-amber-100" : "bg-blue-50 text-blue-600 border-blue-100") border flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                                        <i data-lucide="@note.Icon" class="w-6 h-6"></i>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center justify-between mb-0.5">
                                            <p class="text-sm font-black text-gray-900 truncate pr-2">@note.Title</p>
                                            <span class="text-[10px] font-bold text-gray-400 whitespace-nowrap">@TimeSpanToString(note.CreatedAt)</span>
                                        </div>
                                        <p class="text-[11px] text-gray-500 font-medium leading-relaxed line-clamp-2">@note.Content</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="p-4 border-t border-gray-50 bg-gray-50/30 text-center">
                    <button class="text-xs font-black uppercase tracking-widest text-gray-500 hover:text-blue-600 transition-colors">View History</button>
                </div>
            </div>
        </header>

        <!-- Cart Drawer (Global) -->
        <div id="cartOverlay" class="hidden fixed inset-0 bg-gray-900/40 backdrop-blur-sm z-[100] transition-opacity duration-300 opacity-0" onclick="PharmacyCart.close()"></div>
        <div id="cartDrawer" class="fixed top-0 right-0 bottom-0 w-full max-w-md bg-white shadow-2xl z-[101] transform translate-x-full transition-transform duration-300 flex flex-col">
            <!-- Header -->
            <div class="p-6 border-b border-slate-100 flex items-center justify-between bg-slate-50/50">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white shadow-lg shadow-blue-600/20">
                        <i data-lucide="shopping-cart" class="w-5 h-5"></i>
                    </div>
                    <div>
                        <h3 class="font-black text-slate-900 text-lg tracking-tight">Your Cart</h3>
                        <p id="cartDrawerCount" class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">0 Items</p>
                    </div>
                </div>
                <button onclick="PharmacyCart.close()" class="w-10 h-10 rounded-full bg-white border border-slate-100 text-slate-400 hover:text-rose-500 hover:bg-rose-50 hover:border-rose-100 flex items-center justify-center transition-all">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <!-- Scrollable Items -->
            <div class="flex-1 overflow-y-auto p-6 custom-scrollbar">
                <div id="cartItemsContainer" class="space-y-4">
                    <!-- Items injected by JS -->
                </div>
                
                <div id="cartEmptyState" class="hidden h-full flex flex-col items-center justify-center text-center p-8">
                    <div class="w-20 h-20 bg-slate-50 rounded-[2rem] flex items-center justify-center mb-6 text-slate-300">
                        <i data-lucide="shopping-basket" class="w-10 h-10"></i>
                    </div>
                    <h4 class="font-black text-slate-900 text-lg mb-2">Your cart is empty</h4>
                    <p class="text-sm font-medium text-slate-400 max-w-[200px] mx-auto">Browse our pharmacy store to add essential medicines.</p>
                </div>
            </div>

            <!-- Footer -->
            <div id="cartFooter" class="p-6 border-t border-slate-100 bg-slate-50/50 hidden">
                <div class="flex items-center justify-between mb-6">
                    <span class="text-xs font-bold text-slate-500 uppercase tracking-widest">Total Amount</span>
                    <span id="cartTotalDisplay" class="text-2xl font-black text-slate-900">PKR 0</span>
                </div>
                <button id="btnCartCheckout" onclick="PharmacyCart.checkout()" class="w-full py-4 bg-slate-900 text-white font-black text-sm rounded-2xl hover:bg-emerald-600 shadow-xl shadow-slate-900/10 active:scale-95 transition-all flex items-center justify-center gap-2">
                    Proceed to Checkout <i data-lucide="arrow-right" class="w-4 h-4"></i>
                </button>
            </div>
        </div>

        @RenderBody()
        @RenderSection("Scripts", required: false)
        <script src="~/js/premium-modals.js"></script>
        <div id="mobileSpacer" class="h-20 lg:hidden @(Model.ActiveTab == "messages" ? "hidden" : "")"></div> <!-- Spacer for mobile bottom nav -->
    </main>
    <script src="~/js/pharmacy-cart.js"></script>

    <!-- Mobile Bottom Navigation Bar -->
    <nav id="mobileBottomNav" class="lg:hidden fixed bottom-4 left-4 right-4 bg-white/70 backdrop-blur-2xl backdrop-saturate-150 border border-white/40 shadow-2xl rounded-[2.5rem] px-6 py-3 flex items-center justify-between z-50 transition-all duration-300 @(Model.ActiveTab == "messages" ? "translate-y-[150%] opacity-0 pointer-events-none" : "")">
        <a href="@Url.Action("Index", "Dashboard")" class="flex flex-col items-center gap-1 @(Model.ActiveTab == "overview" ? "text-blue-600" : "text-gray-400")">
            <i data-lucide="layout-grid" class="w-6 h-6"></i>
            <span class="text-[10px] font-bold">Launch</span>
        </a>
        <a href="@Url.Action("Appointments", "Dashboard")" class="flex flex-col items-center gap-1 @(Model.ActiveTab == "appointments" ? "text-blue-600" : "text-gray-400")">
            <i data-lucide="calendar" class="w-6 h-6"></i>
            <span class="text-[10px] font-bold">Bookings</span>
        </a>
        <div class="relative -top-6">
            <a href="@Url.Action("LiveTriage", "Dashboard")" class="w-14 h-14 bg-blue-600 rounded-full flex items-center justify-center text-white shadow-lg shadow-blue-500/40 border-4 border-[#F8FAFC]">
                <i data-lucide="activity" class="w-6 h-6"></i>
            </a>
        </div>
        <a href="@Url.Action("Messages", "Dashboard")" class="flex flex-col items-center gap-1 @(Model.ActiveTab == "messages" ? "text-blue-600" : "text-gray-400")">
            <i data-lucide="message-circle" class="w-6 h-6"></i>
            <span class="text-[10px] font-bold">Talk</span>
        </a>
        <a href="@Url.Action("Settings", "Dashboard")" class="flex flex-col items-center gap-1 @(Model.ActiveTab == "settings" ? "text-blue-600" : "text-gray-400")">
            <i data-lucide="settings" class="w-6 h-6"></i>
            <span class="text-[10px] font-bold">Profile</span>
        </a>
    </nav>

    <script>
        lucide.createIcons();
        
        // AJAX NAVIGATION ENGINE
        async function navigateTo(url, pushState = true) {
            const main = document.getElementById('dashboard-main');
            const progressBar = document.getElementById('page-progress');
            progressBar.style.opacity = '1';
            progressBar.style.width = '30%';
            main.style.opacity = '0.5';
            main.style.transition = 'opacity 0.2s';

            try {
                const response = await fetch(url);
                progressBar.style.width = '60%';
                const html = await response.text();
                
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                
                // Swap main content
                const newContent = doc.querySelector('#dashboard-main').innerHTML;
                main.innerHTML = newContent;
                main.style.opacity = '1';
                
                // Close mobile menu if open
                closeMobileMenu();

                // Toggle Bottom Nav visibility
                updateBottomNavVisibility(url);

                // Handle spacer and padding for Messages page
                updateMessagesLayout(url);
                
                // Update Sidebar highlight
                updateSidebarActive(url);
                
                // Re-initialize Lucide
                lucide.createIcons();
                
                if (pushState) {
                    history.pushState({ url }, '', url);
                }

                // Handle any new scripts (Page-specific logic)
                const scripts = doc.querySelectorAll('#dashboard-main script');
                scripts.forEach(oldScript => {
                    const newScript = document.createElement('script');
                    Array.from(oldScript.attributes).forEach(attr => newScript.setAttribute(attr.name, attr.value));
                    if (oldScript.src) {
                        newScript.src = oldScript.src;
                    } else {
                        newScript.appendChild(document.createTextNode(oldScript.innerHTML));
                    }
                    document.body.appendChild(newScript);
                    setTimeout(() => newScript.parentNode?.removeChild(newScript), 100);
                });

                // Re-initialize Alpine logic for new content (v3+)
                if (window.Alpine) {
                    window.Alpine.initTree(main);
                }

                // REVEAL CONTENT (Ultra Fast Transition)
                revealContent(300);

                // Scroll to top
                document.getElementById('dashboard-main').scrollTop = 0;
                
                progressBar.style.width = '100%';
                setTimeout(() => {
                    progressBar.style.opacity = '0';
                    setTimeout(() => progressBar.style.width = '0%', 300);
                }, 300);

            } catch (err) {
                console.error('Navigation error:', err);
                window.location.href = url; // Fallback
            }
        }

        function updateBottomNavVisibility(url) {
            const path = new URL(url, window.location.origin).pathname;
            const bottomNav = document.getElementById('mobileBottomNav');
            if (bottomNav) {
                if (path.toLowerCase().includes('/messages')) {
                    bottomNav.classList.add('translate-y-full', 'opacity-0', 'pointer-events-none');
                } else {
                    bottomNav.classList.remove('translate-y-full', 'opacity-0', 'pointer-events-none');
                }
            }
        }

        function updateMessagesLayout(url) {
            const path = new URL(url, window.location.origin).pathname;
            const spacer = document.getElementById('mobileSpacer');
            const main = document.getElementById('dashboard-main');
            const header = document.getElementById('dashboardHeader');
            const isMessages = path.toLowerCase().includes('/messages');

            if (spacer) {
                if (isMessages) spacer.classList.add('hidden');
                else spacer.classList.remove('hidden');
            }

            if (header) {
                if (isMessages) header.classList.add('mb-0', 'shrink-0');
                else header.classList.remove('mb-0', 'shrink-0');
            }

            if (main) {
                if (isMessages) {
                    main.classList.remove('p-3', 'md:p-5', 'lg:p-6', 'overflow-y-auto');
                    main.classList.add('p-0', 'lg:p-6', 'h-dvh', 'flex', 'flex-col', 'overflow-hidden');
                } else {
                    main.classList.add('p-3', 'md:p-5', 'lg:p-6', 'overflow-y-auto');
                    main.classList.remove('p-0', 'h-dvh', 'flex', 'flex-col', 'overflow-hidden');
                }
            }
        }

        function updateSidebarActive(url) {
            const path = new URL(url, window.location.origin).pathname;
            document.querySelectorAll('aside a').forEach(link => {
                const linkPath = new URL(link.getAttribute('href'), window.location.origin).pathname;
                if (path === linkPath) {
                    link.classList.add('bg-blue-600', 'text-white', 'shadow-lg');
                    link.classList.remove('text-gray-500', 'hover:bg-gray-50', 'hover:text-gray-900');
                } else {
                    link.classList.remove('bg-blue-600', 'text-white', 'shadow-lg');
                    link.classList.add('text-gray-500', 'hover:bg-gray-50', 'hover:text-gray-900');
                }
            });
        }

        // Intercept link clicks
        document.addEventListener('click', e => {
            const link = e.target.closest('a');
            if (link && link.href && link.href.startsWith(window.location.origin) && !link.hasAttribute('download') && !link.target) {
                const url = new URL(link.href);
                if (url.pathname !== '/Dashboard/Logout') {
                    e.preventDefault();
                    navigateTo(link.href);
                }
            }
        });

        // Handle browser back/forward
        window.addEventListener('popstate', e => {
            if (e.state && e.state.url) {
                navigateTo(e.state.url, false);
            } else {
                window.location.reload();
            }
        });

        function openMobileMenu() {
            document.getElementById('mobileSidebar').classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        }
        function closeMobileMenu() {
            document.getElementById('mobileSidebar').classList.add('hidden');
            document.body.style.overflow = '';
        }

        function toggleNotifications() {
            const dropdown = document.getElementById('notificationDropdown');
            dropdown.classList.toggle('hidden');
        }

        // Close dropdown when clicking outside
        document.addEventListener('click', function(event) {
            const dropdown = document.getElementById('notificationDropdown');
            const button = event.target.closest('button');
            const isToggleButton = button && (button.id === 'notificationButton' || button.id === 'notificationButtonMobile');
            
            if (dropdown && !dropdown.classList.contains('hidden') && !dropdown.contains(event.target) && !isToggleButton) {
                 dropdown.classList.add('hidden');
            }
        });

        async function markAsRead(id) {
            try {
                const response = await fetch(`@Url.Action("MarkNotificationAsRead", "Dashboard")?id=${id}`, { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    location.reload(); // Quickest way to update UI
                }
            } catch (err) { console.error(err); }
        }

        async function markAllAsRead() {
            try {
                const response = await fetch('@Url.Action("MarkAllNotificationsAsRead", "Dashboard")', { method: 'POST' });
                const result = await response.json();
                if (result.success) {
                    const dropdown = document.getElementById('notificationDropdown');
                    const notificationsContainer = dropdown.querySelector('.max-h-\\[400px\\]');
                    notificationsContainer.querySelectorAll('.rounded-2xl').forEach(el => {
                        el.classList.add('opacity-60');
                        el.classList.remove('bg-white');
                        const dot = el.querySelector('.absolute.left-2');
                        if(dot) dot.remove();
                    });
                    document.querySelectorAll('#notificationButton span, #notificationButtonMobile span').forEach(el => el.remove());
                    const unreadText = dropdown.querySelector('p.text-\\[10px\\]');
                    if(unreadText) unreadText.textContent = '0 Unread Messages';
                }
            } catch (err) { console.error(err); }
        }

        // SIGNALR NOTIFICATION ENGINE
        const notificationConnection = new signalR.HubConnectionBuilder()
            .withUrl("/notificationHub")
            .withAutomaticReconnect()
            .build();

        notificationConnection.on("ReceiveNotification", function (notification) {
            console.log("New Notification Received:", notification);
            
            // 1. Update Badge
            [document.getElementById('notificationButton'), document.getElementById('notificationButtonMobile')].forEach(button => {
                if (!button) return;
                let badge = button.querySelector('span');
                if (!badge) {
                    badge = document.createElement('span');
                    badge.className = "absolute top-2 right-2 w-2.5 h-2.5 bg-rose-500 rounded-full border-2 border-white animate-pulse";
                    button.appendChild(badge);
                }
            });

            // 2. Add to Dropdown
            let dropdown = document.getElementById('notificationDropdown');
            let container = dropdown.querySelector('.max-h-\\[400px\\] .p-2') || dropdown.querySelector('.max-h-\\[400px\\]');
            
            // Remove "Empty State" if it exists
            const emptyState = dropdown.querySelector('.px-6.py-12');
            if (emptyState) {
                emptyState.remove();
                container = document.createElement('div');
                container.className = "p-2 space-y-1";
                dropdown.querySelector('.max-h-\\[400px\\]').appendChild(container);
            }

            const newNoteHtml = `
                <div onclick="markAsRead(${notification.id})" class="p-4 hover:bg-blue-50/50 rounded-2xl transition-all cursor-pointer flex gap-4 group relative bg-white">
                    <div class="absolute left-2 top-1/2 -translate-y-1/2 w-1 h-8 bg-blue-600 rounded-full"></div>
                    <div class="w-12 h-12 rounded-2xl bg-${notification.color}-50 text-${notification.color}-600 border border-${notification.color}-100 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform">
                        <i data-lucide="${notification.icon}" class="w-6 h-6"></i>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between mb-0.5">
                            <p class="text-sm font-black text-gray-900 truncate pr-2">${notification.title}</p>
                            <span class="text-[10px] font-bold text-gray-400 whitespace-nowrap">Just now</span>
                        </div>
                        <p class="text-[11px] text-gray-500 font-medium leading-relaxed line-clamp-2">${notification.content}</p>
                    </div>
                </div>
            `;
            
            container.insertAdjacentHTML('afterbegin', newNoteHtml);
            lucide.createIcons();

            // 3. Update Unread Count Text
            const unreadText = dropdown.querySelector('p.text-\\[10px\\]');
            if (unreadText) {
                let currentCount = parseInt(unreadText.textContent) || 0;
                unreadText.textContent = (currentCount + 1) + ' Unread Messages';
            }

            // 4. Play notification sound (optional)
            // new Audio('/sounds/notification.mp3').play();
        });

        notificationConnection.start().catch(err => console.error("Notification Hub Connection Error:", err));
    </script>
    <!-- Content Initializer Logic -->
    <script>
        function revealContent(delay = 800) {
            // Speed up the loading feel
            setTimeout(function() {
                // Hide all skeletons
                document.querySelectorAll('.skeleton-loader').forEach(function(el) {
                    el.style.display = 'none';
                });
                
                // Show all real content with a fade-in effect
                document.querySelectorAll('.page-content').forEach(function(el) {
                    el.classList.remove('hidden');
                    el.classList.add('animate-fade-in'); 
                });
            }, delay);
        }

        document.addEventListener("DOMContentLoaded", function() {
            revealContent(1000); // Initial load can be slightly slower for "impact"
            updateBottomNavVisibility(window.location.href);
            updateMessagesLayout(window.location.href);
        });
    </script>
    <style>
        .page-content.hidden {
            display: none;
        }
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(4px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-fade-in {
            animation: fadeIn 0.4s ease-out forwards;
        }
    </style>
    <script>
        function showToast(message, type = 'success') {
            const toast = document.createElement('div');
            toast.className = `fixed bottom-24 left-1/2 -translate-x-1/2 px-6 py-3 rounded-2xl text-white font-bold text-xs uppercase tracking-widest shadow-2xl z-[200] animate-in slide-in-from-bottom duration-300 ${type === 'success' ? 'bg-emerald-500' : type === 'info' ? 'bg-blue-500' : 'bg-rose-500'}`;
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.classList.add('opacity-0', 'transition-opacity', 'duration-300');
                setTimeout(() => toast.remove(), 300);
            }, 2000);
        }

        // --- Custom Confirmation Modal ---
        window.confirmModal = {
            callback: null,
            show(options = {}) {
                const { title = 'Are you sure?', message = 'This action cannot be undone.', confirmText = 'Confirm', cancelText = 'Cancel', type = 'rose' } = options;
                const modal = document.getElementById('globalConfirmModal');
                const overlay = document.getElementById('globalConfirmOverlay');
                
                modal.querySelector('[data-modal-title]').textContent = title;
                modal.querySelector('[data-modal-message]').textContent = message;
                const confirmBtn = modal.querySelector('[data-modal-confirm]');
                confirmBtn.textContent = confirmText;
                confirmBtn.className = `px-6 py-3 rounded-2xl text-xs font-black uppercase tracking-widest text-white transition-all shadow-lg active:scale-95 ${type === 'rose' ? 'bg-rose-600 hover:bg-rose-700 shadow-rose-500/20' : 'bg-blue-600 hover:bg-blue-700 shadow-blue-500/20'}`;
                
                overlay.classList.remove('hidden');
                setTimeout(() => {
                    overlay.classList.remove('opacity-0');
                    modal.classList.remove('opacity-0', 'scale-95', 'translate-y-4');
                }, 10);
                
                return new Promise((resolve) => {
                    this.callback = resolve;
                });
            },
            hide(result) {
                const modal = document.getElementById('globalConfirmModal');
                const overlay = document.getElementById('globalConfirmOverlay');
                
                modal.classList.add('opacity-0', 'scale-95', 'translate-y-4');
                overlay.classList.add('opacity-0');
                
                setTimeout(() => {
                    overlay.classList.add('hidden');
                    if (this.callback) this.callback(result);
                    this.callback = null;
                }, 300);
            }
        };
    </script>
    @* Scripts section moved inside main to support AJAX swapping *@
    <!-- Global Custom Confirmation Modal -->
    <div id="globalConfirmOverlay" class="hidden fixed inset-0 z-[1000] flex items-center justify-center p-4 bg-gray-900/40 backdrop-blur-sm opacity-0 transition-opacity duration-300">
        <div id="globalConfirmModal" class="relative w-full max-w-sm bg-white rounded-[2.5rem] shadow-2xl p-8 text-center opacity-0 scale-95 translate-y-4 transition-all duration-300 border border-white/50">
            <div class="w-20 h-20 bg-rose-50 rounded-[2rem] flex items-center justify-center mx-auto mb-6 text-rose-500">
                <i data-lucide="alert-circle" class="w-10 h-10"></i>
            </div>
            <h3 data-modal-title class="text-xl font-black text-gray-900 mb-2">Confirm Action</h3>
            <p data-modal-message class="text-gray-500 text-sm font-medium mb-8 leading-relaxed"></p>
            <div class="grid grid-cols-2 gap-4">
                <button onclick="confirmModal.hide(false)" class="px-6 py-3 bg-gray-50 text-gray-400 rounded-2xl text-xs font-black uppercase tracking-widest hover:bg-gray-100 transition-all active:scale-95">
                    Cancel
                </button>
                <button onclick="confirmModal.hide(true)" data-modal-confirm class="px-6 py-3 bg-rose-600 text-white rounded-2xl text-xs font-black uppercase tracking-widest hover:bg-rose-700 transition-all shadow-lg shadow-rose-500/20 active:scale-95">
                    Confirm
                </button>
            </div>
        </div>
    </div>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js');
            });
        }
    </script>
    @await Html.PartialAsync("_GlobalCallOverlay")
</body>
</html>
