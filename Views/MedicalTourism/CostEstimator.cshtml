@model MedLinkPortal.Models.PatientDashboardModel

@{
    ViewData["Title"] = "AI Cost Estimator";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="relative min-h-[calc(100vh-100px)] -mt-6 -mx-8 px-8 py-10 overflow-hidden">
    <!-- Cinematic Background Layer -->
    <div class="absolute inset-0 pointer-events-none select-none overflow-hidden">
        <div class="absolute top-[10%] left-[5%] w-[600px] h-[600px] bg-blue-100/30 rounded-full blur-[120px] animate-pulse"></div>
        <div class="absolute bottom-[10%] right-[5%] w-[500px] h-[500px] bg-indigo-100/20 rounded-full blur-[100px] animate-pulse delay-1000"></div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto space-y-12">
        <!-- Header -->
        <div class="text-center space-y-4">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-blue-50 border border-blue-100 text-blue-600 text-[10px] font-black uppercase tracking-[0.3em]">
                <i data-lucide="calculator" class="w-3 h-3"></i>
                AI-Powered Comparison
            </div>
            <h1 class="text-5xl font-black text-slate-900 tracking-tighter">Treatment <span class="text-blue-600">Cost Estimator</span></h1>
            <p class="text-slate-500 font-medium max-w-2xl mx-auto">Compare global treatment costs and save up to 70% on world-class healthcare with MedLink.</p>
        </div>

        <!-- Estimator Tool -->
        <div class="bg-white rounded-[40px] p-8 md:p-12 shadow-2xl shadow-slate-200/50 border border-slate-100">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
                <!-- Selection Panel -->
                <div class="space-y-8">
                    <div class="space-y-4">
                        <label class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Select Treatment Type</label>
                        <select id="treatmentSelect" class="w-full px-6 py-4 bg-slate-50 border-none rounded-2xl font-bold text-slate-900 focus:ring-2 focus:ring-blue-500 transition-all cursor-pointer">
                            <option value="dental">Dental Implants (Full Mouth)</option>
                            <option value="cardiac">Cardiac Bypass Surgery</option>
                            <option value="knee">Knee Replacement</option>
                            <option value="laser">LASIK Eye Surgery (Both Eyes)</option>
                            <option value="cosmetic">Rhinoplasty</option>
                            <option value="ivf">IVF Treatment Cycle</option>
                        </select>
                    </div>

                    <div class="p-8 bg-blue-600 rounded-[32px] text-white space-y-6 relative overflow-hidden group">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -mr-16 -mt-16 group-hover:scale-150 transition-transform duration-700"></div>
                        <h3 class="text-xl font-black leading-tight relative z-10">Why prices vary?</h3>
                        <p class="text-blue-100 text-sm font-medium leading-relaxed relative z-10">
                            Costs vary due to local economic factors, labor costs, and facility overheads. 
                            MedLink guarantees top-tier accredited hospitals regardless of the price point.
                        </p>
                        <div class="flex items-center gap-4 relative z-10">
                            <i data-lucide="shield-check" class="w-6 h-6 text-blue-300"></i>
                            <span class="text-xs font-black uppercase tracking-widest text-blue-200">ISO Accredited Care</span>
                        </div>
                    </div>
                </div>

                <!-- Results Panel -->
                <div class="bg-slate-50 rounded-[32px] p-8 space-y-6">
                    <h3 class="text-lg font-black text-slate-900 border-b border-slate-200 pb-4">Estimated Global Costs</h3>
                    
                    <div id="resultsContainer" class="space-y-4">
                        <!-- Dynamic Results via JS -->
                    </div>

                    <div class="pt-6 border-t border-slate-200">
                        <a href="@Url.Action("RequestInbound")" class="w-full flex items-center justify-center gap-3 px-8 py-5 bg-slate-900 text-white rounded-2xl font-black text-xs uppercase tracking-[0.2em] hover:bg-blue-600 transition-all shadow-xl group">
                            <span>Get My Custom Quote</span>
                            <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const data = {
        dental: { 'USA': 25000, 'UK': 18000, 'Turkey': 7000, 'Pakistan': 4500 },
        cardiac: { 'USA': 150000, 'UK': 45000, 'Turkey': 15000, 'Pakistan': 8000 },
        knee: { 'USA': 40000, 'UK': 15000, 'Turkey': 8500, 'Pakistan': 5000 },
        laser: { 'USA': 5000, 'UK': 4000, 'Turkey': 1500, 'Pakistan': 800 },
        cosmetic: { 'USA': 12000, 'UK': 8000, 'Turkey': 3500, 'Pakistan': 2000 },
        ivf: { 'USA': 15000, 'UK': 10000, 'Turkey': 5000, 'Pakistan': 3000 }
    };

    function updateEstimates() {
        const treatment = document.getElementById('treatmentSelect').value;
        const container = document.getElementById('resultsContainer');
        if(!container) return;
        const estimates = data[treatment];
        
        container.innerHTML = '';
        
        Object.entries(estimates).forEach(([country, price], index) => {
            const isPakistan = country === 'Pakistan';
            const percentage = Math.round((price / estimates['USA']) * 100);
            
            const div = document.createElement('div');
            div.className = `p-4 rounded-2xl flex items-center justify-between animate-in slide-in-from-bottom duration-500 delay-${index * 100} ${isPakistan ? 'bg-blue-100 border border-blue-200' : 'bg-white border border-slate-100'}`;
            
            div.innerHTML = `
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-black ${isPakistan ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-500'}">
                        ${country.charAt(0)}
                    </div>
                    <div>
                        <p class="text-sm font-black text-slate-900">${country}</p>
                        <div class="w-32 h-1.5 bg-slate-100 rounded-full mt-1 overflow-hidden">
                            <div class="h-full ${isPakistan ? 'bg-blue-500' : 'bg-slate-300'}" style="width: ${percentage}%"></div>
                        </div>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-lg font-black ${isPakistan ? 'text-blue-700' : 'text-slate-900'}">$${price.toLocaleString()}</p>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-tighter">${isPakistan ? 'Best Value' : 'EST. AVG COST'}</p>
                </div>
            `;
            container.appendChild(div);
        });
    }

    document.getElementById('treatmentSelect').addEventListener('change', updateEstimates);
    updateEstimates();
    lucide.createIcons();
</script>
