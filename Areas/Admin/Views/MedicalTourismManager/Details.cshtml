@model MedLinkPortal.Models.MedicalTourismRequest

@{
    ViewData["Title"] = "Request Details";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Lucide Icons Script -->
<script src="https://unpkg.com/lucide@latest"></script>

<div class="p-8 max-w-7xl mx-auto animate-in fade-in duration-700">
    <!-- Header: Refined navigation and status -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 mb-12">
        <div class="flex items-center gap-5">
            <a asp-action="Index" class="w-12 h-12 rounded-2xl bg-white border border-slate-100 flex items-center justify-center text-slate-400 hover:text-slate-900 hover:shadow-md transition-all">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
            </a>
            <div>
                <div class="flex items-center gap-3 mb-1">
                    <h1 class="text-3xl font-semibold text-slate-900 tracking-tight">Case #@Model.Id.ToString("D5")</h1>
                    @if(Model.RequestType == MedLinkPortal.Models.TourismRequestType.Inbound) {
                        <div class="px-3 py-1 bg-emerald-50 text-emerald-700 rounded-lg border border-emerald-100 flex items-center gap-2">
                            <i data-lucide="plane-landing" class="w-3.5 h-3.5"></i>
                            <span class="text-[10px] font-semibold uppercase tracking-wider">Inbound Journey</span>
                        </div>
                    } else {
                        <div class="px-3 py-1 bg-blue-50 text-blue-700 rounded-lg border border-blue-100 flex items-center gap-2">
                            <i data-lucide="plane-takeoff" class="w-3.5 h-3.5"></i>
                            <span class="text-[10px] font-semibold uppercase tracking-wider">Outbound Journey</span>
                        </div>
                    }
                </div>
                <p class="text-slate-400 font-medium text-sm flex items-center gap-2">
                    <i data-lucide="calendar" class="w-4 h-4"></i>
                    Initiated on @Model.CreatedAt.ToString("MMMM dd, yyyy")
                </p>
            </div>
        </div>
        
        <div class="bg-white p-2 rounded-[24px] shadow-sm border border-slate-100 flex items-center gap-2">
             <form asp-action="UpdateStatus" class="flex gap-2">
                <input type="hidden" name="id" value="@Model.Id" />
                <div class="relative">
                    <select name="status" class="bg-slate-50 border-none text-slate-700 text-xs font-semibold uppercase tracking-widest rounded-xl focus:ring-2 focus:ring-blue-500/20 block px-4 py-3 pr-10 appearance-none cursor-pointer">
                        @foreach(var status in Enum.GetValues(typeof(MedLinkPortal.Models.RequestStatus)))
                        {
                            var isSelected = Model.Status.ToString() == status.ToString() ? "selected" : "";
                            @Html.Raw($"<option value='{status}' {isSelected}>{status.ToString().ToUpper()}</option>")
                        }
                    </select>
                    <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="chevron-down" class="w-4 h-4"></i>
                    </div>
                </div>
                <button type="submit" class="bg-slate-900 hover:bg-black text-white px-5 py-3 rounded-xl font-bold text-xs uppercase tracking-widest transition-all active:scale-95">
                    Update Workflow
                </button>
            </form>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Main Content Column -->
        <div class="lg:col-span-2 space-y-8">
            
            <!-- Request Info Bento Card -->
            <div class="bg-white rounded-[32px] p-10 shadow-[0_20px_50px_rgba(0,0,0,0.04)] border border-slate-100 relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-8 opacity-[0.03] group-hover:opacity-[0.07] transition-opacity pointer-events-none">
                    <i data-lucide="file-text" class="w-32 h-32"></i>
                </div>
                
                <h3 class="text-[11px] font-semibold text-slate-400 tracking-[0.2em] uppercase mb-10 flex items-center gap-3">
                    <span class="w-6 h-px bg-slate-200"></span>
                    Patient Inquiry Details
                    <span class="w-6 h-px bg-slate-200"></span>
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
                    <div class="flex gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-500 flex-shrink-0">
                            <i data-lucide="activity" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Target Treatment</p>
                            <p class="text-lg font-bold text-slate-900">@Model.TreatmentType</p>
                        </div>
                    </div>
                    
                    <div class="flex gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center text-indigo-500 flex-shrink-0">
                            <i data-lucide="wallet" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Financial Range</p>
                            <p class="text-lg font-bold text-slate-900">@Model.BudgetRange</p>
                        </div>
                    </div>

                    <div class="flex gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-amber-50 flex items-center justify-center text-amber-500 flex-shrink-0">
                            <i data-lucide="map-pin" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Source Location</p>
                            <p class="text-lg font-bold text-slate-900">@Model.SourceCountry</p>
                        </div>
                    </div>

                    <div class="flex gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-rose-50 flex items-center justify-center text-rose-500 flex-shrink-0">
                            <i data-lucide="navigation-2" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Target Destination</p>
                            <p class="text-lg font-bold text-slate-900">@Model.PreferredCity, @Model.PreferredCountry</p>
                        </div>
                    </div>
                    
                    @if(Model.RequestType == MedLinkPortal.Models.TourismRequestType.Inbound)
                    {
                        <div class="flex gap-4">
                            <div class="w-12 h-12 rounded-2xl bg-emerald-50 flex items-center justify-center text-emerald-500 flex-shrink-0">
                                <i data-lucide="users" class="w-6 h-6"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Party Format</p>
                                <p class="text-lg font-bold text-slate-900">@(Model.TravelWithFamily ? "Family Group" : "Solo Traveler")</p>
                            </div>
                        </div>
                        <div class="md:col-span-2 bg-slate-50 p-6 rounded-3xl mt-2">
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2">
                                <i data-lucide="palmtree" class="w-3.5 h-3.5"></i>
                                Preferred Tour Locations
                            </p>
                            <div class="flex flex-wrap gap-2">
                                @if(!string.IsNullOrEmpty(Model.InterestedTourLocations))
                                {
                                    foreach(var loc in Model.InterestedTourLocations?.Split(',') ?? Array.Empty<string>())
                                    {
                                        <span class="bg-white shadow-sm text-slate-600 text-xs font-bold px-4 py-2 rounded-xl border border-slate-100">@loc.Trim()</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-slate-400 font-medium italic text-sm">No specific tours requested.</span>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if(!string.IsNullOrEmpty(Model.AdditionalNotes))
                {
                    <div class="mt-12 pt-10 border-t border-slate-50 flex gap-4">
                         <div class="w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center text-slate-400 flex-shrink-0">
                            <i data-lucide="message-square" class="w-5 h-5"></i>
                        </div>
                        <div>
                             <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-3">Clinician Notes & Context</p>
                             <div class="text-slate-600 bg-slate-50/50 p-6 rounded-[24px] text-sm leading-relaxed border border-slate-100 italic">
                                 "@Model.AdditionalNotes"
                             </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Package Proposal Bento Card -->
            <div class="bg-slate-900 rounded-[32px] p-10 shadow-[0_30px_60px_rgba(15,23,42,0.15)] overflow-hidden relative">
                <div class="absolute top-0 right-0 p-10 text-white/5 pointer-events-none">
                    <i data-lucide="gem" class="w-48 h-48"></i>
                </div>
                
                <h3 class="text-[11px] font-semibold text-white/40 tracking-[0.2em] uppercase mb-10 flex items-center gap-3">
                    <span class="w-6 h-px bg-white/10"></span>
                    Service Package Proposal
                    <span class="w-6 h-px bg-white/10"></span>
                </h3>

                @if(Model.AssignedPackage != null)
                {
                    <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-[32px] p-8 text-white relative">
                        <div class="flex flex-col md:flex-row justify-between md:items-center gap-6 mb-10">
                            <div>
                                <h4 class="text-2xl font-semibold mb-1">Proposed Itinerary</h4>
                                <p class="text-white/50 text-sm font-medium">Drafted and sent to patient for review.</p>
                            </div>
                            <div class="bg-blue-600 px-6 py-4 rounded-2xl flex flex-col items-end">
                                <span class="text-[10px] font-semibold uppercase tracking-[0.2em] opacity-60">Estimated Total</span>
                                <span class="text-xl font-semibold">PKR @Model.AssignedPackage.TotalPrice.ToString("N0")</span>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div class="space-y-4">
                                <div class="flex items-center gap-4 group">
                                    <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-white group-hover:bg-blue-500 transition-colors">
                                        <i data-lucide="hospital" class="w-5 h-5"></i>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-[10px] font-semibold uppercase text-white/40 mb-0.5">Facility</span>
                                        <span class="font-bold">@(Model.AssignedPackage.Hospital?.Name ?? "Selected Facility")</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4 group">
                                    <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-white group-hover:bg-blue-500 transition-colors">
                                        <i data-lucide="user-round" class="w-5 h-5"></i>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-[10px] font-semibold uppercase text-white/40 mb-0.5">Primary Surgeon</span>
                                        <span class="font-bold">Dr. @(Model.AssignedPackage.Doctor?.Name ?? "Assigned Physician")</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="space-y-4">
                                <div class="flex items-center gap-4 group">
                                    <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-white group-hover:bg-blue-500 transition-colors">
                                        <i data-lucide="clock" class="w-5 h-5"></i>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-[10px] font-semibold uppercase text-white/40 mb-0.5">Treatment Loop</span>
                                        <span class="font-bold">@Model.AssignedPackage.TreatmentDuration</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4 group">
                                    <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-white group-hover:bg-blue-500 transition-colors">
                                        <i data-lucide="heart-pulse" class="w-5 h-5"></i>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-[10px] font-semibold uppercase text-white/40 mb-0.5">Recovery Phase</span>
                                        <span class="font-bold">@Model.AssignedPackage.RecoveryDays</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <form asp-action="CreatePackage" method="post" class="space-y-8">
                        <input type="hidden" name="requestId" value="@Model.Id" />
                        
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="space-y-2">
                                <label class="text-[10px] font-semibold text-white/40 uppercase tracking-widest ml-1">Assigned Hospital</label>
                                <select name="HospitalId" asp-items="ViewBag.Hospitals" class="w-full bg-white/5 border border-white/10 text-white rounded-2xl px-5 py-4 focus:ring-4 focus:ring-blue-500/20 outline-none transition-all font-bold appearance-none cursor-pointer"></select>
                            </div>
                            <div class="space-y-2">
                                <label class="text-[10px] font-semibold text-white/40 uppercase tracking-widest ml-1">Assigned Lead Doctor</label>
                                <select name="DoctorId" asp-items="ViewBag.Doctors" class="w-full bg-white/5 border border-white/10 text-white rounded-2xl px-5 py-4 focus:ring-4 focus:ring-blue-500/20 outline-none transition-all font-bold appearance-none cursor-pointer"></select>
                            </div>
                            
                            <div class="space-y-2">
                                <label class="text-[10px] font-semibold text-white/40 uppercase tracking-widest ml-1">Treatment Cycle (e.g. 5 Days)</label>
                                <input type="text" name="TreatmentDuration" placeholder="5 Days" class="w-full bg-white/5 border border-white/10 text-white rounded-2xl px-5 py-4 focus:ring-4 focus:ring-blue-500/20 outline-none transition-all font-bold" required />
                            </div>
                            <div class="space-y-2">
                                <label class="text-[10px] font-semibold text-white/40 uppercase tracking-widest ml-1">Recovery Phase (e.g. 14 Days)</label>
                                <input type="text" name="RecoveryDays" placeholder="14 Days" class="w-full bg-white/5 border border-white/10 text-white rounded-2xl px-5 py-4 focus:ring-4 focus:ring-blue-500/20 outline-none transition-all font-bold" required />
                            </div>

                            <div class="space-y-2">
                                <label class="text-[10px] font-semibold text-white/40 uppercase tracking-widest ml-1">Proposed Investment (PKR)</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none text-white/30">
                                        <span class="font-semibold text-xs">PKR</span>
                                    </div>
                                    <input type="number" name="TotalPrice" placeholder="500,000" class="w-full bg-white/5 border border-white/10 text-white rounded-2xl pl-16 pr-5 py-4 focus:ring-4 focus:ring-blue-500/20 outline-none transition-all font-semibold text-xl" required />
                                </div>
                            </div>
                            <div class="space-y-2">
                                <label class="text-[10px] font-semibold text-white/40 uppercase tracking-widest ml-1">Airport Concierge</label>
                                <select name="AirportPickup" class="w-full bg-white/5 border border-white/10 text-white rounded-2xl px-5 py-4 focus:ring-4 focus:ring-blue-500/20 outline-none transition-all font-bold appearance-none cursor-pointer">
                                    <option value="Included" class="text-slate-900">Standard Included</option>
                                    <option value="Not Included" class="text-slate-900">Patient Managed</option>
                                    <option value="Premium" class="text-slate-900">VIP Chauffeur Transfer</option>
                                </select>
                            </div>

                            <div class="col-span-2 space-y-2">
                                <label class="text-[10px] font-semibold text-white/40 uppercase tracking-widest ml-1">Comprehensive Tour Itinerary</label>
                                <textarea name="TourPlanDetails" rows="4" class="w-full bg-white/5 border border-white/10 text-white rounded-2xl px-5 py-4 focus:ring-4 focus:ring-blue-500/20 outline-none transition-all font-medium text-sm resize-none" placeholder="Day 1: Arrival & Briefing&#10;Day 2: Clinical Assessment&#10;Day 3: Procedure Day..."></textarea>
                            </div>
                            
                            <div class="col-span-2 space-y-2">
                                <label class="text-[10px] font-semibold text-white/40 uppercase tracking-widest ml-1">Hospitality & Accommodation</label>
                                <textarea name="HotelDetails" rows="2" class="w-full bg-white/5 border border-white/10 text-white rounded-2xl px-5 py-4 focus:ring-4 focus:ring-blue-500/20 outline-none transition-all font-medium text-sm resize-none" placeholder="E.g. Pearl Continental Executive Suite (7 Nights Post-Op Included)"></textarea>
                            </div>
                        </div>

                        <div class="flex justify-end pt-4">
                            <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-semibold py-5 px-10 rounded-2xl shadow-2xl shadow-blue-500/30 transition-all transform hover:-translate-y-1 active:scale-95 flex items-center gap-3">
                                <i data-lucide="send" class="w-5 h-5"></i>
                                <span>Dispatch Proposal to Patient</span>
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>

        <!-- Sidebar / Actions Column -->
        <div class="space-y-8">
            
            <!-- Patient Profile Card -->
            <div class="bg-white rounded-[32px] p-8 shadow-[0_20px_50px_rgba(0,0,0,0.04)] border border-slate-100">
                <h4 class="text-[11px] font-semibold text-slate-400 tracking-[0.2em] uppercase mb-8">Patient Profile</h4>
                <div class="flex items-center gap-4 mb-8">
                    <div class="w-16 h-16 bg-gradient-to-br from-slate-100 to-slate-50 rounded-2xl flex items-center justify-center text-slate-300 border border-slate-100">
                        <i data-lucide="user" class="w-8 h-8"></i>
                    </div>
                    <div>
                        <p class="text-[10px] font-semibold text-blue-500 uppercase tracking-widest mb-0.5">Verified User</p>
                        <p class="font-semibold text-slate-900 truncate max-w-[140px]" title="@Model.UserId">@Model.UserId</p>
                    </div>
                </div>
                
                <div class="space-y-3">
                    <a asp-area="Admin" asp-controller="Chat" asp-action="Messages" asp-route-patientId="@Model.UserId" class="w-full bg-slate-900 hover:bg-black text-white py-4 rounded-2xl text-xs font-semibold uppercase tracking-widest flex items-center justify-center gap-3 transition-all active:scale-95 shadow-lg shadow-slate-200">
                        <i data-lucide="mail" class="w-4 h-4"></i>
                        <span>Secure Messaging</span>
                    </a>
                    <a asp-action="ClinicalHistory" asp-route-userId="@Model.UserId" class="w-full bg-white border border-slate-100 text-slate-500 py-4 rounded-2xl text-xs font-semibold uppercase tracking-widest flex items-center justify-center gap-3 transition-all hover:bg-slate-50">
                        <i data-lucide="clipboard-list" class="w-4 h-4"></i>
                        <span>Clinical History</span>
                    </a>
                </div>
            </div>
            
            <!-- Documents Card -->
            <div class="bg-white rounded-[32px] p-8 shadow-[0_20px_50px_rgba(0,0,0,0.04)] border border-slate-100">
                <h4 class="text-[11px] font-semibold text-slate-400 tracking-[0.2em] uppercase mb-8">Case Documents</h4>
                 @if(!string.IsNullOrEmpty(Model.MedicalReportsUrl))
                 {
                     <a href="@Model.MedicalReportsUrl" target="_blank" class="flex flex-col gap-4 p-5 rounded-3xl border border-slate-100 hover:bg-slate-50 transition-all group">
                         <div class="w-12 h-12 bg-rose-50 text-rose-500 rounded-2xl flex items-center justify-center group-hover:scale-110 group-hover:bg-rose-500 group-hover:text-white transition-all shadow-sm">
                             <i data-lucide="file-text" class="w-6 h-6"></i>
                         </div>
                         <div>
                             <p class="text-sm font-semibold text-slate-900 mb-0.5">Clinical Dossier.pdf</p>
                             <div class="flex items-center gap-1.5 text-slate-400">
                                <span class="text-[10px] font-semibold uppercase tracking-widest">Medical Reports</span>
                                <span class="w-1 h-1 bg-slate-200 rounded-full"></span>
                                <span class="text-[10px] font-bold">PDF Format</span>
                             </div>
                         </div>
                         <div class="mt-2 text-blue-600 text-[11px] font-semibold uppercase tracking-widest flex items-center gap-1.5">
                             View Attachment
                             <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                         </div>
                     </a>
                 }
                 else
                 {
                     <div class="py-6 px-4 bg-slate-50 rounded-2xl border border-dotted border-slate-200 text-center">
                        <i data-lucide="folder-x" class="w-8 h-8 text-slate-200 mx-auto mb-3"></i>
                        <p class="text-xs text-slate-400 font-bold uppercase tracking-widest">No vault files active</p>
                     </div>
                 }
            </div>
        </div>
    </div>
</div>

<script>
    lucide.createIcons();
</script>
