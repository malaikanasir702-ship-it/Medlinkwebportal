@model MedLinkPortal.Models.PatientDashboardModel

@{
    ViewData["Title"] = "Go Abroad - Medical Tourism";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="max-w-6xl mx-auto space-y-12 py-6">
    <div class="text-center space-y-6 max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-6xl font-black text-slate-900 tracking-tight">Where to?</h1>
        <p class="text-xl text-slate-500 font-medium leading-relaxed">
            Select a destination for your treatment. We have established corridors with top medical institutions in these regions.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
        
        <!-- USA -->
        <a href="@Url.Action("RequestOutbound", new { destination = "USA" })" class="group relative h-[600px] rounded-[60px] overflow-hidden shadow-2xl transition-all duration-[1s] hover:-translate-y-4 hover:shadow-[0_80px_120px_-30px_rgba(0,0,0,0.4)] border-[12px] border-white ring-1 ring-slate-100">
            <img src="https://images.unsplash.com/photo-1485738422979-f5c462d49f74?q=80&w=2599&auto=format&fit=crop" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-[2s] ease-out" alt="USA">
            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors duration-700"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
            
            <div class="absolute top-10 left-10">
                <div class="w-16 h-16 rounded-3xl bg-white/20 backdrop-blur-2xl border border-white/30 flex items-center justify-center text-4xl shadow-2xl transform -rotate-6 group-hover:rotate-0 transition-transform duration-700">
                    🇺🇸
                </div>
            </div>

            <div class="absolute bottom-0 left-0 p-12 w-full">
                <span class="text-blue-400 text-[10px] font-black uppercase tracking-[0.3em] mb-2 block opacity-80">Tier 1 Destination</span>
                <h3 class="text-4xl lg:text-5xl font-black text-white mb-4 tracking-tighter">USA</h3>
                <p class="text-gray-300 font-medium text-base mb-8 leading-relaxed opacity-0 group-hover:opacity-100 transform translate-y-8 group-hover:translate-y-0 transition-all duration-700">
                    Access pioneering treatments in Oncology and Neurology at Mayo Clinic & Johns Hopkins.
                </p>
                <div class="inline-flex items-center gap-4 px-8 py-4 bg-white text-slate-900 rounded-2xl font-black text-xs uppercase tracking-widest group-hover:bg-blue-600 group-hover:text-white transition-all duration-500">
                    Start Application <i class="fas fa-arrow-right text-blue-500 group-hover:text-white"></i>
                </div>
            </div>
        </a>

        <!-- UK -->
        <a href="@Url.Action("RequestOutbound", new { destination = "UK" })" class="group relative h-[600px] rounded-[60px] overflow-hidden shadow-2xl transition-all duration-[1s] hover:-translate-y-4 hover:shadow-[0_80px_120px_-30px_rgba(0,0,0,0.4)] border-[12px] border-white ring-1 ring-slate-100">
            <img src="https://images.unsplash.com/photo-1513635269975-59663e0ac1ad?q=80&w=2670&auto=format&fit=crop" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-[2s] ease-out" alt="London">
            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors duration-700"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
            
             <div class="absolute top-10 left-10">
                <div class="w-16 h-16 rounded-3xl bg-white/20 backdrop-blur-2xl border border-white/30 flex items-center justify-center text-4xl shadow-2xl transform rotate-6 group-hover:rotate-0 transition-transform duration-700">
                    🇬🇧
                </div>
            </div>

            <div class="absolute bottom-0 left-0 p-12 w-full">
                <span class="text-indigo-400 text-[10px] font-black uppercase tracking-[0.3em] mb-2 block opacity-80">Royal Healthcare</span>
                <h3 class="text-4xl lg:text-5xl font-black text-white mb-4 tracking-tighter">UK</h3>
                <p class="text-gray-300 font-medium text-base mb-8 leading-relaxed opacity-0 group-hover:opacity-100 transform translate-y-8 group-hover:translate-y-0 transition-all duration-700">
                    Harley Street specialists and renowned NHS private wings for complex surgeries.
                </p>
                <div class="inline-flex items-center gap-4 px-8 py-4 bg-white text-slate-900 rounded-2xl font-black text-xs uppercase tracking-widest group-hover:bg-indigo-600 group-hover:text-white transition-all duration-500">
                    Start Application <i class="fas fa-arrow-right text-indigo-500 group-hover:text-white"></i>
                </div>
            </div>
        </a>

        <!-- Malaysia -->
        <a href="@Url.Action("RequestOutbound", new { destination = "Malaysia" })" class="group relative h-[600px] rounded-[60px] overflow-hidden shadow-2xl transition-all duration-[1s] hover:-translate-y-4 hover:shadow-[0_80px_120px_-30px_rgba(0,0,0,0.4)] border-[12px] border-white ring-1 ring-slate-100">
            <img src="https://images.unsplash.com/photo-1596422846543-75c6fc197f07?q=80&w=2664&auto=format&fit=crop" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-[2s] ease-out" alt="Malaysia">
            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors duration-700"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent"></div>
            
             <div class="absolute top-10 left-10">
                <div class="w-16 h-16 rounded-3xl bg-white/20 backdrop-blur-2xl border border-white/30 flex items-center justify-center text-4xl shadow-2xl transform -rotate-12 group-hover:rotate-0 transition-transform duration-700">
                    🇲🇾
                </div>
            </div>

            <div class="absolute bottom-0 left-0 p-12 w-full">
                <span class="text-emerald-400 text-[10px] font-black uppercase tracking-[0.3em] mb-2 block opacity-80">Elite Recovery</span>
                <h3 class="text-4xl lg:text-5xl font-black text-white mb-4 tracking-tighter">Malaysia</h3>
                <p class="text-gray-300 font-medium text-base mb-8 leading-relaxed opacity-0 group-hover:opacity-100 transform translate-y-8 group-hover:translate-y-0 transition-all duration-700">
                    The perfect balance of affordability and luxury healthcare. Ideal for elective procedures.
                </p>
                <div class="inline-flex items-center gap-4 px-8 py-4 bg-white text-slate-900 rounded-2xl font-black text-xs uppercase tracking-widest group-hover:bg-emerald-600 group-hover:text-white transition-all duration-500">
                    Start Application <i class="fas fa-arrow-right text-emerald-500 group-hover:text-white"></i>
                </div>
            </div>
        </a>

    </div>
</div>
