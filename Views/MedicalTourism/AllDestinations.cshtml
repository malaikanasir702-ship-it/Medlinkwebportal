@model MedLinkPortal.Models.PatientDashboardModel

@{
    ViewData["Title"] = "All Destinations";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<!-- Lucide Icons Script -->
<script src="https://unpkg.com/lucide@latest"></script>

<div class="space-y-12 pb-20">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-blue-50 border border-blue-100 text-blue-600 text-xs font-bold uppercase tracking-widest mb-6">
            <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
            Explore Pakistan
        </div>
        <h1 class="text-4xl lg:text-5xl font-black text-slate-900 tracking-tight mb-4">
            Curated <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">Recovery Retreats</span>
        </h1>
        <p class="text-slate-500 font-medium text-lg">
            Discover serene landscapes and historic wonders tailored for your post-treatment recovery and leisure.
        </p>
    </div>

    <!-- Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-8 auto-rows-[320px]">
        
        <!-- Large Item: Hunza (Spans 2x2) -->
        <div class="group relative md:col-span-2 md:row-span-2 rounded-[60px] overflow-hidden shadow-2xl transition-all duration-[1s] hover:-translate-y-4 hover:shadow-[0_80px_120px_-30px_rgba(0,0,0,0.4)] border-[12px] border-white ring-1 ring-slate-100 cursor-pointer">
            <img src="https://images.unsplash.com/photo-1722082933604-288a1c130475" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-[2s] ease-out" />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-90"></div>
            
            <div class="absolute top-10 right-10">
                <div class="w-16 h-16 rounded-3xl bg-white/20 backdrop-blur-2xl border border-white/30 flex items-center justify-center text-white shadow-2xl group-hover:bg-white group-hover:text-slate-900 transition-all duration-700">
                    <i data-lucide="arrow-up-right" class="w-8 h-8"></i>
                </div>
            </div>

            <div class="absolute bottom-0 left-0 p-12 w-full">
                <span class="inline-block px-4 py-2 bg-blue-600/90 backdrop-blur-md rounded-xl text-white text-[10px] font-black uppercase tracking-[0.2em] mb-4 shadow-xl">Top Recovery Pick</span>
                <h3 class="text-5xl font-black text-white mb-4 leading-tight tracking-tighter">Hunza Valley</h3>
                <p class="text-gray-300 font-medium text-lg leading-relaxed line-clamp-2 opacity-0 group-hover:opacity-100 transform translate-y-8 group-hover:translate-y-0 transition-all duration-700">Experience the "Shangri-La" of earth. Crystal clear lakes, ancient forts, and majestic peaks ideal for peaceful recovery.</p>
            </div>
        </div>

        <!-- Tall Item: Badshahi Mosque (Spans 1x2) -->
        <div class="group relative md:col-span-1 md:row-span-2 rounded-[60px] overflow-hidden shadow-2xl transition-all duration-[1s] hover:-translate-y-4 hover:shadow-[0_80px_120px_-30px_rgba(37,99,235,0.2)] border-[12px] border-white ring-1 ring-slate-100 cursor-pointer">
            <img src="https://images.unsplash.com/photo-1739356025140-f3a282df3c35" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-[2s] ease-out" />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-90"></div>
            
            <div class="absolute bottom-0 left-0 p-10 w-full">
                 <span class="text-blue-400 text-[10px] font-black uppercase tracking-[0.3em] mb-2 block opacity-80">Heritage</span>
                 <h3 class="text-3xl font-black text-white mb-2 leading-tight tracking-tight">Badshahi Mosque</h3>
                 <p class="text-white/70 text-sm font-medium">Lahore's Historic Heart</p>
            </div>
        </div>

        <!-- Standard Item: Faisal Mosque -->
        <div class="group relative md:col-span-1 rounded-[50px] overflow-hidden shadow-xl transition-all duration-700 hover:-translate-y-2 border-[10px] border-white ring-1 ring-slate-100 cursor-pointer">
            <img src="https://images.unsplash.com/photo-1635016288720-c52507b9a717" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/10 to-transparent opacity-80"></div>
             <div class="absolute bottom-0 left-0 p-8">
                 <h3 class="text-xl font-black text-white tracking-tight">Faisal Mosque</h3>
                 <p class="text-blue-300 text-[10px] font-black uppercase tracking-widest mt-1">Islamabad</p>
            </div>
        </div>

         <!-- Standard Item: Shangrila -->
        <div class="group relative md:col-span-1 rounded-[50px] overflow-hidden shadow-xl transition-all duration-700 hover:-translate-y-2 border-[10px] border-white ring-1 ring-slate-100 cursor-pointer">
            <img src="https://images.unsplash.com/photo-1587595431973-160d0d94add1" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/10 to-transparent opacity-80"></div>
             <div class="absolute bottom-0 left-0 p-8">
                 <h3 class="text-xl font-black text-white tracking-tight">Shangrila Resort</h3>
                 <p class="text-indigo-300 text-[10px] font-black uppercase tracking-widest mt-1">Skardu</p>
            </div>
        </div>
        
        <!-- Wide Item: Swat Valley (Spans 2x1) -->
        <div class="group relative md:col-span-2 rounded-[50px] overflow-hidden shadow-xl transition-all duration-700 hover:-translate-y-2 border-[10px] border-white ring-1 ring-slate-100 cursor-pointer">
            <img src="https://plus.unsplash.com/premium_photo-1697729690458-2d64ca777c04?q=80&w=1170&auto=format&fit=crop" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
            <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/20 to-transparent"></div>
             <div class="absolute inset-0 flex flex-col justify-end p-10">
                 <h3 class="text-3xl font-black text-white mb-2 tracking-tighter">Swat Valley</h3>
                 <p class="text-gray-300 text-base font-medium leading-relaxed max-w-sm">Known as the Switzerland of the East. Lush green forests and flowing rivers.</p>
            </div>
        </div>

         <!-- Standard Item: Naran -->
        <div class="group relative md:col-span-1 rounded-[50px] overflow-hidden shadow-xl transition-all duration-700 hover:-translate-y-2 border-[10px] border-white ring-1 ring-slate-100 cursor-pointer">
            <img src="https://images.unsplash.com/photo-1703913370366-f04ebc7da8c2?q=80&w=1170&auto=format&fit=crop" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
             <div class="absolute inset-0 bg-gradient-to-t from-black via-black/10 to-transparent opacity-80"></div>
             <div class="absolute bottom-0 left-0 p-8">
                 <h3 class="text-xl font-black text-white tracking-tight">Naran Kaghan</h3>
                 <p class="text-sky-300 text-[10px] font-black uppercase tracking-widest mt-1">Northern Areas</p>
            </div>
        </div>

        <!-- Standard Item: Beach -->
         <div class="group relative md:col-span-1 rounded-[50px] overflow-hidden shadow-xl transition-all duration-700 hover:-translate-y-2 border-[10px] border-white ring-1 ring-slate-100 cursor-pointer">
            <img src="https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1b/32/a9/2f/caption.jpg?w=600&h=600&s=1" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000" />
             <div class="absolute inset-0 bg-gradient-to-t from-black via-black/10 to-transparent opacity-80"></div>
             <div class="absolute bottom-0 left-0 p-8">
                 <h3 class="text-xl font-black text-white tracking-tight">Muree Lift</h3>
                 <p class="text-blue-300 text-[10px] font-black uppercase tracking-widest mt-1">Islamabad</p>
            </div>
        </div>

    </div>
</div>

<script>
    lucide.createIcons();
</script>
