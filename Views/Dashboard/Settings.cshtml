                            <i data-lucide="smartphone" class="w-4 h-4"></i>
                        </div>
                        Devices
                    </div>
                    <i data-lucide="chevron-right" x-show="activeTab === 'devices'" class="w-3.5 h-3.5 opacity-50"></i>
                </button>
            </nav>
        </div>
    </div>

    <!-- Content Area -->
    <div class="col-span-12 lg:col-span-9 space-y-6">
        <!-- Profile Tab -->
        <div x-show="activeTab === 'profile'" class="animate-fade-in space-y-6">
            <div class="bg-white rounded-[1.5rem] p-8 border border-gray-100 shadow-sm relative overflow-hidden">
