@model MedLinkPortal.Models.PharmacyOrder
@{
    ViewData["Title"] = "Order Details";
    Layout = "_PharmacistLayout";
}

@* Leaflet.js for patient location map *@
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="min-h-screen bg-slate-50/50 pb-20">
    <div class="max-w-4xl mx-auto px-4 py-8 lg:py-12">
        <!-- Header -->
        <div class="bg-white rounded-[2.5rem] p-8 md:p-10 border border-slate-100 shadow-xl mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div class="flex items-center gap-6">
                <a href="/Pharmacy/Dashboard" class="w-12 h-12 bg-slate-50 rounded-2xl flex items-center justify-center text-slate-400 hover:text-slate-900 border border-slate-100 transition-all">
                    <i data-lucide="arrow-left" class="w-5 h-5"></i>
                </a>
                <div>
                    <h1 class="text-2xl font-black text-slate-900 tracking-tight">Order #ORD-@Model.Id.ToString("D5")</h1>
                    <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mt-1">Patient ID: @Model.PatientId</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                 <span class="px-4 py-2 rounded-full text-[10px] font-black uppercase tracking-widest border bg-blue-50 text-blue-600 border-blue-100">@Model.Status</span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
            <!-- Prescription & Items -->
            <div class="md:col-span-8 space-y-8">
                <div class="bg-white rounded-[2.5rem] p-8 border border-slate-100 shadow-xl">
                    <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-6 flex items-center gap-2">
                        <i data-lucide="pill" class="text-blue-500 w-4 h-4"></i> Prescribed Medications
                    </h3>
                    <div class="space-y-4">
                        @foreach(var item in Model.OrderItems)
                        {
                            <div class="flex justify-between items-center p-5 bg-slate-50 rounded-2xl border border-slate-100 group hover:border-blue-200 transition-all">
                                <div class="flex items-center gap-4">
                                    <div class="w-10 h-10 bg-white rounded-xl flex items-center justify-center text-slate-400 group-hover:text-blue-500 shadow-sm transition-all border border-slate-50">
                                        <i data-lucide="pill" class="w-4 h-4"></i>
                                    </div>
                                    <div>
                                        <p class="font-bold text-slate-900">@item.Medicine.Name</p>
                                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Qty: @item.Quantity • Brand: @item.Medicine.Brand</p>
                                    </div>
                                </div>
                                <p class="font-black text-slate-900">PKR @(item.UnitPrice * item.Quantity)</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="bg-slate-900 rounded-[2.5rem] p-8 border border-white/5 shadow-2xl text-white">
                    <h3 class="text-xs font-black text-white/40 uppercase tracking-widest mb-6">Execution Protocol</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                         @if(Model.Status == PharmacyOrderStatus.Pending)
                         {
                             <button onclick="updateOrderStatus(@Model.Id, 1)" class="py-4 bg-emerald-600 text-white font-black text-xs rounded-2xl hover:bg-emerald-700 transition-all border border-emerald-500/50 shadow-xl shadow-emerald-600/20">Accept & Reserve Stock</button>
                             <button onclick="updateOrderStatus(@Model.Id, 5)" class="py-4 bg-white/5 text-rose-500 font-black text-xs rounded-2xl hover:bg-rose-500/10 transition-all border border-rose-500/20">Reject Order</button>
                         }
                         else if(Model.Status == PharmacyOrderStatus.Accepted)
                         {
                             <button onclick="updateOrderStatus(@Model.Id, 2)" class="py-4 bg-blue-600 text-white font-black text-xs rounded-2xl hover:bg-blue-700 transition-all shadow-xl shadow-blue-600/20">Mark as Packed</button>
                             <button onclick="updateOrderStatus(@Model.Id, 3)" class="py-4 bg-white/10 text-white font-black text-xs rounded-2xl hover:bg-white/20 transition-all">Move to Dispatch</button>
                         }
                         @if(Model.Status == PharmacyOrderStatus.Accepted || Model.Status == PharmacyOrderStatus.Packed)
                         {
                             <div class="col-span-2 mt-2 border-t border-white/10 pt-4">
                                 <p class="text-[10px] font-black text-white/50 uppercase tracking-widest mb-3">Assign Rider</p>
                                 <div class="flex gap-3">
                                     <select id="riderSelect" class="flex-1 py-3 px-4 bg-white/10 text-white rounded-xl border border-white/20 text-sm font-bold focus:outline-none focus:ring-2 focus:ring-blue-500">
                                         <option value="">Loading riders...</option>
                                     </select>
                                     <button onclick="assignRider(@Model.Id)" class="px-6 py-3 bg-blue-600 text-white font-black text-xs rounded-xl hover:bg-blue-700 transition-all shadow-lg shadow-blue-600/20">
                                         🏍 Assign
                                     </button>
                                 </div>
                             </div>
                         }
                    </div>
                </div>
            </div>

            <!-- Shipping & Info -->
            <div class="md:col-span-4 space-y-8">
                <div class="bg-white rounded-[2.5rem] p-8 border border-slate-100 shadow-xl">
                    <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-6">Shipping Intelligence</h3>
                    <div class="space-y-6">
                        <div>
                            <p class="text-[10px] font-black text-blue-600 uppercase tracking-widest mb-2">Delivery Address</p>
                            <p class="text-sm font-bold text-slate-700 leading-relaxed">@Model.ShippingAddress</p>
                        </div>
                        @if (Model.DestinationLatitude.HasValue && Model.DestinationLongitude.HasValue &&
                             Model.DestinationLatitude.Value != 0 && Model.DestinationLongitude.Value != 0)
                        {
                            <div class="mt-4">
                                <p class="text-[10px] font-black text-blue-600 uppercase tracking-widest mb-2">Patient Location</p>
                                <div id="patientMap" class="w-full h-48 rounded-2xl overflow-hidden border border-slate-100"></div>
                            </div>
                        }
                        <div>
                            <p class="text-[10px] font-black text-blue-600 uppercase tracking-widest mb-2">Payment</p>
                            <p class="text-sm font-bold text-slate-900 underline decoration-blue-500/30 decoration-2">@Model.PaymentMethod</p>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-[2.5rem] p-8 border border-slate-100 shadow-xl">
                    <div class="flex justify-between items-center mb-6">
                        <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest">Total Invoice</h3>
                        <i data-lucide="file-text" class="text-slate-200 w-5 h-5"></i>
                    </div>
                    <p class="text-4xl font-black text-slate-900 mb-2">PKR @Model.TotalAmount.ToString("N0")</p>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Inclusive of Platform Fees</p>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
async function updateOrderStatus(orderId, status) {
    if(!confirm("Proceed with this operation?")) return;
    const res = await fetch('/Pharmacy/UpdateOrderStatus', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ orderId, status })
    });
    const data = await res.json();
    if(data.success) window.location.reload();
    else alert("Error: " + data.message);
}

// Load available riders into dropdown
(function loadRiders() {
    const sel = document.getElementById('riderSelect');
    if (!sel) return;
    fetch('/Pharmacy/AvailableRiders')
        .then(r => r.json())
        .then(riders => {
            sel.innerHTML = riders.length
                ? riders.map(r => `<option value="${r.id}">${r.name} — ${r.vehicleType}</option>`).join('')
                : '<option value="">No riders available</option>';
        })
        .catch(() => { sel.innerHTML = '<option value="">Failed to load riders</option>'; });
})();

async function assignRider(orderId) {
    const sel = document.getElementById('riderSelect');
    const riderId = sel?.value;
    if (!riderId) { alert('Please select a rider'); return; }
    const token = document.querySelector('[name=__RequestVerificationToken]')?.value || '';
    const res = await fetch('/Pharmacy/AssignRider', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'RequestVerificationToken': token
        },
        body: JSON.stringify({ orderId: parseInt(orderId), riderId: parseInt(riderId) })
    });
    const data = await res.json();
    if (data.success) { alert('Rider assigned successfully!'); window.location.reload(); }
    else alert('Error: ' + (data.message || 'Failed to assign rider'));
}

document.addEventListener('DOMContentLoaded', () => {
    if (window.lucide) {
        lucide.createIcons();
    }

    @if (Model.DestinationLatitude.HasValue && Model.DestinationLongitude.HasValue &&
         Model.DestinationLatitude.Value != 0 && Model.DestinationLongitude.Value != 0)
    {
        <text>
    // Leaflet.js map for patient destination
    (function () {
        const mapEl = document.getElementById('patientMap');
        if (!mapEl || typeof L === 'undefined') return;
        const map = L.map('patientMap', { zoomControl: true })
            .setView([@Model.DestinationLatitude, @Model.DestinationLongitude], 15);
        L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; CARTO',
            subdomains: 'abcd'
        }).addTo(map);
        const icon = L.divIcon({
            html: '<div style="width:32px;height:32px;background:#DC2626;border-radius:50%;border:3px solid white;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(220,38,38,0.4);font-size:14px;">🏠</div>',
            iconSize: [32, 32],
            iconAnchor: [16, 16],
            className: ''
        });
        L.marker([@Model.DestinationLatitude, @Model.DestinationLongitude], { icon })
            .addTo(map)
            .bindPopup('Patient Location')
            .openPopup();
    })();
        </text>
    }
});
</script>
