@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Account Settings";
    ViewData["HeaderTitle"] = "Account Settings";
    ViewData["HeaderSubtitle"] = "Manage your profile, security, and preferences.";
}

@section Scripts {

    <script>
        document.addEventListener('alpine:init', () => {
             // Alpine 2 doesn't have alpine:init like Alpine 3, but this is safe
        });



        const VAPID_PUBLIC_KEY = '@Model.VapidPublicKey';
        console.log('MedLink Notification System: VAPID Public Key Loaded');

        function urlBase64ToUint8Array(base64String) {
            if (!base64String || base64String === '') return new Uint8Array(0);
            const padding = '='.repeat((4 - base64String.length % 4) % 4);
            const base64 = (base64String + padding).replace(/\-/g, '+').replace(/_/g, '/');
            const rawData = window.atob(base64);
            const outputArray = new Uint8Array(rawData.length);
            for (let i = 0; i < rawData.length; ++i) {
                outputArray[i] = rawData.charCodeAt(i);
            }
            return outputArray;
        }

        async function subscribeToPushNotifications() {
            if (!VAPID_PUBLIC_KEY || VAPID_PUBLIC_KEY === '') {
                console.error('VAPID Public Key is missing');
                return;
            }

            if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
                console.warn('Push notifications not supported');
                return;
            }

            try {
                console.log('Registering Service Worker (Busting Cache)...');
                const registration = await navigator.serviceWorker.register('/sw.js?v=' + Date.now());
                
                console.log('Clearing existing subscriptions...');
                const existing = await registration.pushManager.getSubscription();
                if (existing) {
                    await existing.unsubscribe();
                }

                console.log('Subscribing to Push Manager...');
                const subscription = await registration.pushManager.subscribe({
                    userVisibleOnly: true,
                    applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
                });

                console.log('Push Subscription successful:', subscription.endpoint);

                // Post subscription to server
                const res = await fetch('/Dashboard/SubscribeToPush', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        endpoint: subscription.endpoint,
                        p256dh: btoa(String.fromCharCode.apply(null, new Uint8Array(subscription.getKey('p256dh')))),
                        auth: btoa(String.fromCharCode.apply(null, new Uint8Array(subscription.getKey('auth'))))
                    })
                });
                
                const data = await res.json();
                console.log('Server response for subscription:', data);
                await checkSubscriptionStatus();
            } catch (err) {
                console.error('Push Subscription Error Details:', err);
                await PremiumModal.error('Could not enable desktop notifications: ' + err.message, 'Push Protocol Error');
                document.getElementById('notifPush').checked = false;
            }
        }

        async function checkSubscriptionStatus() {
            try {
                if (!('serviceWorker' in navigator)) return;
                const registration = await navigator.serviceWorker.ready;
                const subscription = await registration.pushManager.getSubscription();
                
                const statusEl = document.getElementById('subscriptionStatus');
                const pushToggle = document.getElementById('notifPush');
                
                if (statusEl) {
                    if (subscription) {
                        statusEl.innerHTML = '<span class="flex items-center gap-1.5 text-emerald-600"><span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span> REGISTERED</span>';
                        if (pushToggle) pushToggle.checked = true;
                    } else {
                        statusEl.innerHTML = '<span class="flex items-center gap-1.5 text-rose-600"><span class="w-1.5 h-1.5 bg-rose-500 rounded-full"></span> NOT REGISTERED</span>';
                        if (pushToggle) pushToggle.checked = false;
                    }
                }
            } catch (e) { console.error('Error checking subscription status:', e); }
        }

        // Check on load
        document.addEventListener('DOMContentLoaded', checkSubscriptionStatus);


        async function saveGenericSettings() {
            // Check if push just enabled
            const pushCheckbox = document.getElementById('notifPush');
            if (pushCheckbox.checked) {
                if (Notification.permission !== 'granted') {
                    const permission = await Notification.requestPermission();
                    if (permission === 'granted') {
                        await subscribeToPushNotifications();
                    } else {
                        pushCheckbox.checked = false;
                    }
                } else {
                    // Permission already granted, but let's ensure subscription is active on server
                    await subscribeToPushNotifications();
                }
            }

            const fd = new FormData();
            fd.append('fullName', document.getElementById('setFullName')?.value);
            fd.append('phone', document.getElementById('setPhone')?.value);
            fd.append('dob', document.getElementById('setDOB')?.value);
            fd.append('emailNotifications', document.getElementById('notifEmail')?.checked);
            fd.append('pushNotifications', document.getElementById('notifPush')?.checked);
            
            const btn = document.querySelector('.save-btn');
            const originalText = btn.innerText;
            btn.innerText = 'Saving...';
            btn.disabled = true;

            try {
                const res = await fetch('/Dashboard/UpdateSettings', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.success) {
                    btn.innerText = 'Saved ✓';
                    btn.classList.add('bg-emerald-600');
                    setTimeout(() => {
                        btn.innerText = originalText;
                        btn.classList.remove('bg-emerald-600');
                        btn.disabled = false;
                    }, 2000);
                }
            } catch (e) { 
                console.error(e); 
                btn.innerText = 'Error';
                btn.disabled = false;
            }
        }

        async function uploadProfilePhoto(input) {
            if (!input.files || !input.files[0]) return;
            
            const file = input.files[0];
            const fd = new FormData();
            fd.append('file', file);

            // Preview instantly
            const reader = new FileReader();
            reader.onload = e => document.getElementById('profilePreview').src = e.target.result;
            reader.readAsDataURL(file);

            try {
                const res = await fetch('/Dashboard/UpdateProfilePicture', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.success) {
                    // Success
                }
            } catch (e) { console.error(e); }
        }

        async function updatePassword() {
            const current = document.getElementById('currentPass').value;
            const next = document.getElementById('newPass').value;
            
            if (!current || !next) {
                await PremiumModal.alert('Please fill both fields to proceed with password rotation.', 'Missing Credentials');
                return;
            }

            const fd = new FormData();
            fd.append('currentPassword', current);
            fd.append('newPassword', next);

            try {
                const res = await fetch('/Dashboard/ChangePassword', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.success) {
                    await PremiumModal.success('Your security credentials have been updated successfully!', 'Security Updated');
                    document.getElementById('currentPass').value = '';
                    document.getElementById('newPass').value = '';
                } else {
                    await PremiumModal.error('Security update failed: ' + data.errors.join(', '), 'Commit Rejected');
                }
            } catch (e) { console.error(e); }
        }
    </script>
}

<div class="grid grid-cols-12 gap-6" x-data="{ 
    activeTab: 'profile', 
    show2FAModal: false, 
    targetSessionId: null, 
    targetSessionName: '', 
    verificationCode: '', 
    error2FA: '',
    async startSessionRevoke(id, name) {
        this.targetSessionId = id;
        this.targetSessionName = name;
        this.error2FA = '';
        this.verificationCode = '';

        try {
            const res = await fetch('/Dashboard/RequestSessionRevoke', { method: 'POST' });
            const data = await res.json();
            if (data.success) {
                this.show2FAModal = true;
            } else {
                await PremiumModal.error('Transmission failure: Error sending verification code.', 'Mail Protocol Error');
            }
        } catch (e) { console.error(e); }
    },
    async confirmRevoke() {
        if (this.verificationCode.length < 6) {
            this.error2FA = 'Please enter the 6-digit code';
            return;
        }

        const fd = new FormData();
        fd.append('code', this.verificationCode);
        fd.append('sessionId', this.targetSessionId);

        const url = this.targetSessionId === 'all' 
            ? '/Dashboard/RevokeAllSessions' 
            : '/Dashboard/VerifyAndRevokeSession';

        try {
            const res = await fetch(url, { method: 'POST', body: fd });
            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                this.error2FA = data.message || 'Invalid verification code';
            }
        } catch (e) { 
            console.error(e);
            this.error2FA = 'Server error occurred';
        }
    }
}">
