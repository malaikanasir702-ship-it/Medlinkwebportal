@model MedLinkPortal.Models.Hospital

@{
    ViewData["Title"] = Model.Name + " - Hospital Details";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Lucide Icons Script -->
<script src="https://unpkg.com/lucide@latest"></script>

<div class="p-8 max-w-6xl mx-auto animate-in fade-in slide-in-from-bottom-4 duration-700">
    <!-- Header Navigation -->
    <div class="mb-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div class="flex items-center gap-4">
            <a asp-action="Index" class="w-12 h-12 rounded-2xl bg-white border border-slate-100 flex items-center justify-center text-slate-400 hover:text-slate-900 hover:border-slate-300 transition-all shadow-sm group">
                <i data-lucide="arrow-left" class="w-5 h-5 group-hover:-translate-x-1 transition-transform"></i>
            </a>
            <div>
                <nav class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-widest text-slate-400 mb-1">
                    <a asp-action="Index" class="hover:text-blue-500 transition-colors">Directory</a>
                    <i data-lucide="chevron-right" class="w-3 h-3"></i>
                    <span class="text-slate-900">Hospital Profile</span>
                </nav>
                <h1 class="text-3xl font-semibold text-slate-900 tracking-tight">@Model.Name</h1>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="px-6 py-3 rounded-2xl bg-white border border-slate-200 text-slate-900 hover:bg-slate-50 transition-all font-bold flex items-center gap-2 shadow-sm">
                <i data-lucide="edit-3" class="w-4 h-4"></i>
                <span>Edit Profile</span>
            </a>
            <button class="px-6 py-3 rounded-2xl bg-rose-50 border border-rose-100 text-rose-600 hover:bg-rose-100 transition-all font-bold flex items-center gap-2 shadow-sm">
                <i data-lucide="trash-2" class="w-4 h-4"></i>
                <span>Delete</span>
            </button>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Left Column: Primary Info -->
        <div class="lg:col-span-2 space-y-8">
            
            <!-- Hero Card -->
            <div class="bg-white rounded-[32px] overflow-hidden shadow-[0_30px_60px_rgba(0,0,0,0.06)] border border-slate-100">
                <div class="relative h-64 md:h-80 w-full bg-slate-100">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="w-full h-full object-cover" />
                    }
                    else
                    {
                        <div class="w-full h-full flex items-center justify-center text-slate-300">
                            <i data-lucide="image" class="w-20 h-20"></i>
                        </div>
                    }
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                    <div class="absolute bottom-8 left-8 right-8 flex items-end justify-between">
                        <div>
                            @if (Model.IsVerified)
                            {
                                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500 text-white text-[10px] font-semibold uppercase tracking-widest mb-3 shadow-lg shadow-blue-500/30">
                                    <i data-lucide="verified" class="w-3 h-3"></i>
                                    <span>Verified Partner</span>
                                </div>
                            }
                            <h2 class="text-3xl font-semibold text-white">Clinical Center</h2>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="flex flex-col items-center">
                                <span class="text-[10px] font-bold text-white/60 uppercase">Rating</span>
                                <span class="text-xl font-semibold text-white">4.9/5</span>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="p-8 md:p-12">
                    <h3 class="text-[11px] uppercase tracking-[0.2em] font-semibold text-slate-400 mb-6">About the Institution</h3>
                    <p class="text-slate-600 text-lg leading-relaxed font-medium">
                        @Model.Description
                    </p>
                </div>
            </div>

            <!-- Specialized Services -->
            <div class="bg-white rounded-[32px] p-8 md:p-12 shadow-[0_30px_60px_rgba(0,0,0,0.04)] border border-slate-100">
                <h3 class="text-[11px] uppercase tracking-[0.2em] font-semibold text-slate-400 mb-8">Clinical Specialties</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @if (!string.IsNullOrEmpty(Model.Specialties))
                    {
                        @foreach (var specialty in Model.Specialties.Split(','))
                        {
                            <div class="flex items-center gap-4 p-5 rounded-2xl bg-slate-50 border border-slate-100 group hover:bg-blue-50 hover:border-blue-100 transition-all">
                                <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center text-blue-500 shadow-sm transition-transform group-hover:scale-110">
                                    <i data-lucide="check-circle-2" class="w-6 h-6"></i>
                                </div>
                                <span class="font-bold text-slate-900 capitalize">@specialty.Trim()</span>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-slate-400 italic font-medium">No specialties listed yet.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Sidebar Meta -->
        <div class="space-y-8">
            
            <!-- Location Card -->
            <div class="bg-slate-900 rounded-[32px] p-8 text-white shadow-2xl shadow-slate-900/20">
                <h3 class="text-[10px] uppercase tracking-[0.2em] font-semibold text-white/30 mb-8">Global Location</h3>
                <div class="space-y-6">
                    <div class="flex items-center gap-5">
                        <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center text-white border border-white/10">
                            <i data-lucide="map-pin" class="w-7 h-7"></i>
                        </div>
                        <div>
                            <p class="text-[10px] font-semibold text-blue-400 uppercase tracking-widest mb-1">City Hub</p>
                            <p class="text-xl font-semibold">@Model.City</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-5">
                        <div class="w-14 h-14 rounded-2xl bg-white/10 flex items-center justify-center text-white border border-white/10">
                            <i data-lucide="globe" class="w-7 h-7"></i>
                        </div>
                        <div>
                            <p class="text-[10px] font-semibold text-blue-400 uppercase tracking-widest mb-1">Operation Country</p>
                            <p class="text-xl font-semibold">@Model.Country</p>
                        </div>
                    </div>
                </div>
                
                <div class="mt-10 pt-8 border-t border-white/10">
                    <button class="w-full bg-blue-600 hover:bg-blue-500 text-white py-4 rounded-2xl font-semibold text-xs uppercase tracking-widest transition-all flex items-center justify-center gap-3">
                        <i data-lucide="phone-call" class="w-4 h-4"></i>
                        Connect with Admin
                    </button>
                </div>
            </div>

            <!-- Stats Card -->
            <div class="bg-white rounded-[32px] p-8 shadow-[0_20px_50px_rgba(0,0,0,0.04)] border border-slate-100">
                <h3 class="text-[11px] uppercase tracking-[0.2em] font-semibold text-slate-400 mb-8">Clinical Insights</h3>
                <div class="space-y-1">
                    <div class="flex items-center justify-between p-4 rounded-2xl hover:bg-slate-50 transition-colors">
                        <span class="text-sm font-bold text-slate-500 lowercase">Assigned Case Load</span>
                        <span class="text-lg font-semibold text-slate-900">24</span>
                    </div>
                    <div class="flex items-center justify-between p-4 rounded-2xl hover:bg-slate-50 transition-colors">
                        <span class="text-sm font-bold text-slate-500 lowercase">Active Surgeons</span>
                        <span class="text-lg font-semibold text-slate-900">12</span>
                    </div>
                    <div class="flex items-center justify-between p-4 rounded-2xl hover:bg-slate-50 transition-colors">
                        <span class="text-sm font-bold text-slate-500 lowercase">Verification Date</span>
                        <span class="text-lg font-semibold text-slate-900">Dec 2025</span>
                    </div>
                </div>
            </div>
            
            <!-- Quick Actions -->
            <div class="p-4 bg-blue-50 rounded-[32px] border border-blue-100">
                <a href="#" class="flex items-center justify-between p-6 rounded-2xl bg-white shadow-sm border border-blue-100 group hover:shadow-md transition-all">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 bg-blue-500 rounded-xl flex items-center justify-center text-white group-hover:rotate-12 transition-transform">
                            <i data-lucide="file-text" class="w-5 h-5"></i>
                        </div>
                        <span class="font-bold text-slate-900">Download License</span>
                    </div>
                    <i data-lucide="chevron-right" class="w-5 h-5 text-slate-300 group-hover:text-blue-500 transition-colors"></i>
                </a>
            </div>

        </div>
    </div>
</div>

<script>
    lucide.createIcons();
</script>
