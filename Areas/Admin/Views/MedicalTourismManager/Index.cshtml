@model IEnumerable<MedLinkPortal.Models.MedicalTourismRequest>

@{
    ViewData["Title"] = "Tourism Requests";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<!-- Lucide Icons Script -->
<script src="https://unpkg.com/lucide@latest"></script>

<div class="p-8 max-w-[1600px] mx-auto animate-in fade-in duration-700">
    <div class="mb-10">
        <h1 class="text-3xl font-semibold text-slate-900 tracking-tight mb-2">Tourism Case Navigator</h1>
        <p class="text-slate-500 font-medium">Coordinate international patient journeys and manage inbound/outbound requests.</p>
    </div>

    <div class="bg-white rounded-[32px] shadow-[0_20px_50px_rgba(0,0,0,0.04)] border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/50 text-slate-400 text-[11px] uppercase tracking-[0.2em] font-semibold border-b border-slate-100">
                        <th class="px-8 py-6">Timeline & Reference</th>
                        <th class="px-8 py-6">Patient Identifier</th>
                        <th class="px-8 py-6">Pathway</th>
                        <th class="px-8 py-6">Procedure / Destination</th>
                        <th class="px-8 py-6">Current Status</th>
                        <th class="px-8 py-6 text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @foreach (var item in Model) {
                        <tr class="group hover:bg-slate-50/50 transition-all duration-300">
                            <td class="px-8 py-6">
                                <div class="flex flex-col">
                                    <span class="text-slate-900 font-bold">@item.CreatedAt.ToString("MMM dd, yyyy")</span>
                                    <span class="text-slate-400 text-[10px] font-semibold uppercase tracking-widest mt-1">@item.CreatedAt.ToString("HH:mm")</span>
                                </div>
                            </td>
                            <td class="px-8 py-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-400 group-hover:bg-blue-50 group-hover:text-blue-500 transition-colors">
                                        <i data-lucide="user" class="w-5 h-5"></i>
                                    </div>
                                    <div class="flex flex-col">
                                        <span class="text-slate-700 font-bold text-sm">Case #@item.Id.ToString("D5")</span>
                                        <span class="text-slate-400 text-xs font-medium truncate max-w-[150px]" title="@item.UserId">... @item.UserId.ToString().Substring(Math.Max(0, item.UserId.Length - 8))</span>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-6">
                                @if(item.RequestType == MedLinkPortal.Models.TourismRequestType.Inbound) {
                                    <div class="flex items-center gap-2 px-3 py-1 bg-emerald-50 text-emerald-700 rounded-lg border border-emerald-100 w-fit">
                                        <i data-lucide="plane-landing" class="w-3.5 h-3.5"></i>
                                        <span class="text-[10px] font-semibold uppercase tracking-wider">Inbound</span>
                                    </div>
                                } else {
                                    <div class="flex items-center gap-2 px-3 py-1 bg-blue-50 text-blue-700 rounded-lg border border-blue-100 w-fit">
                                        <i data-lucide="plane-takeoff" class="w-3.5 h-3.5"></i>
                                        <span class="text-[10px] font-semibold uppercase tracking-wider">Outbound</span>
                                    </div>
                                }
                            </td>
                            <td class="px-8 py-6">
                                <div class="flex flex-col">
                                    <span class="text-slate-800 font-bold">@item.TreatmentType</span>
                                    <div class="flex items-center gap-1.5 text-slate-400 text-xs mt-1 font-medium">
                                        <i data-lucide="map-pin" class="w-3 h-3"></i>
                                        <span>@item.PreferredCity, @item.PreferredCountry</span>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-6">
                                <div class="px-3 py-1.5 rounded-full text-[10px] font-semibold uppercase tracking-widest border w-fit shadow-sm
                                      @(item.Status == MedLinkPortal.Models.RequestStatus.Pending ? "bg-amber-50 text-amber-700 border-amber-100" : 
                                        item.Status == MedLinkPortal.Models.RequestStatus.PackagePrepared ? "bg-purple-50 text-purple-700 border-purple-100" :
                                        item.Status == MedLinkPortal.Models.RequestStatus.TreatmentCompleted ? "bg-emerald-50 text-emerald-700 border-emerald-100" : 
                                        "bg-slate-50 text-slate-700 border-slate-200")">
                                    @item.Status.ToString().Replace("([A-Z])", " $1").Trim()
                                </div>
                            </td>
                            <td class="px-8 py-6 text-right">
                                <a asp-action="Details" asp-route-id="@item.Id" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-100 text-slate-700 font-bold text-xs rounded-xl hover:bg-slate-900 hover:text-white hover:border-slate-900 transition-all duration-300 shadow-sm group/btn active:scale-95">
                                    <span>Manage Case</span>
                                    <i data-lucide="arrow-right" class="w-3.5 h-3.5 group-hover/btn:translate-x-1 transition-transform"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (!Model.Any()) {
            <div class="py-24 text-center">
                <div class="w-20 h-20 bg-slate-50 rounded-[24px] flex items-center justify-center text-slate-200 mx-auto mb-6">
                    <i data-lucide="file-search" class="w-10 h-10"></i>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-1">No Requests Queued</h3>
                <p class="text-slate-500 font-medium">Patients who seek medical tourism will appear here.</p>
            </div>
        }
    </div>
</div>

<script>
    lucide.createIcons();
</script>
