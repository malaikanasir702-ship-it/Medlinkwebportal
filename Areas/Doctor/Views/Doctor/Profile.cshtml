@model MedLinkPortal.Areas.Doctor.Controllers.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
}

<div class="max-w-7xl mx-auto py-6 lg:py-10 space-y-8 lg:space-y-12 reveal">
    <!-- Profile Header: High Fidelity -->
    <div class="relative group">
        <div class="absolute -inset-1 bg-gradient-to-r from-blue-600 to-indigo-600 rounded-[36px] lg:rounded-[44px] blur opacity-25 group-hover:opacity-40 transition duration-1000 group-hover:duration-200"></div>
        <div class="relative h-auto lg:h-72 rounded-[32px] lg:rounded-[40px] overflow-hidden bg-slate-900 border border-white/10 shadow-2xl">
            <!-- Dynamic Background -->
            <div class="absolute inset-0 bg-gradient-to-br from-blue-600/20 via-transparent to-indigo-600/20"></div>
            <div class="absolute top-0 right-0 p-10 opacity-10 hidden md:block">
                <i class="fas fa-microscope text-[180px] text-white"></i>
            </div>
            
            <div class="relative w-full p-6 lg:p-10 bg-gradient-to-t from-slate-900 via-slate-900/80 to-slate-900/0 flex flex-col md:flex-row items-center md:items-end justify-between gap-6 lg:gap-8 pt-20 lg:pt-10">
                <div class="flex flex-col md:flex-row items-center md:items-end gap-6 lg:gap-8 text-center md:text-left">
                    <div class="relative shrink-0">
                        <div class="w-28 h-28 lg:w-36 lg:h-36 rounded-3xl bg-white p-1.5 shadow-2xl shadow-blue-500/20 transform hover:-rotate-3 transition-transform duration-500 mx-auto md:mx-0">
                                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                                {
                                    <img src="~/@Model.ProfilePictureUrl" alt="Profile" class="w-full h-full object-cover rounded-2xl" />
                                }
                                else
                                {
                                    <div class="w-full h-full rounded-2xl bg-gradient-to-br from-blue-50 to-slate-100 flex items-center justify-center text-blue-600 text-4xl lg:text-5xl font-semibold">
                                        @(!string.IsNullOrEmpty(Model.Name) ? Model.Name.Substring(0, 1).ToUpper() : "D")
                                    </div>
                                }
                        </div>
                        <div class="absolute -bottom-2 -right-2 w-8 h-8 lg:w-10 lg:h-10 bg-emerald-500 border-4 border-slate-900 rounded-2xl flex items-center justify-center text-white text-[10px] lg:text-xs shadow-lg">
                            <i class="fas fa-check"></i>
                        </div>
                    </div>
                    <div class="mb-2 w-full">
                        <div class="flex flex-col md:flex-row items-center gap-2 lg:gap-3 mb-3 lg:mb-2">
                            <h2 class="text-2xl lg:text-4xl font-semibold text-white tracking-tighter">Dr. @Model.Name</h2>
                            @if (Model.CompletionPercentage == 100)
                            {
                                <span class="px-3 py-1 bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-[10px] font-semibold rounded-lg uppercase tracking-widest">Complete</span>
                            }
                            else
                            {
                                <span class="px-3 py-1 bg-amber-500/20 border border-amber-500/30 text-amber-400 text-[10px] font-semibold rounded-lg uppercase tracking-widest">Incomplete</span>
                            }
                        </div>
                        <!-- Progress Bar -->
                        <div class="w-full max-w-[250px] mx-auto md:mx-0">
                            <div class="flex justify-between items-center mb-1">
                                <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Profile Completion</span>
                                <span class="text-[10px] font-semibold text-white">@Model.CompletionPercentage%</span>
                            </div>
                            <div class="w-full bg-white/10 rounded-full h-1.5">
                                <div class="bg-gradient-to-r from-blue-500 to-indigo-500 h-1.5 rounded-full transition-all duration-1000" style="width: @Model.CompletionPercentage%"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Status/Warning -->
                <div class="flex flex-col items-center md:items-end gap-2 mb-0 lg:mb-4 w-full md:w-auto">
                     @if (Model.CompletionPercentage < 100)
                     {
                        <div class="flex items-center gap-2 lg:gap-3 px-4 py-2 bg-amber-500/10 border border-amber-500/20 rounded-xl animate-pulse w-full md:w-auto justify-center md:justify-start">
                            <i class="fas fa-exclamation-triangle text-amber-500 text-xs"></i>
                            <span class="text-[10px] font-bold text-amber-400 uppercase tracking-wider">Approval blocked</span>
                        </div>
                     }
                     else if (Model.ApprovalStatus == "Pending")
                     {
                         <div class="flex items-center gap-2 lg:gap-3 px-4 py-2 bg-blue-500/10 border border-blue-500/20 rounded-xl w-full md:w-auto justify-center md:justify-start">
                            <i class="fas fa-clock text-blue-500 text-xs"></i>
                            <span class="text-[10px] font-bold text-blue-400 uppercase tracking-wider">Pending Approval</span>
                        </div>
                     }
                    <div class="hidden md:block text-right">
                        <p class="text-[10px] font-semibold text-slate-500 uppercase tracking-widest mt-2">Operational Hash</p>
                        <p class="text-xs font-mono text-slate-400 font-bold bg-white/5 px-3 py-1.5 rounded-lg border border-white/5 inline-block mt-1">0x71C...ED34</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10">
        <!-- Sidebar Perspective -->
        <div class="lg:col-span-12 xl:col-span-4 space-y-6 lg:space-y-8">
            <div class="premium-card p-6 lg:p-8">
                <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-6">Verification Layer</h3>
                <div class="space-y-4 lg:space-y-6">
                    <div class="flex items-center justify-between p-4 bg-slate-50 dark:bg-white/5 rounded-2xl border border-transparent hover:border-blue-100/50 transition-all">
                        <div>
                            <p class="text-xs font-semibold text-emerald-500 uppercase tracking-tighter">MDC Status</p>
                            <p class="text-sm font-semibold text-slate-900 dark:text-white mt-1">Identity Verified</p>
                        </div>
                        <i class="fas fa-fingerprint text-emerald-500 text-xl opacity-50"></i>
                    </div>
                    <div class="flex items-center justify-between p-4 hover:bg-slate-50 dark:hover:bg-white/5 rounded-2xl transition-all border border-transparent">
                        <div>
                            <p class="text-xs font-semibold text-slate-500 uppercase tracking-tighter">Registration</p>
                            <p class="text-sm font-semibold text-slate-800 dark:text-white mt-1">Active Since 2024</p>
                        </div>
                        <i class="fas fa-calendar-check text-slate-300 transform group-hover:rotate-12 transition-transform"></i>
                    </div>
                </div>
                
                <div class="mt-8 pt-6 border-t border-slate-100 dark:border-white/5">
                    <div class="flex items-center gap-4 group cursor-help">
                        <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-600 shrink-0">
                            <i class="fas fa-shield-halved text-sm transition-transform group-hover:scale-110"></i>
                        </div>
                        <p class="text-[10px] font-bold text-slate-500 leading-relaxed uppercase tracking-tight">Your data is governed by<br/><span class="text-blue-600 font-semibold">HIPAA Compliance Level 4</span></p>
                    </div>
                </div>
            </div>

            <!-- Pro Insights -->
            <div class="bg-slate-900 rounded-[32px] p-8 relative overflow-hidden group hidden xl:block">
                <div class="absolute -right-10 -bottom-10 opacity-20 transform group-hover:scale-110 transition-transform duration-700">
                    <i class="fas fa-dna text-[150px] text-white"></i>
                </div>
                <div class="relative z-10">
                    <p class="text-[10px] font-semibold text-blue-500 uppercase tracking-widest mb-3">Professional Quotient</p>
                    <h4 class="text-xl font-semibold text-white tracking-tight leading-tight">Elite Tier<br/>Status Pending</h4>
                    <p class="text-xs font-medium text-slate-500 mt-4 leading-relaxed">Expand your diagnostic profile to unlock cross-institutional patient referrals.</p>
                    <a asp-action="OptimizeProfile" class="w-full mt-10 py-4 bg-white text-slate-900 font-semibold text-xs rounded-2xl hover:opacity-90 transition-all flex items-center justify-center group/btn text-decoration-none">
                        Optimize Profile <i class="fas fa-chevron-right ml-3 text-[10px] group-hover/btn:translate-x-1 transition-transform"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- System Configuration Forms -->
        <div class="lg:col-span-12 xl:col-span-8 space-y-8 lg:space-y-10">
            @if (TempData["StatusMessage"] != null)
            {
                <div class="p-5 bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 rounded-2xl text-xs font-semibold flex items-center shadow-xl shadow-emerald-500/5 animate-in slide-in-from-top-4 duration-500">
                    <div class="w-8 h-8 rounded-lg bg-emerald-500 text-white flex items-center justify-center mr-4 shrink-0">
                        <i class="fas fa-check"></i>
                    </div>
                    @TempData["StatusMessage"]
                </div>
            }

            <form asp-action="Profile" method="post" enctype="multipart/form-data" class="space-y-10">
                @Html.AntiForgeryToken()
                
                <!-- Section 1: Personal Information -->
                <div class="premium-card p-10 space-y-10">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-blue-50 flex items-center justify-center text-blue-600 dark:bg-blue-900/20">
                            <i class="fas fa-user-doctor text-lg"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold text-slate-900 dark:text-white tracking-tight">Personal Information</h3>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-1">Identity & Bio-data</p>
                        </div>
                    </div>

                    <div asp-validation-summary="ModelOnly" class="text-red-500 text-xs font-bold bg-red-50 p-4 rounded-xl"></div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-3">
                            <label asp-for="Name" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Full Name (As per CNIC)</label>
                            <div class="relative">
                                <input asp-for="Name" class="premium-input w-full pl-12 pr-6" placeholder="Full Name" />
                                <i class="fas fa-id-card absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="Name" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                        <div class="space-y-3">
                            <label asp-for="FatherHusbandName" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Father / Husband Name</label>
                            <div class="relative">
                                <input asp-for="FatherHusbandName" class="premium-input w-full pl-12 pr-6" placeholder="Father or Husband Name" />
                                <i class="fas fa-user-group absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="FatherHusbandName" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                        <div class="space-y-3">
                            <label asp-for="Gender" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Gender</label>
                            <div class="relative">
                                <select asp-for="Gender" class="premium-input w-full pl-12 pr-6 appearance-none bg-transparent">
                                    <option value="">Select Gender</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                                <i class="fas fa-venus-mars absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="Gender" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                        <div class="space-y-3">
                            <label asp-for="CNIC" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">CNIC Number</label>
                            <div class="relative">
                                <input asp-for="CNIC" class="premium-input w-full pl-12 pr-6" placeholder="xxxxx-xxxxxxx-x" />
                                <i class="fas fa-fingerprint absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="CNIC" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>
                        
                         <div class="space-y-3 md:col-span-2">
                            <label asp-for="ProfilePicture" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Profile Photo (Passport Size)</label>
                            <div class="relative">
                                <input asp-for="ProfilePicture" type="file" accept="image/*" class="premium-input w-full pl-12 pr-6 pt-3" />
                                <i class="fas fa-camera absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                             @if(!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                            {
                                 <p class="text-[10px] text-emerald-500 font-bold mt-1 ml-1"><i class="fas fa-check mr-1"></i> Current photo uploaded</p>
                            }
                            <span asp-validation-for="ProfilePicture" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Contact Information -->
                <div class="premium-card p-10 space-y-10">
                     <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-50 flex items-center justify-center text-indigo-600 dark:bg-indigo-900/20">
                            <i class="fas fa-address-book text-lg"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold text-slate-900 dark:text-white tracking-tight">Contact Information</h3>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-1">Connectivity Details</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-3">
                            <label asp-for="PhoneNumber" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Mobile Number</label>
                            <div class="relative">
                                <input asp-for="PhoneNumber" class="premium-input w-full pl-12 pr-6" placeholder="03XXXXXXXXX" />
                                <i class="fas fa-mobile-screen absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                        <div class="space-y-3">
                            <label asp-for="Email" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Email Address</label>
                            <div class="relative">
                                <input asp-for="Email" class="premium-input w-full pl-12 pr-6" />
                                <i class="fas fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="Email" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                        <div class="space-y-3 md:col-span-2">
                             <label asp-for="ResidentialAddress" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Residential Address</label>
                            <div class="relative">
                                <input asp-for="ResidentialAddress" class="premium-input w-full pl-12 pr-6" placeholder="House #, Street, Area" />
                                <i class="fas fa-house absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="ResidentialAddress" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                        <div class="space-y-3">
                            <label asp-for="City" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">City</label>
                            <div class="relative">
                                <input asp-for="City" class="premium-input w-full pl-12 pr-6" />
                                <i class="fas fa-city absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                             <span asp-validation-for="City" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                         <div class="space-y-3">
                            <label asp-for="Province" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Province</label>
                            <div class="relative">
                                <input asp-for="Province" class="premium-input w-full pl-12 pr-6" />
                                <i class="fas fa-map absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                             <span asp-validation-for="Province" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Professional Information -->
                <div class="premium-card p-10 space-y-10">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-purple-50 flex items-center justify-center text-purple-600 dark:bg-purple-900/20">
                            <i class="fas fa-briefcase-medical text-lg"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold text-slate-900 dark:text-white tracking-tight">Professional Information</h3>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-1">Qualifications & Experience</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                         <div class="space-y-3">
                            <label asp-for="PMDCRegistrationNumber" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">PMDC Registration No.</label>
                            <div class="relative">
                                <input asp-for="PMDCRegistrationNumber" class="premium-input w-full pl-12 pr-6" />
                                <i class="fas fa-registered absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="PMDCRegistrationNumber" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                        <div class="space-y-3">
                            <label asp-for="PMDCValidityDate" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">PMDC Validity Date</label>
                            <div class="relative">
                                <input asp-for="PMDCValidityDate" type="date" class="premium-input w-full pl-12 pr-6" />
                                <i class="fas fa-calendar absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="PMDCValidityDate" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>
                        
                        <div class="space-y-3">
                            <label asp-for="Specialist" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Specialization</label>
                            <div class="relative">
                                <input asp-for="Specialist" class="premium-input w-full pl-12 pr-6" placeholder="e.g. Cardiologist" />
                                <i class="fas fa-heart-pulse absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="Specialist" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                        <div class="space-y-3">
                            <label asp-for="Qualification" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Qualification</label>
                            <div class="relative">
                                <input asp-for="Qualification" class="premium-input w-full pl-12 pr-6" placeholder="e.g. MBBS, FCPS" />
                                <i class="fas fa-graduation-cap absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="Qualification" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                         <div class="space-y-3">
                            <label asp-for="Experience" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Years of Experience</label>
                            <div class="relative">
                                <input asp-for="Experience" class="premium-input w-full pl-12 pr-6" placeholder="e.g. 5 Years" />
                                <i class="fas fa-business-time absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="Experience" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                         <div class="space-y-3">
                            <label asp-for="Workplace" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Workplace / Clinic Name</label>
                            <div class="relative">
                                <input asp-for="Workplace" class="premium-input w-full pl-12 pr-6" placeholder="e.g. City Medical Center" />
                                <i class="fas fa-hospital absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="Workplace" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                        <div class="space-y-3">
                            <label asp-for="ClinicAddress" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Clinic Street Address</label>
                            <div class="relative">
                                <input asp-for="ClinicAddress" class="premium-input w-full pl-12 pr-6" placeholder="e.g. 123 Health Ave, Medical District" />
                                <i class="fas fa-map-location absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="ClinicAddress" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                        <!-- Professional Branding -->
                        <div class="space-y-3 md:col-span-2">
                             <label asp-for="Description" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Professional Summary</label>
                            <div class="relative">
                                <textarea asp-for="Description" class="premium-input w-full pl-12 pr-6 py-4 min-h-[120px]" placeholder="Provide a dynamic professional summary for your profile..."></textarea>
                                <i class="fas fa-pen-nib absolute left-4 top-6 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="Description" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                         <div class="space-y-3">
                            <label asp-for="Expertise" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Expertise Areas (Comma Separated)</label>
                            <div class="relative">
                                <input asp-for="Expertise" class="premium-input w-full pl-12 pr-6" placeholder="e.g. Heart Surgery, Pediatrics" />
                                <i class="fas fa-microscope absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                        </div>

                        <div class="space-y-3">
                            <label asp-for="HospitalAffiliations" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Hospital Affiliations (Comma Separated)</label>
                            <div class="relative">
                                <input asp-for="HospitalAffiliations" class="premium-input w-full pl-12 pr-6" placeholder="e.g. City Hospital, Mayo Clinic" />
                                <i class="fas fa-building-ngo absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                        </div>

                        <div class="space-y-3 md:col-span-2">
                            <label asp-for="ClinicMapUrl" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Clinic Google Maps Embed URL (IFrame Source)</label>
                            <div class="relative">
                                <input asp-for="ClinicMapUrl" class="premium-input w-full pl-12 pr-6" placeholder="https://www.google.com/maps/embed?..." />
                                <i class="fas fa-map-location-dot absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <div class="mt-4 p-5 bg-blue-600/5 rounded-2xl border border-blue-500/20">
                                <p class="text-[10px] font-semibold text-blue-600 uppercase tracking-widest mb-2 flex items-center gap-2">
                                    <i class="fas fa-info-circle"></i> How to get your Map link?
                                </p>
                                <ol class="text-[10px] text-slate-500 space-y-1 font-bold">
                                    <li>1. Search for your clinic on <a href="https://maps.google.com" target="_blank" class="text-blue-600 hover:underline">Google Maps</a></li>
                                    <li>2. Click the <b>"Share"</b> button</li>
                                    <li>3. Select the <b>"Embed a map"</b> tab</li>
                                    <li>4. Copy ONLY the URL inside the <b>src="..."</b> attribute and paste it above</li>
                                </ol>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 4: Document Verification -->
                <div class="premium-card p-10 space-y-10">
                     <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-amber-50 flex items-center justify-center text-amber-600 dark:bg-amber-900/20">
                            <i class="fas fa-file-shield text-lg"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold text-slate-900 dark:text-white tracking-tight">Document Verification</h3>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-1">Upload Required Documents</p>
                        </div>
                    </div>

                    <div class="space-y-3">
                        <div class="p-4 rounded-xl bg-amber-50 text-amber-800 text-xs font-medium border border-amber-200">
                             <i class="fas fa-info-circle mr-2"></i> Only clear/scanned images (JPG, PNG) or PDF are allowed. Max size 2MB.
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <!-- CNIC Front -->
                        <div class="space-y-3">
                            <label asp-for="CNICFront" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">CNIC Front</label>
                            <div class="relative">
                                <input asp-for="CNICFront" type="file" class="premium-input w-full pl-12 pr-6 pt-3" />
                                <i class="fas fa-id-card absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                             @if(!string.IsNullOrEmpty(Model.CNICFrontUrl))
                            {
                                 <p class="text-[10px] text-emerald-500 font-bold mt-1 ml-1"><i class="fas fa-check mr-1"></i> Uploaded</p>
                            }
                            <span asp-validation-for="CNICFront" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                         <!-- CNIC Back -->
                        <div class="space-y-3">
                            <label asp-for="CNICBack" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">CNIC Back</label>
                            <div class="relative">
                                <input asp-for="CNICBack" type="file" class="premium-input w-full pl-12 pr-6 pt-3" />
                                <i class="fas fa-id-card absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            @if(!string.IsNullOrEmpty(Model.CNICBackUrl))
                            {
                                 <p class="text-[10px] text-emerald-500 font-bold mt-1 ml-1"><i class="fas fa-check mr-1"></i> Uploaded</p>
                            }
                            <span asp-validation-for="CNICBack" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                        <!-- PMDC Certificate -->
                        <div class="space-y-3">
                            <label asp-for="PMDCCertificate" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">PMDC Certificate</label>
                            <div class="relative">
                                <input asp-for="PMDCCertificate" type="file" class="premium-input w-full pl-12 pr-6 pt-3" />
                                <i class="fas fa-certificate absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                             @if(!string.IsNullOrEmpty(Model.PMDCCertificateUrl))
                            {
                                 <p class="text-[10px] text-emerald-500 font-bold mt-1 ml-1"><i class="fas fa-check mr-1"></i> Uploaded</p>
                            }
                            <span asp-validation-for="PMDCCertificate" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                        <!-- Degree Certificate -->
                         <div class="space-y-3">
                            <label asp-for="DegreeCertificate" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Degree Certificate</label>
                            <div class="relative">
                                <input asp-for="DegreeCertificate" type="file" class="premium-input w-full pl-12 pr-6 pt-3" />
                                <i class="fas fa-scroll absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                             @if(!string.IsNullOrEmpty(Model.DegreeCertificateUrl))
                            {
                                 <p class="text-[10px] text-emerald-500 font-bold mt-1 ml-1"><i class="fas fa-check mr-1"></i> Uploaded</p>
                            }
                            <span asp-validation-for="DegreeCertificate" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 5: Financial & Legal -->
                <div class="premium-card p-10 space-y-10">
                     <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-50 flex items-center justify-center text-emerald-600 dark:bg-emerald-900/20">
                            <i class="fas fa-file-contract text-lg"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold text-slate-900 dark:text-white tracking-tight">Financial & Administrative</h3>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-1">Fees & Consent</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                         <div class="space-y-3">
                            <label asp-for="ConsultationFee" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Online Consultation Fee (PKR)</label>
                            <div class="relative">
                                <input asp-for="ConsultationFee" type="number" step="0.01" class="premium-input w-full pl-12 pr-6" />
                                <i class="fas fa-money-bill-wave absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="ConsultationFee" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                         <div class="space-y-3">
                            <label asp-for="BankAccountNumber" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Bank Account / IBAN</label>
                            <div class="relative">
                                <input asp-for="BankAccountNumber" class="premium-input w-full pl-12 pr-6" placeholder="PK..." />
                                <i class="fas fa-building-columns absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="BankAccountNumber" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>
                    </div>

                    <div class="pt-6 border-t border-slate-100 dark:border-white/5">
                        <label class="flex items-start gap-3 cursor-pointer group">
                            <input asp-for="TermsConsent" type="checkbox" class="mt-1 w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 transition-colors" />
                            <div class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed font-medium group-hover:text-slate-800 transition-colors">
                                I hereby declare that the information provided is true and correct. I agree to the <a href="#" class="text-blue-600 font-bold hover:underline">Terms of Service</a> and <a href="#" class="text-blue-600 font-bold hover:underline">Privacy Policy</a> of MedLink Portal. I understand that my profile will be reviewed by the administration before going live.
                            </div>
                        </label>
                        <span asp-validation-for="TermsConsent" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                    </div>
                </div>

                 <!-- Section 6: Security -->
                <div class="premium-card p-10 space-y-10">
                     <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-2xl bg-slate-900 flex items-center justify-center text-white">
                            <i class="fas fa-lock text-lg"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold text-slate-900 dark:text-white tracking-tight">Security Settings</h3>
                            <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mt-1">Password Update</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                         <div class="space-y-3 md:col-span-2">
                             <label asp-for="CurrentPassword" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Current Password (Required for Changes)</label>
                            <div class="relative">
                                <input asp-for="CurrentPassword" type="password" class="premium-input w-full pl-12 pr-6" />
                                <i class="fas fa-key absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>

                         <div class="space-y-3">
                            <label asp-for="NewPassword" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">New Password</label>
                            <div class="relative">
                                <input asp-for="NewPassword" type="password" class="premium-input w-full pl-12 pr-6" />
                                <i class="fas fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                             <span asp-validation-for="NewPassword" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>
                        
                         <div class="space-y-3">
                            <label asp-for="ConfirmPassword" class="text-[10px] font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-widest ml-1">Confirm New Password</label>
                            <div class="relative">
                                <input asp-for="ConfirmPassword" type="password" class="premium-input w-full pl-12 pr-6" />
                                <i class="fas fa-shield absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            </div>
                             <span asp-validation-for="ConfirmPassword" class="text-red-500 text-[10px] font-semibold uppercase ml-1"></span>
                        </div>
                    </div>
                </div>

                <div class="pt-6 flex flex-col md:flex-row items-center justify-end gap-6">
                    <a asp-action="DoctorDashBoard" class="px-8 py-4 text-[11px] font-semibold text-slate-400 uppercase tracking-widest hover:text-slate-900 dark:hover:text-white transition-colors">Discard Vectors</a>
                    <button type="submit" class="w-full md:w-auto px-12 py-5 bg-blue-600 text-white rounded-[20px] text-xs font-semibold shadow-2xl shadow-blue-500/30 hover:bg-blue-700 active:scale-[0.98] transition-all uppercase tracking-widest">
                        Submit for Verification
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
