                                <div class="flex items-start gap-4">
                                    <div class="relative flex-shrink-0">
                                        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-500 to-cyan-400 flex items-center justify-center text-white overflow-hidden group-hover/card:scale-110 group-hover/card:rotate-3 transition-all duration-300 shadow-lg">
