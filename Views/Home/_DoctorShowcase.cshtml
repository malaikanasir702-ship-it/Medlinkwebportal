@model List<MedLinkPortal.Models.Doctor>

<section id="specialists" class="py-12 md:py-32 px-4 md:px-6 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto">
        <div class="doctor-showcase-header flex flex-row items-end justify-between mb-8 md:mb-16 gap-4 md:gap-8 fade-left" data-animate>
            <div>
                <div class="inline-flex items-center gap-2 text-blue-600 font-bold mb-2 md:mb-4 text-xs md:text-sm tracking-widest uppercase">
                    <i data-lucide="shield-check" class="w-4 h-4 md:w-4.5 md:h-4.5"></i>
                    Verified Professionals
                </div>
                <h2 class="text-2xl md:text-5xl font-bold text-gray-900 tracking-tight leading-tight">
                    Consult with top-tier <br class="hidden md:inline" />
                    <span class="text-gray-400 italic">global specialists.</span>
                </h2>
            </div>
            <a href="@Url.Action("Doctors", "Dashboard")" class="flex items-center gap-1 md:gap-2 group text-blue-600 font-bold text-xs md:text-lg hover:gap-4 transition-all whitespace-nowrap">
                <span>View All <span class="hidden sm:inline">500+ Specialists</span></span>
                <i data-lucide="arrow-right" class="w-4 h-4 md:w-5 md:h-5"></i>
            </a>
        </div>

        <div class="doctor-grid flex md:grid md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-8 stagger-children overflow-x-auto snap-x snap-mandatory pb-4" data-animate>
            @foreach (var doctor in Model)
            {
                <div class="doctor-card-wrapper group relative flex-shrink-0 w-[260px] sm:w-[280px] md:w-auto snap-start fade-up" data-animate data-doctor-id="@doctor.Id"
                     onmouseenter="handleDoctorHover(@doctor.Id, true)"
                     onmouseleave="handleDoctorHover(@doctor.Id, false)">
                    <div class="doctor-card-inner relative h-[380px] md:h-[480px] w-full rounded-3xl md:rounded-[2.5rem] overflow-hidden bg-gray-900 shadow-sm border border-gray-100 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2">
                        <img src="@doctor.Image"
                             alt="@doctor.Name"
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110 opacity-90"
                             id="doctor-img-@doctor.Id">

                        <div class="absolute inset-0 bg-gradient-to-t from-gray-950 via-gray-900/40 to-transparent"></div>

                        @if (doctor.Online)
                        {
                            <div class="absolute top-4 left-4 md:top-6 md:left-6 bg-emerald-500/90 backdrop-blur-md text-white px-2.5 py-0.5 md:px-3 md:py-1 rounded-full text-[10px] md:text-xs font-bold flex items-center gap-1.5 animate-pulse">
                                <span class="w-1.5 h-1.5 bg-white rounded-full"></span>
                                LIVE NOW
                            </div>
                        }

                        <div class="absolute bottom-0 left-0 right-0 p-4 md:p-8 transform transition-transform duration-500">
                            <div class="flex items-center gap-1 text-amber-400 mb-1 md:mb-2">
                                @for (int i = 0; i < 5; i++)
                                {
                                    <i data-lucide="star" class="w-3 h-3 md:w-3.5 md:h-3.5 @(i < Math.Floor(doctor.Rating) ? "fill-current" : "")"></i>
                                }
                                <span class="text-white text-[11px] md:text-xs font-bold ml-1">@doctor.Rating (@doctor.Reviews)</span>
                            </div>
                            <h4 class="text-lg md:text-2xl font-bold text-white mb-0.5 md:mb-1 truncate">@doctor.Name</h4>
                            <p class="text-blue-300 text-xs md:text-sm font-medium mb-3 md:mb-4 truncate">@doctor.Specialty</p>

                            <div class="doctor-actions flex flex-col gap-2 transition-all duration-500" id="doctor-actions-@doctor.Id">
                                <button onclick="openBookingForDoctor(@doctor.Id)"
                                        class="w-full bg-white text-gray-900 py-2.5 md:py-3 rounded-xl md:rounded-2xl font-bold text-xs md:text-sm flex items-center justify-center gap-2 hover:bg-blue-50 transition-colors shadow-lg">
                                    <i data-lucide="calendar" class="w-3.5 h-3.5 md:w-4 md:h-4 text-blue-600"></i>
                                    Book Appointment
                                </button>
                                <button class="w-full bg-white/15 backdrop-blur-md border border-white/20 text-white py-2 md:py-3 rounded-xl md:rounded-2xl font-bold text-xs md:text-sm flex items-center justify-center gap-2 hover:bg-white/25 transition-colors">
                                    <i data-lucide="video" class="w-3.5 h-3.5 md:w-4 md:h-4"></i>
                                    Video Call
                                </button>
                            </div>

                            <div class="doctor-availability hidden md:flex items-center gap-2 mt-2 transition-opacity duration-500" id="doctor-availability-@doctor.Id">
                                <i data-lucide="activity" class="w-3.5 h-3.5 text-blue-400"></i>
                                <span class="text-blue-100/70 text-xs font-medium uppercase tracking-wider">@doctor.Availability</span>
                            </div>
                        </div>
                    </div>

                    <div class="doctor-quick-action hidden md:flex absolute -right-4 top-1/2 -translate-y-1/2 flex-col gap-2 transition-all duration-500 opacity-0 translate-x-4" id="quick-action-@doctor.Id">
                        <div class="bg-white p-3 rounded-full shadow-xl text-blue-600 hover:bg-blue-600 hover:text-white transition-all cursor-pointer">
                            <i data-lucide="message-circle" class="w-5 h-5"></i>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="doctor-stats-bar mt-16 md:mt-20 flex flex-wrap justify-center gap-8 md:gap-16 items-center py-10 md:py-12 border-y border-gray-100 fade-up delay-500" data-animate>
            <div class="text-center">
                <div class="text-3xl font-black text-gray-900">12k+</div>
                <div class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-1">Consultations Done</div>
            </div>
            <div class="w-1 h-1 rounded-full bg-gray-200 hidden md:block"></div>
            <div class="text-center">
                <div class="text-3xl font-black text-gray-900">4.9/5</div>
                <div class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-1">Patient Satisfaction</div>
            </div>
            <div class="w-1 h-1 rounded-full bg-gray-200 hidden md:block"></div>
            <div class="text-center">
                <div class="text-3xl font-black text-gray-900">2 min</div>
                <div class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-1">Avg. Response Time</div>
            </div>
        </div>
    </div>
</section>

<script>
    function handleDoctorHover(doctorId, isHovered) {
        const actions = document.getElementById(`doctor-actions-${doctorId}`);
        const availability = document.getElementById(`doctor-availability-${doctorId}`);
        const quickAction = document.getElementById(`quick-action-${doctorId}`);

        if (isHovered) {
            actions.classList.remove('opacity-0', 'translate-y-4');
            actions.classList.add('opacity-100', 'translate-y-0');
            availability.classList.add('opacity-0');
            quickAction.classList.remove('opacity-0', 'translate-x-4');
            quickAction.classList.add('opacity-100', 'translate-x-0');
        } else {
            actions.classList.remove('opacity-100', 'translate-y-0');
            actions.classList.add('opacity-0', 'translate-y-4');
            availability.classList.remove('opacity-0');
            quickAction.classList.remove('opacity-100', 'translate-x-0');
            quickAction.classList.add('opacity-0', 'translate-x-4');
        }
    }

    function openBookingForDoctor(doctorId) {
        // Fetch doctor data and open booking modal
        fetch(`/Home/GetDoctor?id=${doctorId}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Set doctor data in modal
                    document.getElementById('selectedDoctorName').innerText = data.doctor.name;
                    document.getElementById('selectedDoctorSpecialty').innerText = data.doctor.specialty;
                    document.getElementById('selectedDoctorImage').src = data.doctor.image;

                    // Store doctor data for form submission
                    document.getElementById('doctorId').value = data.doctor.id;

                    // Open modal
                    toggleModal('bookingModal');
                }
            });
    }
</script>