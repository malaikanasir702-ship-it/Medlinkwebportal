@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Transcript Record";
    var appointmentId = ViewBag.AppointmentId;
}

<div class="p-6 lg:p-10 space-y-8 max-w-6xl mx-auto overflow-hidden">
    <!-- Header Bento Card -->
    <div class="relative group overflow-hidden bg-white dark:bg-slate-900 rounded-[3rem] p-10 border border-slate-100 dark:border-white/5 shadow-2xl shadow-blue-500/5">
        <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-blue-50/50 dark:bg-blue-900/10 rounded-full blur-[80px] -mr-32 -mt-32 transition-transform group-hover:scale-110"></div>
        
        <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-8">
            <div class="flex items-center gap-6">
                <div class="w-20 h-20 bg-gradient-to-br from-blue-600 to-indigo-700 rounded-3xl flex items-center justify-center text-white shadow-2xl shadow-blue-600/30">
                    <i data-lucide="file-text" class="w-10 h-10"></i>
                </div>
                <div>
                    <h1 class="text-3xl lg:text-4xl font-semibold text-slate-900 dark:text-white tracking-tight">Consultation Archive</h1>
                    <div class="flex items-center gap-3 mt-2">
                         <span class="text-[10px] font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/30 px-3 py-1 rounded-full uppercase tracking-wider border border-blue-100 dark:border-blue-800">
                            Dr. @ViewBag.DoctorName
                        </span>
                        <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest flex items-center gap-1.5">
                            <i data-lucide="calendar" class="w-3 h-3"></i> @ViewBag.AppointmentDate
                        </span>
                    </div>
                </div>
            </div>
            
            <a href="@Url.Action("TranscriptionHistory", "Dashboard")" class="px-8 py-4 bg-slate-50 dark:bg-white/5 text-slate-900 dark:text-white border border-slate-200 dark:border-white/10 rounded-2xl text-[10px] font-semibold uppercase tracking-widest hover:bg-slate-900 dark:hover:bg-white hover:text-white dark:hover:text-slate-900 transition-all flex items-center gap-2">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Archive
            </a>
        </div>
    </div>

    <!-- Transcript Body -->
    <div class="bg-white dark:bg-slate-900/50 rounded-[3rem] border border-slate-100 dark:border-white/5 shadow-2xl overflow-hidden min-h-[600px] relative backdrop-blur-xl">
        <div class="absolute inset-0 bg-gradient-to-b from-slate-50/50 to-transparent dark:from-white/2 pointer-events-none"></div>
        
        <!-- Stats/Info Bar -->
        <div class="relative z-10 px-10 py-6 border-b border-slate-50 dark:border-white/5 flex items-center justify-between bg-white/50 dark:bg-slate-900/50">
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-2">
                    <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
                    <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest">AI Intelligence Active</span>
                </div>
                <div class="hidden sm:flex items-center gap-2 border-l border-slate-100 dark:border-white/10 pl-6 text-slate-400">
                    <i data-lucide="languages" class="w-4 h-4"></i>
                    <span class="text-[10px] font-semibold uppercase tracking-widest">Dual-Language Analysis</span>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest">Session ID: #MED-@(appointmentId)X</span>
            </div>
        </div>

        <!-- Messages Area -->
        <div id="transcriptContainer" class="relative z-10 p-8 lg:p-12 space-y-12">
            <!-- Loading State -->
            <div id="loadingState" class="flex flex-col items-center justify-center py-32 space-y-6">
                <div class="relative">
                    <div class="w-20 h-20 border-4 border-blue-600/10 dark:border-white/5 rounded-full"></div>
                    <div class="w-20 h-20 border-4 border-blue-600 border-t-transparent rounded-full animate-spin absolute top-0 left-0"></div>
                </div>
                <div class="text-center">
                    <p class="text-xs font-semibold text-blue-600 dark:text-blue-400 uppercase tracking-[0.3em] animate-pulse">Synchronizing Data</p>
                    <p class="text-[10px] font-bold text-slate-400 mt-2">Retrieving clinical transcriptions...</p>
                </div>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="hidden flex flex-col items-center justify-center py-32 space-y-8">
                <div class="w-32 h-32 bg-slate-50 dark:bg-white/5 rounded-[3rem] flex items-center justify-center text-slate-200 dark:text-slate-800 shadow-inner">
                    <i data-lucide="microphone-off" class="w-16 h-16"></i>
                </div>
                <div class="text-center max-w-sm">
                    <h3 class="text-2xl font-semibold text-slate-900 dark:text-white mb-2">No Records Detected</h3>
                    <p class="text-sm font-bold text-slate-400 leading-relaxed uppercase tracking-wider">This session has no recorded intelligence data synchronized yet.</p>
                </div>
            </div>

            <!-- Transcript List -->
            <div id="transcriptMessages" class="hidden space-y-12"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        const appointmentId = @(appointmentId ?? 0);

        async function loadTranscript() {
            const loadingElement = document.getElementById('loadingState');
            const emptyElement = document.getElementById('emptyState');
            const messagesElement = document.getElementById('transcriptMessages');

            try {
                if (!appointmentId) throw new Error("Invalid Appointment ID");

                const response = await fetch(`/Dashboard/GetTranscriptHistory?appointmentId=${appointmentId}`);
                if (!response.ok) throw new Error("Network response was not ok");
                
                const data = await response.json();

                if (loadingElement) loadingElement.classList.add('hidden');

                if (data.success && data.transcripts && data.transcripts.length > 0) {
                    if (messagesElement) {
                        messagesElement.classList.remove('hidden');
                        renderTranscripts(data.transcripts);
                    }
                } else {
                    if (emptyElement) emptyElement.classList.remove('hidden');
                }
            } catch (error) {
                console.error('Error loading transcript:', error);
                if (loadingElement) loadingElement.classList.add('hidden');
                if (emptyElement) emptyElement.classList.remove('hidden');
            }
        }

        function renderTranscripts(transcripts) {
            const container = document.getElementById('transcriptMessages');
            if (!container) return;
            
            container.innerHTML = '';

            transcripts.forEach((t, index) => {
                const isDoctor = t.speakerRole === 'Doctor';
                const messageWrapper = document.createElement('div');
                messageWrapper.className = `flex group justify-start`;
                
                // Format timestamp
                let displayTime = "N/A";
                try {
                    const date = new Date(t.timestamp);
                    displayTime = date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                } catch(e) { console.error(e); }

                messageWrapper.style.animation = `fadeSlideUp 0.5s ease forwards ${index * 0.1}s`;
                messageWrapper.style.opacity = '0'; // Start hidden for animation

                messageWrapper.innerHTML = `
                    <div class="w-full max-w-4xl space-y-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-2xl ${isDoctor ? 'bg-blue-600 text-white' : 'bg-emerald-500 text-white'} flex items-center justify-center shadow-lg transition-transform group-hover:scale-110">
                                <i data-lucide="${isDoctor ? 'user-round' : 'user'}" class="w-5 h-5"></i>
                            </div>
                            <div class="flex flex-col">
                                <span class="text-[10px] font-semibold ${isDoctor ? 'text-blue-600 dark:text-blue-400' : 'text-emerald-600 dark:text-emerald-400'} uppercase tracking-widest">
                                    ${t.speakerName} 
                                </span>
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-tighter">
                                    Captured at ${displayTime}
                                </span>
                            </div>
                        </div>

                        <div class="bg-white dark:bg-slate-800/50 p-7 rounded-[2.5rem] rounded-tl-lg border border-slate-100 dark:border-white/5 shadow-xl shadow-slate-200/20 dark:shadow-none hover:shadow-2xl transition-all duration-500">
                             <p class="text-[15px] text-slate-900 dark:text-white font-bold leading-relaxed mb-6">${t.originalText}</p>
                             
                             <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-6 border-t border-slate-50 dark:border-white/5">
                                <div class="space-y-3">
                                    <div class="flex items-center gap-2 opacity-50">
                                        <div class="w-5 h-5 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center text-[8px] font-semibold text-blue-600 dark:text-blue-400">EN</div>
                                        <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest">Translation</span>
                                    </div>
                                    <p class="text-sm text-slate-600 dark:text-slate-400 italic font-medium leading-relaxed">${t.englishTranslation}</p>
                                </div>
                                <div class="space-y-3">
                                    <div class="flex items-center justify-end gap-2 opacity-50">
                                        <span class="text-[9px] font-semibold text-slate-400 uppercase tracking-widest">اردو متن</span>
                                        <div class="w-5 h-5 bg-emerald-50 dark:bg-emerald-900/30 rounded-full flex items-center justify-center text-[8px] font-semibold text-emerald-600 dark:text-emerald-400">UR</div>
                                    </div>
                                    <p class="text-[17px] text-slate-600 dark:text-slate-300 leading-normal text-right font-urdu" dir="rtl">${t.urduTranslation}</p>
                                </div>
                             </div>
                        </div>
                    </div>
                `;

                container.appendChild(messageWrapper);
            });
            
            if (window.lucide) window.lucide.createIcons();
        }

        // Use multiple events to ensure it runs
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', loadTranscript);
        } else {
            loadTranscript();
        }
    </script>

    <style>
        @@keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .font-urdu {
            font-family: 'Jameel Noori Nastaleeq', 'Noto Nastaliq Urdu', serif;
        }
    </style>
}
