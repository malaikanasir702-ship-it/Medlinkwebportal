@{
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
    ViewData["Title"] = "Professional Consultation Room";
    ViewData["HideGlobalCall"] = true;
    var appointmentId = ViewBag.AppointmentId;
    var doctorName = ViewBag.DoctorName;
    var doctorImage = ViewBag.DoctorImage;
    var patientName = ViewBag.PatientName;
}


<div class="min-h-[calc(100vh-140px)] flex flex-col gap-4 lg:gap-6 pb-20 lg:pb-10">
    <!-- Pro Header -->
    <div class="bg-white/90 backdrop-blur-2xl rounded-[2rem] p-4 lg:p-6 border border-slate-100 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-4 md:gap-0">
        <div class="flex items-center gap-4 md:gap-6 w-full md:w-auto">
            <div class="relative shrink-0">
                <div class="w-12 h-12 md:w-16 md:h-16 rounded-2xl bg-blue-600 flex items-center justify-center text-white font-semibold text-xl md:text-2xl shadow-xl shadow-blue-500/20">
                    @((patientName != null && patientName.Length > 0) ? patientName.Substring(0, 1) : "P")
                </div>
                <div class="absolute -bottom-1 -right-1 bg-emerald-500 w-3 h-3 md:w-4 md:h-4 rounded-full border-4 border-white shadow-lg"></div>
            </div>
            <div class="min-w-0 flex-1">
                <h3 class="text-lg md:text-xl font-semibold text-slate-900 tracking-tight truncate">Active Consultation: @patientName</h3>
                <p class="text-[9px] md:text-[10px] font-semibold text-blue-600 uppercase tracking-[0.2em] flex items-center gap-2 mt-1">
                    <span class="flex h-2 w-2 relative shrink-0">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
                    </span>
                    <span class="truncate">Bi-Directional Encrypted Session</span>
                </p>
            </div>
        </div>
        <div class="flex items-center gap-3 md:gap-4 w-full md:w-auto">
            <div id="callTimer" class="flex-1 md:flex-none text-center bg-slate-900 px-4 py-2 md:px-6 md:py-3 rounded-2xl text-xs font-semibold text-white font-mono tracking-widest border border-slate-800 shadow-xl">
                00:00:00
            </div>
            <button id="leaveCall" class="flex-1 md:flex-none justify-center h-10 md:h-12 px-4 md:px-8 bg-rose-50 text-rose-600 font-semibold text-[9px] md:text-[10px] uppercase tracking-widest rounded-2xl hover:bg-rose-600 hover:text-white transition-all border border-rose-100 flex items-center gap-2 md:gap-3 active:scale-95">
                <i class="fas fa-phone-slash"></i> <span class="whitespace-nowrap">Terminate</span>
            </button>
        </div>
    </div>

    <!-- Interface Grid -->
    <div class="flex flex-col xl:grid xl:grid-cols-12 gap-4 lg:gap-6 min-h-0">
        
        <!-- Video Ops -->
        <div class="xl:col-span-8 flex flex-col gap-4 lg:gap-6 min-h-0 order-1">
            <div class="w-full aspect-[4/5] md:aspect-video xl:aspect-auto xl:min-h-[500px] flex-1 bg-slate-900 rounded-[2rem] md:rounded-[3rem] relative overflow-hidden group shadow-[0_30px_100px_rgba(0,0,0,0.3)] border border-white/5 shrink-0">
                <!-- Main Stream -->
                <div id="remoteVideoContainer" class="w-full h-full flex items-center justify-center">
                    <div class="flex flex-col items-center gap-4 md:gap-6 z-10 px-4 text-center">
                        <div class="w-16 h-16 md:w-24 md:h-24 bg-white/5 backdrop-blur-3xl rounded-full flex items-center justify-center border border-white/10 relative">
                             <div class="absolute inset-0 bg-blue-500/20 blur-3xl rounded-full"></div>
                             <i class="fas fa-video text-2xl md:text-3xl text-white/20 relative"></i>
                        </div>
                        <p class="text-white/40 font-semibold text-[9px] md:text-[10px] uppercase tracking-[0.3em]">Awaiting Patient Up-Link...</p>
                    </div>
                </div>

                <!-- Doctor PiP -->
                <div class="absolute bottom-4 right-4 md:bottom-8 md:right-8 w-28 aspect-[3/4] md:w-48 md:aspect-video bg-black/40 backdrop-blur-xl rounded-xl md:rounded-2xl overflow-hidden border border-white/10 shadow-2xl z-20 hover:scale-105 transition-transform group/pip">
                    <div id="localVideoContainer" class="w-full h-full">
                         <div class="w-full h-full flex items-center justify-center opacity-20">
                             <i class="fas fa-user-md text-xl md:text-2xl text-white"></i>
                         </div>
                    </div>
                </div>

                <!-- Tactical Controls -->
                <!-- Tactical Controls -->
                <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-3 md:gap-4 px-4 py-3 md:px-6 md:py-4 bg-black/20 backdrop-blur-2xl rounded-2xl md:rounded-3xl border border-white/10 shadow-2xl z-20 hover:bg-black/40 w-max max-w-[90%] justify-center">
                    <button id="btnMute" class="w-10 h-10 md:w-12 md:h-12 flex shrink-0 items-center justify-center bg-white/5 hover:bg-white/20 text-white rounded-xl transition-all"><i class="fas fa-microphone"></i></button>
                    <button id="btnVideo" class="w-10 h-10 md:w-12 md:h-12 flex shrink-0 items-center justify-center bg-white/5 hover:bg-white/20 text-white rounded-xl transition-all"><i class="fas fa-video"></i></button>
                    <button id="btnSync" onclick="Telemed.initiateCall()" class="w-10 h-10 md:w-12 md:h-12 flex shrink-0 items-center justify-center bg-blue-600/20 hover:bg-blue-600 text-blue-400 hover:text-white rounded-xl transition-all border border-blue-500/30" title="Sync Video Connection"><i class="fas fa-sync-alt"></i></button>
                    <div class="w-px h-6 md:h-8 bg-white/10 mx-1 md:mx-2"></div>
                    <button id="btnEndCall" class="w-10 h-10 md:w-12 md:h-12 flex shrink-0 items-center justify-center bg-rose-600 hover:bg-rose-700 text-white rounded-xl shadow-lg shadow-rose-600/20 transition-all"><i class="fas fa-phone-slash"></i></button>
                </div>
            </div>

            <!-- Precision Prescription & EHR Section -->
            <div class="bg-white rounded-[2rem] md:rounded-[2.5rem] p-6 lg:p-10 border border-slate-100 shadow-2xl relative overflow-hidden order-3 xl:order-2">
                <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 lg:mb-10 gap-4 relative z-10">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 md:w-14 md:h-14 bg-blue-600 rounded-2xl flex shrink-0 items-center justify-center text-white shadow-xl shadow-blue-600/20">
                            <i class="fas fa-file-medical text-lg md:text-xl"></i>
                        </div>
                        <div>
                            <h4 class="text-lg md:text-xl font-semibold text-slate-900 tracking-tight">Clinical Prescription</h4>
                            <p class="text-[9px] md:text-[10px] font-semibold text-rose-500 uppercase tracking-widest mt-1">Live Synchronization Active</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap items-center gap-2 md:gap-3 w-full md:w-auto">
                         <button id="addMedication" class="flex-1 md:flex-none h-10 md:h-11 px-4 md:px-6 bg-slate-50 text-slate-900 border border-slate-200 rounded-xl text-[9px] md:text-[10px] font-semibold uppercase tracking-widest hover:bg-slate-900 hover:text-white hover:border-slate-900 transition-all flex items-center justify-center gap-2 whitespace-nowrap">
                            <i class="fas fa-plus"></i> <span class="hidden sm:inline">Add Medication</span><span class="sm:hidden">Add Med</span>
                        </button>
                        <button id="finalizePrescription" class="flex-1 md:flex-none h-10 md:h-11 px-6 md:px-8 bg-blue-600 text-white rounded-xl text-[9px] md:text-[10px] font-semibold uppercase tracking-widest shadow-xl shadow-blue-600/20 hover:bg-blue-700 transition-all whitespace-nowrap">
                            Finalize EHR
                        </button>
                    </div>
                </div>

                <div class="flex flex-col md:grid md:grid-cols-12 gap-6 lg:gap-10 relative z-10">
                    <!-- Diagnosis Column -->
                    <div class="md:col-span-12 lg:col-span-5 space-y-4">
                        <label class="text-[9px] md:text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] ml-1 flex items-center gap-2">
                             Diagnosis Summary <span class="w-1 h-1 bg-blue-500 rounded-full"></span>
                        </label>
                        <textarea id="diagnosis" class="w-full p-5 lg:p-6 bg-slate-50 border border-slate-100 rounded-[2rem] text-sm font-bold text-slate-800 focus:ring-4 focus:ring-blue-500/5 focus:border-blue-400 focus:bg-white transition-all outline-none resize-none h-40 lg:h-48 placeholder-slate-300" placeholder="Clinical findings and diagnosis..."></textarea>
                    </div>

                    <!-- Medication Management Column -->
                    <div class="md:col-span-12 lg:col-span-7 space-y-4">
                        <label class="text-[9px] md:text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em] ml-1">Medication Protocol</label>
                        <div id="medicationList" class="space-y-3 max-h-48 overflow-y-auto pr-2 lg:pr-4 custom-scrollbar">
                           <div class="flex items-center justify-center p-8 lg:p-12 bg-slate-50/50 rounded-[2rem] border border-dashed border-slate-200 opacity-50">
                                <p class="text-[9px] md:text-[10px] font-semibold text-slate-400 uppercase tracking-widest text-center">No Protocol Defined</p>
                           </div>
                        </div>
                    </div>
                </div>

                <!-- Background Texture -->
                <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-blue-600/5 rounded-full blur-[100px] -z-0"></div>
            </div>
        </div>

        <!-- Intelligence Hub (Chat Area) -->
        <div class="xl:col-span-4 flex flex-col bg-slate-900 rounded-[2rem] md:rounded-[3rem] border border-white/5 shadow-2xl h-[450px] xl:h-auto min-h-0 overflow-hidden order-2 xl:order-3">
            <div class="p-2 border-b border-white/5 bg-white/5 backdrop-blur-md">
                <div class="flex items-center gap-1">
                    <button onclick="switchTab('chat')" id="tab-chat" class="flex-1 py-3 px-4 rounded-2xl flex items-center justify-center gap-2 text-[10px] font-semibold uppercase tracking-widest transition-all bg-white/10 text-white shadow-xl border border-white/10">
                        <i class="fas fa-comment-alt"></i> Chat
                    </button>
                    <button onclick="switchTab('transcript')" id="tab-transcript" class="flex-1 py-3 px-4 rounded-2xl flex items-center justify-center gap-2 text-[10px] font-semibold uppercase tracking-widest transition-all text-white/40 hover:text-white">
                        <i class="fas fa-language"></i> Transcript
                    </button>
                </div>
            </div>

            <!-- Chat Content -->
            <div id="chat-content" class="flex flex-col flex-1 overflow-hidden">
                <div class="p-3 lg:p-4 border-b border-white/5 flex items-center justify-between bg-black/20">
                    <div class="flex items-center gap-3">
                        <div class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.5)]"></div>
                        <h4 class="text-[9px] font-semibold text-white uppercase tracking-[0.2em]">Signal Intelligence</h4>
                    </div>
                </div>
                <div id="chatMessages" class="flex-1 overflow-y-auto p-5 lg:p-6 space-y-6 scrollbar-hide">
                <!-- System Signal -->
                <div class="flex justify-center">
                    <span class="text-[9px] font-semibold text-white/20 bg-white/5 px-4 py-1.5 rounded-full uppercase tracking-[0.2em] text-center">
                        Signal Link Started at @DateTime.Now.ToString("HH:mm")
                    </span>
                </div>
            </div>

            <!-- Command Terminal (Input) -->
            <div class="p-5 lg:p-6 bg-black/20 border-t border-white/5">
                <div class="relative flex items-center gap-3 md:gap-4 bg-white/5 border border-white/10 rounded-[2rem] p-2 focus-within:border-blue-500/40 transition-all">
                    <button id="attachBtn" class="w-10 h-10 md:w-12 md:h-12 flex shrink-0 items-center justify-center text-white/30 hover:text-white transition-all rounded-2xl hover:bg-white/5">
                        <i class="fas fa-paperclip"></i>
                    </button>
                    <input type="text" id="chatInput" class="flex-1 bg-transparent border-none px-2 md:px-4 text-sm font-bold text-white placeholder-white/20 outline-none focus:ring-0" placeholder="Type signal..." autocomplete="off">
                    <button id="sendBtn" class="w-10 h-10 md:w-12 md:h-12 bg-blue-600 text-white rounded-2xl shadow-xl shadow-blue-600/20 hover:bg-blue-700 active:scale-90 transition-all flex shrink-0 items-center justify-center">
                        <i class="fas fa-location-arrow"></i>
                    </button>
                </div>
                </div>
            </div>

            <!-- Transcription Content -->
            <div id="transcript-content" class="hidden flex flex-col flex-1 overflow-hidden bg-black/40 font-mono">
                <div class="p-4 border-b border-white/5 flex items-center justify-between bg-white/5">
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-blue-500 animate-pulse shadow-[0_0_10px_rgba(59,130,246,0.5)]"></div>
                        <span class="text-[9px] font-semibold text-white/70 uppercase tracking-[0.2em]">Medical Signal Transcription</span>
                    </div>
                </div>
                <div id="transcriptionLog" class="flex-1 overflow-y-auto p-5 space-y-4 custom-scrollbar">
                    <div class="flex flex-col items-center justify-center h-full text-center p-6 space-y-4 opacity-20">
                         <i class="fas fa-microchip text-3xl text-blue-400"></i>
                         <p class="text-white text-[9px] font-semibold uppercase tracking-[0.2em] leading-relaxed">Awaiting Audio Link...</p>
                    </div>
                </div>
                <div class="p-5 bg-black/60 border-t border-white/5 flex items-center justify-between">
                     <div class="flex items-center gap-3">
                         <div id="listen-status-dot" class="w-2 h-2 rounded-full bg-white/10"></div>
                         <span id="listen-status-text" class="text-[8px] font-semibold text-white/30 uppercase tracking-widest">Standby</span>
                     </div>
                     <button id="toggleTranscription" class="px-5 py-2.5 bg-blue-600 text-white text-[9px] font-semibold uppercase tracking-widest rounded-xl shadow-xl shadow-blue-600/20 hover:bg-blue-700 transition-all active:scale-95">
                        Enable Live Aid
                     </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
@* SignalR is in layout *@

    <script src="~/js/telemedicine-core.js"></script>
    <script>
        const roomContext = {
            roomId: "room_@appointmentId",
            userName: "@(User.Identity.Name?.Split('@')[0] ?? "User")",
            isDoctor: true,
            appointmentId: "@appointmentId",
            senderId: "@(ViewBag.CurrentUserId ?? "")",
            receiverId: "@(ViewBag.PatientUserId ?? "")",
            isLocked: @((ViewBag.IsPrescriptionLocked ?? false).ToString().ToLower()),
            initialData: @Html.Raw(ViewBag.PrescriptionData ?? "null")
        };
        
        document.addEventListener("DOMContentLoaded", () => {
             console.log("Telemed Bootstrapping...");
             Telemed.init(roomContext);
        });

        function switchTab(tab) {
            const chatBtn = document.getElementById('tab-chat');
            const transcriptBtn = document.getElementById('tab-transcript');
            const chatContent = document.getElementById('chat-content');
            const transcriptContent = document.getElementById('transcript-content');
            const chatInput = document.getElementById('chatInput').parentElement.parentElement;

            if (tab === 'chat') {
                chatBtn.className = "flex-1 py-3 px-4 rounded-2xl flex items-center justify-center gap-2 text-[10px] font-semibold uppercase tracking-widest transition-all bg-white/10 text-white shadow-xl border border-white/10";
                transcriptBtn.className = "flex-1 py-3 px-4 rounded-2xl flex items-center justify-center gap-2 text-[10px] font-semibold uppercase tracking-widest transition-all text-white/40 hover:text-white";
                chatContent.classList.remove('hidden');
                transcriptContent.classList.add('hidden');
                chatInput.classList.remove('hidden');
            } else {
                transcriptBtn.className = "flex-1 py-3 px-4 rounded-2xl flex items-center justify-center gap-2 text-[10px] font-semibold uppercase tracking-widest transition-all bg-blue-600/20 text-blue-400 shadow-xl border border-blue-500/20";
                chatBtn.className = "flex-1 py-3 px-4 rounded-2xl flex items-center justify-center gap-2 text-[10px] font-semibold uppercase tracking-widest transition-all text-white/40 hover:text-white";
                chatContent.classList.add('hidden');
                transcriptContent.classList.remove('hidden');
                chatInput.classList.add('hidden');
            }
        }
    </script>
}

<!-- Diagnostic Overlay (Fixed bottom right) -->
<div class="fixed bottom-4 left-4 z-[9999] opacity-10 hover:opacity-100 transition-opacity pointer-events-none">
    <div class="bg-black/80 backdrop-blur-xl p-4 rounded-2xl border border-white/10 text-[10px] text-white/50 font-mono">
        <p>Room: <span class="text-blue-400">room_@appointmentId</span></p>
        <p>Status: <span id="debug-status" class="text-emerald-400">Initializing...</span></p>
    </div>
</div>

<style>
    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.05); border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.1); }
    
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>
