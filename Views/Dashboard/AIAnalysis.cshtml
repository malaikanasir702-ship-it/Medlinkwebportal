@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Neural Health Analysis";
    ViewData["HeaderTitle"] = "Diagnostics Dashboard";
    ViewData["HeaderSubtitle"] = "Neural Core V2.4 Deep Learning Insights";
    var report = Model.AIReport;
}

<div class="grid grid-cols-12 gap-8">
    <!-- Left Column: Main Analysis & Vitals -->
    <div class="col-span-12 xl:col-span-8 space-y-8">
        <!-- Main Health Score Card -->
        <div class="bg-slate-900 rounded-[3rem] p-8 md:p-12 text-white shadow-2xl relative overflow-hidden group">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(59,130,246,0.1),transparent)] group-hover:opacity-60 transition-opacity"></div>
            <div class="absolute -right-20 -top-20 w-80 h-80 bg-blue-600/20 rounded-full blur-[100px]"></div>
            
            <div class="relative z-10 flex flex-col md:flex-row items-center gap-12">
                <div class="relative w-64 h-64 flex-shrink-0">
                    <svg class="w-full h-full transform -rotate-90">
                        <circle cx="128" cy="128" r="110" stroke="currentColor" stroke-width="8" fill="transparent" class="text-white/5" />
                        <circle cx="128" cy="128" r="110" stroke="currentColor" stroke-width="14" fill="transparent" stroke-dasharray="691" stroke-dashoffset="@(691 - (691 * report.OverallScore / 100))" class="text-emerald-400 drop-shadow-[0_0_15px_rgba(52,211,153,0.5)]" stroke-linecap="round" />
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="text-7xl font-semibold tracking-tighter">@report.OverallScore</span>
                        <span class="text-[10px] font-semibold text-emerald-400 uppercase tracking-[0.3em] mt-2">@report.StatusLabel</span>
                    </div>
                </div>

                <div class="flex-1 text-center md:text-left">
                    <div class="inline-flex items-center gap-2 bg-blue-500/10 border border-blue-500/20 px-4 py-2 rounded-full text-[10px] font-semibold uppercase tracking-[0.2em] mb-6 text-blue-400">
                        <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
                        Neural Analysis Optimized
                    </div>
                    <h2 class="text-4xl md:text-5xl font-semibold mb-6 tracking-tight leading-tight">Health Index <span class="text-blue-400">Validated.</span></h2>
                    <p class="text-slate-400 text-lg font-medium leading-relaxed mb-8 max-w-2xl">
                        @report.Summary
                    </p>
                    
                    <div class="flex flex-wrap items-center gap-6">
                        <div class="px-6 py-3 bg-white/5 rounded-2xl border border-white/10 flex items-center gap-4">
                            <span class="text-3xl font-semibold text-emerald-400">@report.ResilienceTrend</span>
                            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest leading-tight">Resilience<br>Velocity</span>
                        </div>
                        <div class="px-6 py-3 bg-white/5 rounded-2xl border border-white/10 flex items-center gap-4">
                            <span class="text-3xl font-semibold text-blue-400">98.2%</span>
                            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-widest leading-tight">Data<br>Confidence</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section 2: Personal Diet Plan (NEW) -->
        <div class="bg-white rounded-[3rem] p-10 border border-slate-100 shadow-xl overflow-hidden relative">
            <div class="flex items-center justify-between mb-10">
                <h3 class="text-2xl font-semibold text-slate-900 flex items-center gap-4">
                    <div class="w-12 h-12 rounded-2xl bg-amber-50 flex items-center justify-center text-amber-600">
                        <i data-lucide="utensils" class="w-6 h-6"></i>
                    </div>
                    AI Generated Diet Plan
                </h3>
                <span class="px-4 py-1.5 bg-slate-100 text-slate-500 rounded-full text-[9px] font-semibold uppercase tracking-[0.2em]">Next 24 Hours</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                @foreach (var meal in report.DietPlan)
                {
                    <div class="p-6 rounded-[2rem] bg-slate-50 border border-slate-100 group hover:bg-white hover:shadow-2xl hover:border-transparent transition-all">
                        <div class="w-10 h-10 rounded-xl bg-white flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-sm">
                            <i data-lucide="@meal.Icon" class="w-5 h-5 text-amber-500"></i>
                        </div>
                        <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-2">@meal.MealTime</p>
                        <h4 class="font-bold text-slate-900 text-sm mb-3">@meal.FoodItems</h4>
                        <p class="text-[10px] font-bold text-amber-600 bg-amber-50 px-3 py-1 rounded-lg inline-block">@meal.NutritionalValue</p>
                    </div>
                }
            </div>
        </div>

        <!-- Section 3: Vitals Deep Dive -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @foreach (var vital in report.Vitals)
            {
                <div class="bg-white rounded-[2.5rem] p-8 border border-slate-100 shadow-sm hover:shadow-2xl transition-all group overflow-hidden relative">
                    <div class="absolute top-0 right-0 p-8 opacity-[0.03] group-hover:opacity-[0.07] transition-opacity">
                        <span class="text-8xl font-semibold italic">@(new Random().Next(92, 99))%</span>
                    </div>

                    <div class="relative z-10">
                        <div class="flex items-start justify-between mb-8">
                            <div class="w-14 h-14 rounded-2xl @GetVitalBgColor(vital.Color) flex items-center justify-center shadow-lg @GetVitalTextColor(vital.Color) ring-4 ring-white">
                                <i data-lucide="@vital.Icon" class="w-7 h-7"></i>
                            </div>
                            <div class="text-right">
                                <p class="text-[10px] font-semibold text-slate-400 uppercase tracking-widest mb-1">Stability</p>
                                <p class="text-sm font-semibold @GetVitalTextColor(vital.Color)">High Coverage</p>
                            </div>
                        </div>

                        <div class="mb-8">
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">@vital.Label</p>
                            <div class="flex items-baseline gap-2">
                                <h4 class="text-4xl font-semibold text-slate-900">@vital.Value</h4>
                                <span class="text-lg font-bold text-slate-300">@vital.Unit</span>
                            </div>
                        </div>

                        <div class="p-5 rounded-2xl bg-slate-50 border border-slate-100 relative group-hover:bg-blue-50/50 transition-colors">
                            <h5 class="text-[10px] font-semibold text-blue-600 uppercase tracking-widest mb-3 flex items-center gap-2">
                                <i data-lucide="brain" class="w-3 h-3"></i> Neural Reasoning
                            </h5>
                            <p class="text-xs text-slate-600 leading-relaxed font-medium">
                                @if(vital.Label == "Heart Rate") { <text>Autonomic nervous system balance is stable. Recovery slope indicates superior cardiac efficiency based on age-weight ratio.</text> }
                                else if(vital.Label == "Temperature") { <text>Thermoregulation is optimal. No inflammatory biomarkers detected in current thermal trend.</text> }
                                else if(vital.Label == "Blood Oxygen") { <text>98% SpO2. Efficient hemoglobin binding observed.</text> }
                                else { <text>Daily movement markers meet the active threshold for your height/weight profile.</text> }
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Right Column: Daily Tips & Next Steps -->
    <div class="col-span-12 xl:col-span-4 space-y-8">
        <!-- Daily Useful Tips -->
        <div class="bg-white rounded-[3rem] p-8 border border-slate-100 shadow-xl relative overflow-hidden">
            <h3 class="text-xl font-semibold text-slate-900 mb-8 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600">
                    <i data-lucide="sparkles" class="w-5 h-5"></i>
                </div>
                Daily AI Health Tips
            </h3>

            <div class="space-y-6">
                @foreach (var tip in report.DailyTips)
                {
                    <div class="p-6 rounded-3xl bg-slate-50 hover:bg-white hover:shadow-lg border border-transparent hover:border-slate-100 transition-all group">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="w-8 h-8 rounded-lg bg-white flex items-center justify-center shadow-sm @GetVitalTextColor(tip.Color)">
                                <i data-lucide="@tip.Icon" class="w-4 h-4"></i>
                            </div>
                            <h4 class="font-semibold text-slate-900 text-sm">@tip.Title</h4>
                        </div>
                        <p class="text-xs text-slate-500 leading-relaxed font-medium">@tip.Description</p>
                    </div>
                }
            </div>
        </div>

        <!-- Clinical Protocols & Report Download -->
        <div class="bg-slate-900 rounded-[3rem] p-8 text-white shadow-2xl relative overflow-hidden">
            <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-blue-600/10 rounded-full blur-3xl"></div>
            
            <h3 class="text-xl font-semibold mb-8 flex items-center gap-3">
                <i data-lucide="shield-check" class="text-emerald-400 w-6 h-6"></i>
                Clinical Protocol
            </h3>

            <div class="space-y-6 mb-12">
                @foreach (var protocol in report.Protocols)
                {
                    <div class="relative pl-8 before:absolute before:left-0 before:top-2 before:bottom-2 before:w-0.5 before:bg-white/10">
                        <div class="absolute left-[-3px] top-2 w-2 h-2 rounded-full @GetVitalBgColor(protocol.Color) shadow-[0_0_10px_rgba(255,255,255,0.3)]"></div>
                        <h5 class="font-semibold text-sm mb-2 text-white/90">@protocol.Title</h5>
                        <p class="text-[11px] text-slate-400 leading-relaxed mb-3">@protocol.Description</p>
                        @if (protocol.ActionText == "View Sleep Map")
                        {
                            <a href="@Url.Action("SleepMap", "Dashboard")" class="text-[9px] font-semibold text-blue-400 uppercase tracking-widest hover:text-white transition-colors">@protocol.ActionText <i data-lucide="arrow-right" class="w-2 h-2 ml-1 inline-block"></i></a>
                        }
                        else if (protocol.ActionText == "Set Reminder")
                        {
                            <a href="@Url.Action("SetReminder", "Dashboard")" class="text-[9px] font-semibold text-blue-400 uppercase tracking-widest hover:text-white transition-colors">@protocol.ActionText <i data-lucide="arrow-right" class="w-2 h-2 ml-1 inline-block"></i></a>
                        }
                        else
                        {
                            <button class="text-[9px] font-semibold text-blue-400 uppercase tracking-widest hover:text-white transition-colors">@protocol.ActionText <i data-lucide="arrow-right" class="w-2 h-2 ml-1 inline-block"></i></button>
                        }
                    </div>
                }
            </div>

            <a href="@Url.Action("DownloadReport", "Dashboard")" class="w-full py-5 bg-white text-slate-900 rounded-2xl font-semibold text-xs uppercase tracking-[0.2em] shadow-xl hover:bg-blue-600 hover:text-white transition-all flex items-center justify-center gap-3">
                <i data-lucide="file-down" class="w-4 h-4"></i>
                Download Neural Report
            </a>
            <p class="mt-6 text-center text-[9px] font-semibold text-slate-500 uppercase tracking-widest">
                ID: NC-@(DateTime.Now.ToString("yyyyMMdd"))-ALPHA
            </p>
        </div>
    </div>
</div>

@functions {
    public string GetVitalBgColor(string color)
    {
        return color switch
        {
            "rose" => "bg-rose-50",
            "amber" => "bg-amber-50",
            "emerald" => "bg-emerald-50",
            "blue" => "bg-blue-50",
            "indigo" => "bg-indigo-50",
            _ => "bg-gray-50"
        };
    }

    public string GetVitalTextColor(string color)
    {
        return color switch
        {
            "rose" => "text-rose-500",
            "amber" => "text-amber-500",
            "emerald" => "text-emerald-500",
            "blue" => "text-blue-500",
            "indigo" => "text-indigo-500",
            _ => "text-gray-500"
        };
    }
}
