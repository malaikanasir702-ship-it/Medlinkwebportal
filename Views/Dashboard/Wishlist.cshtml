@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Your Wishlist";
    ViewData["HeaderTitle"] = "Your Wishlist";
    ViewData["HeaderSubtitle"] = "Quickly access your saved specialists and preferred experts.";
}

<div class="space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
    <!-- Premium Header Section -->
    <div class="relative group">
        <div class="absolute -inset-1 bg-gradient-to-r from-rose-600/10 to-blue-600/10 rounded-[2.5rem] blur-2xl opacity-50 group-hover:opacity-75 transition-opacity duration-500"></div>
        <div class="relative bg-white/70 backdrop-blur-3xl border border-white/50 rounded-[2.5rem] p-8 md:p-10 shadow-2xl shadow-blue-900/5 transition-all">
            <div class="flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="text-center md:text-left">
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-rose-50 border border-rose-100 text-[10px] font-semibold uppercase tracking-widest text-rose-600 mb-4">
                        Saved Specialists
                    </div>
                    <h1 class="text-3xl md:text-4xl font-semibold text-gray-900 tracking-tight leading-none mb-2">Clinical Wishlist</h1>
                    <p class="text-gray-500 font-medium text-sm">Review and manage your curated list of medical experts.</p>
                </div>
                <div class="flex items-center gap-4 bg-white/50 p-2 rounded-2xl border border-white shadow-sm">
                    <div class="text-right px-4 border-r border-gray-100">
                        <p id="wishlistCountText" class="text-2xl font-semibold text-gray-900">0</p>
                        <p class="text-[9px] font-semibold text-gray-400 uppercase tracking-widest">Total Saved</p>
                    </div>
                    <button onclick="clearWishlist()" class="px-4 py-2 text-rose-500 hover:bg-rose-50 rounded-xl text-[10px] font-semibold uppercase tracking-widest transition-all">
                        Clear All
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Empty State -->
    <div id="wishlistEmpty" class="hidden py-20 text-center animate-in zoom-in duration-500">
        <div class="w-24 h-24 bg-white rounded-[2rem] border-2 border-dashed border-gray-200 flex items-center justify-center mx-auto mb-6 text-gray-300">
            <i data-lucide="heart" class="w-10 h-10"></i>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Wishlist is Empty</h3>
        <p class="text-gray-500 text-sm max-w-xs mx-auto mb-8 font-medium">Browse our directory to find and save specialists to your personal list.</p>
        <a href="@Url.Action("Doctors", "Dashboard")" class="inline-flex items-center gap-2 px-8 py-4 bg-blue-600 text-white rounded-2xl font-semibold text-xs uppercase tracking-widest shadow-xl shadow-blue-500/20 hover:bg-blue-700 hover:-translate-y-1 transition-all">
            Find Doctors <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
    </div>

    <!-- Wishlist Grid -->
    <div id="wishlistGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        <!-- Cards will be injected here -->
    </div>
</div>

@section Scripts {
    <script>
        function getWishlist() {
            return JSON.parse(localStorage.getItem('medlink_wishlist') || '[]');
        }

        function renderWishlist() {
            const wishlist = getWishlist();
            const grid = document.getElementById('wishlistGrid');
            const empty = document.getElementById('wishlistEmpty');
            const countText = document.getElementById('wishlistCountText');
            
            grid.innerHTML = '';
            countText.textContent = wishlist.length;

            if (wishlist.length === 0) {
                grid.classList.add('hidden');
                empty.classList.remove('hidden');
                return;
            }

            grid.classList.remove('hidden');
            empty.classList.add('hidden');

            wishlist.sort((a, b) => new Date(b.addedAt) - new Date(a.addedAt)).forEach(doctor => {
                const card = createDoctorCard(doctor);
                grid.appendChild(card);
            });
            
            lucide.createIcons();
        }

        function createDoctorCard(doctor) {
            const div = document.createElement('div');
            div.className = 'animate-in fade-in slide-in-from-bottom-4 duration-500';
            div.innerHTML = `
                <div class="group relative bg-white rounded-[2.5rem] p-6 border border-gray-100 shadow-sm hover:shadow-2xl hover:shadow-rose-900/5 hover:-translate-y-2 transition-all duration-500 overflow-hidden">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-rose-50/30 rounded-full blur-3xl -mr-16 -mt-16 group-hover:bg-rose-100/50 transition-colors"></div>
                    
                    <button onclick="removeFromWishlist(${doctor.id})" class="absolute top-6 right-6 p-2.5 bg-rose-50 text-rose-500 border border-rose-100 rounded-xl hover:bg-rose-500 hover:text-white transition-all shadow-sm z-10" title="Remove from Wishlist">
                        <i data-lucide="heart" fill="currentColor" class="w-4 h-4"></i>
                    </button>

                    <div class="flex flex-col items-center text-center mb-6">
                        <div class="relative mb-4">
                            <div class="absolute inset-0 bg-blue-600/10 rounded-[2rem] scale-110 blur-xl group-hover:scale-125 transition-transform"></div>
                            <img src="${doctor.image}" class="relative w-24 h-24 rounded-[2rem] object-cover shadow-xl border-4 border-white">
                        </div>
                        
                        <h3 class="font-semibold text-gray-900 text-xl tracking-tight mb-1">${doctor.name}</h3>
                        <p class="text-rose-600 text-[10px] font-semibold uppercase tracking-widest mb-3">${doctor.specialty}</p>
                        
                        <div class="text-[9px] font-semibold text-gray-400 uppercase tracking-[0.2em] mt-2">
                            Saved on ${new Date(doctor.addedAt).toLocaleDateString()}
                        </div>
                    </div>

                    <div class="space-y-3">
                        <a href="/Dashboard/DoctorProfile/${doctor.id}" 
                           class="w-full py-4 bg-gray-900 text-white rounded-2xl text-[10px] font-semibold uppercase tracking-[0.15em] hover:bg-blue-600 transition-all flex items-center justify-center gap-2 group/btn shadow-lg shadow-gray-900/10">
                            Book Appointment
                            <i data-lucide="calendar" class="w-4 h-4"></i>
                        </a>
                        
                        <a href="/Dashboard/DoctorProfile/${doctor.id}" 
                           class="w-full py-3 bg-white border border-gray-100 text-gray-600 rounded-xl text-[9px] font-semibold uppercase tracking-widest hover:border-gray-200 transition-all text-center">
                            View Full Profile
                        </a>
                    </div>
                </div>
            `;
            return div;
        }

        function removeFromWishlist(id) {
            let wishlist = getWishlist();
            wishlist = wishlist.filter(d => d.id !== id);
            localStorage.setItem('medlink_wishlist', JSON.stringify(wishlist));
            renderWishlist();
            
            // Notification (if available in layout)
            if (typeof showToast === 'function') {
                showToast('Removed from wishlist', 'info');
            }
        }

        async function clearWishlist() {
            const confirmed = await confirmModal.show({
                title: 'Clear Wishlist?',
                message: 'Are you sure you want to clear your entire wishlist?',
                confirmText: 'Clear All',
                type: 'rose'
            });

            if (confirmed) {
                localStorage.removeItem('medlink_wishlist');
                renderWishlist();
            }
        }

        document.addEventListener('DOMContentLoaded', renderWishlist);
    </script>
}
