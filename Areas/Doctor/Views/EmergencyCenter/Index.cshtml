@{
    ViewData["Title"] = "Emergency Operations Center";
    Layout = "~/Areas/Doctor/Views/Shared/_DocDash.cshtml";
}

<div class="min-h-[80vh] flex flex-col space-y-8 animate-in fade-in duration-700">
    <!-- Tactical Header -->
    <div class="relative overflow-hidden rounded-[32px] bg-slate-900 border border-slate-800 p-8 lg:p-12 shadow-2xl">
        <!-- Background decorative elements -->
        <div class="absolute top-0 right-0 w-1/2 h-full bg-gradient-to-l from-rose-500/10 to-transparent"></div>
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-blue-500/5 rounded-full blur-3xl"></div>
        
        <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-8">
            <div class="space-y-4">
                <div class="inline-flex items-center space-x-3 px-4 py-2 bg-rose-500/10 border border-rose-500/20 rounded-full">
                    <div class="w-2 h-2 bg-rose-500 rounded-full animate-pulse"></div>
                    <span class="text-[10px] font-semibold text-rose-500 uppercase tracking-[0.2em]">Live Tactical Feed</span>
                </div>
                <h1 class="text-3xl lg:text-5xl font-semibold text-white tracking-tighter">Emergency Operations <span class="text-rose-500">Center</span></h1>
                <p class="text-slate-400 font-medium max-w-xl text-sm lg:text-base leading-relaxed">
                    Listening for high-priority triage requests across the secure MedLink Bio-Network. 
                    Real-time synchronization active.
                </p>
            </div>
            
            <div class="flex items-center gap-4">
                <div class="p-6 bg-slate-800/50 border border-slate-700 rounded-[24px] backdrop-blur-md text-center min-w-[140px]">
                    <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Network Status</div>
                    <div class="text-emerald-500 font-semibold flex items-center justify-center gap-2">
                        <i class="fas fa-shield-halved"></i>
                        SECURE
                    </div>
                </div>
                <div class="p-6 bg-slate-800/50 border border-slate-700 rounded-[24px] backdrop-blur-md text-center min-w-[140px]">
                    <div class="text-[10px] font-bold text-slate-500 uppercase tracking-widest mb-1">Active Nodes</div>
                    <div id="active-nodes-count" class="text-white font-semibold text-xl">0</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts Grid -->
    <div id="emergency-alerts-container" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 lg:gap-8">
        <!-- Placeholder when no alerts -->
        <div id="no-alerts-placeholder" class="col-span-full py-20 flex flex-col items-center justify-center space-y-6 opacity-40">
            <div class="relative">
                <div class="absolute inset-0 bg-rose-500/20 blur-2xl rounded-full animate-pulse"></div>
                <div class="w-24 h-24 rounded-full border-2 border-dashed border-slate-300 flex items-center justify-center">
                    <i class="fas fa-satellite-dish text-4xl text-slate-400 animate-bounce"></i>
                </div>
            </div>
            <div class="text-center">
                <h3 class="text-xl font-semibold text-slate-700 dark:text-slate-300">Scanning Bio-Frequencies...</h3>
                <p class="text-slate-500 text-sm font-medium mt-2">Standing by for incoming triage routing.</p>
            </div>
        </div>
    </div>
</div>

<!-- Alert Card Template -->
<template id="emergency-alert-template">
    <div class="emergency-card group relative">
        <div class="absolute -inset-0.5 bg-gradient-to-br from-rose-500 to-amber-500 rounded-[32px] opacity-20 group-hover:opacity-100 transition duration-500 blur-sm"></div>
        <div class="relative bg-white dark:bg-slate-900 rounded-[32px] p-8 space-y-6 shadow-xl border border-slate-100 dark:border-white/5 h-full flex flex-col">
            <!-- Card Header -->
            <div class="flex items-start justify-between">
                <div class="w-14 h-14 bg-rose-500 rounded-2xl flex items-center justify-center text-white text-2xl shadow-lg shadow-rose-500/30 transform group-hover:rotate-6 transition-transform">
                    <i class="fas fa-truck-medical"></i>
                </div>
                <div class="text-right">
                    <div class="priority-label px-3 py-1 bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 text-[10px] font-semibold rounded-lg uppercase tracking-widest mb-2">High Priority</div>
                    <div class="timestamp-badge text-[10px] font-bold text-slate-400">Just Now</div>
                </div>
            </div>

            <!-- Patient Info -->
            <div class="space-y-1">
                <h3 class="patient-name text-2xl font-semibold text-slate-900 dark:text-white tracking-tight">Patient Name</h3>
                <p class="text-xs font-medium text-slate-500 flex items-center gap-2">
                    <i class="fas fa-fingerprint text-rose-500/50"></i>
                    Session: <span class="session-id font-mono text-slate-400"></span>
                </p>
            </div>

            <!-- Symptom Area -->
            <div class="flex-grow space-y-4">
                <div class="flex flex-wrap gap-2">
                    <span class="specialty-label px-3 py-1.5 bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 rounded-xl text-[10px] font-semibold text-slate-600 dark:text-slate-400 uppercase tracking-widest">General</span>
                </div>
                <div class="p-4 bg-slate-50 dark:bg-slate-800/50 rounded-2xl border border-slate-100 dark:border-white/5">
                    <div class="text-[9px] font-semibold text-slate-400 uppercase tracking-[0.2em] mb-2">Patient Symptoms</div>
                    <p class="symptoms-text text-sm font-semibold text-slate-700 dark:text-slate-300 line-clamp-3 leading-relaxed"></p>
                </div>
            </div>

            <!-- Action Area -->
            <button class="join-room-btn group/btn w-full py-4 bg-rose-600 hover:bg-rose-700 text-white rounded-2xl font-semibold text-xs uppercase tracking-[0.2em] shadow-xl shadow-rose-500/20 transition-all flex items-center justify-center gap-3 active:scale-[0.98]">
                <span>Launch Live Session</span>
                <i class="fas fa-arrow-right group-hover/btn:translate-x-1 transition-transform"></i>
            </button>
        </div>
    </div>
</template>

<style>
    .emergency-card {
        animation: cardAppear 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
        transition: opacity 0.5s ease, transform 0.5s ease;
    }

    @@keyframes cardAppear {
        from { transform: scale(0.9) translateY(30px); opacity: 0; }
        to { transform: scale(1) translateY(0); opacity: 1; }
    }
    
    .card-expire {
        opacity: 0 !important;
        transform: scale(0.9) translateY(-20px) !important;
        pointer-events: none;
    }
</style>

@section Scripts {
    <script>
        (function() {
            let activeAlertsCount = 0;
            const container = document.getElementById("emergency-alerts-container");
            const placeholder = document.getElementById("no-alerts-placeholder");
            const counterEl = document.getElementById("active-nodes-count");
            const EXPIRY_TIME = 60000; // 1 Minute

            function updateCounter(delta) {
                activeAlertsCount = Math.max(0, activeAlertsCount + delta);
                if (counterEl) counterEl.textContent = activeAlertsCount;
                
                if (activeAlertsCount === 0 && placeholder) {
                    placeholder.style.display = 'flex';
                }
            }

            function renderAlert(alertData, isHistory = false) {
                if (placeholder) placeholder.style.display = 'none';
                
                const template = document.getElementById("emergency-alert-template");
                const clone = template.content.cloneNode(true);
                const card = clone.querySelector('.emergency-card');
                
                const priority = alertData.priority || alertData.Priority || "HIGH";
                const patientName = alertData.patientName || alertData.PatientName || "Unknown Patient";
                const sessionId = alertData.sessionId || alertData.SessionId || "";
                const specialty = alertData.specialty || alertData.Specialty || "URGENT TRIAGE";
                const symptoms = alertData.symptoms || alertData.Symptoms || "No symptoms reported.";
                const receivedAt = alertData.receivedAt || new Date().getTime();

                card.querySelector('.priority-label').textContent = priority.toUpperCase() + " PRIORITY";
                card.querySelector('.patient-name').textContent = patientName;
                card.querySelector('.session-id').textContent = sessionId;
                card.querySelector('.specialty-label').textContent = specialty;
                card.querySelector('.symptoms-text').textContent = symptoms;
                
                if (isHistory) {
                    const diff = Math.round((new Date().getTime() - receivedAt) / 1000);
                    card.querySelector('.timestamp-badge').textContent = diff + "s ago";
                }

                const joinBtn = card.querySelector('.join-room-btn');
                joinBtn.addEventListener('click', function() {
                    const triageRoomId = sessionId.startsWith("triage_") ? sessionId : "triage_" + sessionId;
                    window.location.href = "/Doctor/Doctor/ConsultationRoom?id=" + triageRoomId;
                });
                
                // Expiry Logic
                const timeRemaining = EXPIRY_TIME - (new Date().getTime() - receivedAt);
                if (timeRemaining <= 0) return; // Already expired

                setTimeout(() => {
                    card.classList.add('card-expire');
                    setTimeout(() => {
                        card.remove();
                        updateCounter(-1);
                    }, 500);
                }, timeRemaining);

                if (container.firstChild) {
                    container.insertBefore(card, container.firstChild);
                } else {
                    container.appendChild(card);
                }
                
                updateCounter(1);
            }

            // Load History on Startup
            function loadHistory() {
                const history = JSON.parse(localStorage.getItem('medlink_emergency_history') || '[]');
                const now = new Date().getTime();
                // Filter out alerts older than 1 minute
                const validHistory = history.filter(a => (now - (a.receivedAt || 0)) < EXPIRY_TIME);
                
                validHistory.reverse().forEach(alert => renderAlert(alert, true));
                localStorage.setItem('medlink_emergency_history', JSON.stringify(validHistory));
            }

            window.addEventListener('medlink:emergency', function(e) {
                renderAlert(e.detail);
            });
            
            loadHistory();
            console.log("Emergency Center: 60s Expiry active.");
        })();
    </script>
}
