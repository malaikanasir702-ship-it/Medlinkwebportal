@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "AI Doctor";
}

<div class="h-[calc(100dvh-8rem)] min-h-[640px] grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_360px] gap-5">
    <section class="bg-white border border-gray-100 rounded-[2rem] shadow-sm overflow-hidden flex flex-col">
        <div class="px-5 md:px-7 py-5 border-b border-gray-100 bg-gradient-to-r from-blue-50/80 via-white to-indigo-50/60 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <div class="relative">
                    <div class="absolute inset-0 bg-blue-500/20 blur-xl rounded-2xl animate-pulse"></div>
                    <div class="relative w-12 h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center shadow-lg shadow-blue-500/20">
                        <i data-lucide="bot" class="w-6 h-6"></i>
                    </div>
                </div>
                <div>
                    <h2 class="text-lg md:text-xl font-semibold text-gray-900 tracking-tight">AI Doctor Consultant</h2>
                    <p class="text-xs md:text-sm font-medium text-gray-500">Roman Urdu ya English mein symptoms describe karein.</p>
                </div>
            </div>
            <button id="clearAiDoctorChat" class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-2xl bg-white border border-gray-100 text-gray-500 hover:text-rose-600 hover:border-rose-100 hover:bg-rose-50 transition-all text-[10px] font-semibold uppercase tracking-widest">
                <i data-lucide="refresh-ccw" class="w-4 h-4"></i>
                Clear
            </button>
        </div>

        <div id="aiDoctorMessages" class="flex-1 overflow-y-auto custom-scrollbar px-4 md:px-7 py-6 space-y-5 bg-[#F8FAFC]"></div>

        <div id="aiDoctorTyping" class="hidden px-4 md:px-7 pb-3 bg-[#F8FAFC]">
            <div class="flex items-start gap-3">
                <div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center shrink-0">
                    <i data-lucide="bot" class="w-4 h-4"></i>
                </div>
                <div class="px-4 py-3 rounded-2xl rounded-bl-md bg-white border border-gray-100 shadow-sm text-xs font-bold text-gray-400 italic">
                    AI Doctor is typing...
                </div>
            </div>
        </div>

        <form id="aiDoctorForm" class="p-4 md:p-5 bg-white border-t border-gray-100">
            <div class="flex items-end gap-3">
                <div class="flex-1 relative">
                    <textarea id="aiDoctorInput" rows="1" class="w-full resize-none rounded-2xl bg-gray-50 border border-gray-100 px-5 py-4 pr-12 text-sm font-semibold text-gray-800 placeholder:text-gray-400 focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all max-h-36" placeholder="Describe symptoms..."></textarea>
                    <i data-lucide="stethoscope" class="w-4 h-4 text-gray-400 absolute right-4 top-4"></i>
                </div>
                <button id="aiDoctorSend" type="submit" class="w-12 h-12 rounded-2xl bg-blue-600 text-white flex items-center justify-center shadow-lg shadow-blue-500/20 hover:bg-blue-700 active:scale-95 transition-all">
                    <i data-lucide="send" class="w-5 h-5"></i>
                </button>
            </div>
        </form>
    </section>

    <aside class="space-y-5">
        <div class="bg-gray-900 text-white rounded-[2rem] p-6 shadow-xl shadow-gray-900/10">
            <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 border border-white/10 text-[9px] font-semibold uppercase tracking-widest mb-5">
                <i data-lucide="shield-alert" class="w-3 h-3"></i>
                Medical Safety
            </div>
            <h3 class="text-xl font-semibold tracking-tight mb-3">AI guidance, not a diagnosis.</h3>
            <p class="text-sm text-gray-300 leading-relaxed font-medium">Serious symptoms, chest pain, breathing issue, fainting, severe bleeding, or emergency mein nearest hospital ya rescue services contact karein.</p>
        </div>

        <div class="bg-white border border-gray-100 rounded-[2rem] p-6 shadow-sm">
            <h3 class="text-base font-semibold text-gray-900 flex items-center gap-2 mb-4">
                <i data-lucide="sparkles" class="w-4 h-4 text-blue-600"></i>
                Quick Prompts
            </h3>
            <div class="space-y-2">
                <button type="button" class="ai-prompt w-full text-left px-4 py-3 rounded-2xl bg-gray-50 hover:bg-blue-50 hover:text-blue-700 transition-all text-xs font-bold text-gray-600">Mujhe fever aur body pain hai.</button>
                <button type="button" class="ai-prompt w-full text-left px-4 py-3 rounded-2xl bg-gray-50 hover:bg-blue-50 hover:text-blue-700 transition-all text-xs font-bold text-gray-600">I have chest discomfort since morning.</button>
                <button type="button" class="ai-prompt w-full text-left px-4 py-3 rounded-2xl bg-gray-50 hover:bg-blue-50 hover:text-blue-700 transition-all text-xs font-bold text-gray-600">Mere pait mein dard aur nausea hai.</button>
            </div>
        </div>
    </aside>
</div>

<div id="aiDoctorDisclaimer" class="hidden fixed inset-0 z-[120] flex items-center justify-center p-4 bg-gray-900/50 backdrop-blur-sm">
    <div class="w-full max-w-md bg-white rounded-[2rem] p-7 shadow-2xl border border-white/60">
        <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center mb-5">
            <i data-lucide="alert-triangle" class="w-7 h-7"></i>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Disclaimer</h3>
        <p class="text-sm text-gray-500 font-medium leading-relaxed mb-6">This AI tool is for informational purposes only. It is not a substitute for professional medical advice. In case of emergency, visit a hospital immediately.</p>
        <button id="acceptAiDoctorDisclaimer" class="w-full py-3.5 bg-blue-600 text-white rounded-2xl font-semibold text-xs uppercase tracking-widest hover:bg-blue-700 transition-all">
            I Understand
        </button>
    </div>
</div>

<script>
    (function () {
        const historyUrl = '@Url.Action("GetAiDoctorHistory", "Dashboard")';
        const sendUrl = '@Url.Action("SendAiDoctorMessage", "Dashboard")';
        const clearUrl = '@Url.Action("ClearAiDoctorHistory", "Dashboard")';
        const profileUrl = '@Url.Action("DoctorProfile", "Dashboard")';
        const fallbackGreeting = 'Assalam-o-Alaikum! Main aapka AI Medical Assistant hoon. Aap ko kya masla hai? (How can I help you today?)';

        const messagesEl = document.getElementById('aiDoctorMessages');
        const form = document.getElementById('aiDoctorForm');
        const input = document.getElementById('aiDoctorInput');
        const sendBtn = document.getElementById('aiDoctorSend');
        const typing = document.getElementById('aiDoctorTyping');
        const clearBtn = document.getElementById('clearAiDoctorChat');
        const disclaimer = document.getElementById('aiDoctorDisclaimer');
        const acceptDisclaimer = document.getElementById('acceptAiDoctorDisclaimer');
        let isLoading = false;

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, function (char) {
                return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char];
            });
        }

        function avatar(isUser) {
            if (isUser) {
                return '<div class="w-9 h-9 rounded-full bg-gray-900 text-white flex items-center justify-center shrink-0"><i data-lucide="user" class="w-4 h-4"></i></div>';
            }
            return '<div class="w-9 h-9 rounded-full bg-blue-600 text-white flex items-center justify-center shrink-0 shadow-md shadow-blue-500/20"><i data-lucide="bot" class="w-4 h-4"></i></div>';
        }

        function doctorImage(doctor) {
            if (doctor.image) return doctor.image;
            return 'https://ui-avatars.com/api/?name=' + encodeURIComponent(doctor.name || 'Doctor') + '&size=128&background=random&color=fff&bold=true';
        }

        function renderDoctors(doctors) {
            if (!Array.isArray(doctors) || doctors.length === 0) return '';
            return '<div class="ml-12 mt-3 grid grid-cols-1 md:grid-cols-2 gap-3">' + doctors.map(function (doctor) {
                const location = doctor.hospitalAffiliations || doctor.clinicName || doctor.availability || 'MedLink clinic';
                return `
                    <a href="${profileUrl}?id=${doctor.id}" class="block bg-white border border-gray-100 rounded-2xl p-4 hover:border-blue-200 hover:shadow-lg hover:shadow-blue-900/5 transition-all">
                        <div class="flex items-center gap-3">
                            <img src="${escapeHtml(doctorImage(doctor))}" class="w-12 h-12 rounded-xl object-cover border border-gray-100" alt="${escapeHtml(doctor.name)}">
                            <div class="min-w-0">
                                <h4 class="text-sm font-semibold text-gray-900 truncate">${escapeHtml(doctor.name)}</h4>
                                <p class="text-[10px] font-semibold uppercase tracking-widest text-blue-600 truncate">${escapeHtml(doctor.specialty)}</p>
                            </div>
                        </div>
                        <div class="flex items-center justify-between mt-4 pt-3 border-t border-gray-50">
                            <span class="text-[10px] font-bold text-gray-400 truncate max-w-[130px]">${escapeHtml(location)}</span>
                            <span class="inline-flex items-center gap-1 text-[10px] font-semibold text-amber-600"><i data-lucide="star" class="w-3 h-3 fill-current"></i>${escapeHtml(doctor.rating || '0')}</span>
                        </div>
                    </a>`;
            }).join('') + '</div>';
        }

        function addMessage(message) {
            const isUser = message.role === 'user' || message.isUser === true;
            const wrap = document.createElement('div');
            wrap.className = isUser ? 'flex flex-col items-end' : 'flex flex-col items-start';
            wrap.innerHTML = `
                <div class="flex items-start gap-3 max-w-[88%] ${isUser ? 'flex-row-reverse' : ''}">
                    ${avatar(isUser)}
                    <div class="px-4 py-3 rounded-2xl ${isUser ? 'rounded-br-md bg-blue-600 text-white shadow-lg shadow-blue-500/20' : 'rounded-bl-md bg-white text-gray-700 border border-gray-100 shadow-sm'}">
                        <p class="text-sm font-semibold leading-relaxed whitespace-pre-wrap">${escapeHtml(message.content || message.reply || message.text)}</p>
                    </div>
                </div>
                ${renderDoctors(message.suggestedDoctors)}
            `;
            messagesEl.appendChild(wrap);
            lucide.createIcons();
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        function setLoading(value) {
            isLoading = value;
            typing.classList.toggle('hidden', !value);
            sendBtn.disabled = value;
            sendBtn.classList.toggle('opacity-60', value);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        async function loadHistory() {
            messagesEl.innerHTML = '';
            try {
                const response = await fetch(historyUrl);
                const history = response.ok ? await response.json() : [];
                if (!history.length) {
                    addMessage({ role: 'assistant', content: fallbackGreeting });
                    return;
                }
                history.forEach(function (message) {
                    addMessage({ role: message.role, content: message.content });
                });
            } catch (error) {
                addMessage({ role: 'assistant', content: fallbackGreeting });
            }
        }

        async function sendMessage(text) {
            if (!text || isLoading) return;
            addMessage({ role: 'user', content: text });
            input.value = '';
            input.style.height = 'auto';
            setLoading(true);

            try {
                const response = await fetch(sendUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: text })
                });
                const data = await response.json().catch(function () { return {}; });
                addMessage({
                    role: 'assistant',
                    content: data.reply || data.message || 'Sorry, I encountered an issue.',
                    suggestedDoctors: data.suggestedDoctors
                });
            } catch (error) {
                addMessage({ role: 'assistant', content: 'Main maafi chahta hoon, AI service se connection nahi ho saka.' });
            } finally {
                setLoading(false);
            }
        }

        form.addEventListener('submit', function (event) {
            event.preventDefault();
            sendMessage(input.value.trim());
        });

        input.addEventListener('input', function () {
            input.style.height = 'auto';
            input.style.height = Math.min(input.scrollHeight, 144) + 'px';
        });

        input.addEventListener('keydown', function (event) {
            if (event.key === 'Enter' && !event.shiftKey) {
                event.preventDefault();
                form.requestSubmit();
            }
        });

        clearBtn.addEventListener('click', async function () {
            const ok = window.confirmModal ? await window.confirmModal.show({
                title: 'Clear AI chat?',
                message: 'This will remove your AI Doctor conversation history from the portal.',
                confirmText: 'Clear',
                type: 'rose'
            }) : confirm('Clear AI chat history?');
            if (!ok) return;

            await fetch(clearUrl, { method: 'POST' });
            await loadHistory();
        });

        document.querySelectorAll('.ai-prompt').forEach(function (button) {
            button.addEventListener('click', function () {
                input.value = button.textContent.trim();
                input.focus();
                input.dispatchEvent(new Event('input'));
            });
        });

        if (localStorage.getItem('ai_doctor_disclaimer_shown') !== 'true') {
            disclaimer.classList.remove('hidden');
        }

        acceptDisclaimer.addEventListener('click', function () {
            localStorage.setItem('ai_doctor_disclaimer_shown', 'true');
            disclaimer.classList.add('hidden');
        });

        loadHistory();
    })();
</script>
