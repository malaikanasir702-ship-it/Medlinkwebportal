@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Security Protocol";
}

<div class="p-6 lg:p-10 space-y-12 max-w-[1400px] mx-auto overflow-hidden animate-in fade-in slide-in-from-bottom-8 duration-1000">
    <!-- Hero Section -->
    <div class="relative bg-slate-900 dark:bg-slate-950 rounded-[3rem] p-8 lg:p-20 overflow-hidden shadow-2xl shadow-blue-500/20 group">
        <!-- Abstract Background -->
        <div class="absolute inset-0 opacity-30">
            <div class="absolute top-0 right-0 w-[800px] h-[800px] bg-blue-600 rounded-full blur-[150px] -mr-96 -mt-96 group-hover:scale-110 transition-transform duration-1000"></div>
            <div class="absolute bottom-0 left-0 w-[600px] h-[600px] bg-indigo-600 rounded-full blur-[120px] -ml-64 -mb-64"></div>
        </div>
        
        <div class="relative z-10 flex flex-col lg:flex-row items-center gap-16">
            <div class="flex-1 space-y-8 text-center lg:text-left">
                <div class="inline-flex items-center gap-2 px-5 py-2.5 bg-white/10 backdrop-blur-xl text-blue-400 rounded-full text-[11px] font-semibold uppercase tracking-[0.3em] border border-white/10">
                    <span class="w-2.5 h-2.5 bg-blue-500 rounded-full animate-ping"></span>
                    Military-Grade Protection Active
                </div>
                <h1 class="text-5xl lg:text-7xl font-semibold text-white leading-[1.05] tracking-tighter">
                    Data Defense <br/>
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400">Architecture.</span>
                </h1>
                <p class="text-slate-400 font-bold max-w-xl text-lg leading-relaxed">
                    Your medical data is your most private asset. We protect it with the same standards used by high-security financial institutions and government agencies.
                </p>
                <div class="flex flex-wrap justify-center lg:justify-start gap-4 pt-4">
                    <div class="flex items-center gap-3 bg-white/5 border border-white/10 px-6 py-4 rounded-2xl backdrop-blur-md">
                        <i data-lucide="lock" class="w-6 h-6 text-blue-400"></i>
                        <span class="text-xs font-semibold text-white uppercase tracking-widest">AES-256 Bit</span>
                    </div>
                    <div class="flex items-center gap-3 bg-white/5 border border-white/10 px-6 py-4 rounded-2xl backdrop-blur-md">
                        <i data-lucide="shield-check" class="w-6 h-6 text-emerald-400"></i>
                        <span class="text-xs font-semibold text-white uppercase tracking-widest">End-to-End</span>
                    </div>
                </div>
            </div>
            
            <div class="relative group">
                <div class="absolute inset-0 bg-blue-500/20 rounded-[4rem] blur-3xl scale-110 group-hover:scale-125 transition-transform duration-700"></div>
                <div class="relative w-64 h-64 lg:w-96 lg:h-96 bg-white/5 backdrop-blur-2xl border border-white/20 rounded-[4rem] flex items-center justify-center shadow-2xl overflow-hidden shadow-blue-500/10">
                    <i data-lucide="shield" class="w-32 h-32 lg:w-48 lg:h-48 text-white opacity-20 absolute rotate-12"></i>
                    <div class="relative flex flex-col items-center">
                         <i data-lucide="brain-circuit" class="w-24 h-24 lg:w-32 lg:h-32 text-blue-400 animate-pulse"></i>
                         <div class="h-1 lg:h-1.5 w-12 lg:w-16 bg-blue-500 rounded-full mt-8 blur-[2px]"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Security Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Card 1: Encryption -->
        <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] p-10 border border-slate-100 dark:border-white/5 shadow-xl group hover:-translate-y-2 transition-all duration-500">
            <div class="w-16 h-16 bg-blue-50 dark:bg-blue-900/30 rounded-2xl flex items-center justify-center text-blue-600 dark:text-blue-400 mb-8 items-start">
                <i data-lucide="key-round" class="w-8 h-8"></i>
            </div>
            <h3 class="text-2xl font-semibold text-slate-900 dark:text-white tracking-tight mb-4">AES-256 Standard</h3>
            <p class="text-slate-500 dark:text-slate-400 font-bold text-sm leading-relaxed">
                Advanced Encryption Standard with a 256-bit key length is virtually unbreakable by even the most powerful supercomputers currently in existence.
            </p>
        </div>

        <!-- Card 2: AI Privacy -->
        <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] p-10 border border-slate-100 dark:border-white/5 shadow-xl group hover:-translate-y-2 transition-all duration-500">
             <div class="w-16 h-16 bg-indigo-50 dark:bg-indigo-900/30 rounded-2xl flex items-center justify-center text-indigo-600 dark:text-indigo-400 mb-8">
                <i data-lucide="eye-off" class="w-8 h-8"></i>
            </div>
            <h3 class="text-2xl font-semibold text-slate-900 dark:text-white tracking-tight mb-4">Anonymized Processing</h3>
            <p class="text-slate-500 dark:text-slate-400 font-bold text-sm leading-relaxed">
                Our MedLink AI processes your data in a secure, decentralized environment. Personal identifiers are removed before medical analysis begins.
            </p>
        </div>

        <!-- Card 3: Real-time Monitoring -->
        <div class="bg-white dark:bg-slate-900 rounded-[2.5rem] p-10 border border-slate-100 dark:border-white/5 shadow-xl group hover:-translate-y-2 transition-all duration-500">
             <div class="w-16 h-16 bg-emerald-50 dark:bg-emerald-900/30 rounded-2xl flex items-center justify-center text-emerald-600 dark:text-emerald-400 mb-8">
                <i data-lucide="activity" class="w-8 h-8"></i>
            </div>
            <h3 class="text-2xl font-semibold text-slate-900 dark:text-white tracking-tight mb-4">Zero-Trust Network</h3>
            <p class="text-slate-500 dark:text-slate-400 font-bold text-sm leading-relaxed">
                Every request is authenticated and verified. We never trust, always verify every interaction within our ecosystem.
            </p>
        </div>
    </div>

    <!-- Deep Dive Info Section -->
    <div class="bg-blue-600 rounded-[3rem] p-12 lg:p-20 text-white relative overflow-hidden group">
        <div class="absolute right-0 top-0 opacity-10">
            <i data-lucide="file-text" class="w-96 h-96 -mr-20 -mt-20"></i>
        </div>
        
        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div class="space-y-8">
                <h2 class="text-4xl lg:text-5xl font-semibold tracking-tight leading-tight">Your Rights Under <br/>Our Protection.</h2>
                <div class="space-y-6">
                    <div class="flex gap-4">
                        <div class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-white/20 flex items-center justify-center">
                             <i data-lucide="check" class="w-4 h-4 text-white"></i>
                        </div>
                        <div>
                            <h4 class="font-semibold text-lg">Absolute Ownership</h4>
                            <p class="text-blue-100 font-bold text-sm opacity-80">You own 100% of your records. You can request deletion or download at any time.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                         <div class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-white/20 flex items-center justify-center">
                             <i data-lucide="check" class="w-4 h-4 text-white"></i>
                        </div>
                        <div>
                            <h4 class="font-semibold text-lg">No Third-Party Access</h4>
                            <p class="text-blue-100 font-bold text-sm opacity-80">Your data is never sold or shared with advertisers. It stays within your medical circle.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                         <div class="mt-1 flex-shrink-0 w-6 h-6 rounded-full bg-white/20 flex items-center justify-center">
                             <i data-lucide="check" class="w-4 h-4 text-white"></i>
                        </div>
                        <div>
                            <h4 class="font-semibold text-lg">Compliance Ready</h4>
                            <p class="text-blue-100 font-bold text-sm opacity-80">Built to exceed HIPAA and international medical data protection regulations.</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="bg-white/10 backdrop-blur-2xl rounded-[2.5rem] p-10 border border-white/20 space-y-8">
                <div class="flex justify-between items-center">
                    <div class="text-[10px] font-semibold uppercase tracking-[0.2em] opacity-60">System Log</div>
                    <div class="flex items-center gap-2">
                        <span class="w-2 h-2 bg-emerald-400 rounded-full"></span>
                        <span class="text-[10px] font-semibold uppercase tracking-[0.2em]">Operational</span>
                    </div>
                </div>
                <div class="space-y-4 font-mono text-[11px] opacity-80">
                    <p class="flex justify-between"><span>> INITIATING ENCRYPTION LAYER...</span> <span class="text-blue-300">[SUCCESS]</span></p>
                    <p class="flex justify-between"><span>> VERIFYING P2P INTEGRITY...</span> <span class="text-blue-300">[SECURE]</span></p>
                    <p class="flex justify-between"><span>> SHIELDING TRANSLATION BUFFER...</span> <span class="text-blue-300">[ENABLED]</span></p>
                    <p class="flex justify-between"><span>> AUDITING ACCESS LOGS...</span> <span class="text-blue-300">[CLEAN]</span></p>
                </div>
                <button onclick="window.print()" class="w-full py-4 bg-white text-blue-600 rounded-2xl text-[10px] font-semibold uppercase tracking-[0.2em] shadow-xl hover:bg-blue-50 transition-all flex items-center justify-center gap-3">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    Export Privacy Statement
                </button>
            </div>
        </div>
    </div>
    
    <div class="flex justify-center pt-8">
        <a href="@Url.Action("TranscriptionHistory", "Dashboard")" class="inline-flex items-center gap-3 px-8 py-5 bg-white dark:bg-slate-900 border border-slate-100 dark:border-white/5 rounded-2xl text-[10px] font-semibold uppercase tracking-[0.2em] text-slate-400 hover:text-blue-600 hover:border-blue-500/30 transition-all group">
            <i data-lucide="move-left" class="w-4 h-4 group-hover:-translate-x-1 transition-transform"></i>
            Return to Hub
        </a>
    </div>
</div>
