@model List<MedLinkPortal.Models.Department>

<section id="departments" class="py-32 px-6 bg-white overflow-hidden">
    <div class="max-w-7xl mx-auto">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-20 gap-8 fade-right" data-animate>
            <div class="max-w-xl">
                <h2 class="text-sm font-bold text-blue-600 uppercase tracking-[0.2em] mb-4">Medical Specialties</h2>
                <h3 class="text-4xl md:text-5xl font-bold text-gray-900 tracking-tight leading-tight">
                    World-class expertise <br />
                    <span class="text-gray-400">across every discipline.</span>
                </h3>
            </div>
            <p class="text-gray-600 max-w-sm mb-2">
                Access a vast network of board-certified specialists ready to provide precision care tailored to your needs.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 stagger-children" data-animate>
            @foreach (var dept in Model)
            {
                <div class="group relative bg-gray-50 rounded-[2rem] p-8 border border-gray-100 hover:bg-white hover:shadow-2xl hover:shadow-gray-200 transition-all duration-500 overflow-hidden fade-up" data-animate>
                    <div class="absolute -right-8 -top-8 w-32 h-32 rounded-full opacity-[0.03] group-hover:opacity-[0.08] transition-opacity @dept.Color"></div>

                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl @dept.Color text-white flex items-center justify-center mb-6 shadow-lg group-hover:scale-110 transition-transform duration-500">
                            <i data-lucide="@dept.Icon.ToLower()" class="w-7 h-7"></i>
                        </div>

                        <div class="flex items-center justify-between mb-4">
                            <h4 class="text-2xl font-bold text-gray-900">@dept.Title</h4>
                            <span class="bg-white border border-gray-100 px-3 py-1 rounded-full text-[10px] font-bold text-gray-500 uppercase tracking-wider">
                                @dept.Specialists Doctors
                            </span>
                        </div>

                        <p class="text-gray-500 mb-8 leading-relaxed line-clamp-2 group-hover:line-clamp-none transition-all">
                            @dept.Description
                        </p>

                        <div class="space-y-2 opacity-0 group-hover:opacity-100 transition-all duration-500 translate-y-4 group-hover:translate-y-0">
                            <div class="text-[10px] font-black text-gray-400 uppercase tracking-widest mb-2">Key Services</div>
                            @if (dept.Services != null)
                            {
                                @foreach (var service in dept.Services)
                                {
                                    <div class="flex items-center gap-2 text-sm text-gray-700 font-medium">
                                        <div class="w-1 h-1 rounded-full @dept.Color"></div>
                                        @service
                                    </div>
                                }
                            }
                            <a href="@Url.Action("DepartmentDetails", "Home", new { id = dept.Id })"
                                    class="mt-6 flex items-center gap-2 text-blue-600 font-bold text-sm hover:gap-3 transition-all">
                                Explore Department <i data-lucide="arrow-right" class="w-4 h-4"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="mt-20 p-8 md:p-12 rounded-[2.5rem] bg-blue-50 border border-blue-100 flex flex-col md:flex-row items-center justify-between gap-8 fade-up delay-300" data-animate>
            <div class="flex items-center gap-6">
                <div class="bg-blue-600 p-4 rounded-2xl text-white">
                    <i data-lucide="stethoscope" class="w-8 h-8"></i>
                </div>
                <div>
                    <h4 class="text-xl font-bold text-gray-900">Need immediate help?</h4>
                    <p class="text-gray-600">Our General Practitioners are available 24/7 for urgent triage.</p>
                </div>
            </div>
            <a href="@Url.Action("GPNow", "Home")"
                    class="whitespace-nowrap bg-gray-900 text-white px-8 py-4 rounded-full font-bold hover:bg-black transition-colors shadow-lg">
                Consult a GP Now
            </a>
        </div>
    </div>
</section>
