@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Payment Successful";
    ViewData["HeaderTitle"] = "Payment Successful";
    ViewData["HeaderSubtitle"] = "Your appointment has been confirmed.";
}

<div class="flex flex-col items-center justify-center min-h-[60vh] text-center space-y-6">
    <div class="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center mb-4 animate-bounce">
        <i data-lucide="check" class="w-12 h-12 text-green-600"></i>
    </div>
    
    <div class="space-y-2">
        <h2 class="text-3xl font-semibold text-gray-900">Payment Successful!</h2>
        <p class="text-gray-500 text-lg max-w-md mx-auto">
            Your appointment with <span class="font-bold text-gray-900">@Model.SuccessAppointment?.Doctor?.Name</span> has been successfully booked and paid for.
        </p>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-gray-100 shadow-lg w-full max-w-md text-left space-y-4">
        <div class="flex items-center gap-4">
            <img src="@Model.SuccessAppointment?.Doctor?.Image" class="w-16 h-16 rounded-xl object-cover" alt="@Model.SuccessAppointment?.Doctor?.Name">
            <div>
                <h3 class="font-bold text-gray-900">@Model.SuccessAppointment?.Doctor?.Name</h3>
                <p class="text-sm text-gray-500">@Model.SuccessAppointment?.Doctor?.Specialty</p>
            </div>
        </div>
        <div class="border-t border-gray-100 pt-4 space-y-3">
            <div class="flex justify-between text-sm">
                <span class="text-gray-500">Date</span>
                <span class="font-bold text-gray-900">@Model.SuccessAppointment?.AppointmentDate.ToString("MMMM dd, yyyy")</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-gray-500">Time</span>
                <span class="font-bold text-gray-900">@Model.SuccessAppointment?.TimeSlot</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-gray-500">Type</span>
                <span class="font-bold text-gray-900">@Model.SuccessAppointment?.ConsultationType</span>
            </div>
            <div class="flex justify-between text-sm pt-2 border-t border-dashed border-gray-200">
                <span class="text-gray-500">Amount Paid</span>
                <span class="font-bold text-green-600">PKR @Model.AmountPaid.ToString("N2")</span>
            </div>
        </div>
    </div>

    <div class="flex flex-col sm:flex-row gap-4">
        <a href="@Url.Action("Appointments", "Dashboard")" class="px-8 py-3 bg-blue-600 text-white font-bold rounded-xl shadow-lg shadow-blue-500/30 hover:bg-blue-700 hover:scale-105 transition-all flex items-center gap-2">
            Go to Appointments <i data-lucide="arrow-right" class="w-4 h-4"></i>
        </a>
        <a href="@Url.Action("DownloadInvoice", "Dashboard", new { id = Model.SuccessAppointment?.Id })" target="_blank" class="px-8 py-3 bg-white text-gray-900 border border-gray-200 font-bold rounded-xl shadow-sm hover:bg-gray-50 hover:scale-105 transition-all flex items-center gap-2">
            Download Invoice <i data-lucide="download" class="w-4 h-4"></i>
        </a>
    </div>
</div>
