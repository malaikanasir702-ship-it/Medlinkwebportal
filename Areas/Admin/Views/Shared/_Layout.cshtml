<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedLink</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --primary: #2563eb;
            --accent: #0ea5e9;
            --bg: #f8fafc;
        }
        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--bg);
            color: #1e293b;
            -webkit-font-smoothing: antialiased;
            overflow-x: hidden;
        }
        .mesh-bg {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            z-index: -1;
            background-color: #f8fafc;
            background-image: 
                radial-gradient(at 0% 0%, hsla(217,100%,97%,1) 0, transparent 50%), 
                radial-gradient(at 50% 0%, hsla(215,100%,95%,1) 0, transparent 50%), 
                radial-gradient(at 100% 0%, hsla(210,100%,92%,1) 0, transparent 50%),
                radial-gradient(at 0% 100%, hsla(190,100%,96%,1) 0, transparent 50%);
            background-attachment: fixed;
        }
        .glass-panel {
            background: rgba(255, 255, 255, 0.6);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.04);
        }
        .bento-card {
            background: #ffffff;
            border-radius: 32px;
            border: 1px solid rgba(0, 0, 0, 0.03);
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
            position: relative;
            overflow: hidden;
        }
        .bento-card:hover {
            transform: translateY(-8px) scale(1.01);
            box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.08), 0 18px 36px -18px rgba(0, 0, 0, 0.05);
            border-color: rgba(37, 99, 235, 0.1);
        }
        .glow-pulse {
            box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4);
            animation: pulse-glow 2s infinite;
        }
        @@keyframes pulse-glow {
            0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
            100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }
        ::-webkit-scrollbar { width: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .skeleton {
            background-color: #e2e8f0;
            background-image: linear-gradient(
                90deg,
                rgba(255, 255, 255, 0) 0,
                rgba(255, 255, 255, 0.2) 20%,
                rgba(255, 255, 255, 0.5) 60%,
                rgba(255, 255, 255, 0)
            );
            background-size: 200% 100%;
            animation: shimmer 2s infinite linear;
        }
        @@keyframes shimmer {
            to {
                background-position-x: -200%;
            }
        }
        .skeleton-text {
            height: 1rem;
            margin-bottom: 0.5rem;
            border-radius: 0.25rem;
            width: 100%;
        }
        .skeleton-title {
            height: 2rem;
            margin-bottom: 1rem;
            border-radius: 0.5rem;
            width: 60%;
        }
        .skeleton-avatar {
            width: 3rem;
            height: 3rem;
            border-radius: 50%;
        }
        .skeleton-card {
            background: white;
            border-radius: 32px;
            padding: 2rem;
            border: 1px solid rgba(0, 0, 0, 0.03);
        }
        .content-hidden {
            display: none !important;
        }
        [data-theme="dark"] {
            --bg: #0f172a;
            --primary: #3b82f6;
            background-color: var(--bg);
            color: #e2e8f0;
        }
        [data-theme="dark"] .bg-white { background-color: #1e293b !important; color: #e2e8f0 !important; border-color: #334155 !important; }
        [data-theme="dark"] .bg-slate-50 { background-color: #334155 !important; } 
        [data-theme="dark"] .bg-slate-100 { background-color: #334155 !important; border-color: #475569 !important; }
        [data-theme="dark"] .bg-[#0F172A] { background-color: #3b82f6 !important; color: #ffffff !important; } 
        [data-theme="dark"] .text-slate-900 { color: #f8fafc !important; }
        [data-theme="dark"] .text-slate-700 { color: #e2e8f0 !important; } 
        [data-theme="dark"] .text-slate-600 { color: #cbd5e1 !important; }
        [data-theme="dark"] .text-slate-500 { color: #94a3b8 !important; }
        [data-theme="dark"] .text-slate-400 { color: #cbd5e1 !important; }
        [data-theme="dark"] .border-slate-100, [data-theme="dark"] .border-slate-200 { border-color: #334155 !important; }
        [data-theme="dark"] .border-white { border-color: #1e293b !important; } 
        [data-theme="dark"] .bg-white { background-color: #1e293b !important; color: #e2e8f0 !important; border-color: #334155 !important; }
        [data-theme="dark"] .group:hover .group-hover\:bg-white { background-color: #334155 !important; } 
        [data-theme="dark"] .shadow-slate-200 { --tw-shadow-color: #000000 !important; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -2px rgba(0, 0, 0, 0.3) !important; } 
        [data-theme="dark"] #sidebar { background-color: #020617; border-color: #1e293b; }
        [data-theme="dark"] .bento-card { background-color: #1e293b; border-color: #334155; }
        [data-theme="dark"] input, [data-theme="dark"] textarea, [data-theme="dark"] select { 
            background-color: #0f172a !important; 
            border-color: #334155 !important; 
            color: white !important; 
        }
        [data-theme="dark"] .skeleton {
            background-color: #1e293b !important;
            background-image: linear-gradient(
                90deg,
                rgba(255, 255, 255, 0) 0,
                rgba(255, 255, 255, 0.05) 20%,
                rgba(255, 255, 255, 0.1) 60%,
                rgba(255, 255, 255, 0)
            ) !important;
        }
        [data-theme="dark"] .skeleton-card {
            background: #1e293b !important;
            border-color: #334155 !important;
        }
        [data-theme="dark"] .hover\:bg-slate-50:hover { background-color: #1e293b !important; }
        [data-theme="dark"] .hover\:bg-slate-50\/80:hover { background-color: #1e293b !important; } 
        [data-theme="dark"] .hover\:bg-blue-50:hover { background-color: #1e293b !important; }
        [data-theme="dark"] .group:hover .group-hover\:bg-white { background-color: #1e293b !important; }
        [data-theme="dark"] .group:hover .group-hover\:text-white { color: #ffffff !important; }
        [data-theme="dark"] .notification-item { border-color: #334155 !important; }
        
        .modal-content {
            background-color: #ffffff !important;
            border: 1px solid #e2e8f0 !important;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25) !important;
        }
        
        [data-theme="light"] .modal-content,
        .modal-content.bg-white {
            background-color: #ffffff !important;
        }
        
        [data-theme="dark"] .modal-content { 
            background-color: #1e293b !important; 
            border: 1px solid #334155 !important; 
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;
        }
        [data-theme="blue"] {
            --bg: #f0f9ff;
            background-color: var(--bg);
            color: #0c4a6e;
        }
        [data-theme="blue"] #sidebar { background-color: #0c4a6e; border-color: #075985; }
        [data-theme="blue"] .bg-slate-50 { background-color: #e0f2fe !important; }
        [data-theme="blue"] .text-slate-500 { color: #0369a1 !important; }
        [data-theme="blue"] .text-slate-900 { color: #0c4a6e !important; }
        .modal-overlay {
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(8px);
            z-index: 100;
        }
    </style>
    <script>
        // Apply theme immediately to prevent flash
        (function() {
            const savedTheme = localStorage.getItem('medidash_theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
            document.documentElement.className = savedTheme; // For simple selectors if needed
        })();
        window.setTheme = function(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            localStorage.setItem('medidash_theme', theme);
        };
    </script>
</head>
