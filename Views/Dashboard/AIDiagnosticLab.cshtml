@model MedLinkPortal.Models.PatientDashboardModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "AI Diagnostic Lab";
    ViewData["HeaderTitle"] = "AI Diagnostic Lab";
    ViewData["HeaderSubtitle"] = "Advanced health analysis powered by artificial intelligence.";
}

<div class="grid grid-cols-12 gap-5" x-data="{ 
    showShareModal: false, 
    selectedDoctorId: null, 
    isSharing: false, 
    sharedSuccess: false,
    async shareWithSelectedDoctor() {
        if (!currentAnalysis || !this.selectedDoctorId) return;
        this.isSharing = true;
        
        const fd = new FormData();
        fd.append('doctorId', this.selectedDoctorId);
        fd.append('analysisId', currentAnalysis.id || currentAnalysis.Id);

        try {
            const res = await fetch('/Dashboard/ShareAnalysis', { method: 'POST', body: fd });
            const data = await res.json();
            if (data.success) {
                this.isSharing = false;
                this.sharedSuccess = true;
            } else {
                await PremiumModal.error('Transmission failure: Could not share analysis with the selected specialist.', 'Protocol Error');
                this.isSharing = false;
            }
        } catch (err) {
            console.error(err);
            this.isSharing = false;
        }
    }
}">
    <!-- Main Analysis Area -->
    <div class="col-span-12 lg:col-span-8">
        <div id="dropZone" class="bg-gradient-to-br from-[#0f172a] via-[#1e293b] to-[#0f172a] rounded-3xl p-8 relative overflow-hidden text-white shadow-2xl min-h-[500px] flex flex-col items-center justify-center border border-white/5 transition-all duration-500">
            <!-- Background effects -->
            <div class="absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-[0.1] mix-blend-overlay"></div>
            <div class="absolute top-[-10%] right-[-10%] w-[60%] h-[60%] bg-indigo-600 rounded-full blur-[100px] opacity-20 animate-pulse-slow"></div>
            <div class="absolute bottom-[-10%] left-[-10%] w-[60%] h-[60%] bg-blue-600 rounded-full blur-[100px] opacity-20 animate-pulse-slow"></div>
            
            <div id="uploadContent" class="relative z-10 text-center max-w-md mx-auto transform transition-all duration-500 scale-100">
                <div class="mb-8 relative inline-block">
                    <div class="absolute inset-0 bg-blue-500 blur-2xl opacity-30 animate-pulse"></div>
                    <div class="w-24 h-24 bg-white/5 backdrop-blur-2xl rounded-2xl flex items-center justify-center border border-white/10 relative group shadow-xl">
                        <i data-lucide="microscope" class="w-12 h-12 text-blue-400 group-hover:scale-110 transition-transform duration-500"></i>
                    </div>
                </div>
                
                <h2 class="text-3xl font-semibold mb-4 tracking-tight text-white">AI Medical Intelligence</h2>
                <p class="text-blue-200/60 mb-8 font-medium text-base leading-relaxed">Instantly analyze X-rays, MRIs, and lab reports with clinical-grade accuracy powered by Gemini 1.5 Pro.</p>
                
                <div onclick="document.getElementById('fileInput').click()" class="w-full bg-white/5 border-2 border-dashed border-white/10 rounded-2xl p-8 hover:bg-white/10 hover:border-blue-400/40 transition-all cursor-pointer group shadow-inner">
                    <input type="file" id="fileInput" class="hidden" accept=".jpg,.jpeg,.png,.pdf,.dicom">
                    <div class="w-12 h-12 bg-blue-500/10 rounded-xl flex items-center justify-center mx-auto mb-4 group-hover:bg-blue-500 group-hover:text-white transition-all duration-500">
                        <i data-lucide="cloud-upload" class="w-6 h-6 text-blue-400 group-hover:text-white transition-all"></i>
                    </div>
                    <p class="font-bold text-base text-white">Drop medical files here</p>
                    <p class="text-[11px] text-blue-300/50 mt-2 font-medium">Supports DICOM, High-Res JPG, PDF Reports</p>
                </div>
            </div>

            <!-- Processing State -->
            <div id="processingState" class="hidden relative z-10 text-center max-w-sm mx-auto">
                <div class="relative w-32 h-32 mx-auto mb-8">
                    <div class="absolute inset-0 border-[4px] border-blue-500/10 border-t-blue-500 rounded-full animate-spin"></div>
                    <div class="absolute inset-4 bg-white/5 backdrop-blur-2xl rounded-full flex items-center justify-center">
                        <i data-lucide="scan" class="w-10 h-10 text-blue-400 animate-pulse"></i>
                    </div>
                    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-transparent via-blue-400 to-transparent animate-scan"></div>
                </div>
                <h3 class="text-2xl font-semibold mb-2">AI Processing...</h3>
                <p class="text-blue-200/50 text-sm font-medium">Analyzing diagnostic markers.</p>
            </div>

            <!-- Result State -->
            <div id="resultState" class="hidden relative z-10 w-full max-w-3xl bg-white/5 backdrop-blur-2xl p-8 rounded-3xl border border-white/10 shadow-2xl">
                <div class="flex items-center justify-between mb-8">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 bg-blue-600 text-white rounded-xl flex items-center justify-center shadow-lg shadow-blue-500/20">
                            <i data-lucide="zap" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <h3 class="text-xl font-semibold text-white">Diagnostic Insights</h3>
                            <p class="text-blue-300/50 text-[10px] font-bold uppercase tracking-widest mt-0.5">MedLink AI Core v2.4</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2 px-3 py-1 bg-emerald-500/10 text-emerald-400 text-[10px] font-semibold rounded-full border border-emerald-500/20 uppercase tracking-widest">
                        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
                        99.8% Confident
                    </div>
                </div>

                <div id="resultBody" class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
                    <!-- Dynamic Content -->
                </div>

                <div class="flex items-center gap-3 pt-6 border-t border-white/5">
                    <button onclick="downloadReport()" class="flex-1 py-3.5 bg-white text-gray-900 font-semibold rounded-xl hover:bg-blue-50 transition-all flex items-center justify-center gap-2 shadow-lg hover:scale-[1.02] active:scale-95 text-xs uppercase tracking-widest">
                        <i data-lucide="download" class="w-4 h-4"></i> Download
                    </button>
                    <button x-on:click="showShareModal = true; sharedSuccess = false" class="flex-1 py-3.5 bg-indigo-600 text-white font-semibold rounded-xl hover:bg-indigo-700 transition-all border border-indigo-400/30 flex items-center justify-center gap-2 shadow-lg hover:scale-[1.02] active:scale-95 text-xs uppercase tracking-widest">
                        <i data-lucide="share-2" class="w-4 h-4"></i> Share
                    </button>
                    <button onclick="resetLab()" class="w-12 h-12 bg-white/10 text-white rounded-xl hover:bg-white/20 transition-all flex items-center justify-center border border-white/10 shadow-lg group">
                        <i data-lucide="rotate-ccw" class="w-4 h-4 group-hover:rotate-180 transition-transform duration-500"></i>
                    </button>
                </div>
            </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-5">
             <div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-sm group relative overflow-hidden">
                 <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center mb-3 group-hover:bg-emerald-600 group-hover:text-white transition-all duration-500">
                     <i data-lucide="activity" class="w-5 h-5"></i>
                 </div>
                 <h4 class="font-semibold text-gray-900 text-xs uppercase tracking-widest">Vital Scan</h4>
                 <p class="text-[10px] text-gray-500 mt-1.5 font-medium">Real-time cardiovascular analysis.</p>
             </div>
             <div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-sm group relative overflow-hidden">
                 <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center mb-3 group-hover:bg-blue-600 group-hover:text-white transition-all duration-500">
                     <i data-lucide="file-scan" class="w-5 h-5"></i>
                 </div>
                 <h4 class="font-semibold text-gray-900 text-xs uppercase tracking-widest">Smart OCR</h4>
                 <p class="text-[10px] text-gray-500 mt-1.5 font-medium">Handwritten report parsing.</p>
             </div>
             <div class="bg-white p-5 rounded-3xl border border-gray-100 shadow-sm group relative overflow-hidden">
                 <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center mb-3 group-hover:bg-purple-600 group-hover:text-white transition-all duration-500">
                     <i data-lucide="dna" class="w-5 h-5"></i>
                 </div>
                 <h4 class="font-semibold text-gray-900 text-xs uppercase tracking-widest">Genome AI</h4>
                 <p class="text-[10px] text-gray-500 mt-1.5 font-medium">Hereditary marker detection.</p>
             </div>
        </div>
    </div>
    
    <!-- Sidebar -->
    <div class="col-span-12 lg:col-span-4 space-y-5">
        <div class="bg-white rounded-[2rem] p-6 border border-gray-50 shadow-sm min-h-[440px] relative overflow-hidden">
            <h3 class="font-semibold text-gray-900 mb-6 flex items-center gap-2 uppercase tracking-widest text-[10px]">
                <div class="w-1 h-3 bg-blue-600 rounded-full"></div>
                Analysis History
            </h3>
            
            <div id="historyList" class="space-y-3">
                @if (Model.AIAnalyses != null && Model.AIAnalyses.Any())
                {
                    @foreach (var analysis in Model.AIAnalyses)
                    {
                        <div class="flex gap-3 items-center p-3.5 bg-gray-50/50 rounded-2xl border border-transparent hover:border-blue-100 hover:bg-white transition-all cursor-pointer group" onclick="showAnalysisDetailsById(@analysis.Id)">
                            <div class="w-10 h-10 rounded-xl bg-white border border-gray-100 flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                                <i data-lucide="@(analysis.FileType == "Imaging" ? "image" : "file-text")" class="w-5 h-5 text-blue-500"></i>
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex justify-between items-center mb-0.5">
                                    <h4 class="font-bold text-gray-900 text-xs truncate pr-1">@analysis.FileName</h4>
                                    <span class="text-[8px] @(analysis.Status == "Normal" ? "text-green-600 bg-green-50 px-1.5 py-0.5 rounded border border-green-100" : analysis.Status == "Critical" ? "text-rose-600 bg-rose-50 px-1.5 py-0.5 rounded border border-rose-100" : "text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-100") font-semibold uppercase tracking-widest whitespace-nowrap">@analysis.Status</span>
                                </div>
                                <div class="text-[9px] text-gray-400 font-bold uppercase tracking-wider">@analysis.CreatedAt.ToString("MMM dd, hh:mm tt")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-12">
                        <i data-lucide="search" class="w-8 h-8 text-gray-200 mx-auto mb-3"></i>
                        <p class="text-[10px] text-gray-400 font-semibold uppercase tracking-widest">Empty History</p>
                    </div>
                }
            </div>
            
            <button class="w-full mt-6 py-3.5 text-[9px] font-semibold uppercase tracking-widest text-blue-600 hover:bg-blue-50 rounded-xl transition-all border border-blue-50">
                View All Labs
            </button>
        </div>
        
        <div class="bg-[#0f172a] rounded-[2rem] p-6 text-white shadow-xl relative overflow-hidden group">
            <div class="absolute inset-0 bg-blue-600 opacity-0 group-hover:opacity-5 transition-opacity duration-700"></div>
            <h3 class="font-semibold text-[10px] uppercase tracking-widest mb-3 text-blue-400">Clinical AI Hub</h3>
            <p class="text-xs font-medium text-blue-100/60 leading-relaxed">
                HIPAA compliant Neural-Core parsing 640T diagnostic datasets daily. AES-256 encrypted.
            </p>
        </div>
    </div>

    <!-- Share Selection Modal -->
    <div x-show="showShareModal" x-cloak class="fixed inset-0 z-[100] flex items-center justify-center p-6 bg-[#0f172a]/80 backdrop-blur-md animate-in fade-in duration-300">
        <div x-on:click.outside="showShareModal = false" class="bg-white rounded-[2.5rem] p-8 max-w-xl w-full shadow-2xl relative overflow-hidden transform transition-all scale-100">
            <div class="absolute top-0 left-0 w-full h-2.5 bg-indigo-600"></div>
            
            <button x-on:click="showShareModal = false" class="absolute top-6 right-6 w-10 h-10 rounded-xl bg-gray-50 flex items-center justify-center text-gray-400 hover:bg-gray-100 transition-all shadow-sm">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>

            <div class="mb-8 pr-12">
                <h3 class="text-2xl font-semibold text-gray-900 mb-1">Share Report</h3>
                <p class="text-xs text-gray-500 font-medium">Pick a specialist to provide these findings to.</p>
            </div>

            <div class="space-y-2.5 max-h-[320px] overflow-y-auto px-1 custom-scrollbar-gray mb-8">
                @foreach(var doc in Model.AvailableDoctors) {
                    <div 
                        x-on:click="selectedDoctorId = @doc.Id"
                        x-bind:class="selectedDoctorId === @doc.Id ? 'border-indigo-600 bg-indigo-50/50 ring-4 ring-indigo-500/10' : 'border-gray-100 bg-gray-50/50 hover:bg-white hover:border-indigo-100'"
                        class="p-4 rounded-2xl border-2 transition-all cursor-pointer group flex items-center gap-4">
                        <div class="relative">
                            <img src="@doc.Image" class="w-11 h-11 rounded-xl object-cover border-2 border-white shadow-sm">
                            @if(doc.Online) {
                                <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 rounded-full border-2 border-white"></div>
                            }
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="font-semibold text-gray-900 text-sm truncate">@doc.Name</h4>
                            <p class="text-[9px] text-indigo-600 font-semibold uppercase tracking-widest mt-0.5">@doc.Specialty</p>
                        </div>
                        <i data-lucide="check-circle-2" class="w-5 h-5 text-indigo-600 opacity-0 transition-opacity" x-bind:class="selectedDoctorId === @doc.Id ? 'opacity-100' : ''"></i>
                    </div>
                }
            </div>

            <div class="flex gap-4" x-show="!sharedSuccess">
                <button x-on:click="showShareModal = false" class="flex-1 py-4 rounded-xl text-[10px] font-semibold uppercase tracking-widest text-gray-400 hover:bg-gray-50 transition-all">Cancel</button>
                <button 
                    x-on:click="shareWithSelectedDoctor()" 
                    x-bind:disabled="!selectedDoctorId || isSharing"
                    x-bind:class="!selectedDoctorId ? 'opacity-50 cursor-not-allowed bg-gray-300' : 'bg-indigo-600 hover:bg-indigo-700 shadow-lg shadow-indigo-200'"
                    class="flex-[2] py-4 text-white rounded-2xl font-semibold text-xs uppercase tracking-widest transition-all flex items-center justify-center gap-2">
                    <i data-lucide="send" class="w-4 h-4" x-show="!isSharing"></i>
                    <i data-lucide="loader-2" class="w-4 h-4 animate-spin" x-show="isSharing"></i>
                    <span x-text="isSharing ? 'Sharing...' : 'Confirm Share'"></span>
                </button>
            </div>

            <!-- Success State -->
            <div x-show="sharedSuccess" class="text-center py-4 animate-in zoom-in duration-300">
                <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4">
                    <i data-lucide="check" class="w-8 h-8"></i>
                </div>
                <h4 class="text-lg font-semibold text-gray-900">Successfully Shared!</h4>
                <p class="text-xs text-gray-500 mt-1 mb-6">The specialist has been notified of your findings.</p>
                <div class="flex gap-3">
                    <button x-on:click="window.location.href='/Dashboard/Messages?doctorId=' + selectedDoctorId" class="flex-1 py-3.5 bg-gray-900 text-white rounded-xl font-semibold text-[10px] uppercase tracking-widest shadow-lg">Jump to Chat</button>
                    <button x-on:click="sharedSuccess=false; showShareModal=false" class="flex-1 py-3.5 bg-gray-100 text-gray-600 rounded-xl font-semibold text-[10px] uppercase tracking-widest">Back to Lab</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const uploadContent = document.getElementById('uploadContent');
        const processingState = document.getElementById('processingState');
        const resultState = document.getElementById('resultState');
        const resultBody = document.getElementById('resultBody');

        // Drag & Drop
        if (dropZone) {
            ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, e => {
                    e.preventDefault();
                    e.stopPropagation();
                }, false);
            });

            ['dragenter', 'dragover'].forEach(eventName => {
                dropZone.addEventListener(eventName, () => dropZone.classList.add('bg-blue-900/20', 'border-blue-500/30'), false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZone.addEventListener(eventName, () => dropZone.classList.remove('bg-blue-900/20', 'border-blue-500/30'), false);
            });

            dropZone.addEventListener('drop', e => {
                const files = e.dataTransfer.files;
                if (files.length) handleUpload(files[0]);
            });
        }

        fileInput.addEventListener('change', e => {
            if (e.target.files.length) handleUpload(e.target.files[0]);
        });

        let currentAnalysis = null;
        let allAnalyses = @Html.Raw(Json.Serialize(Model.AIAnalyses));

        async function handleUpload(file) {
            uploadContent.classList.add('hidden');
            resultState.classList.add('hidden');
            processingState.classList.remove('hidden');

            const formData = new FormData();
            formData.append('file', file);

            try {
                const response = await fetch('/Dashboard/AnalyzeFile', { method: 'POST', body: formData });
                const data = await response.json();
                if (data.success) {
                    currentAnalysis = data.analysis;
                    showResult(data.analysis);
                    // Ultra-fast history update without reload
                    prependToHistory(data.analysis);
                } else {
                    await PremiumModal.error('Diagnostic analysis failed: ' + data.message, 'Core Rejection');
                    resetLab();
                }
            } catch (err) {
                console.error(err);
                resetLab();
            }
        }

        function showResult(analysis) {
            processingState.classList.add('hidden');
            uploadContent.classList.add('hidden');
            resultState.classList.remove('hidden');
            
            const content = analysis.analysisResult || analysis.AnalysisResult || "";
            let summary = content;
            let nextSteps = "Consult with your specialist about these findings.";

            if (content.toLowerCase().includes("risk assessment:")) {
                const parts = content.split(/Risk Assessment:|Next Steps:/i);
                summary = parts[0];
                nextSteps = parts[2] || nextSteps;
            }

            const status = (analysis.status || analysis.Status).toLowerCase();
            const color = status === 'normal' ? 'emerald' : status === 'critical' ? 'rose' : 'amber';
            const icon = status === 'normal' ? 'shield-check' : status === 'critical' ? 'alert-triangle' : 'info';

            resultBody.innerHTML = `
                <div class="col-span-2 bg-white/5 border border-white/10 rounded-2xl p-5">
                    <h4 class="text-[9px] font-semibold text-blue-400 uppercase tracking-widest mb-3 flex items-center gap-2">
                        <i data-lucide="file-text" class="w-3 h-3"></i> Summary
                    </h4>
                    <p class="text-blue-50/80 text-xs leading-relaxed font-medium">${summary.replace(/\n/g, '<br>')}</p>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
                    <h4 class="text-[9px] font-semibold text-blue-400 uppercase tracking-widest mb-3">Clinical Risk</h4>
                    <div class="flex items-center gap-3">
                        <div class="w-11 h-11 rounded-lg bg-${color}-500/10 flex items-center justify-center border border-${color}-500/20">
                            <i data-lucide="${icon}" class="w-5 h-5 text-${color}-400"></i>
                        </div>
                        <p class="text-xl font-semibold text-white">${analysis.status || analysis.Status}</p>
                    </div>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
                    <h4 class="text-[9px] font-semibold text-blue-400 uppercase tracking-widest mb-3">AI Suggestion</h4>
                    <p class="text-blue-50/60 text-[10px] font-medium leading-relaxed">${nextSteps}</p>
                </div>
            `;
            lucide.createIcons();
        }

        function prependToHistory(a) {
            const list = document.getElementById('historyList');
            if (list.querySelector('.text-center')) list.innerHTML = ''; // Clear empty state
            
            const status = (a.status || a.Status);
            const statusClass = status === "Normal" ? "text-green-600 bg-green-50" : status === "Critical" ? "text-rose-600 bg-rose-50" : "text-amber-600 bg-amber-50";
            
            const item = document.createElement('div');
            item.className = "flex gap-3 items-center p-3.5 bg-gray-50/50 rounded-2xl border border-transparent hover:border-blue-100 hover:bg-white transition-all cursor-pointer group animate-in slide-in-from-left duration-500";
            item.onclick = () => showAnalysisDetailsById(a.id || a.Id);
            item.innerHTML = `
                <div class="w-10 h-10 rounded-xl bg-white border border-gray-100 flex items-center justify-center shrink-0 shadow-sm group-hover:scale-105 transition-transform">
                    <i data-lucide="${a.fileType === "Imaging" ? "image" : "file-text"}" class="w-5 h-5 text-blue-500"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <div class="flex justify-between items-center mb-0.5">
                        <h4 class="font-bold text-gray-900 text-xs truncate pr-1">${a.fileName || a.FileName}</h4>
                        <span class="text-[8px] ${statusClass} px-1.5 py-0.5 rounded border font-semibold uppercase tracking-widest whitespace-nowrap">${status}</span>
                    </div>
                    <div class="text-[9px] text-gray-400 font-bold uppercase tracking-wider">Just Now</div>
                </div>
            `;
            list.insertBefore(item, list.firstChild);
            allAnalyses.unshift(a);
            lucide.createIcons();
        }



        function showAnalysisDetailsById(id) {
            const analysis = allAnalyses.find(a => (a.id || a.Id) == id);
            if (analysis) {
                currentAnalysis = analysis;
                showResult(analysis);
                document.getElementById('dropZone').scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        function resetLab() {
            currentAnalysis = null;
            resultState.classList.add('hidden');
            processingState.classList.add('hidden');
            uploadContent.classList.remove('hidden');
            fileInput.value = '';
        }

        function downloadReport() {
            if (!currentAnalysis) return;
            const content = `MEDLINK DIAGNOSTIC REPORT\n${currentAnalysis.fileName}\n${new Date(currentAnalysis.createdAt).toLocaleString()}\nStatus: ${currentAnalysis.status}\n\n${currentAnalysis.analysisResult}`;
            const blob = new Blob([content], { type: 'text/plain' });
            const url = window.URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `Report_${currentAnalysis.fileName}.txt`;
            a.click();
        }
    </script>
    <style>
        [x-cloak] { display: none !important; }
        .animate-pulse-slow { animation: pulse-slow 6s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
        @@keyframes pulse-slow { 0%, 100% { opacity: 0.15; transform: scale(1); } 50% { opacity: 0.25; transform: scale(1.05); } }
        .animate-scan { animation: scan 2.5s linear infinite; }
        @@keyframes scan { 0% { transform: translateY(0); opacity: 0; } 50% { opacity: 1; } 100% { transform: translateY(120px); opacity: 0; } }
        .custom-scrollbar-gray::-webkit-scrollbar { width: 5px; }
        .custom-scrollbar-gray::-webkit-scrollbar-track { background: #F9FAFB; }
        .custom-scrollbar-gray::-webkit-scrollbar-thumb { background: #E5E7EB; border-radius: 10px; }
    </style>
}
