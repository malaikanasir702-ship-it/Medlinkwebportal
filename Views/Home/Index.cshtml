@model dynamic
@{
    ViewData["Title"] = "MedLink | Revolutionizing Global Healthcare";
}

<!-- Navigation -->
<nav class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-gray-100 py-3 shadow-sm">
    <div class="max-w-7xl mx-auto px-6 flex items-center justify-between">
        <div class="flex items-center gap-2 group cursor-pointer">
            <div class="w-9 h-9 rounded-lg overflow-hidden shadow-lg shadow-blue-500/20 transition-transform group-hover:scale-110 flex-shrink-0">
                <img src="/images/medlink-logo.png" alt="MedLink Logo" class="w-full h-full object-cover">
            </div>
            <span class="text-xl font-bold tracking-tight text-gray-900">MedLink</span>
        </div>

        <div class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600">
            <a href="#features" class="hover:text-blue-600 transition-colors">Features</a>
            <a href="#how-it-works" class="hover:text-blue-600 transition-colors">How it Works</a>
            <a href="#security" class="hover:text-blue-600 transition-colors">Security</a>
            <a href="#impact" class="hover:text-blue-600 transition-colors">Vision</a>
        </div>

        <div class="hidden md:flex items-center gap-4">
            <a asp-area="Identity" asp-page="/Account/Login" class="text-sm font-medium text-gray-600 hover:text-gray-900 px-4 py-2 inline-block">
                Log in
            </a>

             <a asp-area="Identity" asp-page="/Account/Register"
                    class="bg-blue-600 text-white text-sm font-semibold px-6 py-2.5 rounded-full hover:bg-blue-700 transition-all shadow-md hover:shadow-lg active:scale-95">
                Get Started
            </a>
        </div>

        <button class="md:hidden p-2 text-gray-600" onclick="toggleMobileMenu()">
            <i data-lucide="menu" id="menuIcon"></i>
        </button>
    </div>

    <!-- Mobile Menu -->
    <div id="mobileMenu" class="md:hidden bg-white border-b border-gray-100 absolute w-full px-6 py-6 flex-col gap-4 hidden">
        <a href="#features" class="text-lg font-medium">Features</a>
        <a href="#how-it-works" class="text-lg font-medium">How it Works</a>
        <a href="#security" class="text-lg font-medium">Security</a>
        <button onclick="toggleModal('bookingModal')" class="bg-blue-600 text-white py-3 rounded-xl font-semibold">Get Started</button>
    </div>
</nav>

<!-- Hero Section -->
<section class="relative pt-20 pb-12 md:pt-32 md:pb-20 px-4 overflow-hidden min-h-[70vh] flex items-center">
    <div class="max-w-6xl mx-auto w-full">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-6 items-center">
            <!-- Left Column: Content -->
            <div class="flex flex-col items-start text-left z-10">
                <div class="inline-flex items-center gap-2 bg-blue-50 border border-blue-100 rounded-full px-3 py-1 mb-6 fade-down" data-animate>
                    <span class="flex h-1.5 w-1.5 rounded-full bg-blue-600 animate-pulse"></span>
                    <span class="text-xs font-semibold text-blue-700 uppercase tracking-wider">The Future of Global Health</span>
                </div>

                <h1 class="text-4xl md:text-5xl xl:text-6xl font-bold text-gray-900 leading-tight mb-6 tracking-tight fade-up" data-animate>
                    Precision <br />
                    Healthcare, <br />
                    <span class="gradient-text">Without Borders.</span>
                </h1>

                <p class="text-base md:text-lg text-gray-600 max-w-lg mb-8 leading-relaxed fade-up delay-200" data-animate>
                    MedLink integrates cutting-edge AI diagnostics with a global network of specialists,
                    providing a seamless, secure, and immediate consultation experience for everyone.
                </p>

                <div class="flex flex-col sm:flex-row gap-4 mb-12 fade-up delay-300" data-animate>
                    <a asp-area="Identity" asp-page="/Account/Login"
                            class="group relative flex items-center justify-center gap-2 bg-blue-600 text-white text-base font-bold px-8 py-4 rounded-full hover:bg-blue-700 transition-all shadow-lg hover:shadow-blue-200 active:scale-95 overflow-hidden">
                        <span class="relative z-10 flex items-center gap-2">
                            Book a Consultation
                            <i data-lucide="arrow-up-right" class="w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"></i>
                        </span>
                        <div class="absolute inset-0 bg-gradient-to-r from-blue-400/0 via-white/10 to-blue-400/0 translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-700"></div>
                    </a>
                    <button onclick="document.getElementById('how-it-works').scrollIntoView({behavior: 'smooth', block: 'start'})" class="group flex items-center justify-center gap-2 bg-white border border-gray-200 text-gray-800 text-base font-bold px-8 py-4 rounded-full hover:bg-gray-50 transition-all shadow-sm active:scale-95">
                        <i data-lucide="play" class="fill-blue-600 text-blue-600 transition-transform group-hover:scale-125 w-4 h-4"></i>
                        See How It Works
                    </button>
                </div>

                <div class="flex items-center gap-6 fade-up delay-500" data-animate>
                    <div class="flex -space-x-3">
                        @for (int i = 1; i <= 4; i++)
                        {
                            <div class="relative group cursor-pointer hover-scale">
                                <img src="https://picsum.photos/seed/doctor-@i/80/80"
                                     class="w-10 h-10 rounded-full border-3 border-white shadow-sm ring-1 ring-gray-100 transition-transform group-hover:scale-110 group-hover:-translate-y-1"
                                     alt="Doctor">
                                <div class="absolute -top-10 left-1/2 -translate-x-1/2 bg-gray-900 text-white text-[9px] py-1 px-2 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                                    Dr. Specialist @i
                                </div>
                            </div>
                        }
                        <a asp-area="Identity" asp-page="/Account/Login"
                             class="w-10 h-10 rounded-full border-3 border-white bg-blue-50 flex items-center justify-center text-blue-600 shadow-sm ring-1 ring-gray-100 hover:bg-blue-600 hover:text-white cursor-pointer transition-colors hover-scale">
                            <i data-lucide="plus" class="w-4 h-4"></i>
                        </a>
                    </div>
                    <div>
                        <div class="flex items-center gap-1 text-yellow-500 mb-0.5">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i data-lucide="star" class="w-3 h-3 fill-current"></i>
                            }
                        </div>
                        <p class="text-xs font-bold text-gray-900">4.9/5 from 2,500+ Patients</p>
                    </div>
                </div>
            </div>

            <!-- Right Column: Visual Composition -->
            <div class="relative h-[350px] md:h-[400px] xl:h-[450px] flex items-center justify-center zoom-in duration-1000" data-animate
                 onmouseenter="this.classList.add('hovered')" onmouseleave="this.classList.remove('hovered')">
                <!-- Main Image Base - SMALLER SIZE -->
                <div class="relative w-full max-w-xs xl:max-w-sm aspect-[4/5] bg-white rounded-[2rem] shadow-lg overflow-hidden border border-gray-100 transition-all duration-700 ease-out rotate-3 scale-100 hover:rotate-0 hover:scale-105 hover:shadow-blue-500/10">
                    <img src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&q=80&w=600"
                         alt="Modern Healthcare"
                         class="w-full h-full object-cover grayscale-[10%] transition-all duration-700 hover:grayscale-0">
                    <div class="absolute inset-0 bg-gradient-to-t from-blue-900/60 to-transparent"></div>

                    <!-- Bottom Label - ADJUSTED FOR SMALLER SIZE -->
                    <div class="absolute bottom-4 left-4">
                        <div class="bg-white/10 backdrop-blur-md border border-white/20 p-2 rounded-lg text-white">
                            <div class="flex items-center gap-1 mb-0.5">
                                <i data-lucide="heart-pulse" class="w-2.5 h-2.5 text-blue-400"></i>
                                <span class="text-[10px] font-bold uppercase tracking-wider">Real-time Care</span>
                            </div>
                            <p class="text-[10px] font-medium">Virtual diagnostic room activated</p>
                        </div>
                    </div>
                </div>

                <!-- Floating Glass Card 1 (Top Left) - ADJUSTED FOR SMALLER IMAGE -->
                <a asp-area="Identity" asp-page="/Account/Login"
                     class="absolute top-6 -left-3 md:-left-6 lg:-left-10 xl:-left-12 bg-white/90 backdrop-blur-xl p-4 rounded-xl shadow-lg border border-white/50 w-48 transform -rotate-6 animate-float cursor-pointer hover:bg-white transition-colors">
                    <div class="flex items-center gap-2 mb-2">
                        <img src="https://scontent.fkhi6-2.fna.fbcdn.net/v/t1.15752-9/617194772_894514363521845_3038485655411687524_n.png?stp=dst-png_p480x480&_nc_cat=109&ccb=1-7&_nc_sid=0024fc&_nc_ohc=5eOsMTm8vmIQ7kNvwHFY5yD&_nc_oc=AdlR0QwqI-GSOT3HkYuh52MBUtUtitt2bexW1vET2AojcILOnk36tVj1JPyGUfwlJHM&_nc_ad=z-m&_nc_cid=0&_nc_zt=23&_nc_ht=scontent.fkhi6-2.fna&oh=03_Q7cD4QFjnpF6zeUTVdwHP5Sf9hoW8O4PdJL-8a_hYKXJ19Qzww&oe=6997B00F"
                             class="w-10 h-10 rounded-lg object-cover" alt="Dr. Jenkins">
                        <div>
                            <h4 class="font-bold text-gray-900 text-xs leading-none mb-0.5">Dr.Waleed</h4>
                            <p class="text-[10px] text-blue-600 font-bold uppercase tracking-tight">Cardiologist</p>
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <div class="h-1 w-full bg-gray-100 rounded-full overflow-hidden">
                            <div class="h-full bg-blue-600 w-3/4 animate-shimmer"></div>
                        </div>
                        <div class="flex justify-between text-[8px] font-bold text-gray-400">
                            <span>LIVE CONNECTIVITY</span>
                            <span class="text-blue-600">ACTIVE</span>
                        </div>
                    </div>
                </a>

                <!-- Floating Element 2: Stats Card (Bottom Right) - ADJUSTED -->
                <div class="absolute bottom-6 -right-3 md:-right-6 lg:-right-10 xl:-right-12 bg-white/90 backdrop-blur-xl p-4 rounded-xl shadow-lg border border-white/50 w-56 transform rotate-6 animate-float-delayed cursor-pointer hover:bg-white transition-colors group/stats">
                    <div class="flex items-center justify-between mb-3">
                        <div class="bg-green-100 p-1.5 rounded-lg text-green-600 transition-transform group-hover/stats:scale-110">
                            <i data-lucide="activity" class="w-4 h-4"></i>
                        </div>
                        <div class="text-right">
                            <div class="text-[9px] font-bold text-gray-400 uppercase">Live Vitals</div>
                            <div class="text-lg font-black text-gray-900 flex items-center gap-1">72 <span class="text-[10px] text-gray-400 font-normal">BPM</span></div>
                        </div>
                    </div>
                    <svg class="w-full h-8 text-blue-500 overflow-visible" viewBox="0 0 100 20">
                        <path d="M0,10 L10,10 L15,0 L25,20 L30,10 L40,10 L45,2 L55,18 L60,10 L70,10 L75,5 L85,15 L90,10 L100,10"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2"
                              class="animate-draw"></path>
                    </svg>
                </div>

                <!-- Floating Element 3: Security Badge (Middle Right) - ADJUSTED -->
                <div class="absolute top-1/2 -right-4 transform -translate-y-1/2 bg-blue-600 text-white p-3 rounded-full shadow-md animate-bounce-slow cursor-help hover:scale-110 transition-transform">
                    <i data-lucide="shield-check" class="w-5 h-5"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @@keyframes draw {
        to {
            stroke-dashoffset: 0;
        }
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0) rotate(-6deg);
        }

        50% {
            transform: translateY(-8px) rotate(-6deg);
        }
    }

    @@keyframes float-delayed {
        0%, 100% {
            transform: translateY(0) rotate(6deg);
        }

        50% {
            transform: translateY(-6px) rotate(6deg);
        }
    }

    .animate-draw {
        stroke-dasharray: 200;
        stroke-dashoffset: 200;
        animation: draw 2s ease-out infinite;
    }

    .animate-float {
        animation: float 3s ease-in-out infinite;
    }

    .animate-float-delayed {
        animation: float-delayed 3.5s ease-in-out infinite 0.5s;
    }

    .animate-shimmer {
        animation: shimmer 2s infinite linear;
        background: linear-gradient(90deg, #3b82f6 0%, #60a5fa 50%, #3b82f6 100%);
        background-size: 200px 100%;
    }

    @@keyframes shimmer {
        0% {
            background-position: -200px 0;
        }

        100% {
            background-position: calc(200px + 100%) 0;
        }
    }
</style>

<!-- Partners Section -->
<section class="py-12 bg-white/50 backdrop-blur-sm border-y border-gray-100 fade-up delay-500" data-animate>
    <div class="max-w-7xl mx-auto px-6">
        <p class="text-center text-[10px] font-black text-gray-400 uppercase tracking-[0.3em] mb-10">
            Trusted by over 500+ Leading Health Organizations
        </p>
        <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-40 grayscale transition-all">
            @foreach (var brand in new[] { "HealthCore", "GlobalClinic", "BioGuard", "LifeSystems", "NeuroLink", "PulseNetwork" })
            {
                <div class="group cursor-pointer hover:grayscale-0 hover:opacity-100 transition-all duration-500">
                    <span class="text-xl md:text-2xl font-black italic tracking-tighter text-gray-600 group-hover:text-blue-600">
                        @brand
                    </span>
                </div>
            }
        </div>
    </div>
</section>

<!-- Problem Section -->
