                           class="flex items-center gap-4 w-full px-5 py-3 rounded-2xl transition-all @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Settings" ? "bg-blue-600 text-white shadow-xl shadow-blue-900/40" : "text-slate-400 hover:text-white hover:bg-white/5")">
                            <i class="fas fa-cog text-sm"></i>
                            <span class="text-sm font-semibold">Settings</span>
                        </a>
                        <a href="/Admin/Sitemap" 
                           class="flex items-center gap-4 w-full px-5 py-3 rounded-2xl transition-all @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["Action"]?.ToString() == "Sitemap" ? "bg-blue-600 text-white shadow-xl shadow-blue-900/40" : "text-slate-400 hover:text-white hover:bg-white/5")">
                            <i class="fas fa-sitemap text-sm"></i>
                            <span class="text-sm font-semibold">Sitemap</span>
                        </a>
                    </div>
                </div>
                <div class="p-8 relative z-10 mt-auto">
                    <a href="@Url.Action("Logout", "Account")" class="flex items-center gap-3 w-full px-5 py-4 text-slate-500 hover:text-red-400 hover:bg-red-400/5 rounded-2xl transition-all group">
                        <i class="fas fa-sign-out-alt w-5 h-5 group-hover:-translate-x-1 transition-transform"></i>
                        <span class="text-sm font-bold">Sign Out</span>
                    </a>
                </div>
            </div>
        </aside>
        <div class="flex-1 flex flex-col min-w-0">
            <header id="mainHeader" class="h-16 lg:h-20 flex items-center justify-between px-6 lg:px-14 sticky top-0 z-40 transition-all duration-500">
                <div class="flex items-center gap-4 lg:gap-8 max-w-[60%] lg:max-w-none">
                    <button id="sidebarToggle" class="p-2.5 bg-white border border-slate-200 rounded-xl text-slate-500 shadow-sm hover:text-blue-600 lg:hidden">
                        <i class="fas fa-bars text-base"></i>
                    </button>
                </div>
                <div class="flex items-center gap-3 lg:gap-8 header-actions animate-in fade-in slide-in-from-right-8 duration-1000">
                    <!-- Notification Bell -->
                    <div class="relative dropdown">
                        <button id="notificationToggle" class="w-9 h-9 bg-white border border-slate-200 rounded-xl flex items-center justify-center text-slate-400 hover:text-blue-600 hover:border-blue-200 hover:shadow-xl hover:shadow-blue-500/10 transition-all relative group">
                            <i class="fas fa-bell text-base group-hover:block transition-all"></i>
                            <span id="unreadDot" class="absolute top-2 right-2 w-2 h-2 bg-red-500 border-2 border-white rounded-full glow-pulse shadow-[0_0_10px_rgba(239,68,68,0.5)]"></span>
                        </button>

                        <div id="notificationDropdown" class="hidden absolute right-0 mt-6 w-[320px] bg-white rounded-[32px] shadow-[0_30px_70px_-15px_rgba(0,0,0,0.2)] border border-slate-100 overflow-hidden transform origin-top-right transition-all z-[100] animate-in slide-in-from-top-4 duration-500">
                            <!-- List View -->
                            <div id="notificationListContainer">
                                <div class="px-6 py-4 flex items-center justify-between border-b border-slate-50">
                                    <div>
                                        <h4 class="text-[10px] font-semibold text-slate-400 uppercase tracking-[0.2em]">Alerts</h4>
                                    </div>
                                    <span class="px-2 py-0.5 bg-blue-50 text-blue-600 text-[8px] font-semibold rounded-lg uppercase tracking-wider" id="notifCount">2 New</span>
                                </div>
                                <div class="max-h-[350px] overflow-y-auto px-3 py-2 custom-scrollbar">
                                    <!-- Consultation -->
                                    <div class="notification-item flex gap-4 p-3.5 rounded-[20px] hover:bg-slate-50 transition-all cursor-pointer group mb-1 unread" 
                                         data-title="Consultation Pending" 
                                         data-msg="Dr. Miller has requested a review for Patient-774 regarding surgical clearance."
                                         data-time="Just Now" data-icon="fa-stethoscope" data-color="bg-blue-600">
                                        <div class="w-10 h-10 bg-blue-600 rounded-[14px] flex items-center justify-center text-white text-base shadow-lg shadow-blue-500/20 group-hover:scale-110 transition-transform">
                                            <i class="fas fa-stethoscope"></i>
                                        </div>
                                        <div class="flex-1">
                                            <div class="flex items-center justify-between mb-0.5">
                                                <p class="text-[12px] font-semibold text-slate-800">Consultation Pending</p>
                                                <div class="w-1.5 h-1.5 bg-blue-600 rounded-full unread-mark shadow-[0_0_8px_rgba(37,99,235,0.4)]"></div>
                                            </div>
                                            <p class="text-[10px] font-medium text-slate-500 mb-1 leading-relaxed line-clamp-1">Dr. Miller has requested a review for P...</p>
                                            <p class="text-[8px] font-semibold text-blue-600 uppercase tracking-widest">Just Now</p>
                                        </div>
                                    </div>

                                    <!-- Critical Status -->
                                    <div class="notification-item flex gap-4 p-3.5 rounded-[20px] hover:bg-slate-50 transition-all cursor-pointer group unread" 
                                         data-title="Critical Status Alert" 
                                         data-msg="Patient ID: P-1024 vital sensors reporting irregular cardiac rhythm. Immediate review advised."
                                         data-time="12 Mins Ago" data-icon="fa-exclamation-triangle" data-color="bg-amber-500">
                                        <div class="w-10 h-10 bg-amber-500 rounded-[14px] flex items-center justify-center text-white text-base shadow-lg shadow-amber-500/20 group-hover:scale-110 transition-transform">
                                            <i class="fas fa-exclamation-triangle"></i>
                                        </div>
                                        <div class="flex-1">
                                            <div class="flex items-center justify-between mb-0.5">
                                                <p class="text-[12px] font-semibold text-slate-800">Critical Status Alert</p>
                                                <div class="w-1.5 h-1.5 bg-blue-600 rounded-full unread-mark shadow-[0_0_8px_rgba(37,99,235,0.4)]"></div>
                                            </div>
                                            <p class="text-[10px] font-medium text-slate-500 mb-1 leading-relaxed line-clamp-1">Patient ID: P-1024 vital sensors report...</p>
                                            <p class="text-[8px] font-semibold text-slate-400 uppercase tracking-widest">12 Mins Ago</p>
                                        </div>
                                    </div>
                                </div>
                                <div class="p-5 border-t border-slate-50 bg-slate-50/50">
                                    <button id="btnClearAllNotifs" class="w-full py-3.5 text-[9px] font-semibold text-blue-600 uppercase tracking-[0.2em] hover:bg-white hover:shadow-lg rounded-xl transition-all">Clear All History</button>
                                </div>
                            </div>

                            <!-- Detail View -->
                            <div id="notificationDetailContainer" class="hidden">
                                <div class="p-6">
                                    <button id="btnBackToNotifications" class="flex items-center gap-2 text-[9px] font-semibold text-slate-400 uppercase tracking-widest hover:text-blue-600 transition-all mb-6">
                                        <i class="fas fa-arrow-left"></i> Back to Alerts
                                    </button>
                                    <div id="notifDetailHeader" class="w-12 h-12 rounded-[18px] flex items-center justify-center text-white text-xl mb-4 shadow-2xl">
                                        <i class="fas"></i>
                                    </div>
                                    <h4 id="notifDetailTitle" class="text-lg font-semibold text-slate-900 mb-2 tracking-tight"></h4>
                                    <p id="notifDetailTime" class="text-[9px] font-semibold text-blue-600 uppercase tracking-widest mb-4"></p>
                                    <p id="notifDetailMsg" class="text-[12px] font-medium text-slate-500 leading-relaxed mb-6"></p>
                                    <button class="w-full py-3.5 bg-[#0F172A] text-white rounded-[18px] text-[10px] font-semibold uppercase tracking-widest hover:bg-black hover:shadow-2xl transition-all shadow-xl active:scale-95">Exec Action: Review Record</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    @await Component.InvokeAsync("AdminProfile")
                </div>
            </header>
            <main class="flex-1 overflow-y-auto px-10 lg:px-14 pb-20 scroll-smooth">
                <div id="app-content" class="max-w-[1600px] mx-auto pt-6">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            const $sidebar = $('#sidebar');
            const $sidebarToggle = $('#sidebarToggle');
            const $sidebarClose = $('#sidebarClose');
            const $header = $('#mainHeader');
            const $sidebarBackdrop = $('#sidebarBackdrop');
            const $body = $('body');
            const $profileToggle = $('#profileToggle');
            const $profileDropdown = $('#profileDropdown');
            const $notificationToggle = $('#notificationToggle');
            const $notificationDropdown = $('#notificationDropdown');
            // Sidebar Toggle
            function toggleSidebar(open) {
                if (open) {
                    $sidebar.removeClass('-translate-x-full');
                    $sidebarBackdrop.removeClass('hidden').addClass('block');
                    $body.addClass('overflow-hidden lg:overflow-auto');
                } else {
                    $sidebar.addClass('-translate-x-full');
                    $sidebarBackdrop.removeClass('block').addClass('hidden');
                    $body.removeClass('overflow-hidden lg:overflow-auto');
                }
            }
            $sidebarToggle.on('click', function(e) {
                e.stopPropagation();
                toggleSidebar(true);
            });
            $sidebarClose.on('click', function(e) {
                e.stopPropagation();
                toggleSidebar(false);
            });
            $sidebarBackdrop.on('click', function() {
                toggleSidebar(false);
            });
            // Handle resize
            $(window).on('resize', function() {
                if ($(window).width() >= 1024) {
                    toggleSidebar(false); 
                }
            });
            // Header scroll effect
            $(window).on('scroll', function() {
                if ($(window).scrollTop() > 20) {
                    $header.addClass('bg-white border-b shadow-sm');
                } else {
                    $header.removeClass('bg-white border-b shadow-sm');
                }
            });
            // Profile Dropdown Toggle
            $profileToggle.on('click', function(e) {
                e.stopPropagation();
                $notificationDropdown.addClass('hidden');
                $profileDropdown.toggleClass('hidden');
            });
            // Notification Dropdown Toggle
            $notificationToggle.on('click', function(e) {
                e.stopPropagation();
                $profileDropdown.addClass('hidden');
                $notificationDropdown.toggleClass('hidden');
                // Reset to list view when opening
                $('#notificationListContainer').removeClass('hidden');
                $('#notificationDetailContainer').addClass('hidden');
            });
            // Notification Item Click
            $('#notificationDropdown').on('click', '.notification-item', function(e) {
                e.stopPropagation();
                const $item = $(this);
                const title = $item.data('title');
                const msg = $item.data('msg');
                const time = $item.data('time');
                const icon = $item.data('icon');
                const color = $item.data('color');
                // Mark as read
                $item.find('.unread-mark').remove();
                // Update Badge & Globe Dot
                const unreadCount = $('.unread-mark').length;
                if (unreadCount > 0) {
                    $('#notifCount').text(`${unreadCount} New`);
                } else {
                    $('#notifCount').text('No New Alerts');
                    $('#unreadDot').fadeOut();
                }
                // Populate Detail View
                $('#notifDetailTitle').text(title);
                $('#notifDetailMsg').text(msg);
                $('#notifDetailTime').text(`Received ${time}`);
                $('#notifDetailHeader').removeClass().addClass(`w-16 h-16 rounded-[24px] flex items-center justify-center text-white text-2xl mb-6 shadow-2xl ${color}`);
                $('#notifDetailHeader i').removeClass().addClass(`fas ${icon}`);
                // Switch Views
                $('#notificationListContainer').addClass('hidden');
                $('#notificationDetailContainer').removeClass('hidden').addClass('animate-in slide-in-from-right-8 duration-500');
            });
            $('#notificationDropdown').on('click', '#btnBackToNotifications', function(e) {
                e.stopPropagation();
                $('#notificationDetailContainer').addClass('hidden');
                $('#notificationListContainer').removeClass('hidden').addClass('animate-in slide-in-from-left-8 duration-500');
            });
            // Clear All Notifications
            $('#notificationDropdown').on('click', '#btnClearAllNotifs', function(e) {
                e.stopPropagation();
                // Add removal animation
                $('.notification-item').addClass('scale-95 opacity-0 transition-all duration-300');
                setTimeout(() => {
                    $('.notification-item').remove();
                    $('#notifCount').text('No New Alerts');
                    $('#unreadDot').fadeOut();
                    // Show Empty State
                    $('#notificationListContainer .px-4').html(`
                        <div class="py-12 text-center animate-in fade-in zoom-in duration-700">
                            <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
                                <i class="fas fa-bell-slash text-slate-300 text-xl"></i>
                            </div>
                            <p class="text-[11px] font-semibold text-slate-400 uppercase tracking-widest">Registry is Clear</p>
                            <p class="text-[10px] font-medium text-slate-400 mt-1">No pending administrative alerts.</p>
                        </div>
                    `);
                    $(this).parent().fadeOut(); // Hide Clear All button
                }, 300);
            });
            // Header Clock Functionality
            function updateHeaderClock() {
                const now = new Date();
                const timeStr = now.toLocaleTimeString('en-US', { 
                    hour12: false, 
                    hour: '2-digit', 
                    minute: '2-digit', 
                    second: '2-digit' 
                });
                $('#headerClock').text(timeStr);
            }
            setInterval(updateHeaderClock, 1000);
            updateHeaderClock();
            $(document).on('click', function() {
                $profileDropdown.addClass('hidden');
                $notificationDropdown.addClass('hidden');
            });
            $profileDropdown.on('click', function(e) { e.stopPropagation(); });
            $notificationDropdown.on('click', function(e) { e.stopPropagation(); });
            $sidebar.on('click', function(e) { e.stopPropagation(); });
            // Global Skeleton Loader Handler
            window.showContent = function() {
                $('.skeleton-container').fadeOut(400, function() {
                    $(this).addClass('content-hidden');
                    $('.main-content-actual').removeClass('content-hidden').addClass('animate-in fade-in duration-700');
                });
            };
            // Simulate loading (Remove this in production or trigger when data is ready)
            setTimeout(window.showContent, 1500);
        });
    </script>
    <div id="app-scripts">
        @await RenderSectionAsync("Scripts", required: false)
    </div>
    <script>
        $(document).ready(function() {
            // Intercept internal links
            $(document).on('click', 'a.nav-link', function(e) {
                const url = $(this).attr('href');
                // Allow control/cmd click or external links or empty links
                if (e.ctrlKey || e.metaKey || !url || url === '#' || url.startsWith('http')) return;
                e.preventDefault();
                // Visual Feedback & Optimization
                $('.nav-link').removeClass('text-white bg-white/10 shadow-[0_0_20px_rgba(255,255,255,0.1)] border-white/10').addClass('text-slate-400 border-transparent');
                $(this).addClass('text-white bg-white/10 shadow-[0_0_20px_rgba(255,255,255,0.1)] border-white/10').removeClass('text-slate-400 border-transparent');
                // Show Skeleton
                $('.main-content-actual').addClass('hidden');
                $('.skeleton-container').removeClass('hidden').show();
                // Fetch Content
                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function(response) {
                        const $res = $(response);
                        const newContent = $res.find('#app-content').html();
                        const newScripts = $res.find('#app-scripts').html();
                        const newTitle = $res.filter('title').text();
                        if (newContent) {
                            // Update DOM
                            $('#app-content').html(newContent);
                            $('#app-scripts').html(newScripts); // This re-executes page specific scripts
                            // Update Browser History
                            history.pushState(null, newTitle, url);
                            document.title = newTitle;
                            // Re-trigger global showContent logic if it exists in the new view or fallback
                            if (typeof window.showContent === 'function') {
                                setTimeout(window.showContent, 600); // Shorter delay for SPA feel
                            } else {
                                // Fallback reveal just in case
                                $('.skeleton-container').fadeOut(200);
                                $('.main-content-actual').removeClass('hidden').addClass('animate-in fade-in duration-500');
                            }
                        } else {
                            // Fallback if parsing fails
                            window.location.href = url;
                        }
                    },
                    error: function() {
                        window.location.href = url; // Fallback to full reload on error
                    }
                });
            });
            // Handle Back/Forward Browser Buttons
            window.addEventListener('popstate', function() {
                window.location.reload(); // Simplest way to handle history traversal without complex cache logic
            });
        });
    </script>
</body>
</html>