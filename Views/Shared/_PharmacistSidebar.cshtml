@using Microsoft.AspNetCore.Identity
@using MedLinkPortal.Areas.Identity.Pages.Account
@inject UserManager<ApplicationUser> UserManager
@{
    var user = await UserManager.GetUserAsync(User);
}

<div class="p-6 flex-1 flex flex-col h-full bg-slate-900 text-white">
    <!-- Brand -->
    <div class="flex items-center gap-3 mb-10 group cursor-pointer px-2">
        <div class="rounded-2xl overflow-hidden shadow-lg shadow-emerald-500/20 group-hover:scale-110 transition-transform duration-300 w-11 h-11 flex-shrink-0">
            <img src="/images/medlink-logo.png" alt="MedLink Logo" class="w-10 h-10 rounded-2xl object-cover shadow-lg">
        </div>
        <div>
            <span class="text-xl font-black text-white tracking-tight block leading-none">MedLink</span>
            <span class="text-[10px] font-bold text-emerald-500 uppercase tracking-widest mt-1 block tracking-[0.2em]">Pharmacist Hub</span>
        </div>
    </div>

    <!-- Navigation -->
    <nav class="space-y-2 flex-1">
        <p class="px-2 text-[10px] font-black text-white/30 uppercase tracking-[0.2em] mb-4">Command Center</p>
        
        <a href="/Pharmacy/Dashboard" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-[13px] font-bold transition-all duration-200 group hover:bg-white/5 active:scale-95">
            <i data-lucide="layout-grid" class="w-5 h-5 text-emerald-500"></i>
            Dashboard
        </a>

        <a href="/Pharmacy/Inventory" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-[13px] font-bold transition-all duration-200 group hover:bg-white/5 active:scale-95">
            <i data-lucide="package" class="w-5 h-5 text-emerald-500"></i>
            Inventory CMS
        </a>

        <a href="/Pharmacy/Orders" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-[13px] font-bold transition-all duration-200 group hover:bg-white/5 active:scale-95">
            <i data-lucide="history" class="w-5 h-5 text-emerald-500"></i>
            History
        </a>
        
        <div class="pt-8">
            <p class="px-2 text-[10px] font-black text-white/30 uppercase tracking-[0.2em] mb-4">Operations</p>
            <a href="/Pharmacy/Analytics" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-[13px] font-bold transition-all duration-200 group hover:bg-white/5 active:scale-95">
                <i data-lucide="trending-up" class="w-5 h-5 text-emerald-500"></i>
                Revenue Intel
            </a>
            <a href="/Pharmacy/CustomerSupport" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-[13px] font-bold transition-all duration-200 group hover:bg-white/5 active:scale-95">
                <i data-lucide="message-circle" class="w-5 h-5 text-emerald-500"></i>
                Customer Support
            </a>
            <p class="px-2 text-[10px] font-black text-white/30 uppercase tracking-[0.2em] mb-4 mt-6">Settings</p>
            <a href="/Pharmacy/Profile" class="flex items-center gap-3 px-4 py-3.5 rounded-2xl text-[13px] font-bold transition-all duration-200 group hover:bg-white/5 active:scale-95">
                <i data-lucide="user-cog" class="w-5 h-5 text-emerald-500"></i>
                Profile Config
            </a>
        </div>
    </nav>

    <div class="pt-6 border-t border-white/5">
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit" class="w-full flex items-center gap-3 px-4 py-3.5 rounded-2xl text-[13px] font-bold text-rose-500 hover:bg-rose-500/10 transition-all duration-200 group">
                <i data-lucide="log-out" class="w-4 h-4 group-hover:rotate-12 transition-transform"></i>
                Terminal Sign Out
            </button>
        </form>
    </div>
</div>
